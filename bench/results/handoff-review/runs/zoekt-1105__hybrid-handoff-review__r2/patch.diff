+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"cmp"
+	"path/filepath"
+	"slices"
+
+	"github.com/sourcegraph/zoekt/index"
+)
+
+type repositoryRecord struct {
+	Name   string
+	Source string
+	Shards []string
+}
+
+func readInventory(indexDir string) ([]string, error) {
+	matches, err := filepath.Glob(filepath.Join(indexDir, "*.zoekt"))
+	if err != nil {
+		return nil, err
+	}
+	if matches == nil {
+		return []string{}, nil
+	}
+	return matches, nil
+}
+
+func recordsFromShards(shards []string) []repositoryRecord {
+	repoMap := make(map[string]*repositoryRecord)
+
+	for _, shard := range shards {
+		repos, _, err := index.ReadMetadataPath(shard)
+		if err != nil {
+			continue
+		}
+		for _, r := range repos {
+			if r == nil || r.Tombstone {
+				continue
+			}
+			rec, exists := repoMap[r.Name]
+			if !exists {
+				rec = &repositoryRecord{
+					Name:   r.Name,
+					Source: r.Source,
+				}
+				repoMap[r.Name] = rec
+			}
+			if rec.Source == "" && r.Source != "" {
+				rec.Source = r.Source
+			}
+			rec.Shards = append(rec.Shards, shard)
+		}
+	}
+
+	result := make([]repositoryRecord, 0, len(repoMap))
+	for _, rec := range repoMap {
+		result = append(result, *rec)
+	}
+	slices.SortFunc(result, func(a, b repositoryRecord) int {
+		return cmp.Compare(a.Name, b.Name)
+	})
+	return result
+}
