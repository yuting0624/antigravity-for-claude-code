+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"cmp"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+)
+
+type repository struct {
+	Name string
+	Path string
+}
+
+func isGitRepo(dir string) bool {
+	// Check for .git directory or file (worktrees, submodules)
+	if _, err := os.Stat(filepath.Join(dir, ".git")); err == nil {
+		return true
+	}
+	// Check for bare repository (objects directory exists)
+	if fi, err := os.Stat(filepath.Join(dir, "objects")); err == nil && fi.IsDir() {
+		if strings.HasSuffix(dir, ".git") {
+			return true
+		}
+		if _, err := os.Stat(filepath.Join(dir, "HEAD")); err == nil {
+			return true
+		}
+		if _, err := os.Stat(filepath.Join(dir, "config")); err == nil {
+			return true
+		}
+	}
+	return false
+}
+
+func deriveRepoName(root, repoDir string) string {
+	cleanRoot := filepath.Clean(root)
+	cleanRepo := filepath.Clean(repoDir)
+	if cleanRoot == cleanRepo {
+		return strings.TrimSuffix(filepath.Base(cleanRoot), ".git")
+	}
+	rel, err := filepath.Rel(cleanRoot, cleanRepo)
+	if err != nil {
+		return strings.TrimSuffix(filepath.Base(cleanRepo), ".git")
+	}
+	return strings.TrimSuffix(filepath.ToSlash(rel), ".git")
+}
+
+func discoverRepositories(roots []string) ([]repository, error) {
+	var discovered []repository
+	nameToPath := make(map[string]string)
+
+	for _, root := range roots {
+		cleanRoot := filepath.Clean(root)
+		fi, err := os.Stat(cleanRoot)
+		if err != nil {
+			return nil, err
+		}
+		if !fi.IsDir() {
+			return nil, fmt.Errorf("%s is not a directory", cleanRoot)
+		}
+
+		addRepo := func(path string) error {
+			name := deriveRepoName(cleanRoot, path)
+			if prevPath, exists := nameToPath[name]; exists {
+				return fmt.Errorf("duplicate repository name %q: %s and %s", name, prevPath, path)
+			}
+			nameToPath[name] = path
+			discovered = append(discovered, repository{Name: name, Path: path})
+			return nil
+		}
+
+		if isGitRepo(cleanRoot) {
+			if err := addRepo(cleanRoot); err != nil {
+				return nil, err
+			}
+			continue
+		}
+
+		err = filepath.WalkDir(cleanRoot, func(path string, d fs.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			if path == cleanRoot {
+				return nil
+			}
+			if d.IsDir() && d.Name() == ".git" {
+				return filepath.SkipDir
+			}
+			if isGitRepo(path) {
+				if err := addRepo(path); err != nil {
+					return err
+				}
+				if d.IsDir() {
+					return filepath.SkipDir
+				}
+			}
+			return nil
+		})
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	slices.SortFunc(discovered, func(a, b repository) int {
+		return cmp.Compare(a.Name, b.Name)
+	})
+
+	return discovered, nil
+}
