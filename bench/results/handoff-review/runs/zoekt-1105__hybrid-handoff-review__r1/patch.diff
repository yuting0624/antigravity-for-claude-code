+
+package main
+
+import (
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+)
+
+type repository struct {
+	Name string
+	Path string
+}
+
+// isGitRepo reports whether path is a git repository worktree or bare repository.
+func isGitRepo(path string) bool {
+	if _, err := os.Lstat(filepath.Join(path, ".git")); err == nil {
+		return true
+	}
+	if strings.HasSuffix(path, ".git") {
+		if fi, err := os.Lstat(filepath.Join(path, "objects")); err == nil && fi.IsDir() {
+			return true
+		}
+	}
+	return false
+}
+
+func discoverRepositories(roots []string) ([]repository, error) {
+	var repos []repository
+	seen := make(map[string]string)
+
+	addRepo := func(name, path string) error {
+		if prev, ok := seen[name]; ok {
+			return fmt.Errorf("duplicate repository name %q (at %s and %s)", name, prev, path)
+		}
+		seen[name] = path
+		repos = append(repos, repository{Name: name, Path: path})
+		return nil
+	}
+
+	for _, root := range roots {
+		root = filepath.Clean(root)
+		fi, err := os.Stat(root)
+		if err != nil {
+			return nil, err
+		}
+		if !fi.IsDir() {
+			return nil, fmt.Errorf("%s is not a directory", root)
+		}
+
+		if isGitRepo(root) {
+			name := strings.TrimSuffix(filepath.Base(root), ".git")
+			if err := addRepo(name, root); err != nil {
+				return nil, err
+			}
+			continue
+		}
+
+		err = filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			if path == root || !d.IsDir() {
+				return nil
+			}
+			if d.Name() == ".git" {
+				return filepath.SkipDir
+			}
+			if !isGitRepo(path) {
+				return nil
+			}
+
+			rel, err := filepath.Rel(root, path)
+			if err != nil {
+				return err
+			}
+			name := filepath.ToSlash(strings.TrimSuffix(rel, ".git"))
+			if err := addRepo(name, path); err != nil {
+				return err
+			}
+			return filepath.SkipDir
+		})
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	slices.SortFunc(repos, func(a, b repository) int {
+		return strings.Compare(a.Name, b.Name)
+	})
+
+	return repos, nil
+}
