+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+
+	"github.com/sourcegraph/zoekt/index"
+)
+
+type repositoryRecord struct {
+	Name   string
+	Source string
+	Shards []string
+}
+
+func readInventory(indexDir string) ([]string, error) {
+	if _, err := os.Stat(indexDir); os.IsNotExist(err) {
+		return []string{}, nil
+	} else if err != nil {
+		return nil, err
+	}
+
+	shards, err := filepath.Glob(filepath.Join(indexDir, "*.zoekt"))
+	if err != nil {
+		return nil, err
+	}
+	if shards == nil {
+		shards = []string{}
+	}
+	slices.Sort(shards)
+	return shards, nil
+}
+
+func recordsFromShards(shards []string) []repositoryRecord {
+	repoMap := make(map[string]*repositoryRecord)
+	for _, shard := range shards {
+		repos, _, err := index.ReadMetadataPath(shard)
+		if err != nil {
+			continue
+		}
+		for _, r := range repos {
+			rec, ok := repoMap[r.Name]
+			if !ok {
+				rec = &repositoryRecord{
+					Name:   r.Name,
+					Source: r.Source,
+				}
+				repoMap[r.Name] = rec
+			}
+			rec.Shards = append(rec.Shards, shard)
+		}
+	}
+
+	names := make([]string, 0, len(repoMap))
+	for name := range repoMap {
+		names = append(names, name)
+	}
+	slices.Sort(names)
+
+	records := make([]repositoryRecord, 0, len(names))
+	for _, name := range names {
+		records = append(records, *repoMap[name])
+	}
+	return records
+}
