+// CreateOrFindLoadTest creates a load test with the given name if it doesn't exist,
+// or retrieves the existing one if a conflict (409) occurs.
+func (c *Client) CreateOrFindLoadTest(ctx context.Context, projectID int64, name string) (int64, error) {
+	res, hr, err := c.apiClient.LoadTestsAPI.
+		ProjectsLoadTestsCreate(c.authCtx(ctx), projectID).
+		XStackId(c.stackID).
+		Name(name).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if err := CheckResponse(hr, err); err != nil {
+		var rerr ResponseError
+		if errors.As(err, &rerr) && rerr.Response != nil && rerr.Response.StatusCode == http.StatusConflict {
+			lt, ferr := c.findTestByName(ctx, projectID, name)
+			if ferr != nil {
+				return 0, ferr
+			}
+			return lt.GetId(), nil
+		}
+		return 0, err
+	}
+	if res == nil {
+		return 0, errUnknown
+	}
+
+	return res.GetId(), nil
+}
