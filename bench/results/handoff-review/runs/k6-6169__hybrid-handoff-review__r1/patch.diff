@@ -0,0 +1,11 @@
+package clientcfg
+
+import "time"
+
+const (
+	// RetryInterval is the default wait duration between retry attempts.
+	RetryInterval = 500 * time.Millisecond
+
+	// MaxRetries specifies the default maximum retry attempts.
+	MaxRetries = 3
+)
diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..3b9051ab6
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,247 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// StartLocalExecution initiates a local execution test run on the cloud backend.
+func (c *Client) StartLocalExecution(
+	ctx context.Context,
+	loadTestID int64,
+	req StartLocalExecutionRequest,
+) (*StartLocalExecutionResponse, error) {
+	bodyBytes, err := json.Marshal(req)
+	if err != nil {
+		return nil, fmt.Errorf("marshaling start local execution request: %w", err)
+	}
+
+	url := fmt.Sprintf("%s/provisioning/v1/load_tests/%d/start_local_execution", c.host, loadTestID)
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(bodyBytes))
+	if err != nil {
+		return nil, fmt.Errorf("creating HTTP request: %w", err)
+	}
+
+	var key [8]byte
+	if _, err := rand.Read(key[:]); err != nil {
+		return nil, fmt.Errorf("generating idempotency key: %w", err)
+	}
+
+	httpReq.Header.Set("Content-Type", "application/json")
+	httpReq.Header.Set("X-Stack-Id", strconv.FormatInt(c.stackID, 10))
+	httpReq.Header.Set("K6-Idempotency-Key", hex.EncodeToString(key[:]))
+
+	var sdkResp k6cloud.StartLocalExecutionTestResponse
+	if err := c.httpClient.Do(httpReq, &sdkResp); err != nil {
+		return nil, err
+	}
+
+	var uploadURL *string
+	if sdkResp.ArchiveUploadUrl.IsSet() && sdkResp.ArchiveUploadUrl.Get() != nil {
+		uploadURL = sdkResp.ArchiveUploadUrl.Get()
+	}
+
+	rc := sdkResp.GetRuntimeConfig()
+	m := rc.GetMetrics()
+	s := rc.GetSecrets()
+
+	var pushInterval *string
+	if m.PushInterval.IsSet() && m.PushInterval.Get() != nil {
+		pushInterval = m.PushInterval.Get()
+	}
+	var pushConcurrency *int32
+	if m.PushConcurrency.IsSet() && m.PushConcurrency.Get() != nil {
+		pushConcurrency = m.PushConcurrency.Get()
+	}
+	var aggPeriod *string
+	if m.AggregationPeriod.IsSet() && m.AggregationPeriod.Get() != nil {
+		aggPeriod = m.AggregationPeriod.Get()
+	}
+	var aggWaitPeriod *string
+	if m.AggregationWaitPeriod.IsSet() && m.AggregationWaitPeriod.Get() != nil {
+		aggWaitPeriod = m.AggregationWaitPeriod.Get()
+	}
+	var aggMinSamples *int32
+	if m.AggregationMinSamples.IsSet() && m.AggregationMinSamples.Get() != nil {
+		aggMinSamples = m.AggregationMinSamples.Get()
+	}
+	var maxSamples *int32
+	if m.MaxSamplesPerPackage.IsSet() && m.MaxSamplesPerPackage.Get() != nil {
+		maxSamples = m.MaxSamplesPerPackage.Get()
+	}
+
+	return &StartLocalExecutionResponse{
+		TestRunID:             sdkResp.GetTestRunId(),
+		ArchiveUploadURL:      uploadURL,
+		TestRunDetailsPageURL: sdkResp.GetTestRunDetailsPageUrl(),
+		RuntimeConfig: RuntimeConfig{
+			Metrics: MetricsConfig{
+				PushURL:               m.GetPushUrl(),
+				PushInterval:          pushInterval,
+				PushConcurrency:       pushConcurrency,
+				AggregationPeriod:     aggPeriod,
+				AggregationWaitPeriod: aggWaitPeriod,
+				AggregationMinSamples: aggMinSamples,
+				MaxSamplesPerPackage:  maxSamples,
+			},
+			Secrets: SecretsConfig{
+				Endpoint:     s.GetEndpoint(),
+				ResponsePath: s.GetResponsePath(),
+			},
+			TestRunToken: rc.GetTestRunToken(),
+		},
+	}, nil
+}
+
+// UploadArchive uploads the tar archive to the presigned S3 upload URL using PUT.
+func (c *Client) UploadArchive(ctx context.Context, uploadURL string, archiveBody []byte) error {
+	maxAttempts := clientcfg.MaxRetries
+	if maxAttempts < 1 {
+		maxAttempts = 1
+	}
+
+	for attempt := 1; attempt <= maxAttempts; attempt++ {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+
+		req, err := http.NewRequestWithContext(ctx, http.MethodPut, uploadURL, bytes.NewReader(archiveBody))
+		if err != nil {
+			return fmt.Errorf("creating archive upload request: %w", err)
+		}
+		req.Header.Set("Content-Type", "application/x-tar")
+		if c.version != "" {
+			req.Header.Set("User-Agent", "k6cloud/"+c.version)
+		}
+		// Explicitly no Authorization header for presigned S3 uploads
+
+		resp, err := c.rawHTTPClient.Do(req)
+		if err != nil {
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			if attempt == maxAttempts {
+				return err
+			}
+			select {
+			case <-ctx.Done():
+				return ctx.Err()
+			case <-time.After(clientcfg.RetryInterval):
+			}
+			continue
+		}
+
+		if resp.StatusCode >= 500 && attempt < maxAttempts {
+			_ = resp.Body.Close()
+			select {
+			case <-ctx.Done():
+				return ctx.Err()
+			case <-time.After(clientcfg.RetryInterval):
+			}
+			continue
+		}
+
+		defer resp.Body.Close()
+		if err := CheckResponse(resp); err != nil {
+			return err
+		}
+		return nil
+	}
+
+	return nil
+}
+
+// WaitForTestRunReady polls GET /cloud/v6/test_runs/{id} until the status is "initializing".
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	if pollInterval <= 0 {
+		pollInterval = 500 * time.Millisecond
+	}
+
+	var lastStatus v6.Status
+	for {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+
+		progress, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			return err
+		}
+
+		switch progress.Status {
+		case v6.StatusInitializing:
+			return nil
+		case v6.StatusAborted:
+			for _, event := range progress.StatusHistory {
+				if event.Status == v6.StatusAborted && event.Message != "" {
+					return fmt.Errorf("test run aborted: %s", event.Message)
+				}
+			}
+			return errors.New("test run aborted before starting")
+		case v6.StatusCompleted:
+			return errors.New("test run completed prematurely")
+		default:
+			if progress.Status != lastStatus {
+				statusTitle := formatStatus(progress.Status)
+				c.logger.WithField("status", statusTitle).Info("Test run status changed")
+				lastStatus = progress.Status
+			}
+		}
+
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(pollInterval):
+		}
+	}
+}
+
+// NotifyTestRunCompleted posts execution status to /provisioning/v1/test_runs/{id}/notify.
+func (c *Client) NotifyTestRunCompleted(
+	ctx context.Context,
+	testRunID int64,
+	scopedToken string,
+	runErr error,
+) error {
+	reqBody := notifyRequest{
+		EventType: "script_execution_completed",
+		Error:     mapTestErrorToNotifyCode(runErr),
+	}
+
+	bodyBytes, err := json.Marshal(reqBody)
+	if err != nil {
+		return fmt.Errorf("marshaling notify request: %w", err)
+	}
+
+	url := fmt.Sprintf("%s/provisioning/v1/test_runs/%d/notify", c.host, testRunID)
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(bodyBytes))
+	if err != nil {
+		return fmt.Errorf("creating notify HTTP request: %w", err)
+	}
+	httpReq.Header.Set("Content-Type", "application/json")
+
+	notifyClient := NewHTTPClient(c.rawHTTPClient, scopedToken, c.version, c.logger)
+	return notifyClient.Do(httpReq, nil)
+}
+
+func formatStatus(s v6.Status) string {
+	str := string(s)
+	if len(str) == 0 {
+		return ""
+	}
+	return strings.ToUpper(str[:1]) + strings.ToLower(str[1:])
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..e0f76cec8
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,82 @@
+package provisioning
+
+import (
+	"fmt"
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client coordinates local execution with the provisioning API and Cloud v6 API.
+type Client struct {
+	logger        logrus.FieldLogger
+	token         string
+	stackID       int64
+	host          string
+	version       string
+	timeout       time.Duration
+	apiClient     *k6cloud.APIClient
+	v6Client      *v6.Client
+	httpClient    *HTTPClient
+	rawHTTPClient *http.Client
+}
+
+// NewClient returns a new provisioning Client configured with auth and API endpoints.
+func NewClient(
+	logger logrus.FieldLogger,
+	token, host, version string,
+	stackID int64,
+	timeout time.Duration,
+) (*Client, error) {
+	if token == "" {
+		return nil, fmt.Errorf("token is required to create provisioning client")
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Global k6 Cloud API.",
+		},
+	}
+	cfg.HTTPClient = &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+
+	v6Client, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if err := v6Client.SetStackID(stackID); err != nil {
+		return nil, err
+	}
+
+	rawHTTPClient := &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+
+	httpClient := NewHTTPClient(rawHTTPClient, token, version, logger)
+
+	return &Client{
+		logger:        logger,
+		token:         token,
+		stackID:       stackID,
+		host:          host,
+		version:       version,
+		timeout:       timeout,
+		apiClient:     k6cloud.NewAPIClient(cfg),
+		v6Client:      v6Client,
+		httpClient:    httpClient,
+		rawHTTPClient: rawHTTPClient,
+	}, nil
+}
