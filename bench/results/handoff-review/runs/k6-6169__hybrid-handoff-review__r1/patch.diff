new file mode 100644
index 000000000..fc3fc72e1
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,46 @@
+package provisioning
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+// ResponseError represents an HTTP error response from the provisioning API.
+type ResponseError struct {
+	StatusCode int
+	Body       string
+}
+
+func (e *ResponseError) Error() string {
+	return fmt.Sprintf("HTTP %d: %s", e.StatusCode, e.Body)
+}
+
+// Unwrap returns ErrNotAuthenticated for 401, ErrNotAuthorized for 403, or nil.
+func (e *ResponseError) Unwrap() error {
+	return httperr.ClassifyStatus(e.StatusCode)
+}
+
+// CheckResponse inspects an HTTP response and returns a ResponseError if not 2xx.
+func CheckResponse(r *http.Response) error {
+	if r == nil {
+		return errors.New("nil response")
+	}
+	if r.StatusCode >= 200 && r.StatusCode <= 299 {
+		return nil
+	}
+	var body string
+	if r.Body != nil {
+		data, err := io.ReadAll(r.Body)
+		if err == nil {
+			body = string(data)
+		}
+	}
+	return &ResponseError{
+		StatusCode: r.StatusCode,
+		Body:       body,
+	}
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..81514ac10
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,116 @@
+package provisioning
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient is an HTTP client with Bearer auth, User-Agent header, and 5xx retries.
+type HTTPClient struct {
+	client  *http.Client
+	token   string
+	version string
+	logger  logrus.FieldLogger
+}
+
+// NewHTTPClient creates a new HTTPClient.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	if client == nil {
+		client = http.DefaultClient
+	}
+	return &HTTPClient{
+		client:  client,
+		token:   token,
+		version: version,
+		logger:  logger,
+	}
+}
+
+// Do executes an HTTP request, retrying on 5xx errors, and decodes JSON into v if non-nil.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	var bodyBytes []byte
+	if req.Body != nil {
+		var err error
+		bodyBytes, err = io.ReadAll(req.Body)
+		if err != nil {
+			return fmt.Errorf("reading request body: %w", err)
+		}
+		_ = req.Body.Close()
+	}
+
+	maxAttempts := clientcfg.MaxRetries
+	if maxAttempts < 1 {
+		maxAttempts = 1
+	}
+
+	for attempt := 1; attempt <= maxAttempts; attempt++ {
+		if req.Context().Err() != nil {
+			return req.Context().Err()
+		}
+
+		// Clone or reset request for retry
+		clonedReq := req.Clone(req.Context())
+		if bodyBytes != nil {
+			clonedReq.Body = io.NopCloser(bytes.NewReader(bodyBytes))
+		}
+		if c.token != "" && clonedReq.Header.Get("Authorization") == "" {
+			clonedReq.Header.Set("Authorization", "Bearer "+c.token)
+		}
+		if c.version != "" && clonedReq.Header.Get("User-Agent") == "" {
+			clonedReq.Header.Set("User-Agent", "k6cloud/"+c.version)
+		}
+
+		resp, err := c.client.Do(clonedReq)
+		if err != nil {
+			if req.Context().Err() != nil {
+				return req.Context().Err()
+			}
+			if attempt == maxAttempts {
+				return err
+			}
+			// Wait before retry
+			select {
+			case <-req.Context().Done():
+				return req.Context().Err()
+			case <-time.After(clientcfg.RetryInterval):
+			}
+			continue
+		}
+
+		// Check if 5xx retryable
+		if resp.StatusCode >= 500 {
+			if attempt < maxAttempts {
+				_ = resp.Body.Close()
+				select {
+				case <-req.Context().Done():
+					return req.Context().Err()
+				case <-time.After(clientcfg.RetryInterval):
+				}
+				continue
+			}
+		}
+
+		// Non-5xx or exhausted retries
+		defer resp.Body.Close()
+		if err := CheckResponse(resp); err != nil {
+			return err
+		}
+
+		if v != nil {
+			if err := json.NewDecoder(resp.Body).Decode(v); err != nil {
+				return fmt.Errorf("decoding response body: %w", err)
+			}
+		}
+		return nil
+	}
+
+	return nil
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..6eb2a61e1
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,39 @@
+package provisioning
+
+import (
+	"errors"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+type notifyError struct {
+	Code   int32  `json:"code"`
+	Reason string `json:"reason"`
+}
+
+type notifyRequest struct {
+	EventType string       `json:"event_type"`
+	Error     *notifyError `json:"error"`
+}
+
+func mapTestErrorToNotifyCode(err error) *notifyError {
+	if err == nil {
+		return nil
+	}
+
+	var arerr errext.HasAbortReason
+	if errors.As(err, &arerr) {
+		switch arerr.AbortReason() {
+		case errext.AbortedByThresholdsAfterTestEnd:
+			return nil
+		case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+			return &notifyError{Code: 8036, Reason: err.Error()}
+		case errext.AbortedByScriptError:
+			return &notifyError{Code: 8035, Reason: err.Error()}
+		case errext.AbortedByOutput, errext.AbortedByTimeout:
+			return &notifyError{Code: 8034, Reason: err.Error()}
+		}
+	}
+
+	return &notifyError{Code: 0, Reason: err.Error()}
+}
diff --git a/internal/cloudapi/provisioning/provision.go b/internal/cloudapi/provisioning/provision.go
