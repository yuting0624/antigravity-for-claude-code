+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,157 @@
+package test
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	DefaultLoadTestID   int64  = 456
+	DefaultTestRunID    int64  = 123
+	PresignedUploadPath string = "/upload/archive.tar"
+)
+
+// Server simulates the provisioning and cloud v6 APIs for tests.
+type Server struct {
+	*httptest.Server
+	Mux *http.ServeMux
+
+	fetchHitCount atomic.Int32
+	progressMu    sync.Mutex
+	progressList  map[int64][]v6.TestProgress
+	progressIdx   map[int64]int
+}
+
+// NewServer creates a new fake provisioning test server.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+
+	mux := http.NewServeMux()
+	srv := httptest.NewServer(mux)
+	t.Cleanup(srv.Close)
+
+	return &Server{
+		Server:       srv,
+		Mux:          mux,
+		progressList: make(map[int64][]v6.TestProgress),
+		progressIdx:  make(map[int64]int),
+	}
+}
+
+// PresignedUploadURL returns the absolute URL for the presigned archive upload.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// FetchTestRunHitCount returns the number of times FetchTestRun endpoint was called.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchHitCount.Load()
+}
+
+// HandleStartLocalExecution registers a handler for the start local execution endpoint.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, handler http.HandlerFunc) {
+	pattern := fmt.Sprintf("/provisioning/v1/load_tests/%d/start_local_execution", loadTestID)
+	s.Mux.HandleFunc(pattern, handler)
+}
+
+// HandlePresignedUpload registers a handler for presigned upload.
+func (s *Server) HandlePresignedUpload(path string, handler http.HandlerFunc) {
+	s.Mux.HandleFunc(path, handler)
+}
+
+// HandleCreateLoadTest registers a handler for create/find load test.
+func (s *Server) HandleCreateLoadTest(projectID int64, handler http.HandlerFunc) {
+	pattern := fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID)
+	s.Mux.HandleFunc(pattern, handler)
+}
+
+// HandleFetchTestRun registers mock progress responses for polling GET /cloud/v6/test_runs/{id}.
+func (s *Server) HandleFetchTestRun(testRunID int64, progressList []v6.TestProgress) {
+	s.progressMu.Lock()
+	s.progressList[testRunID] = progressList
+	s.progressIdx[testRunID] = 0
+	s.progressMu.Unlock()
+
+	pattern := fmt.Sprintf("/cloud/v6/test_runs/%d", testRunID)
+	s.Mux.HandleFunc(pattern, func(w http.ResponseWriter, _ *http.Request) {
+		s.fetchHitCount.Add(1)
+
+		s.progressMu.Lock()
+		list := s.progressList[testRunID]
+		idx := s.progressIdx[testRunID]
+		var tp v6.TestProgress
+		if len(list) > 0 {
+			if idx < len(list) {
+				tp = list[idx]
+				s.progressIdx[testRunID] = idx + 1
+			} else {
+				tp = list[len(list)-1]
+			}
+		}
+		s.progressMu.Unlock()
+
+		res := k6cloud.NewTestRunApiModelWithDefaults()
+		res.SetStatus(tp.Status.String())
+		res.SetResult(tp.Result.String())
+		res.SetEstimatedDuration(tp.EstimatedDuration)
+		res.SetExecutionDuration(tp.ExecutionDuration)
+		res.SetStatusHistory(v6.ToStatusModel(tp.StatusHistory))
+		res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+		res.SetResultDetails(k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(k6cloud.NewResultDetailsApiModel("")))
+		res.SetOptions(map[string]any{})
+
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusOK)
+		_ = json.NewEncoder(w).Encode(res)
+	})
+}
+
+// HandleNotify registers a handler for the notify endpoint.
+func (s *Server) HandleNotify(testRunID int64, handler http.HandlerFunc) {
+	pattern := fmt.Sprintf("/provisioning/v1/test_runs/%d/notify", testRunID)
+	s.Mux.HandleFunc(pattern, handler)
+}
