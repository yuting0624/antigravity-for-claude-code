+// MarshalJSON customizes JSON serialization so that an ArchiveSize <= 0
+// is explicitly marshaled as JSON null rather than omitted or zero.
+func (r StartLocalExecutionRequest) MarshalJSON() ([]byte, error) {
+	type Alias StartLocalExecutionRequest
+	var sizePtr *int64
+	if r.ArchiveSize > 0 {
+		sizePtr = &r.ArchiveSize
+	}
+	return json.Marshal(&struct {
+		Alias
+		ArchiveSize *int64 `json:"archive_size"`
+	}{
+		Alias:       Alias(r),
+		ArchiveSize: sizePtr,
+	})
+}
