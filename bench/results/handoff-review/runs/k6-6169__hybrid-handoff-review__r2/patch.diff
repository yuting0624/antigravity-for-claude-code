+// CreateOrFindLoadTest ensures the load test exists in the given project
+// without uploading a script. On conflict (409), it falls back to finding
+// the existing load test by name. Returns the load test ID.
+func (c *Client) CreateOrFindLoadTest(
+	ctx context.Context, projectID int64, name string,
+) (int64, error) {
+	lt, err := c.createTestWithoutScript(ctx, name, projectID)
+	if err == nil {
+		return lt.GetId(), nil
+	}
+	var rerr ResponseError
+	if !errors.As(err, &rerr) || rerr.Response == nil || rerr.Response.StatusCode != http.StatusConflict {
+		return 0, err
+	}
+
+	lt, err = c.findTestByName(ctx, projectID, name)
+	if err != nil {
+		return 0, err
+	}
+
+	return lt.GetId(), nil
+}
+
+func (c *Client) createTestWithoutScript(
+	ctx context.Context, name string, projectID int64,
+) (_ *k6cloud.LoadTestApiModel, err error) {
+	res, hr, err := c.apiClient.LoadTestsAPI.
+		ProjectsLoadTestsCreate(c.authCtx(ctx), projectID).
+		XStackId(c.stackID).
+		Name(name).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if err := CheckResponse(hr, err); err != nil {
+		return nil, err
+	}
+	if res == nil {
+		return nil, errUnknown
+	}
+
+	return res, nil
+}
+
