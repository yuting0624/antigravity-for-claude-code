--- /dev/null
+++ b/internal/cloudapi/clientcfg/clientcfg.go
@@ -0,0 +1,11 @@
+package clientcfg
+
+import "time"
+
+const (
+	// MaxRetries specifies max retry attempts for cloud API clients.
+	MaxRetries = 3
+
+	// RetryInterval is the sleep duration between retries for cloud API clients.
+	RetryInterval = 500 * time.Millisecond
+)
diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..d951bb321
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,165 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strconv"
+	"time"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+func generateIdempotencyKey() string {
+	b := make([]byte, 16)
+	_, _ = rand.Read(b)
+	return hex.EncodeToString(b)
+}
+
+// StartLocalExecution starts local execution for a load test via POST /provisioning/v1/load_tests/{id}/start_local_execution.
+func (c *Client) StartLocalExecution(ctx context.Context, loadTestID int64, req StartLocalExecutionRequest) (*StartLocalExecutionResponse, error) {
+	url := fmt.Sprintf("%s/provisioning/v1/load_tests/%d/start_local_execution", c.host, loadTestID)
+
+	bodyBytes, err := json.Marshal(req)
+	if err != nil {
+		return nil, err
+	}
+
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(bodyBytes))
+	if err != nil {
+		return nil, err
+	}
+
+	httpReq.Header.Set("Content-Type", "application/json")
+	httpReq.Header.Set("K6-Idempotency-Key", generateIdempotencyKey())
+	if c.stackID > 0 {
+		httpReq.Header.Set("X-Stack-Id", strconv.FormatInt(c.stackID, 10))
+	}
+
+	var resp StartLocalExecutionResponse
+	if err := c.httpClient.Do(httpReq, &resp); err != nil {
+		return nil, err
+	}
+
+	return &resp, nil
+}
+
+// UploadArchive uploads the tar archive to the presigned upload URL via PUT without authorization.
+func (c *Client) UploadArchive(ctx context.Context, uploadURL string, archive []byte) error {
+	for attempt := 0; attempt <= clientcfg.MaxRetries; attempt++ {
+		req, err := http.NewRequestWithContext(ctx, http.MethodPut, uploadURL, bytes.NewReader(archive))
+		if err != nil {
+			return err
+		}
+		req.Header.Set("Content-Type", "application/x-tar")
+		req.ContentLength = int64(len(archive))
+
+		resp, err := c.rawClient.Do(req)
+		if err != nil {
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			if attempt < clientcfg.MaxRetries {
+				select {
+				case <-ctx.Done():
+					return ctx.Err()
+				case <-time.After(clientcfg.RetryInterval):
+					continue
+				}
+			}
+			return err
+		}
+
+		if resp.StatusCode >= 200 && resp.StatusCode <= 299 {
+			_ = resp.Body.Close()
+			return nil
+		}
+
+		if resp.StatusCode >= 500 && resp.StatusCode < 600 {
+			if attempt < clientcfg.MaxRetries {
+				_ = resp.Body.Close()
+				select {
+				case <-ctx.Done():
+					return ctx.Err()
+				case <-time.After(clientcfg.RetryInterval):
+					continue
+				}
+			}
+		}
+
+		defer resp.Body.Close()
+		return CheckResponse(resp)
+	}
+
+	return errors.New("max retries exceeded uploading archive")
+}
+
+// WaitForTestRunReady polls the v6 cloud API until the test run reaches StatusInitializing.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	var lastStatus v6.Status
+	for {
+		progress, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			return err
+		}
+
+		if progress.Status == v6.StatusInitializing {
+			return nil
+		}
+
+		if progress.Status == v6.StatusAborted {
+			for _, event := range progress.StatusHistory {
+				if event.Status == v6.StatusAborted && event.Message != "" {
+					return fmt.Errorf("test run aborted before starting: %s", event.Message)
+				}
+			}
+			return errors.New("test run aborted before starting")
+		}
+
+		if progress.Status == v6.StatusCompleted {
+			return errors.New("test run completed prematurely")
+		}
+
+		if progress.Status != lastStatus {
+			lastStatus = progress.Status
+			c.logger.WithField("status", progress.FormatStatus()).Info("Test run status changed")
+		}
+
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(pollInterval):
+		}
+	}
+}
+
+// NotifyTestRunCompleted posts the completion event and test run error to the provisioning notify endpoint.
+func (c *Client) NotifyTestRunCompleted(ctx context.Context, testRunID int64, testRunToken string, testErr error) error {
+	url := fmt.Sprintf("%s/provisioning/v1/test_runs/%d/notify", c.host, testRunID)
+
+	reqPayload := notifyRequest{
+		EventType: "script_execution_completed",
+		Error:     mapTestErrorToNotifyCode(testErr),
+	}
+
+	bodyBytes, err := json.Marshal(reqPayload)
+	if err != nil {
+		return err
+	}
+
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(bodyBytes))
+	if err != nil {
+		return err
+	}
+
+	httpReq.Header.Set("Content-Type", "application/json")
+	httpReq.Header.Set("Authorization", "Bearer "+testRunToken)
+
+	return c.httpClient.Do(httpReq, nil)
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..8aa11ddee
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,59 @@
+package provisioning
+
+import (
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client is the client for the provisioning and v6 cloud APIs used for local execution.
+type Client struct {
+	logger     logrus.FieldLogger
+	token      string
+	host       string
+	version    string
+	stackID    int64
+	apiClient  *k6cloud.APIClient
+	v6Client   *v6.Client
+	httpClient *HTTPClient
+	rawClient  *http.Client
+}
+
+// NewClient creates a new provisioning Client.
+func NewClient(logger logrus.FieldLogger, token, host, version string, stackID int64, timeout time.Duration) (*Client, error) {
+	cfg := k6cloud.NewConfiguration()
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL: host,
+		},
+	}
+	rawClient := &http.Client{Timeout: timeout}
+	cfg.HTTPClient = rawClient
+	apiClient := k6cloud.NewAPIClient(cfg)
+
+	v6Client, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if stackID > 0 {
+		v6Client.SetStackID(stackID)
+	}
+
+	httpClient := NewHTTPClient(rawClient, token, version, logger)
+
+	return &Client{
+		logger:     logger,
+		token:      token,
+		host:       host,
+		version:    version,
+		stackID:    stackID,
+		apiClient:  apiClient,
+		v6Client:   v6Client,
+		httpClient: httpClient,
+		rawClient:  rawClient,
+	}, nil
+}
diff --git a/internal/cloudapi/provisioning/errors.go b/internal/cloudapi/provisioning/errors.go
new file mode 100644
index 000000000..8f550e57d
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,41 @@
+package provisioning
+
+import (
+	"fmt"
+	"io"
+	"net/http"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+// ResponseError represents an HTTP error response from the provisioning service.
+type ResponseError struct {
+	StatusCode int
+	Body       string
+}
+
+func (e *ResponseError) Error() string {
+	return fmt.Sprintf("status code %d: %s", e.StatusCode, e.Body)
+}
+
+// Unwrap classifies HTTP 401 and 403 status codes using the shared httperr helper.
+func (e *ResponseError) Unwrap() error {
+	return httperr.ClassifyStatus(e.StatusCode)
+}
+
+// CheckResponse verifies the HTTP response status. If 2xx, returns nil.
+// Otherwise, it reads the body and returns a *ResponseError.
+func CheckResponse(resp *http.Response) error {
+	if resp == nil {
+		return nil
+	}
+	if resp.StatusCode >= 200 && resp.StatusCode <= 299 {
+		return nil
+	}
+
+	body, _ := io.ReadAll(resp.Body)
+	return &ResponseError{
+		StatusCode: resp.StatusCode,
+		Body:       string(body),
+	}
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..537d3b5fe
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,101 @@
+package provisioning
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient is an HTTP client for provisioning requests with authentication,
+// user-agent header injection, retries on 5xx status codes, and request body replay.
+type HTTPClient struct {
+	client  *http.Client
+	token   string
+	version string
+	logger  logrus.FieldLogger
+}
+
+// NewHTTPClient creates a new HTTPClient.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	if client == nil {
+		client = http.DefaultClient
+	}
+	return &HTTPClient{
+		client:  client,
+		token:   token,
+		version: version,
+		logger:  logger,
+	}
+}
+
+// Do executes an HTTP request, retrying on 5xx responses, and unmarshals the response JSON into v if non-nil.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	if c.token != "" && req.Header.Get("Authorization") == "" {
+		req.Header.Set("Authorization", "Bearer "+c.token)
+	}
+	if c.version != "" && req.Header.Get("User-Agent") == "" {
+		req.Header.Set("User-Agent", "k6cloud/"+c.version)
+	}
+
+	var bodyBytes []byte
+	if req.Body != nil {
+		var err error
+		bodyBytes, err = io.ReadAll(req.Body)
+		_ = req.Body.Close()
+		if err != nil {
+			return err
+		}
+	}
+
+	for attempt := 0; attempt <= clientcfg.MaxRetries; attempt++ {
+		if bodyBytes != nil {
+			req.Body = io.NopCloser(bytes.NewReader(bodyBytes))
+		}
+
+		resp, err := c.client.Do(req)
+		if err != nil {
+			if req.Context().Err() != nil {
+				return req.Context().Err()
+			}
+			if attempt < clientcfg.MaxRetries {
+				select {
+				case <-req.Context().Done():
+					return req.Context().Err()
+				case <-time.After(clientcfg.RetryInterval):
+					continue
+				}
+			}
+			return err
+		}
+
+		if resp.StatusCode >= 500 && resp.StatusCode < 600 {
+			if attempt < clientcfg.MaxRetries {
+				_ = resp.Body.Close()
+				select {
+				case <-req.Context().Done():
+					return req.Context().Err()
+				case <-time.After(clientcfg.RetryInterval):
+					continue
+				}
+			}
+		}
+
+		defer resp.Body.Close()
+		if err := CheckResponse(resp); err != nil {
+			return err
+		}
+
+		if v != nil {
+			return json.NewDecoder(resp.Body).Decode(v)
+		}
+		return nil
+	}
+
+	return nil
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..0aa6da60a
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,51 @@
+package provisioning
+
+import (
+	"errors"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+type notifyError struct {
+	Code   int32  `json:"code"`
+	Reason string `json:"reason"`
+}
+
+type notifyRequest struct {
+	EventType string       `json:"event_type"`
+	Error     *notifyError `json:"error"`
+}
+
+func mapTestErrorToNotifyCode(err error) *notifyError {
+	if err == nil {
+		return nil
+	}
+
+	var arerr errext.HasAbortReason
+	if errors.As(err, &arerr) {
+		switch arerr.AbortReason() {
+		case errext.AbortedByThresholdsAfterTestEnd:
+			return nil
+		case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+			return &notifyError{
+				Code:   8036,
+				Reason: err.Error(),
+			}
+		case errext.AbortedByScriptError:
+			return &notifyError{
+				Code:   8035,
+				Reason: err.Error(),
+			}
+		case errext.AbortedByOutput, errext.AbortedByTimeout:
+			return &notifyError{
+				Code:   8034,
+				Reason: err.Error(),
+			}
+		}
+	}
+
+	return &notifyError{
+		Code:   0,
+		Reason: err.Error(),
+	}
+}
diff --git a/internal/cloudapi/provisioning/provision.go b/internal/cloudapi/provisioning/provision.go
new file mode 100644
index 000000000..e9441bf4f
--- /dev/null
+++ b/internal/cloudapi/provisioning/provision.go
@@ -0,0 +1,68 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"time"
+)
+
+// ProvisionLocalExecution orchestrates the setup of a local execution test run:
+// 1. Create or find the load test in the v6 API.
+// 2. Start local execution via the provisioning API.
+// 3. Upload the archive to the presigned URL (if an archive is provided and URL returned).
+// 4. Poll the test run until it reaches the initializing status.
+func (c *Client) ProvisionLocalExecution(ctx context.Context, params ProvisionParams) (*ProvisionResult, error) {
+	loadTestID, err := c.v6Client.CreateOrFindLoadTest(ctx, params.ProjectID, params.Name)
+	if err != nil {
+		return nil, fmt.Errorf("create or find load test: %w", err)
+	}
+
+	var archiveBytes []byte
+	var archiveSize int64
+	if params.Archive != nil {
+		var buf bytes.Buffer
+		if err := params.Archive.Write(&buf); err != nil {
+			return nil, fmt.Errorf("serialize archive: %w", err)
+		}
+		archiveBytes = buf.Bytes()
+		archiveSize = int64(len(archiveBytes))
+	}
+
+	sleReq := StartLocalExecutionRequest{
+		Options:       params.Options,
+		MaxVUs:        params.MaxVUs,
+		TotalDuration: params.TotalDuration,
+		ArchiveSize:   archiveSize,
+	}
+
+	sleResp, err := c.StartLocalExecution(ctx, loadTestID, sleReq)
+	if err != nil {
+		return nil, fmt.Errorf("start local execution: %w", err)
+	}
+
+	if params.Archive != nil {
+		if sleResp.ArchiveUploadURL != nil && *sleResp.ArchiveUploadURL != "" {
+			if err := c.UploadArchive(ctx, *sleResp.ArchiveUploadURL, archiveBytes); err != nil {
+				return nil, fmt.Errorf("upload archive: %w", err)
+			}
+		} else {
+			c.logger.Warn("archive provided but no upload URL returned, skipping archive upload")
+		}
+	}
+
+	pollInterval := params.PollInterval
+	if pollInterval <= 0 {
+		pollInterval = 500 * time.Millisecond
+	}
+
+	if err := c.WaitForTestRunReady(ctx, sleResp.TestRunID, pollInterval); err != nil {
+		return nil, fmt.Errorf("wait for test run ready: %w", err)
+	}
+
+	return &ProvisionResult{
+		TestRunID:             sleResp.TestRunID,
+		TestRunDetailsPageURL: sleResp.TestRunDetailsPageURL,
+		RuntimeConfig:         sleResp.RuntimeConfig,
+	}, nil
+}
diff --git a/internal/cloudapi/provisioning/test/server.go b/internal/cloudapi/provisioning/test/server.go
new file mode 100644
index 000000000..4701bc806
--- /dev/null
+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,237 @@
+package provtest
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	// DefaultLoadTestID is the default load test id used by the test server.
+	DefaultLoadTestID int64 = 456
+	// DefaultTestRunID is the default test run id used by the test server.
+	DefaultTestRunID int64 = 123
+	// PresignedUploadPath is the presigned upload URL path used in tests.
+	PresignedUploadPath string = "/presigned/upload"
+)
+
+// DefaultStartLocalExecutionResponse constructs a default StartLocalExecutionTestResponse for tests.
+func DefaultStartLocalExecutionResponse() *k6cloud.StartLocalExecutionTestResponse {
+	resp := k6cloud.NewStartLocalExecutionTestResponseWithDefaults()
+	resp.SetTestRunId(DefaultTestRunID)
+	archiveURL := "https://s3.amazonaws.com/k6-archives/fake-upload"
+	resp.ArchiveUploadUrl = *k6cloud.NewNullableString(&archiveURL)
+	resp.SetTestRunDetailsPageUrl("https://app.k6.io/runs/123")
+
+	rc := k6cloud.NewRuntimeConfigWithDefaults()
+	rc.SetTestRunToken("test-run-token-abc")
+
+	mc := k6cloud.NewMetricsRuntimeConfigWithDefaults()
+	mc.SetPushUrl("https://ingest.k6.io/v1/metrics")
+	pushInterval := "2s"
+	mc.PushInterval = *k6cloud.NewNullableString(&pushInterval)
+	pushConcurrency := int32(5)
+	mc.PushConcurrency = *k6cloud.NewNullableInt32(&pushConcurrency)
+	aggregationPeriod := "3s"
+	mc.AggregationPeriod = *k6cloud.NewNullableString(&aggregationPeriod)
+	aggregationWaitPeriod := "1s"
+	mc.AggregationWaitPeriod = *k6cloud.NewNullableString(&aggregationWaitPeriod)
+	maxSamples := int32(2000)
+	mc.MaxSamplesPerPackage = *k6cloud.NewNullableInt32(&maxSamples)
+	rc.SetMetrics(*mc)
+
+	sc := k6cloud.NewSecretsRuntimeConfigWithDefaults()
+	sc.SetEndpoint("https://api.k6.io/provisioning/v1/test_runs/123/decrypt_secret?name={key}")
+	sc.SetResponsePath("plaintext")
+	rc.SetSecrets(*sc)
+
+	resp.SetRuntimeConfig(*rc)
+	return resp
+}
+
+// Server is a test HTTP server for the provisioning API.
+type Server struct {
+	*httptest.Server
+	URL string
+	Mux *http.ServeMux
+
+	mu                     sync.Mutex
+	fetchTestRunHits       atomic.Int32
+	startLocalExecHandlers map[int64]http.HandlerFunc
+	presignedHandlers      map[string]http.HandlerFunc
+	createLoadTestHandlers map[int64]http.HandlerFunc
+	fetchTestRunProgress   map[int64][]v6.TestProgress
+	fetchTestRunIndex      map[int64]int
+	notifyHandlers         map[int64]http.HandlerFunc
+}
+
+// NewServer creates a new fake provisioning server for tests.
+func NewServer(t testing.TB) *Server {
+	s := &Server{
+		Mux:                    http.NewServeMux(),
+		startLocalExecHandlers: make(map[int64]http.HandlerFunc),
+		presignedHandlers:      make(map[string]http.HandlerFunc),
+		createLoadTestHandlers: make(map[int64]http.HandlerFunc),
+		fetchTestRunProgress:   make(map[int64][]v6.TestProgress),
+		fetchTestRunIndex:      make(map[int64]int),
+		notifyHandlers:         make(map[int64]http.HandlerFunc),
+	}
+
+	ts := httptest.NewServer(http.HandlerFunc(s.dispatch))
+	s.Server = ts
+	s.URL = ts.URL
+	t.Cleanup(ts.Close)
+
+	return s
+}
+
+// PresignedUploadURL returns the absolute URL for presigned upload.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// FetchTestRunHitCount returns the number of times GET /cloud/v6/test_runs/{id} was called.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchTestRunHits.Load()
+}
+
+// HandleStartLocalExecution registers a handler for POST /provisioning/v1/load_tests/{loadTestID}/start_local_execution.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, handler http.HandlerFunc) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.startLocalExecHandlers[loadTestID] = handler
+}
+
+// HandlePresignedUpload registers a handler for requests to the presigned upload path.
+func (s *Server) HandlePresignedUpload(path string, handler http.HandlerFunc) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.presignedHandlers[path] = handler
+}
+
+// HandleCreateLoadTest registers a handler for /cloud/v6/projects/{projectID}/load_tests.
+func (s *Server) HandleCreateLoadTest(projectID int64, handler http.HandlerFunc) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.createLoadTestHandlers[projectID] = handler
+}
+
+// HandleFetchTestRun sets up the test progress sequence for GET /cloud/v6/test_runs/{testRunID}.
+func (s *Server) HandleFetchTestRun(testRunID int64, progresses []v6.TestProgress) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.fetchTestRunProgress[testRunID] = progresses
+	s.fetchTestRunIndex[testRunID] = 0
+}
+
+// HandleNotify registers a handler for POST /provisioning/v1/test_runs/{testRunID}/notify.
+func (s *Server) HandleNotify(testRunID int64, handler http.HandlerFunc) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.notifyHandlers[testRunID] = handler
+}
+
+func (s *Server) dispatch(w http.ResponseWriter, r *http.Request) {
+	s.mu.Lock()
+
+	// Check presigned upload handlers
+	for path, handler := range s.presignedHandlers {
+		if r.URL.Path == path {
+			s.mu.Unlock()
+			handler(w, r)
+			return
+		}
+	}
+
+	// Check start local execution: /provisioning/v1/load_tests/{id}/start_local_execution
+	if strings.HasPrefix(r.URL.Path, "/provisioning/v1/load_tests/") && strings.HasSuffix(r.URL.Path, "/start_local_execution") {
+		trimmed := strings.TrimPrefix(r.URL.Path, "/provisioning/v1/load_tests/")
+		trimmed = strings.TrimSuffix(trimmed, "/start_local_execution")
+		id, err := strconv.ParseInt(trimmed, 10, 64)
+		if err == nil {
+			if handler, ok := s.startLocalExecHandlers[id]; ok {
+				s.mu.Unlock()
+				handler(w, r)
+				return
+			}
+		}
+	}
+
+	// Check create load test: /cloud/v6/projects/{id}/load_tests
+	if strings.HasPrefix(r.URL.Path, "/cloud/v6/projects/") && strings.HasSuffix(r.URL.Path, "/load_tests") {
+		trimmed := strings.TrimPrefix(r.URL.Path, "/cloud/v6/projects/")
+		trimmed = strings.TrimSuffix(trimmed, "/load_tests")
+		id, err := strconv.ParseInt(trimmed, 10, 64)
+		if err == nil {
+			if handler, ok := s.createLoadTestHandlers[id]; ok {
+				s.mu.Unlock()
+				handler(w, r)
+				return
+			}
+		}
+	}
+
+	// Check fetch test run: /cloud/v6/test_runs/{id}
+	if strings.HasPrefix(r.URL.Path, "/cloud/v6/test_runs/") && !strings.HasSuffix(r.URL.Path, "/notify") && !strings.HasSuffix(r.URL.Path, "/abort") {
+		trimmed := strings.TrimPrefix(r.URL.Path, "/cloud/v6/test_runs/")
+		id, err := strconv.ParseInt(trimmed, 10, 64)
+		if err == nil {
+			if progs, ok := s.fetchTestRunProgress[id]; ok && len(progs) > 0 {
+				idx := s.fetchTestRunIndex[id]
+				var p v6.TestProgress
+				if idx < len(progs) {
+					p = progs[idx]
+					s.fetchTestRunIndex[id] = idx + 1
+				} else {
+					p = progs[len(progs)-1]
+				}
+				s.mu.Unlock()
+				s.fetchTestRunHits.Add(1)
+
+				res := k6cloud.NewTestRunApiModelWithDefaults()
+				res.SetStatus(p.Status.String())
+				res.SetResult(p.Result.String())
+				res.SetEstimatedDuration(p.EstimatedDuration)
+				res.SetExecutionDuration(p.ExecutionDuration)
+				res.SetStatusHistory(v6.ToStatusModel(p.StatusHistory))
+				res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+				res.SetResultDetails(k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(k6cloud.NewResultDetailsApiModel("")))
+				res.SetOptions(map[string]any{})
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(http.StatusOK)
+				_ = json.NewEncoder(w).Encode(res)
+				return
+			}
+		}
+	}
+
+	// Check notify: /provisioning/v1/test_runs/{id}/notify
+	if strings.HasPrefix(r.URL.Path, "/provisioning/v1/test_runs/") && strings.HasSuffix(r.URL.Path, "/notify") {
+		trimmed := strings.TrimPrefix(r.URL.Path, "/provisioning/v1/test_runs/")
+		trimmed = strings.TrimSuffix(trimmed, "/notify")
+		id, err := strconv.ParseInt(trimmed, 10, 64)
+		if err == nil {
+			if handler, ok := s.notifyHandlers[id]; ok {
+				s.mu.Unlock()
+				handler(w, r)
+				return
+			}
+		}
+	}
+
+	s.mu.Unlock()
+	if s.Mux != nil {
+		s.Mux.ServeHTTP(w, r)
+		return
+	}
+	http.NotFound(w, r)
+}
