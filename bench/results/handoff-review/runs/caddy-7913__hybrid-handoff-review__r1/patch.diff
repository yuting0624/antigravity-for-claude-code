+package timeouts
+
+import (
+	"testing"
+	"time"
+
+	"github.com/caddyserver/caddy/v2/caddyconfig/caddyfile"
+	"github.com/caddyserver/caddy/v2/caddyconfig/httpcaddyfile"
+)
+
+func TestParseCaddyfile(t *testing.T) {
+	tests := []struct {
+		name          string
+		input         string
+		expectedRead  time.Duration
+		expectedReadR int64
+		expectedWrite time.Duration
+		expectedWritR int64
+		expectedChunk int
+	}{
+		{
+			name: "block syntax full",
+			input: `timeouts {
+				read_timeout 30s 1000
+				write_timeout 45s 2000
+				write_max_chunk 32KiB
+			}`,
+			expectedRead:  30 * time.Second,
+			expectedReadR: 1000,
+			expectedWrite: 45 * time.Second,
+			expectedWritR: 2000,
+			expectedChunk: 32 * 1024,
+		},
+		{
+			name: "block syntax defaults",
+			input: `timeouts {
+				read_timeout
+				write_timeout
+			}`,
+			expectedRead:  time.Minute,
+			expectedReadR: 0,
+			expectedWrite: time.Minute,
+			expectedWritR: 0,
+			expectedChunk: 0,
+		},
+		{
+			name:          "inline syntax",
+			input:         `timeouts 15s 25s`,
+			expectedRead:  15 * time.Second,
+			expectedReadR: 0,
+			expectedWrite: 25 * time.Second,
+			expectedWritR: 0,
+			expectedChunk: 0,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			d := caddyfile.NewTestDispenser(tc.input)
+			h := httpcaddyfile.Helper{Dispenser: d}
+			handler, err := parseCaddyfile(h)
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			tm, ok := handler.(*Timeouts)
+			if !ok {
+				t.Fatalf("expected *Timeouts, got %T", handler)
+			}
+			if tm.ReadTimeout != tc.expectedRead {
+				t.Errorf("expected ReadTimeout %v, got %v", tc.expectedRead, tm.ReadTimeout)
+			}
+			if tm.ReadMinRate != tc.expectedReadR {
+				t.Errorf("expected ReadMinRate %v, got %v", tc.expectedReadR, tm.ReadMinRate)
+			}
+			if tm.WriteTimeout != tc.expectedWrite {
+				t.Errorf("expected WriteTimeout %v, got %v", tc.expectedWrite, tm.WriteTimeout)
+			}
+			if tm.WriteMinRate != tc.expectedWritR {
+				t.Errorf("expected WriteMinRate %v, got %v", tc.expectedWritR, tm.WriteMinRate)
+			}
+			if tm.MaxWriteChunk != tc.expectedChunk {
+				t.Errorf("expected MaxWriteChunk %v, got %v", tc.expectedChunk, tm.MaxWriteChunk)
+			}
+		})
+	}
+}
