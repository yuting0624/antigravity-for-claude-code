+
+func TestServerTimeoutsIdleOptions(t *testing.T) {
+	input := `{
+		servers {
+			timeouts {
+				read_body_idle 30s 1000
+				write_idle 45s 2000
+				write_max_chunk 32KiB
+			}
+		}
+	}
+	:8080 {
+		respond "OK"
+	}`
+
+	adapter := caddyfile.Adapter{
+		ServerType: ServerType{},
+	}
+
+	out, _, err := adapter.Adapt([]byte(input), nil)
+	if err != nil {
+		t.Fatalf("adapting Caddyfile: %v", err)
+	}
+
+	var config struct {
+		Apps struct {
+			HTTP struct {
+				Servers map[string]*caddyhttp.Server `json:"servers"`
+			} `json:"http"`
+		} `json:"apps"`
+	}
+
+	if err := json.Unmarshal(out, &config); err != nil {
+		t.Fatalf("unmarshaling adapted config: %v", err)
+	}
+
+	srv, ok := config.Apps.HTTP.Servers["srv0"]
+	if !ok {
+		t.Fatalf("expected srv0 in servers, got %#v", config.Apps.HTTP.Servers)
+	}
+
+	if srv.ReadIdleTimeout != caddy.Duration(30*time.Second) {
+		t.Errorf("expected ReadIdleTimeout 30s, got %v", srv.ReadIdleTimeout)
+	}
+	if srv.ReadMinRate != 1000 {
+		t.Errorf("expected ReadMinRate 1000, got %v", srv.ReadMinRate)
+	}
+	if srv.WriteIdleTimeout != caddy.Duration(45*time.Second) {
+		t.Errorf("expected WriteIdleTimeout 45s, got %v", srv.WriteIdleTimeout)
+	}
+	if srv.WriteMinRate != 2000 {
+		t.Errorf("expected WriteMinRate 2000, got %v", srv.WriteMinRate)
+	}
+	if srv.MaxWriteChunk != 32*1024 {
+		t.Errorf("expected MaxWriteChunk 32768, got %v", srv.MaxWriteChunk)
+	}
+}
+
+func TestServerTimeoutsIdleDefaults(t *testing.T) {
