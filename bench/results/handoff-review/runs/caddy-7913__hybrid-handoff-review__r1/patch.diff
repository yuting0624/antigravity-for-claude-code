 }
+
+func TestServer_EnforcementHandler_IdleTimeout(t *testing.T) {
+	s := &Server{
+		ReadIdleTimeout:  caddy.Duration(time.Minute),
+		WriteIdleTimeout: caddy.Duration(time.Minute),
+		MaxWriteChunk:    32 * 1024,
+	}
+	req := httptest.NewRequest("POST", "/", strings.NewReader("hello"))
+	rec := httptest.NewRecorder()
+
+	var wrappedReqBody io.ReadCloser
+	var wrappedWriter http.ResponseWriter
+	err := s.enforcementHandler(rec, req, HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		wrappedReqBody = r.Body
+		wrappedWriter = w
+		return nil
+	}))
+	require.NoError(t, err)
+
+	_, okR := wrappedReqBody.(*IdleTimeoutReader)
+	assert.True(t, okR, "request body should be wrapped in IdleTimeoutReader")
+
+	_, okW := wrappedWriter.(*IdleTimeoutWriter)
+	assert.True(t, okW, "response writer should be wrapped in IdleTimeoutWriter")
+}
+
+func TestServer_EnforcementHandler_NoIdleTimeout(t *testing.T) {
+	s := &Server{}
+	req := httptest.NewRequest("POST", "/", strings.NewReader("hello"))
+	rec := httptest.NewRecorder()
+
+	var wrappedReqBody io.ReadCloser
+	var wrappedWriter http.ResponseWriter
+	err := s.enforcementHandler(rec, req, HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		wrappedReqBody = r.Body
+		wrappedWriter = w
+		return nil
+	}))
+	require.NoError(t, err)
+
+	_, okR := wrappedReqBody.(*IdleTimeoutReader)
+	assert.False(t, okR, "request body should not be wrapped when idle timeouts not set")
+
+	_, okW := wrappedWriter.(*IdleTimeoutWriter)
+	assert.False(t, okW, "response writer should not be wrapped when idle timeouts not set")
+}
