+func parseRate(rateStr string) (int64, error) {
+	s := strings.TrimSuffix(strings.TrimSuffix(rateStr, "/s"), "/sec")
+	size, err := humanize.ParseBytes(s)
+	if err != nil {
+		val, err2 := strconv.ParseInt(s, 10, 64)
+		if err2 != nil {
