+	}
+
+	out, _, err := adapter.Adapt([]byte(input), nil)
+	if err != nil {
+		t.Fatalf("adapting Caddyfile: %v", err)
+	}
+
+	var config struct {
+		Apps struct {
+			HTTP struct {
+				Servers map[string]*caddyhttp.Server `json:"servers"`
+			} `json:"http"`
+		} `json:"apps"`
+	}
+
+	if err := json.Unmarshal(out, &config); err != nil {
+		t.Fatalf("unmarshaling adapted config: %v", err)
+	}
+
+	srv, ok := config.Apps.HTTP.Servers["srv0"]
+	if !ok {
+		t.Fatalf("expected srv0 in servers, got %#v", config.Apps.HTTP.Servers)
+	}
+
+	if srv.ReadIdleTimeout != caddy.Duration(time.Minute) {
+		t.Errorf("expected ReadIdleTimeout 1m, got %v", srv.ReadIdleTimeout)
+	}
+	if srv.ReadMinRate != 0 {
+		t.Errorf("expected ReadMinRate 0, got %v", srv.ReadMinRate)
+	}
+	if srv.WriteIdleTimeout != caddy.Duration(time.Minute) {
