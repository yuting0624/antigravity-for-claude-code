+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/caddyconfig/httpcaddyfile"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func init() {
+	httpcaddyfile.RegisterHandlerDirective("timeouts", parseCaddyfile)
+}
+
+func parseCaddyfile(h httpcaddyfile.Helper) (caddyhttp.MiddlewareHandler, error) {
+	h.Next() // consume directive name
+
+	t := new(Timeouts)
+
+	args := h.RemainingArgs()
+	if len(args) > 0 {
+		dur, err := caddy.ParseDuration(args[0])
+		if err != nil {
+			return nil, h.Errf("parsing read_timeout duration: %v", err)
+		}
+		t.ReadTimeout = time.Duration(dur)
+		if len(args) > 1 {
+			dur2, err := caddy.ParseDuration(args[1])
+			if err != nil {
+				return nil, h.Errf("parsing write_timeout duration: %v", err)
+			}
+			t.WriteTimeout = time.Duration(dur2)
+		}
+		if len(args) > 2 {
+			return nil, h.ArgErr()
+		}
+	}
+
+	for h.NextBlock(0) {
+		switch h.Val() {
+		case "read_timeout":
+			subArgs := h.RemainingArgs()
+			dur := time.Minute
+			if len(subArgs) > 0 {
+				cdur, err := caddy.ParseDuration(subArgs[0])
+				if err != nil {
+					return nil, h.Errf("parsing read_timeout duration: %v", err)
+				}
+				dur = time.Duration(cdur)
+			}
+			t.ReadTimeout = dur
+			if len(subArgs) > 1 {
+				rate, err := parseRate(subArgs[1])
+				if err != nil {
+					return nil, h.Errf("parsing read_timeout rate: %v", err)
+				}
+				t.ReadMinRate = rate
+			}
+			if len(subArgs) > 2 {
+				return nil, h.ArgErr()
+			}
+
+		case "write_timeout":
+			subArgs := h.RemainingArgs()
+			dur := time.Minute
+			if len(subArgs) > 0 {
+				cdur, err := caddy.ParseDuration(subArgs[0])
+				if err != nil {
+					return nil, h.Errf("parsing write_timeout duration: %v", err)
+				}
+				dur = time.Duration(cdur)
+			}
+			t.WriteTimeout = dur
+			if len(subArgs) > 1 {
+				rate, err := parseRate(subArgs[1])
+				if err != nil {
+					return nil, h.Errf("parsing write_timeout rate: %v", err)
+				}
+				t.WriteMinRate = rate
+			}
+			if len(subArgs) > 2 {
+				return nil, h.ArgErr()
+			}
+
+		case "write_max_chunk":
+			var sizeStr string
+			if !h.AllArgs(&sizeStr) {
+				return nil, h.ArgErr()
+			}
+			size, err := humanize.ParseBytes(sizeStr)
+			if err != nil {
+				return nil, h.Errf("parsing write_max_chunk size: %v", err)
+			}
+			t.MaxWriteChunk = int(size)
+
+		default:
+			return nil, h.Errf("unrecognized timeouts subdirective '%s'", h.Val())
+		}
+	}
+
+	return t, nil
+}
+
+func parseRate(rateStr string) (int64, error) {
+	s := strings.TrimSuffix(strings.TrimSuffix(rateStr, "/s"), "/sec")
+	size, err := humanize.ParseBytes(s)
+	if err != nil {
+		val, err2 := strconv.ParseInt(s, 10, 64)
+		if err2 != nil {
+			return 0, err
+		}
+		return val, nil
+	}
+	return int64(size), nil
+}
