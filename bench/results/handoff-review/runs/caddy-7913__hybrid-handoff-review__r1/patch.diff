+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package caddyhttp
+
+import (
+	"errors"
+	"io"
+	"math"
+	"net/http"
+	"os"
+	"time"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+)
+
+// DefaultMaxWriteChunk is the default maximum size in bytes for a single
+// underlying write or ReadFrom call when idle timeout or chunking is enabled.
+const DefaultMaxWriteChunk = 64 * 1024
+
+// IdleDeadline tracks idle timeout, hard deadline, and minimum transfer rate
+// for an active read or write transfer.
+type IdleDeadline struct {
+	Start        time.Time
+	Timeout      time.Duration
+	HardDeadline time.Time
+	MinRate      int64
+
+	totalBytes int64
+}
+
+func (d *IdleDeadline) rateCredit() time.Duration {
+	if d.MinRate <= 0 || d.totalBytes <= 0 {
+		return 0
+	}
+	secs := float64(d.totalBytes) / float64(d.MinRate)
+	ns := secs * float64(time.Second)
+	if ns >= float64(math.MaxInt64) {
+		return time.Duration(math.MaxInt64)
+	}
+	return time.Duration(ns)
+}
+
+func (d *IdleDeadline) calculate(now time.Time) time.Time {
+	if d.Start.IsZero() {
+		d.Start = now
+	}
+
+	var deadline time.Time
+
+	if d.Timeout > 0 {
+		deadline = now.Add(d.Timeout)
+	}
+
+	if d.MinRate > 0 {
+		rateDeadline := d.Start.Add(d.Timeout + d.rateCredit())
+		if deadline.IsZero() || rateDeadline.Before(deadline) {
+			deadline = rateDeadline
+		}
+	}
+
+	if !d.HardDeadline.IsZero() {
+		if deadline.IsZero() || d.HardDeadline.Before(deadline) {
+			deadline = d.HardDeadline
+		}
+	}
+
+	return deadline
+}
+
+// IdleTimeoutReader wraps an io.ReadCloser to enforce idle timeouts and minimum transfer rates.
+type IdleTimeoutReader struct {
+	ReadCloser io.ReadCloser
+	Ctrl       *http.ResponseController
+	Deadline   IdleDeadline
+	Logger     *zap.Logger
+}
+
+func (r *IdleTimeoutReader) Read(p []byte) (int, error) {
+	if r.Ctrl != nil {
+		now := time.Now()
+		deadline := r.Deadline.calculate(now)
+		if !deadline.IsZero() {
+			if !now.Before(deadline) {
+				return 0, os.ErrDeadlineExceeded
+			}
+			err := r.Ctrl.SetReadDeadline(deadline)
+			if err != nil && !errors.Is(err, http.ErrNotSupported) {
+				if r.Logger != nil {
+					if c := r.Logger.Check(zapcore.DebugLevel, "setting read deadline"); c != nil {
+						c.Write(zap.Error(err))
+					}
+				}
+				return 0, err
+			}
+		}
+	}
+	n, err := r.ReadCloser.Read(p)
+	if n > 0 {
+		r.Deadline.totalBytes += int64(n)
+	}
+	return n, err
+}
+
+func (r *IdleTimeoutReader) Close() error {
+	if r.ReadCloser != nil {
+		return r.ReadCloser.Close()
+	}
+	return nil
+}
+
+// IdleTimeoutWriter wraps an http.ResponseWriter to chunk large writes and enforce idle timeouts
+// and minimum transfer rates.
+type IdleTimeoutWriter struct {
+	*ResponseWriterWrapper
+	Ctrl     *http.ResponseController
+	Deadline IdleDeadline
+	MaxChunk int
+	Logger   *zap.Logger
+}
+
+func (w *IdleTimeoutWriter) Unwrap() http.ResponseWriter {
+	return w.ResponseWriterWrapper
+}
+
+func (w *IdleTimeoutWriter) setWriteDeadline() error {
+	if w.Ctrl == nil {
+		return nil
+	}
+	now := time.Now()
+	deadline := w.Deadline.calculate(now)
+	if deadline.IsZero() {
+		return nil
+	}
+	if !now.Before(deadline) {
+		return os.ErrDeadlineExceeded
+	}
+	err := w.Ctrl.SetWriteDeadline(deadline)
+	if err != nil && !errors.Is(err, http.ErrNotSupported) {
+		if w.Logger != nil {
+			if c := w.Logger.Check(zapcore.DebugLevel, "setting write deadline"); c != nil {
+				c.Write(zap.Error(err))
+			}
+		}
+		return err
+	}
+	return nil
+}
+
+func (w *IdleTimeoutWriter) Write(p []byte) (int, error) {
+	chunkSize := w.MaxChunk
+	if chunkSize <= 0 {
+		chunkSize = DefaultMaxWriteChunk
+	}
+	if len(p) == 0 {
+		return w.ResponseWriterWrapper.Write(p)
+	}
+
+	var total int
+	for len(p) > 0 {
+		n := len(p)
+		if n > chunkSize {
+			n = chunkSize
+		}
+		chunk := p[:n]
+
+		if err := w.setWriteDeadline(); err != nil {
+			return total, err
+		}
+
+		m, err := w.ResponseWriterWrapper.Write(chunk)
+		if m > 0 {
+			total += m
+			w.Deadline.totalBytes += int64(m)
+		}
+		if err != nil {
+			return total, err
+		}
+		p = p[m:]
+	}
+	return total, nil
+}
+
+func (w *IdleTimeoutWriter) ReadFrom(r io.Reader) (int64, error) {
+	chunkSize := w.MaxChunk
+	if chunkSize <= 0 {
+		chunkSize = DefaultMaxWriteChunk
+	}
+
+	var total int64
+	for {
+		if err := w.setWriteDeadline(); err != nil {
+			return total, err
+		}
+
+		lr := io.LimitReader(r, int64(chunkSize))
+		n, err := w.ResponseWriterWrapper.ReadFrom(lr)
+		if n > 0 {
+			total += n
+			w.Deadline.totalBytes += n
+		}
+		if err != nil {
+			if errors.Is(err, io.EOF) {
+				return total, nil
+			}
+			return total, err
+		}
+		if n < int64(chunkSize) {
+			break
+		}
+	}
+	return total, nil
+}
diff --git a/modules/caddyhttp/server.go b/modules/caddyhttp/server.go
index d8077463b..d55a9ca67 100644
--- a/modules/caddyhttp/server.go
+++ b/modules/caddyhttp/server.go
@@ -79,6 +79,21 @@ type Server struct {
 	// 5m is applied to help avoid resource exhaustion.
 	IdleTimeout caddy.Duration `json:"idle_timeout,omitempty"`
 
+	// How long to allow an idle read from a client's upload.
+	ReadIdleTimeout caddy.Duration `json:"read_idle_timeout,omitempty"`
+
+	// How long to allow an idle write to a client.
+	WriteIdleTimeout caddy.Duration `json:"write_idle_timeout,omitempty"`
+
+	// ReadMinRate is the minimum rate in bytes per second for reading request bodies.
+	ReadMinRate int64 `json:"read_min_rate,omitempty"`
+
+	// WriteMinRate is the minimum rate in bytes per second for writing responses.
+	WriteMinRate int64 `json:"write_min_rate,omitempty"`
+
+	// MaxWriteChunk is the maximum size in bytes for a write chunk.
+	MaxWriteChunk int `json:"max_write_chunk,omitempty"`
+
 	// KeepAliveInterval is the interval at which TCP keepalive packets
 	// are sent to keep the connection alive at the TCP layer when no other
 	// data is being transmitted.
@@ -807,6 +822,47 @@ func (s *Server) enforcementHandler(w http.ResponseWriter, r *http.Request, next
 			return Error(http.StatusMisdirectedRequest, err)
 		}
 	}
+
+	var rc *http.ResponseController
+	if s.ReadIdleTimeout > 0 || s.WriteIdleTimeout > 0 || s.ReadMinRate > 0 || s.WriteMinRate > 0 || s.MaxWriteChunk > 0 {
+		rc = http.NewResponseController(w)
+	}
+
+	if (s.ReadIdleTimeout > 0 || s.ReadMinRate > 0) && r.Body != nil {
+		var hardDeadline time.Time
+		if s.ReadTimeout > 0 {
+			hardDeadline = time.Now().Add(time.Duration(s.ReadTimeout))
+		}
+		r.Body = &IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       rc,
+			Deadline: IdleDeadline{
+				Timeout:      time.Duration(s.ReadIdleTimeout),
+				HardDeadline: hardDeadline,
+				MinRate:      s.ReadMinRate,
+			},
+			Logger: s.logger,
+		}
+	}
+
+	if s.WriteIdleTimeout > 0 || s.WriteMinRate > 0 || s.MaxWriteChunk > 0 {
+		var hardDeadline time.Time
+		if s.WriteTimeout > 0 {
+			hardDeadline = time.Now().Add(time.Duration(s.WriteTimeout))
+		}
+		w = &IdleTimeoutWriter{
+			ResponseWriterWrapper: &ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  rc,
+			Deadline: IdleDeadline{
+				Timeout:      time.Duration(s.WriteIdleTimeout),
+				HardDeadline: hardDeadline,
+				MinRate:      s.WriteMinRate,
+			},
+			MaxChunk: s.MaxWriteChunk,
+			Logger:   s.logger,
+		}
+	}
+
 	return next.ServeHTTP(w, r)
 }
 
