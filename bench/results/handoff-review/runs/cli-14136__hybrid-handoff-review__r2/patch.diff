+// WorktreeAdd adds a worktree at path for the given branch. If trackingRef is non-empty,
+// the branch is created as a tracking branch from trackingRef.
+func (c *Client) WorktreeAdd(ctx context.Context, path, branch, trackingRef string, mods ...CommandModifier) error {
+	var args []string
+	if trackingRef != "" {
+		args = []string{"worktree", "add", "--track", "-b", branch, "--", path, trackingRef}
+	} else {
+		args = []string{"worktree", "add", "--", path, branch}
+	}
+	cmd, err := c.Command(ctx, args...)
+	if err != nil {
+		return err
+	}
+	for _, mod := range mods {
+		mod(cmd)
+	}
+	_, err = cmd.Output()
+	return err
+}
