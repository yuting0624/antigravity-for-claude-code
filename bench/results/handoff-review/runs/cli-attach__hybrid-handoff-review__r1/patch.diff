+package attachments
+
+import (
+	"net/http"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/httpmock"
+)
+
+type UploadStub struct {
+	Name   string
+	Status int
+	Body   string
+}
+
+func StubUpload(reg *httpmock.Registry, repoID int64, name string, status int, body string) {
+	StubUploadToHost(nil, reg, "", repoID, name, status, body)
+}
+
+func StubUploadToHost(t *testing.T, reg *httpmock.Registry, host string, repoID int64, name string, status int, body string) {
+	reg.Register(func(req *http.Request) bool {
+		if !strings.EqualFold(req.Method, "POST") {
+			return false
+		}
+		if host != "" {
+			if !strings.EqualFold(req.Host, host) && !strings.EqualFold(req.URL.Host, host) {
+				return false
+			}
+		}
+		if req.URL.Path != "/user-attachments/assets" {
+			return false
+		}
+		if name != "" && req.URL.Query().Get("name") != name {
+			return false
+		}
+		if repoID > 0 && req.URL.Query().Get("repository_id") != strconv.FormatInt(repoID, 10) {
+			return false
+		}
+		return true
+	}, httpmock.StatusStringResponse(status, body))
+}
+
+func NewTestAssets(t *testing.T, specs ...string) []UserAsset {
+	t.Helper()
+	dir := t.TempDir()
+	origDir, err := os.Getwd()
+	if err == nil {
+		t.Cleanup(func() { _ = os.Chdir(origDir) })
+	}
+	if err := os.Chdir(dir); err != nil {
+		t.Fatalf("failed to chdir to temp dir: %v", err)
+	}
+
+	assets := make([]UserAsset, 0, len(specs))
+	for _, spec := range specs {
+		path, alt := parseTestAssetSpec(spec)
+		if !filepath.IsAbs(path) && !strings.HasPrefix(path, ".") {
+			path = "./" + path
+		}
+		if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+			t.Fatalf("failed to create dir for %s: %v", path, err)
+		}
+		if err := os.WriteFile(path, []byte("test attachment content"), 0600); err != nil {
+			t.Fatalf("failed to write test asset %s: %v", path, err)
+		}
+		a, err := newAsset(path, alt)
+		if err != nil {
+			t.Fatalf("failed to create asset for %s: %v", spec, err)
+		}
+		assets = append(assets, a)
+	}
+	return assets
+}
+
+func parseTestAssetSpec(raw string) (string, string) {
+	if strings.Contains(raw, "#") {
+		lastHash := strings.LastIndex(raw, "#")
+		prefix := raw[:lastHash]
+		if filepath.Ext(prefix) != "" {
+			return prefix, raw[lastHash+1:]
+		}
+	}
+	return raw, ""
+}
diff --git a/internal/attachments/userasset.go b/internal/attachments/userasset.go
