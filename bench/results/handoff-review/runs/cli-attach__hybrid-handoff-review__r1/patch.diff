new file mode 100644
index 000000000..beec06c2c
--- /dev/null
+++ b/internal/attachments/flags.go
@@ -0,0 +1,77 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+)
+
+const flagName = "attach"
+
+type Flag struct {
+	flag   *pflag.Flag
+	values []string
+}
+
+func AddFlag(cmd *cobra.Command) *Flag {
+	f := &Flag{}
+	cmd.Flags().StringArrayVar(&f.values, flagName, nil, "Attach an image or video `file`, in '<file>#<image alt text>' format")
+	f.flag = cmd.Flags().Lookup(flagName)
+	return f
+}
+
+func (f *Flag) Changed() bool {
+	return f != nil && f.flag != nil && f.flag.Changed
+}
+
+func (f *Flag) UserAssets() ([]UserAsset, error) {
+	if f == nil || !f.Changed() {
+		return nil, nil
+	}
+	if len(f.values) == 0 {
+		return nil, errors.New("cannot attach an empty path; --attach needs a file path")
+	}
+	var assets []UserAsset
+	for _, raw := range f.values {
+		if raw == "" {
+			return nil, errors.New("cannot attach an empty path; --attach needs a file path")
+		}
+		if raw == "-" {
+			return nil, errors.New("cannot attach standard input; --attach needs a file path")
+		}
+		path, alt := parseAttachmentArg(raw)
+		a, err := newAsset(path, alt)
+		if err != nil {
+			return nil, err
+		}
+		for _, prev := range assets {
+			if os.SameFile(prev.getAsset().info, a.getAsset().info) {
+				return nil, fmt.Errorf("%s and %s are the same file; attached files must be unique", prev.Path(), a.Path())
+			}
+		}
+		assets = append(assets, a)
+	}
+	return assets, nil
+}
+
+func parseAttachmentArg(raw string) (string, string) {
+	if _, err := os.Stat(raw); err == nil {
+		return raw, ""
+	}
+	for i := len(raw) - 1; i >= 0; i-- {
+		if raw[i] == '#' {
+			prefix := raw[:i]
+			if _, err := os.Stat(prefix); err == nil {
+				return prefix, raw[i+1:]
+			}
+		}
+	}
+	if last := strings.LastIndex(raw, "#"); last != -1 {
+		return raw[:last], raw[last+1:]
+	}
+	return raw, ""
+}
diff --git a/internal/attachments/references.go b/internal/attachments/references.go
new file mode 100644
index 000000000..20146635e
--- /dev/null
+++ b/internal/attachments/references.go
@@ -0,0 +1,610 @@
+package attachments
+
+import (
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/yuin/goldmark"
+	"github.com/yuin/goldmark/ast"
+	"github.com/yuin/goldmark/parser"
+	"github.com/yuin/goldmark/text"
+)
+
+type attachmentArg struct {
+	Path            string
+	URL             string
+	Alt             string
+	RendersAsPlayer bool
+}
+
+type validatedMarkdown struct {
+	markdown       string
+	attachmentArgs []attachmentArg
+}
+
+type attachResult struct {
+	Rewritten string
+	ToAppend  []attachmentArg
+}
+
+func newAttachableMarkdown(markdown string, attachmentArgs []attachmentArg) (validatedMarkdown, error) {
+	pc := parser.NewContext()
+	doc := goldmark.DefaultParser().Parse(text.NewReader([]byte(markdown)), parser.WithContext(pc))
+
+	var offending []string
+	seenOffending := make(map[string]bool)
+
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		img, ok := n.(*ast.Image)
+		if !ok || img.Reference == nil {
+			return ast.WalkContinue, nil
+		}
+
+		dest := string(img.Destination)
+		arg := findMatchingArg(dest, attachmentArgs)
+		if arg != nil && arg.RendersAsPlayer {
+			if !seenOffending[arg.Path] {
+				seenOffending[arg.Path] = true
+				offending = append(offending, arg.Path)
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+
+	if len(offending) > 0 {
+		return validatedMarkdown{}, fmt.Errorf("cannot embed a video as a reference-style image: %s", strings.Join(offending, ", "))
+	}
+
+	return validatedMarkdown{
+		markdown:       markdown,
+		attachmentArgs: attachmentArgs,
+	}, nil
+}
+
+func isSingleImage(markdown, url string) bool {
+	doc := goldmark.DefaultParser().Parse(text.NewReader([]byte(markdown)))
+	if doc.ChildCount() != 1 {
+		return false
+	}
+	p, ok := doc.FirstChild().(*ast.Paragraph)
+	if !ok || p.ChildCount() != 1 {
+		return false
+	}
+	img, ok := p.FirstChild().(*ast.Image)
+	if !ok {
+		return false
+	}
+	return string(img.Destination) == url
+}
+
+type textEdit struct {
+	start     int
+	end       int
+	newText   string
+	argPath   string
+	isSwallow bool
+}
+
+var bracketReplacer = strings.NewReplacer(`\`, `\\`, "[", `\[`, "]", `\]`)
+
+func attachAssetsToMarkdown(v validatedMarkdown) (attachResult, error) {
+	if len(v.attachmentArgs) == 0 || v.markdown == "" {
+		return attachResult{
+			Rewritten: v.markdown,
+			ToAppend:  filterValidURLs(v.attachmentArgs),
+		}, nil
+	}
+
+	src := []byte(v.markdown)
+	pc := parser.NewContext()
+	doc := goldmark.DefaultParser().Parse(text.NewReader(src), parser.WithContext(pc))
+
+	referencedMap := collectReferenced(doc, v.attachmentArgs)
+	defEdits := collectDefEdits(src, doc, v.attachmentArgs, referencedMap)
+	inlineEdits := collectInlineEdits(src, doc, v.attachmentArgs)
+
+	edits := append(defEdits, inlineEdits...)
+	return applyEdits(src, edits, v.attachmentArgs), nil
+}
+
+func collectReferenced(doc ast.Node, args []attachmentArg) map[string]bool {
+	referencedMap := make(map[string]bool)
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		switch x := n.(type) {
+		case *ast.Link:
+			if arg := findMatchingArg(string(x.Destination), args); arg != nil {
+				referencedMap[arg.Path] = true
+			}
+		case *ast.Image:
+			if arg := findMatchingArg(string(x.Destination), args); arg != nil {
+				referencedMap[arg.Path] = true
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+	return referencedMap
+}
+
+func collectDefEdits(src []byte, doc ast.Node, args []attachmentArg, referencedMap map[string]bool) []textEdit {
+	var edits []textEdit
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		def, ok := n.(*ast.LinkReferenceDefinition)
+		if !ok || def.Lines().Len() == 0 {
+			return ast.WalkContinue, nil
+		}
+
+		arg := findMatchingArg(string(def.Destination), args)
+		if arg == nil || arg.URL == "" || !referencedMap[arg.Path] {
+			return ast.WalkContinue, nil
+		}
+
+		seg0 := def.Lines().At(0)
+		line0 := string(seg0.Value(src))
+
+		colonIdx := findLabelClosingColon(line0)
+		if colonIdx == -1 {
+			return ast.WalkContinue, nil
+		}
+
+		afterColon := colonIdx + 1
+		for afterColon < len(line0) && (line0[afterColon] == ' ' || line0[afterColon] == '\t') {
+			afterColon++
+		}
+		if afterColon >= len(line0) || line0[afterColon] == '\r' || line0[afterColon] == '\n' {
+			return ast.WalkContinue, nil
+		}
+
+		destStartInLine := afterColon
+		var destEndInLine int
+		if line0[destStartInLine] == '<' {
+			closed := false
+			for j := destStartInLine + 1; j < len(line0); j++ {
+				if line0[j] == '>' && countPrecedingBackslashes(line0[:j])%2 == 0 {
+					destEndInLine = j + 1
+					closed = true
+					break
+				}
+			}
+			if !closed {
+				return ast.WalkContinue, nil
+			}
+		} else {
+			j := destStartInLine
+			for j < len(line0) && line0[j] != ' ' && line0[j] != '\t' && line0[j] != '\r' && line0[j] != '\n' {
+				j++
+			}
+			destEndInLine = j
+		}
+
+		edits = append(edits, textEdit{
+			start:   seg0.Start + destStartInLine,
+			end:     seg0.Start + destEndInLine,
+			newText: arg.URL,
+			argPath: arg.Path,
+		})
+
+		return ast.WalkContinue, nil
+	})
+	return edits
+}
+
+func collectInlineEdits(src []byte, doc ast.Node, args []attachmentArg) []textEdit {
+	var edits []textEdit
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+
+		switch x := n.(type) {
+		case *ast.Link:
+			if x.Reference != nil {
+				return ast.WalkContinue, nil
+			}
+			arg := findMatchingArg(string(x.Destination), args)
+			if arg == nil || arg.URL == "" {
+				return ast.WalkContinue, nil
+			}
+			if destStart, destEnd, ok := findInlineDestinationSpan(src, x.Pos(), false); ok {
+				edits = append(edits, textEdit{
+					start:   destStart,
+					end:     destEnd,
+					newText: arg.URL,
+					argPath: arg.Path,
+				})
+			}
+
+		case *ast.Image:
+			if x.Reference != nil {
+				return ast.WalkContinue, nil
+			}
+			arg := findMatchingArg(string(x.Destination), args)
+			if arg == nil || arg.URL == "" {
+				return ast.WalkContinue, nil
+			}
+
+			if !arg.RendersAsPlayer {
+				if destStart, destEnd, ok := findInlineDestinationSpan(src, x.Pos(), true); ok {
+					edits = append(edits, textEdit{
+						start:   destStart,
+						end:     destEnd,
+						newText: arg.URL,
+						argPath: arg.Path,
+					})
+				}
+			} else {
+				edits = append(edits, videoInlineEdits(src, x, arg)...)
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+	return edits
+}
+
+func videoInlineEdits(src []byte, img *ast.Image, arg *attachmentArg) []textEdit {
+	parentP, isP := img.Parent().(*ast.Paragraph)
+	alone := isP && parentP.ChildCount() == 1
+
+	if alone {
+		nodeStart := img.Pos()
+		nodeEnd, ok := findInlineNodeEnd(src, nodeStart, true)
+		if !ok {
+			return nil
+		}
+		return []textEdit{{
+			start:     nodeStart,
+			end:       nodeEnd,
+			newText:   arg.URL,
+			argPath:   arg.Path,
+			isSwallow: true,
+		}}
+	}
+
+	// Degrade inline video embed to a link.
+	var edits []textEdit
+	if destStart, destEnd, ok := findInlineDestinationSpan(src, img.Pos(), true); ok {
+		edits = append(edits, textEdit{
+			start:   destStart,
+			end:     destEnd,
+			newText: arg.URL,
+			argPath: arg.Path,
+		})
+	}
+
+	// If alt text is empty (![]), insert filename inside [].
+	bracketStart := img.Pos() + 1
+	bracketEnd := findClosingBracket(src, bracketStart)
+	if bracketEnd == bracketStart+1 {
+		fallback := bracketReplacer.Replace(filepath.Base(arg.Path))
+		edits = append(edits, textEdit{
+			start:   bracketEnd,
+			end:     bracketEnd,
+			newText: fallback,
+		})
+	}
+
+	// Remove or escape the leading '!'.
+	bangPos := img.Pos()
+	if bangPos > 0 && src[bangPos-1] == '!' {
+		precedingBackslashes := countPrecedingBackslashes(string(src[:bangPos-1]))
+		if precedingBackslashes%2 == 0 {
+			edits = append(edits, textEdit{
+				start:   bangPos - 1,
+				end:     bangPos + 1,
+				newText: `\!`,
+			})
+		} else {
+			edits = append(edits, textEdit{
+				start:   bangPos,
+				end:     bangPos + 1,
+				newText: "",
+			})
+		}
+	} else {
+		edits = append(edits, textEdit{
+			start:   bangPos,
+			end:     bangPos + 1,
+			newText: "",
+		})
+	}
+
+	return edits
+}
+
+func applyEdits(src []byte, edits []textEdit, args []attachmentArg) attachResult {
+	var filteredEdits []textEdit
+	for _, e := range edits {
+		swallowed := false
+		for _, s := range edits {
+			if s.isSwallow && (s.start != e.start || s.end != e.end) {
+				if e.start >= s.start && e.end <= s.end {
+					swallowed = true
+					break
+				}
+			}
+		}
+		if !swallowed {
+			filteredEdits = append(filteredEdits, e)
+		}
+	}
+	edits = filteredEdits
+
+	sort.SliceStable(edits, func(i, j int) bool {
+		if edits[i].start != edits[j].start {
+			return edits[i].start > edits[j].start
+		}
+		return edits[i].end > edits[j].end
+	})
+
+	attachedMap := make(map[string]bool)
+	curMD := string(src)
+	lastAppliedStart := len(curMD) + 1
+
+	for _, e := range edits {
+		if e.end > lastAppliedStart {
+			continue
+		}
+		curMD = curMD[:e.start] + e.newText + curMD[e.end:]
+		lastAppliedStart = e.start
+		if e.argPath != "" {
+			attachedMap[e.argPath] = true
+		}
+	}
+
+	var toAppend []attachmentArg
+	for _, arg := range args {
+		if arg.URL != "" && !attachedMap[arg.Path] {
+			toAppend = append(toAppend, arg)
+		}
+	}
+
+	return attachResult{
+		Rewritten: curMD,
+		ToAppend:  toAppend,
+	}
+}
+
+func filterValidURLs(args []attachmentArg) []attachmentArg {
+	var res []attachmentArg
+	for _, a := range args {
+		if a.URL != "" {
+			res = append(res, a)
+		}
+	}
+	return res
+}
+
+func isURLOrAnchor(dest string) bool {
+	if strings.HasPrefix(dest, "#") || strings.HasPrefix(dest, "//") {
+		return true
+	}
+	colon := strings.Index(dest, ":")
+	slash := strings.Index(dest, "/")
+	backslash := strings.Index(dest, `\`)
+	firstSlash := -1
+	if slash != -1 && (backslash == -1 || slash < backslash) {
+		firstSlash = slash
+	} else if backslash != -1 {
+		firstSlash = backslash
+	}
+	if colon != -1 && (firstSlash == -1 || colon < firstSlash) {
+		scheme := dest[:colon]
+		if len(scheme) == 1 && ((scheme[0] >= 'a' && scheme[0] <= 'z') || (scheme[0] >= 'A' && scheme[0] <= 'Z')) {
+			return false // Windows drive letter
+		}
+		return true
+	}
+	return false
+}
+
+func unescapeMarkdownChars(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\\' && i+1 < len(s) {
+			next := s[i+1]
+			switch next {
+			case '(', ')', '[', ']', '<', '>', '\\', '"', '\'', '`', '*', '_', '~', '{', '}', '#', '+', '-', '.', '!':
+				b.WriteByte(next)
+				i++
+				continue
+			}
+		}
+		b.WriteByte(s[i])
+	}
+	return b.String()
+}
+
+func findMatchingArg(dest string, args []attachmentArg) *attachmentArg {
+	if isURLOrAnchor(dest) {
+		return nil
+	}
+
+	unescapedMD := unescapeMarkdownChars(dest)
+	unescapedURL, err := url.PathUnescape(unescapedMD)
+	if err != nil {
+		unescapedURL = unescapedMD
+	}
+
+	candidates := []string{dest, unescapedMD, unescapedURL}
+
+	for _, cand := range candidates {
+		for i := range args {
+			arg := &args[i]
+			if cand == arg.Path {
+				return arg
+			}
+			if filepath.Clean(cand) == filepath.Clean(arg.Path) {
+				return arg
+			}
+			if abs1, err1 := filepath.Abs(cand); err1 == nil {
+				if abs2, err2 := filepath.Abs(arg.Path); err2 == nil && abs1 == abs2 {
+					return arg
+				}
+			}
+			if fi1, err1 := os.Stat(cand); err1 == nil {
+				if fi2, err2 := os.Stat(arg.Path); err2 == nil && os.SameFile(fi1, fi2) {
+					return arg
+				}
+			}
+		}
+	}
+	return nil
+}
+
+func findLabelClosingColon(line string) int {
+	bracketDepth := 0
+	for i := 0; i < len(line); i++ {
+		if line[i] == '\\' && i+1 < len(line) {
+			i++
+			continue
+		}
+		if line[i] == '[' {
+			bracketDepth++
+		} else if line[i] == ']' {
+			bracketDepth--
+			if bracketDepth == 0 {
+				if i+1 < len(line) && line[i+1] == ':' {
+					return i + 1
+				}
+			}
+		}
+	}
+	return -1
+}
+
+func countPrecedingBackslashes(s string) int {
+	cnt := 0
+	for i := len(s) - 1; i >= 0 && s[i] == '\\'; i-- {
+		cnt++
+	}
+	return cnt
+}
+
+func findClosingBracket(src []byte, openBracketPos int) int {
+	depth := 0
+	for i := openBracketPos; i < len(src); i++ {
+		if src[i] == '`' {
+			// Skip inline code span
+			end := i + 1
+			for end < len(src) && src[end] != '`' {
+				end++
+			}
+			if end < len(src) {
+				i = end
+				continue
+			}
+		}
+		if src[i] == '\\' && i+1 < len(src) {
+			i++
+			continue
+		}
+		if src[i] == '[' {
+			depth++
+		} else if src[i] == ']' {
+			depth--
+			if depth == 0 {
+				return i
+			}
+		}
+	}
+	return -1
+}
+
+func findInlineDestinationSpan(src []byte, nodePos int, isImage bool) (start, end int, ok bool) {
+	openBracket := nodePos
+	if isImage {
+		openBracket++
+	}
+	if openBracket >= len(src) || src[openBracket] != '[' {
+		return 0, 0, false
+	}
+	closeBracket := findClosingBracket(src, openBracket)
+	if closeBracket == -1 || closeBracket+1 >= len(src) || src[closeBracket+1] != '(' {
+		return 0, 0, false
+	}
+
+	cur := closeBracket + 2
+	for cur < len(src) && (src[cur] == ' ' || src[cur] == '\t' || src[cur] == '\r' || src[cur] == '\n') {
+		cur++
+	}
+	if cur >= len(src) {
+		return 0, 0, false
+	}
+
+	if src[cur] == '<' {
+		destStart := cur
+		for j := destStart + 1; j < len(src); j++ {
+			if src[j] == '>' && countPrecedingBackslashes(string(src[destStart+1:j]))%2 == 0 {
+				return destStart, j + 1, true
+			}
+		}
+		return 0, 0, false
+	}
+
+	destStart := cur
+	parenDepth := 0
+	for j := destStart; j < len(src); j++ {
+		if src[j] == '\\' && j+1 < len(src) {
+			j++
+			continue
+		}
+		if src[j] == '(' {
+			parenDepth++
+		} else if src[j] == ')' {
+			if parenDepth > 0 {
+				parenDepth--
+			} else {
+				return destStart, j, true
+			}
+		} else if src[j] == ' ' || src[j] == '\t' || src[j] == '\r' || src[j] == '\n' {
+			return destStart, j, true
+		}
+	}
+	return 0, 0, false
+}
+
+func findInlineNodeEnd(src []byte, nodePos int, isImage bool) (end int, ok bool) {
+	openBracket := nodePos
+	if isImage {
+		openBracket++
+	}
+	if openBracket >= len(src) || src[openBracket] != '[' {
+		return 0, false
+	}
+	closeBracket := findClosingBracket(src, openBracket)
+	if closeBracket == -1 || closeBracket+1 >= len(src) || src[closeBracket+1] != '(' {
+		return 0, false
+	}
+
+	cur := closeBracket + 2
+	parenDepth := 0
+	for cur < len(src) {
+		if src[cur] == '\\' && cur+1 < len(src) {
+			cur += 2
+			continue
+		}
+		if src[cur] == '(' {
+			parenDepth++
+		} else if src[cur] == ')' {
+			if parenDepth > 0 {
+				parenDepth--
+			} else {
+				return cur + 1, true
+			}
+		}
+		cur++
+	}
+	return 0, false
+}
