+++ b/internal/attachments/userasset.go
@@ -0,0 +1,187 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+const (
+	maxImageBytes int64 = 10 * 1024 * 1024
+	maxVideoBytes int64 = 100 * 1024 * 1024
+)
+
+type UserAsset interface {
+	Path() string
+	getAsset() asset
+	markdown(url string) string
+	rendersAsPlayer() bool
+}
+
+type asset struct {
+	path        string
+	name        string
+	contentType string
+	size        int64
+	alt         string
+	info        os.FileInfo
+}
+
+func (a asset) Name() string {
+	if a.name != "" {
+		return a.name
+	}
+	if a.info != nil {
+		return a.info.Name()
+	}
+	return filepath.Base(a.path)
+}
+
+func (a asset) Size() int64 {
+	if a.size != 0 {
+		return a.size
+	}
+	if a.info != nil {
+		return a.info.Size()
+	}
+	return 0
+}
+
+type imageAsset struct {
+	asset
+}
+
+func (a *imageAsset) Path() string {
+	return a.path
+}
+
+func (a *imageAsset) getAsset() asset {
+	return a.asset
+}
+
+var altReplacer = strings.NewReplacer(
+	"\r", " ",
+	"\n", " ",
+	`\`, `\\`,
+	"[", `\[`,
+	"]", `\]`,
+)
+
+func (a *imageAsset) markdown(url string) string {
+	return fmt.Sprintf("![%s](%s)", altReplacer.Replace(a.alt), url)
+}
+
+func (a *imageAsset) rendersAsPlayer() bool {
+	return false
+}
+
+type videoAsset struct {
+	asset
+}
+
+func (a *videoAsset) Path() string {
+	return a.path
+}
+
+func (a *videoAsset) getAsset() asset {
+	return a.asset
+}
+
+func (a *videoAsset) markdown(url string) string {
+	return url
+}
+
+func (a *videoAsset) rendersAsPlayer() bool {
+	return true
+}
+
+var imageTypes = map[string]string{
+	".png":  "image/png",
+	".jpg":  "image/jpeg",
+	".jpeg": "image/jpeg",
+	".gif":  "image/gif",
+	".webp": "image/webp",
+	".svg":  "image/svg+xml",
+}
+
+var videoTypes = map[string]string{
+	".mp4":  "video/mp4",
+	".mov":  "video/quicktime",
+	".webm": "video/webm",
+}
+
+func newAsset(path, alt string) (UserAsset, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		var pathErr *os.PathError
+		if errors.As(err, &pathErr) {
+			return nil, fmt.Errorf("%s: %w", path, pathErr.Err)
+		}
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+
+	if info.IsDir() {
+		return nil, fmt.Errorf("%s is a directory", path)
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%s is not a regular file", path)
+	}
+	if info.Size() == 0 {
+		return nil, fmt.Errorf("%s is empty", path)
+	}
+
+	ext := strings.ToLower(filepath.Ext(path))
+	contentType, isImage := imageTypes[ext]
+	isVideo := false
+	if !isImage {
+		contentType, isVideo = videoTypes[ext]
+	}
+
+	if !isImage && !isVideo {
+		return nil, fmt.Errorf("%s is not a supported file type (supported: png, jpg, jpeg, gif, webp, svg, mp4, mov, webm)", path)
+	}
+
+	filename := filepath.Base(path)
+
+	if isVideo {
+		if alt != "" {
+			return nil, errors.New("cannot set alt text on video")
+		}
+		if info.Size() > maxVideoBytes {
+			return nil, fmt.Errorf("%s: videos must be at most 100.0 MB", path)
+		}
+		return &videoAsset{
+			asset: asset{
+				path:        path,
+				name:        filename,
+				contentType: contentType,
+				size:        info.Size(),
+				alt:         filename,
+				info:        info,
+			},
+		}, nil
+	}
+
+	// Image
+	if info.Size() > maxImageBytes {
+		return nil, fmt.Errorf("%s: images must be at most 10.0 MB", path)
+	}
+
+	if alt == "" {
+		baseWithoutExt := strings.TrimSuffix(filename, filepath.Ext(filename))
+		alt = strings.ReplaceAll(baseWithoutExt, ".", " ")
+	}
+
+	return &imageAsset{
+		asset: asset{
+			path:        path,
+			name:        filename,
+			contentType: contentType,
+			size:        info.Size(),
+			alt:         alt,
+			info:        info,
+		},
+	}, nil
+}
