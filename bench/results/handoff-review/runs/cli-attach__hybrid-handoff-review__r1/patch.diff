diff --git a/internal/attachments/attach.go b/internal/attachments/attach.go
new file mode 100644
index 000000000..1af8e76f9
--- /dev/null
+++ b/internal/attachments/attach.go
@@ -0,0 +1,69 @@
+package attachments
+
+import (
+	"context"
+	"strings"
+)
+
+func appendParagraph(md, addition string) string {
+	if addition == "" {
+		return md
+	}
+	trimmed := strings.TrimRight(md, " \t\r\n")
+	if trimmed == "" {
+		return addition
+	}
+	return trimmed + "\n\n" + addition
+}
+
+func (u *Uploader) UploadAndAttach(ctx context.Context, body string, assets []UserAsset) (string, int, error) {
+	if len(assets) == 0 {
+		return body, 0, nil
+	}
+
+	args := make([]attachmentArg, len(assets))
+	for i, a := range assets {
+		args[i] = attachmentArg{
+			Path:            a.Path(),
+			Alt:             a.getAsset().alt,
+			RendersAsPlayer: a.rendersAsPlayer(),
+		}
+	}
+
+	v, err := newAttachableMarkdown(body, args)
+	if err != nil {
+		return body, 0, err
+	}
+
+	var uploadErr error
+	var uploadedCount int
+	for i, a := range assets {
+		url, err := u.upload(ctx, a)
+		if err != nil {
+			uploadErr = err
+			break
+		}
+		args[i].URL = url
+		uploadedCount++
+	}
+
+	v.attachmentArgs = args
+	res, err := attachAssetsToMarkdown(v)
+	if err != nil && uploadErr == nil {
+		uploadErr = err
+	}
+
+	currentBody := res.Rewritten
+	for _, toAppend := range res.ToAppend {
+		if toAppend.URL != "" {
+			for _, a := range assets {
+				if a.Path() == toAppend.Path {
+					currentBody = appendParagraph(currentBody, a.markdown(toAppend.URL))
+					break
+				}
+			}
+		}
+	}
+
+	return currentBody, uploadedCount, uploadErr
+}
diff --git a/internal/attachments/client.go b/internal/attachments/client.go
new file mode 100644
index 000000000..4319c3fec
--- /dev/null
+++ b/internal/attachments/client.go
@@ -0,0 +1,227 @@
+package attachments
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+
+	"github.com/cli/cli/v2/internal/gh"
+	"github.com/cli/cli/v2/internal/ghinstance"
+)
+
+var openFile = func(path string) (io.ReadCloser, error) {
+	return os.Open(path)
+}
+
+type uploadError struct {
+	StatusCode int
+	Path       string
+	Message    string
+}
+
+func (e *uploadError) Error() string {
+	return e.Message
+}
+
+type Uploader struct {
+	httpClient       *http.Client
+	host             string
+	targetRepository int64
+}
+
+func checkHost(host string) error {
+	if ghinstance.CategorizeHost(host) == "ghes" {
+		return errors.New("attaching files is not supported on GitHub Enterprise Server")
+	}
+	return nil
+}
+
+func NewUploader(httpClient *http.Client, tokenType gh.TokenType, host string, targetRepository int64, viewerPermission string) (*Uploader, error) {
+	if err := checkHost(host); err != nil {
+		return nil, err
+	}
+	switch tokenType {
+	case gh.TokenTypeOAuth, gh.TokenTypePersonalAccess, gh.TokenTypeFineGrainedPAT:
+		// allowed
+	default:
+		return nil, errors.New("unsupported authentication type")
+	}
+	if targetRepository <= 0 {
+		return nil, errors.New("could not determine which repository to attach files to")
+	}
+	if viewerPermission == "" {
+		return nil, errors.New("could not determine your permission on the repository to attach files")
+	}
+	switch viewerPermission {
+	case "ADMIN", "MAINTAIN", "WRITE":
+		// allowed
+	default:
+		return nil, errors.New("attaching files requires write access to the repository")
+	}
+	return &Uploader{
+		httpClient:       httpClient,
+		host:             host,
+		targetRepository: targetRepository,
+	}, nil
+}
+
+func (u *Uploader) upload(ctx context.Context, a UserAsset) (string, error) {
+	rc, err := openFile(a.Path())
+	if err != nil {
+		return "", fmt.Errorf("failed to upload %s: %w", a.Path(), err)
+	}
+	defer rc.Close()
+
+	prefix := ghinstance.UserAssetUploadPrefix(u.host)
+	values := url.Values{}
+	values.Set("content_type", a.getAsset().contentType)
+	values.Set("name", a.getAsset().Name())
+	values.Set("repository_id", strconv.FormatInt(u.targetRepository, 10))
+	targetURL := prefix + "user-attachments/assets?" + values.Encode()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, targetURL, rc)
+	if err != nil {
+		return "", fmt.Errorf("failed to upload %s: %w", a.Path(), err)
+	}
+	req.Header.Set("Content-Type", "application/octet-stream")
+	req.Header.Set("Accept", "application/vnd.github+json")
+	req.ContentLength = a.getAsset().Size()
+
+	resp, err := u.httpClient.Do(req)
+	if err != nil {
+		return "", fmt.Errorf("failed to upload %s: %w", a.Path(), err)
+	}
+	defer resp.Body.Close()
+
+	bodyBytes, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return "", &uploadError{
+			StatusCode: resp.StatusCode,
+			Path:       a.Path(),
+			Message:    fmt.Sprintf("failed to upload %s: %v", a.Path(), err),
+		}
+	}
+
+	if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+		var result struct {
+			URL string `json:"url"`
+		}
+		if err := json.Unmarshal(bodyBytes, &result); err != nil {
+			return "", &uploadError{
+				StatusCode: 0,
+				Path:       a.Path(),
+				Message:    fmt.Sprintf("failed to upload %s: %v", a.Path(), err),
+			}
+		}
+		if result.URL == "" {
+			return "", &uploadError{
+				StatusCode: 0,
+				Path:       a.Path(),
+				Message:    fmt.Sprintf("failed to upload %s: the server returned no asset URL", a.Path()),
+			}
+		}
+		return result.URL, nil
+	}
+
+	if resp.StatusCode == 404 {
+		return "", &uploadError{
+			StatusCode: 404,
+			Path:       a.Path(),
+			Message:    fmt.Sprintf("could not upload %s: attaching files requires write access to the repository", a.Path()),
+		}
+	}
+
+	if resp.StatusCode == 413 {
+		var errResp struct {
+			Message string `json:"message"`
+		}
+		_ = json.Unmarshal(bodyBytes, &errResp)
+		msg := fmt.Sprintf("failed to upload %s: HTTP 413", a.Path())
+		if errResp.Message != "" {
+			msg = fmt.Sprintf("failed to upload %s: HTTP 413: %s", a.Path(), errResp.Message)
+		}
+		return "", &uploadError{
+			StatusCode: 413,
+			Path:       a.Path(),
+			Message:    msg,
+		}
+	}
+
+	if resp.StatusCode == 429 {
+		retryAfter := resp.Header.Get("Retry-After")
+		var msg string
+		if retryAfter == "" {
+			msg = fmt.Sprintf("could not upload %s: rate limited; wait and try again", a.Path())
+		} else if _, err := strconv.Atoi(retryAfter); err == nil {
+			msg = fmt.Sprintf("could not upload %s: rate limited; retry after %s seconds", a.Path(), retryAfter)
+		} else {
+			msg = fmt.Sprintf("could not upload %s: rate limited; retry after %s", a.Path(), retryAfter)
+		}
+		return "", &uploadError{
+			StatusCode: 429,
+			Path:       a.Path(),
+			Message:    msg,
+		}
+	}
+
+	if resp.StatusCode == 422 {
+		type apiError struct {
+			Resource string `json:"resource"`
+			Field    string `json:"field"`
+			Code     string `json:"code"`
+			Message  string `json:"message"`
+		}
+		var errResp struct {
+			Message string     `json:"message"`
+			Errors  []apiError `json:"errors"`
+		}
+		_ = json.Unmarshal(bodyBytes, &errResp)
+		var parts []string
+		if errResp.Message != "" {
+			parts = append(parts, errResp.Message)
+		}
+		for _, item := range errResp.Errors {
+			if item.Message != "" {
+				parts = append(parts, item.Message)
+			} else if item.Code != "" {
+				target := item.Field
+				if item.Resource != "" {
+					target = item.Resource + "." + target
+				}
+				parts = append(parts, fmt.Sprintf("%s is %s", target, item.Code))
+			}
+		}
+		var msg string
+		if len(parts) == 0 {
+			msg = fmt.Sprintf("could not upload %s", a.Path())
+		} else {
+			msg = fmt.Sprintf("could not upload %s: %s", a.Path(), strings.Join(parts, "; "))
+		}
+		return "", &uploadError{
+			StatusCode: 422,
+			Path:       a.Path(),
+			Message:    msg,
+		}
+	}
+
+	var errResp struct {
+		Message string `json:"message"`
+	}
+	_ = json.Unmarshal(bodyBytes, &errResp)
+	msg := fmt.Sprintf("failed to upload %s: HTTP %d", a.Path(), resp.StatusCode)
+	if errResp.Message != "" {
+		msg = fmt.Sprintf("failed to upload %s: HTTP %d: %s", a.Path(), resp.StatusCode, errResp.Message)
+	}
+	return "", &uploadError{
+		StatusCode: resp.StatusCode,
+		Path:       a.Path(),
+		Message:    msg,
+	}
+}
