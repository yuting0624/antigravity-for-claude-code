+func TestServerTimeoutsOptions(t *testing.T) {
+	input := `{
+		servers {
+			timeouts {
+				read_body_idle 150ms 1000
+				write_idle 1s 2000
+				write_max_chunk 64KiB
+			}
+		}
+	}
+	:80 {
+		respond "OK"
+	}`
+
+	adapter := caddyfile.Adapter{
+		ServerType: ServerType{},
+	}
+
+	out, _, err := adapter.Adapt([]byte(input), nil)
+	if err != nil {
+		t.Fatalf("unexpected error adapting caddyfile: %v", err)
+	}
+
+	var cfg caddy.Config
+	if err := json.Unmarshal(out, &cfg); err != nil {
+		t.Fatalf("unexpected error unmarshaling config: %v", err)
+	}
+
+	var httpApp caddyhttp.App
+	if err := json.Unmarshal(cfg.AppsRaw["http"], &httpApp); err != nil {
+		t.Fatalf("unexpected error unmarshaling http app: %v", err)
+	}
+
+	var srv *caddyhttp.Server
+	for _, s := range httpApp.Servers {
+		srv = s
+		break
+	}
+	if srv == nil {
+		t.Fatalf("expected server in http app")
+	}
+
+	if srv.ReadIdleTimeout != caddy.Duration(150*time.Millisecond) {
+		t.Errorf("expected ReadIdleTimeout 150ms, got %v", srv.ReadIdleTimeout)
+	}
+	if srv.ReadMinRate != 1000 {
+		t.Errorf("expected ReadMinRate 1000, got %v", srv.ReadMinRate)
+	}
+	if srv.WriteIdleTimeout != caddy.Duration(time.Second) {
+		t.Errorf("expected WriteIdleTimeout 1s, got %v", srv.WriteIdleTimeout)
+	}
+	if srv.WriteMinRate != 2000 {
+		t.Errorf("expected WriteMinRate 2000, got %v", srv.WriteMinRate)
+	}
+	if srv.MaxWriteChunk != 64*1024 {
+		t.Errorf("expected MaxWriteChunk 65536, got %v", srv.MaxWriteChunk)
+	}
+}
