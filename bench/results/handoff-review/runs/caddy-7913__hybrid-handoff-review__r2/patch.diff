+
+package caddyhttp
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestParseRate(t *testing.T) {
+	for _, tc := range []struct {
+		input       string
+		expected    int64
+		expectError bool
+	}{
+		{"1000", 1000, false},
+		{"1000/s", 1000, false},
+		{"1000/sec", 1000, false},
+		{"64KiB", 65536, false},
+		{"64KiB/s", 65536, false},
+		{"1MB", 1000000, false},
+		{"0", 0, false},
+		{"-100", 0, true},
+		{"invalid", 0, true},
+	} {
+		rate, err := ParseRate(tc.input)
+		if tc.expectError {
+			assert.Error(t, err, "input: %s", tc.input)
+		} else {
+			require.NoError(t, err, "input: %s", tc.input)
+			assert.Equal(t, tc.expected, rate, "input: %s", tc.input)
+		}
+	}
+}
