+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package caddyhttp
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/dustin/go-humanize"
+	"go.uber.org/zap"
+)
+
+// DefaultMaxWriteChunk is the default maximum size in bytes written to the
+// underlying ResponseWriter in a single chunk when idle write timeouts are active.
+const DefaultMaxWriteChunk = 64 * 1024
+
+// IdleDeadline computes dynamic deadlines based on idle timeout windows,
+// minimum sustained transfer rates, and optional hard ceilings.
+type IdleDeadline struct {
+	Timeout      time.Duration
+	HardDeadline time.Time
+	Start        time.Time
+	MinRate      int64
+}
+
+// Calculate returns the deadline given the current time and bytes transferred so far.
+func (d *IdleDeadline) Calculate(now time.Time, bytesTransferred int64) time.Time {
+	if d.Start.IsZero() {
+		d.Start = now
+	}
+	var deadline time.Time
+	if d.Timeout > 0 {
+		deadline = now.Add(d.Timeout)
+	}
+	if d.MinRate > 0 {
+		baseTimeout := d.Timeout
+		if baseTimeout <= 0 {
+			baseTimeout = time.Minute
+		}
+		creditSec := float64(bytesTransferred) / float64(d.MinRate)
+		const maxSec = float64(math.MaxInt64 / int64(time.Second))
+		var credit time.Duration
+		if creditSec > maxSec {
+			credit = time.Duration(math.MaxInt64)
+		} else {
+			credit = time.Duration(creditSec * float64(time.Second))
+		}
+		rateDeadline := d.Start.Add(baseTimeout).Add(credit)
+		if deadline.IsZero() || rateDeadline.Before(deadline) {
+			deadline = rateDeadline
+		}
+	}
+	if !d.HardDeadline.IsZero() {
+		if deadline.IsZero() || d.HardDeadline.Before(deadline) {
+			deadline = d.HardDeadline
+		}
+	}
+	return deadline
+}
+
+// IdleTimeoutReader wraps an io.ReadCloser and resets the read deadline
+// before each Read of the request body.
+type IdleTimeoutReader struct {
+	io.ReadCloser
+	Ctrl     *http.ResponseController
+	Deadline IdleDeadline
+	Logger   *zap.Logger
+
+	bytesRead   int64
+	unsupported bool
+}
+
+func (r *IdleTimeoutReader) Read(p []byte) (int, error) {
+	if r.ReadCloser == nil {
+		return 0, io.EOF
+	}
+
+	if !r.unsupported {
+		now := time.Now()
+		d := r.Deadline.Calculate(now, r.bytesRead)
+		if !d.IsZero() && !now.Before(d) {
+			return 0, os.ErrDeadlineExceeded
+		}
+		if r.Ctrl != nil && !d.IsZero() {
+			if err := r.Ctrl.SetReadDeadline(d); err != nil {
+				if errors.Is(err, http.ErrNotSupported) {
+					r.unsupported = true
+				} else if r.Logger != nil {
+					r.Logger.Debug("setting read deadline", zap.Error(err))
+				}
+			}
+		}
+	}
+
+	n, err := r.ReadCloser.Read(p)
+	if n > 0 {
+		r.bytesRead += int64(n)
+	}
+	return n, err
+}
+
+func (r *IdleTimeoutReader) Close() error {
+	if r.ReadCloser != nil {
+		return r.ReadCloser.Close()
+	}
+	return nil
+}
+
+// IdleTimeoutWriter wraps a ResponseWriterWrapper to enforce idle write timeouts,
+// rate floors, and chunked writes.
+type IdleTimeoutWriter struct {
+	*ResponseWriterWrapper
+	Ctrl     *http.ResponseController
+	Deadline IdleDeadline
+	MaxChunk int
+	Logger   *zap.Logger
+
+	bytesWritten int64
+	unsupported  bool
+}
+
+func (w *IdleTimeoutWriter) maxChunk() int {
+	if w.MaxChunk > 0 {
+		return w.MaxChunk
+	}
+	return DefaultMaxWriteChunk
+}
+
+func (w *IdleTimeoutWriter) setDeadline() error {
+	if w.unsupported {
+		return nil
+	}
+	now := time.Now()
+	d := w.Deadline.Calculate(now, w.bytesWritten)
+	if !d.IsZero() && !now.Before(d) {
+		return os.ErrDeadlineExceeded
+	}
+	if w.Ctrl != nil && !d.IsZero() {
+		if err := w.Ctrl.SetWriteDeadline(d); err != nil {
+			if errors.Is(err, http.ErrNotSupported) {
+				w.unsupported = true
+				return nil
+			}
+			if w.Logger != nil {
+				w.Logger.Debug("setting write deadline", zap.Error(err))
+			}
+		}
+	}
+	return nil
+}
+
+func (w *IdleTimeoutWriter) Write(p []byte) (int, error) {
+	if len(p) == 0 {
+		if w.ResponseWriterWrapper != nil {
+			return w.ResponseWriterWrapper.Write(p)
+		}
+		return 0, nil
+	}
+
+	chunkSize := w.maxChunk()
+	var total int
+	for len(p) > 0 {
+		chunk := p
+		if len(chunk) > chunkSize {
+			chunk = chunk[:chunkSize]
+		}
+		if err := w.setDeadline(); err != nil {
+			return total, err
+		}
+		var n int
+		var err error
+		if w.ResponseWriterWrapper != nil {
+			n, err = w.ResponseWriterWrapper.Write(chunk)
+		}
+		total += n
+		w.bytesWritten += int64(n)
+		p = p[n:]
+		if err != nil {
+			return total, err
+		}
+	}
+	return total, nil
+}
+
+func (w *IdleTimeoutWriter) ReadFrom(r io.Reader) (int64, error) {
+	chunkSize := int64(w.maxChunk())
+	var total int64
+	for {
+		if err := w.setDeadline(); err != nil {
+			return total, err
+		}
+		var n int64
+		var err error
+		if w.ResponseWriterWrapper != nil {
+			n, err = w.ResponseWriterWrapper.ReadFrom(io.LimitReader(r, chunkSize))
+		} else {
+			n, err = io.Copy(io.Discard, io.LimitReader(r, chunkSize))
+		}
+		total += n
+		w.bytesWritten += n
+		if err != nil {
+			return total, err
+		}
+		if n < chunkSize {
+			return total, nil
+		}
+	}
+}
+
+// ParseRate parses a transfer rate string into bytes per second.
+// It accepts bare numbers (e.g. "1000") or size units (e.g. "10KB", "1MB"),
+// with an optional "/s" or "/sec" suffix (e.g. "10KB/s").
+func ParseRate(s string) (int64, error) {
+	s = strings.TrimSpace(s)
+	s = strings.TrimSuffix(s, "/s")
+	s = strings.TrimSuffix(s, "/sec")
+
+	if val, err := strconv.ParseInt(s, 10, 64); err == nil {
+		if val < 0 {
+			return 0, fmt.Errorf("rate cannot be negative: %s", s)
+		}
+		return val, nil
+	}
+	bytes, err := humanize.ParseBytes(s)
+	if err != nil {
+		return 0, err
+	}
+	return int64(bytes), nil
+}
+
+// Interface guards
+var (
+	_ io.ReadCloser       = (*IdleTimeoutReader)(nil)
+	_ http.ResponseWriter = (*IdleTimeoutWriter)(nil)
+	_ io.ReaderFrom       = (*IdleTimeoutWriter)(nil)
+)
