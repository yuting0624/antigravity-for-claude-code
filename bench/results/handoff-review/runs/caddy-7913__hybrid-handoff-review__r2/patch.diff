+package timeouts
+
+import (
+	"encoding/json"
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func init() {
+	caddy.RegisterModule(Timeouts{})
+}
+
+// Timeouts is a middleware that enforces idle timeouts and rate floors on request bodies and responses.
+type Timeouts struct {
+	ReadTimeout   time.Duration `json:"read_timeout,omitempty"`
+	ReadMinRate   int64         `json:"read_min_rate,omitempty"`
+	WriteTimeout  time.Duration `json:"write_timeout,omitempty"`
+	WriteMinRate  int64         `json:"write_min_rate,omitempty"`
+	MaxWriteChunk int           `json:"max_write_chunk,omitempty"`
+
+	logger *zap.Logger
+}
+
+// CaddyModule returns the Caddy module information.
+func (Timeouts) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{
+		ID:  "http.handlers.timeouts",
+		New: func() caddy.Module { return new(Timeouts) },
+	}
+}
+
+// Provision sets up the module.
+func (t *Timeouts) Provision(ctx caddy.Context) error {
+	t.logger = ctx.Logger()
+	if t.ReadMinRate > 0 && t.ReadTimeout == 0 {
+		t.ReadTimeout = time.Minute
+	}
+	if t.WriteMinRate > 0 && t.WriteTimeout == 0 {
+		t.WriteTimeout = time.Minute
+	}
+	return nil
+}
+
+// ServeHTTP implements caddyhttp.MiddlewareHandler.
+func (t Timeouts) ServeHTTP(w http.ResponseWriter, r *http.Request, next caddyhttp.Handler) error {
+	logger := t.logger
+	if logger == nil {
+		logger = zap.NewNop()
+	}
+
+	rc := http.NewResponseController(w)
+
+	if (t.ReadTimeout > 0 || t.ReadMinRate > 0) && r.Body != nil {
+		readTimeout := t.ReadTimeout
+		if readTimeout == 0 && t.ReadMinRate > 0 {
+			readTimeout = time.Minute
+		}
+		r.Body = &caddyhttp.IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       rc,
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   time.Now(),
+				Timeout: readTimeout,
+				MinRate: t.ReadMinRate,
+			},
+			Logger: logger,
+		}
+	}
+
+	if t.WriteTimeout > 0 || t.WriteMinRate > 0 || t.MaxWriteChunk > 0 {
+		writeTimeout := t.WriteTimeout
+		if writeTimeout == 0 && t.WriteMinRate > 0 {
+			writeTimeout = time.Minute
+		}
+		w = &caddyhttp.IdleTimeoutWriter{
+			ResponseWriterWrapper: &caddyhttp.ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  rc,
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   time.Now(),
+				Timeout: writeTimeout,
+				MinRate: t.WriteMinRate,
+			},
+			MaxChunk: t.MaxWriteChunk,
+			Logger:   logger,
+		}
+	}
+
+	return next.ServeHTTP(w, r)
+}
+
+// UnmarshalJSON unmarshals JSON configuration into Timeouts.
+func (t *Timeouts) UnmarshalJSON(data []byte) error {
+	type Alias Timeouts
+	aux := &struct {
+		ReadTimeout   caddy.Duration `json:"read_timeout,omitempty"`
+		WriteTimeout  caddy.Duration `json:"write_timeout,omitempty"`
+		WriteMaxChunk int            `json:"write_max_chunk,omitempty"`
+		*Alias
+	}{
+		Alias: (*Alias)(t),
+	}
+	if err := json.Unmarshal(data, aux); err != nil {
+		return err
+	}
+	if aux.WriteMaxChunk > 0 && t.MaxWriteChunk == 0 {
+		t.MaxWriteChunk = aux.WriteMaxChunk
+	}
+	t.ReadTimeout = time.Duration(aux.ReadTimeout)
+	t.WriteTimeout = time.Duration(aux.WriteTimeout)
+	return nil
+}
+
+// MarshalJSON marshals Timeouts to JSON.
+func (t Timeouts) MarshalJSON() ([]byte, error) {
+	type Alias Timeouts
+	aux := struct {
+		ReadTimeout  caddy.Duration `json:"read_timeout,omitempty"`
+		WriteTimeout caddy.Duration `json:"write_timeout,omitempty"`
+		Alias
+	}{
+		ReadTimeout:  caddy.Duration(t.ReadTimeout),
+		WriteTimeout: caddy.Duration(t.WriteTimeout),
+		Alias:        (Alias)(t),
+	}
+	return json.Marshal(aux)
+}
+
+// Interface guards
+var (
+	_ caddy.Module                = (*Timeouts)(nil)
+	_ caddy.Provisioner           = (*Timeouts)(nil)
+	_ caddyhttp.MiddlewareHandler = (*Timeouts)(nil)
+)
