+package timeouts
+
+import (
+	"testing"
+	"time"
+
+	"github.com/caddyserver/caddy/v2/caddyconfig/caddyfile"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestUnmarshalCaddyfile(t *testing.T) {
+	for i, tc := range []struct {
+		input       string
+		expected    Timeouts
+		expectError bool
+	}{
+		{
+			input: `timeouts {
+				read_timeout 150ms 1000
+				write_timeout 1s 2000
+				write_max_chunk 64KiB
+			}`,
+			expected: Timeouts{
+				ReadTimeout:   150 * time.Millisecond,
+				ReadMinRate:   1000,
+				WriteTimeout:  time.Second,
+				WriteMinRate:  2000,
+				MaxWriteChunk: 65536,
+			},
+		},
+		{
+			input: `timeouts 5s 10s`,
+			expected: Timeouts{
+				ReadTimeout:  5 * time.Second,
+				WriteTimeout: 10 * time.Second,
+			},
+		},
+		{
+			input: `timeouts 5s`,
+			expected: Timeouts{
+				ReadTimeout:  5 * time.Second,
+				WriteTimeout: 5 * time.Second,
+			},
+		},
+		{
+			input: `timeouts {
+				read_timeout
+				write_timeout
+			}`,
+			expected: Timeouts{
+				ReadTimeout:  time.Minute,
+				WriteTimeout: time.Minute,
+			},
+		},
+		{
+			input: `timeouts {
+				read_min_rate 500
+				write_min_rate 1000
+			}`,
+			expected: Timeouts{
+				ReadMinRate:  500,
+				WriteMinRate: 1000,
+			},
+		},
+		{
+			input: `timeouts {
+				unknown_directive
+			}`,
+			expectError: true,
+		},
+		{
+			input: `timeouts {
+				read_timeout invalid
+			}`,
+			expectError: true,
+		},
+		{
+			input: `timeouts {
+				write_max_chunk invalid
+			}`,
+			expectError: true,
+		},
+	} {
+		d := caddyfile.NewTestDispenser(tc.input)
+		var tm Timeouts
+		err := tm.UnmarshalCaddyfile(d)
+		if tc.expectError {
+			assert.Error(t, err, "test %d", i)
+		} else {
+			require.NoError(t, err, "test %d", i)
+			assert.Equal(t, tc.expected.ReadTimeout, tm.ReadTimeout, "test %d ReadTimeout", i)
+			assert.Equal(t, tc.expected.ReadMinRate, tm.ReadMinRate, "test %d ReadMinRate", i)
+			assert.Equal(t, tc.expected.WriteTimeout, tm.WriteTimeout, "test %d WriteTimeout", i)
+			assert.Equal(t, tc.expected.WriteMinRate, tm.WriteMinRate, "test %d WriteMinRate", i)
+			assert.Equal(t, tc.expected.MaxWriteChunk, tm.MaxWriteChunk, "test %d MaxWriteChunk", i)
+		}
+	}
+}
