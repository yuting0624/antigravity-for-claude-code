diff --git a/internal/attachments/attach.go b/internal/attachments/attach.go
new file mode 100644
index 000000000..09d351c20
--- /dev/null
+++ b/internal/attachments/attach.go
@@ -0,0 +1,69 @@
+package attachments
+
+import (
+	"context"
+	"strings"
+)
+
+func appendParagraph(md, addition string) string {
+	if addition == "" {
+		return md
+	}
+	if strings.TrimSpace(md) == "" {
+		return addition
+	}
+	trimmed := strings.TrimRight(md, " \t\r\n")
+	return trimmed + "\n\n" + addition
+}
+
+func (u *Uploader) UploadAndAttach(ctx context.Context, body string, assets []UserAsset) (string, int, error) {
+	if len(assets) == 0 {
+		return body, 0, nil
+	}
+
+	args := make([]attachmentArg, len(assets))
+	for i, a := range assets {
+		base := a.getAsset()
+		args[i] = attachmentArg{
+			Path:            a.Path(),
+			Alt:             base.alt,
+			RendersAsPlayer: a.rendersAsPlayer(),
+		}
+	}
+
+	v, err := newAttachableMarkdown(body, args)
+	if err != nil {
+		return body, 0, err
+	}
+
+	uploaded := 0
+	var uploadErr error
+	for i, a := range assets {
+		url, err := u.upload(ctx, a)
+		if err != nil {
+			uploadErr = err
+			break
+		}
+		v.args[i].URL = url
+		uploaded++
+	}
+
+	rewritten, err := attachAssetsToMarkdown(v)
+	if err != nil && uploadErr == nil {
+		uploadErr = err
+	}
+
+	resultBody := rewritten.Rewritten
+	for _, item := range rewritten.ToAppend {
+		if item.URL != "" {
+			for _, a := range assets {
+				if a.Path() == item.Path {
+					resultBody = appendParagraph(resultBody, a.markdown(item.URL))
+					break
+				}
+			}
+		}
+	}
+
+	return resultBody, uploaded, uploadErr
+}
diff --git a/internal/attachments/client.go b/internal/attachments/client.go
new file mode 100644
index 000000000..6cad147bc
--- /dev/null
+++ b/internal/attachments/client.go
@@ -0,0 +1,220 @@
+package attachments
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/cli/cli/v2/api"
+	"github.com/cli/cli/v2/internal/gh"
+	"github.com/cli/cli/v2/internal/ghinstance"
+	ghauth "github.com/cli/go-gh/v2/pkg/auth"
+)
+
+var openFile = func(name string) (io.ReadCloser, error) {
+	return os.Open(name)
+}
+
+type uploadError struct {
+	StatusCode int
+	Path       string
+	Message    string
+}
+
+func (e *uploadError) Error() string {
+	return e.Message
+}
+
+type Uploader struct {
+	httpClient       *http.Client
+	host             string
+	targetRepository int64
+}
+
+func checkHost(host string) error {
+	if ghauth.IsEnterprise(host) && !ghauth.IsTenancy(host) {
+		return errors.New("attaching files is not supported on GitHub Enterprise Server")
+	}
+	return nil
+}
+
+func NewUploader(httpClient *http.Client, tokenType gh.TokenType, host string, targetRepository int64, viewerPermission string) (*Uploader, error) {
+	if err := checkHost(host); err != nil {
+		return nil, err
+	}
+
+	switch tokenType {
+	case gh.TokenTypeOAuth, gh.TokenTypePersonalAccess, gh.TokenTypeFineGrainedPAT:
+		// allowed
+	default:
+		return nil, errors.New("unsupported authentication type")
+	}
+
+	if targetRepository <= 0 {
+		return nil, errors.New("could not determine which repository to attach files to")
+	}
+
+	if viewerPermission == "" {
+		return nil, errors.New("could not determine your permission on the repository to attach files")
+	}
+
+	switch strings.ToUpper(viewerPermission) {
+	case "ADMIN", "MAINTAIN", "WRITE":
+		// allowed
+	default:
+		return nil, errors.New("attaching files requires write access to the repository")
+	}
+
+	return &Uploader{
+		httpClient:       httpClient,
+		host:             host,
+		targetRepository: targetRepository,
+	}, nil
+}
+
+func (u *Uploader) upload(ctx context.Context, a UserAsset) (string, error) {
+	rc, err := openFile(a.Path())
+	if err != nil {
+		return "", &uploadError{
+			StatusCode: 0,
+			Path:       a.Path(),
+			Message:    fmt.Sprintf("failed to upload %s: %s", a.Path(), err),
+		}
+	}
+	defer rc.Close()
+
+	endpoint := fmt.Sprintf("%suser-attachments/assets?content_type=%s&name=%s&repository_id=%d",
+		ghinstance.UserAssetUploadPrefix(u.host),
+		url.QueryEscape(a.getAsset().contentType),
+		url.QueryEscape(filepath.Base(a.Path())),
+		u.targetRepository,
+	)
+
+	req, err := http.NewRequestWithContext(ctx, "POST", endpoint, rc)
+	if err != nil {
+		return "", &uploadError{
+			StatusCode: 0,
+			Path:       a.Path(),
+			Message:    fmt.Sprintf("failed to upload %s: %s", a.Path(), err),
+		}
+	}
+
+	req.Header.Set("Content-Type", "application/octet-stream")
+	req.Header.Set("Accept", "application/vnd.github+json")
+	if a.getAsset().info != nil {
+		req.ContentLength = a.getAsset().info.Size()
+	}
+
+	resp, err := u.httpClient.Do(req)
+	if err != nil {
+		return "", &uploadError{
+			StatusCode: 0,
+			Path:       a.Path(),
+			Message:    fmt.Sprintf("failed to upload %s: %s", a.Path(), err),
+		}
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode == http.StatusOK || resp.StatusCode == http.StatusCreated {
+		var result struct {
+			URL string `json:"url"`
+		}
+		if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
+			return "", &uploadError{
+				Path:    a.Path(),
+				Message: fmt.Sprintf("failed to upload %s: %s", a.Path(), err),
+			}
+		}
+		if result.URL == "" {
+			return "", &uploadError{
+				Path:    a.Path(),
+				Message: fmt.Sprintf("failed to upload %s: the server returned no asset URL", a.Path()),
+			}
+		}
+		return result.URL, nil
+	}
+
+	if resp.StatusCode == http.StatusNotFound {
+		return "", &uploadError{
+			StatusCode: 404,
+			Path:       a.Path(),
+			Message:    fmt.Sprintf("could not upload %s: attaching files requires write access to the repository", a.Path()),
+		}
+	}
+
+	if resp.StatusCode == http.StatusUnprocessableEntity {
+		var errResp struct {
+			Message string `json:"message"`
+			Errors  []struct {
+				Resource string `json:"resource"`
+				Field    string `json:"field"`
+				Code     string `json:"code"`
+				Message  string `json:"message"`
+			} `json:"errors"`
+		}
+		bodyBytes, _ := io.ReadAll(resp.Body)
+		_ = json.Unmarshal(bodyBytes, &errResp)
+
+		var msg string
+		if errResp.Message != "" {
+			msg = fmt.Sprintf("could not upload %s: %s", a.Path(), errResp.Message)
+		} else {
+			msg = fmt.Sprintf("could not upload %s", a.Path())
+		}
+
+		for _, item := range errResp.Errors {
+			var reason string
+			if item.Message != "" {
+				reason = item.Message
+			} else if item.Resource != "" && item.Field != "" && item.Code != "" {
+				reason = fmt.Sprintf("%s.%s is %s", item.Resource, item.Field, item.Code)
+			} else if item.Field != "" && item.Code != "" {
+				reason = fmt.Sprintf("%s is %s", item.Field, item.Code)
+			} else if item.Code != "" {
+				reason = item.Code
+			}
+			if reason != "" {
+				msg += "; " + reason
+			}
+		}
+
+		return "", &uploadError{
+			StatusCode: 422,
+			Path:       a.Path(),
+			Message:    msg,
+		}
+	}
+
+	if resp.StatusCode == 429 { // Too Many Requests
+		retryAfter := resp.Header.Get("Retry-After")
+		var msg string
+		if retryAfter == "" {
+			msg = fmt.Sprintf("could not upload %s: rate limited; wait and try again", a.Path())
+		} else if _, err := strconv.Atoi(retryAfter); err == nil {
+			msg = fmt.Sprintf("could not upload %s: rate limited; retry after %s seconds", a.Path(), retryAfter)
+		} else {
+			msg = fmt.Sprintf("could not upload %s: rate limited; retry after %s", a.Path(), retryAfter)
+		}
+		return "", &uploadError{
+			StatusCode: 429,
+			Path:       a.Path(),
+			Message:    msg,
+		}
+	}
+
+	httpErr := api.HandleHTTPError(resp)
+	cleanErr := strings.TrimSpace(strings.ReplaceAll(httpErr.Error(), "\n", " "))
+	return "", &uploadError{
+		StatusCode: resp.StatusCode,
+		Path:       a.Path(),
+		Message:    fmt.Sprintf("failed to upload %s: %s", a.Path(), cleanErr),
+	}
+}
diff --git a/internal/attachments/flags.go b/internal/attachments/flags.go
new file mode 100644
index 000000000..80510a596
--- /dev/null
+++ b/internal/attachments/flags.go
@@ -0,0 +1,96 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+)
+
+const flagName = "attach"
+
+type Flag struct {
+	flag   *pflag.Flag
+	values []string
+}
+
+func AddFlag(cmd *cobra.Command) *Flag {
+	f := &Flag{}
+	cmd.Flags().StringArrayVar(&f.values, flagName, nil, "Attach an image or video `file`, in '<file>#<image alt text>' format")
+	f.flag = cmd.Flags().Lookup(flagName)
+	return f
+}
+
+func (f *Flag) Changed() bool {
+	return f != nil && f.flag != nil && f.flag.Changed
+}
+
+func (f *Flag) IsPresent() bool {
+	return f != nil && (f.Changed() || len(f.values) > 0)
+}
+
+func (f *Flag) UserAssets() ([]UserAsset, error) {
+	if f == nil || len(f.values) == 0 {
+		return nil, nil
+	}
+
+	var assets []UserAsset
+	for _, val := range f.values {
+		if val == "" {
+			return nil, errors.New("cannot attach an empty path; --attach needs a file path")
+		}
+		if val == "-" {
+			return nil, errors.New("cannot attach standard input; --attach needs a file path")
+		}
+
+		path, alt := splitPathAndAlt(val)
+		asset, err := newAsset(path, alt)
+		if err != nil {
+			return nil, err
+		}
+
+		for _, prev := range assets {
+			if os.SameFile(prev.getAsset().info, asset.getAsset().info) {
+				return nil, fmt.Errorf("%s and %s are the same file; attached files must be unique", prev.Path(), asset.Path())
+			}
+		}
+
+		assets = append(assets, asset)
+	}
+
+	return assets, nil
+}
+
+func splitPathAndAlt(val string) (string, string) {
+	if !strings.Contains(val, "#") {
+		return val, ""
+	}
+
+	// 1. Check if whole string exists as a file
+	if _, err := os.Stat(val); err == nil {
+		return val, ""
+	}
+
+	// 2. Find all '#' positions and test prefixes from longest to shortest
+	var hashIndices []int
+	for i := 0; i < len(val); i++ {
+		if val[i] == '#' {
+			hashIndices = append(hashIndices, i)
+		}
+	}
+
+	for i := len(hashIndices) - 1; i >= 0; i-- {
+		idx := hashIndices[i]
+		candidate := val[:idx]
+		if _, err := os.Stat(candidate); err == nil {
+			return candidate, val[idx+1:]
+		}
+	}
+
+	// 3. If none exists, fall back to the last hash
+	last := hashIndices[len(hashIndices)-1]
+	return val[:last], val[last+1:]
+}
diff --git a/internal/attachments/references.go b/internal/attachments/references.go
new file mode 100644
index 000000000..c79856395
--- /dev/null
+++ b/internal/attachments/references.go
@@ -0,0 +1,680 @@
+package attachments
+
+import (
+	"fmt"
+	"net/url"
+	"path/filepath"
+	"sort"
+	"strings"
+	"unicode"
+
+	"github.com/yuin/goldmark"
+	"github.com/yuin/goldmark/ast"
+	"github.com/yuin/goldmark/text"
+)
+
+type attachmentArg struct {
+	Path            string
+	URL             string
+	Alt             string
+	RendersAsPlayer bool
+}
+
+type attachableMarkdown struct {
+	markdown string
+	args     []attachmentArg
+}
+
+type rewrittenMarkdown struct {
+	Rewritten string
+	ToAppend  []attachmentArg
+}
+
+func commonmarkUnescape(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\\' && i+1 < len(s) {
+			b.WriteByte(s[i+1])
+			i++
+		} else {
+			b.WriteByte(s[i])
+		}
+	}
+	return b.String()
+}
+
+func matchArg(dest string, arg attachmentArg) bool {
+	if strings.HasPrefix(dest, "#") || strings.HasPrefix(dest, "//") {
+		return false
+	}
+	// Check for URL scheme (e.g. https:, mailto:).
+	// Allow Windows drive letters (e.g. C:/...).
+	if idx := strings.Index(dest, ":"); idx != -1 {
+		isWindowsDrive := idx == 1 && len(dest) >= 3 && unicode.IsLetter(rune(dest[0])) && (dest[2] == '/' || dest[2] == '\\')
+		if !isWindowsDrive {
+			return false
+		}
+	}
+
+	cleanDest := dest
+	if strings.HasPrefix(cleanDest, "<") && strings.HasSuffix(cleanDest, ">") {
+		cleanDest = cleanDest[1 : len(cleanDest)-1]
+	}
+
+	unescapedDest, err := url.PathUnescape(cleanDest)
+	if err != nil {
+		unescapedDest = cleanDest
+	}
+
+	candidates := []string{
+		cleanDest,
+		unescapedDest,
+		commonmarkUnescape(cleanDest),
+		commonmarkUnescape(unescapedDest),
+	}
+
+	for _, cand := range candidates {
+		if cand == arg.Path {
+			return true
+		}
+		if filepath.Clean(cand) == filepath.Clean(arg.Path) {
+			return true
+		}
+		absCand, err1 := filepath.Abs(cand)
+		absArg, err2 := filepath.Abs(arg.Path)
+		if err1 == nil && err2 == nil && absCand == absArg {
+			return true
+		}
+	}
+	return false
+}
+
+func newAttachableMarkdown(markdown string, args []attachmentArg) (attachableMarkdown, error) {
+	if len(args) == 0 {
+		return attachableMarkdown{markdown: markdown, args: args}, nil
+	}
+
+	p := goldmark.New().Parser()
+	doc := p.Parse(text.NewReader([]byte(markdown)))
+
+	var offending []string
+	seen := make(map[string]bool)
+
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		// Skip code blocks
+		if n.Kind() == ast.KindCodeBlock || n.Kind() == ast.KindFencedCodeBlock {
+			return ast.WalkSkipChildren, nil
+		}
+		if img, ok := n.(*ast.Image); ok && img.Reference != nil {
+			dest := string(img.Destination)
+			for _, arg := range args {
+				if arg.RendersAsPlayer && matchArg(dest, arg) {
+					if !seen[arg.Path] {
+						seen[arg.Path] = true
+						offending = append(offending, arg.Path)
+					}
+				}
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+
+	if len(offending) > 0 {
+		return attachableMarkdown{}, fmt.Errorf("cannot embed a video as a reference-style image: %s", strings.Join(offending, ", "))
+	}
+
+	return attachableMarkdown{markdown: markdown, args: args}, nil
+}
+
+func isSingleImage(markdown, url string) bool {
+	if strings.TrimSpace(markdown) == "" {
+		return false
+	}
+	p := goldmark.New().Parser()
+	doc := p.Parse(text.NewReader([]byte(markdown)))
+	if doc.ChildCount() != 1 {
+		return false
+	}
+	para, ok := doc.FirstChild().(*ast.Paragraph)
+	if !ok {
+		return false
+	}
+	if para.ChildCount() != 1 {
+		return false
+	}
+	img, ok := para.FirstChild().(*ast.Image)
+	if !ok {
+		return false
+	}
+	return string(img.Destination) == url
+}
+
+type inlineInfo struct {
+	start      int // index of ! or [
+	labelStart int // index after [
+	labelEnd   int // index of ]
+	destStart  int // index where destination starts
+	destEnd    int // index where destination ends
+	end        int // index after )
+	rawDest    string
+}
+
+func parseInline(src string, pos int, isImage bool) (*inlineInfo, bool) {
+	start := pos
+	p := pos
+	if isImage {
+		if p >= len(src) || src[p] != '!' {
+			return nil, false
+		}
+		p++
+	}
+	if p >= len(src) || src[p] != '[' {
+		return nil, false
+	}
+	p++ // skip '['
+	labelStart := p
+
+	// Scan label until matching ']'
+	bracketDepth := 0
+	for p < len(src) {
+		if src[p] == '\\' && p+1 < len(src) {
+			p += 2
+			continue
+		}
+		if src[p] == '`' {
+			// Skip code span
+			tickCount := 0
+			for p < len(src) && src[p] == '`' {
+				tickCount++
+				p++
+			}
+			closing := strings.Repeat("`", tickCount)
+			idx := strings.Index(src[p:], closing)
+			if idx != -1 {
+				p += idx + tickCount
+			}
+			continue
+		}
+		if src[p] == '[' {
+			bracketDepth++
+			p++
+			continue
+		}
+		if src[p] == ']' {
+			if bracketDepth > 0 {
+				bracketDepth--
+				p++
+				continue
+			}
+			break
+		}
+		p++
+	}
+
+	if p >= len(src) || src[p] != ']' {
+		return nil, false
+	}
+	labelEnd := p
+	p++ // skip ']'
+
+	if p >= len(src) || src[p] != '(' {
+		return nil, false
+	}
+	p++ // skip '('
+
+	// Skip spaces
+	for p < len(src) && (src[p] == ' ' || src[p] == '\t' || src[p] == '\n' || src[p] == '\r') {
+		p++
+	}
+	if p >= len(src) {
+		return nil, false
+	}
+
+	destStart := p
+	if src[p] == '<' {
+		// Angle bracket destination
+		p++
+		closed := false
+		for p < len(src) {
+			if src[p] == '\\' && p+1 < len(src) {
+				p += 2
+				continue
+			}
+			if src[p] == '>' {
+				p++
+				closed = true
+				break
+			}
+			if src[p] == '\n' || src[p] == '\r' || src[p] == '<' {
+				return nil, false
+			}
+			p++
+		}
+		if !closed {
+			return nil, false
+		}
+	} else {
+		// Bare destination
+		parens := 0
+		for p < len(src) {
+			if src[p] == '\\' && p+1 < len(src) {
+				p += 2
+				continue
+			}
+			if src[p] == '(' {
+				parens++
+			} else if src[p] == ')' {
+				if parens > 0 {
+					parens--
+				} else {
+					break
+				}
+			} else if unicode.IsSpace(rune(src[p])) {
+				break
+			}
+			p++
+		}
+	}
+	destEnd := p
+	rawDest := src[destStart:destEnd]
+
+	// Skip spaces
+	for p < len(src) && (src[p] == ' ' || src[p] == '\t' || src[p] == '\n' || src[p] == '\r') {
+		p++
+	}
+
+	// Optional title
+	if p < len(src) && (src[p] == '"' || src[p] == '\'' || src[p] == '(') {
+		closer := src[p]
+		if closer == '(' {
+			closer = ')'
+		}
+		p++
+		for p < len(src) {
+			if src[p] == '\\' && p+1 < len(src) {
+				p += 2
+				continue
+			}
+			if src[p] == closer {
+				p++
+				break
+			}
+			p++
+		}
+		// Skip spaces
+		for p < len(src) && (src[p] == ' ' || src[p] == '\t' || src[p] == '\n' || src[p] == '\r') {
+			p++
+		}
+	}
+
+	if p >= len(src) || src[p] != ')' {
+		return nil, false
+	}
+	p++ // skip ')'
+	end := p
+
+	return &inlineInfo{
+		start:      start,
+		labelStart: labelStart,
+		labelEnd:   labelEnd,
+		destStart:  destStart,
+		destEnd:    destEnd,
+		end:        end,
+		rawDest:    rawDest,
+	}, true
+}
+
+func escapeFallbackAlt(alt string) string {
+	var b strings.Builder
+	for i := 0; i < len(alt); i++ {
+		if alt[i] == '\\' && i+1 < len(alt) {
+			b.WriteByte(alt[i])
+			b.WriteByte(alt[i+1])
+			i++
+			continue
+		}
+		if alt[i] == ']' {
+			b.WriteString(`\]`)
+			continue
+		}
+		b.WriteByte(alt[i])
+	}
+	return b.String()
+}
+
+type textEdit struct {
+	start       int
+	end         int
+	newText     string
+	argIndex    int
+	isStandalone bool
+}
+
+type defInfo struct {
+	label     string
+	destStart int
+	destEnd   int
+	rawDest   string
+	skip      bool
+	argIndex  int
+}
+
+func attachAssetsToMarkdown(v attachableMarkdown) (rewrittenMarkdown, error) {
+	markdown := v.markdown
+	args := v.args
+
+	if len(args) == 0 {
+		return rewrittenMarkdown{Rewritten: markdown, ToAppend: nil}, nil
+	}
+	if len(markdown) == 0 {
+		return rewrittenMarkdown{Rewritten: "", ToAppend: args}, nil
+	}
+
+	p := goldmark.New().Parser()
+	doc := p.Parse(text.NewReader([]byte(markdown)))
+
+	var defs []defInfo
+	referencedByDef := make(map[int]bool)
+
+	// Phase 1: Collect definitions and reference link usages
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		if n.Kind() == ast.KindCodeBlock || n.Kind() == ast.KindFencedCodeBlock {
+			return ast.WalkSkipChildren, nil
+		}
+
+		if lrd, ok := n.(*ast.LinkReferenceDefinition); ok {
+			skip := false
+			if lrd.Parent().Kind() == ast.KindBlockquote && lrd.Lines().Len() > 1 {
+				skip = true
+			}
+			seg := lrd.Lines().At(0)
+			segText := markdown[seg.Start:seg.Stop]
+			// Find ']:'
+			p := 0
+			for p < len(segText) {
+				if segText[p] == '\\' && p+1 < len(segText) {
+					p += 2
+					continue
+				}
+				if segText[p] == ']' && p+1 < len(segText) && segText[p+1] == ':' {
+					p += 2
+					break
+				}
+				p++
+			}
+			// Skip spaces
+			for p < len(segText) && (segText[p] == ' ' || segText[p] == '\t') {
+				p++
+			}
+			if p < len(segText) {
+				destStartRel := p
+				if segText[p] == '<' {
+					p++
+					closed := false
+					for p < len(segText) {
+						if segText[p] == '\\' && p+1 < len(segText) {
+							p += 2
+							continue
+						}
+						if segText[p] == '>' {
+							p++
+							closed = true
+							break
+						}
+						if segText[p] == '\n' || segText[p] == '\r' || segText[p] == '<' {
+							break
+						}
+						p++
+					}
+					if !closed {
+						skip = true
+					}
+				} else {
+					for p < len(segText) {
+						if segText[p] == '\\' && p+1 < len(segText) {
+							p += 2
+							continue
+						}
+						if segText[p] == ' ' || segText[p] == '\t' || segText[p] == '\r' || segText[p] == '\n' {
+							break
+						}
+						p++
+					}
+				}
+				destEndRel := p
+				destStart := seg.Start + destStartRel
+				destEnd := seg.Start + destEndRel
+				rawDest := markdown[destStart:destEnd]
+
+				matchedArgIndex := -1
+				for i, arg := range args {
+					if matchArg(rawDest, arg) {
+						matchedArgIndex = i
+						break
+					}
+				}
+
+				defs = append(defs, defInfo{
+					label:     string(lrd.Label),
+					destStart: destStart,
+					destEnd:   destEnd,
+					rawDest:   rawDest,
+					skip:      skip,
+					argIndex:  matchedArgIndex,
+				})
+			}
+		}
+
+		// Check reference-style usages
+		var refDest string
+		if img, ok := n.(*ast.Image); ok && img.Reference != nil {
+			refDest = string(img.Destination)
+		} else if l, ok := n.(*ast.Link); ok && l.Reference != nil {
+			refDest = string(l.Destination)
+		}
+		if refDest != "" {
+			for i, arg := range args {
+				if matchArg(refDest, arg) {
+					referencedByDef[i] = true
+				}
+			}
+		}
+
+		return ast.WalkContinue, nil
+	})
+
+	// Phase 2: Collect inline edits
+	var edits []textEdit
+	referenced := make(map[int]bool)
+
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		if n.Kind() == ast.KindCodeBlock || n.Kind() == ast.KindFencedCodeBlock {
+			return ast.WalkSkipChildren, nil
+		}
+
+		var isImage bool
+		var inlineNode ast.Node
+		if img, ok := n.(*ast.Image); ok && img.Reference == nil {
+			isImage = true
+			inlineNode = img
+		} else if l, ok := n.(*ast.Link); ok && l.Reference == nil {
+			isImage = false
+			inlineNode = l
+		}
+
+		if inlineNode != nil {
+			pos := inlineNode.Pos()
+			info, ok := parseInline(markdown, pos, isImage)
+			if ok {
+				matchedArgIndex := -1
+				for i, arg := range args {
+					if matchArg(info.rawDest, arg) {
+						matchedArgIndex = i
+						break
+					}
+				}
+				if matchedArgIndex != -1 {
+					arg := args[matchedArgIndex]
+					if isImage && arg.RendersAsPlayer {
+						aloneInParagraph := inlineNode.Parent().Kind() == ast.KindParagraph && inlineNode.Parent().ChildCount() == 1
+						if aloneInParagraph {
+							// Standalone video: whole embed becomes bare URL (or unchanged if URL == "")
+							newVal := markdown[info.start:info.end]
+							if arg.URL != "" {
+								newVal = arg.URL
+							}
+							edits = append(edits, textEdit{
+								start:        info.start,
+								end:          info.end,
+								newText:      newVal,
+								argIndex:     matchedArgIndex,
+								isStandalone: true,
+							})
+						} else {
+							// Degrade to link
+							if arg.URL != "" {
+								// Destination edit
+								edits = append(edits, textEdit{
+									start:    info.destStart,
+									end:      info.destEnd,
+									newText:  arg.URL,
+									argIndex: matchedArgIndex,
+								})
+								// Alt text edit if empty
+								if info.labelStart == info.labelEnd {
+									edits = append(edits, textEdit{
+										start:    info.labelStart,
+										end:      info.labelStart,
+										newText:  escapeFallbackAlt(arg.Alt),
+										argIndex: matchedArgIndex,
+									})
+								}
+								// Bang edit
+								precedingBang := false
+								if info.start > 0 && markdown[info.start-1] == '!' {
+									slashes := 0
+									for j := info.start - 2; j >= 0 && markdown[j] == '\\'; j-- {
+										slashes++
+									}
+									if slashes%2 == 0 {
+										precedingBang = true
+									}
+								}
+								if precedingBang {
+									edits = append(edits, textEdit{
+										start:    info.start - 1,
+										end:      info.start + 1,
+										newText:  `\!`,
+										argIndex: matchedArgIndex,
+									})
+								} else {
+									edits = append(edits, textEdit{
+										start:    info.start,
+										end:      info.start + 1,
+										newText:  ``,
+										argIndex: matchedArgIndex,
+									})
+								}
+							} else {
+								// arg.URL == "", mark referenced
+								referenced[matchedArgIndex] = true
+							}
+						}
+					} else {
+						// Normal image or link
+						if arg.URL != "" {
+							edits = append(edits, textEdit{
+								start:    info.destStart,
+								end:      info.destEnd,
+								newText:  arg.URL,
+								argIndex: matchedArgIndex,
+							})
+						} else {
+							referenced[matchedArgIndex] = true
+						}
+					}
+				}
+			}
+		}
+
+		return ast.WalkContinue, nil
+	})
+
+	// Phase 3: Add definition edits if referenced
+	for _, def := range defs {
+		if def.argIndex != -1 && !def.skip && referencedByDef[def.argIndex] {
+			arg := args[def.argIndex]
+			if arg.URL != "" {
+				edits = append(edits, textEdit{
+					start:    def.destStart,
+					end:      def.destEnd,
+					newText:  arg.URL,
+					argIndex: def.argIndex,
+				})
+			} else {
+				referenced[def.argIndex] = true
+			}
+		}
+	}
+
+	// Filter subsumed edits (edits strictly inside a standalone video edit)
+	var standaloneEdits []textEdit
+	for _, e := range edits {
+		if e.isStandalone {
+			standaloneEdits = append(standaloneEdits, e)
+		}
+	}
+
+	var finalEdits []textEdit
+	for _, e := range edits {
+		subsumed := false
+		for _, s := range standaloneEdits {
+			if !e.isStandalone && e.start >= s.start && e.end <= s.end {
+				subsumed = true
+				break
+			}
+		}
+		if !subsumed {
+			finalEdits = append(finalEdits, e)
+			if e.argIndex >= 0 {
+				referenced[e.argIndex] = true
+			}
+		}
+	}
+
+	// Sort edits: start ascending, end descending
+	sort.Slice(finalEdits, func(i, j int) bool {
+		if finalEdits[i].start != finalEdits[j].start {
+			return finalEdits[i].start < finalEdits[j].start
+		}
+		return finalEdits[i].end > finalEdits[j].end
+	})
+
+	// Apply edits from right to left
+	res := markdown
+	for i := len(finalEdits) - 1; i >= 0; i-- {
+		e := finalEdits[i]
+		res = res[:e.start] + e.newText + res[e.end:]
+	}
+
+	var toAppend []attachmentArg
+	for i, arg := range args {
+		if !referenced[i] {
+			toAppend = append(toAppend, arg)
+		}
+	}
+
+	return rewrittenMarkdown{
+		Rewritten: res,
+		ToAppend:  toAppend,
+	}, nil
+}
