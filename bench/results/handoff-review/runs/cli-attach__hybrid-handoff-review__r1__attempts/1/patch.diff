+package attachments
+
+import (
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/httpmock"
+	"github.com/spf13/cobra"
+	"github.com/stretchr/testify/require"
+)
+
+type UploadStub struct {
+	Name   string
+	Status int
+	Body   string
+}
+
+func StubUploadToHost(t *testing.T, reg *httpmock.Registry, uploadHost string, repositoryID int64, name string, status int, body string) {
+	reg.Register(func(req *http.Request) bool {
+		if !strings.EqualFold(req.Method, "POST") {
+			return false
+		}
+		if req.URL.Path != "/user-attachments/assets" && req.URL.EscapedPath() != "/user-attachments/assets" {
+			return false
+		}
+		if uploadHost != "" && req.URL.Host != uploadHost {
+			return false
+		}
+		if repositoryID > 0 && req.URL.Query().Get("repository_id") != fmt.Sprintf("%d", repositoryID) {
+			return false
+		}
+		if name != "" && req.URL.Query().Get("name") != name {
+			return false
+		}
+		return true
+	}, httpmock.StatusStringResponse(status, body))
+}
+
+func StubUpload(reg *httpmock.Registry, repositoryID int64, name string, status int, body string) {
+	StubUploadToHost(nil, reg, "", repositoryID, name, status, body)
+}
+
+func NewTestAssets(t *testing.T, names ...string) []UserAsset {
+	t.Helper()
+	cmd := &cobra.Command{}
+	f := AddFlag(cmd)
+	var args []string
+	for _, name := range names {
+		pathPart := name
+		altPart := ""
+		if idx := strings.Index(name, "#"); idx != -1 {
+			pathPart = name[:idx]
+			altPart = name[idx:]
+		}
+		actualPath := pathPart
+		if !filepath.IsAbs(actualPath) && !strings.HasPrefix(actualPath, ".") {
+			actualPath = "./" + actualPath
+		}
+		if _, err := os.Stat(actualPath); err != nil {
+			require.NoError(t, os.WriteFile(actualPath, []byte("test content"), 0o600))
+			t.Cleanup(func() { _ = os.Remove(actualPath) })
+		}
+		args = append(args, "--attach", actualPath+altPart)
+	}
+	require.NoError(t, cmd.Flags().Parse(args))
+	assets, err := f.UserAssets()
+	require.NoError(t, err)
+	return assets
+}
diff --git a/internal/attachments/userasset.go b/internal/attachments/userasset.go
new file mode 100644
index 000000000..cc2517a6b
--- /dev/null
+++ b/internal/attachments/userasset.go
@@ -0,0 +1,141 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+const (
+	maxImageBytes = 10 * 1024 * 1024
+	maxVideoBytes = 100 * 1024 * 1024
+)
+
+type UserAsset interface {
+	Path() string
+	getAsset() *asset
+	markdown(url string) string
+	rendersAsPlayer() bool
+}
+
+type asset struct {
+	path        string
+	alt         string
+	contentType string
+	info        os.FileInfo
+}
+
+func (a *asset) Path() string {
+	return a.path
+}
+
+func (a *asset) getAsset() *asset {
+	return a
+}
+
+type imageAsset struct {
+	asset
+}
+
+func (a *imageAsset) markdown(url string) string {
+	return fmt.Sprintf("![%s](%s)", escapeAltText(a.alt), url)
+}
+
+func (a *imageAsset) rendersAsPlayer() bool {
+	return false
+}
+
+type videoAsset struct {
+	asset
+}
+
+func (a *videoAsset) markdown(url string) string {
+	return url
+}
+
+func (a *videoAsset) rendersAsPlayer() bool {
+	return true
+}
+
+func escapeAltText(alt string) string {
+	r := strings.ReplaceAll(alt, `\`, `\\`)
+	r = strings.ReplaceAll(r, `[`, `\[`)
+	r = strings.ReplaceAll(r, `]`, `\]`)
+	r = strings.ReplaceAll(r, "\r", " ")
+	r = strings.ReplaceAll(r, "\n", " ")
+	return r
+}
+
+func newAsset(path, alt string) (UserAsset, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		var pathErr *fs.PathError
+		if errors.As(err, &pathErr) {
+			return nil, fmt.Errorf("%s: %w", path, pathErr.Err)
+		}
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+
+	if info.IsDir() {
+		return nil, fmt.Errorf("%s is a directory", path)
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%s is not a regular file", path)
+	}
+	if info.Size() == 0 {
+		return nil, fmt.Errorf("%s is empty", path)
+	}
+
+	ext := strings.ToLower(filepath.Ext(path))
+	ext = strings.TrimPrefix(ext, ".")
+
+	var contentType string
+	var isVideo bool
+	switch ext {
+	case "png":
+		contentType = "image/png"
+	case "jpg", "jpeg":
+		contentType = "image/jpeg"
+	case "gif":
+		contentType = "image/gif"
+	case "webp":
+		contentType = "image/webp"
+	case "svg":
+		contentType = "image/svg+xml"
+	case "mp4":
+		contentType = "video/mp4"
+		isVideo = true
+	case "mov":
+		contentType = "video/quicktime"
+		isVideo = true
+	case "webm":
+		contentType = "video/webm"
+		isVideo = true
+	default:
+		return nil, fmt.Errorf("%s is not a supported file type (supported: png, jpg, jpeg, gif, webp, svg, mp4, mov, webm)", path)
+	}
+
+	if isVideo {
+		if info.Size() > maxVideoBytes {
+			return nil, fmt.Errorf("%s: videos must be at most 100.0 MB", path)
+		}
+		if alt != "" {
+			return nil, errors.New("cannot set alt text on video")
+		}
+		alt = filepath.Base(path)
+		return &videoAsset{asset{path: path, alt: alt, contentType: contentType, info: info}}, nil
+	}
+
+	if info.Size() > maxImageBytes {
+		return nil, fmt.Errorf("%s: images must be at most 10.0 MB", path)
+	}
+	if alt == "" {
+		base := filepath.Base(path)
+		base = strings.TrimSuffix(base, filepath.Ext(path))
+		alt = strings.ReplaceAll(base, ".", " ")
+	}
+	return &imageAsset{asset{path: path, alt: alt, contentType: contentType, info: info}}, nil
+}
