+package attachments
+
+import (
+	"net/http"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/httpmock"
+	"github.com/spf13/cobra"
+)
+
+type UploadStub struct {
+	Name   string
+	Status int
+	Body   string
+}
+
+func StubUpload(reg *httpmock.Registry, repoID int64, name string, status int, body string) {
+	matcher := func(req *http.Request) bool {
+		if req.Method != "POST" {
+			return false
+		}
+		if !strings.HasSuffix(req.URL.Path, "user-attachments/assets") {
+			return false
+		}
+		q := req.URL.Query()
+		if q.Get("name") != name {
+			return false
+		}
+		if q.Get("repository_id") != strconv.FormatInt(repoID, 10) {
+			return false
+		}
+		return true
+	}
+	reg.Register(matcher, httpmock.StatusStringResponse(status, body))
+}
+
+func StubUploadToHost(t *testing.T, reg *httpmock.Registry, host string, repoID int64, name string, status int, body string) {
+	if t != nil {
+		t.Helper()
+	}
+	matcher := func(req *http.Request) bool {
+		if req.Method != "POST" {
+			return false
+		}
+		if req.URL.Host != host {
+			return false
+		}
+		if !strings.HasSuffix(req.URL.Path, "user-attachments/assets") {
+			return false
+		}
+		q := req.URL.Query()
+		if q.Get("name") != name {
+			return false
+		}
+		if q.Get("repository_id") != strconv.FormatInt(repoID, 10) {
+			return false
+		}
+		return true
+	}
+	reg.Register(matcher, httpmock.StatusStringResponse(status, body))
+}
+
+func NewTestAssets(t *testing.T, names ...string) []UserAsset {
+	t.Helper()
+	t.Chdir(t.TempDir())
+	cmd := &cobra.Command{}
+	flag := AddFlag(cmd)
+	argv := make([]string, 0, len(names)*2)
+	for _, n := range names {
+		path := n
+		alt := ""
+		if idx := strings.Index(n, "#"); idx != -1 {
+			path = n[:idx]
+			alt = n[idx:]
+		}
+		if !strings.HasPrefix(path, "./") && !filepath.IsAbs(path) {
+			path = "./" + path
+		}
+		cleanPath := filepath.Clean(path)
+		dir := filepath.Dir(cleanPath)
+		if dir != "." && dir != "" {
+			_ = os.MkdirAll(dir, 0o700)
+		}
+		_ = os.WriteFile(cleanPath, []byte("test-content"), 0o600)
+		argv = append(argv, "--attach", path+alt)
+	}
+	if err := cmd.Flags().Parse(argv); err != nil {
+		t.Fatal(err)
+	}
+	assets, err := flag.UserAssets()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return assets
+}
diff --git a/internal/attachments/userasset.go b/internal/attachments/userasset.go
new file mode 100644
index 000000000..6d84d7c8a
--- /dev/null
+++ b/internal/attachments/userasset.go
@@ -0,0 +1,170 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+const (
+	maxImageBytes int64 = 10 * 1024 * 1024
+	maxVideoBytes int64 = 100 * 1024 * 1024
+)
+
+type UserAsset interface {
+	Path() string
+	markdown(url string) string
+	rendersAsPlayer() bool
+	getAsset() asset
+}
+
+type asset struct {
+	path        string
+	info        fs.FileInfo
+	contentType string
+	alt         string
+}
+
+func (a *asset) Path() string {
+	return a.path
+}
+
+func (a *asset) getAsset() asset {
+	return *a
+}
+
+type imageAsset struct {
+	asset
+}
+
+func (a *imageAsset) rendersAsPlayer() bool {
+	return false
+}
+
+func (a *imageAsset) markdown(url string) string {
+	return fmt.Sprintf("![%s](%s)", escapeAlt(a.alt), url)
+}
+
+type videoAsset struct {
+	asset
+}
+
+func (a *videoAsset) rendersAsPlayer() bool {
+	return true
+}
+
+func (a *videoAsset) markdown(url string) string {
+	return url
+}
+
+func escapeAlt(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		switch r {
+		case '\\':
+			b.WriteString(`\\`)
+		case '[':
+			b.WriteString(`\[`)
+		case ']':
+			b.WriteString(`\]`)
+		case '\n', '\r':
+			b.WriteByte(' ')
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+func defaultImageAlt(path string) string {
+	base := filepath.Base(path)
+	ext := filepath.Ext(base)
+	stem := base[:len(base)-len(ext)]
+
+	left := strings.IndexFunc(stem, func(r rune) bool { return r != '.' })
+	if left == -1 {
+		return stem
+	}
+	right := strings.LastIndexFunc(stem, func(r rune) bool { return r != '.' })
+
+	leading := stem[:left]
+	trailing := stem[right+1:]
+	middle := strings.ReplaceAll(stem[left:right+1], ".", " ")
+
+	return leading + middle + trailing
+}
+
+var supportedExtensions = map[string]string{
+	"png":  "image/png",
+	"jpg":  "image/jpeg",
+	"jpeg": "image/jpeg",
+	"gif":  "image/gif",
+	"webp": "image/webp",
+	"svg":  "image/svg+xml",
+	"mp4":  "video/mp4",
+	"mov":  "video/quicktime",
+	"webm": "video/webm",
+}
+
+func newAsset(path, alt string) (UserAsset, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		var pathErr *fs.PathError
+		if errors.As(err, &pathErr) {
+			return nil, fmt.Errorf("%s: %w", path, pathErr.Err)
+		}
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+
+	if info.IsDir() {
+		return nil, fmt.Errorf("%s is a directory", path)
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%s is not a regular file", path)
+	}
+	if info.Size() == 0 {
+		return nil, fmt.Errorf("%s is empty", path)
+	}
+
+	ext := filepath.Ext(path)
+	cleanExt := strings.ToLower(strings.TrimPrefix(ext, "."))
+	contentType, ok := supportedExtensions[cleanExt]
+	if !ok || cleanExt == "" {
+		return nil, fmt.Errorf("%s is not a supported file type (supported: png, jpg, jpeg, gif, webp, svg, mp4, mov, webm)", path)
+	}
+
+	if strings.HasPrefix(contentType, "video/") {
+		if alt != "" {
+			return nil, errors.New("cannot set alt text on video")
+		}
+		if info.Size() > maxVideoBytes {
+			return nil, fmt.Errorf("%s: videos must be at most 100.0 MB", path)
+		}
+		return &videoAsset{
+			asset: asset{
+				path:        path,
+				info:        info,
+				contentType: contentType,
+				alt:         filepath.Base(path),
+			},
+		}, nil
+	}
+
+	if info.Size() > maxImageBytes {
+		return nil, fmt.Errorf("%s: images must be at most 10.0 MB", path)
+	}
+	if alt == "" {
+		alt = defaultImageAlt(path)
+	}
+	return &imageAsset{
+		asset: asset{
+			path:        path,
+			info:        info,
+			contentType: contentType,
+			alt:         alt,
+		},
+	}, nil
+}
