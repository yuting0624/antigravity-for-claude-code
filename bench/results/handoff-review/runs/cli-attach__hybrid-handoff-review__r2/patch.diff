index 000000000..5d7264e8f
--- /dev/null
+++ b/internal/attachments/attach.go
@@ -0,0 +1,75 @@
+package attachments
+
+import (
+	"context"
+	"fmt"
+	"strings"
+)
+
+func appendParagraph(md, addition string) string {
+	if addition == "" {
+		return md
+	}
+	trimmed := strings.TrimRight(md, " \t\r\n")
+	if trimmed == "" {
+		return addition
+	}
+	return trimmed + "\n\n" + addition
+}
+
+func formatAttachment(a attachmentArg) string {
+	if a.RendersAsPlayer {
+		return a.URL
+	}
+	return fmt.Sprintf("![%s](%s)", escapeAlt(a.Alt), a.URL)
+}
+
+func (u *Uploader) UploadAndAttach(ctx context.Context, body string, assets []UserAsset) (string, int, error) {
+	if len(assets) == 0 {
+		return body, 0, nil
+	}
+
+	args := make([]attachmentArg, len(assets))
+	for i, a := range assets {
+		args[i] = attachmentArg{
+			Path:            a.Path(),
+			Alt:             a.getAsset().alt,
+			RendersAsPlayer: a.rendersAsPlayer(),
+		}
+	}
+
+	_, err := newAttachableMarkdown(body, args)
+	if err != nil {
+		return body, 0, err
+	}
+
+	var uploadedCount int
+	for i, a := range assets {
+		url, err := u.upload(ctx, a)
+		if err != nil {
+			succeededArgs := args[:uploadedCount]
+			res, _ := attachAssetsToMarkdown(attachableMarkdown{markdown: body, attachmentArgs: succeededArgs})
+			finalBody := res.Rewritten
+			for _, toApp := range res.ToAppend {
+				if toApp.URL != "" {
+					finalBody = appendParagraph(finalBody, formatAttachment(toApp))
+				}
+			}
+			return finalBody, uploadedCount, err
+		}
+		args[i].URL = url
+		uploadedCount++
+	}
+
+	res, err := attachAssetsToMarkdown(attachableMarkdown{markdown: body, attachmentArgs: args})
+	if err != nil {
+		return body, uploadedCount, err
+	}
+	finalBody := res.Rewritten
+	for _, toApp := range res.ToAppend {
+		if toApp.URL != "" {
+			finalBody = appendParagraph(finalBody, formatAttachment(toApp))
+		}
+	}
+	return finalBody, uploadedCount, nil
+}
diff --git a/internal/attachments/client.go b/internal/attachments/client.go
new file mode 100644
index 000000000..db93b5f27
--- /dev/null
+++ b/internal/attachments/client.go
@@ -0,0 +1,243 @@
+package attachments
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/cli/cli/v2/internal/gh"
+	"github.com/cli/cli/v2/internal/ghinstance"
+)
+
+var openFile = func(path string) (io.ReadCloser, error) {
+	return os.Open(path)
+}
+
+type uploadError struct {
+	StatusCode int
+	Path       string
+	msg        string
+}
+
+func (e *uploadError) Error() string {
+	return e.msg
+}
+
+type serverErrorResponse struct {
+	Message string `json:"message"`
+	Errors  []struct {
+		Resource string `json:"resource"`
+		Field    string `json:"field"`
+		Code     string `json:"code"`
+		Message  string `json:"message"`
+	} `json:"errors"`
+}
+
+type Uploader struct {
+	httpClient       *http.Client
+	host             string
+	targetRepository int64
+}
+
+func checkHost(host string) error {
+	if ghinstance.CategorizeHost(host) == "ghes" {
+		return errors.New("attaching files is not supported on GitHub Enterprise Server")
+	}
+	return nil
+}
+
+func NewUploader(httpClient *http.Client, tokenType gh.TokenType, host string, targetRepository int64, viewerPermission string) (*Uploader, error) {
+	if err := checkHost(host); err != nil {
+		return nil, err
+	}
+
+	switch tokenType {
+	case gh.TokenTypeOAuth, gh.TokenTypePersonalAccess, gh.TokenTypeFineGrainedPAT:
+	default:
+		return nil, errors.New("unsupported authentication type")
+	}
+
+	if targetRepository <= 0 {
+		return nil, errors.New("could not determine which repository to attach files to")
+	}
+
+	if viewerPermission == "" {
+		return nil, errors.New("could not determine your permission on the repository to attach files")
+	}
+
+	switch viewerPermission {
+	case "ADMIN", "MAINTAIN", "WRITE":
+	default:
+		return nil, errors.New("attaching files requires write access to the repository")
+	}
+
+	return &Uploader{
+		httpClient:       httpClient,
+		host:             host,
+		targetRepository: targetRepository,
+	}, nil
+}
+
+func (u *Uploader) upload(ctx context.Context, a UserAsset) (string, error) {
+	rc, err := openFile(a.Path())
+	if err != nil {
+		return "", fmt.Errorf("failed to upload %s: %w", a.Path(), err)
+	}
+	defer rc.Close()
+
+	prefix := ghinstance.UserAssetUploadPrefix(u.host)
+	baseURL := prefix + "user-attachments/assets"
+	reqURL, err := url.Parse(baseURL)
+	if err != nil {
+		return "", fmt.Errorf("failed to upload %s: %w", a.Path(), err)
+	}
+
+	q := reqURL.Query()
+	q.Set("content_type", a.getAsset().contentType)
+	q.Set("name", filepath.Base(a.Path()))
+	q.Set("repository_id", strconv.FormatInt(u.targetRepository, 10))
+	reqURL.RawQuery = q.Encode()
+
+	req, err := http.NewRequestWithContext(ctx, "POST", reqURL.String(), rc)
+	if err != nil {
+		return "", fmt.Errorf("failed to upload %s: %w", a.Path(), err)
+	}
+	req.Header.Set("Content-Type", "application/octet-stream")
+	req.Header.Set("Accept", "application/vnd.github+json")
+	req.ContentLength = a.getAsset().info.Size()
+
+	resp, err := u.httpClient.Do(req)
+	if err != nil {
+		return "", fmt.Errorf("failed to upload %s: %w", a.Path(), err)
+	}
+	defer resp.Body.Close()
+
+	bodyBytes, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return "", &uploadError{
+			StatusCode: resp.StatusCode,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("failed to upload %s: %v", a.Path(), err),
+		}
+	}
+
+	if resp.StatusCode == 404 {
+		return "", &uploadError{
+			StatusCode: 404,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("could not upload %s: attaching files requires write access to the repository", a.Path()),
+		}
+	}
+
+	if resp.StatusCode == 413 {
+		var serverResp serverErrorResponse
+		_ = json.Unmarshal(bodyBytes, &serverResp)
+		msg := serverResp.Message
+		if msg == "" {
+			msg = resp.Status
+		}
+		return "", &uploadError{
+			StatusCode: 413,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("failed to upload %s: HTTP 413: %s", a.Path(), msg),
+		}
+	}
+
+	if resp.StatusCode == 422 {
+		var serverResp serverErrorResponse
+		_ = json.Unmarshal(bodyBytes, &serverResp)
+		prefix := fmt.Sprintf("could not upload %s", a.Path())
+		var causes []string
+		if serverResp.Message != "" {
+			causes = append(causes, serverResp.Message)
+		}
+		for _, errItem := range serverResp.Errors {
+			if errItem.Message != "" {
+				causes = append(causes, errItem.Message)
+			} else if errItem.Resource != "" && errItem.Field != "" && errItem.Code != "" {
+				causes = append(causes, fmt.Sprintf("%s.%s is %s", errItem.Resource, errItem.Field, errItem.Code))
+			} else if errItem.Field != "" && errItem.Code != "" {
+				causes = append(causes, fmt.Sprintf("%s is %s", errItem.Field, errItem.Code))
+			} else if errItem.Code != "" {
+				causes = append(causes, errItem.Code)
+			}
+		}
+		var errMsg string
+		if len(causes) > 0 {
+			errMsg = prefix + ": " + strings.Join(causes, "; ")
+		} else {
+			errMsg = prefix
+		}
+		return "", &uploadError{
+			StatusCode: 422,
+			Path:       a.Path(),
+			msg:        errMsg,
+		}
+	}
+
+	if resp.StatusCode == 429 {
+		retryAfter := resp.Header.Get("Retry-After")
+		var reason string
+		if retryAfter == "" {
+			reason = "wait and try again"
+		} else if _, err := strconv.Atoi(retryAfter); err == nil {
+			reason = fmt.Sprintf("retry after %s seconds", retryAfter)
+		} else {
+			reason = fmt.Sprintf("retry after %s", retryAfter)
+		}
+		return "", &uploadError{
+			StatusCode: 429,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("could not upload %s: rate limited; %s", a.Path(), reason),
+		}
+	}
+
+	if resp.StatusCode >= 500 {
+		var serverResp serverErrorResponse
+		_ = json.Unmarshal(bodyBytes, &serverResp)
+		msg := serverResp.Message
+		if msg == "" {
+			msg = resp.Status
+		}
+		return "", &uploadError{
+			StatusCode: resp.StatusCode,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("failed to upload %s: HTTP %d: %s", a.Path(), resp.StatusCode, msg),
+		}
+	}
+
+	if resp.StatusCode != 200 && resp.StatusCode != 201 {
+		return "", &uploadError{
+			StatusCode: resp.StatusCode,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("failed to upload %s: HTTP %d", a.Path(), resp.StatusCode),
+		}
+	}
+
+	var result struct {
+		URL string `json:"url"`
+	}
+	if err := json.Unmarshal(bodyBytes, &result); err != nil {
+		return "", &uploadError{
+			StatusCode: 0,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("failed to upload %s: %v", a.Path(), err),
+		}
+	}
+	if result.URL == "" {
+		return "", &uploadError{
+			StatusCode: 0,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("failed to upload %s: the server returned no asset URL", a.Path()),
+		}
+	}
+	return result.URL, nil
+}
diff --git a/internal/attachments/flags.go b/internal/attachments/flags.go
new file mode 100644
index 000000000..28835031f
--- /dev/null
+++ b/internal/attachments/flags.go
@@ -0,0 +1,94 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"os"
+
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+)
+
+const flagName = "attach"
+
+type Flag struct {
+	flag   *pflag.Flag
+	values []string
+}
+
+func AddFlag(cmd *cobra.Command) *Flag {
+	f := &Flag{}
+	cmd.Flags().StringArrayVar(&f.values, flagName, []string{}, "Attach an image or video `file`, in '<file>#<image alt text>' format")
+	f.flag = cmd.Flags().Lookup(flagName)
+	return f
+}
+
+func (f *Flag) Changed() bool {
+	return f != nil && f.flag != nil && f.flag.Changed
+}
+
+func (f *Flag) UserAssets() ([]UserAsset, error) {
+	if f == nil || !f.Changed() {
+		return nil, nil
+	}
+	var assets []UserAsset
+	for _, raw := range f.values {
+		if raw == "" {
+			return nil, errors.New("cannot attach an empty path; --attach needs a file path")
+		}
+		if raw == "-" {
+			return nil, errors.New("cannot attach standard input; --attach needs a file path")
+		}
+
+		var path, alt string
+		if _, err := os.Stat(raw); err == nil {
+			path = raw
+			alt = ""
+		} else {
+			var hashIndices []int
+			for i := 0; i < len(raw); i++ {
+				if raw[i] == '#' {
+					hashIndices = append(hashIndices, i)
+				}
+			}
+			found := false
+			for i := len(hashIndices) - 1; i >= 0; i-- {
+				idx := hashIndices[i]
+				candidate := raw[:idx]
+				if _, err := os.Stat(candidate); err == nil {
+					path = candidate
+					alt = raw[idx+1:]
+					found = true
+					break
+				}
+			}
+			if !found {
+				if len(hashIndices) > 0 {
+					lastHash := hashIndices[len(hashIndices)-1]
+					path = raw[:lastHash]
+					alt = raw[lastHash+1:]
+				} else {
+					path = raw
+					alt = ""
+				}
+			}
+		}
+
+		if path == "" {
+			return nil, errors.New("cannot attach an empty path; --attach needs a file path")
+		}
+
+		asset, err := newAsset(path, alt)
+		if err != nil {
+			return nil, err
+		}
+
+		for _, prev := range assets {
+			if os.SameFile(prev.getAsset().info, asset.getAsset().info) {
+				return nil, fmt.Errorf("%s and %s are the same file; attached files must be unique", prev.Path(), asset.Path())
+			}
+		}
+		assets = append(assets, asset)
+	}
+	return assets, nil
+}
diff --git a/internal/attachments/references.go b/internal/attachments/references.go
new file mode 100644
index 000000000..a3cc0b01e
--- /dev/null
+++ b/internal/attachments/references.go
@@ -0,0 +1,694 @@
+package attachments
+
+import (
+	"fmt"
+	"net/url"
+	"path/filepath"
+	"strings"
+
+	"github.com/yuin/goldmark"
+	"github.com/yuin/goldmark/ast"
+	"github.com/yuin/goldmark/parser"
+	"github.com/yuin/goldmark/text"
+)
+
+type attachmentArg struct {
+	Path            string
+	URL             string
+	Alt             string
+	RendersAsPlayer bool
+}
+
+type attachableMarkdown struct {
+	markdown       string
+	attachmentArgs []attachmentArg
+}
+
+type attachResult struct {
+	Rewritten string
+	ToAppend  []attachmentArg
+}
+
+func unescapeBackslashes(s string) string {
+	var b strings.Builder
+	b.Grow(len(s))
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\\' && i+1 < len(s) {
+			i++
+			b.WriteByte(s[i])
+		} else {
+			b.WriteByte(s[i])
+		}
+	}
+	return b.String()
+}
+
+func matchesPath(dest, argPath string) bool {
+	if strings.HasPrefix(dest, "#") || strings.HasPrefix(dest, "//") {
+		return false
+	}
+	if u, err := url.Parse(dest); err == nil && len(u.Scheme) > 1 {
+		return false
+	}
+
+	cleanDest := dest
+	if strings.HasPrefix(cleanDest, "<") && strings.HasSuffix(cleanDest, ">") {
+		cleanDest = cleanDest[1 : len(cleanDest)-1]
+	}
+
+	variants := []string{cleanDest, unescapeBackslashes(cleanDest)}
+	if unesc, err := url.PathUnescape(cleanDest); err == nil {
+		variants = append(variants, unesc, unescapeBackslashes(unesc))
+	}
+
+	cleanArg := filepath.Clean(argPath)
+	absArg, absArgErr := filepath.Abs(argPath)
+
+	for _, v := range variants {
+		if v == argPath {
+			return true
+		}
+		if filepath.Clean(v) == cleanArg {
+			return true
+		}
+		if absArgErr == nil {
+			if absV, err := filepath.Abs(v); err == nil && absV == absArg {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func newAttachableMarkdown(markdown string, args []attachmentArg) (attachableMarkdown, error) {
+	pc := parser.NewContext()
+	doc := goldmark.New().Parser().Parse(text.NewReader([]byte(markdown)), parser.WithContext(pc))
+
+	var offending []string
+	seen := make(map[string]bool)
+
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		img, ok := n.(*ast.Image)
+		if !ok || img.Reference == nil {
+			return ast.WalkContinue, nil
+		}
+		dest := string(img.Destination)
+		for _, arg := range args {
+			if arg.RendersAsPlayer && matchesPath(dest, arg.Path) {
+				if !seen[arg.Path] {
+					seen[arg.Path] = true
+					offending = append(offending, arg.Path)
+				}
+				break
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+
+	if len(offending) > 0 {
+		return attachableMarkdown{}, fmt.Errorf("cannot embed a video as a reference-style image: %s", strings.Join(offending, ", "))
+	}
+
+	return attachableMarkdown{
+		markdown:       markdown,
+		attachmentArgs: args,
+	}, nil
+}
+
+type codeRange struct {
+	start int
+	stop  int
+}
+
+func inCodeRanges(pos int, ranges []codeRange) bool {
+	for _, r := range ranges {
+		if pos >= r.start && pos < r.stop {
+			return true
+		}
+	}
+	return false
+}
+
+func getCodeRanges(doc ast.Node, md []byte) []codeRange {
+	var ranges []codeRange
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		switch n.Kind() {
+		case ast.KindCodeBlock, ast.KindFencedCodeBlock:
+			lines := n.Lines()
+			if lines != nil && lines.Len() > 0 {
+				start := lines.At(0).Start
+				stop := lines.At(lines.Len() - 1).Stop
+				// If fenced, expand backwards to fence opening and forwards to closing fence
+				if n.Kind() == ast.KindFencedCodeBlock {
+					for start > 0 && md[start-1] != '\n' {
+						start--
+					}
+					for stop < len(md) && md[stop] != '\n' {
+						stop++
+					}
+					if stop < len(md) && md[stop] == '\n' {
+						stop++
+					}
+				}
+				ranges = append(ranges, codeRange{start: start, stop: stop})
+			}
+		case ast.KindCodeSpan:
+			// Find backticks around code span
+			for c := n.FirstChild(); c != nil; c = c.NextSibling() {
+				if t, ok := c.(*ast.Text); ok {
+					start := t.Segment.Start
+					stop := t.Segment.Stop
+					for start > 0 && md[start-1] == '`' {
+						start--
+					}
+					for stop < len(md) && md[stop] == '`' {
+						stop++
+					}
+					ranges = append(ranges, codeRange{start: start, stop: stop})
+				}
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+	return ranges
+}
+
+type singleParagraphVideo struct {
+	start int
+	stop  int
+	path  string
+	url   string
+}
+
+func findSingleParagraphVideos(doc ast.Node, md []byte, args []attachmentArg) []singleParagraphVideo {
+	var result []singleParagraphVideo
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		img, ok := n.(*ast.Image)
+		if !ok || img.Reference != nil {
+			return ast.WalkContinue, nil
+		}
+		p, ok := n.Parent().(*ast.Paragraph)
+		if !ok || p.ChildCount() != 1 {
+			return ast.WalkContinue, nil
+		}
+		dest := string(img.Destination)
+		for _, arg := range args {
+			if arg.RendersAsPlayer && arg.URL != "" && matchesPath(dest, arg.Path) {
+				if p.Lines() != nil && p.Lines().Len() > 0 {
+					seg := p.Lines().At(0)
+					result = append(result, singleParagraphVideo{
+						start: seg.Start,
+						stop:  seg.Stop,
+						path:  arg.Path,
+						url:   arg.URL,
+					})
+				}
+				break
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+	return result
+}
+
+func parseLinkTail(md string, start int) (destStart, destEnd int, titlePart string, endParen int, ok bool) {
+	if start >= len(md) {
+		return 0, 0, "", 0, false
+	}
+	pos := start
+	if md[pos] == '<' {
+		destStart = pos
+		pos++
+		for pos < len(md) {
+			if md[pos] == '\n' || md[pos] == '\r' || md[pos] == '<' {
+				return 0, 0, "", 0, false
+			}
+			if md[pos] == '\\' && pos+1 < len(md) {
+				pos += 2
+				continue
+			}
+			if md[pos] == '>' {
+				destEnd = pos + 1
+				pos++
+				break
+			}
+			pos++
+		}
+		if destEnd == 0 {
+			return 0, 0, "", 0, false
+		}
+	} else {
+		destStart = pos
+		parenDepth := 0
+		for pos < len(md) {
+			if md[pos] == '\n' || md[pos] == '\r' {
+				return 0, 0, "", 0, false
+			}
+			if md[pos] == '\\' && pos+1 < len(md) {
+				pos += 2
+				continue
+			}
+			if md[pos] == '(' {
+				parenDepth++
+				pos++
+				continue
+			}
+			if md[pos] == ')' {
+				if parenDepth > 0 {
+					parenDepth--
+					pos++
+					continue
+				}
+				destEnd = pos
+				endParen = pos + 1
+				return destStart, destEnd, "", endParen, true
+			}
+			if md[pos] == ' ' || md[pos] == '\t' {
+				if parenDepth > 0 {
+					return 0, 0, "", 0, false
+				}
+				destEnd = pos
+				break
+			}
+			pos++
+		}
+		if destEnd == 0 {
+			return 0, 0, "", 0, false
+		}
+	}
+
+	// After destination, skip whitespace to title or ')'
+	titleScanStart := pos
+	for pos < len(md) && (md[pos] == ' ' || md[pos] == '\t') {
+		pos++
+	}
+	if pos >= len(md) {
+		return 0, 0, "", 0, false
+	}
+	if md[pos] == ')' {
+		return destStart, destEnd, md[titleScanStart:pos], pos + 1, true
+	}
+
+	if md[pos] == '"' || md[pos] == '\'' || md[pos] == '(' {
+		closeDelim := md[pos]
+		if closeDelim == '(' {
+			closeDelim = ')'
+		}
+		pos++
+		for pos < len(md) {
+			if md[pos] == '\\' && pos+1 < len(md) {
+				pos += 2
+				continue
+			}
+			if md[pos] == closeDelim {
+				pos++
+				break
+			}
+			pos++
+		}
+		if pos > len(md) {
+			return 0, 0, "", 0, false
+		}
+		titleEnd := pos
+		for pos < len(md) && (md[pos] == ' ' || md[pos] == '\t') {
+			pos++
+		}
+		if pos < len(md) && md[pos] == ')' {
+			return destStart, destEnd, md[titleScanStart:titleEnd], pos + 1, true
+		}
+	}
+	return 0, 0, "", 0, false
+}
+
+func escapeAltLabel(s string) string {
+	var b strings.Builder
+	b.Grow(len(s))
+	for i := 0; i < len(s); i++ {
+		if s[i] == ']' {
+			b.WriteString(`\]`)
+		} else {
+			b.WriteByte(s[i])
+		}
+	}
+	return b.String()
+}
+
+func attachAssetsToMarkdown(v attachableMarkdown) (attachResult, error) {
+	if len(v.attachmentArgs) == 0 {
+		return attachResult{Rewritten: v.markdown, ToAppend: nil}, nil
+	}
+	if v.markdown == "" {
+		return attachResult{Rewritten: "", ToAppend: v.attachmentArgs}, nil
+	}
+
+	source := []byte(v.markdown)
+	pc := parser.NewContext()
+	doc := goldmark.New().Parser().Parse(text.NewReader(source), parser.WithContext(pc))
+
+	codeRanges := getCodeRanges(doc, source)
+
+	// Track which args are used anywhere in the document
+	argUsed := make(map[string]bool)
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		switch node := n.(type) {
+		case *ast.Link:
+			dest := string(node.Destination)
+			for _, a := range v.attachmentArgs {
+				if matchesPath(dest, a.Path) {
+					argUsed[a.Path] = true
+				}
+			}
+		case *ast.Image:
+			dest := string(node.Destination)
+			for _, a := range v.attachmentArgs {
+				if matchesPath(dest, a.Path) {
+					argUsed[a.Path] = true
+				}
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+
+	singleVideos := findSingleParagraphVideos(doc, source, v.attachmentArgs)
+
+	// Step 1: Rewrite Definitions that are used
+	type textReplacement struct {
+		start int
+		stop  int
+		text  string
+	}
+	var defReplacements []textReplacement
+
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		def, ok := n.(*ast.LinkReferenceDefinition)
+		if !ok || def.Lines() == nil || def.Lines().Len() == 0 {
+			return ast.WalkContinue, nil
+		}
+		dest := string(def.Destination)
+		var matchedArg *attachmentArg
+		for i := range v.attachmentArgs {
+			if v.attachmentArgs[i].URL != "" && matchesPath(dest, v.attachmentArgs[i].Path) {
+				matchedArg = &v.attachmentArgs[i]
+				break
+			}
+		}
+		if matchedArg == nil || !argUsed[matchedArg.Path] {
+			return ast.WalkContinue, nil
+		}
+
+		// Check if definition is continued onto next line in a blockquote
+		if def.Lines().Len() > 1 {
+			firstLineStop := def.Lines().At(0).Stop
+			secondLineStart := def.Lines().At(1).Start
+			between := string(source[firstLineStop:secondLineStart])
+			if strings.Contains(between, ">") {
+				return ast.WalkContinue, nil
+			}
+		}
+
+		// Find destination on definition line
+		seg0 := def.Lines().At(0)
+		lineText := string(source[seg0.Start:seg0.Stop])
+		colonIdx := -1
+		for i := 0; i < len(lineText); i++ {
+			if lineText[i] == ']' && (i == 0 || lineText[i-1] != '\\') && i+1 < len(lineText) && lineText[i+1] == ':' {
+				colonIdx = i + 1
+				break
+			}
+		}
+		if colonIdx == -1 {
+			return ast.WalkContinue, nil
+		}
+		afterColon := seg0.Start + colonIdx + 1
+		for afterColon < len(source) && (source[afterColon] == ' ' || source[afterColon] == '\t') {
+			afterColon++
+		}
+		if afterColon >= len(source) || source[afterColon] == '\n' || source[afterColon] == '\r' {
+			return ast.WalkContinue, nil
+		}
+
+		// Locate destination in source
+		destStart := afterColon
+		var destStop int
+		if source[destStart] == '<' {
+			for idx := destStart + 1; idx < len(source); idx++ {
+				if source[idx] == '\\' && idx+1 < len(source) {
+					idx++
+					continue
+				}
+				if source[idx] == '>' {
+					destStop = idx + 1
+					break
+				}
+			}
+			if destStop == 0 {
+				return ast.WalkContinue, nil
+			}
+		} else {
+			destStop = destStart
+			for destStop < len(source) && source[destStop] != ' ' && source[destStop] != '\t' && source[destStop] != '\n' && source[destStop] != '\r' {
+				destStop++
+			}
+		}
+
+		defReplacements = append(defReplacements, textReplacement{
+			start: destStart,
+			stop:  destStop,
+			text:  matchedArg.URL,
+		})
+		return ast.WalkContinue, nil
+	})
+
+	// Step 2: Rewrite Inline links and images
+	// Single paragraph videos: replace entire embed with URL
+	var inlineReplacements []textReplacement
+
+	for _, sv := range singleVideos {
+		inlineReplacements = append(inlineReplacements, textReplacement{
+			start: sv.start,
+			stop:  sv.stop,
+			text:  sv.url,
+		})
+	}
+
+	// Scan for other `](`
+	mdStr := v.markdown
+	for i := 0; i < len(mdStr)-1; i++ {
+		if mdStr[i] != ']' || mdStr[i+1] != '(' {
+			continue
+		}
+		if inCodeRanges(i, codeRanges) {
+			continue
+		}
+
+		// Check if i is inside any singleParagraphVideo
+		insideSV := false
+		for _, sv := range singleVideos {
+			if i >= sv.start && i < sv.stop {
+				insideSV = true
+				break
+			}
+		}
+		if insideSV {
+			continue
+		}
+
+		destStart, destEnd, _, _, ok := parseLinkTail(mdStr, i+2)
+		if !ok {
+			continue
+		}
+
+		// Find opening bracket
+		bracketDepth := 0
+		openBracket := -1
+		for k := i - 1; k >= 0; k-- {
+			if inCodeRanges(k, codeRanges) {
+				// Jump to start of code range
+				for _, cr := range codeRanges {
+					if k >= cr.start && k < cr.stop {
+						k = cr.start
+						break
+					}
+				}
+				continue
+			}
+			if k > 0 && mdStr[k-1] == '\\' {
+				continue
+			}
+			if mdStr[k] == ']' {
+				bracketDepth++
+				continue
+			}
+			if mdStr[k] == '[' {
+				if bracketDepth > 0 {
+					bracketDepth--
+					continue
+				}
+				openBracket = k
+				break
+			}
+			if k > 0 && (mdStr[k] == '\n' && mdStr[k-1] == '\n') {
+				break
+			}
+		}
+		if openBracket == -1 {
+			continue
+		}
+
+		// Determine if image
+		isImage := false
+		embedStart := openBracket
+		if openBracket > 0 && mdStr[openBracket-1] == '!' {
+			slashes := 0
+			for s := openBracket - 2; s >= 0 && mdStr[s] == '\\'; s-- {
+				slashes++
+			}
+			if slashes%2 == 0 {
+				isImage = true
+				embedStart = openBracket - 1
+			}
+		}
+
+		dest := mdStr[destStart:destEnd]
+		var matchedArg *attachmentArg
+		for aIdx := range v.attachmentArgs {
+			if v.attachmentArgs[aIdx].URL != "" && matchesPath(dest, v.attachmentArgs[aIdx].Path) {
+				matchedArg = &v.attachmentArgs[aIdx]
+				break
+			}
+		}
+		if matchedArg == nil {
+			continue
+		}
+
+		if !isImage {
+			// Link: replace destination
+			inlineReplacements = append(inlineReplacements, textReplacement{
+				start: destStart,
+				stop:  destEnd,
+				text:  matchedArg.URL,
+			})
+		} else if !matchedArg.RendersAsPlayer {
+			// Image: replace destination
+			inlineReplacements = append(inlineReplacements, textReplacement{
+				start: destStart,
+				stop:  destEnd,
+				text:  matchedArg.URL,
+			})
+		} else {
+			// Video embed not alone in paragraph: degrade to link
+			// 1. Destination becomes URL
+			inlineReplacements = append(inlineReplacements, textReplacement{
+				start: destStart,
+				stop:  destEnd,
+				text:  matchedArg.URL,
+			})
+
+			// 2. Prefix and label
+			repStart := embedStart
+			repPrefix := ""
+			if embedStart > 0 && mdStr[embedStart-1] == '!' {
+				if embedStart > 1 && mdStr[embedStart-2] == '\\' {
+					// already escaped
+				} else {
+					repStart = embedStart - 1
+					repPrefix = `\!`
+				}
+			}
+
+			if openBracket+1 == i {
+				// Empty alt text: ![] -> [filename]
+				inlineReplacements = append(inlineReplacements, textReplacement{
+					start: repStart,
+					stop:  i + 1,
+					text:  repPrefix + "[" + escapeAltLabel(matchedArg.Alt) + "]",
+				})
+			} else {
+				// Non-empty alt text: convert ![ to [
+				inlineReplacements = append(inlineReplacements, textReplacement{
+					start: repStart,
+					stop:  openBracket + 1,
+					text:  repPrefix + "[",
+				})
+			}
+		}
+	}
+
+	// Combine all replacements and sort from highest index to lowest
+	allReplacements := append(defReplacements, inlineReplacements...)
+	// Sort by start descending. If start equal, longer stop first.
+	for i := 0; i < len(allReplacements)-1; i++ {
+		for j := i + 1; j < len(allReplacements); j++ {
+			if allReplacements[i].start < allReplacements[j].start ||
+				(allReplacements[i].start == allReplacements[j].start && allReplacements[i].stop < allReplacements[j].stop) {
+				allReplacements[i], allReplacements[j] = allReplacements[j], allReplacements[i]
+			}
+		}
+	}
+
+	// Filter out overlapping replacements (outer replacement wins if it completely contains inner)
+	var filtered []textReplacement
+	lastStart := len(mdStr) + 1
+	for _, r := range allReplacements {
+		if r.stop <= lastStart {
+			filtered = append(filtered, r)
+			lastStart = r.start
+		}
+	}
+
+	// Apply replacements to mdStr
+	rewritten := mdStr
+	for _, r := range filtered {
+		rewritten = rewritten[:r.start] + r.text + rewritten[r.stop:]
+	}
+
+	// Determine ToAppend: attachments whose URL was not used in the final rewritten markdown
+	var toAppend []attachmentArg
+	for _, arg := range v.attachmentArgs {
+		if arg.URL == "" {
+			continue
+		}
+		if !strings.Contains(rewritten, arg.URL) {
+			toAppend = append(toAppend, arg)
+		}
+	}
+
+	return attachResult{
+		Rewritten: rewritten,
+		ToAppend:  toAppend,
+	}, nil
+}
+
+func isSingleImage(markdown, url string) bool {
+	doc := goldmark.New().Parser().Parse(text.NewReader([]byte(markdown)))
+	if doc.ChildCount() != 1 {
+		return false
+	}
+	p, ok := doc.FirstChild().(*ast.Paragraph)
+	if !ok {
+		return false
+	}
+	if p.ChildCount() != 1 {
+		return false
+	}
+	img, ok := p.FirstChild().(*ast.Image)
+	if !ok {
+		return false
+	}
+	return string(img.Destination) == url
+}
