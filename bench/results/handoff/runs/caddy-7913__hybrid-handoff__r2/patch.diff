+// limitations under the License.
+
+package caddyhttp
+
+import (
+	"bufio"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+)
+
+// DefaultMaxWriteChunk is the default maximum number of bytes written to the underlying connection by a single write while an idle write deadline is in effect. A write deadline bounds the whole write call it precedes, not merely a stall within it, so large writes are split into chunks of at most this size with the deadline reset between them.
+const DefaultMaxWriteChunk = 64 * 1024
+
+// IdleDeadline defines the constraints for an idle timeout mechanism.
+type IdleDeadline struct {
+	// Start is when the transfer began; the fixed base from which the MinRate allowance grows; filled in on first use if zero.
+	Start time.Time
+	// Timeout is the idle window; the deadline is pushed to now+Timeout before every read or write; zero disables it.
+	Timeout time.Duration
+	// MinRate is the minimum acceptable transfer rate in bytes per second; zero disables the rate floor.
+	MinRate int64
+	// HardDeadline is an absolute ceiling the computed deadline may never pass, if non-zero.
+	HardDeadline time.Time
+}
+
+func (d IdleDeadline) next(now time.Time, transferred int64) time.Time {
+	var deadline time.Time
+	if d.Timeout > 0 {
+		deadline = now.Add(d.Timeout)
+	}
+	if d.MinRate > 0 {
+		start := d.Start
+		if start.IsZero() {
+			start = now
+		}
+		allowed := d.Timeout + time.Duration(float64(transferred)/float64(d.MinRate)*float64(time.Second))
+		rateDeadline := start.Add(allowed)
+		if deadline.IsZero() || rateDeadline.Before(deadline) {
+			deadline = rateDeadline
+		}
+	}
+	if !d.HardDeadline.IsZero() && (deadline.IsZero() || d.HardDeadline.Before(deadline)) {
+		deadline = d.HardDeadline
+	}
+	return deadline
+}
+
+// IdleTimeoutReader wraps an io.ReadCloser to apply idle timeouts on read operations.
+type IdleTimeoutReader struct {
+	io.ReadCloser
+	// Ctrl provides control over the HTTP response.
+	Ctrl *http.ResponseController
+	// Deadline contains the idle deadline configuration.
+	Deadline IdleDeadline
+	// Logger is the zap logger used to log deadline errors.
+	Logger *zap.Logger
+	read   int64
+}
+
+// Read reads from the underlying ReadCloser and updates the idle deadline.
+func (r *IdleTimeoutReader) Read(p []byte) (int, error) {
+	if r.Deadline.Start.IsZero() {
+		r.Deadline.Start = time.Now()
+	}
+	setDeadline(r.Ctrl.SetReadDeadline, r.Deadline.next(time.Now(), r.read), "read", r.Logger)
+	n, err := r.ReadCloser.Read(p)
+	r.read += int64(n)
+	return n, err
+}
+
+// Close closes the underlying ReadCloser and clears the read deadline.
+func (r *IdleTimeoutReader) Close() error {
+	_ = r.Ctrl.SetReadDeadline(time.Time{})
+	return r.ReadCloser.Close()
+}
+
+// IdleTimeoutWriter wraps a ResponseWriterWrapper to apply idle timeouts on write operations.
+type IdleTimeoutWriter struct {
+	*ResponseWriterWrapper
+	// Ctrl provides control over the HTTP response.
+	Ctrl *http.ResponseController
+	// Deadline contains the idle deadline configuration.
+	Deadline IdleDeadline
+	// MaxChunk is the largest number of bytes covered by a single underlying write; if zero, DefaultMaxWriteChunk is used.
+	MaxChunk int
+	// Logger is the zap logger used to log deadline errors.
+	Logger  *zap.Logger
+	written int64
+}
+
+func (w *IdleTimeoutWriter) maxChunk() int {
+	if w.MaxChunk > 0 {
+		return w.MaxChunk
+	}
+	return DefaultMaxWriteChunk
+}
+
+func (w *IdleTimeoutWriter) resetDeadline() {
+	if w.Deadline.Start.IsZero() {
+		w.Deadline.Start = time.Now()
+	}
+	setDeadline(w.Ctrl.SetWriteDeadline, w.Deadline.next(time.Now(), w.written), "write", w.Logger)
+}
+
+// WriteHeader sends an HTTP response header with the provided status code, resetting the deadline.
+func (w *IdleTimeoutWriter) WriteHeader(statusCode int) {
+	w.resetDeadline()
+	w.ResponseWriterWrapper.WriteHeader(statusCode)
+}
+
+// Write writes the data to the connection as part of an HTTP reply, resetting the deadline for each chunk.
+func (w *IdleTimeoutWriter) Write(p []byte) (int, error) {
+	maxSize := w.maxChunk()
+	var total int
+	for {
+		chunk := p[total:]
+		if len(chunk) > maxSize {
+			chunk = chunk[:maxSize]
+		}
+		w.resetDeadline()
+		n, err := w.ResponseWriterWrapper.Write(chunk)
+		total += n
+		w.written += int64(n)
+		if err != nil {
+			return total, err
+		}
+		if total >= len(p) {
+			return total, nil
+		}
+	}
+}
+
+// ReadFrom reads data from r until EOF or error, resetting the deadline for each read.
+func (w *IdleTimeoutWriter) ReadFrom(r io.Reader) (int64, error) {
+	maxSize := int64(w.maxChunk())
+	var total int64
+	for {
+		w.resetDeadline()
+		n, err := w.ResponseWriterWrapper.ReadFrom(io.LimitReader(r, maxSize))
+		total += n
+		w.written += n
+		if err != nil {
+			return total, err
+		}
+		if n < maxSize {
+			return total, nil
+		}
+	}
+}
+
+// Hijack lets the caller take over the connection, clearing the deadlines before handing it over.
+func (w *IdleTimeoutWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	// a hijacked connection is no longer governed by this response writer,
+	// so clear the deadlines we installed before handing it over
+	_ = w.Ctrl.SetWriteDeadline(time.Time{})
+	_ = w.Ctrl.SetReadDeadline(time.Time{})
+	return w.Ctrl.Hijack()
+}
+
+func setDeadline(set func(time.Time) error, t time.Time, kind string, logger *zap.Logger) {
+	err := set(t)
+	if err == nil || logger == nil {
+		return
+	}
+	level := zapcore.ErrorLevel
+	if errors.Is(err, http.ErrNotSupported) {
+		level = zapcore.DebugLevel
+	}
+	if c := logger.Check(level, "could not set "+kind+" deadline"); c != nil {
+		c.Write(zap.Error(err))
+	}
+}
+
+// Interface guards
+var (
+	_ io.ReadCloser       = (*IdleTimeoutReader)(nil)
+	_ http.ResponseWriter = (*IdleTimeoutWriter)(nil)
+	_ io.ReaderFrom       = (*IdleTimeoutWriter)(nil)
+	_ http.Hijacker       = (*IdleTimeoutWriter)(nil)
+)
