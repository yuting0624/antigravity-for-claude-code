+// WorktreeAdd adds a worktree at the given path for branch via
+// `git worktree add`.
+// When trackingRef is empty, it checks out an existing branch:
+//
+//	git worktree add -- <path> <branch>
+//
+// When trackingRef is non-empty, it creates a new branch tracking trackingRef:
+//
+//	git worktree add --track -b <branch> -- <path> <trackingRef>
+func (c *Client) WorktreeAdd(ctx context.Context, path, branch string, trackingRef ...string) error {
+	cmd, err := c.WorktreeAddCommand(ctx, path, branch, trackingRef...)
+	if err != nil {
+		return err
+	}
+	_, err = cmd.Output()
+	return err
+}
+
+// WorktreeAddCommand prepares a git worktree add command.
+func (c *Client) WorktreeAddCommand(ctx context.Context, path, branch string, trackingRef ...string) (*Command, error) {
+	return c.Command(ctx, c.WorktreeAddArgs(path, branch, trackingRef...)...)
+}
+
+// WorktreeAddArgs returns the argument list for `git worktree add`.
+func (c *Client) WorktreeAddArgs(path, branch string, trackingRef ...string) []string {
+	return WorktreeAddArgs(path, branch, trackingRef...)
+}
+
+// WorktreeAddArgs returns the argument list for `git worktree add`.
+// When trackingRef is empty, it returns the form for an existing branch:
+//
+//	git worktree add -- <path> <branch>
+//
+// When trackingRef is non-empty, it returns the form for a new tracking branch:
+//
+//	git worktree add --track -b <branch> -- <path> <trackingRef>
+func WorktreeAddArgs(path, branch string, trackingRef ...string) []string {
+	var track string
+	if len(trackingRef) > 0 {
+		track = trackingRef[0]
+	}
+	if track != "" {
+		return []string{"worktree", "add", "--track", "-b", branch, "--", path, track}
+	}
+	return []string{"worktree", "add", "--", path, branch}
+}
+
 // WorktreeRemove removes the worktree at the given path via
 // `git worktree remove <path>`.
 func (c *Client) WorktreeRemove(ctx context.Context, path string) error {
