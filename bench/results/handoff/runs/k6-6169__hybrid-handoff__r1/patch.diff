diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..d3f43de10
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,146 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strconv"
+	"time"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// StartLocalExecution initiates local execution of a load test in the cloud.
+func (c *Client) StartLocalExecution(
+	ctx context.Context,
+	loadTestID int64,
+	req StartLocalExecutionRequest,
+) (*StartLocalExecutionResponse, error) {
+	endpoint := fmt.Sprintf("%s/provisioning/v1/load_tests/%d/start_local_execution", c.host, loadTestID)
+
+	var wireReq struct {
+		Options       json.RawMessage `json:"options"`
+		MaxVUs        int64           `json:"max_vus"`
+		TotalDuration int64           `json:"total_duration"`
+		ArchiveSize   *int64          `json:"archive_size"`
+	}
+	wireReq.Options = req.Options
+	wireReq.MaxVUs = req.MaxVUs
+	wireReq.TotalDuration = req.TotalDuration
+	if req.ArchiveSize > 0 {
+		size := req.ArchiveSize
+		wireReq.ArchiveSize = &size
+	}
+
+	buf, err := json.Marshal(wireReq)
+	if err != nil {
+		return nil, err
+	}
+
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(buf))
+	if err != nil {
+		return nil, err
+	}
+	httpReq.Header.Set("Content-Type", "application/json")
+	if c.stackID != 0 {
+		httpReq.Header.Set("X-Stack-Id", strconv.FormatInt(c.stackID, 10))
+	}
+
+	var key [8]byte
+	if _, err := rand.Read(key[:]); err != nil {
+		return nil, err
+	}
+	httpReq.Header.Set("K6-Idempotency-Key", hex.EncodeToString(key[:]))
+
+	httpClient := NewHTTPClient(c.httpClient, c.token, c.version, c.logger)
+	var resp StartLocalExecutionResponse
+	if err := httpClient.Do(httpReq, &resp); err != nil {
+		return nil, err
+	}
+	return &resp, nil
+}
+
+// UploadArchive uploads the tar archive to the presigned S3 URL.
+func (c *Client) UploadArchive(ctx context.Context, uploadURL string, data []byte) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPut, uploadURL, bytes.NewReader(data))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/x-tar")
+	req.ContentLength = int64(len(data))
+
+	uploader := NewHTTPClient(c.httpClient, "", "", c.logger)
+	return uploader.Do(req, nil)
+}
+
+// WaitForTestRunReady polls GET /cloud/v6/test_runs/{id} until the run reports initializing.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	var lastStatus v6.Status
+	for {
+		progress, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			return err
+		}
+
+		switch progress.Status {
+		case v6.StatusInitializing:
+			return nil
+		case v6.StatusAborted:
+			for _, event := range progress.StatusHistory {
+				if event.Status == v6.StatusAborted && event.Message != "" {
+					return fmt.Errorf("test run aborted: %s", event.Message)
+				}
+			}
+			return errors.New("test run aborted before starting")
+		case v6.StatusCompleted:
+			return errors.New("test run completed before starting")
+		default:
+			if progress.Status != lastStatus {
+				lastStatus = progress.Status
+				c.logger.WithField("status", progress.FormatStatus()).Info("Waiting for test run to start...")
+			}
+		}
+
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(pollInterval):
+		}
+	}
+}
+
+// NotifyTestRunCompleted posts script execution completion status to the provisioning API.
+func (c *Client) NotifyTestRunCompleted(
+	ctx context.Context,
+	testRunID int64,
+	testRunToken string,
+	testErr error,
+) error {
+	endpoint := fmt.Sprintf("%s/provisioning/v1/test_runs/%d/notify", c.host, testRunID)
+
+	var payload struct {
+		EventType string       `json:"event_type"`
+		Error     *notifyError `json:"error"`
+	}
+	payload.EventType = "script_execution_completed"
+	payload.Error = mapTestErrorToNotifyCode(testErr)
+
+	buf, err := json.Marshal(payload)
+	if err != nil {
+		return err
+	}
+
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(buf))
+	if err != nil {
+		return err
+	}
+	httpReq.Header.Set("Content-Type", "application/json")
+
+	httpClient := NewHTTPClient(c.httpClient, testRunToken, c.version, c.logger)
+	return httpClient.Do(httpReq, nil)
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..a1e6b3a97
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,80 @@
+package provisioning
+
+import (
+	"fmt"
+	"net/http"
+	"strconv"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client handles communication with the provisioning API and orchestrates local execution.
+type Client struct {
+	logger     logrus.FieldLogger
+	token      string
+	host       string
+	version    string
+	stackID    int64
+	timeout    time.Duration
+	apiClient  *k6cloud.APIClient
+	v6Client   *v6.Client
+	httpClient *http.Client
+}
+
+// NewClient returns a new Client for the provisioning API.
+func NewClient(
+	logger logrus.FieldLogger,
+	token, host, version string,
+	stackID int64,
+	timeout time.Duration,
+) (*Client, error) {
+	if token == "" {
+		return nil, fmt.Errorf("token is required to create cloud API client")
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Global k6 Cloud API.",
+		},
+	}
+	httpClient := &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+	cfg.HTTPClient = httpClient
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+	if stackID != 0 {
+		cfg.AddDefaultHeader("X-Stack-Id", strconv.FormatInt(stackID, 10))
+	}
+
+	v6c, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if stackID != 0 {
+		if err := v6c.SetStackID(stackID); err != nil {
+			return nil, err
+		}
+	}
+
+	return &Client{
+		logger:     logger,
+		token:      token,
+		host:       host,
+		version:    version,
+		stackID:    stackID,
+		timeout:    timeout,
+		apiClient:  k6cloud.NewAPIClient(cfg),
+		v6Client:   v6c,
+		httpClient: httpClient,
+	}, nil
+}
