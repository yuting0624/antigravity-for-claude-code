--- /dev/null
+++ b/internal/cloudapi/provisioning/provision.go
@@ -0,0 +1,63 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"time"
+)
+
+// ProvisionLocalExecution composes create-or-find, start, optional upload and wait-until-ready.
+func (c *Client) ProvisionLocalExecution(ctx context.Context, params ProvisionParams) (*ProvisionResult, error) {
+	loadTestID, err := c.v6Client.CreateOrFindLoadTest(ctx, params.ProjectID, params.Name)
+	if err != nil {
+		return nil, fmt.Errorf("create or find load test: %w", err)
+	}
+
+	var archiveBytes []byte
+	var archiveSize int64
+	if params.Archive != nil {
+		var buf bytes.Buffer
+		if err := params.Archive.Write(&buf); err != nil {
+			return nil, fmt.Errorf("write archive: %w", err)
+		}
+		archiveBytes = buf.Bytes()
+		archiveSize = int64(len(archiveBytes))
+	}
+
+	sleReq := StartLocalExecutionRequest{
+		Options:       params.Options,
+		MaxVUs:        params.MaxVUs,
+		TotalDuration: params.TotalDuration,
+		ArchiveSize:   archiveSize,
+	}
+
+	sleResp, err := c.StartLocalExecution(ctx, loadTestID, sleReq)
+	if err != nil {
+		return nil, fmt.Errorf("start local execution: %w", err)
+	}
+
+	if params.Archive != nil {
+		if sleResp.ArchiveUploadURL != nil && *sleResp.ArchiveUploadURL != "" {
+			if err := c.UploadArchive(ctx, *sleResp.ArchiveUploadURL, archiveBytes); err != nil {
+				return nil, fmt.Errorf("upload archive: %w", err)
+			}
+		} else {
+			c.logger.Warn("archive provided but no upload URL returned by API")
+		}
+	}
+
+	pollInterval := params.PollInterval
+	if pollInterval == 0 {
+		pollInterval = 500 * time.Millisecond
+	}
+	if err := c.WaitForTestRunReady(ctx, sleResp.TestRunID, pollInterval); err != nil {
+		return nil, fmt.Errorf("wait for test run ready: %w", err)
+	}
+
+	return &ProvisionResult{
+		TestRunID:             sleResp.TestRunID,
+		TestRunDetailsPageURL: sleResp.TestRunDetailsPageURL,
+		RuntimeConfig:         sleResp.RuntimeConfig,
+	}, nil
+}
diff --git a/internal/cloudapi/provisioning/test/server.go b/internal/cloudapi/provisioning/test/server.go
new file mode 100644
index 000000000..fa290b7e7
--- /dev/null
+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,183 @@
+package test
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	DefaultLoadTestID   int64  = 456
+	DefaultTestRunID    int64  = 123
+	PresignedUploadPath string = "/s3/upload/archive.tar"
+)
+
+// Server is a test HTTP server for the provisioning API.
+type Server struct {
+	*httptest.Server
+	Mux                *http.ServeMux
+	fetchHitCount      atomic.Int32
+	mu                 sync.RWMutex
+	customHandlers     map[string]http.HandlerFunc
+	fetchProgressSteps []v6.TestProgress
+	fetchProgressIdx   int
+}
+
+// NewServer creates a new test server.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+
+	s := &Server{
+		Mux:            http.NewServeMux(),
+		customHandlers: make(map[string]http.HandlerFunc),
+	}
+
+	srv := httptest.NewServer(http.HandlerFunc(s.dispatch))
+	s.Server = srv
+	t.Cleanup(srv.Close)
+	return s
+}
+
+func (s *Server) dispatch(w http.ResponseWriter, r *http.Request) {
+	s.mu.RLock()
+	methodKey := r.Method + " " + r.URL.Path
+	handler, ok := s.customHandlers[methodKey]
+	if !ok {
+		handler, ok = s.customHandlers[r.URL.Path]
+	}
+	s.mu.RUnlock()
+
+	if ok {
+		handler(w, r)
+		return
+	}
+
+	if s.Mux != nil {
+		s.Mux.ServeHTTP(w, r)
+		return
+	}
+
+	http.NotFound(w, r)
+}
+
+// PresignedUploadURL returns the full URL for presigned upload.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// HandleStartLocalExecution registers a handler for start_local_execution.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, fn http.HandlerFunc) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	path := fmt.Sprintf("/provisioning/v1/load_tests/%d/start_local_execution", loadTestID)
+	s.customHandlers[path] = fn
+}
+
+// HandlePresignedUpload registers a handler for presigned uploads.
+func (s *Server) HandlePresignedUpload(path string, fn http.HandlerFunc) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.customHandlers[path] = fn
+}
+
+// HandleCreateLoadTest registers a handler for create/list load tests.
+func (s *Server) HandleCreateLoadTest(projectID int64, fn http.HandlerFunc) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	path := fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID)
+	s.customHandlers[path] = fn
+}
+
+// HandleNotify registers a handler for test run notify.
+func (s *Server) HandleNotify(testRunID int64, fn http.HandlerFunc) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	path := fmt.Sprintf("/provisioning/v1/test_runs/%d/notify", testRunID)
+	s.customHandlers[path] = fn
+}
+
+// HandleFetchTestRun registers mock progress for test run fetching.
+func (s *Server) HandleFetchTestRun(testRunID int64, progress []v6.TestProgress) {
+	s.mu.Lock()
+	s.fetchProgressSteps = progress
+	s.fetchProgressIdx = 0
+	path := fmt.Sprintf("/cloud/v6/test_runs/%d", testRunID)
+	s.customHandlers[path] = func(w http.ResponseWriter, r *http.Request) {
+		s.fetchHitCount.Add(1)
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		var tp v6.TestProgress
+		if len(s.fetchProgressSteps) > 0 {
+			if s.fetchProgressIdx < len(s.fetchProgressSteps) {
+				tp = s.fetchProgressSteps[s.fetchProgressIdx]
+				s.fetchProgressIdx++
+			} else {
+				tp = s.fetchProgressSteps[len(s.fetchProgressSteps)-1]
+			}
+		}
+
+		res := k6cloud.NewTestRunApiModelWithDefaults()
+		res.SetStatus(tp.Status.String())
+		res.SetResult(tp.Result.String())
+		res.SetEstimatedDuration(tp.EstimatedDuration)
+		res.SetExecutionDuration(tp.ExecutionDuration)
+		res.SetStatusHistory(v6.ToStatusModel(tp.StatusHistory))
+		res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+		res.SetResultDetails(k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(k6cloud.NewResultDetailsApiModel("")))
+		res.SetOptions(map[string]any{})
+
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusOK)
+		_ = json.NewEncoder(w).Encode(res)
+	}
+	s.mu.Unlock()
+}
+
+// FetchTestRunHitCount returns the number of times test run was fetched.
+func (s *Server) FetchTestRunHitCount() int32 {
