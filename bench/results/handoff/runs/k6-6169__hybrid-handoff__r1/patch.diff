index 000000000..f8e5c65e6
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,44 @@
+package provisioning
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+// ResponseError represents an HTTP error response from the provisioning API.
+type ResponseError struct {
+	StatusCode int
+	Body       string
+}
+
+func (e *ResponseError) Error() string {
+	return fmt.Sprintf("unexpected HTTP error %d: %s", e.StatusCode, e.Body)
+}
+
+// Unwrap classifies 401/403 HTTP errors using httperr.
+func (e *ResponseError) Unwrap() error {
+	return httperr.ClassifyStatus(e.StatusCode)
+}
+
+// CheckResponse inspects an HTTP response and returns nil for 2xx or a ResponseError.
+func CheckResponse(r *http.Response) error {
+	if r == nil {
+		return errors.New("nil response")
+	}
+	if r.StatusCode >= 200 && r.StatusCode <= 299 {
+		return nil
+	}
+	var body string
+	if r.Body != nil {
+		data, _ := io.ReadAll(r.Body)
+		body = string(data)
+	}
+	return &ResponseError{
+		StatusCode: r.StatusCode,
+		Body:       body,
+	}
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..efec9a1ea
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,98 @@
+package provisioning
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient is an HTTP client for provisioning endpoints.
+type HTTPClient struct {
+	client  *http.Client
+	token   string
+	version string
+	logger  logrus.FieldLogger
+}
+
+// NewHTTPClient creates a new HTTPClient.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	if client == nil {
+		client = http.DefaultClient
+	}
+	return &HTTPClient{
+		client:  client,
+		token:   token,
+		version: version,
+		logger:  logger,
+	}
+}
+
+// Do executes an HTTP request, retrying on 5xx and decoding the response JSON into v.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	var bodyBytes []byte
+	if req.Body != nil {
+		var err error
+		bodyBytes, err = io.ReadAll(req.Body)
+		if err != nil {
+			return err
+		}
+		_ = req.Body.Close()
+	}
+
+	var lastErr error
+	for attempt := 0; attempt <= clientcfg.MaxRetries; attempt++ {
+		if attempt > 0 {
+			select {
+			case <-req.Context().Done():
+				return req.Context().Err()
+			case <-time.After(clientcfg.RetryInterval):
+			}
+		}
+
+		reqClone := req.Clone(req.Context())
+		if bodyBytes != nil {
+			reqClone.Body = io.NopCloser(bytes.NewReader(bodyBytes))
+		}
+		if c.token != "" {
+			reqClone.Header.Set("Authorization", "Bearer "+c.token)
+		}
+		if c.version != "" {
+			reqClone.Header.Set("User-Agent", "k6cloud/"+c.version)
+		}
+
+		resp, err := c.client.Do(reqClone)
+		if err != nil {
+			if req.Context().Err() != nil {
+				return req.Context().Err()
+			}
+			lastErr = err
+			continue
+		}
+
+		if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+			defer resp.Body.Close()
+			if v != nil {
+				if err := json.NewDecoder(resp.Body).Decode(v); err != nil {
+					return err
+				}
+			}
+			return nil
+		}
+
+		respErr := CheckResponse(resp)
+		_ = resp.Body.Close()
+
+		if resp.StatusCode >= 400 && resp.StatusCode < 500 {
+			return respErr
+		}
+
+		lastErr = respErr
+	}
+
+	return lastErr
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..ed92019dd
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,48 @@
+package provisioning
+
+import (
+	"errors"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+type notifyError struct {
+	Code   int32  `json:"code"`
+	Reason string `json:"reason"`
+}
+
+func mapTestErrorToNotifyCode(err error) *notifyError {
+	if err == nil {
+		return nil
+	}
+
+	var arerr errext.HasAbortReason
+	if errors.As(err, &arerr) {
+		reason := arerr.AbortReason()
+		if reason == errext.AbortedByThresholdsAfterTestEnd {
+			return nil
+		}
+
+		var code int32
+		switch reason {
+		case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+			code = 8036
+		case errext.AbortedByScriptError:
+			code = 8035
+		case errext.AbortedByOutput, errext.AbortedByTimeout:
+			code = 8034
+		default:
+			code = 0
+		}
+
+		return &notifyError{
+			Code:   code,
+			Reason: err.Error(),
+		}
+	}
+
+	return &notifyError{
+		Code:   0,
+		Reason: err.Error(),
+	}
+}
