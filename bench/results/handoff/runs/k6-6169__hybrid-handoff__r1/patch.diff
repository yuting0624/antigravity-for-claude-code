+		if err != nil {
+			logger.WithField("field", "push_interval").WithError(err).Warn("failed to parse push_interval")
+		} else {
+			cfg.MetricPushInterval = types.NewNullDuration(d, true)
+		}
+	}
+
+	if rc.Metrics.PushConcurrency != nil {
+		cfg.MetricPushConcurrency = null.IntFrom(int64(*rc.Metrics.PushConcurrency))
+	}
+
+	if rc.Metrics.AggregationPeriod != nil {
+		d, err := time.ParseDuration(*rc.Metrics.AggregationPeriod)
+		if err != nil {
+			logger.WithField("field", "aggregation_period").WithError(err).Warn("failed to parse aggregation_period")
+		} else {
+			cfg.AggregationPeriod = types.NewNullDuration(d, true)
+		}
+	}
+
+	if rc.Metrics.AggregationWaitPeriod != nil {
+		d, err := time.ParseDuration(*rc.Metrics.AggregationWaitPeriod)
+		if err != nil {
+			logger.WithField("field", "aggregation_wait_period").WithError(err).Warn("failed to parse aggregation_wait_period")
+		} else {
+			cfg.AggregationWaitPeriod = types.NewNullDuration(d, true)
+		}
+	}
+
+	if rc.Metrics.MaxSamplesPerPackage != nil {
+		cfg.MaxTimeSeriesInBatch = null.IntFrom(int64(*rc.Metrics.MaxSamplesPerPackage))
+	}
+
+	return cfg
+}
