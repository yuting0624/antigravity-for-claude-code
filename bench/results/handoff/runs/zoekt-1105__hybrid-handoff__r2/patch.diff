+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/sourcegraph/zoekt/index"
+)
+
+type repositoryRecord struct {
+	Name   string
+	Source string
+	Shards []string
+}
+
+func readInventory(indexDir string) ([]string, error) {
+	entries, err := os.ReadDir(indexDir)
+	if os.IsNotExist(err) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var shards []string
+	for _, entry := range entries {
+		if entry.IsDir() {
+			continue
+		}
+		if strings.HasSuffix(entry.Name(), ".zoekt") {
+			shards = append(shards, filepath.Join(indexDir, entry.Name()))
+		}
+	}
+	sort.Strings(shards)
+	return shards, nil
+}
+
+func recordsFromShards(shards []string) []repositoryRecord {
+	recordsMap := make(map[string]*repositoryRecord)
+	for _, shard := range shards {
+		repos, _, err := index.ReadMetadataPath(shard)
+		if err != nil {
+			continue
+		}
+		for _, repo := range repos {
+			rec, exists := recordsMap[repo.Name]
+			if !exists {
+				rec = &repositoryRecord{
+					Name:   repo.Name,
+					Source: repo.Source,
+				}
+				recordsMap[repo.Name] = rec
+			}
+			rec.Shards = append(rec.Shards, shard)
+		}
+	}
+	var records []repositoryRecord
+	for _, rec := range recordsMap {
+		sort.Strings(rec.Shards)
+		records = append(records, *rec)
+	}
+	sort.Slice(records, func(i, j int) bool {
+		return records[i].Name < records[j].Name
+	})
+	return records
+}
+
+func removeShard(shard string) error {
+	if err := os.Remove(shard); err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	if err := os.Remove(shard + ".meta"); err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	return nil
+}
diff --git a/cmd/zoekt-local-sync/lock.go b/cmd/zoekt-local-sync/lock.go
