+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+type repository struct {
+	Name string
+	Path string
+}
+
+func isGitRepository(dir string) bool {
+	// Normal git repo or worktree/submodule (.git can be a directory or file)
+	if _, err := os.Stat(filepath.Join(dir, ".git")); err == nil {
+		return true
+	}
+	// Bare repository: directory ending in .git containing an objects directory
+	if strings.HasSuffix(dir, ".git") && filepath.Base(dir) != ".git" {
+		if fi, err := os.Stat(filepath.Join(dir, "objects")); err == nil && fi.IsDir() {
+			return true
+		}
+	}
+	return false
+}
+
+func repoNameFromRel(rel string) string {
+	rel = filepath.ToSlash(rel)
+	rel = strings.TrimPrefix(rel, "./")
+	return strings.TrimSuffix(rel, ".git")
+}
+
+func discoverRepositories(roots []string) ([]repository, error) {
+	var all []repository
+	seen := make(map[string]string) // name -> path
+
+	for _, rawRoot := range roots {
+		root, err := filepath.Abs(rawRoot)
+		if err != nil {
+			return nil, err
+		}
+		root = filepath.Clean(root)
+
+		fi, err := os.Stat(root)
+		if err != nil {
+			return nil, err
+		}
+		if !fi.IsDir() {
+			return nil, fmt.Errorf("%s is not a directory", root)
+		}
+
+		// A root that is itself a repository counts
+		if isGitRepository(root) {
+			name := strings.TrimSuffix(filepath.Base(root), ".git")
+			if prev, ok := seen[name]; ok {
+				return nil, fmt.Errorf("duplicate repository name %q (%s and %s)", name, prev, root)
+			}
+			seen[name] = root
+			all = append(all, repository{
+				Name: name,
+				Path: root,
+			})
+			continue
+		}
+
+		// Discover git repositories beneath root
+		var foundInRoot []repository
+		err = filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			if path == root {
+				return nil
+			}
+			if !d.IsDir() {
+				return nil
+			}
+			if d.Name() == ".git" {
+				return filepath.SkipDir
+			}
+			if isGitRepository(path) {
+				rel, err := filepath.Rel(root, path)
+				if err != nil {
+					return err
+				}
+				name := repoNameFromRel(rel)
+				foundInRoot = append(foundInRoot, repository{
+					Name: name,
+					Path: path,
+				})
+				return filepath.SkipDir
+			}
+			return nil
+		})
+		if err != nil {
+			return nil, err
+		}
+
+		for _, repo := range foundInRoot {
+			if prev, ok := seen[repo.Name]; ok {
+				return nil, fmt.Errorf("duplicate repository name %q (%s and %s)", repo.Name, prev, repo.Path)
+			}
+			seen[repo.Name] = repo.Path
+			all = append(all, repo)
+		}
+	}
+
+	sort.Slice(all, func(i, j int) bool {
+		return all[i].Name < all[j].Name
+	})
+
+	return all, nil
+}
