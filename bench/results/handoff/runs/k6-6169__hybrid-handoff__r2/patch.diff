+// CreateOrFindLoadTest creates a new load test in the given project without a script.
+// If a load test with the same name already exists (HTTP 409 Conflict),
+// it finds the existing load test by name and returns its ID.
+func (c *Client) CreateOrFindLoadTest(
+	ctx context.Context, projectID int64, name string,
+) (int64, error) {
+	res, hr, err := c.apiClient.LoadTestsAPI.
+		ProjectsLoadTestsCreate(c.authCtx(ctx), projectID).
+		XStackId(c.stackID).
+		Name(name).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if err := CheckResponse(hr, err); err != nil {
+		var rerr ResponseError
+		if errors.As(err, &rerr) && rerr.Response != nil && rerr.Response.StatusCode == http.StatusConflict {
+			lt, findErr := c.findTestByName(ctx, projectID, name)
+			if findErr != nil {
+				return 0, findErr
+			}
+			return lt.GetId(), nil
+		}
+		return 0, err
+	}
+
+	if res == nil {
+		return 0, errUnknown
+	}
+
+	return res.GetId(), nil
+}
+
