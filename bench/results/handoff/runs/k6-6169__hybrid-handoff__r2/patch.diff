+package provisioning
+
+import (
+	"encoding/json"
+	"time"
+
+	"go.k6.io/k6/v2/lib"
+)
+
+// MetricsConfig contains metrics tuning parameters returned by the provisioning service.
+type MetricsConfig struct {
+	PushURL               string  `json:"push_url"`
+	PushInterval          *string `json:"push_interval,omitempty"`
+	PushConcurrency       *int32  `json:"push_concurrency,omitempty"`
+	AggregationPeriod     *string `json:"aggregation_period,omitempty"`
+	AggregationWaitPeriod *string `json:"aggregation_wait_period,omitempty"`
+	AggregationMinSamples *int32  `json:"aggregation_min_samples,omitempty"`
+	MaxSamplesPerPackage  *int32  `json:"max_samples_per_package,omitempty"`
+}
+
+// SecretsConfig contains secrets endpoints configuration.
+type SecretsConfig struct {
+	Endpoint     string `json:"endpoint"`
+	ResponsePath string `json:"response_path"`
+}
+
+// RuntimeConfig contains runtime overrides and configuration for a test run.
+type RuntimeConfig struct {
+	Metrics      MetricsConfig `json:"metrics"`
+	TestRunToken string        `json:"test_run_token"`
+	Secrets      SecretsConfig `json:"secrets"`
+}
+
+// StartLocalExecutionRequest is the request payload to start local execution.
+type StartLocalExecutionRequest struct {
+	Options       json.RawMessage `json:"options"`
+	MaxVUs        int64           `json:"max_vus"`
+	TotalDuration int64           `json:"total_duration"`
+	ArchiveSize   int64           `json:"archive_size"`
+}
+
+// MarshalJSON ensures archive_size is explicit null when <= 0.
+func (r StartLocalExecutionRequest) MarshalJSON() ([]byte, error) {
+	type Alias StartLocalExecutionRequest
+	var archiveSize *int64
+	if r.ArchiveSize > 0 {
+		archiveSize = &r.ArchiveSize
+	}
+	return json.Marshal(&struct {
+		Alias
+		ArchiveSize *int64 `json:"archive_size"`
+	}{
+		Alias:       Alias(r),
+		ArchiveSize: archiveSize,
+	})
+}
+
+// StartLocalExecutionResponse is the response from the provisioning service.
+type StartLocalExecutionResponse struct {
+	TestRunID             int64         `json:"test_run_id"`
+	ArchiveUploadURL      *string       `json:"archive_upload_url"`
+	TestRunDetailsPageURL string        `json:"test_run_details_page_url"`
+	RuntimeConfig         RuntimeConfig `json:"runtime_config"`
+}
+
+// ProvisionParams configures ProvisionLocalExecution.
+type ProvisionParams struct {
+	Name          string
+	ProjectID     int64
+	MaxVUs        int64
+	TotalDuration int64
+	Options       json.RawMessage
+	Archive       *lib.Archive
+	PollInterval  time.Duration
+}
+
+// ProvisionResult contains the result of ProvisionLocalExecution.
+type ProvisionResult struct {
+	TestRunID             int64
+	TestRunDetailsPageURL string
+	RuntimeConfig         RuntimeConfig
+}
