diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..4d272284a
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,136 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strconv"
+	"time"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// StartLocalExecution starts a local execution test run via the provisioning API.
+func (c *Client) StartLocalExecution(
+	ctx context.Context,
+	loadTestID int64,
+	req StartLocalExecutionRequest,
+) (*StartLocalExecutionResponse, error) {
+	url := fmt.Sprintf("%s/provisioning/v1/load_tests/%d/start_local_execution", c.host, loadTestID)
+
+	var key [8]byte
+	if _, err := rand.Read(key[:]); err != nil {
+		return nil, err
+	}
+	idempKey := hex.EncodeToString(key[:])
+
+	bodyBytes, err := json.Marshal(req)
+	if err != nil {
+		return nil, err
+	}
+
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(bodyBytes))
+	if err != nil {
+		return nil, err
+	}
+
+	httpReq.Header.Set("Content-Type", "application/json")
+	httpReq.Header.Set("K6-Idempotency-Key", idempKey)
+	if c.stackID != 0 {
+		httpReq.Header.Set("X-Stack-Id", strconv.FormatInt(c.stackID, 10))
+	}
+
+	var res StartLocalExecutionResponse
+	if err := c.httpClient.Do(httpReq, &res); err != nil {
+		return nil, err
+	}
+
+	return &res, nil
+}
+
+// UploadArchive uploads the tar archive to the presigned S3 URL without authorization header.
+func (c *Client) UploadArchive(ctx context.Context, presignedURL string, archiveBytes []byte) error {
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPut, presignedURL, bytes.NewReader(archiveBytes))
+	if err != nil {
+		return err
+	}
+
+	httpReq.Header.Set("Content-Type", "application/x-tar")
+	httpReq.ContentLength = int64(len(archiveBytes))
+
+	unauthClient := NewHTTPClient(c.httpClient.client, "", c.version, c.logger)
+	return unauthClient.Do(httpReq, nil)
+}
+
+// WaitForTestRunReady polls the v6 test run until it transitions to initializing status.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	var lastStatus v6.Status
+	for {
+		tp, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			return err
+		}
+
+		switch tp.Status {
+		case v6.StatusInitializing:
+			return nil
+		case v6.StatusAborted:
+			if len(tp.StatusHistory) > 0 {
+				for i := len(tp.StatusHistory) - 1; i >= 0; i-- {
+					if tp.StatusHistory[i].Status == v6.StatusAborted && tp.StatusHistory[i].Message != "" {
+						return fmt.Errorf("test run aborted before starting: %s", tp.StatusHistory[i].Message)
+					}
+				}
+			}
+			return errors.New("test run aborted before starting")
+		case v6.StatusCompleted:
+			return fmt.Errorf("test run unexpected status: %s", tp.Status)
+		default:
+			if tp.Status != lastStatus {
+				lastStatus = tp.Status
+				c.logger.WithField("status", tp.FormatStatus()).Info("Test run status updated")
+			}
+		}
+
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(pollInterval):
+		}
+	}
+}
+
+// NotifyTestRunCompleted posts the completion event and mapped error to the provisioning notify endpoint.
+func (c *Client) NotifyTestRunCompleted(ctx context.Context, testRunID int64, token string, testErr error) error {
+	url := fmt.Sprintf("%s/provisioning/v1/test_runs/%d/notify", c.host, testRunID)
+
+	type notifyPayload struct {
+		EventType string       `json:"event_type"`
+		Error     *notifyError `json:"error"`
+	}
+
+	payload := notifyPayload{
+		EventType: "script_execution_completed",
+		Error:     mapTestErrorToNotifyCode(testErr),
+	}
+
+	bodyBytes, err := json.Marshal(payload)
+	if err != nil {
+		return err
+	}
+
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(bodyBytes))
+	if err != nil {
+		return err
+	}
+
+	httpReq.Header.Set("Content-Type", "application/json")
+	httpReq.Header.Set("Authorization", "Bearer "+token)
+
+	return c.httpClient.Do(httpReq, nil)
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..583b8c8d0
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,79 @@
+package provisioning
+
+import (
+	"fmt"
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client handles communication with the provisioning API and wraps v6 operations.
+type Client struct {
+	logger     logrus.FieldLogger
+	token      string
+	host       string
+	version    string
+	stackID    int64
+	apiClient  *k6cloud.APIClient
+	v6Client   *v6.Client
+	httpClient *HTTPClient
+}
+
+// NewClient returns a new provisioning client.
+func NewClient(
+	logger logrus.FieldLogger,
+	token, host, version string,
+	stackID int64,
+	timeout time.Duration,
+) (*Client, error) {
+	if token == "" {
+		return nil, fmt.Errorf("token is required to create provisioning client")
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Global k6 Cloud API.",
+		},
+	}
+	cfg.HTTPClient = &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+
+	apiClient := k6cloud.NewAPIClient(cfg)
+
+	v6Client, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if err := v6Client.SetStackID(stackID); err != nil {
+		return nil, err
+	}
+
+	httpClient := NewHTTPClient(cfg.HTTPClient, token, version, logger)
+
+	return &Client{
+		logger:     logger,
+		token:      token,
+		host:       host,
+		version:    version,
+		stackID:    stackID,
+		apiClient:  apiClient,
+		v6Client:   v6Client,
+		httpClient: httpClient,
+	}, nil
+}
+
+// SetV6Client sets a custom v6 client on the Client.
+func (c *Client) SetV6Client(v6Client *v6.Client) {
+	c.v6Client = v6Client
+}
