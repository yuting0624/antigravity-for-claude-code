index 000000000..fb6c2611c
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,52 @@
+package provisioning
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+// ResponseError represents an HTTP error response from the provisioning API.
+type ResponseError struct {
+	StatusCode int
+	Body       string
+}
+
+func (e *ResponseError) Error() string {
+	if e.Body == "" {
+		return fmt.Sprintf("HTTP %d", e.StatusCode)
+	}
+	return fmt.Sprintf("HTTP %d: %s", e.StatusCode, e.Body)
+}
+
+// Unwrap classifies the HTTP status code (e.g. 401 -> ErrUnauthorized, 403 -> ErrForbidden).
+func (e *ResponseError) Unwrap() error {
+	return httperr.ClassifyStatus(e.StatusCode)
+}
+
+// CheckResponse inspects the HTTP response status. If it indicates an error,
+// it returns a *ResponseError with the status code and body.
+func CheckResponse(r *http.Response) error {
+	if r == nil {
+		return errors.New("nil response")
+	}
+	if r.StatusCode >= 200 && r.StatusCode <= 299 {
+		return nil
+	}
+	var body string
+	if r.Body != nil {
+		data, err := io.ReadAll(r.Body)
+		if err == nil {
+			body = string(data)
+			r.Body = io.NopCloser(strings.NewReader(body))
+		}
+	}
+	return &ResponseError{
+		StatusCode: r.StatusCode,
+		Body:       body,
+	}
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..e42b42ee3
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,106 @@
+package provisioning
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient wraps http.Client with authentication, user-agent, retry logic, and JSON decoding.
+type HTTPClient struct {
+	client  *http.Client
+	token   string
+	version string
+	logger  logrus.FieldLogger
+}
+
+// NewHTTPClient returns a new HTTPClient.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	if client == nil {
+		client = http.DefaultClient
+	}
+	return &HTTPClient{
+		client:  client,
+		token:   token,
+		version: version,
+		logger:  logger,
+	}
+}
+
+// Do executes an HTTP request with retries on 5xx and network errors.
+// On success (2xx), if v is non-nil, the response body is decoded into v.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	var bodyBytes []byte
+	if req.Body != nil {
+		var err error
+		bodyBytes, err = io.ReadAll(req.Body)
+		if err != nil {
+			return err
+		}
+		_ = req.Body.Close()
+	}
+
+	if c.token != "" && req.Header.Get("Authorization") == "" {
+		req.Header.Set("Authorization", "Bearer "+c.token)
+	}
+	if req.Header.Get("User-Agent") == "" {
+		req.Header.Set("User-Agent", "k6cloud/"+c.version)
+	}
+
+	for attempt := 0; attempt < clientcfg.MaxRetries; attempt++ {
+		if attempt > 0 {
+			select {
+			case <-req.Context().Done():
+				return req.Context().Err()
+			case <-time.After(clientcfg.RetryInterval):
+			}
+		}
+
+		if bodyBytes != nil {
+			req.Body = io.NopCloser(bytes.NewReader(bodyBytes))
+			req.ContentLength = int64(len(bodyBytes))
+		}
+
+		resp, err := c.client.Do(req)
+		if err != nil {
+			if req.Context().Err() != nil {
+				return req.Context().Err()
+			}
+			if attempt < clientcfg.MaxRetries-1 {
+				continue
+			}
+			return err
+		}
+
+		if resp.StatusCode >= 500 && resp.StatusCode <= 599 {
+			if attempt < clientcfg.MaxRetries-1 {
+				_ = resp.Body.Close()
+				continue
+			}
+			defer resp.Body.Close()
+			return CheckResponse(resp)
+		}
+
+		defer resp.Body.Close()
+
+		if err := CheckResponse(resp); err != nil {
+			return err
+		}
+
+		if v != nil {
+			if err := json.NewDecoder(resp.Body).Decode(v); err != nil && !errors.Is(err, io.EOF) {
+				return err
+			}
+		}
+
+		return nil
+	}
+
+	return nil
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..f3a8bb23f
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,47 @@
+package provisioning
+
+import (
+	"errors"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+type notifyError struct {
+	Code   int32  `json:"code"`
+	Reason string `json:"reason"`
+}
+
+func mapTestErrorToNotifyCode(testErr error) *notifyError {
+	if testErr == nil {
+		return nil
+	}
+
+	var hasAbort errext.HasAbortReason
+	if errors.As(testErr, &hasAbort) {
+		reason := hasAbort.AbortReason()
+		switch reason {
+		case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+			return &notifyError{
+				Code:   8036,
+				Reason: testErr.Error(),
+			}
+		case errext.AbortedByScriptError:
+			return &notifyError{
+				Code:   8035,
+				Reason: testErr.Error(),
+			}
+		case errext.AbortedByOutput, errext.AbortedByTimeout:
+			return &notifyError{
+				Code:   8034,
+				Reason: testErr.Error(),
+			}
+		case errext.AbortedByThresholdsAfterTestEnd:
+			return nil
+		}
+	}
+
+	return &notifyError{
+		Code:   0,
+		Reason: testErr.Error(),
+	}
+}
diff --git a/internal/cloudapi/provisioning/provision.go b/internal/cloudapi/provisioning/provision.go
new file mode 100644
index 000000000..1143d8613
--- /dev/null
+++ b/internal/cloudapi/provisioning/provision.go
@@ -0,0 +1,68 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"time"
+)
+
+// ProvisionLocalExecution orchestrates the complete setup flow for local execution:
+// 1. Create or find the load test via v6 API.
+// 2. Start local execution via the provisioning API.
+// 3. Upload the archive if present and an upload URL was provided.
+// 4. Wait for the test run to reach initializing state.
+func (c *Client) ProvisionLocalExecution(ctx context.Context, params ProvisionParams) (*ProvisionResult, error) {
+	loadTestID, err := c.v6Client.CreateOrFindLoadTest(ctx, params.ProjectID, params.Name)
+	if err != nil {
+		return nil, fmt.Errorf("create or find load test: %w", err)
+	}
+
+	var archiveSize int64
+	var archiveBytes []byte
+	if params.Archive != nil {
+		var buf bytes.Buffer
+		if err := params.Archive.Write(&buf); err != nil {
+			return nil, err
+		}
+		archiveBytes = buf.Bytes()
+		archiveSize = int64(len(archiveBytes))
+	}
+
+	sleReq := StartLocalExecutionRequest{
+		Options:       params.Options,
+		MaxVUs:        params.MaxVUs,
+		TotalDuration: params.TotalDuration,
+		ArchiveSize:   archiveSize,
+	}
+
+	sleResp, err := c.StartLocalExecution(ctx, loadTestID, sleReq)
+	if err != nil {
+		return nil, fmt.Errorf("start local execution: %w", err)
+	}
+
+	if params.Archive != nil {
+		if sleResp.ArchiveUploadURL != nil && *sleResp.ArchiveUploadURL != "" {
+			if err := c.UploadArchive(ctx, *sleResp.ArchiveUploadURL, archiveBytes); err != nil {
+				return nil, fmt.Errorf("upload archive: %w", err)
+			}
+		} else {
+			c.logger.Warn("Archive provided but no upload URL returned by provisioning API, skipping archive upload")
+		}
+	}
+
+	pollInterval := params.PollInterval
+	if pollInterval <= 0 {
+		pollInterval = 500 * time.Millisecond
+	}
+
+	if err := c.WaitForTestRunReady(ctx, sleResp.TestRunID, pollInterval); err != nil {
+		return nil, fmt.Errorf("wait for test run ready: %w", err)
+	}
+
+	return &ProvisionResult{
+		TestRunID:             sleResp.TestRunID,
+		TestRunDetailsPageURL: sleResp.TestRunDetailsPageURL,
+		RuntimeConfig:         sleResp.RuntimeConfig,
+	}, nil
+}
diff --git a/internal/cloudapi/provisioning/test/server.go b/internal/cloudapi/provisioning/test/server.go
new file mode 100644
index 000000000..3c5548a47
--- /dev/null
+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,138 @@
+package provtest
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	DefaultLoadTestID   int64 = 456
+	DefaultTestRunID    int64 = 123
+	PresignedUploadPath       = "/presigned/upload"
+)
+
+// Server is a fake provisioning server used in tests.
+type Server struct {
+	*httptest.Server
+	Mux              *http.ServeMux
+	fetchTestRunHits atomic.Int32
+}
+
+// NewServer creates a new test server.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+	mux := http.NewServeMux()
+	ts := httptest.NewServer(mux)
+	t.Cleanup(ts.Close)
+	return &Server{
+		Server: ts,
+		Mux:    mux,
+	}
+}
+
+// PresignedUploadURL returns the presigned upload URL for the server.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// FetchTestRunHitCount returns the number of times the fetch test run endpoint was hit.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchTestRunHits.Load()
+}
+
+// HandleCreateLoadTest registers a handler for creating a load test.
+func (s *Server) HandleCreateLoadTest(projectID int64, handler http.HandlerFunc) {
+	path := fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID)
+	s.Mux.HandleFunc(path, handler)
+}
+
+// HandleStartLocalExecution registers a handler for starting local execution.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, handler http.HandlerFunc) {
+	path := fmt.Sprintf("/provisioning/v1/load_tests/%d/start_local_execution", loadTestID)
+	s.Mux.HandleFunc(path, handler)
+}
+
+// HandlePresignedUpload registers a handler for presigned archive upload.
+func (s *Server) HandlePresignedUpload(path string, handler http.HandlerFunc) {
+	s.Mux.HandleFunc(path, handler)
+}
+
+// HandleFetchTestRun registers a handler that returns test run progress.
+func (s *Server) HandleFetchTestRun(testRunID int64, progress []v6.TestProgress) {
+	var idx atomic.Int32
+	path := fmt.Sprintf("/cloud/v6/test_runs/%d", testRunID)
+	s.Mux.HandleFunc(path, func(w http.ResponseWriter, r *http.Request) {
+		s.fetchTestRunHits.Add(1)
+		cur := int(idx.Add(1) - 1)
+		if cur >= len(progress) {
+			cur = len(progress) - 1
+		}
+		p := progress[cur]
+
+		resp := k6cloud.NewTestRunApiModelWithDefaults()
+		resp.SetId(testRunID)
+		resp.SetStatus(p.Status.String())
+		resp.SetResult(p.Result.String())
+		resp.SetEstimatedDuration(p.EstimatedDuration)
+		resp.SetExecutionDuration(p.ExecutionDuration)
+		resp.SetStatusHistory(v6.ToStatusModel(p.StatusHistory))
+		resp.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+		resp.SetResultDetails(k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(k6cloud.NewResultDetailsApiModel("")))
+		resp.SetOptions(map[string]any{})
+
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusOK)
+		_ = json.NewEncoder(w).Encode(resp)
+	})
+}
+
+// HandleNotify registers a handler for test run notification.
+func (s *Server) HandleNotify(testRunID int64, handler http.HandlerFunc) {
+	path := fmt.Sprintf("/provisioning/v1/test_runs/%d/notify", testRunID)
+	s.Mux.HandleFunc(path, handler)
+}
+
+// DefaultStartLocalExecutionResponse creates a default response for start local execution.
+func DefaultStartLocalExecutionResponse() *k6cloud.StartLocalExecutionTestResponse {
+	resp := k6cloud.NewStartLocalExecutionTestResponseWithDefaults()
+	resp.SetTestRunId(DefaultTestRunID)
+	uploadURL := "https://s3.amazonaws.com/k6-archives/test-archive.tar"
+	resp.ArchiveUploadUrl = *k6cloud.NewNullableString(&uploadURL)
+	resp.SetTestRunDetailsPageUrl(fmt.Sprintf("https://app.k6.io/runs/%d", DefaultTestRunID))
+
+	pushInterval := "2s"
+	pushConcurrency := int32(5)
+	aggPeriod := "3s"
+	aggWaitPeriod := "1s"
+	maxSamples := int32(2000)
+
+	metricsConfig := k6cloud.NewMetricsRuntimeConfig(
+		"https://ingest.k6.io/v1/metrics",
+		*k6cloud.NewNullableString(&pushInterval),
+		*k6cloud.NewNullableInt32(&pushConcurrency),
+		*k6cloud.NewNullableString(&aggPeriod),
+		*k6cloud.NewNullableString(&aggWaitPeriod),
+		*k6cloud.NewNullableInt32(nil),
+		*k6cloud.NewNullableInt32(&maxSamples),
+	)
+
+	secretsConfig := k6cloud.NewSecretsRuntimeConfig(
+		"https://api.k6.io/provisioning/v1/test_runs/123/decrypt_secret?name={key}",
+		"plaintext",
