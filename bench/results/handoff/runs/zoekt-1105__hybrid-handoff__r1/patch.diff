+// limitations under the License.
+
+package main
+
+import (
+	"path/filepath"
+	"sort"
+
+	"github.com/sourcegraph/zoekt"
+	"github.com/sourcegraph/zoekt/index"
+)
+
+type shardInventory struct {
+	Path string
+	Repo zoekt.Repository
+}
+
+func readInventory(indexDir string) ([]shardInventory, error) {
+	shardPaths, err := filepath.Glob(filepath.Join(indexDir, "*.zoekt"))
+	if err != nil {
+		return nil, err
+	}
+	sort.Strings(shardPaths)
+
+	var shards []shardInventory
+	for _, p := range shardPaths {
+		repos, _, err := index.ReadMetadataPath(p)
+		if err != nil {
+			return nil, err
+		}
+		for _, r := range repos {
+			shards = append(shards, shardInventory{
+				Path: p,
+				Repo: *r,
+			})
+		}
+	}
+	return shards, nil
+}
+
+func recordsFromShards(shards []shardInventory) []zoekt.Repository {
+	seen := make(map[string]bool)
+	var records []zoekt.Repository
+	for _, s := range shards {
+		if !seen[s.Repo.Name] {
+			seen[s.Repo.Name] = true
+			records = append(records, s.Repo)
+		}
+	}
+	sort.Slice(records, func(i, j int) bool {
+		return records[i].Name < records[j].Name
+	})
+	return records
+}
