+
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+type repository struct {
+	Name string
+	Path string
+}
+
+func isGitRepo(path string) bool {
+	if filepath.Base(path) == ".git" {
+		return false
+	}
+	gitPath := filepath.Join(path, ".git")
+	if _, err := os.Lstat(gitPath); err == nil {
+		return true
+	}
+	objectsPath := filepath.Join(path, "objects")
+	if fi, err := os.Lstat(objectsPath); err == nil && fi.IsDir() {
+		if strings.HasSuffix(path, ".git") {
+			return true
+		}
+		if _, err := os.Lstat(filepath.Join(path, "HEAD")); err == nil {
+			return true
+		}
+	}
+	return false
+}
+
+func discoverRepositories(roots []string) ([]repository, error) {
+	var allRepos []repository
+
+	for _, root := range roots {
+		root = filepath.Clean(root)
+		if isGitRepo(root) {
+			name := strings.TrimSuffix(filepath.Base(root), ".git")
+			allRepos = append(allRepos, repository{
+				Name: name,
+				Path: root,
+			})
+			continue
+		}
+
+		err := filepath.Walk(root, func(path string, info os.FileInfo, err error) error {
+			if err != nil {
+				return err
+			}
+			if path == root {
+				return nil
+			}
+			if !info.IsDir() {
+				return nil
+			}
+			if info.Name() == ".git" {
+				return filepath.SkipDir
+			}
+			if isGitRepo(path) {
+				rel, err := filepath.Rel(root, path)
+				if err != nil {
+					return err
+				}
+				rel = filepath.ToSlash(rel)
+				name := strings.TrimSuffix(rel, ".git")
+				allRepos = append(allRepos, repository{
+					Name: name,
+					Path: path,
+				})
+				return filepath.SkipDir
+			}
+			return nil
+		})
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	seen := make(map[string]string)
+	for _, repo := range allRepos {
+		if prev, ok := seen[repo.Name]; ok {
+			return nil, fmt.Errorf("duplicate repository name %q: %s and %s", repo.Name, prev, repo.Path)
+		}
+		seen[repo.Name] = repo.Path
+	}
+
+	sort.Slice(allRepos, func(i, j int) bool {
+		return allRepos[i].Name < allRepos[j].Name
+	})
+
+	return allRepos, nil
+}
diff --git a/cmd/zoekt-local-sync/inventory.go b/cmd/zoekt-local-sync/inventory.go
