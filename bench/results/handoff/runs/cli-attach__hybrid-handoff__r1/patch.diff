+package attachments
+
+import (
+	"fmt"
+	"net/url"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/yuin/goldmark"
+	"github.com/yuin/goldmark/ast"
+	"github.com/yuin/goldmark/parser"
+	"github.com/yuin/goldmark/text"
+)
+
+type attachmentArg struct {
+	Path            string
+	URL             string
+	Alt             string
+	RendersAsPlayer bool
+}
+
+type attachableMarkdown struct {
+	markdown       string
+	attachmentArgs []attachmentArg
+}
+
+type attachResult struct {
+	Rewritten string
+	ToAppend  []attachmentArg
+}
+
+type replacement struct {
+	start      int
+	end        int
+	text       string
+	assetIndex int
+}
+
+func unescapeMarkdownPath(s string) string {
+	if strings.HasPrefix(s, "<") && strings.HasSuffix(s, ">") {
+		s = s[1 : len(s)-1]
+	}
+	if u, err := url.PathUnescape(s); err == nil {
+		s = u
+	}
+	var buf strings.Builder
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\\' && i+1 < len(s) {
+			buf.WriteByte(s[i+1])
+			i++
+		} else {
+			buf.WriteByte(s[i])
+		}
+	}
+	return buf.String()
+}
+
+func matchAsset(rawDest string, args []attachmentArg) (int, bool) {
+	if strings.HasPrefix(rawDest, "#") || strings.HasPrefix(rawDest, "//") {
+		return -1, false
+	}
+	if idx := strings.Index(rawDest, ":"); idx != -1 {
+		isWinDrive := (idx == 1) && ((rawDest[0] >= 'a' && rawDest[0] <= 'z') || (rawDest[0] >= 'A' && rawDest[0] <= 'Z'))
+		if !isWinDrive {
+			return -1, false
+		}
+	}
+
+	normDest := unescapeMarkdownPath(rawDest)
+
+	for i, arg := range args {
+		if rawDest == arg.Path || normDest == arg.Path {
+			return i, true
+		}
+		if filepath.Clean(normDest) == filepath.Clean(arg.Path) {
+			if strings.TrimSpace(normDest) == normDest || strings.TrimSpace(arg.Path) == arg.Path {
+				return i, true
+			}
+		}
+		absNorm, err1 := filepath.Abs(normDest)
+		absArg, err2 := filepath.Abs(arg.Path)
+		if err1 == nil && err2 == nil && absNorm == absArg {
+			return i, true
+		}
+	}
+	return -1, false
+}
+
+func findLinkDetails(markdown string, n ast.Node) (labelStart, labelEnd, destStart, destEnd, fullEnd int, ok bool) {
+	pos := n.Pos()
+	if n.Kind() == ast.KindImage {
+		if pos >= len(markdown) || markdown[pos] != '!' {
+			return 0, 0, 0, 0, 0, false
+		}
+		pos++
+	}
+	if pos >= len(markdown) || markdown[pos] != '[' {
+		return 0, 0, 0, 0, 0, false
+	}
+	labelStart = pos + 1
+	depth := 1
+	i := pos + 1
+	for i < len(markdown) && depth > 0 {
+		if markdown[i] == '`' {
+			run := 0
+			for i+run < len(markdown) && markdown[i+run] == '`' {
+				run++
+			}
+			j := i + run
+			found := false
+			for j < len(markdown) {
+				if markdown[j] == '`' {
+					closeRun := 0
+					for j+closeRun < len(markdown) && markdown[j+closeRun] == '`' {
+						closeRun++
+					}
+					if closeRun == run {
+						i = j + closeRun
+						found = true
+						break
+					}
+					j += closeRun
+				} else {
+					j++
+				}
+			}
+			if !found {
+				i += run
+			}
+			continue
+		}
+		if markdown[i] == '\\' {
+			i += 2
+			continue
+		}
+		if markdown[i] == '[' {
+			depth++
+			i++
+			continue
+		}
+		if markdown[i] == ']' {
+			depth--
+			if depth == 0 {
+				labelEnd = i
+				break
+			}
+			i++
+			continue
+		}
+		i++
+	}
+	if depth != 0 || labelEnd+1 >= len(markdown) || markdown[labelEnd+1] != '(' {
+		return 0, 0, 0, 0, 0, false
+	}
+	destStart = labelEnd + 2
+	for destStart < len(markdown) && (markdown[destStart] == ' ' || markdown[destStart] == '\t' || markdown[destStart] == '\r' || markdown[destStart] == '\n') {
+		destStart++
+	}
+	if destStart >= len(markdown) {
+		return 0, 0, 0, 0, 0, false
+	}
+	if markdown[destStart] == '<' {
+		destEnd = destStart + 1
+		for destEnd < len(markdown) {
+			if markdown[destEnd] == '\\' {
+				destEnd += 2
+			} else if markdown[destEnd] == '>' {
+				destEnd++
+				break
+			} else if markdown[destEnd] == '\r' || markdown[destEnd] == '\n' {
+				return 0, 0, 0, 0, 0, false
+			} else {
+				destEnd++
+			}
+		}
+	} else {
+		destEnd = destStart
+		pDepth := 0
+		for destEnd < len(markdown) {
+			c := markdown[destEnd]
+			if c == '\\' {
+				destEnd += 2
+			} else if c == '(' {
+				pDepth++
+				destEnd++
+			} else if c == ')' {
+				if pDepth == 0 {
+					break
+				}
+				pDepth--
+				destEnd++
+			} else if c == ' ' || c == '\t' || c == '\r' || c == '\n' {
+				break
+			} else {
+				destEnd++
+			}
+		}
+	}
+
+	j := destEnd
+	for j < len(markdown) {
+		c := markdown[j]
+		if c == '\\' {
+			j += 2
+		} else if c == '"' || c == '\'' {
+			quote := c
+			j++
+			for j < len(markdown) {
+				if markdown[j] == '\\' {
+					j += 2
+				} else if markdown[j] == quote {
+					j++
+					break
+				} else {
+					j++
+				}
+			}
+		} else if c == '(' {
+			j++
+			for j < len(markdown) {
+				if markdown[j] == '\\' {
+					j += 2
+				} else if markdown[j] == ')' {
+					j++
+					break
+				} else {
+					j++
+				}
+			}
+		} else if c == ')' {
+			fullEnd = j + 1
+			break
+		} else {
+			j++
+		}
+	}
+
+	return labelStart, labelEnd, destStart, destEnd, fullEnd, true
+}
+
+func newAttachableMarkdown(markdown string, attachmentArgs []attachmentArg) (*attachableMarkdown, error) {
+	pctx := parser.NewContext()
+	doc := goldmark.New().Parser().Parse(text.NewReader([]byte(markdown)), parser.WithContext(pctx))
+
+	var offending []string
+	seenOffending := make(map[string]bool)
+
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		if n.Kind() == ast.KindImage {
+			img := n.(*ast.Image)
+			if img.Reference != nil {
+				rawDest := string(img.Destination)
+				idx, matched := matchAsset(rawDest, attachmentArgs)
+				if matched && attachmentArgs[idx].RendersAsPlayer {
+					p := attachmentArgs[idx].Path
+					if !seenOffending[p] {
+						seenOffending[p] = true
+						offending = append(offending, p)
+					}
+				}
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+
+	if len(offending) > 0 {
+		return nil, fmt.Errorf("cannot embed a video as a reference-style image: %s", strings.Join(offending, ", "))
+	}
+
+	return &attachableMarkdown{
+		markdown:       markdown,
+		attachmentArgs: attachmentArgs,
+	}, nil
+}
+
+func attachAssetsToMarkdown(v *attachableMarkdown) (*attachResult, error) {
+	markdown := v.markdown
+	args := v.attachmentArgs
+
+	pctx := parser.NewContext()
+	doc := goldmark.New().Parser().Parse(text.NewReader([]byte(markdown)), parser.WithContext(pctx))
+
+	// Pre-pass: collect reference usages
+	usedLabels := make(map[string]bool)
+	usedDestinations := make(map[string]bool)
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		if n.Kind() == ast.KindImage {
+			img := n.(*ast.Image)
+			if img.Reference != nil {
+				usedLabels[strings.ToLower(string(img.Reference.Value))] = true
+				usedDestinations[string(img.Destination)] = true
+			}
+		} else if n.Kind() == ast.KindLink {
+			lnk := n.(*ast.Link)
+			if lnk.Reference != nil {
+				usedLabels[strings.ToLower(string(lnk.Reference.Value))] = true
+				usedDestinations[string(lnk.Destination)] = true
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+
+	var reps []replacement
+
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		if n.Kind() == ast.KindLinkReferenceDefinition {
+			def := n.(*ast.LinkReferenceDefinition)
+			lbl := strings.ToLower(string(def.Label))
+			rawDest := string(def.Destination)
+			if !usedLabels[lbl] && !usedDestinations[rawDest] {
+				return ast.WalkContinue, nil
+			}
+			assetIndex, matched := matchAsset(rawDest, args)
+			if !matched || args[assetIndex].URL == "" {
+				return ast.WalkContinue, nil
+			}
+			// Check if multi-line inside blockquote
+			if def.Parent() != nil && def.Parent().Kind() == ast.KindBlockquote && def.Lines() != nil && def.Lines().Len() > 1 {
+				return ast.WalkContinue, nil
+			}
+			// Find destination span in definition
+			pos := def.Pos()
+			for pos < len(markdown) && markdown[pos] != '[' {
+				pos++
+			}
+			if pos >= len(markdown) {
+				return ast.WalkContinue, nil
+			}
+			// Find closing ']' of label
+			k := pos + 1
+			for k < len(markdown) {
+				if markdown[k] == '\\' {
+					k += 2
+					continue
+				}
+				if markdown[k] == ']' {
+					break
+				}
+				k++
+			}
+			if k >= len(markdown) || k+1 >= len(markdown) || markdown[k+1] != ':' {
+				return ast.WalkContinue, nil
+			}
+			dStart := k + 2
+			for dStart < len(markdown) && (markdown[dStart] == ' ' || markdown[dStart] == '\t') {
+				dStart++
+			}
+			if dStart >= len(markdown) {
+				return ast.WalkContinue, nil
+			}
+			var dEnd int
+			if markdown[dStart] == '<' {
+				dEnd = dStart + 1
+				for dEnd < len(markdown) {
+					if markdown[dEnd] == '\\' {
+						dEnd += 2
+					} else if markdown[dEnd] == '>' {
+						dEnd++
+						break
+					} else if markdown[dEnd] == '\r' || markdown[dEnd] == '\n' {
+						return ast.WalkContinue, nil
+					} else {
+						dEnd++
+					}
+				}
+			} else {
+				dEnd = dStart
+				for dEnd < len(markdown) && markdown[dEnd] != ' ' && markdown[dEnd] != '\t' && markdown[dEnd] != '\r' && markdown[dEnd] != '\n' {
+					dEnd++
+				}
+			}
+			reps = append(reps, replacement{
+				start:      dStart,
+				end:        dEnd,
+				text:       args[assetIndex].URL,
+				assetIndex: assetIndex,
+			})
+			return ast.WalkContinue, nil
+		}
+
+		if n.Kind() == ast.KindImage || n.Kind() == ast.KindLink {
+			// Skip reference style usages
+			if n.Kind() == ast.KindImage && n.(*ast.Image).Reference != nil {
+				return ast.WalkContinue, nil
+			}
+			if n.Kind() == ast.KindLink && n.(*ast.Link).Reference != nil {
+				return ast.WalkContinue, nil
+			}
+
+			ls, le, ds, de, fe, ok := findLinkDetails(markdown, n)
+			if !ok {
+				return ast.WalkContinue, nil
+			}
+			rawDest := markdown[ds:de]
+			assetIndex, matched := matchAsset(rawDest, args)
+			if !matched || args[assetIndex].URL == "" {
+				return ast.WalkContinue, nil
+			}
+			arg := args[assetIndex]
+
+			if n.Kind() == ast.KindImage && arg.RendersAsPlayer {
+				// Video embed
+				isAlone := (n.Parent() != nil && n.Parent().Kind() == ast.KindParagraph && n.Parent().ChildCount() == 1)
+				if isAlone {
+					// Replace whole embed with bare URL
+					reps = append(reps, replacement{
+						start:      n.Pos(),
+						end:        fe,
+						text:       arg.URL,
+						assetIndex: assetIndex,
+					})
+				} else {
+					// Degrades to link
+					// Destination replacement
+					reps = append(reps, replacement{
+						start:      ds,
+						end:        de,
+						text:       arg.URL,
+						assetIndex: assetIndex,
+					})
+					// Alt text if empty
+					if ls == le {
+						fallbackAlt := strings.ReplaceAll(arg.Alt, `\`, `\\`)
+						fallbackAlt = strings.ReplaceAll(fallbackAlt, `[`, `\[`)
+						fallbackAlt = strings.ReplaceAll(fallbackAlt, `]`, `\]`)
+						reps = append(reps, replacement{
+							start:      ls,
+							end:        le,
+							text:       fallbackAlt,
+							assetIndex: assetIndex,
+						})
+					}
+					// Bang handling
+					bangPos := n.Pos()
+					if bangPos > 0 && markdown[bangPos-1] == '!' {
+						if bangPos >= 2 && markdown[bangPos-2] == '\\' {
+							reps = append(reps, replacement{
+								start:      bangPos,
+								end:        bangPos + 1,
+								text:       "",
+								assetIndex: assetIndex,
+							})
+						} else {
+							reps = append(reps, replacement{
+								start:      bangPos - 1,
+								end:        bangPos + 1,
+								text:       "\\!",
+								assetIndex: assetIndex,
+							})
+						}
+					} else {
+						reps = append(reps, replacement{
+							start:      bangPos,
+							end:        bangPos + 1,
+							text:       "",
+							assetIndex: assetIndex,
+						})
+					}
+				}
+			} else {
+				// Normal image or link destination replacement
+				reps = append(reps, replacement{
+					start:      ds,
+					end:        de,
+					text:       arg.URL,
+					assetIndex: assetIndex,
+				})
+			}
+		}
+
+		return ast.WalkContinue, nil
+	})
+
+	// Sort replacements by start ascending, then by end descending (larger intervals first)
+	sort.SliceStable(reps, func(i, j int) bool {
+		if reps[i].start != reps[j].start {
+			return reps[i].start < reps[j].start
+		}
+		return reps[i].end > reps[j].end
+	})
+
+	// Filter out swallowed replacements
+	var activeReps []replacement
+	referencedAssets := make(map[int]bool)
+
+	lastEnd := -1
+	for _, r := range reps {
+		if r.start < lastEnd {
+			// Swallowed by earlier replacement!
+			continue
+		}
+		activeReps = append(activeReps, r)
+		referencedAssets[r.assetIndex] = true
+		if r.end > lastEnd {
+			lastEnd = r.end
+		}
+	}
+
+	// Apply replacements
+	var sb strings.Builder
+	idx := 0
+	for _, r := range activeReps {
+		if r.start > idx {
+			sb.WriteString(markdown[idx:r.start])
+		}
+		sb.WriteString(r.text)
+		idx = r.end
+	}
+	if idx < len(markdown) {
+		sb.WriteString(markdown[idx:])
+	}
+
+	// Determine unreferenced assets
+	var toAppend []attachmentArg
+	for i, arg := range args {
+		if arg.URL == "" {
+			continue
+		}
+		if !referencedAssets[i] {
+			toAppend = append(toAppend, arg)
+		}
+	}
+
+	return &attachResult{
+		Rewritten: sb.String(),
+		ToAppend:  toAppend,
+	}, nil
+}
+
+func isSingleImage(markdown string, targetURL string) bool {
+	doc := goldmark.New().Parser().Parse(text.NewReader([]byte(markdown)))
+	if doc.ChildCount() != 1 {
+		return false
+	}
+	p, ok := doc.FirstChild().(*ast.Paragraph)
+	if !ok {
+		return false
+	}
+	if p.ChildCount() != 1 {
+		return false
+	}
+	img, ok := p.FirstChild().(*ast.Image)
+	if !ok {
+		return false
+	}
+	return string(img.Destination) == targetURL
+}
