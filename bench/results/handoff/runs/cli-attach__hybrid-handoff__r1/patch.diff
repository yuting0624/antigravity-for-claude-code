+package attachments
+
+import (
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/httpmock"
+)
+
+type UploadStub struct {
+	Name   string
+	Status int
+	Body   string
+}
+
+func StubUpload(reg *httpmock.Registry, repoID int64, name string, status int, body string) {
+	StubUploadToHost(nil, reg, "", repoID, name, status, body)
+}
+
+func StubUploadToHost(t testing.TB, reg *httpmock.Registry, host string, repoID int64, name string, status int, body string) {
+	matcher := func(req *http.Request) bool {
+		if !strings.EqualFold(req.Method, "POST") {
+			return false
+		}
+		if strings.TrimPrefix(req.URL.Path, "/") != "user-attachments/assets" {
+			return false
+		}
+		if host != "" && req.URL.Host != host {
+			return false
+		}
+		if repoID > 0 && req.URL.Query().Get("repository_id") != fmt.Sprintf("%d", repoID) {
+			return false
+		}
+		if name != "" && req.URL.Query().Get("name") != name {
+			return false
+		}
+		return true
+	}
+	reg.Register(matcher, httpmock.StatusStringResponse(status, body))
+}
+
+func NewTestAssets(t testing.TB, names ...string) []UserAsset {
+	t.Helper()
+	t.Chdir(t.TempDir())
+	assets := make([]UserAsset, 0, len(names))
+	for _, raw := range names {
+		path, alt := splitPathAlt(raw)
+		if !filepath.IsAbs(path) && !strings.HasPrefix(path, "./") && !strings.HasPrefix(path, "../") {
+			path = "./" + path
+		}
+		dir := filepath.Dir(path)
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			t.Fatalf("failed to create directory for test asset: %v", err)
+		}
+		if err := os.WriteFile(path, []byte("asset-bytes"), 0o600); err != nil {
+			t.Fatalf("failed to write test asset: %v", err)
+		}
+		a, err := newAsset(path, alt)
+		if err != nil {
+			t.Fatalf("failed to create test asset: %v", err)
+		}
+		assets = append(assets, a)
+	}
+	return assets
+}
