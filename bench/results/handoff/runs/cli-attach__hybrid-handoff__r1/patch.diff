+++ b/internal/attachments/attach.go
@@ -0,0 +1,72 @@
+package attachments
+
+import (
+	"context"
+	"strings"
+)
+
+func appendParagraph(md, addition string) string {
+	if addition == "" {
+		return md
+	}
+	trimmed := strings.TrimRight(md, " \t\r\n")
+	if trimmed == "" {
+		return addition
+	}
+	return trimmed + "\n\n" + addition
+}
+
+func (u *Uploader) UploadAndAttach(ctx context.Context, body string, assets []UserAsset) (string, int, error) {
+	if len(assets) == 0 {
+		return body, 0, nil
+	}
+
+	args := make([]attachmentArg, len(assets))
+	for i, a := range assets {
+		args[i] = attachmentArg{
+			Path:            a.Path(),
+			Alt:             a.getAsset().alt,
+			RendersAsPlayer: a.rendersAsPlayer(),
+		}
+	}
+
+	attachable, err := newAttachableMarkdown(body, args)
+	if err != nil {
+		return body, 0, err
+	}
+
+	var uploadedCount int
+	var uploadErr error
+	for i, a := range assets {
+		url, err := u.upload(ctx, a)
+		if err != nil {
+			uploadErr = err
+			break
+		}
+		args[i].URL = url
+		uploadedCount++
+	}
+
+	if uploadedCount == 0 {
+		return body, 0, uploadErr
+	}
+
+	attachable.attachmentArgs = args
+
+	res, err := attachAssetsToMarkdown(attachable)
+	if err != nil {
+		return body, uploadedCount, err
+	}
+
+	out := res.Rewritten
+	for _, item := range res.ToAppend {
+		for _, a := range assets {
+			if a.Path() == item.Path {
+				out = appendParagraph(out, a.markdown(item.URL))
+				break
+			}
+		}
+	}
+
+	return out, uploadedCount, uploadErr
+}
diff --git a/internal/attachments/client.go b/internal/attachments/client.go
new file mode 100644
index 000000000..f111f192a
--- /dev/null
+++ b/internal/attachments/client.go
@@ -0,0 +1,234 @@
+package attachments
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+
+	"github.com/cli/cli/v2/internal/gh"
+	"github.com/cli/cli/v2/internal/ghinstance"
+)
+
+var openFile = func(path string) (io.ReadCloser, error) {
+	return os.Open(path)
+}
+
+type uploadError struct {
+	StatusCode int
+	Path       string
+	msg        string
+}
+
+func (e *uploadError) Error() string {
+	return e.msg
+}
+
+type Uploader struct {
+	httpClient       *http.Client
+	host             string
+	targetRepository int64
+}
+
+func checkHost(host string) error {
+	if ghinstance.IsEnterprise(host) {
+		return errors.New("attaching files is not supported on GitHub Enterprise Server")
+	}
+	return nil
+}
+
+func NewUploader(httpClient *http.Client, tokenType gh.TokenType, host string, targetRepository int64, viewerPermission string) (*Uploader, error) {
+	if err := checkHost(host); err != nil {
+		return nil, err
+	}
+	switch tokenType {
+	case gh.TokenTypeOAuth, gh.TokenTypePersonalAccess, gh.TokenTypeFineGrainedPAT:
+	default:
+		return nil, errors.New("unsupported authentication type")
+	}
+	if targetRepository <= 0 {
+		return nil, errors.New("could not determine which repository to attach files to")
+	}
+	if viewerPermission == "" {
+		return nil, errors.New("could not determine your permission on the repository to attach files")
+	}
+	switch viewerPermission {
+	case "WRITE", "ADMIN", "MAINTAIN":
+	default:
+		return nil, errors.New("attaching files requires write access to the repository")
+	}
+	return &Uploader{
+		httpClient:       httpClient,
+		host:             host,
+		targetRepository: targetRepository,
+	}, nil
+}
+
+func (u *Uploader) upload(ctx context.Context, a UserAsset) (string, error) {
+	f, err := openFile(a.Path())
+	if err != nil {
+		return "", &uploadError{
+			StatusCode: 0,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("failed to upload %s: %v", a.Path(), err),
+		}
+	}
+	defer f.Close()
+
+	endpoint := fmt.Sprintf("%suser-attachments/assets?content_type=%s&name=%s&repository_id=%d",
+		ghinstance.UserAssetUploadPrefix(u.host),
+		url.QueryEscape(a.ContentType()),
+		url.QueryEscape(a.Basename()),
+		u.targetRepository,
+	)
+
+	req, err := http.NewRequestWithContext(ctx, "POST", endpoint, f)
+	if err != nil {
+		return "", &uploadError{
+			StatusCode: 0,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("failed to upload %s: %v", a.Path(), err),
+		}
+	}
+
+	req.Header.Set("Content-Type", "application/octet-stream")
+	req.Header.Set("Accept", "application/vnd.github+json")
+	req.ContentLength = a.Size()
+
+	resp, err := u.httpClient.Do(req)
+	if err != nil {
+		return "", &uploadError{
+			StatusCode: 0,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("failed to upload %s: %v", a.Path(), err),
+		}
+	}
+	defer resp.Body.Close()
+
+	bodyBytes, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return "", &uploadError{
+			StatusCode: resp.StatusCode,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("failed to upload %s: %v", a.Path(), err),
+		}
+	}
+
+	cleanMsg := func(s string) string {
+		return strings.ReplaceAll(strings.ReplaceAll(s, "\r", " "), "\n", " ")
+	}
+
+	if resp.StatusCode == http.StatusOK || resp.StatusCode == http.StatusCreated {
+		var result struct {
+			URL string `json:"url"`
+		}
+		if err := json.Unmarshal(bodyBytes, &result); err != nil {
+			return "", &uploadError{
+				StatusCode: 0,
+				Path:       a.Path(),
+				msg:        cleanMsg(fmt.Sprintf("failed to upload %s: %v", a.Path(), err)),
+			}
+		}
+		if result.URL == "" {
+			return "", &uploadError{
+				StatusCode: 0,
+				Path:       a.Path(),
+				msg:        fmt.Sprintf("failed to upload %s: the server returned no asset URL", a.Path()),
+			}
+		}
+		return result.URL, nil
+	}
+
+	if resp.StatusCode == http.StatusNotFound {
+		return "", &uploadError{
+			StatusCode: resp.StatusCode,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("could not upload %s: attaching files requires write access to the repository", a.Path()),
+		}
+	}
+
+	if resp.StatusCode == http.StatusRequestEntityTooLarge {
+		return "", &uploadError{
+			StatusCode: resp.StatusCode,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("failed to upload %s: HTTP 413: Payload Too Large", a.Path()),
+		}
+	}
+
+	if resp.StatusCode == http.StatusUnprocessableEntity {
+		var valErr struct {
+			Message string `json:"message"`
+			Errors  []struct {
+				Resource string `json:"resource"`
+				Field    string `json:"field"`
+				Code     string `json:"code"`
+				Message  string `json:"message"`
+			} `json:"errors"`
+		}
+		if err := json.Unmarshal(bodyBytes, &valErr); err == nil && (valErr.Message != "" || len(valErr.Errors) > 0) {
+			var sb strings.Builder
+			sb.WriteString(fmt.Sprintf("could not upload %s", a.Path()))
+			if valErr.Message != "" {
+				sb.WriteString(": ")
+				sb.WriteString(valErr.Message)
+			}
+			for _, e := range valErr.Errors {
+				if e.Message != "" {
+					sb.WriteString("; ")
+					sb.WriteString(e.Message)
+				} else if e.Resource != "" && e.Field != "" && e.Code != "" {
+					sb.WriteString(fmt.Sprintf("; %s.%s is %s", e.Resource, e.Field, e.Code))
+				}
+			}
+			return "", &uploadError{
+				StatusCode: resp.StatusCode,
+				Path:       a.Path(),
+				msg:        cleanMsg(sb.String()),
+			}
+		}
+		return "", &uploadError{
+			StatusCode: resp.StatusCode,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("could not upload %s", a.Path()),
+		}
+	}
+
+	if resp.StatusCode == http.StatusTooManyRequests {
+		ra := resp.Header.Get("Retry-After")
+		if ra == "" {
+			return "", &uploadError{
+				StatusCode: resp.StatusCode,
+				Path:       a.Path(),
+				msg:        fmt.Sprintf("could not upload %s: rate limited; wait and try again", a.Path()),
+			}
+		}
+		if _, err := strconv.Atoi(ra); err == nil {
+			return "", &uploadError{
+				StatusCode: resp.StatusCode,
+				Path:       a.Path(),
+				msg:        fmt.Sprintf("could not upload %s: rate limited; retry after %s seconds", a.Path(), ra),
+			}
+		}
+		return "", &uploadError{
+			StatusCode: resp.StatusCode,
+			Path:       a.Path(),
+			msg:        fmt.Sprintf("could not upload %s: rate limited; retry after %s", a.Path(), ra),
+		}
+	}
+
+	statusText := http.StatusText(resp.StatusCode)
+	if statusText == "" {
+		statusText = fmt.Sprintf("status %d", resp.StatusCode)
+	}
+	return "", &uploadError{
+		StatusCode: resp.StatusCode,
+		Path:       a.Path(),
+		msg:        fmt.Sprintf("failed to upload %s: HTTP %d: %s", a.Path(), resp.StatusCode, statusText),
+	}
+}
