+			if req.URL.Query().Get("name") != filepath.Base(name) {
+				return false
+			}
+			return true
+		},
+		httpmock.StatusStringResponse(status, body),
+	)
+}
+
+type StubTestAsset struct {
+	path string
+	asset
+}
+func (t StubTestAsset) Path() string { return t.path }
+func (t StubTestAsset) getAsset() asset { return t.asset }
+func (t StubTestAsset) markdown(url string) string { return fmt.Sprintf("![%s](%s)", t.path, url) }
+func (t StubTestAsset) rendersAsPlayer() bool { return false }
+
+func NewTestAssets(t *testing.T, names ...string) []UserAsset {
+	var out []UserAsset
+	for _, n := range names {
+		out = append(out, StubTestAsset{path: n, asset: asset{contentType: "image/png"}})
+	}
+	return out
+}
diff --git a/internal/attachments/userasset.go b/internal/attachments/userasset.go
new file mode 100644
index 000000000..a32a68be0
--- /dev/null
+++ b/internal/attachments/userasset.go
@@ -0,0 +1,130 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+const (
+	maxImageBytes = 10 * 1024 * 1024
+	maxVideoBytes = 100 * 1024 * 1024
+)
+
+type UserAsset interface {
+	Path() string
+	getAsset() asset
+	markdown(url string) string
+	rendersAsPlayer() bool
+}
+
+type asset struct {
+	path        string
+	alt         string
+	contentType string
+	info        fs.FileInfo
+}
+
+type imageAsset struct {
+	asset
+}
+
+func (a *imageAsset) Path() string { return a.path }
+func (a *imageAsset) getAsset() asset { return a.asset }
+func (a *imageAsset) markdown(url string) string {
+	alt := a.alt
+	alt = strings.ReplaceAll(alt, `\`, `\\`)
+	alt = strings.ReplaceAll(alt, `[`, `\[`)
+	alt = strings.ReplaceAll(alt, `]`, `\]`)
+	alt = strings.ReplaceAll(alt, "\r", " ")
+	alt = strings.ReplaceAll(alt, "\n", " ")
+	return fmt.Sprintf("![%s](%s)", alt, url)
+}
+func (a *imageAsset) rendersAsPlayer() bool { return false }
+
+type videoAsset struct {
+	asset
+}
+
+func (a *videoAsset) Path() string { return a.path }
+func (a *videoAsset) getAsset() asset { return a.asset }
+func (a *videoAsset) markdown(url string) string {
+	return url
+}
+func (a *videoAsset) rendersAsPlayer() bool { return true }
+
+func newAsset(path, alt string) (UserAsset, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		if errors.Is(err, fs.ErrNotExist) {
+			return nil, fmt.Errorf("%s: %w", path, fs.ErrNotExist)
+		}
+		return nil, err
+	}
+	if info.IsDir() {
+		return nil, fmt.Errorf("%s is a directory", path)
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%s is not a regular file", path)
+	}
+	if info.Size() == 0 {
+		return nil, fmt.Errorf("%s is empty", path)
+	}
+
+	ext := strings.ToLower(filepath.Ext(path))
+	if ext == "" {
+		return nil, fmt.Errorf("%s is not a supported file type (supported: png, jpg, jpeg, gif, webp, svg, mp4, mov, webm)", path)
+	}
+	ext = ext[1:]
+
+	var contentType string
+	var isVideo bool
+	switch ext {
+	case "png":
+		contentType = "image/png"
+	case "jpg", "jpeg":
+		contentType = "image/jpeg"
+	case "gif":
+		contentType = "image/gif"
+	case "webp":
+		contentType = "image/webp"
+	case "svg":
+		contentType = "image/svg+xml"
+	case "mp4":
+		contentType = "video/mp4"
+		isVideo = true
+	case "mov":
+		contentType = "video/quicktime"
+		isVideo = true
+	case "webm":
+		contentType = "video/webm"
+		isVideo = true
+	default:
+		return nil, fmt.Errorf("%s is not a supported file type (supported: png, jpg, jpeg, gif, webp, svg, mp4, mov, webm)", path)
+	}
+
+	if isVideo {
+		if alt != "" {
+			return nil, errors.New("cannot set alt text on video")
+		}
+		if info.Size() > maxVideoBytes {
+			return nil, fmt.Errorf("%s: videos must be at most 100.0 MB", path)
+		}
+		alt = filepath.Base(path)
+		return &videoAsset{asset{path: path, alt: alt, contentType: contentType, info: info}}, nil
+	}
+
+	if info.Size() > maxImageBytes {
+		return nil, fmt.Errorf("%s: images must be at most 10.0 MB", path)
+	}
+
+	if alt == "" {
+		alt = strings.TrimSuffix(filepath.Base(path), filepath.Ext(path))
+		alt = strings.ReplaceAll(alt, ".", " ")
+	}
+
+	return &imageAsset{asset{path: path, alt: alt, contentType: contentType, info: info}}, nil
+}
