+
+package caddyhttp
+
+import (
+	"errors"
+	"io"
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+)
+
+// DefaultMaxWriteChunk is the default maximum size of an underlying write
+// or ReadFrom chunk for idle-timeout writers (64 KiB).
+const DefaultMaxWriteChunk = 64 * 1024
+
+// IdleDeadline encapsulates parameters for calculating idle timeouts,
+// rate floors, and hard ceilings.
+type IdleDeadline struct {
+	Start        time.Time
+	Timeout      time.Duration
+	HardDeadline time.Time
+	MinRate      int64
+}
+
+func (d IdleDeadline) deadline(now time.Time, bytesTransferred int64) time.Time {
+	var dl time.Time
+	if d.Timeout > 0 {
+		dl = now.Add(d.Timeout)
+	}
+	if d.MinRate > 0 {
+		start := d.Start
+		if start.IsZero() {
+			start = now
+		}
+		if bytesTransferred < 0 {
+			bytesTransferred = 0
+		}
+		sec := bytesTransferred / d.MinRate
+		rem := bytesTransferred % d.MinRate
+		earned := time.Duration(sec)*time.Second + time.Duration(rem)*time.Second/time.Duration(d.MinRate)
+		rateLimit := start.Add(d.Timeout).Add(earned)
+		if dl.IsZero() || rateLimit.Before(dl) {
+			dl = rateLimit
+		}
+	}
+	if !d.HardDeadline.IsZero() {
+		if dl.IsZero() || d.HardDeadline.Before(dl) {
+			dl = d.HardDeadline
+		}
+	}
+	return dl
+}
+
+// IdleTimeoutReader wraps an io.ReadCloser with idle read deadline enforcement.
+type IdleTimeoutReader struct {
+	ReadCloser io.ReadCloser
+	Ctrl       *http.ResponseController
+	Deadline   IdleDeadline
+	Logger     *zap.Logger
+
+	bytesRead   int64
+	initialized bool
+}
+
+func (r *IdleTimeoutReader) setReadDeadline() {
+	if r.Ctrl == nil {
+		return
+	}
+	if !r.initialized {
+		r.initialized = true
+		if r.Deadline.Start.IsZero() {
+			r.Deadline.Start = time.Now()
+		}
+	}
+	dl := r.Deadline.deadline(time.Now(), r.bytesRead)
+	if !dl.IsZero() {
+		if err := r.Ctrl.SetReadDeadline(dl); err != nil {
+			if r.Logger != nil {
+				r.Logger.Debug("failed to set read deadline", zap.Error(err))
+			}
+		}
+	}
+}
+
+func (r *IdleTimeoutReader) Read(p []byte) (int, error) {
+	if r.ReadCloser == nil {
+		return 0, io.EOF
+	}
+	r.setReadDeadline()
+	n, err := r.ReadCloser.Read(p)
+	if n > 0 {
+		r.bytesRead += int64(n)
+		r.setReadDeadline()
+	}
+	return n, err
+}
+
+func (r *IdleTimeoutReader) Close() error {
+	if r.ReadCloser != nil {
+		return r.ReadCloser.Close()
+	}
+	return nil
+}
+
+// IdleTimeoutWriter wraps a ResponseWriterWrapper to enforce idle write deadlines
+// and chunk large writes.
+type IdleTimeoutWriter struct {
+	*ResponseWriterWrapper
+	Ctrl     *http.ResponseController
+	Deadline IdleDeadline
+	MaxChunk int
+	Logger   *zap.Logger
+
+	bytesWritten int64
+	initialized  bool
+}
+
+func (w *IdleTimeoutWriter) controller() *http.ResponseController {
+	if w.Ctrl != nil {
+		return w.Ctrl
+	}
+	if w.ResponseWriterWrapper != nil {
+		w.Ctrl = http.NewResponseController(w.ResponseWriterWrapper)
+		return w.Ctrl
+	}
+	return nil
+}
+
+func (w *IdleTimeoutWriter) setWriteDeadline() {
+	ctrl := w.controller()
+	if ctrl == nil {
+		return
+	}
+	if !w.initialized {
+		w.initialized = true
+		if w.Deadline.Start.IsZero() {
+			w.Deadline.Start = time.Now()
+		}
+	}
+	dl := w.Deadline.deadline(time.Now(), w.bytesWritten)
+	if !dl.IsZero() {
+		if err := ctrl.SetWriteDeadline(dl); err != nil {
+			if w.Logger != nil {
+				w.Logger.Debug("failed to set write deadline", zap.Error(err))
+			}
+		}
+	}
+}
+
+func (w *IdleTimeoutWriter) chunkSize() int {
+	if w.MaxChunk > 0 {
+		return w.MaxChunk
+	}
+	return DefaultMaxWriteChunk
+}
+
+func (w *IdleTimeoutWriter) Write(p []byte) (int, error) {
+	if w.ResponseWriterWrapper == nil {
+		return 0, errors.New("nil ResponseWriterWrapper")
+	}
+	chunkSize := w.chunkSize()
+	var totalWritten int
+	for len(p) > 0 {
+		chunk := p
+		if len(chunk) > chunkSize {
+			chunk = chunk[:chunkSize]
+		}
+		w.setWriteDeadline()
+		n, err := w.ResponseWriterWrapper.Write(chunk)
+		if n > 0 {
+			totalWritten += n
+			w.bytesWritten += int64(n)
+			w.setWriteDeadline()
+		}
+		if err != nil {
+			return totalWritten, err
+		}
+		p = p[n:]
+	}
+	return totalWritten, nil
+}
+
+func (w *IdleTimeoutWriter) ReadFrom(r io.Reader) (int64, error) {
+	if w.ResponseWriterWrapper == nil {
+		return 0, errors.New("nil ResponseWriterWrapper")
+	}
+	chunkSize := w.chunkSize()
+	var total int64
+	for {
+		w.setWriteDeadline()
+		limited := io.LimitReader(r, int64(chunkSize))
+		n, err := w.ResponseWriterWrapper.ReadFrom(limited)
+		if n > 0 {
+			total += n
+			w.bytesWritten += n
+			w.setWriteDeadline()
+		}
+		if err != nil {
+			if errors.Is(err, io.EOF) {
+				return total, nil
+			}
+			return total, err
+		}
+		if n < int64(chunkSize) {
+			break
+		}
+	}
+	return total, nil
+}
+
+func (w *IdleTimeoutWriter) WriteHeader(statusCode int) {
+	w.setWriteDeadline()
+	if w.ResponseWriterWrapper != nil {
+		w.ResponseWriterWrapper.WriteHeader(statusCode)
+	}
+}
+
+func (w *IdleTimeoutWriter) Unwrap() http.ResponseWriter {
+	if w.ResponseWriterWrapper != nil {
+		return w.ResponseWriterWrapper.ResponseWriter
+	}
+	return nil
+}
+
+var (
+	_ http.ResponseWriter = (*IdleTimeoutWriter)(nil)
+	_ io.ReaderFrom       = (*IdleTimeoutWriter)(nil)
+)
