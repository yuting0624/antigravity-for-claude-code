+
+package caddyhttp
+
+import (
+	"errors"
+	"io"
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+)
+
+// DefaultMaxWriteChunk is the default maximum number of bytes
+// written to the underlying writer in a single call.
+const DefaultMaxWriteChunk = 64 * 1024
+
+// IdleDeadline computes the next read or write deadline for the idle-reset
+// mechanism shared by IdleTimeoutReader and IdleTimeoutWriter.
+type IdleDeadline struct {
+	Start        time.Time     // when transfer began; base for MinRate credit; zero means use time of first use
+	Timeout      time.Duration // idle window; deadline pushed to now+Timeout after each successful transfer; zero disables
+	MinRate      int64         // minimum bytes per second; when >0 the deadline grows with bytes instead of idle-resetting
+	HardDeadline time.Time     // absolute ceiling the computed deadline must never exceed; zero means none
+}
+
+// Next returns the deadline to set before transferring more bytes, given
+// how many bytes were transferred so far. A zero return means no deadline
+// should be set. The start argument is the fallback for a zero d.Start.
+func (d IdleDeadline) Next(start time.Time, transferred int64) time.Time {
+	var dl time.Time
+	if d.MinRate > 0 {
+		s := d.Start
+		if s.IsZero() {
+			s = start
+		}
+		credit := time.Duration(float64(transferred) / float64(d.MinRate) * float64(time.Second))
+		dl = s.Add(d.Timeout + credit)
+	} else if d.Timeout > 0 {
+		dl = time.Now().Add(d.Timeout)
+	}
+	if !d.HardDeadline.IsZero() && (dl.IsZero() || dl.After(d.HardDeadline)) {
+		dl = d.HardDeadline
+	}
+	return dl
+}
+
+// setDeadline sets a transfer deadline via set, returning false if the
+// protocol does not support deadlines and no further attempts should be
+// made. kind is "read" or "write" and is used in the log message.
+func setDeadline(set func(time.Time) error, dl time.Time, kind string, logger *zap.Logger) bool {
+	if err := set(dl); err != nil {
+		if logger == nil {
+			logger = zap.NewNop()
+		}
+		if errors.Is(err, http.ErrNotSupported) {
+			if c := logger.Check(zapcore.DebugLevel, "protocol does not support transfer deadlines"); c != nil {
+				c.Write(zap.Error(err), zap.String("kind", kind))
+			}
+			return false
+		}
+		if c := logger.Check(zapcore.ErrorLevel, "could not set transfer deadline"); c != nil {
+			c.Write(zap.Error(err), zap.String("kind", kind))
+		}
+		return true
+	}
+	return true
+}
+
+// IdleTimeoutReader wraps an io.ReadCloser with an idle-reset deadline,
+// resetting the read deadline via http.ResponseController before every read.
+type IdleTimeoutReader struct {
+	io.ReadCloser
+	Ctrl     *http.ResponseController
+	Deadline IdleDeadline
+	Logger   *zap.Logger
+
+	start      time.Time
+	read       int64
+	noDeadline bool
+}
+
+// Read reads from the underlying reader, resetting the idle read deadline
+// before each read.
+func (r *IdleTimeoutReader) Read(p []byte) (int, error) {
+	if !r.noDeadline {
+		if r.start.IsZero() {
+			r.start = time.Now()
+		}
+		dl := r.Deadline.Next(r.start, r.read)
+		if !dl.IsZero() && r.Ctrl != nil {
+			if !setDeadline(r.Ctrl.SetReadDeadline, dl, "read", r.Logger) {
+				r.noDeadline = true
+			}
+		}
+	}
+	n, err := r.ReadCloser.Read(p)
+	r.read += int64(n)
+	return n, err
+}
+
+// IdleTimeoutWriter wraps a ResponseWriter with an idle-reset deadline,
+// resetting the write deadline via http.ResponseController before every write.
+type IdleTimeoutWriter struct {
+	*ResponseWriterWrapper
+	Ctrl     *http.ResponseController
+	Deadline IdleDeadline
+	MaxChunk int // max bytes per underlying write call; if <= 0, DefaultMaxWriteChunk is used
+	Logger   *zap.Logger
+
+	start      time.Time
+	written    int64
+	noDeadline bool
+}
+
+func (w *IdleTimeoutWriter) setWriteDeadline() {
+	if !w.noDeadline {
+		if w.start.IsZero() {
+			w.start = time.Now()
+		}
+		dl := w.Deadline.Next(w.start, w.written)
+		if !dl.IsZero() && w.Ctrl != nil {
+			if !setDeadline(w.Ctrl.SetWriteDeadline, dl, "write", w.Logger) {
+				w.noDeadline = true
+			}
+		}
+	}
+}
+
+func (w *IdleTimeoutWriter) effectiveChunkSize() int {
+	if w.MaxChunk > 0 {
+		return w.MaxChunk
+	}
+	return DefaultMaxWriteChunk
+}
+
+// Write writes p in chunks up to MaxChunk, resetting the idle write deadline
+// before each chunk.
+func (w *IdleTimeoutWriter) Write(p []byte) (int, error) {
+	chunk := w.effectiveChunkSize()
+	if len(p) == 0 {
+		w.setWriteDeadline()
+		return w.ResponseWriterWrapper.Write(p)
+	}
+	var total int
+	for len(p) > 0 {
+		end := chunk
+		if len(p) < end {
+			end = len(p)
+		}
+		w.setWriteDeadline()
+		n, err := w.ResponseWriterWrapper.Write(p[:end])
+		total += n
+		w.written += int64(n)
+		if err != nil {
+			return total, err
+		}
+		if n < end {
+			return total, io.ErrShortWrite
+		}
+		p = p[end:]
+	}
+	return total, nil
+}
+
+// ReadFrom reads from r and writes to the underlying writer in chunks up to
+// MaxChunk, resetting the idle write deadline before each chunk.
+func (w *IdleTimeoutWriter) ReadFrom(r io.Reader) (int64, error) {
+	chunk := int64(w.effectiveChunkSize())
+	var total int64
+	for {
+		w.setWriteDeadline()
+		n, err := w.ResponseWriterWrapper.ReadFrom(io.LimitReader(r, chunk))
+		total += n
+		w.written += n
+		if err != nil {
+			return total, err
+		}
+		if n < chunk {
+			return total, nil
+		}
+	}
+}
+
+// Interface guards
+var (
+	_ io.ReadCloser       = (*IdleTimeoutReader)(nil)
+	_ http.ResponseWriter = (*IdleTimeoutWriter)(nil)
+	_ io.ReaderFrom       = (*IdleTimeoutWriter)(nil)
+)
