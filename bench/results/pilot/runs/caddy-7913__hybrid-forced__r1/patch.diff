+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package timeouts
+
+import (
+	"net/http"
+	"time"
+
+	"github.com/dustin/go-humanize"
+	"go.uber.org/zap"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/caddyconfig/caddyfile"
+	"github.com/caddyserver/caddy/v2/caddyconfig/httpcaddyfile"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func init() {
+	caddy.RegisterModule(Timeouts{})
+	httpcaddyfile.RegisterHandlerDirective("timeouts", parseCaddyfile)
+}
+
+// Timeouts is a middleware that enforces idle timeouts and minimum transfer
+// rates on HTTP request and response bodies.
+type Timeouts struct {
+	// How long to allow a read from the request body to stall. The deadline
+	// is reset after every successful read, so a slow but steadily
+	// progressing upload is not cut off. Zero disables.
+	ReadTimeout time.Duration `json:"read_timeout,omitempty"`
+
+	// Minimum read rate in bytes per second. If greater than zero, the
+	// allowed deadline grows with the number of bytes read instead of
+	// simply resetting, so a trickle that never sustains the rate is
+	// still cut off. Zero disables.
+	ReadMinRate int64 `json:"read_min_rate,omitempty"`
+
+	// How long to allow a write to the client to stall; reset after every
+	// successful write. Zero disables.
+	WriteTimeout time.Duration `json:"write_timeout,omitempty"`
+
+	// Minimum write rate in bytes per second; see ReadMinRate.
+	WriteMinRate int64 `json:"write_min_rate,omitempty"`
+
+	// Maximum bytes written to the connection per write call, so that a
+	// single large write cannot outlive one deadline window. Defaults to
+	// caddyhttp.DefaultMaxWriteChunk.
+	MaxWriteChunk int `json:"max_write_chunk,omitempty"`
+
+	logger *zap.Logger
+}
+
+// CaddyModule returns the Caddy module information.
+func (Timeouts) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{
+		ID:  "http.handlers.timeouts",
+		New: func() caddy.Module { return new(Timeouts) },
+	}
+}
+
+// Provision sets up the module.
+func (t *Timeouts) Provision(ctx caddy.Context) error {
+	t.logger = ctx.Logger()
+	return nil
+}
+
+// ServeHTTP implements caddyhttp.MiddlewareHandler.
+func (t *Timeouts) ServeHTTP(w http.ResponseWriter, r *http.Request, next caddyhttp.Handler) error {
+	if t.ReadTimeout <= 0 && t.WriteTimeout <= 0 && t.ReadMinRate <= 0 && t.WriteMinRate <= 0 {
+		return next.ServeHTTP(w, r)
+	}
+
+	start := time.Now()
+
+	logger := t.logger
+	if logger == nil {
+		logger = zap.NewNop()
+	}
+
+	//nolint:bodyclose
+	ctrl := http.NewResponseController(w)
+
+	if (t.ReadTimeout > 0 || t.ReadMinRate > 0) && r.Body != nil {
+		r.Body = &caddyhttp.IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       ctrl,
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   start,
+				Timeout: t.ReadTimeout,
+				MinRate: t.ReadMinRate,
+			},
+			Logger: logger,
+		}
+	}
+
+	if t.WriteTimeout > 0 || t.WriteMinRate > 0 {
+		w = &caddyhttp.IdleTimeoutWriter{
+			ResponseWriterWrapper: &caddyhttp.ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  ctrl,
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   start,
+				Timeout: t.WriteTimeout,
+				MinRate: t.WriteMinRate,
+			},
+			MaxChunk: t.MaxWriteChunk,
+			Logger:   logger,
+		}
+	}
+
+	return next.ServeHTTP(w, r)
+}
+
+// UnmarshalCaddyfile sets up the handler from Caddyfile tokens. Syntax:
+//
+//	timeouts {
+//	    read_timeout    <duration> [<min_rate>]
+//	    write_timeout   <duration> [<min_rate>]
+//	    write_max_chunk <size>
+//	}
+func (t *Timeouts) UnmarshalCaddyfile(d *caddyfile.Dispenser) error {
+	d.Next() // consume directive name
+
+	if d.NextArg() {
+		return d.ArgErr()
+	}
+
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		switch d.Val() {
+		case "read_timeout":
+			if !d.NextArg() {
+				return d.ArgErr()
+			}
+			dur, err := caddy.ParseDuration(d.Val())
+			if err != nil {
+				return d.Errf("parsing read timeout duration: %v", err)
+			}
+			t.ReadTimeout = dur
+
+			if d.NextArg() {
+				minRate, err := humanize.ParseBytes(d.Val())
+				if err != nil {
+					return d.Errf("parsing read min rate: %v", err)
+				}
+				t.ReadMinRate = int64(minRate)
+			}
+			if d.NextArg() {
+				return d.ArgErr()
+			}
+
+		case "write_timeout":
+			if !d.NextArg() {
+				return d.ArgErr()
+			}
+			dur, err := caddy.ParseDuration(d.Val())
+			if err != nil {
+				return d.Errf("parsing write timeout duration: %v", err)
+			}
+			t.WriteTimeout = dur
+
+			if d.NextArg() {
+				minRate, err := humanize.ParseBytes(d.Val())
+				if err != nil {
+					return d.Errf("parsing write min rate: %v", err)
+				}
+				t.WriteMinRate = int64(minRate)
+			}
+			if d.NextArg() {
+				return d.ArgErr()
+			}
+
+		case "write_max_chunk":
+			if !d.NextArg() {
+				return d.ArgErr()
+			}
+			size, err := humanize.ParseBytes(d.Val())
+			if err != nil {
+				return d.Errf("parsing write_max_chunk: %v", err)
+			}
+			t.MaxWriteChunk = int(size)
+			if d.NextArg() {
+				return d.ArgErr()
+			}
+
+		default:
+			return d.Errf("unrecognized timeouts option '%s'", d.Val())
+		}
+	}
+
+	return nil
+}
+
+// parseCaddyfile sets up the handler from Caddyfile tokens.
+func parseCaddyfile(h httpcaddyfile.Helper) (caddyhttp.MiddlewareHandler, error) {
+	var t Timeouts
+	err := t.UnmarshalCaddyfile(h.Dispenser)
+	return &t, err
+}
+
+// Interface guards
+var (
+	_ caddy.Provisioner           = (*Timeouts)(nil)
+	_ caddyhttp.MiddlewareHandler = (*Timeouts)(nil)
+	_ caddyfile.Unmarshaler       = (*Timeouts)(nil)
+)
