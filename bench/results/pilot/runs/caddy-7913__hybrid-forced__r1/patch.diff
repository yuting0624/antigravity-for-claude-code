+// applyIdleTimeouts wraps the request body and the response writer with
+// idle-reset deadlines, if configured. The hard ReadTimeout and
+// WriteTimeout, if set, remain an absolute ceiling that the idle resets
+// cannot push past.
+func (s *Server) applyIdleTimeouts(w http.ResponseWriter, r *http.Request, start time.Time) (http.ResponseWriter, *http.Request) {
+	readIdle := time.Duration(s.ReadIdleTimeout)
+	writeIdle := time.Duration(s.WriteIdleTimeout)
+	if readIdle <= 0 && writeIdle <= 0 && s.ReadMinRate <= 0 && s.WriteMinRate <= 0 {
+		return w, r
+	}
+
+	logger := s.logger
+	if logger == nil {
+		logger = zap.NewNop()
+	}
+
+	//nolint:bodyclose
+	ctrl := http.NewResponseController(w)
+
+	if (readIdle > 0 || s.ReadMinRate > 0) && r.Body != nil {
+		dl := IdleDeadline{Start: start, Timeout: readIdle, MinRate: s.ReadMinRate}
+		if s.ReadTimeout > 0 {
+			dl.HardDeadline = start.Add(time.Duration(s.ReadTimeout))
+		}
+		r.Body = &IdleTimeoutReader{ReadCloser: r.Body, Ctrl: ctrl, Deadline: dl, Logger: logger}
+	}
+
+	if writeIdle > 0 || s.WriteMinRate > 0 {
+		dl := IdleDeadline{Start: start, Timeout: writeIdle, MinRate: s.WriteMinRate}
+		if s.WriteTimeout > 0 {
+			dl.HardDeadline = start.Add(time.Duration(s.WriteTimeout))
+		}
+		w = &IdleTimeoutWriter{
+			ResponseWriterWrapper: &ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  ctrl,
+			Deadline:              dl,
+			MaxChunk:              s.MaxWriteChunk,
+			Logger:                logger,
+		}
+	}
+
+	return w, r
+}
