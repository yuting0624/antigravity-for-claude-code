+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"go.k6.io/k6/v2/lib"
+)
+
+// ProvisionParams describes the load test to provision for a local execution run.
+type ProvisionParams struct {
+	// Name is the load test name in the cloud project.
+	Name string
+	// ProjectID is the cloud project the load test belongs to.
+	ProjectID int64
+	// MaxVUs is the maximum number of VUs the test can run.
+	MaxVUs int32
+	// TotalDuration is the total duration of the test, in seconds.
+	TotalDuration int32
+	// Options is the resolved k6 script options, as JSON.
+	Options json.RawMessage
+	// Archive is the test archive to upload. When nil, no archive is uploaded.
+	Archive *lib.Archive
+	// PollInterval is how often the test run is polled while waiting for it to become ready.
+	PollInterval time.Duration
+}
+
+// ProvisionResult is everything a locally executed test run needs to talk to the cloud.
+type ProvisionResult struct {
+	// TestRunID identifies the created test run.
+	TestRunID int64
+	// TestRunDetailsPageURL links to the test run results page.
+	TestRunDetailsPageURL string
+	// RuntimeConfig carries the metrics push URL, the test-run scoped token and the secrets endpoint.
+	RuntimeConfig RuntimeConfig
+}
+
+// ProvisionLocalExecution prepares a local execution run in the cloud: it ensures the load test
+// exists, starts a local execution, uploads the archive when there is one, and waits until the
+// test run is ready to receive metrics.
+func (c *Client) ProvisionLocalExecution(ctx context.Context, params ProvisionParams) (ProvisionResult, error) {
+	var archiveBytes []byte
+	if params.Archive != nil {
+		var buf bytes.Buffer
+		if err := params.Archive.Write(&buf); err != nil {
+			return ProvisionResult{}, fmt.Errorf("serialize archive: %w", err)
+		}
+		archiveBytes = buf.Bytes()
+	}
+
+	loadTestID, err := c.v6Client.CreateOrFindLoadTest(ctx, params.ProjectID, params.Name)
+	if err != nil {
+		return ProvisionResult{}, fmt.Errorf("create or find load test: %w", err)
+	}
+
+	res, err := c.StartLocalExecution(ctx, loadTestID, StartLocalExecutionRequest{
+		Options:       params.Options,
+		MaxVUs:        params.MaxVUs,
+		TotalDuration: params.TotalDuration,
+		ArchiveSize:   int64(len(archiveBytes)),
+	})
+	if err != nil {
+		return ProvisionResult{}, fmt.Errorf("start local execution: %w", err)
+	}
+
+	if len(archiveBytes) > 0 {
+		if res.ArchiveUploadURL == nil || *res.ArchiveUploadURL == "" {
+			if c.logger != nil {
+				c.logger.Warn("cloud returned no archive upload URL, archive is not uploaded")
+			}
+		} else {
+			if err := c.UploadArchive(ctx, *res.ArchiveUploadURL, archiveBytes); err != nil {
+				return ProvisionResult{}, fmt.Errorf("upload archive: %w", err)
+			}
+		}
+	}
+
+	if err := c.WaitForTestRunReady(ctx, res.TestRunID, params.PollInterval); err != nil {
+		return ProvisionResult{}, fmt.Errorf("wait for test run ready: %w", err)
+	}
+
+	return ProvisionResult{
+		TestRunID:             res.TestRunID,
+		TestRunDetailsPageURL: res.TestRunDetailsPageURL,
+		RuntimeConfig:         res.RuntimeConfig,
+	}, nil
+}
