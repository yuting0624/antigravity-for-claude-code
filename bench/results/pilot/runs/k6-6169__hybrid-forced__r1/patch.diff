@@ -0,0 +1,12 @@
+// Package clientcfg holds HTTP client tuning constants shared by the k6 Cloud API clients.
+package clientcfg
+
+import "time"
+
+const (
+	// RetryInterval is the default cloud request retry interval.
+	RetryInterval = 500 * time.Millisecond
+
+	// MaxRetries is the maximum retry attempts.
+	MaxRetries = 3
+)
diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..fd457feab
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,242 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// StartLocalExecutionRequest holds parameters for starting a test run in local execution mode.
+// Options is the resolved k6 script options as JSON; TotalDuration is in seconds; ArchiveSize is
+// in bytes and zero means no archive is uploaded.
+type StartLocalExecutionRequest struct {
+	Options       json.RawMessage
+	MaxVUs        int32
+	TotalDuration int32
+	ArchiveSize   int64
+}
+
+// MetricsConfig holds configuration for pushing metrics to k6 Cloud during local execution.
+type MetricsConfig struct {
+	PushURL               string
+	PushInterval          *string
+	PushConcurrency       *int32
+	AggregationPeriod     *string
+	AggregationWaitPeriod *string
+	AggregationMinSamples *int32
+	MaxSamplesPerPackage  *int32
+}
+
+// SecretsConfig holds configuration for retrieving decrypted secrets from k6 Cloud during local execution.
+type SecretsConfig struct {
+	Endpoint     string
+	ResponsePath string
+}
+
+// RuntimeConfig holds runtime parameters returned by k6 Cloud for local execution.
+type RuntimeConfig struct {
+	Metrics      MetricsConfig
+	TestRunToken string
+	Secrets      SecretsConfig
+}
+
+// StartLocalExecutionResponse holds the response payload from starting a test run in local execution mode.
+type StartLocalExecutionResponse struct {
+	TestRunID             int64
+	ArchiveUploadURL      *string
+	TestRunDetailsPageURL string
+	RuntimeConfig         RuntimeConfig
+}
+
+// StartLocalExecution initiates a test run in local execution mode with k6 Cloud.
+func (c *Client) StartLocalExecution(ctx context.Context, loadTestID int64, req StartLocalExecutionRequest) (_ *StartLocalExecutionResponse, err error) {
+	opts := make(map[string]interface{})
+	if len(req.Options) > 0 && string(req.Options) != "null" {
+		if err := json.Unmarshal(req.Options, &opts); err != nil {
+			return nil, err
+		}
+		if opts == nil {
+			opts = make(map[string]interface{})
+		}
+	}
+
+	body := k6cloud.NewStartLocalExecutionTestRequest(opts, req.MaxVUs, req.TotalDuration)
+	if req.ArchiveSize > 0 {
+		size := req.ArchiveSize
+		if size > math.MaxInt32 {
+			size = math.MaxInt32
+		}
+		size32 := int32(size)
+		body.ArchiveSize = *k6cloud.NewNullableInt32(&size32)
+	} else {
+		body.ArchiveSize = *k6cloud.NewNullableInt32(nil)
+	}
+
+	var key [8]byte
+	if _, err := rand.Read(key[:]); err != nil {
+		return nil, err
+	}
+
+	res, hr, err := c.apiClient.ProvisioningAPI.
+		StartLocalExecutionTest(c.authCtx(ctx, c.token), loadTestID).
+		StartLocalExecutionTestRequest(body).
+		K6IdempotencyKey(hex.EncodeToString(key[:])).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if cerr := CheckResponse(hr); cerr != nil {
+		return nil, cerr
+	}
+	if err != nil {
+		return nil, err
+	}
+	if res == nil {
+		return nil, errUnknown
+	}
+
+	var archiveUploadURL *string
+	if val, ok := res.GetArchiveUploadUrlOk(); ok && val != nil {
+		archiveUploadURL = val
+	}
+
+	return &StartLocalExecutionResponse{
+		TestRunID:             res.GetTestRunId(),
+		ArchiveUploadURL:      archiveUploadURL,
+		TestRunDetailsPageURL: res.GetTestRunDetailsPageUrl(),
+		RuntimeConfig:         convertRuntimeConfig(res.GetRuntimeConfig()),
+	}, nil
+}
+
+func convertRuntimeConfig(rc k6cloud.RuntimeConfig) RuntimeConfig {
+	m := rc.GetMetrics()
+	metrics := MetricsConfig{
+		PushURL: m.GetPushUrl(),
+	}
+	if v, ok := m.GetPushIntervalOk(); ok && v != nil {
+		metrics.PushInterval = v
+	}
+	if v, ok := m.GetPushConcurrencyOk(); ok && v != nil {
+		metrics.PushConcurrency = v
+	}
+	if v, ok := m.GetAggregationPeriodOk(); ok && v != nil {
+		metrics.AggregationPeriod = v
+	}
+	if v, ok := m.GetAggregationWaitPeriodOk(); ok && v != nil {
+		metrics.AggregationWaitPeriod = v
+	}
+	if v, ok := m.GetAggregationMinSamplesOk(); ok && v != nil {
+		metrics.AggregationMinSamples = v
+	}
+	if v, ok := m.GetMaxSamplesPerPackageOk(); ok && v != nil {
+		metrics.MaxSamplesPerPackage = v
+	}
+
+	s := rc.GetSecrets()
+	secrets := SecretsConfig{
+		Endpoint:     s.GetEndpoint(),
+		ResponsePath: s.GetResponsePath(),
+	}
+
+	return RuntimeConfig{
+		Metrics:      metrics,
+		TestRunToken: rc.GetTestRunToken(),
+		Secrets:      secrets,
+	}
+}
+
+// UploadArchive uploads a tar archive to the given presigned upload URL.
+func (c *Client) UploadArchive(ctx context.Context, url string, archive []byte) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPut, url, bytes.NewReader(archive))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/x-tar")
+	req.ContentLength = int64(len(archive))
+	req.GetBody = func() (io.ReadCloser, error) {
+		return io.NopCloser(bytes.NewReader(archive)), nil
+	}
+
+	return c.uploader.Do(req, nil)
+}
+
+// WaitForTestRunReady polls the test run progress until it reaches an active state.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	var lastLoggedStatus v6.Status
+
+	for {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		default:
+		}
+
+		tp, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			return err
+		}
+
+		switch tp.Status {
+		case v6.StatusInitializing, v6.StatusRunning:
+			return nil
+		case v6.StatusAborted:
+			var lastMsg string
+			for i := len(tp.StatusHistory) - 1; i >= 0; i-- {
+				if tp.StatusHistory[i].Status == v6.StatusAborted && tp.StatusHistory[i].Message != "" {
+					lastMsg = tp.StatusHistory[i].Message
+					break
+				}
+			}
+			if lastMsg != "" {
+				return fmt.Errorf("test run aborted before starting: %s", lastMsg)
+			}
+			return errors.New("test run aborted before starting")
+		case v6.StatusCompleted, v6.StatusProcessingMetrics:
+			return fmt.Errorf("test run reached status %q before starting", tp.Status)
+		default:
+			if c.logger != nil && tp.Status != lastLoggedStatus {
+				c.logger.WithField("status", tp.FormatStatus()).Info("waiting for test run to start")
+				lastLoggedStatus = tp.Status
+			}
+		}
+
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(pollInterval):
+		}
+	}
+}
+
+// NotifyTestRunCompleted reports test run completion and any execution error to k6 Cloud.
+func (c *Client) NotifyTestRunCompleted(ctx context.Context, testRunID int64, token string, testErr error) (err error) {
+	m := k6cloud.NewScriptExecutionCompletedNotificationApiModel("script_execution_completed")
+	if ne := mapTestErrorToNotifyCode(testErr); ne != nil {
+		m.SetError(*k6cloud.NewScriptExecutionError(ne.Code, ne.Reason))
+	}
+
+	hr, err := c.apiClient.ProvisioningAPI.
+		TestRunsNotify(c.authCtx(ctx, token), testRunID).
+		ScriptExecutionCompletedNotificationApiModel(m).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if cerr := CheckResponse(hr); cerr != nil {
+		return cerr
+	}
+	return err
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..12527f225
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,92 @@
+package provisioning
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client talks to the k6 Cloud provisioning API. It wraps the generated cloud SDK for the
+// provisioning endpoints and embeds a v6 API client for the load test and test run endpoints the
+// local-execution flow also needs.
+type Client struct {
+	apiClient *k6cloud.APIClient
+	v6Client  *v6.Client
+	uploader  *HTTPClient
+	token     string
+	stackID   int64
+	version   string
+	logger    logrus.FieldLogger
+}
+
+// NewClient returns a new client for the k6 Cloud provisioning API.
+func NewClient(logger logrus.FieldLogger, token, host, version string, stackID int64, timeout time.Duration) (*Client, error) {
+	if token == "" {
+		return nil, fmt.Errorf("token is required to create cloud API client")
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Global k6 Cloud API.",
+		},
+	}
+	cfg.HTTPClient = &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+
+	if stackID != 0 {
+		cfg.AddDefaultHeader("X-Stack-Id", strconv.FormatInt(stackID, 10))
+	}
+
+	v6c, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if err := v6c.SetStackID(stackID); err != nil {
+		return nil, err
+	}
+
+	uploader := NewHTTPClient(&http.Client{Timeout: timeout, Transport: http.DefaultTransport}, "", version, logger)
+
+	return &Client{
+		apiClient: k6cloud.NewAPIClient(cfg),
+		v6Client:  v6c,
+		uploader:  uploader,
+		token:     token,
+		stackID:   stackID,
+		version:   version,
+		logger:    logger,
+	}, nil
+}
+
+// authCtx returns a context carrying the given bearer token for the generated SDK.
+func (c *Client) authCtx(ctx context.Context, token string) context.Context {
+	return context.WithValue(ctx, k6cloud.ContextAccessToken, token)
+}
+
+// closeResponse drains and closes an HTTP response body, reporting a close error only when nothing
+// else failed.
+func closeResponse(res *http.Response, rerr *error) {
+	if res == nil {
+		return
+	}
+	_, _ = io.Copy(io.Discard, res.Body)
+	if err := res.Body.Close(); err != nil && *rerr == nil {
+		*rerr = err
+	}
+}
