new file mode 100644
index 000000000..c4e1cefe3
--- /dev/null
+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,151 @@
+// Package provtest provides an HTTP test server that fakes the k6 Cloud provisioning API and the
+// bits of the v6 API that the local-execution provisioning flow uses. It keeps SDK wire-format details
+// out of the tests that use it.
+package provtest
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	// DefaultLoadTestID is the load test id the fake serves by default.
+	DefaultLoadTestID int64 = 456
+	// DefaultTestRunID is the test run id the fake serves by default.
+	DefaultTestRunID int64 = 123
+	// PresignedUploadPath is the path the fake serves as a presigned archive upload URL.
+	PresignedUploadPath = "/presigned-upload/archive.tar"
+)
+
+// Server is a test HTTP server for the k6 Cloud provisioning API.
+type Server struct {
+	*httptest.Server
+	// Mux is the request multiplexer, exported so tests can register extra routes
+	// such as a catch-all "/" handler.
+	Mux *http.ServeMux
+
+	fetchTestRunHits atomic.Int32
+}
+
+// NewServer starts a test server with no routes registered. Routes are added with the Handle*
+// methods. The server is closed via t.Cleanup.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+
+	mux := http.NewServeMux()
+	srv := httptest.NewServer(mux)
+	t.Cleanup(srv.Close)
+
+	return &Server{
+		Server: srv,
+		Mux:    mux,
+	}
+}
+
+// PresignedUploadURL returns the absolute URL of the fake presigned archive upload endpoint.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// HandleCreateLoadTest registers the v6 create-or-find load test route for the given project.
+// The handler receives both the POST (create) and the GET (find by name) requests.
+func (s *Server) HandleCreateLoadTest(projectID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID), h)
+}
+
+// HandleStartLocalExecution registers the start-local-execution route for the given load test.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/load_tests/%d/start_local_execution", loadTestID), h)
+}
+
+// HandlePresignedUpload registers the fake presigned archive upload route.
+func (s *Server) HandlePresignedUpload(path string, h http.HandlerFunc) {
+	s.Mux.HandleFunc(path, h)
+}
+
+// HandleNotify registers the end-of-script-execution notification route for the given test run.
+func (s *Server) HandleNotify(testRunID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/test_runs/%d/notify", testRunID), h)
+}
+
+// HandleFetchTestRun registers the v6 test run route for the given test run. Each request returns
+// the next entry of progress; once the slice is exhausted the last entry is repeated forever.
+func (s *Server) HandleFetchTestRun(testRunID int64, progress []v6.TestProgress) {
+	var reqIndex atomic.Int32
+	pattern := fmt.Sprintf("/cloud/v6/test_runs/%d", testRunID)
+	s.Mux.HandleFunc(pattern, func(w http.ResponseWriter, _ *http.Request) {
+		s.fetchTestRunHits.Add(1)
+		idx := int(reqIndex.Add(1) - 1)
+		var tp v6.TestProgress
+		if len(progress) > 0 {
+			if idx >= len(progress) {
+				idx = len(progress) - 1
+			}
+			tp = progress[idx]
+		}
+
+		res := k6cloud.NewTestRunApiModelWithDefaults()
+		res.SetStatus(tp.Status.String())
+		res.SetResult(tp.Result.String())
+		res.SetEstimatedDuration(tp.EstimatedDuration)
+		res.SetExecutionDuration(tp.ExecutionDuration)
+		res.SetStatusHistory(v6.ToStatusModel(tp.StatusHistory))
+		res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+		res.SetResultDetails(k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(k6cloud.NewResultDetailsApiModel("")))
+		res.SetOptions(map[string]any{})
+		writeJSON(w, http.StatusOK, res)
+	})
+}
+
+// FetchTestRunHitCount returns how many times the test run route has been requested.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchTestRunHits.Load()
+}
+
+// DefaultStartLocalExecutionResponse returns the canned start-local-execution response used by
+// tests. Callers mutate the returned value to point URLs at their own test server.
+func DefaultStartLocalExecutionResponse() *k6cloud.StartLocalExecutionTestResponse {
+	metrics := k6cloud.NewMetricsRuntimeConfigWithDefaults()
+	metrics.SetPushUrl("https://ingest.k6.io/v1/metrics")
+	metrics.SetPushInterval("2s")
+	metrics.SetPushConcurrency(5)
+	metrics.SetAggregationPeriod("3s")
+	metrics.SetAggregationWaitPeriod("1s")
+	metrics.SetAggregationMinSamples(50)
+	metrics.SetMaxSamplesPerPackage(2000)
+
+	secrets := k6cloud.NewSecretsRuntimeConfigWithDefaults()
+	secrets.SetEndpoint("https://api.k6.io/provisioning/v1/test_runs/123/decrypt_secret?name={key}")
+	secrets.SetResponsePath("plaintext")
+
+	rc := k6cloud.NewRuntimeConfigWithDefaults()
+	rc.SetMetrics(*metrics)
+	rc.SetTraces(*k6cloud.NewTracesRuntimeConfigWithDefaults())
+	rc.SetFiles(*k6cloud.NewFilesRuntimeConfigWithDefaults())
+	rc.SetLogs(*k6cloud.NewLogsRuntimeConfigWithDefaults())
+	rc.SetSecrets(*secrets)
+	rc.SetTestRunToken("test-run-token-abc")
+
+	res := k6cloud.NewStartLocalExecutionTestResponseWithDefaults()
+	res.SetTestRunId(DefaultTestRunID)
+	res.SetRuntimeConfig(*rc)
+	res.SetArchiveUploadUrl("https://s3.amazonaws.com/k6-cloud-archives/test-run-123/archive.tar")
+	res.SetTestRunDetailsPageUrl(fmt.Sprintf("https://app.k6.io/runs/%d", DefaultTestRunID))
+	return res
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	if err := json.NewEncoder(w).Encode(v); err != nil {
+		panic(fmt.Errorf("provtest: encoding JSON: %w", err))
+	}
+}
