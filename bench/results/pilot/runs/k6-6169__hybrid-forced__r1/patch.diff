diff --git a/internal/cloudapi/provisioning/errors.go b/internal/cloudapi/provisioning/errors.go
new file mode 100644
index 000000000..fcab6cf49
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,52 @@
+package provisioning
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+// errUnknown is returned when the API gives us nothing useful.
+var errUnknown = errors.New("an error occurred communicating with k6 Cloud")
+
+// ResponseError is an error returned by the k6 Cloud provisioning API.
+type ResponseError struct {
+	StatusCode int
+	Body       string
+	classified error // unexported: the 401/403 classification from internal/cloudapi/httperr
+}
+
+// Error returns a message containing both the status code and the response body.
+func (e *ResponseError) Error() string {
+	return fmt.Sprintf("unexpected HTTP status %d from k6 Cloud: %s", e.StatusCode, e.Body)
+}
+
+// Unwrap returns the classified 401/403 error, if any.
+func (e *ResponseError) Unwrap() error {
+	return e.classified
+}
+
+// CheckResponse converts a non-2xx HTTP response into a *ResponseError. It returns nil for a nil
+// response (the caller reports the transport error instead) and for any 2xx status.
+func CheckResponse(r *http.Response) error {
+	if r == nil {
+		return nil
+	}
+	if r.StatusCode >= 200 && r.StatusCode <= 299 {
+		return nil
+	}
+	var body []byte
+	if r.Body != nil {
+		body, _ = io.ReadAll(r.Body)
+	}
+	trimmed := strings.TrimSpace(string(body))
+	return &ResponseError{
+		StatusCode: r.StatusCode,
+		Body:       trimmed,
+		classified: httperr.ClassifyStatus(r.StatusCode),
+	}
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..b236537aa
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,110 @@
+package provisioning
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient is a small retrying JSON-over-HTTP client for the k6 Cloud endpoints that are not
+// covered by the generated cloud SDK: the metrics ingest endpoint and presigned archive uploads.
+type HTTPClient struct {
+	client  *http.Client
+	token   string
+	version string
+	logger  logrus.FieldLogger
+}
+
+// NewHTTPClient returns an HTTPClient authenticating with the given test-run scoped token.
+// An empty token means no Authorization header is sent, which is what presigned upload URLs require.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	if client == nil {
+		client = http.DefaultClient
+	}
+	return &HTTPClient{
+		client:  client,
+		token:   token,
+		version: version,
+		logger:  logger,
+	}
+}
+
+// Do sends req, retrying on transport errors, HTTP 5xx and HTTP 429. When v is non-nil and the
+// response carries a body, the body is JSON-decoded into v.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	if req.Header == nil {
+		req.Header = make(http.Header)
+	}
+	if c.token != "" {
+		req.Header.Set("Authorization", "Bearer "+c.token)
+	}
+	req.Header.Set("User-Agent", "k6cloud/"+c.version)
+
+	for attempt := 0; attempt <= clientcfg.MaxRetries; attempt++ {
+		if attempt > 0 && req.GetBody != nil {
+			body, err := req.GetBody()
+			if err != nil {
+				return err
+			}
+			req.Body = body
+		}
+
+		resp, err := c.client.Do(req)
+		retryable := err != nil || (resp != nil && (resp.StatusCode >= 500 || resp.StatusCode == http.StatusTooManyRequests))
+
+		if !retryable {
+			if cerr := CheckResponse(resp); cerr != nil {
+				drainAndClose(resp.Body)
+				return cerr
+			}
+			if v != nil && resp.Body != nil {
+				if err := json.NewDecoder(resp.Body).Decode(v); err != nil && !errors.Is(err, io.EOF) {
+					drainAndClose(resp.Body)
+					return err
+				}
+			}
+			drainAndClose(resp.Body)
+			return nil
+		}
+
+		if attempt == clientcfg.MaxRetries || req.Context().Err() != nil {
+			if err != nil {
+				if resp != nil {
+					drainAndClose(resp.Body)
+				}
+				return err
+			}
+			cerr := CheckResponse(resp)
+			drainAndClose(resp.Body)
+			return cerr
+		}
+
+		if resp != nil {
+			drainAndClose(resp.Body)
+		}
+		if c.logger != nil {
+			c.logger.Debug("retrying request")
+		}
+		select {
+		case <-time.After(clientcfg.RetryInterval):
+		case <-req.Context().Done():
+			return req.Context().Err()
+		}
+	}
+
+	return nil
+}
+
+func drainAndClose(body io.ReadCloser) {
+	if body == nil {
+		return
+	}
+	_, _ = io.Copy(io.Discard, body)
+	_ = body.Close()
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..25778dfde
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,65 @@
+package provisioning
+
+import (
+	"errors"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+const (
+	// Unknown error.
+	notifyCodeUnknown int32 = 0
+	// Timeout or output failure.
+	notifyCodeTimeoutOrOutput int32 = 8034
+	// Script error.
+	notifyCodeScriptError int32 = 8035
+	// Aborted by user or script abort.
+	notifyCodeAborted int32 = 8036
+)
+
+// notifyError is the error payload reported to the provisioning API at the end of a script execution.
+type notifyError struct {
+	Code   int32
+	Reason string
+}
+
+// mapTestErrorToNotifyCode maps how k6 stopped onto the cloud notification error codes.
+// It returns nil when the test run completed normally from the cloud point of view.
+func mapTestErrorToNotifyCode(err error) *notifyError {
+	if err == nil {
+		return nil
+	}
+
+	var hasReason errext.HasAbortReason
+	if !errors.As(err, &hasReason) {
+		return &notifyError{
+			Code:   notifyCodeUnknown,
+			Reason: err.Error(),
+		}
+	}
+
+	switch hasReason.AbortReason() {
+	case errext.AbortedByThresholdsAfterTestEnd:
+		return nil
+	case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+		return &notifyError{
+			Code:   notifyCodeAborted,
+			Reason: err.Error(),
+		}
+	case errext.AbortedByScriptError:
+		return &notifyError{
+			Code:   notifyCodeScriptError,
+			Reason: err.Error(),
+		}
+	case errext.AbortedByOutput, errext.AbortedByTimeout:
+		return &notifyError{
+			Code:   notifyCodeTimeoutOrOutput,
+			Reason: err.Error(),
+		}
+	default:
+		return &notifyError{
+			Code:   notifyCodeUnknown,
+			Reason: err.Error(),
+		}
+	}
+}
