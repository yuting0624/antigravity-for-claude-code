+// CreateOrFindLoadTest ensures a load test with the given name exists in the project and returns
+// its id. The script is not uploaded: local execution uploads the archive later through a
+// presigned URL. On HTTP 409, meaning a test with that name already exists, it looks the existing
+// test up by exact-match name.
+func (c *Client) CreateOrFindLoadTest(ctx context.Context, projectID int64, name string) (int64, error) {
+	lt, err := c.createTestWithoutScript(ctx, name, projectID)
+	if err == nil {
+		return lt.GetId(), nil
+	}
+	var rerr ResponseError
+	if !errors.As(err, &rerr) || rerr.Response == nil || rerr.Response.StatusCode != http.StatusConflict {
+		return 0, err
+	}
+
+	lt, err = c.findTestByName(ctx, projectID, name)
+	if err != nil {
+		return 0, err
+	}
+
+	return lt.GetId(), nil
+}
