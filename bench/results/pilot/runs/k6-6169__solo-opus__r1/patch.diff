+// parseRuntimeDuration parses an optional duration coming from the cloud's
+// runtime configuration, reporting whether a usable value was found.
+func parseRuntimeDuration(logger logrus.FieldLogger, field string, value *string) (time.Duration, bool) {
+	if value == nil {
+		return 0, false
+	}
+
+	d, err := types.ParseExtendedDuration(*value)
