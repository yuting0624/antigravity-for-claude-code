diff --git a/internal/cloudapi/clientcfg/clientcfg.go b/internal/cloudapi/clientcfg/clientcfg.go
new file mode 100644
index 000000000..2389f8df2
--- /dev/null
+++ b/internal/cloudapi/clientcfg/clientcfg.go
@@ -0,0 +1,15 @@
+// Package clientcfg holds the HTTP retry settings shared by k6 Cloud's API
+// clients (internal/cloudapi/v6, internal/cloudapi/provisioning), so that a
+// change to the retry policy applies to every one of them at once.
+package clientcfg
+
+import "time"
+
+const (
+	// RetryInterval is the wait between two attempts of the same request.
+	RetryInterval = 500 * time.Millisecond
+
+	// MaxRetries is how many times a request is retried after its first
+	// attempt failed with a retriable error.
+	MaxRetries = 3
+)
diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..e4e474841
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,231 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// archiveContentType is the content type of a k6 test archive, as expected by
+// the presigned upload URL.
+const archiveContentType = "application/x-tar"
+
+// StartLocalExecutionRequest describes a local execution start request.
+type StartLocalExecutionRequest struct {
+	// Options holds the resolved k6 script options, as JSON.
+	Options json.RawMessage
+
+	// MaxVUs is the maximum number of VUs the test can reach.
+	MaxVUs int64
+
+	// TotalDuration is the total test duration, in seconds.
+	TotalDuration int64
+
+	// ArchiveSize is the size of the test archive in bytes. Zero means no
+	// archive is going to be uploaded and is sent as an explicit null.
+	ArchiveSize int64
+}
+
+// StartLocalExecutionResult holds everything the cloud hands back to a
+// locally executed test run.
+type StartLocalExecutionResult struct {
+	// TestRunID is the id of the test run that has just been created.
+	TestRunID int64
+
+	// ArchiveUploadURL is the presigned URL the test archive must be PUT to.
+	// It is nil when the cloud does not expect an archive.
+	ArchiveUploadURL *string
+
+	// TestRunDetailsPageURL links to the test run page in Grafana.
+	TestRunDetailsPageURL string
+
+	// RuntimeConfig configures the run's cloud-facing components.
+	RuntimeConfig RuntimeConfig
+}
+
+// RuntimeConfig is the cloud-provided configuration of a test run.
+type RuntimeConfig struct {
+	// Metrics configures how the run pushes its metrics.
+	Metrics MetricsConfig
+
+	// TestRunToken is a token scoped to this test run. It authenticates the
+	// metrics pushes, the secret lookups and the end-of-test notification.
+	TestRunToken string
+
+	// Secrets locates the test run's secrets endpoint.
+	Secrets SecretsConfig
+}
+
+// MetricsConfig is the metrics section of a [RuntimeConfig]. Every field but
+// the push URL is optional: a nil value means "keep the k6 default".
+type MetricsConfig struct {
+	PushURL               string
+	PushInterval          *string
+	PushConcurrency       *int32
+	AggregationPeriod     *string
+	AggregationWaitPeriod *string
+	AggregationMinSamples *int32
+	MaxSamplesPerPackage  *int32
+}
+
+// SecretsConfig is the secrets section of a [RuntimeConfig].
+type SecretsConfig struct {
+	Endpoint     string
+	ResponsePath string
+}
+
+// StartLocalExecution starts a local execution run of the given load test.
+func (c *Client) StartLocalExecution(
+	ctx context.Context, loadTestID int64, req StartLocalExecutionRequest,
+) (_ *StartLocalExecutionResult, err error) {
+	options := map[string]any{}
+	if len(req.Options) > 0 {
+		if err := json.Unmarshal(req.Options, &options); err != nil {
+			return nil, fmt.Errorf("could not encode the test options: %w", err)
+		}
+	}
+
+	body := k6cloud.NewStartLocalExecutionTestRequest(
+		options, int32Of(req.MaxVUs), int32Of(req.TotalDuration))
+	if req.ArchiveSize > 0 {
+		body.SetArchiveSize(int32Of(req.ArchiveSize))
+	} else {
+		// An explicit null tells the backend not to expect an archive.
+		body.SetArchiveSizeNil()
+	}
+
+	key, err := idempotencyKey()
+	if err != nil {
+		return nil, err
+	}
+
+	res, hr, err := c.apiClient.ProvisioningAPI.
+		StartLocalExecutionTest(c.authCtx(ctx), loadTestID).
+		StartLocalExecutionTestRequest(body).
+		K6IdempotencyKey(key).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if err := checkAPIResponse(hr, err); err != nil {
+		return nil, err
+	}
+	if res == nil {
+		return nil, errUnknown
+	}
+
+	return &StartLocalExecutionResult{
+		TestRunID:             res.GetTestRunId(),
+		ArchiveUploadURL:      res.ArchiveUploadUrl.Get(),
+		TestRunDetailsPageURL: res.GetTestRunDetailsPageUrl(),
+		RuntimeConfig:         newRuntimeConfig(res.GetRuntimeConfig()),
+	}, nil
+}
+
+// UploadArchive uploads the test archive to a presigned URL.
+func (c *Client) UploadArchive(ctx context.Context, uploadURL string, archive []byte) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPut, uploadURL, bytes.NewReader(archive))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", archiveContentType)
+
+	return c.uploadClient.Do(req, nil)
+}
+
+// WaitForTestRunReady polls the test run until the cloud reports it ready for
+// the local execution to begin, logging every status transition on the way.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	var lastStatus v6.Status
+
+	for {
+		progress, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			return err
+		}
+
+		ready, err := testRunReady(progress)
+		if err != nil {
+			return err
+		}
+		if ready {
+			return nil
+		}
+
+		if progress.Status != lastStatus {
+			lastStatus = progress.Status
+			c.logger.WithField("status", progress.FormatStatus()).
+				Info("Waiting for the cloud test run to be ready...")
+		}
+
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(pollInterval):
+		}
+	}
+}
+
+// testRunReady reports whether the run has reached a status from which local
+// execution can start, and errors out on the statuses it can never leave.
+func testRunReady(progress *v6.TestProgress) (bool, error) {
+	switch progress.Status {
+	case v6.StatusInitializing, v6.StatusRunning:
+		return true, nil
+	case v6.StatusAborted:
+		msg := "test run aborted before starting"
+		for _, e := range progress.StatusHistory {
+			if e.Status == v6.StatusAborted && e.Message != "" {
+				return false, fmt.Errorf("%s: %s", msg, e.Message)
+			}
+		}
+		return false, errors.New(msg)
+	case v6.StatusCompleted, v6.StatusProcessingMetrics:
+		return false, fmt.Errorf("test run unexpectedly %s before starting", progress.Status)
+	default:
+		// Anything else, including a status this k6 version does not know
+		// about yet, is treated as "not ready yet".
+		return false, nil
+	}
+}
+
+func newRuntimeConfig(rc k6cloud.RuntimeConfig) RuntimeConfig {
+	metrics := rc.GetMetrics()
+	secrets := rc.GetSecrets()
+
+	return RuntimeConfig{
+		Metrics: MetricsConfig{
+			PushURL:               metrics.GetPushUrl(),
+			PushInterval:          metrics.PushInterval.Get(),
+			PushConcurrency:       metrics.PushConcurrency.Get(),
+			AggregationPeriod:     metrics.AggregationPeriod.Get(),
+			AggregationWaitPeriod: metrics.AggregationWaitPeriod.Get(),
+			AggregationMinSamples: metrics.AggregationMinSamples.Get(),
+			MaxSamplesPerPackage:  metrics.MaxSamplesPerPackage.Get(),
+		},
+		TestRunToken: rc.GetTestRunToken(),
+		Secrets: SecretsConfig{
+			Endpoint:     secrets.GetEndpoint(),
+			ResponsePath: secrets.GetResponsePath(),
+		},
+	}
+}
+
+// idempotencyKey returns a random key letting the backend deduplicate the
+// retries of a start request.
+func idempotencyKey() (string, error) {
+	var key [8]byte
+	if _, err := rand.Read(key[:]); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(key[:]), nil
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..01943d8cc
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,107 @@
+package provisioning
+
+import (
+	"context"
+	"io"
+	"math"
+	"net/http"
+	"strconv"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client talks to the Grafana Cloud k6 provisioning API.
+//
+// It wraps three transports: the generated cloud SDK for the provisioning
+// endpoints, a v6 client for the load test and test run resources those
+// endpoints refer to, and a plain [HTTPClient] for the presigned archive
+// upload, which is not a k6 Cloud endpoint at all.
+type Client struct {
+	apiClient    *k6cloud.APIClient
+	v6Client     *v6.Client
+	uploadClient *HTTPClient
+
+	token   string
+	stackID int64
+
+	logger logrus.FieldLogger
+}
+
+// NewClient returns a new provisioning API client for the given stack.
+func NewClient(
+	logger logrus.FieldLogger, token, host, version string, stackID int64, timeout time.Duration,
+) (*Client, error) {
+	v6Client, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if err := v6Client.SetStackID(stackID); err != nil {
+		return nil, err
+	}
+
+	httpClient := &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Global k6 Cloud API.",
+		},
+	}
+	cfg.HTTPClient = httpClient
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+	// The provisioning endpoints are stack-scoped but the generated SDK does
+	// not expose the header as a parameter, so it is sent with every request.
+	if stackID != 0 {
+		cfg.AddDefaultHeader("X-Stack-Id", strconv.FormatInt(stackID, 10))
+	}
+
+	return &Client{
+		apiClient: k6cloud.NewAPIClient(cfg),
+		v6Client:  v6Client,
+		// Presigned URLs authenticate through their query string and reject
+		// requests carrying an Authorization header, hence the empty token.
+		uploadClient: NewHTTPClient(httpClient, "", version, logger),
+		token:        token,
+		stackID:      stackID,
+		logger:       logger,
+	}, nil
+}
+
+// authCtx returns a context carrying the client's long-lived token.
+func (c *Client) authCtx(ctx context.Context) context.Context {
+	return context.WithValue(ctx, k6cloud.ContextAccessToken, c.token)
+}
+
+func closeResponse(res *http.Response, rerr *error) {
+	if res == nil {
+		return
+	}
+	_, _ = io.Copy(io.Discard, res.Body)
+	if err := res.Body.Close(); err != nil && *rerr == nil {
+		*rerr = err
+	}
+}
+
+// int32Of narrows v to int32, saturating instead of wrapping around, so an
+// absurd VU count or duration cannot turn into a negative one on the wire.
+func int32Of(v int64) int32 {
+	switch {
+	case v > math.MaxInt32:
+		return math.MaxInt32
+	case v < math.MinInt32:
+		return math.MinInt32
+	default:
+		return int32(v)
+	}
+}
