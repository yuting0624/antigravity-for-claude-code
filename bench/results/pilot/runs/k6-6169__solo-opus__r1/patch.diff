+// buildConfigFromRuntimeConfig translates the runtime configuration the cloud
+// handed back at provisioning time into the cloud output's own configuration.
+//
+// Unparseable values are skipped with a warning rather than failing the run:
+// the affected knob keeps its k6 default, which is always a workable value.
+func buildConfigFromRuntimeConfig(
+	logger logrus.FieldLogger, runtimeConfig provisioning.RuntimeConfig,
+) cloudapi.Config {
+	var conf cloudapi.Config
+
+	metrics := runtimeConfig.Metrics
+	if metrics.PushURL != "" {
+		conf.MetricsPushURL = null.StringFrom(metrics.PushURL)
+	}
+	if runtimeConfig.TestRunToken != "" {
+		conf.TestRunToken = null.StringFrom(runtimeConfig.TestRunToken)
+	}
+	if d, ok := parseRuntimeDuration(logger, "push_interval", metrics.PushInterval); ok {
+		conf.MetricPushInterval = types.NewNullDuration(d, true)
+	}
+	if metrics.PushConcurrency != nil {
+		conf.MetricPushConcurrency = null.IntFrom(int64(*metrics.PushConcurrency))
+	}
+	if d, ok := parseRuntimeDuration(logger, "aggregation_period", metrics.AggregationPeriod); ok {
+		conf.AggregationPeriod = types.NewNullDuration(d, true)
+	}
+	if d, ok := parseRuntimeDuration(logger, "aggregation_wait_period", metrics.AggregationWaitPeriod); ok {
+		conf.AggregationWaitPeriod = types.NewNullDuration(d, true)
+	}
+	if metrics.MaxSamplesPerPackage != nil {
+		conf.MaxTimeSeriesInBatch = null.IntFrom(int64(*metrics.MaxSamplesPerPackage))
+	}
+	// aggregation_min_samples is intentionally dropped: the cloud output has
+	// no minimum-sample threshold to map it onto.
+
+	return conf
