+++ b/internal/cloudapi/provisioning/doc.go
@@ -0,0 +1,12 @@
+// Package provisioning talks to the Grafana Cloud k6 provisioning API, the
+// service that hands a locally executed test run everything it needs to
+// report back to the cloud: a test run id, an optional presigned URL for the
+// test archive, and a runtime configuration holding the metrics push URL, a
+// test-run-scoped token and the secrets endpoint.
+//
+// [Client.ProvisionLocalExecution] composes the whole handshake - create or
+// find the load test through the v6 API, start the local execution, upload
+// the archive and wait until the run is ready - and is the only entry point
+// the command layer needs. [Client.NotifyTestRunCompleted] closes the loop
+// once the local run is over.
+package provisioning
diff --git a/internal/cloudapi/provisioning/errors.go b/internal/cloudapi/provisioning/errors.go
new file mode 100644
index 000000000..2ceef84fe
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,66 @@
+package provisioning
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+var errUnknown = errors.New("an error occurred communicating with k6 Cloud")
+
+// ResponseError is returned for every non-2xx HTTP response, both from the
+// provisioning API and from the presigned archive upload URL. The latter is
+// not a k6 Cloud endpoint and answers with plain text, so the raw body is
+// kept as-is instead of being decoded into an API error model.
+type ResponseError struct {
+	StatusCode int
+	Body       string
+}
+
+func (e *ResponseError) Error() string {
+	return fmt.Sprintf("unexpected HTTP %d response from k6 Cloud: %s", e.StatusCode, e.Body)
+}
+
+// Unwrap classifies 401 and 403 the same way the v6 client does, so callers
+// can match [httperr.ErrNotAuthenticated] and [httperr.ErrNotAuthorized].
+func (e *ResponseError) Unwrap() error {
+	return httperr.ClassifyStatus(e.StatusCode)
+}
+
+// CheckResponse returns nil when r reports success, and a [ResponseError]
+// otherwise. It consumes r.Body.
+func CheckResponse(r *http.Response) error {
+	if r == nil {
+		return errUnknown
+	}
+
+	if c := r.StatusCode; c >= 200 && c <= 299 {
+		return nil
+	}
+
+	body, err := io.ReadAll(r.Body)
+	if err != nil {
+		return err
+	}
+
+	return &ResponseError{StatusCode: r.StatusCode, Body: string(body)}
+}
+
+// checkAPIResponse turns the (response, error) pair returned by the generated
+// cloud SDK into a [ResponseError]. Errors that aren't HTTP status errors,
+// such as a connection failure, are returned untouched.
+func checkAPIResponse(r *http.Response, err error) error {
+	if err != nil {
+		var aerr *k6cloud.GenericOpenAPIError
+		if !errors.As(err, &aerr) {
+			return err
+		}
+	}
+
+	return CheckResponse(r)
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..6c2fc0d0f
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,110 @@
+package provisioning
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient performs the requests that the generated cloud SDK does not
+// cover: the presigned archive upload and, once a local run is provisioned,
+// the metrics pushes authenticated with the test-run-scoped token.
+//
+// An empty token leaves the Authorization header out entirely, which is what
+// presigned URLs require: they carry their own credentials in the query
+// string and reject requests that also send an Authorization header.
+type HTTPClient struct {
+	client  *http.Client
+	token   string
+	version string
+	logger  logrus.FieldLogger
+}
+
+// NewHTTPClient returns an HTTPClient sending requests through client.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	return &HTTPClient{
+		client:  client,
+		token:   token,
+		version: version,
+		logger:  logger,
+	}
+}
+
+// Do sends req, retrying it on connection errors and server-side failures,
+// and decodes a successful JSON response into v. A nil v discards the body.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	if c.token != "" {
+		req.Header.Set("Authorization", "Bearer "+c.token)
+	}
+	req.Header.Set("User-Agent", "k6cloud/"+c.version)
+
+	resp, err := c.do(req)
+	if err != nil {
+		return err
+	}
+	defer func() {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+	}()
+
+	if err := CheckResponse(resp); err != nil {
+		return err
+	}
+	if v == nil {
+		return nil
+	}
+
+	return json.NewDecoder(resp.Body).Decode(v)
+}
+
+func (c *HTTPClient) do(req *http.Request) (*http.Response, error) {
+	var (
+		resp *http.Response
+		err  error
+	)
+
+	for attempt := 0; ; attempt++ {
+		// http.Client.Do consumes the request body, so it has to be rewound
+		// before every retry. GetBody is non-nil only for rewindable bodies.
+		if attempt > 0 && req.GetBody != nil {
+			body, berr := req.GetBody()
+			if berr != nil {
+				return nil, berr
+			}
+			req.Body = body
+		}
+
+		resp, err = c.client.Do(req) //nolint:bodyclose // closed by the caller, or below before retrying
+		if !retriable(resp, err) || attempt >= clientcfg.MaxRetries {
+			if err != nil {
+				return nil, err
+			}
+			return resp, nil
+		}
+
+		if resp != nil {
+			_, _ = io.Copy(io.Discard, resp.Body)
+			_ = resp.Body.Close()
+		}
+		c.logger.WithError(err).Debugf("Request to %s failed, retrying (%d/%d)",
+			req.URL, attempt+1, clientcfg.MaxRetries)
+
+		select {
+		case <-req.Context().Done():
+			return nil, req.Context().Err()
+		case <-time.After(clientcfg.RetryInterval):
+		}
+	}
+}
+
+func retriable(resp *http.Response, err error) bool {
+	if err != nil || resp == nil {
+		return true
+	}
+	return resp.StatusCode >= http.StatusInternalServerError || resp.StatusCode == http.StatusTooManyRequests
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..acfc5e54a
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,84 @@
+package provisioning
+
+import (
+	"context"
+	"errors"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+// scriptExecutionCompleted is the only lifecycle event a locally executed
+// test run reports.
+const scriptExecutionCompleted = "script_execution_completed"
+
+// Error codes the cloud uses to describe how a local run ended.
+const (
+	// errCodeTimeout covers the runs k6 could not finish on its own, either
+	// because it ran out of time or because an output gave up.
+	errCodeTimeout int32 = 8034
+
+	// errCodeScriptError is a failure raised by the script itself.
+	errCodeScriptError int32 = 8035
+
+	// errCodeAborted is a deliberate stop, by the user or by the script.
+	errCodeAborted int32 = 8036
+)
+
+// notifyError is the error payload of a lifecycle notification.
+type notifyError struct {
+	Code   int32
+	Reason string
+}
+
+// NotifyTestRunCompleted tells the cloud that the local script execution is
+// over. The request is authenticated with the test-run-scoped token handed
+// out at provisioning time, not with the user's long-lived one.
+func (c *Client) NotifyTestRunCompleted(
+	ctx context.Context, testRunID int64, token string, testErr error,
+) (err error) {
+	model := k6cloud.NewScriptExecutionCompletedNotificationApiModel(scriptExecutionCompleted)
+	if nerr := mapTestErrorToNotifyCode(testErr); nerr != nil {
+		model.SetError(*k6cloud.NewScriptExecutionError(nerr.Code, nerr.Reason))
+	}
+
+	hr, err := c.apiClient.ProvisioningAPI.
+		TestRunsNotify(context.WithValue(ctx, k6cloud.ContextAccessToken, token), testRunID).
+		ScriptExecutionCompletedNotificationApiModel(model).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	return checkAPIResponse(hr, err)
+}
+
+// mapTestErrorToNotifyCode translates the way k6 stopped into the error the
+// cloud expects. It returns nil when the run is to be reported as clean,
+// which includes thresholds that only failed after the test had ended: the
+// run itself completed normally, so the cloud learns about those failures
+// through the threshold results instead.
+func mapTestErrorToNotifyCode(testErr error) *notifyError {
+	if testErr == nil {
+		return nil
+	}
+
+	var withReason errext.HasAbortReason
+	if !errors.As(testErr, &withReason) {
+		// An error k6 could not classify: report it without a code.
+		return &notifyError{Reason: testErr.Error()}
+	}
+
+	var code int32
+	switch withReason.AbortReason() {
+	case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+		code = errCodeAborted
+	case errext.AbortedByScriptError:
+		code = errCodeScriptError
+	case errext.AbortedByTimeout, errext.AbortedByOutput:
+		code = errCodeTimeout
+	case errext.AbortedByThresholdsAfterTestEnd:
+		return nil
+	}
+
+	return &notifyError{Code: code, Reason: testErr.Error()}
+}
diff --git a/internal/cloudapi/provisioning/provision.go b/internal/cloudapi/provisioning/provision.go
new file mode 100644
index 000000000..d25c3e83b
--- /dev/null
+++ b/internal/cloudapi/provisioning/provision.go
@@ -0,0 +1,115 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"go.k6.io/k6/v2/lib"
+)
+
+// defaultPollInterval is how often the test run is polled while waiting for
+// the cloud to make it ready.
+const defaultPollInterval = time.Second
+
+// ProvisionParams describes the test run to provision.
+type ProvisionParams struct {
+	// Name is the load test name. A test with that name is created in the
+	// project, or reused when it already exists.
+	Name string
+
+	// ProjectID is the project the load test belongs to.
+	ProjectID int64
+
+	// MaxVUs is the maximum number of VUs the test can reach.
+	MaxVUs int64
+
+	// TotalDuration is the total test duration, in seconds.
+	TotalDuration int64
+
+	// Options holds the resolved k6 script options, as JSON.
+	Options json.RawMessage
+
+	// Archive is the test archive to upload. A nil archive skips the upload
+	// altogether, as does a cloud that returns no upload URL.
+	Archive *lib.Archive
+
+	// PollInterval is how often the test run is polled while waiting for it
+	// to be ready. Defaults to [defaultPollInterval].
+	PollInterval time.Duration
+}
+
+// ProvisionResult is what a provisioned local test run needs to report back
+// to the cloud.
+type ProvisionResult struct {
+	// LoadTestID is the id of the load test the run belongs to.
+	LoadTestID int64
+
+	// TestRunID is the id of the test run.
+	TestRunID int64
+
+	// TestRunDetailsPageURL links to the test run page in Grafana.
+	TestRunDetailsPageURL string
+
+	// RuntimeConfig configures the run's cloud-facing components.
+	RuntimeConfig RuntimeConfig
+}
+
+// ProvisionLocalExecution prepares a local test run in the cloud: it makes
+// sure the load test exists, starts a local execution run for it, uploads the
+// test archive when there is one, and waits until the run is ready to start.
+func (c *Client) ProvisionLocalExecution(ctx context.Context, p ProvisionParams) (*ProvisionResult, error) {
+	loadTestID, err := c.v6Client.CreateOrFindLoadTest(ctx, p.ProjectID, p.Name)
+	if err != nil {
+		return nil, fmt.Errorf("create or find load test: %w", err)
+	}
+
+	// The archive has to be serialized upfront: the cloud wants its size in
+	// the start request, before handing out the URL to upload it to.
+	var archive []byte
+	if p.Archive != nil {
+		var buf bytes.Buffer
+		if err := p.Archive.Write(&buf); err != nil {
+			return nil, fmt.Errorf("serialize test archive: %w", err)
+		}
+		archive = buf.Bytes()
+	}
+
+	start, err := c.StartLocalExecution(ctx, loadTestID, StartLocalExecutionRequest{
+		Options:       p.Options,
+		MaxVUs:        p.MaxVUs,
+		TotalDuration: p.TotalDuration,
+		ArchiveSize:   int64(len(archive)),
+	})
+	if err != nil {
+		return nil, fmt.Errorf("start local execution: %w", err)
+	}
+
+	if len(archive) > 0 {
+		switch {
+		case start.ArchiveUploadURL == nil || *start.ArchiveUploadURL == "":
+			c.logger.Warn("k6 Cloud did not return an archive upload URL, skipping the test archive upload")
+		default:
+			if err := c.UploadArchive(ctx, *start.ArchiveUploadURL, archive); err != nil {
+				return nil, fmt.Errorf("upload archive: %w", err)
+			}
+		}
+	}
+
+	pollInterval := p.PollInterval
+	if pollInterval <= 0 {
+		pollInterval = defaultPollInterval
+	}
+	if err := c.WaitForTestRunReady(ctx, start.TestRunID, pollInterval); err != nil {
+		return nil, fmt.Errorf("wait for test run ready: %w", err)
+	}
+
+	return &ProvisionResult{
+		LoadTestID:            loadTestID,
+		TestRunID:             start.TestRunID,
+		TestRunDetailsPageURL: start.TestRunDetailsPageURL,
+		RuntimeConfig:         start.RuntimeConfig,
+	}, nil
+}
diff --git a/internal/cloudapi/provisioning/test/server.go b/internal/cloudapi/provisioning/test/server.go
new file mode 100644
index 000000000..f677ad9db
--- /dev/null
+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,179 @@
+// Package provtest provides an HTTP test server that simulates the parts of
+// the k6 Cloud API a locally executed test run talks to: the provisioning
+// endpoints, the v6 resources they refer to, and the presigned URL the test
+// archive is uploaded to.
+//
+// It keeps the SDK-specific encoding (nullable fields, runtime config models)
+// out of the test files. Tests register the handlers they care about and
+// speak in domain terms; this server translates to the wire format.
+package provtest
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	// DefaultLoadTestID is the load test id the server's routes are built
+	// around unless a test asks for another one.
+	DefaultLoadTestID int64 = 456
+
+	// DefaultTestRunID is the test run id reported by
+	// [DefaultStartLocalExecutionResponse].
+	DefaultTestRunID int64 = 123
+
+	// PresignedUploadPath is the path of the stubbed presigned archive
+	// upload URL, standing in for the object storage k6 Cloud uses.
+	PresignedUploadPath = "/presigned/archive-upload"
+)
+
+// Server is a test HTTP server for the provisioning API.
+type Server struct {
+	*httptest.Server
+
+	// Mux routes the requests. It is exported so tests can register extra
+	// routes, such as a catch-all for the metrics pushes.
+	Mux *http.ServeMux
+
+	fetchTestRunHits atomic.Int32
+}
+
+// NewServer starts a test server with no route registered. Use the Handle*
+// methods to add the endpoints the test under scrutiny needs.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+
+	mux := http.NewServeMux()
+	srv := httptest.NewServer(mux)
+	t.Cleanup(srv.Close)
+
+	return &Server{Server: srv, Mux: mux}
+}
+
+// PresignedUploadURL returns the absolute URL of the stubbed presigned
+// archive upload endpoint.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// HandleCreateLoadTest registers the v6 create-or-find load test endpoint of
+// the given project. The handler sees both the POST that creates the test and
+// the GET that looks it up after a conflict.
+func (s *Server) HandleCreateLoadTest(projectID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID), h)
+}
+
+// HandleStartLocalExecution registers the start-local-execution endpoint of
+// the given load test.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/load_tests/%d/start_local_execution", loadTestID), h)
+}
+
+// HandlePresignedUpload registers the stubbed presigned archive upload
+// endpoint at the given path.
+func (s *Server) HandlePresignedUpload(path string, h http.HandlerFunc) {
+	s.Mux.HandleFunc(path, h)
+}
+
+// HandleNotify registers the end-of-test notification endpoint of the given
+// test run.
+func (s *Server) HandleNotify(testRunID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/test_runs/%d/notify", testRunID), h)
+}
+
+// HandleFetchTestRun registers the v6 test run endpoint, serving one entry of
+// progress per call and repeating the last one once they run out.
+func (s *Server) HandleFetchTestRun(testRunID int64, progress []v6.TestProgress) {
+	s.Mux.HandleFunc(fmt.Sprintf("GET /cloud/v6/test_runs/%d", testRunID), func(w http.ResponseWriter, _ *http.Request) {
+		if len(progress) == 0 {
+			http.Error(w, "no test run progress configured", http.StatusInternalServerError)
+			return
+		}
+
+		i := int(s.fetchTestRunHits.Add(1)) - 1
+		if i >= len(progress) {
+			i = len(progress) - 1
+		}
+		writeTestRun(w, progress[i])
+	})
+}
+
+// FetchTestRunHitCount returns how many times the test run endpoint was hit.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchTestRunHits.Load()
+}
+
+// DefaultStartLocalExecutionResponse returns a fully populated
+// start-local-execution response. Tests override the fields they assert on.
+func DefaultStartLocalExecutionResponse() *k6cloud.StartLocalExecutionTestResponse {
+	var (
+		pushInterval          = "2s"
+		pushConcurrency       = int32(5)
+		aggregationPeriod     = "3s"
+		aggregationWaitPeriod = "1s"
+		aggregationMinSamples = int32(100)
+		maxSamplesPerPackage  = int32(2000)
+		archiveUploadURL      = "https://k6-cloud-archives.s3.amazonaws.com/" +
+			"archive.tar?X-Amz-Signature=fake"
+	)
+
+	metrics := k6cloud.NewMetricsRuntimeConfig(
+		"https://ingest.k6.io/v1/metrics",
+		*k6cloud.NewNullableString(&pushInterval),
+		*k6cloud.NewNullableInt32(&pushConcurrency),
+		*k6cloud.NewNullableString(&aggregationPeriod),
+		*k6cloud.NewNullableString(&aggregationWaitPeriod),
+		*k6cloud.NewNullableInt32(&aggregationMinSamples),
+		*k6cloud.NewNullableInt32(&maxSamplesPerPackage),
+	)
+	traces := k6cloud.NewTracesRuntimeConfig("https://ingest.k6.io/v1/traces", map[string]string{}, "grpc")
+	files := k6cloud.NewFilesRuntimeConfig("https://ingest.k6.io/v1/files", "screenshots", map[string]string{}, "PUT")
+	logs := k6cloud.NewLogsRuntimeConfig(
+		"https://ingest.k6.io/v1/logs",
+		"wss://cloudlogs.k6.io/api/v1/tail",
+		100, "3s", "info", 1000, []string{},
+	)
+	secrets := k6cloud.NewSecretsRuntimeConfig(
+		fmt.Sprintf("https://api.k6.io/provisioning/v1/test_runs/%d/decrypt_secret?name={key}", DefaultTestRunID),
+		"plaintext",
+	)
+
+	runtimeConfig := k6cloud.NewRuntimeConfig(
+		*metrics, *traces, *files, *logs, *secrets, "test-run-token-abc")
+
+	return k6cloud.NewStartLocalExecutionTestResponse(
+		DefaultTestRunID,
+		*runtimeConfig,
+		*k6cloud.NewNullableString(&archiveUploadURL),
+		fmt.Sprintf("https://app.k6.io/runs/%d", DefaultTestRunID),
+	)
+}
+
+// writeTestRun encodes a [v6.TestProgress] as a v6 test run response.
+func writeTestRun(w http.ResponseWriter, progress v6.TestProgress) {
+	res := k6cloud.NewTestRunApiModelWithDefaults()
+	res.SetStatus(progress.Status.String())
+	res.SetResult(progress.Result.String())
+	res.SetEstimatedDuration(progress.EstimatedDuration)
+	res.SetExecutionDuration(progress.ExecutionDuration)
+	res.SetStatusHistory(v6.ToStatusModel(progress.StatusHistory))
+	// The SDK decoder requires these keys on the other end even when empty.
+	res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+	res.SetResultDetails(
+		k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(k6cloud.NewResultDetailsApiModel("")))
+	res.SetOptions(map[string]any{})
+
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusOK)
+	if err := json.NewEncoder(w).Encode(res); err != nil {
+		panic(fmt.Errorf("provtest: encoding test run: %w", err))
+	}
+}
