+	if s.readIdleEnabled && s.ReadIdleTimeout == 0 {
+		s.ReadIdleTimeout = defaultReadIdleTimeout
+	}
+	if s.writeIdleEnabled && s.WriteIdleTimeout == 0 {
+		s.WriteIdleTimeout = defaultWriteIdleTimeout
+	}
