+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package caddyhttp
+
+import (
+	"bufio"
+	"errors"
+	"io"
+	"math"
+	"net"
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+)
+
+// DefaultMaxWriteChunk is the largest amount of data written to the
+// underlying connection between two deadline resets. Deadlines bound a
+// whole write call, not just a stall within it, so a huge single write
+// (or ReadFrom fast path) would otherwise have to fit in one deadline
+// window no matter how long it legitimately takes.
+const DefaultMaxWriteChunk = 64 * 1024
+
+// IdleDeadline computes the deadline to apply to a single read or write
+// of an HTTP request body or response. Unlike the hard read/write
+// timeouts of the HTTP server, which bound a whole transfer, this
+// deadline is recomputed before every read or write, so a transfer that
+// keeps making progress is never cut off for being slow in total; only
+// one that stalls (or, if MinRate is set, one that fails to sustain a
+// minimum rate) is.
+//
+// The zero value imposes no deadline at all.
+type IdleDeadline struct {
+	// Start is when the transfer began. It is the fixed point from
+	// which the MinRate allowance grows; it is unused if MinRate is 0.
+	Start time.Time
+
+	// Timeout is how long a single read or write may make no progress
+	// before the deadline trips. If MinRate is set, it doubles as the
+	// initial allowance granted before any bytes have been transferred.
+	// If zero or negative, no idle deadline is imposed (but MinRate and
+	// HardDeadline, if set, still are).
+	Timeout time.Duration
+
+	// HardDeadline, if not zero, is an absolute ceiling that the
+	// idle-reset deadline may never push past; it corresponds to a hard
+	// read or write timeout that bounds the transfer as a whole.
+	HardDeadline time.Time
+
+	// MinRate is the minimum transfer rate, in bytes per second, that
+	// the peer must sustain; 0 disables the rate floor. The allowance
+	// grows by one second for every MinRate bytes transferred, so a
+	// trickle that never stalls, but never reaches the rate either, is
+	// still cut off, while a transfer at or above the rate survives no
+	// matter how long it runs.
+	MinRate int64
+
+	// so that a rate floor still has a fixed origin if Start was not set
+	started time.Time
+}
+
+// Next returns the deadline to apply to the read or write about to be
+// performed at time now, given that transferred bytes have already been
+// transferred. A zero time means no deadline should be applied.
+func (d *IdleDeadline) Next(now time.Time, transferred int64) time.Time {
+	var deadline time.Time
+
+	// the deadline is reset on every read or write, so a connection
+	// that keeps making progress keeps earning a fresh window
+	if d.Timeout > 0 {
+		deadline = now.Add(d.Timeout)
+	}
+
+	// a rate floor grows its allowance from a fixed origin instead of
+	// from the last bit of progress, so trickling can't extend it forever
+	if d.MinRate > 0 {
+		if d.started.IsZero() {
+			d.started = d.Start
+			if d.started.IsZero() {
+				d.started = now
+			}
+		}
+		rateDeadline := d.started.Add(max(d.Timeout, 0)).Add(rateAllowance(transferred, d.MinRate))
+		if deadline.IsZero() || rateDeadline.Before(deadline) {
+			deadline = rateDeadline
+		}
+	}
+
+	// an idle reset must never push the deadline past a hard ceiling
+	if !d.HardDeadline.IsZero() && (deadline.IsZero() || d.HardDeadline.Before(deadline)) {
+		deadline = d.HardDeadline
+	}
+
+	return deadline
+}
+
+// rateAllowance is the extra time that transferring n bytes earns at
+// a floor of rate bytes per second.
+func rateAllowance(n, rate int64) time.Duration {
+	if n <= 0 || rate <= 0 {
+		return 0
+	}
+	seconds := float64(n) / float64(rate)
+	if seconds >= float64(math.MaxInt64)/float64(time.Second) {
+		return time.Duration(math.MaxInt64)
+	}
+	return time.Duration(seconds * float64(time.Second))
+}
+
+// IdleTimeoutReader wraps a request body so that the read deadline of
+// the connection is refreshed before every read, giving the client a
+// fresh window each time it makes progress. See IdleDeadline for the
+// exact semantics.
+type IdleTimeoutReader struct {
+	io.ReadCloser
+
+	// Ctrl is the response controller of the request being served; it
+	// is how the deadline reaches the connection, whatever the HTTP
+	// version. If nil, no deadlines are set.
+	Ctrl *http.ResponseController
+
+	// Deadline is how the deadline for each read is computed.
+	Deadline IdleDeadline
+
+	// Logger is used to report deadlines that could not be set.
+	Logger *zap.Logger
+
+	read        int64
+	cantSetting bool
+}
+
+func (itr *IdleTimeoutReader) Read(p []byte) (int, error) {
+	itr.refreshDeadline()
+	n, err := itr.ReadCloser.Read(p)
+	itr.read += int64(n)
+	return n, err
+}
+
+func (itr *IdleTimeoutReader) refreshDeadline() {
+	if itr.Ctrl == nil || itr.cantSetting {
+		return
+	}
+	deadline := itr.Deadline.Next(time.Now(), itr.read)
+	if deadline.IsZero() {
+		return
+	}
+	if err := itr.Ctrl.SetReadDeadline(deadline); err != nil {
+		itr.cantSetting = true
+		logDeadlineError(itr.Logger, "could not set read deadline", err)
+	}
+}
+
+// IdleTimeoutWriter wraps a response writer so that the write deadline
+// of the connection is refreshed before every write, giving a fresh
+// window each time the response makes progress. See IdleDeadline for
+// the exact semantics.
+//
+// Because a deadline bounds a whole write call, writes are broken into
+// chunks of at most MaxChunk bytes, with the deadline reset between
+// them.
+type IdleTimeoutWriter struct {
+	*ResponseWriterWrapper
+
+	// Ctrl is the response controller of the request being served; it
+	// is how the deadline reaches the connection, whatever the HTTP
+	// version. If nil, no deadlines are set.
+	Ctrl *http.ResponseController
+
+	// Deadline is how the deadline for each write is computed.
+	Deadline IdleDeadline
+
+	// MaxChunk is the maximum number of bytes written to the underlying
+	// writer between two deadline resets. If not positive,
+	// DefaultMaxWriteChunk is used.
+	MaxChunk int
+
+	// Logger is used to report deadlines that could not be set.
+	Logger *zap.Logger
+
+	written     int64
+	cantSetting bool
+}
+
+func (itw *IdleTimeoutWriter) Write(data []byte) (int, error) {
+	maxChunk := itw.maxChunk()
+	var written int
+	for {
+		chunk := data[written:]
+		if len(chunk) > maxChunk {
+			chunk = chunk[:maxChunk]
+		}
+		itw.refreshDeadline()
+		n, err := itw.ResponseWriterWrapper.Write(chunk)
+		written += n
+		itw.written += int64(n)
+		if err != nil {
+			return written, err
+		}
+		if n < len(chunk) {
+			return written, io.ErrShortWrite
+		}
+		if written >= len(data) {
+			return written, nil
+		}
+	}
+}
+
+// ReadFrom implements io.ReaderFrom, chunking the copy so that no
+// single write to the underlying writer has to complete within one
+// deadline window.
+func (itw *IdleTimeoutWriter) ReadFrom(r io.Reader) (int64, error) {
+	maxChunk := int64(itw.maxChunk())
+	limited := &io.LimitedReader{R: r}
+	var written int64
+	for {
+		limited.N = maxChunk
+		itw.refreshDeadline()
+		n, err := itw.ResponseWriterWrapper.ReadFrom(limited)
+		written += n
+		itw.written += n
+		if err != nil {
+			return written, err
+		}
+		if n < maxChunk {
+			// the source is exhausted, otherwise the limit
+			// would have been reached
+			return written, nil
+		}
+	}
+}
+
+// Hijack implements http.Hijacker. Deadlines set by this writer are
+// cleared first, since the connection is no longer ours to bound.
+func (itw *IdleTimeoutWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	//nolint:bodyclose
+	conn, brw, err := http.NewResponseController(itw.ResponseWriterWrapper).Hijack()
+	if err != nil {
+		return nil, nil, err
+	}
+	itw.cantSetting = true
+	_ = conn.SetDeadline(time.Time{})
+	return conn, brw, nil
+}
+
+func (itw *IdleTimeoutWriter) maxChunk() int {
+	if itw.MaxChunk > 0 {
+		return itw.MaxChunk
+	}
+	return DefaultMaxWriteChunk
+}
+
+func (itw *IdleTimeoutWriter) refreshDeadline() {
+	if itw.Ctrl == nil || itw.cantSetting {
+		return
+	}
+	deadline := itw.Deadline.Next(time.Now(), itw.written)
+	if deadline.IsZero() {
+		return
+	}
+	if err := itw.Ctrl.SetWriteDeadline(deadline); err != nil {
+		itw.cantSetting = true
+		logDeadlineError(itw.Logger, "could not set write deadline", err)
+	}
+}
+
+// logDeadlineError logs err, which prevented a deadline from being set.
+// Transports that don't support deadlines at all are only worth a debug
+// message; anything else is an error.
+func logDeadlineError(logger *zap.Logger, msg string, err error) {
+	if logger == nil {
+		return
+	}
+	level := zapcore.ErrorLevel
+	if errors.Is(err, http.ErrNotSupported) {
+		level = zapcore.DebugLevel
+	}
+	if c := logger.Check(level, msg); c != nil {
+		c.Write(zap.Error(err))
+	}
+}
+
+// wrapIdleDeadlines wraps the request body and/or the response writer
+// so that the server's idle read/write deadlines and minimum transfer
+// rates are enforced. The hard read/write timeouts, if any, are passed
+// along as ceilings that the idle resets may not exceed. It is a no-op
+// for the directions the server has not enabled.
+func (s *Server) wrapIdleDeadlines(w http.ResponseWriter, r *http.Request, start time.Time) (http.ResponseWriter, *http.Request) {
+	//nolint:bodyclose
+	ctrl := http.NewResponseController(w)
+
+	if s.readIdleEnabled && r.Body != nil {
+		deadline := IdleDeadline{
+			Start:   start,
+			Timeout: time.Duration(s.ReadIdleTimeout),
+			MinRate: s.ReadMinRate,
+		}
+		if s.ReadTimeout > 0 {
+			deadline.HardDeadline = start.Add(time.Duration(s.ReadTimeout))
+		}
+		r.Body = &IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       ctrl,
+			Deadline:   deadline,
+			Logger:     s.logger,
+		}
+	}
+
+	if s.writeIdleEnabled {
+		deadline := IdleDeadline{
+			Start:   start,
+			Timeout: time.Duration(s.WriteIdleTimeout),
+			MinRate: s.WriteMinRate,
+		}
+		if s.WriteTimeout > 0 {
+			deadline.HardDeadline = start.Add(time.Duration(s.WriteTimeout))
+		}
+		w = &IdleTimeoutWriter{
+			ResponseWriterWrapper: &ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  ctrl,
+			Deadline:              deadline,
+			MaxChunk:              s.MaxWriteChunk,
+			Logger:                s.logger,
+		}
+	}
+
+	return w, r
+}
+
+// Interface guards
+var (
+	_ io.ReadCloser       = (*IdleTimeoutReader)(nil)
+	_ http.ResponseWriter = (*IdleTimeoutWriter)(nil)
+	_ http.Hijacker       = (*IdleTimeoutWriter)(nil)
+	_ io.ReaderFrom       = (*IdleTimeoutWriter)(nil)
+)
