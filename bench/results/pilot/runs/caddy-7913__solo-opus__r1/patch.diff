+	// a negative value means "no idle deadline"; normalize it so the
+	// deadline computation doesn't have to special-case it
+	s.ReadIdleTimeout = max(s.ReadIdleTimeout, 0)
+	s.WriteIdleTimeout = max(s.WriteIdleTimeout, 0)
+}
