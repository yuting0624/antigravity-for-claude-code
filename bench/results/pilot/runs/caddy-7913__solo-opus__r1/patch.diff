+// provisionIdleDeadlines decides whether idle-based deadlines apply to
+// this server's reads and writes, and fills in the default idle
+// timeouts where they do. They are opt-in per direction: a server that
+// configures neither an idle timeout nor a minimum rate for a direction
+// behaves exactly as before. Configuring only a minimum rate (or only a
+// write chunk size) implies the default idle timeout for that
+// direction, and a negative idle timeout turns the idle deadline off
+// while leaving any minimum rate in effect.
+func (s *Server) provisionIdleDeadlines() {
+	s.readIdleEnabled = s.ReadIdleTimeout != 0 || s.ReadMinRate > 0
+	s.writeIdleEnabled = s.WriteIdleTimeout != 0 || s.WriteMinRate > 0 || s.MaxWriteChunk > 0
