+package timeouts
+
+import (
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func init() {
+	caddy.RegisterModule(Timeouts{})
+}
+
+// Timeouts applies idle-based read and write deadlines to the routes it
+// is part of, the same way the server-wide idle timeouts do, but scoped
+// to a single route: useful when one endpoint (a file upload, say) needs
+// a different tolerance for slow clients than the rest of the site.
+//
+// The deadline is reset every time the request body is read from or the
+// response is written to, so a transfer that keeps making progress is
+// never cut off for being slow overall; only one that stalls is. An
+// optional minimum transfer rate additionally cuts off a client that
+// keeps trickling bytes without ever stalling.
+type Timeouts struct {
+	// How long a read from the request body may make no progress
+	// before the request is aborted. Zero (default) means no
+	// idle-based read deadline.
+	ReadTimeout time.Duration `json:"read_timeout,omitempty"`
+
+	// The minimum rate, in bytes per second, at which the client must
+	// upload its request body. The allowance starts at ReadTimeout and
+	// grows by one second per ReadMinRate bytes read. Zero (default)
+	// disables the rate floor.
+	ReadMinRate int64 `json:"read_min_rate,omitempty"`
+
+	// How long a write of the response may make no progress before the
+	// response is aborted. Zero (default) means no idle-based write
+	// deadline.
+	WriteTimeout time.Duration `json:"write_timeout,omitempty"`
+
+	// The minimum rate, in bytes per second, at which the client must
+	// download the response. The allowance starts at WriteTimeout and
+	// grows by one second per WriteMinRate bytes written. Zero
+	// (default) disables the rate floor.
+	WriteMinRate int64 `json:"write_min_rate,omitempty"`
+
+	// The largest amount of response body written to the connection
+	// between two deadline resets; a deadline bounds a whole write, so
+	// a single huge write would otherwise have to fit in one idle
+	// window. Default: 64 KiB.
+	MaxWriteChunk int `json:"max_write_chunk,omitempty"`
+
+	logger *zap.Logger
+}
+
+// CaddyModule returns the Caddy module information.
+func (Timeouts) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{
+		ID:  "http.handlers.timeouts",
+		New: func() caddy.Module { return new(Timeouts) },
+	}
+}
+
+// Provision sets up the handler.
+func (t *Timeouts) Provision(ctx caddy.Context) error {
+	t.logger = ctx.Logger()
+	return nil
+}
+
+func (t Timeouts) ServeHTTP(w http.ResponseWriter, r *http.Request, next caddyhttp.Handler) error {
+	readEnabled := t.ReadTimeout > 0 || t.ReadMinRate > 0
+	writeEnabled := t.WriteTimeout > 0 || t.WriteMinRate > 0 || t.MaxWriteChunk > 0
+	if !readEnabled && !writeEnabled {
+		return next.ServeHTTP(w, r)
+	}
+
+	start := time.Now()
+
+	// the response controller is how deadlines reach the connection,
+	// whatever the HTTP version in use
+	//nolint:bodyclose
+	ctrl := http.NewResponseController(w)
+
+	if readEnabled && r.Body != nil {
+		r.Body = &caddyhttp.IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       ctrl,
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   start,
+				Timeout: t.ReadTimeout,
+				MinRate: t.ReadMinRate,
+			},
+			Logger: t.logger,
+		}
+	}
+
+	if writeEnabled {
+		w = &caddyhttp.IdleTimeoutWriter{
+			ResponseWriterWrapper: &caddyhttp.ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  ctrl,
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   start,
+				Timeout: t.WriteTimeout,
+				MinRate: t.WriteMinRate,
+			},
+			MaxChunk: t.MaxWriteChunk,
+			Logger:   t.logger,
+		}
+	}
+
+	return next.ServeHTTP(w, r)
+}
+
+// Interface guards
+var (
+	_ caddy.Provisioner           = (*Timeouts)(nil)
+	_ caddyhttp.MiddlewareHandler = (*Timeouts)(nil)
+)
