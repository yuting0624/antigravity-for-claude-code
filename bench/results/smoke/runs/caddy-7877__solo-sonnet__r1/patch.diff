+// reverseAtoms reverses s by atom, where an atom is a single byte, except
+// a valid escape sequence ("%xx") is kept together as one atom rather than
+// being reversed byte-by-byte. This lets trimPathPrefix be reused to trim
+// a suffix (by reversing the path and suffix, trimming a prefix, then
+// reversing the result back) without corrupting escape sequences, which a
+// naive byte reversal would otherwise scramble (e.g. "%2F" -> "F2%").
+func reverseAtoms(s string) string {
+	var atoms []string
+	for i := 0; i < len(s); {
+		if s[i] == '%' && i+2 < len(s) && isHexDigit(s[i+1]) && isHexDigit(s[i+2]) {
+			atoms = append(atoms, s[i:i+3])
+			i += 3
+			continue
+		}
+		atoms = append(atoms, s[i:i+1])
+		i++
+	}
+	for i, j := 0, len(atoms)-1; i < j; i, j = i+1, j-1 {
+		atoms[i], atoms[j] = atoms[j], atoms[i]
 	}
-	return string(r)
+	return strings.Join(atoms, "")
+}
+
+func isHexDigit(c byte) bool {
+	return '0' <= c && c <= '9' || 'a' <= c && c <= 'f' || 'A' <= c && c <= 'F'
