+// trimPathSuffix is like strings.TrimSuffix, but customized for advanced URI
+// path suffix matching; both strings are iterated in lock-step from the end;
+// if the suffix has a percent encoding at a position, the path must literally
+// use the same escape at that position; otherwise all character comparisons
+// are performed in normalized/unescaped space.
+func trimPathSuffix(escapedPath, suffix string) string {
+	iPath, iSuffix := len(escapedPath), len(suffix)
+	for iPath > 0 && iSuffix > 0 {
+		pathEsc := iPath >= 3 && escapedPath[iPath-3] == '%'
+		suffixEsc := iSuffix >= 3 && suffix[iSuffix-3] == '%'
