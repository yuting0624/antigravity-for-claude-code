+		switch {
+		case pathEsc && suffixEsc:
+			// both use an escape here, so compare the escapes literally;
+			// case-insensitively, since the hex digits may differ in case
+			if !strings.EqualFold(escapedPath[iPath-3:iPath], suffix[iSuffix-3:iSuffix]) {
+				return escapedPath
+			}
+			iPath -= 3
+			iSuffix -= 3
+
+		case pathEsc:
+			// the path is escaped here but the suffix is not,
+			// so compare them in normalized space
+			ch, err := url.PathUnescape(escapedPath[iPath-3 : iPath])
+			if err != nil {
