+				return escapedPath
+			}
+			iPath -= 3
+			iSuffix--
+
+		case suffixEsc:
+			// the suffix requires an escape at this position,
+			// but the path does not use one
+			return escapedPath
+
+		default:
+			if !strings.EqualFold(string(escapedPath[iPath-1]), string(suffix[iSuffix-1])) {
+				return escapedPath
+			}
+			iPath--
+			iSuffix--
+		}
 	}
-	return string(r)
