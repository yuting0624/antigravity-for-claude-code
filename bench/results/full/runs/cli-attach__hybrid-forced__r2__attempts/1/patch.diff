new file mode 100644
index 000000000..3866493c7
--- /dev/null
+++ b/internal/attachments/testing.go
@@ -0,0 +1,65 @@
+// Package attachments provides test helpers for use in other packages.
+// This is not a _test.go file so that its helpers can be imported by tests in other packages.
+package attachments
+
+import (
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/httpmock"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// UploadStub describes one stubbed upload response.
+type UploadStub struct {
+	Name   string
+	Status int
+	Body   string
+}
+
+func uploadMatcher(repositoryID int64, name string) httpmock.Matcher {
+	return httpmock.QueryMatcher("POST", "user-attachments/assets", url.Values{
+		"repository_id": []string{strconv.FormatInt(repositoryID, 10)},
+		"name":          []string{name},
+	})
+}
+
+// StubUpload registers one upload response for the named file.
+func StubUpload(reg *httpmock.Registry, repositoryID int64, name string, status int, body string) {
+	reg.Register(uploadMatcher(repositoryID, name), httpmock.StatusStringResponse(status, body))
+}
+
+// StubUploadToHost is StubUpload for an upload that must reach a particular host.
+func StubUploadToHost(t *testing.T, reg *httpmock.Registry, host string, repositoryID int64, name string, status int, body string) {
+	t.Helper()
+	matcher := func(req *http.Request) bool {
+		if req.URL.Host != host && !strings.EqualFold(req.URL.Host, host) {
+			return false
+		}
+		return uploadMatcher(repositoryID, name)(req)
+	}
+	reg.Register(matcher, func(req *http.Request) (*http.Response, error) {
+		assert.Equal(t, host, req.URL.Host)
+		return httpmock.StatusStringResponse(status, body)(req)
+	})
+}
+
+// NewTestAssets moves the test into a temporary directory, writes a file for each
+// name there and resolves them, so the caller gets assets whose bytes an upload can read.
+func NewTestAssets(t *testing.T, names ...string) []UserAsset {
+	t.Helper()
+	t.Chdir(t.TempDir())
+	assets := make([]UserAsset, 0, len(names))
+	for _, name := range names {
+		require.NoError(t, os.WriteFile(name, []byte("the bytes"), 0o600))
+		asset, err := newAsset("./"+name, "")
+		require.NoError(t, err)
+		assets = append(assets, asset)
+	}
+	return assets
+}
diff --git a/internal/attachments/userasset.go b/internal/attachments/userasset.go
new file mode 100644
index 000000000..bf22c8bd7
--- /dev/null
+++ b/internal/attachments/userasset.go
@@ -0,0 +1,152 @@
+// Package attachments decides what gh can attach to an issue or pull request body and uploads it.
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+const (
+	maxImageBytes = 10 * 1024 * 1024
+	maxVideoBytes = 100 * 1024 * 1024
+)
+
+var openFile = func(path string) (io.ReadCloser, error) {
+	return os.Open(path)
+}
+
+type asset struct {
+	path        string
+	alt         string
+	contentType string
+	info        os.FileInfo
+}
+
+func (a *asset) Path() string {
+	return a.path
+}
+
+func (a *asset) getAsset() *asset {
+	return a
+}
+
+// UserAsset represents a media asset that can be attached.
+type UserAsset interface {
+	Path() string
+	getAsset() *asset
+	markdown(assetURL string) string
+	rendersAsPlayer() bool
+}
+
+type imageAsset struct {
+	asset
+}
+
+func (img *imageAsset) markdown(assetURL string) string {
+	alt := img.alt
+	alt = strings.ReplaceAll(alt, `\`, `\\`)
+	alt = strings.ReplaceAll(alt, "[", `\[`)
+	alt = strings.ReplaceAll(alt, "]", `\]`)
+	alt = strings.ReplaceAll(alt, "\r", " ")
+	alt = strings.ReplaceAll(alt, "\n", " ")
+	return fmt.Sprintf("![%s](%s)", alt, assetURL)
+}
+
+func (img *imageAsset) rendersAsPlayer() bool {
+	return false
+}
+
+type videoAsset struct {
+	asset
+}
+
+func (v *videoAsset) markdown(assetURL string) string {
+	return assetURL
+}
+
+func (v *videoAsset) rendersAsPlayer() bool {
+	return true
+}
+
+var mediaTypes = map[string]string{
+	".png":  "image/png",
+	".jpg":  "image/jpeg",
+	".jpeg": "image/jpeg",
+	".gif":  "image/gif",
+	".webp": "image/webp",
+	".svg":  "image/svg+xml",
+	".mp4":  "video/mp4",
+	".mov":  "video/quicktime",
+	".webm": "video/webm",
+}
+
+func newAsset(path, alt string) (UserAsset, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		var pathErr *fs.PathError
+		if errors.As(err, &pathErr) {
+			return nil, fmt.Errorf("%s: %w", path, pathErr.Err)
+		}
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+
+	if info.IsDir() {
+		return nil, fmt.Errorf("%s is a directory", path)
+	}
+
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%s is not a regular file", path)
+	}
+
+	ext := strings.ToLower(filepath.Ext(path))
+	contentType, ok := mediaTypes[ext]
+	if !ok {
+		return nil, fmt.Errorf("%s is not a supported file type (supported: png, jpg, jpeg, gif, webp, svg, mp4, mov, webm)", path)
+	}
+
+	if info.Size() == 0 {
+		return nil, fmt.Errorf("%s is empty", path)
+	}
+
+	isVideo := strings.HasPrefix(contentType, "video/")
+	if isVideo && alt != "" {
+		return nil, errors.New("cannot set alt text on video")
+	}
+
+	if isVideo {
+		if info.Size() > maxVideoBytes {
+			return nil, fmt.Errorf("%s: videos must be at most %.1f MB", path, float64(maxVideoBytes)/(1024*1024))
+		}
+	} else {
+		if info.Size() > maxImageBytes {
+			return nil, fmt.Errorf("%s: images must be at most %.1f MB", path, float64(maxImageBytes)/(1024*1024))
+		}
+	}
+
+	if alt == "" {
+		if isVideo {
+			alt = filepath.Base(path)
+		} else {
+			base := filepath.Base(path)
+			nameWithoutExt := strings.TrimSuffix(base, filepath.Ext(base))
+			alt = strings.ReplaceAll(nameWithoutExt, ".", " ")
+		}
+	}
+
+	baseAsset := asset{
+		path:        path,
+		alt:         alt,
+		contentType: contentType,
+		info:        info,
+	}
+
+	if isVideo {
+		return &videoAsset{asset: baseAsset}, nil
+	}
+	return &imageAsset{asset: baseAsset}, nil
+}
