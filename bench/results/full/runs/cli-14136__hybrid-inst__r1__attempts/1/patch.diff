+// AddWorktree adds a linked worktree at path with branch checked out in it.
+// When remoteName is empty, branch must already exist locally. Otherwise branch
+// is created in the new worktree as a tracking branch of remoteName/branch.
+func (c *Client) AddWorktree(ctx context.Context, path, branch, remoteName string) error {
+	args := []string{"worktree", "add", "--", path, branch}
+	if remoteName != "" {
+		track := fmt.Sprintf("%s/%s", remoteName, branch)
+		args = []string{"worktree", "add", "--track", "-b", branch, "--", path, track}
+	}
+	cmd, err := c.Command(ctx, args...)
+	if err != nil {
+		return err
+	}
+	_, err = cmd.Output()
+	if err != nil {
+		return err
+	}
+	return nil
+}
+
 func (c *Client) HasLocalBranch(ctx context.Context, branch string) bool {
 	_, err := c.revParse(ctx, "--verify", "refs/heads/"+branch)
 	return err == nil
