+// checkoutBranchInWorktree checks the linked branch out in a Git worktree at
+// target.Path, leaving the current working copy on its own branch. An existing
+// linked worktree at that path is reused; otherwise a new one is added.
+func checkoutBranchInWorktree(opts *DevelopOptions, target prShared.WorktreeTarget, remoteName, branchName string) error {
+	gc := opts.GitClient
+	branchExists := gc.HasLocalBranch(ctx.Background(), branchName)
+
+	// Scoping a client to the worktree runs its commands with -C <path>.
+	worktreeClient := gc.Copy()
+	worktreeClient.RepoDir = target.Path
+
+	switch {
+	case target.Reuse && branchExists:
+		if err := worktreeClient.CheckoutBranch(ctx.Background(), branchName); err != nil {
+			return err
+		}
+	case target.Reuse:
+		return worktreeClient.CheckoutNewBranch(ctx.Background(), remoteName, branchName)
+	case branchExists:
+		if err := gc.AddWorktree(ctx.Background(), target.Path, branchName, ""); err != nil {
+			return err
+		}
+	default:
+		return gc.AddWorktree(ctx.Background(), target.Path, branchName, remoteName)
+	}
+
+	// The branch already existed locally, so fast-forward it inside the worktree.
+	if err := worktreeClient.Pull(ctx.Background(), remoteName, branchName); err != nil {
+		_, _ = fmt.Fprintf(opts.IO.ErrOut, "%s warning: not possible to fast-forward to: %q\n", opts.IO.ColorScheme().WarningIcon(), branchName)
+	}
+	return nil
+}
