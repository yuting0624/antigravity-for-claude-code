index 000000000..0fe48529c
--- /dev/null
+++ b/internal/cloudapi/clientcfg/clientcfg.go
@@ -0,0 +1,12 @@
+// Package clientcfg holds retry configuration shared by k6 Cloud's various
+// API clients (cloudapi, internal/cloudapi/v6, internal/cloudapi/provisioning).
+package clientcfg
+
+import "time"
+
+const (
+	// RetryInterval is the default cloud request retry interval.
+	RetryInterval = 500 * time.Millisecond
+	// MaxRetries specifies the max retry attempts.
+	MaxRetries = 3
+)
diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..9c04629d7
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,174 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strconv"
+	"time"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// StartLocalExecutionRequest is the body of a start_local_execution request.
+type StartLocalExecutionRequest struct {
+	// Options holds the parsed k6 script options, forwarded as-is.
+	Options json.RawMessage
+	// MaxVUs is the maximum number of virtual users during the test.
+	MaxVUs int32
+	// TotalDuration is the total duration of the test, in seconds.
+	TotalDuration int32
+	// ArchiveSize is the k6 archive size in bytes, or 0 when not uploading
+	// an archive. It's encoded as an explicit JSON null in that case.
+	ArchiveSize int64
+}
+
+// MarshalJSON encodes ArchiveSize as an explicit JSON null when it's 0,
+// signaling "no archive" rather than omitting the field.
+func (r StartLocalExecutionRequest) MarshalJSON() ([]byte, error) {
+	type wire struct {
+		Options       json.RawMessage `json:"options"`
+		MaxVUs        int32           `json:"max_vus"`
+		TotalDuration int32           `json:"total_duration"`
+		ArchiveSize   *int64          `json:"archive_size"`
+	}
+	w := wire{Options: r.Options, MaxVUs: r.MaxVUs, TotalDuration: r.TotalDuration}
+	if r.ArchiveSize > 0 {
+		w.ArchiveSize = &r.ArchiveSize
+	}
+	return json.Marshal(w)
+}
+
+// StartLocalExecutionResponse is the response to a start_local_execution request.
+type StartLocalExecutionResponse struct {
+	TestRunID             int64         `json:"test_run_id"`
+	RuntimeConfig         RuntimeConfig `json:"runtime_config"`
+	ArchiveUploadURL      *string       `json:"archive_upload_url"`
+	TestRunDetailsPageURL string        `json:"test_run_details_page_url"`
+}
+
+// RuntimeConfig is the runtime configuration returned by start_local_execution:
+// where to push metrics, the test-run-scoped token, and the secrets endpoint.
+type RuntimeConfig struct {
+	Metrics      MetricsConfig `json:"metrics"`
+	TestRunToken string        `json:"test_run_token"`
+	Secrets      SecretsConfig `json:"secrets"`
+}
+
+// MetricsConfig holds where and how to push metrics for the test run.
+type MetricsConfig struct {
+	PushURL               string  `json:"push_url"`
+	PushInterval          *string `json:"push_interval,omitempty"`
+	PushConcurrency       *int32  `json:"push_concurrency,omitempty"`
+	AggregationPeriod     *string `json:"aggregation_period,omitempty"`
+	AggregationWaitPeriod *string `json:"aggregation_wait_period,omitempty"`
+	AggregationMinSamples *int32  `json:"aggregation_min_samples,omitempty"`
+	MaxSamplesPerPackage  *int32  `json:"max_samples_per_package,omitempty"`
+}
+
+// SecretsConfig describes how to decrypt cloud secrets for the test run.
+type SecretsConfig struct {
+	Endpoint     string `json:"endpoint"`
+	ResponsePath string `json:"response_path"`
+}
+
+// StartLocalExecution ensures loadTestID is started for local execution,
+// returning the test run id, an optional presigned archive upload URL, the
+// runtime config, and the details-page URL.
+func (c *Client) StartLocalExecution(
+	ctx context.Context, loadTestID int64, req StartLocalExecutionRequest,
+) (*StartLocalExecutionResponse, error) {
+	body, err := json.Marshal(req)
+	if err != nil {
+		return nil, err
+	}
+
+	url := fmt.Sprintf("%s/provisioning/v1/load_tests/%d/start_local_execution", c.host(), loadTestID)
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(body))
+	if err != nil {
+		return nil, err
+	}
+	httpReq.Header.Set("Content-Type", "application/json")
+	httpReq.Header.Set("X-Stack-Id", strconv.FormatInt(c.stackID, 10))
+	httpReq.Header.Set("K6-Idempotency-Key", randomHex())
+
+	var resp StartLocalExecutionResponse
+	if err := c.httpClient.Do(httpReq, &resp); err != nil {
+		return nil, err
+	}
+	return &resp, nil
+}
+
+// UploadArchive uploads the k6 archive body to a presigned URL, without an
+// Authorization header (which presigned URLs reject).
+func (c *Client) UploadArchive(ctx context.Context, url string, body []byte) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPut, url, bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/x-tar")
+	req.ContentLength = int64(len(body))
+
+	return c.uploadClient.Do(req, nil)
+}
+
+// WaitForTestRunReady polls the v6 test run status until it reports
+// initializing (or any later, non-terminal-failure status), returning an
+// error if the test run is aborted or completes before starting.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	logged := make(map[v6.Status]bool)
+
+	for {
+		tp, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			return err
+		}
+
+		switch tp.Status {
+		case v6.StatusInitializing, v6.StatusRunning, v6.StatusProcessingMetrics:
+			return nil
+		case v6.StatusAborted:
+			if msg := abortMessage(tp); msg != "" {
+				return fmt.Errorf("test run aborted before starting: %s", msg)
+			}
+			return errors.New("test run aborted before starting")
+		case v6.StatusCompleted:
+			return errors.New("test run completed before starting local execution")
+		default:
+			if !logged[tp.Status] {
+				logged[tp.Status] = true
+				c.logger.WithField("status", tp.FormatStatus()).Info("Waiting for test run to start")
+			}
+		}
+
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(pollInterval):
+		}
+	}
+}
+
+func abortMessage(tp *v6.TestProgress) string {
+	for _, e := range tp.StatusHistory {
+		if e.Status == v6.StatusAborted && e.Message != "" {
+			return e.Message
+		}
+	}
+	return ""
+}
+
+func (c *Client) host() string {
+	return c.apiClient.GetConfig().Servers[0].URL
+}
+
+func randomHex() string {
+	b := make([]byte, 8)
+	_, _ = rand.Read(b)
+	return hex.EncodeToString(b)
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..5503cfb36
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,92 @@
+// Package provisioning implements the client side of Grafana Cloud k6's
+// provisioning API, used by `k6 cloud run --local-execution` to start a test
+// run that executes locally while streaming metrics to the cloud.
+package provisioning
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client talks to the provisioning API and the v6 cloud API endpoints that
+// local-execution orchestration needs (creating/finding a load test, and
+// polling a test run's status).
+type Client struct {
+	apiClient *k6cloud.APIClient
+	token     string
+	version   string
+	stackID   int64
+
+	logger logrus.FieldLogger
+
+	// v6Client handles the create-or-find-load-test and fetch-test-run
+	// operations, which live on the v6 cloud API rather than provisioning.
+	v6Client *v6.Client
+
+	// httpClient authenticates with the long-lived token given to
+	// NewClient. It's used for calls made on behalf of the user/stack:
+	// starting local execution.
+	httpClient *HTTPClient
+
+	// uploadClient carries no Authorization header, as required by
+	// presigned archive upload URLs.
+	uploadClient *HTTPClient
+}
+
+// NewClient creates a new provisioning API client authenticated with token
+// and scoped to stackID.
+func NewClient(
+	logger logrus.FieldLogger, token, host, version string, stackID int64, timeout time.Duration,
+) (*Client, error) {
+	if token == "" {
+		return nil, errors.New("token is required to create provisioning API client")
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Global k6 Cloud API.",
+		},
+	}
+	cfg.HTTPClient = &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+
+	v6Client, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if err := v6Client.SetStackID(stackID); err != nil {
+		return nil, err
+	}
+
+	return &Client{
+		apiClient:    k6cloud.NewAPIClient(cfg),
+		token:        token,
+		version:      version,
+		stackID:      stackID,
+		logger:       logger,
+		v6Client:     v6Client,
+		httpClient:   NewHTTPClient(cfg.HTTPClient, token, version, logger),
+		uploadClient: NewHTTPClient(cfg.HTTPClient, "", version, logger),
+	}, nil
+}
+
+// CreateOrFindLoadTest ensures a load test named name exists in projectID,
+// returning its id.
+func (c *Client) CreateOrFindLoadTest(ctx context.Context, projectID int64, name string) (int64, error) {
+	return c.v6Client.CreateOrFindLoadTest(ctx, projectID, name)
+}
diff --git a/internal/cloudapi/provisioning/errors.go b/internal/cloudapi/provisioning/errors.go
new file mode 100644
index 000000000..c117d5753
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,41 @@
+package provisioning
+
+import (
+	"fmt"
+	"io"
+	"net/http"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+// ResponseError represents a non-2xx HTTP response from the provisioning API.
+type ResponseError struct {
+	StatusCode int
+	Body       string
+}
+
+func (e *ResponseError) Error() string {
+	return fmt.Sprintf("%d: %s", e.StatusCode, e.Body)
+}
+
+// CheckResponse returns nil for a successful (2xx) response, otherwise it
+// reads the response body and returns a [*ResponseError] describing the
+// failure. HTTP 401 and 403 responses are additionally classified as
+// [httperr.ErrNotAuthenticated] and [httperr.ErrNotAuthorized], matching how
+// the v6 cloud API client classifies the same status codes.
+func CheckResponse(resp *http.Response) error {
+	if resp.StatusCode >= 200 && resp.StatusCode <= 299 {
+		return nil
+	}
+
+	data, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return err
+	}
+
+	rerr := &ResponseError{StatusCode: resp.StatusCode, Body: string(data)}
+	if classified := httperr.ClassifyStatus(resp.StatusCode); classified != nil {
+		return fmt.Errorf("%w: %w", classified, rerr)
+	}
+	return rerr
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..f7d7bffca
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,116 @@
+package provisioning
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient is a thin, retrying HTTP client used to talk to the
+// provisioning API. Unlike the generated k6-cloud-openapi-client-go SDK
+// methods, it lets callers set arbitrary headers (X-Stack-Id, idempotency
+// keys, ...) and decode responses into the package's own domain types.
+type HTTPClient struct {
+	client    *http.Client
+	token     string
+	userAgent string
+	logger    logrus.FieldLogger
+}
+
+// NewHTTPClient creates a new HTTPClient that authenticates every request
+// with the given bearer token and identifies itself with a "k6cloud/version"
+// User-Agent header. An empty token omits the Authorization header, which is
+// required for presigned upload URLs that must not carry one.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	return &HTTPClient{
+		client:    client,
+		token:     token,
+		userAgent: "k6cloud/" + version,
+		logger:    logger,
+	}
+}
+
+// Do sends req, retrying on 5xx responses and network errors up to
+// [clientcfg.MaxRetries] times, waiting [clientcfg.RetryInterval] between
+// attempts. If v is non-nil, the JSON response body is decoded into it.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	if c.token != "" {
+		req.Header.Set("Authorization", "Bearer "+c.token)
+	}
+	req.Header.Set("User-Agent", c.userAgent)
+
+	if req.Body != nil && req.GetBody == nil {
+		body, err := io.ReadAll(req.Body)
+		if err != nil {
+			return err
+		}
+		if err := req.Body.Close(); err != nil {
+			return err
+		}
+		req.GetBody = func() (io.ReadCloser, error) {
+			return io.NopCloser(bytes.NewReader(body)), nil
+		}
+		req.Body, _ = req.GetBody()
+	}
+
+	var lastErr error
+	for attempt := 0; attempt <= clientcfg.MaxRetries; attempt++ {
+		if attempt > 0 {
+			if req.GetBody != nil {
+				req.Body, _ = req.GetBody()
+			}
+			select {
+			case <-req.Context().Done():
+				return req.Context().Err()
+			case <-time.After(clientcfg.RetryInterval):
+			}
+		}
+
+		retry, err := c.do(req, v)
+		if !retry {
+			return err
+		}
+		lastErr = err
+		if c.logger != nil {
+			c.logger.WithError(err).WithField("attempt", attempt+1).Debug("Retrying provisioning API request")
+		}
+	}
+
+	return lastErr
+}
+
+func (c *HTTPClient) do(req *http.Request, v any) (retry bool, err error) {
+	resp, err := c.client.Do(req)
+	if err != nil {
+		return true, err
+	}
+	defer func() {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		if cerr := resp.Body.Close(); cerr != nil && err == nil {
+			err = cerr
+		}
+	}()
+
+	if resp.StatusCode >= 500 {
+		return true, CheckResponse(resp)
+	}
+
+	if err := CheckResponse(resp); err != nil {
+		return false, err
+	}
+
+	if v != nil {
+		if err := json.NewDecoder(resp.Body).Decode(v); err != nil && !errors.Is(err, io.EOF) {
+			return false, err
+		}
+	}
+
+	return false, nil
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..2534073cf
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,70 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+// notifyError is the error payload sent as part of a script_execution_completed notification.
+type notifyError struct {
+	Code   int32  `json:"code"`
+	Reason string `json:"reason"`
+}
+
+// mapTestErrorToNotifyCode maps a k6 test error to the notify API's error
+// code: 8036 for a user or script abort, 8035 for a script error, 8034 for a
+// timeout or output failure, and nil for a clean finish or thresholds that
+// failed only after the test ended.
+func mapTestErrorToNotifyCode(err error) *notifyError {
+	if err == nil {
+		return nil
+	}
+
+	var hasReason errext.HasAbortReason
+	if errors.As(err, &hasReason) {
+		switch hasReason.AbortReason() {
+		case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+			return &notifyError{Code: 8036, Reason: err.Error()}
+		case errext.AbortedByScriptError:
+			return &notifyError{Code: 8035, Reason: err.Error()}
+		case errext.AbortedByOutput, errext.AbortedByTimeout:
+			return &notifyError{Code: 8034, Reason: err.Error()}
+		case errext.AbortedByThresholdsAfterTestEnd:
+			return nil
+		}
+	}
+
+	return &notifyError{Code: 0, Reason: err.Error()}
+}
+
+// NotifyTestRunCompleted reports a script_execution_completed lifecycle event
+// for testRunID, authenticated with the given test-run-scoped token (not the
+// client's own long-lived token).
+func (c *Client) NotifyTestRunCompleted(ctx context.Context, testRunID int64, token string, testErr error) error {
+	body, err := json.Marshal(struct {
+		EventType string       `json:"event_type"`
+		Error     *notifyError `json:"error"`
+	}{
+		EventType: "script_execution_completed",
+		Error:     mapTestErrorToNotifyCode(testErr),
+	})
+	if err != nil {
+		return err
+	}
+
+	url := fmt.Sprintf("%s/provisioning/v1/test_runs/%d/notify", c.host(), testRunID)
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/json")
+
+	notifyClient := NewHTTPClient(c.apiClient.GetConfig().HTTPClient, token, c.version, c.logger)
+	return notifyClient.Do(req, nil)
+}
diff --git a/internal/cloudapi/provisioning/provision.go b/internal/cloudapi/provisioning/provision.go
new file mode 100644
index 000000000..9fe224d10
--- /dev/null
+++ b/internal/cloudapi/provisioning/provision.go
@@ -0,0 +1,100 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"go.k6.io/k6/v2/lib"
+)
+
+// defaultPollInterval is used when ProvisionParams.PollInterval is zero.
+const defaultPollInterval = 2 * time.Second
+
+// ProvisionParams holds the inputs needed to provision a local-execution test run.
+type ProvisionParams struct {
+	// Name and ProjectID identify (or create) the load test.
+	Name      string
+	ProjectID int64
+
+	// MaxVUs and TotalDuration describe the test, in seconds for the latter.
+	MaxVUs        int32
+	TotalDuration int32
+
+	// Options holds the parsed k6 script options, forwarded as-is.
+	Options json.RawMessage
+
+	// Archive is uploaded to the cloud unless nil, in which case no
+	// archive is sent and StartLocalExecutionRequest.ArchiveSize is null.
+	Archive *lib.Archive
+
+	// PollInterval is the delay between test-run status polls. Defaults
+	// to [defaultPollInterval] when zero.
+	PollInterval time.Duration
+}
+
+// ProvisionResult holds what the caller needs to stream metrics to, and
+// report on, the newly started local-execution test run.
+type ProvisionResult struct {
+	TestRunID             int64
+	TestRunDetailsPageURL string
+	RuntimeConfig         RuntimeConfig
+}
+
+// ProvisionLocalExecution ensures the load test exists, starts it for local
+// execution, optionally uploads the test archive, and waits until the test
+// run reports it's ready (initializing) for k6 to start pushing metrics.
+func (c *Client) ProvisionLocalExecution(ctx context.Context, params ProvisionParams) (*ProvisionResult, error) {
+	loadTestID, err := c.CreateOrFindLoadTest(ctx, params.ProjectID, params.Name)
+	if err != nil {
+		return nil, fmt.Errorf("create or find load test: %w", err)
+	}
+
+	var archiveBytes []byte
+	var archiveSize int64
+	if params.Archive != nil {
+		var buf bytes.Buffer
+		if err := params.Archive.Write(&buf); err != nil {
+			return nil, fmt.Errorf("build archive: %w", err)
+		}
+		archiveBytes = buf.Bytes()
+		archiveSize = int64(len(archiveBytes))
+	}
+
+	sleResp, err := c.StartLocalExecution(ctx, loadTestID, StartLocalExecutionRequest{
+		Options:       params.Options,
+		MaxVUs:        params.MaxVUs,
+		TotalDuration: params.TotalDuration,
+		ArchiveSize:   archiveSize,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("start local execution: %w", err)
+	}
+
+	if params.Archive != nil {
+		switch {
+		case sleResp.ArchiveUploadURL == nil || *sleResp.ArchiveUploadURL == "":
+			c.logger.Warn("start_local_execution returned no archive upload URL; skipping archive upload")
+		default:
+			if err := c.UploadArchive(ctx, *sleResp.ArchiveUploadURL, archiveBytes); err != nil {
+				return nil, fmt.Errorf("upload archive: %w", err)
+			}
+		}
+	}
+
+	pollInterval := params.PollInterval
+	if pollInterval <= 0 {
+		pollInterval = defaultPollInterval
+	}
+	if err := c.WaitForTestRunReady(ctx, sleResp.TestRunID, pollInterval); err != nil {
+		return nil, fmt.Errorf("wait for test run ready: %w", err)
+	}
+
+	return &ProvisionResult{
