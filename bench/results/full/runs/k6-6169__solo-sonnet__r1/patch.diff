diff --git a/internal/cloudapi/provisioning/test/server.go b/internal/cloudapi/provisioning/test/server.go
new file mode 100644
index 000000000..a61960af3
--- /dev/null
+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,163 @@
+// Package test provides an HTTP test server that simulates the provisioning
+// API (and the small slice of the v6 cloud API that local-execution
+// provisioning depends on: create-or-find load test, fetch test run).
+package test
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	// DefaultLoadTestID is the load test id used by [DefaultStartLocalExecutionResponse]
+	// and the routes registered by [Server.HandleStartLocalExecution] et al.
+	DefaultLoadTestID int64 = 456
+	// DefaultTestRunID is the test run id used by [DefaultStartLocalExecutionResponse].
+	DefaultTestRunID int64 = 123
+
+	// PresignedUploadPath is the path used for the fake presigned S3 upload URL.
+	PresignedUploadPath = "/s3-presigned/upload"
+)
+
+// Server is a test HTTP server simulating the provisioning API.
+type Server struct {
+	*httptest.Server
+
+	// Mux is exposed so tests can register additional routes (e.g. a
+	// catch-all for metrics pushes) beyond the Handle* helpers below.
+	Mux *http.ServeMux
+
+	fetchTestRunHits atomic.Int32
+}
+
+// NewServer creates a new provisioning test server. Routes are registered
+// with the Handle* methods before making requests.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+
+	mux := http.NewServeMux()
+	s := &Server{Mux: mux}
+
+	srv := httptest.NewServer(mux)
+	s.Server = srv
+	t.Cleanup(srv.Close)
+
+	return s
+}
+
+// HandleCreateLoadTest registers h at the v6 create-load-test route for projectID.
+func (s *Server) HandleCreateLoadTest(projectID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID), h)
+}
+
+// HandleStartLocalExecution registers h at the start_local_execution route for loadTestID.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/load_tests/%d/start_local_execution", loadTestID), h)
+}
+
+// HandlePresignedUpload registers h at path, simulating a presigned archive upload URL.
+func (s *Server) HandlePresignedUpload(path string, h http.HandlerFunc) {
+	s.Mux.HandleFunc(path, h)
+}
+
+// HandleNotify registers h at the provisioning notify route for testRunID.
+func (s *Server) HandleNotify(testRunID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/test_runs/%d/notify", testRunID), h)
+}
+
+// HandleFetchTestRun registers the v6 fetch-test-run route for testRunID. Each
+// successive request returns the next entry in progression; once exhausted,
+// the last entry is repeated. FetchTestRunHitCount reports how many times the
+// route was hit.
+func (s *Server) HandleFetchTestRun(testRunID int64, progression []v6.TestProgress) {
+	var calls atomic.Int32
+
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/test_runs/%d", testRunID), func(w http.ResponseWriter, _ *http.Request) {
+		s.fetchTestRunHits.Add(1)
+
+		i := int(calls.Add(1)) - 1
+		if i >= len(progression) {
+			i = len(progression) - 1
+		}
+		tp := progression[i]
+
+		res := k6cloud.NewTestRunApiModelWithDefaults()
+		res.SetStatus(tp.Status.String())
+		res.SetResult(tp.Result.String())
+		res.SetEstimatedDuration(tp.EstimatedDuration)
+		res.SetExecutionDuration(tp.ExecutionDuration)
+		res.SetStatusHistory(v6.ToStatusModel(tp.StatusHistory))
+		// SDK decoder requires these keys on the other end even when empty.
+		res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+		res.SetResultDetails(k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(k6cloud.NewResultDetailsApiModel("")))
+		res.SetOptions(map[string]any{})
+		writeJSON(w, http.StatusOK, res)
+	})
+}
+
+// FetchTestRunHitCount reports how many times a fetch-test-run route
+// registered by HandleFetchTestRun has been hit.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchTestRunHits.Load()
+}
+
+// PresignedUploadURL returns the full URL of the fake presigned upload route.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// DefaultStartLocalExecutionResponse returns a fully populated
+// start_local_execution response using DefaultTestRunID, a fake S3 presigned
+// upload URL, and canned runtime-config tuning values.
+func DefaultStartLocalExecutionResponse() *k6cloud.StartLocalExecutionTestResponse {
+	pushInterval := "2s"
+	var pushConcurrency int32 = 5
+	aggPeriod := "3s"
+	aggWaitPeriod := "1s"
+	var maxSamples int32 = 2000
+
+	metrics := k6cloud.NewMetricsRuntimeConfigWithDefaults()
+	metrics.SetPushUrl("https://ingest.k6.io/v1/metrics")
+	metrics.SetPushInterval(pushInterval)
+	metrics.SetPushConcurrency(pushConcurrency)
+	metrics.SetAggregationPeriod(aggPeriod)
+	metrics.SetAggregationWaitPeriod(aggWaitPeriod)
+	metrics.SetMaxSamplesPerPackage(maxSamples)
+
+	secrets := k6cloud.NewSecretsRuntimeConfig(
+		fmt.Sprintf("https://api.k6.io/provisioning/v1/test_runs/%d/decrypt_secret?name={key}", DefaultTestRunID),
+		"plaintext",
+	)
+
+	rc := k6cloud.NewRuntimeConfigWithDefaults()
+	rc.SetMetrics(*metrics)
+	rc.SetSecrets(*secrets)
+	rc.SetTraces(*k6cloud.NewTracesRuntimeConfigWithDefaults())
+	rc.SetFiles(*k6cloud.NewFilesRuntimeConfigWithDefaults())
+	rc.SetLogs(*k6cloud.NewLogsRuntimeConfigWithDefaults())
+	rc.SetTestRunToken("test-run-token-abc")
+
+	resp := k6cloud.NewStartLocalExecutionTestResponseWithDefaults()
+	resp.SetTestRunId(DefaultTestRunID)
+	resp.SetRuntimeConfig(*rc)
+	resp.SetArchiveUploadUrl("https://bucket.s3.amazonaws.com/presigned-upload?sig=abc")
+	resp.SetTestRunDetailsPageUrl(fmt.Sprintf("https://app.k6.io/runs/%d", DefaultTestRunID))
+
+	return resp
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	if err := json.NewEncoder(w).Encode(v); err != nil {
+		panic(fmt.Errorf("provisioning test server: encoding JSON: %w", err))
+	}
+}
