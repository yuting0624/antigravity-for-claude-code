+// CreateOrFindLoadTest ensures a load test named name exists in the given
+// project, returning its id. Unlike UploadTest, it never uploads a script:
+// it's used by local execution, where the script runs on the caller's
+// machine and only the load test's existence is needed.
+func (c *Client) CreateOrFindLoadTest(ctx context.Context, projectID int64, name string) (int64, error) {
+	lt, err := c.createLoadTestWithoutScript(ctx, projectID, name)
+	if err == nil {
+		return lt.GetId(), nil
+	}
+
+	var rerr ResponseError
+	if !errors.As(err, &rerr) || rerr.Response == nil || rerr.Response.StatusCode != http.StatusConflict {
+		return 0, err
+	}
+
+	// 409: a test with this name already exists in this project.
+	lt, err = c.findTestByName(ctx, projectID, name)
+	if err != nil {
+		return 0, err
+	}
+
+	return lt.GetId(), nil
+}
+
+func (c *Client) createLoadTestWithoutScript(
+	ctx context.Context, projectID int64, name string,
+) (_ *k6cloud.LoadTestApiModel, err error) {
+	res, hr, err := c.apiClient.LoadTestsAPI.
+		ProjectsLoadTestsCreate(c.authCtx(ctx), projectID).
+		XStackId(c.stackID).
+		Name(name).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if err := CheckResponse(hr, err); err != nil {
+		return nil, err
+	}
+	if res == nil {
+		return nil, errUnknown
+	}
+
+	return res, nil
+}
