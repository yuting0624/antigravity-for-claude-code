+// AddWorktree creates a worktree at path for the existing local branch via
+// `git worktree add -- <path> <branch>`.
+func (c *Client) AddWorktree(ctx context.Context, path, branch string) error {
+	cmd, err := c.Command(ctx, "worktree", "add", "--", path, branch)
+	if err != nil {
+		return err
+	}
+	_, err = cmd.Output()
+	return err
+}
+
+// AddWorktreeTrackingBranch creates a worktree at path with a new branch that
+// tracks remoteBranch via
+// `git worktree add --track -b <branch> -- <path> <remoteBranch>`.
+func (c *Client) AddWorktreeTrackingBranch(ctx context.Context, path, branch, remoteBranch string) error {
+	cmd, err := c.Command(ctx, "worktree", "add", "--track", "-b", branch, "--", path, remoteBranch)
+	if err != nil {
+		return err
+	}
+	_, err = cmd.Output()
+	return err
+}
