diff --git a/internal/attachments/attach.go b/internal/attachments/attach.go
new file mode 100644
index 000000000..de9ea83d6
--- /dev/null
+++ b/internal/attachments/attach.go
@@ -0,0 +1,82 @@
+package attachments
+
+import (
+	"context"
+	"strings"
+)
+
+// UploadAndAttach uploads every asset and writes it into body: a reference to a
+// local path is rewritten in place and anything unreferenced is appended. It
+// returns the new body and how many assets reached the server. A caller must
+// write the body whenever that count is above zero, even on error, because an
+// upload cannot be taken back.
+func (u *Uploader) UploadAndAttach(ctx context.Context, body string, assets []UserAsset) (string, int, error) {
+	if len(assets) == 0 {
+		return body, 0, nil
+	}
+
+	args := make([]attachmentArg, len(assets))
+	for i, a := range assets {
+		args[i] = attachmentArg{
+			Path:            a.Path(),
+			Alt:             a.getAsset().alt,
+			RendersAsPlayer: a.rendersAsPlayer(),
+			URL:             "",
+		}
+	}
+
+	v, err := newAttachableMarkdown(body, args)
+	if err != nil {
+		return body, 0, err
+	}
+
+	var uploadErr error
+	uploaded := 0
+	for i, a := range assets {
+		assetURL, err := u.upload(ctx, a)
+		if err != nil {
+			uploadErr = err
+			break
+		}
+		args[i].URL = assetURL
+		uploaded++
+	}
+
+	if uploaded == 0 {
+		return body, 0, uploadErr
+	}
+
+	attached, err := attachAssetsToMarkdown(v)
+	if err != nil {
+		return body, uploaded, err
+	}
+
+	newBody := attached.Rewritten
+	for i, a := range assets {
+		if args[i].URL != "" && inToAppend(attached.ToAppend, args[i]) {
+			newBody = appendParagraph(newBody, a.markdown(args[i].URL))
+		}
+	}
+
+	return newBody, uploaded, uploadErr
+}
+
+func inToAppend(list []attachmentArg, target attachmentArg) bool {
+	for _, item := range list {
+		if item == target || item.Path == target.Path {
+			return true
+		}
+	}
+	return false
+}
+
+// appendParagraph puts addition in a paragraph of its own below md.
+func appendParagraph(md, addition string) string {
+	if addition == "" {
+		return md
+	}
+	if strings.TrimSpace(md) == "" {
+		return addition
+	}
+	return strings.TrimRight(md, " \t\r\n") + "\n\n" + addition
+}
diff --git a/internal/attachments/client.go b/internal/attachments/client.go
new file mode 100644
index 000000000..1c6e5f922
--- /dev/null
+++ b/internal/attachments/client.go
@@ -0,0 +1,232 @@
+package attachments
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/cli/cli/v2/api"
+	"github.com/cli/cli/v2/internal/gh"
+	"github.com/cli/cli/v2/internal/ghinstance"
+	ghauth "github.com/cli/go-gh/v2/pkg/auth"
+)
+
+// openFile opens an asset for upload. It is a variable so tests can stub it.
+var openFile = func(path string) (io.ReadCloser, error) { return os.Open(path) }
+
+// Uploader posts files to the user-attachments endpoint of one host.
+type Uploader struct {
+	httpClient       *http.Client
+	host             string
+	targetRepository int64
+}
+
+// NewUploader checks everything that would make an upload impossible before any
+// request is made, because an upload cannot be taken back.
+func NewUploader(httpClient *http.Client, tokenType gh.TokenType, host string, targetRepository int64, viewerPermission string) (*Uploader, error) {
+	if err := checkHost(host); err != nil {
+		return nil, err
+	}
+	switch tokenType {
+	case gh.TokenTypeOAuth, gh.TokenTypePersonalAccess, gh.TokenTypeFineGrainedPAT:
+	default:
+		return nil, errors.New("unsupported authentication type")
+	}
+	if targetRepository <= 0 {
+		return nil, errors.New("could not determine which repository to attach files to")
+	}
+	if viewerPermission == "" {
+		return nil, errors.New("could not determine your permission on the repository to attach files")
+	}
+	switch viewerPermission {
+	case "ADMIN", "MAINTAIN", "WRITE":
+	default:
+		return nil, errors.New("attaching files requires write access to the repository")
+	}
+	return &Uploader{
+		httpClient:       httpClient,
+		host:             host,
+		targetRepository: targetRepository,
+	}, nil
+}
+
+// checkHost refuses a host whose user-attachments endpoint gh cannot reach.
+func checkHost(host string) error {
+	if ghauth.IsEnterprise(host) {
+		return errors.New("attaching files is not supported on GitHub Enterprise Server")
+	}
+	return nil
+}
+
+// uploadError is one file that did not reach the server.
+type uploadError struct {
+	Path       string
+	StatusCode int
+	msg        string
+	err        error
+}
+
+func (e *uploadError) Error() string {
+	return e.msg
+}
+
+func (e *uploadError) Unwrap() error {
+	return e.err
+}
+
+// upload posts one asset and returns the URL the server gave it.
+func (u *Uploader) upload(ctx context.Context, a UserAsset) (string, error) {
+	p := a.Path()
+	file, err := openFile(p)
+	if err != nil {
+		return "", &uploadError{
+			Path:       p,
+			StatusCode: 0,
+			msg:        "failed to upload " + p + ": " + sanitizeSingleLine(err.Error()),
+			err:        err,
+		}
+	}
+	defer file.Close()
+
+	q := url.Values{}
+	q.Set("content_type", a.getAsset().contentType)
+	q.Set("name", filepath.Base(p))
+	q.Set("repository_id", strconv.FormatInt(u.targetRepository, 10))
+
+	endpointURL := ghinstance.UserAssetUploadPrefix(u.host) + "user-attachments/assets?" + q.Encode()
+
+	req, err := http.NewRequestWithContext(ctx, "POST", endpointURL, file)
+	if err != nil {
+		return "", &uploadError{
+			Path:       p,
+			StatusCode: 0,
+			msg:        "failed to upload " + p + ": " + sanitizeSingleLine(err.Error()),
+			err:        err,
+		}
+	}
+
+	req.Header.Set("Content-Type", "application/octet-stream")
+	req.Header.Set("Accept", "application/vnd.github+json")
+	req.ContentLength = a.getAsset().info.Size()
+
+	resp, err := u.httpClient.Do(req)
+	if err != nil {
+		return "", &uploadError{
+			Path:       p,
+			StatusCode: 0,
+			msg:        "failed to upload " + p + ": " + sanitizeSingleLine(err.Error()),
+			err:        err,
+		}
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode == http.StatusNotFound {
+		return "", &uploadError{
+			Path:       p,
+			StatusCode: http.StatusNotFound,
+			msg:        "could not upload " + p + ": attaching files requires write access to the repository",
+		}
+	}
+
+	if resp.StatusCode == http.StatusTooManyRequests {
+		retryAfter := resp.Header.Get("Retry-After")
+		var reason string
+		if retryAfter == "" {
+			reason = "rate limited; wait and try again"
+		} else if _, err := strconv.Atoi(retryAfter); err == nil {
+			reason = "rate limited; retry after " + retryAfter + " seconds"
+		} else {
+			reason = "rate limited; retry after " + retryAfter
+		}
+		return "", &uploadError{
+			Path:       p,
+			StatusCode: http.StatusTooManyRequests,
+			msg:        "could not upload " + p + ": " + reason,
+		}
+	}
+
+	if resp.StatusCode == http.StatusUnprocessableEntity {
+		var valResp struct {
+			Message string `json:"message"`
+			Errors  []struct {
+				Resource string `json:"resource"`
+				Field    string `json:"field"`
+				Code     string `json:"code"`
+				Message  string `json:"message"`
+			} `json:"errors"`
+		}
+		_ = json.NewDecoder(resp.Body).Decode(&valResp)
+		var parts []string
+		if valResp.Message != "" {
+			parts = append(parts, valResp.Message)
+		}
+		for _, entry := range valResp.Errors {
+			if entry.Message != "" {
+				parts = append(parts, entry.Message)
+			} else {
+				parts = append(parts, fmt.Sprintf("%s.%s is %s", entry.Resource, entry.Field, entry.Code))
+			}
+		}
+		msg := "could not upload " + p
+		if len(parts) > 0 {
+			msg += ": " + strings.Join(parts, "; ")
+		}
+		return "", &uploadError{
+			Path:       p,
+			StatusCode: http.StatusUnprocessableEntity,
+			msg:        sanitizeSingleLine(msg),
+		}
+	}
+
+	if resp.StatusCode > 299 {
+		httpErr := api.HandleHTTPError(resp)
+		errMsg := ""
+		if httpErr != nil {
+			errMsg = httpErr.Error()
+		} else {
+			errMsg = resp.Status
+		}
+		return "", &uploadError{
+			Path:       p,
+			StatusCode: resp.StatusCode,
+			msg:        "failed to upload " + p + ": " + sanitizeSingleLine(errMsg),
+			err:        httpErr,
+		}
+	}
+
+	var successResp struct {
+		URL string `json:"url"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&successResp); err != nil {
+		return "", &uploadError{
+			Path:       p,
+			StatusCode: 0,
+			msg:        "failed to upload " + p + ": " + sanitizeSingleLine(err.Error()),
+			err:        err,
+		}
+	}
+	if successResp.URL == "" {
+		return "", &uploadError{
+			Path:       p,
+			StatusCode: 0,
+			msg:        "failed to upload " + p + ": the server returned no asset URL",
+		}
+	}
+
+	return successResp.URL, nil
+}
+
+func sanitizeSingleLine(s string) string {
+	s = strings.ReplaceAll(s, "\r\n", " ")
+	s = strings.ReplaceAll(s, "\r", " ")
+	s = strings.ReplaceAll(s, "\n", " ")
+	return s
+}
diff --git a/internal/attachments/flags.go b/internal/attachments/flags.go
new file mode 100644
index 000000000..f237437e4
--- /dev/null
+++ b/internal/attachments/flags.go
@@ -0,0 +1,88 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+)
+
+const flagName = "attach"
+
+// Flag is the --attach flag on a command that can attach files.
+type Flag struct {
+	values *[]string
+	flag   *pflag.Flag
+}
+
+// AddFlag registers --attach on cmd.
+func AddFlag(cmd *cobra.Command) *Flag {
+	values := cmd.Flags().StringArray(flagName, []string{}, "Attach an image or video `file`, in '<file>#<image alt text>' format")
+	return &Flag{
+		values: values,
+		flag:   cmd.Flags().Lookup(flagName),
+	}
+}
+
+// Changed reports whether --attach was passed.
+func (f *Flag) Changed() bool {
+	return f.flag.Changed
+}
+
+// UserAssets resolves every --attach value into a validated asset, in the
+// order the flags were written.
+func (f *Flag) UserAssets() ([]UserAsset, error) {
+	if f == nil || f.values == nil || len(*f.values) == 0 {
+		return nil, nil
+	}
+
+	var resolved []UserAsset
+	for _, raw := range *f.values {
+		if raw == "" {
+			return nil, errors.New("cannot attach an empty path; --attach needs a file path")
+		}
+		path, alt := splitAttachment(raw)
+		if path == "-" {
+			return nil, errors.New("cannot attach standard input; --attach needs a file path")
+		}
+		a, err := newAsset(path, alt)
+		if err != nil {
+			return nil, err
+		}
+		for _, prev := range resolved {
+			if os.SameFile(prev.getAsset().info, a.getAsset().info) {
+				return nil, fmt.Errorf("%s and %s are the same file; attached files must be unique", prev.Path(), a.Path())
+			}
+		}
+		resolved = append(resolved, a)
+	}
+
+	return resolved, nil
+}
+
+// splitAttachment splits a "<file>#<alt text>" value. A file name may itself
+// contain a "#", so the longest prefix that names an existing file wins; when
+// none does, the last "#" is the split.
+func splitAttachment(value string) (path, alt string) {
+	if _, err := os.Stat(value); err == nil {
+		return value, ""
+	}
+
+	for i := len(value) - 1; i >= 0; i-- {
+		if value[i] == '#' {
+			prefix := value[:i]
+			if _, err := os.Stat(prefix); err == nil {
+				return prefix, value[i+1:]
+			}
+		}
+	}
+
+	if last := strings.LastIndex(value, "#"); last != -1 {
+		return value[:last], value[last+1:]
+	}
+
+	return value, ""
+}
diff --git a/internal/attachments/references.go b/internal/attachments/references.go
new file mode 100644
index 000000000..e6e9ef50c
--- /dev/null
+++ b/internal/attachments/references.go
@@ -0,0 +1,786 @@
+package attachments
+
+import (
+	"fmt"
+	"net/url"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/yuin/goldmark"
+	"github.com/yuin/goldmark/ast"
+	"github.com/yuin/goldmark/text"
+)
+
+// attachmentArg is one attached file, the URL its upload produced, and how it
+// should render.
+type attachmentArg struct {
+	Path            string
+	URL             string
+	Alt             string
+	RendersAsPlayer bool
+}
+
+// attachableMarkdown is markdown that has been checked against a set of
+// attachments and can therefore be rewritten once they are uploaded.
+type attachableMarkdown struct {
+	markdown       string
+	attachmentArgs []attachmentArg
+}
+
+// attachedMarkdown is the rewritten body plus the attachments nothing referenced.
+type attachedMarkdown struct {
+	Rewritten string
+	ToAppend  []attachmentArg
+}
+
+// candidateTail records an inline link or image tail candidate in a leaf block.
+type candidateTail struct {
+	nodeStart  int
+	nodeEnd    int
+	labelStart int
+	labelEnd   int
+	destStart  int
+	destEnd    int
+	isImage    bool
+	destVal    string
+	block      ast.Node
+	blockStart int
+	blockStop  int
+}
+
+// edit describes a byte replacement in markdown.
+type edit struct {
+	start       int
+	end         int
+	replacement string
+	argIndex    int
+}
+
+// newAttachableMarkdown refuses markdown that the attachments cannot be written
+// into. On error it returns the zero attachableMarkdown.
+func newAttachableMarkdown(markdown string, attachmentArgs []attachmentArg) (attachableMarkdown, error) {
+	if len(attachmentArgs) == 0 {
+		return attachableMarkdown{
+			markdown:       markdown,
+			attachmentArgs: attachmentArgs,
+		}, nil
+	}
+
+	doc := parseMarkdown(markdown)
+	candidates := findInlineTails(markdown, doc)
+	astImages, astLinks := countASTNodes(doc, attachmentArgs)
+
+	inlineImageTails := make([]int, len(attachmentArgs))
+	inlineTails := make([]int, len(attachmentArgs))
+	for _, c := range candidates {
+		for i, arg := range attachmentArgs {
+			if pathsMatch(c.destVal, arg.Path) {
+				inlineTails[i]++
+				if c.isImage {
+					inlineImageTails[i]++
+				}
+				break
+			}
+		}
+	}
+
+	var offendingPaths []string
+	seenPaths := make(map[string]bool)
+	for i, arg := range attachmentArgs {
+		if !arg.RendersAsPlayer {
+			continue
+		}
+		hasRefImage := astImages[i] > inlineImageTails[i]
+		if hasRefImage && !seenPaths[arg.Path] {
+			seenPaths[arg.Path] = true
+			offendingPaths = append(offendingPaths, arg.Path)
+		}
+	}
+
+	if len(offendingPaths) > 0 {
+		_ = astLinks
+		return attachableMarkdown{}, fmt.Errorf("cannot embed a video as a reference-style image: %s", strings.Join(offendingPaths, ", "))
+	}
+
+	return attachableMarkdown{
+		markdown:       markdown,
+		attachmentArgs: attachmentArgs,
+	}, nil
+}
+
+// attachAssetsToMarkdown rewrites local asset references to uploaded URLs.
+func attachAssetsToMarkdown(v attachableMarkdown) (attachedMarkdown, error) {
+	if len(v.attachmentArgs) == 0 {
+		return attachedMarkdown{
+			Rewritten: v.markdown,
+			ToAppend:  nil,
+		}, nil
+	}
+
+	doc := parseMarkdown(v.markdown)
+	candidates := findInlineTails(v.markdown, doc)
+	astImages, astLinks := countASTNodes(doc, v.attachmentArgs)
+
+	inlineTails := make([]int, len(v.attachmentArgs))
+	inlineImageTails := make([]int, len(v.attachmentArgs))
+	for _, c := range candidates {
+		for i, arg := range v.attachmentArgs {
+			if pathsMatch(c.destVal, arg.Path) {
+				inlineTails[i]++
+				if c.isImage {
+					inlineImageTails[i]++
+				}
+				break
+			}
+		}
+	}
+
+	hasRefUsage := make([]bool, len(v.attachmentArgs))
+	for i := range v.attachmentArgs {
+		hasRefUsage[i] = (astImages[i] + astLinks[i]) > inlineTails[i]
+	}
+
+	var edits []edit
+
+	// 1. Process inline tail candidates.
+	for _, c := range candidates {
+		matchedArgIdx := -1
+		for i, arg := range v.attachmentArgs {
+			if arg.URL != "" && pathsMatch(c.destVal, arg.Path) {
+				matchedArgIdx = i
+				break
+			}
+		}
+		if matchedArgIdx == -1 {
+			continue
+		}
+
+		arg := v.attachmentArgs[matchedArgIdx]
+
+		if !c.isImage || !arg.RendersAsPlayer {
+			edits = append(edits, edit{
+				start:       c.destStart,
+				end:         c.destEnd,
+				replacement: arg.URL,
+				argIndex:    matchedArgIdx,
+			})
+			continue
+		}
+
+		// Candidate is an image of an arg that renders as a player (video embed).
+		if isAloneInParagraph(c, v.markdown) {
+			// Discard any existing edit contained within [c.nodeStart, c.nodeEnd).
+			filtered := edits[:0]
+			for _, e := range edits {
+				if e.start >= c.nodeStart && e.end <= c.nodeEnd {
+					continue
+				}
+				filtered = append(filtered, e)
+			}
+			edits = filtered
+
+			edits = append(edits, edit{
+				start:       c.nodeStart,
+				end:         c.nodeEnd,
+				replacement: arg.URL,
+				argIndex:    matchedArgIdx,
+			})
+		} else {
+			// Degrade to link.
+			if c.nodeStart > 0 && v.markdown[c.nodeStart-1] == '!' && !isEscaped(v.markdown, c.nodeStart-1) {
+				edits = append(edits, edit{
+					start:       c.nodeStart - 1,
+					end:         c.nodeStart + 1,
+					replacement: `\!`,
+					argIndex:    matchedArgIdx,
+				})
+			} else {
+				edits = append(edits, edit{
+					start:       c.nodeStart,
+					end:         c.nodeStart + 1,
+					replacement: "",
+					argIndex:    matchedArgIdx,
+				})
+			}
+
+			if c.labelStart == c.labelEnd {
+				edits = append(edits, edit{
+					start:       c.labelStart,
+					end:         c.labelStart,
+					replacement: escapeAltText(arg.Alt),
+					argIndex:    matchedArgIdx,
+				})
+			}
+
+			edits = append(edits, edit{
+				start:       c.destStart,
+				end:         c.destEnd,
+				replacement: arg.URL,
+				argIndex:    matchedArgIdx,
+			})
+		}
+	}
+
+	// 2. Process link reference definitions.
+	codeBlockRanges := findCodeBlockRanges(doc)
+	lines := splitMarkdownLines(v.markdown)
+	for _, l := range lines {
+		if lineInRanges(l.start, l.end, codeBlockRanges) {
+			continue
+		}
+		destStart, destEnd, destVal, ok := parseReferenceDefinition(v.markdown, l.start, l.end)
+		if !ok {
+			continue
+		}
+		for i, arg := range v.attachmentArgs {
+			if arg.URL != "" && hasRefUsage[i] && pathsMatch(destVal, arg.Path) {
+				edits = append(edits, edit{
+					start:       destStart,
+					end:         destEnd,
+					replacement: arg.URL,
+					argIndex:    i,
+				})
+				break
+			}
+		}
+	}
+
+	// 3. Output generation and tracking referenced args.
+	sort.SliceStable(edits, func(i, j int) bool {
+		if edits[i].start != edits[j].start {
+			return edits[i].start < edits[j].start
+		}
+		return edits[i].end < edits[j].end
+	})
+
+	referenced := make([]bool, len(v.attachmentArgs))
+	var sb strings.Builder
+	lastPos := 0
+	for _, e := range edits {
+		if e.start < lastPos {
+			continue
+		}
+		if e.argIndex >= 0 {
+			referenced[e.argIndex] = true
+		}
+		sb.WriteString(v.markdown[lastPos:e.start])
+		sb.WriteString(e.replacement)
+		lastPos = e.end
+	}
+	sb.WriteString(v.markdown[lastPos:])
+
+	var toAppend []attachmentArg
+	for i, arg := range v.attachmentArgs {
+		if arg.URL != "" && !referenced[i] {
+			toAppend = append(toAppend, arg)
+		}
+	}
+
+	return attachedMarkdown{
+		Rewritten: sb.String(),
+		ToAppend:  toAppend,
+	}, nil
+}
+
+// isSingleImage reports whether markdown is exactly one image embed pointing at url.
+func isSingleImage(markdown, url string) bool {
+	doc := parseMarkdown(markdown)
+	firstChild := doc.FirstChild()
+	if firstChild == nil || firstChild.NextSibling() != nil {
+		return false
+	}
+	p, ok := firstChild.(*ast.Paragraph)
+	if !ok {
+		return false
+	}
+	pChild := p.FirstChild()
+	if pChild == nil || pChild.NextSibling() != nil {
+		return false
+	}
+	img, ok := pChild.(*ast.Image)
+	if !ok {
+		return false
+	}
+	return string(img.Destination) == url
+}
+
+func parseMarkdown(source string) ast.Node {
+	md := goldmark.New()
+	reader := text.NewReader([]byte(source))
+	return md.Parser().Parse(reader)
+}
+
+// findInlineTails scans all leaf blocks for inline link and image tails.
+func findInlineTails(source string, doc ast.Node) []candidateTail {
+	var candidates []candidateTail
+
+	var leafBlocks []ast.Node
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		switch n.Kind() {
+		case ast.KindParagraph, ast.KindHeading, ast.KindTextBlock:
+			leafBlocks = append(leafBlocks, n)
+			return ast.WalkSkipChildren, nil
+		}
+		return ast.WalkContinue, nil
+	})
+
+	for _, block := range leafBlocks {
+		if block.Lines().Len() == 0 {
+			continue
+		}
+		blockStart := block.Lines().At(0).Start
+		blockStop := block.Lines().At(block.Lines().Len() - 1).Stop
+
+		var skipRegions [][2]int
+		_ = ast.Walk(block, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+			if !entering {
+				return ast.WalkContinue, nil
+			}
+			if cs, ok := n.(*ast.CodeSpan); ok {
+				var firstText, lastText *ast.Text
+				for child := cs.FirstChild(); child != nil; child = child.NextSibling() {
+					if t, ok := child.(*ast.Text); ok {
+						if firstText == nil {
+							firstText = t
+						}
+						lastText = t
+					}
+				}
+				if firstText != nil && lastText != nil {
+					skipRegions = append(skipRegions, [2]int{firstText.Segment.Start, lastText.Segment.Stop})
+				}
+				return ast.WalkSkipChildren, nil
+			}
+			return ast.WalkContinue, nil
+		})
+
+		var bracketStack []int
+		i := blockStart
+		for i < blockStop {
+			if skipEnd, inSkip := inSkipRange(i, skipRegions); inSkip {
+				i = skipEnd
+				continue
+			}
+
+			if source[i] == '[' && !isEscaped(source, i) {
+				bracketStack = append(bracketStack, i)
+				i++
+				continue
+			}
+
+			if source[i] == ']' && !isEscaped(source, i) && i+1 < blockStop && source[i+1] == '(' {
+				if len(bracketStack) == 0 {
+					i++
+					continue
+				}
+				openBracket := bracketStack[len(bracketStack)-1]
+				bracketStack = bracketStack[:len(bracketStack)-1]
+
+				destStart, destEnd, destVal, nodeEnd, valid := parseDestinationAndTitle(source, blockStop, i)
+				if !valid {
+					i++
+					continue
+				}
+
+				isImage := false
+				nodeStart := openBracket
+				if openBracket > blockStart && source[openBracket-1] == '!' && !isEscaped(source, openBracket-1) {
+					isImage = true
+					nodeStart = openBracket - 1
+				}
+
+				candidates = append(candidates, candidateTail{
+					nodeStart:  nodeStart,
+					nodeEnd:    nodeEnd,
+					labelStart: openBracket + 1,
+					labelEnd:   i,
+					destStart:  destStart,
+					destEnd:    destEnd,
+					isImage:    isImage,
+					destVal:    destVal,
+					block:      block,
+					blockStart: blockStart,
+					blockStop:  blockStop,
+				})
+
+				i = nodeEnd
+				continue
+			}
+
+			i++
+		}
+	}
+
+	return candidates
+}
+
+func parseDestinationAndTitle(source string, blockStop, i int) (destStart, destEnd int, destVal string, nodeEnd int, valid bool) {
+	p := i + 2
+	if p > blockStop {
+		return 0, 0, "", 0, false
+	}
+
+	if p < blockStop && source[p] == '<' {
+		destStart = p
+		closeIdx := -1
+		for k := p + 1; k < blockStop; k++ {
+			if source[k] == '>' && !isEscaped(source, k) {
+				closeIdx = k
+				break
+			}
+		}
+		if closeIdx == -1 {
+			return 0, 0, "", 0, false
+		}
+		destEnd = closeIdx + 1
+		destVal = removeBackslashEscapes([]byte(source[p+1 : closeIdx]))
+		p = destEnd
+	} else {
+		destStart = p
+		depth := 0
+		destEnd = -1
+		for k := p; k < blockStop; k++ {
+			if isEscaped(source, k) {
+				continue
+			}
+			c := source[k]
+			if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
+				if depth == 0 {
+					destEnd = k
+					break
+				}
+			} else if c == '(' {
+				depth++
+			} else if c == ')' {
+				if depth == 0 {
+					destEnd = k
+					break
+				}
+				depth--
+			}
+		}
+		if depth > 0 || destEnd == -1 {
+			return 0, 0, "", 0, false
+		}
+		destVal = removeBackslashEscapes([]byte(source[destStart:destEnd]))
+		p = destEnd
+	}
+
+	for p < blockStop && isASCIIWhitespace(source[p]) {
+		p++
+	}
+
+	if p < blockStop && (source[p] == '"' || source[p] == '\'' || source[p] == '(') {
+		openQuote := source[p]
+		closeQuote := openQuote
+		if openQuote == '(' {
+			closeQuote = ')'
+		}
+		titleEnd := -1
+		for k := p + 1; k < blockStop; k++ {
+			if source[k] == closeQuote && !isEscaped(source, k) {
+				titleEnd = k
+				break
+			}
+		}
+		if titleEnd == -1 {
+			return 0, 0, "", 0, false
+		}
+		p = titleEnd + 1
+		for p < blockStop && isASCIIWhitespace(source[p]) {
+			p++
+		}
+	}
+
+	if p >= blockStop || source[p] != ')' {
+		return 0, 0, "", 0, false
+	}
+
+	nodeEnd = p + 1
+	valid = true
+	return
+}
+
+func countASTNodes(doc ast.Node, attachmentArgs []attachmentArg) (astImages, astLinks []int) {
+	astImages = make([]int, len(attachmentArgs))
+	astLinks = make([]int, len(attachmentArgs))
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		switch node := n.(type) {
+		case *ast.Image:
+			dest := string(node.Destination)
+			for i, arg := range attachmentArgs {
+				if pathsMatch(dest, arg.Path) {
+					astImages[i]++
+				}
+			}
+		case *ast.Link:
+			dest := string(node.Destination)
+			for i, arg := range attachmentArgs {
+				if pathsMatch(dest, arg.Path) {
+					astLinks[i]++
+				}
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+	return astImages, astLinks
+}
+
+func isAloneInParagraph(c candidateTail, markdown string) bool {
+	if _, ok := c.block.(*ast.Paragraph); !ok {
+		return false
+	}
+	for k := c.blockStart; k < c.nodeStart; k++ {
+		if !isASCIIWhitespace(markdown[k]) {
+			return false
+		}
+	}
+	for k := c.nodeEnd; k < c.blockStop; k++ {
+		if !isASCIIWhitespace(markdown[k]) {
+			return false
+		}
+	}
+	return true
+}
+
+func findCodeBlockRanges(doc ast.Node) [][2]int {
+	var ranges [][2]int
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		switch block := n.(type) {
+		case *ast.FencedCodeBlock:
+			if block.Lines().Len() > 0 {
+				start := block.Lines().At(0).Start
+				stop := block.Lines().At(block.Lines().Len() - 1).Stop
+				ranges = append(ranges, [2]int{start, stop})
+			}
+		case *ast.CodeBlock:
+			if block.Lines().Len() > 0 {
+				start := block.Lines().At(0).Start
+				stop := block.Lines().At(block.Lines().Len() - 1).Stop
+				ranges = append(ranges, [2]int{start, stop})
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+	return ranges
+}
+
+type lineSpan struct {
+	start int
+	end   int
+}
+
+func splitMarkdownLines(source string) []lineSpan {
+	var lines []lineSpan
+	lineStart := 0
+	for lineStart < len(source) {
+		newlineIdx := strings.IndexByte(source[lineStart:], '\n')
+		if newlineIdx == -1 {
+			lines = append(lines, lineSpan{start: lineStart, end: len(source)})
+			break
+		}
+		lineEnd := lineStart + newlineIdx + 1
+		lines = append(lines, lineSpan{start: lineStart, end: lineEnd})
+		lineStart = lineEnd
+	}
+	return lines
+}
+
+func lineInRanges(start, end int, ranges [][2]int) bool {
+	for _, r := range ranges {
+		if start >= r[0] && start < r[1] {
+			return true
+		}
+	}
+	return false
+}
+
+func parseReferenceDefinition(source string, lineStart, lineEnd int) (destStart, destEnd int, destVal string, ok bool) {
+	contentEnd := lineEnd
+	if contentEnd > lineStart && source[contentEnd-1] == '\n' {
+		contentEnd--
+	}
+	if contentEnd > lineStart && source[contentEnd-1] == '\r' {
+		contentEnd--
+	}
+
+	idx := lineStart
+	for idx < contentEnd && (source[idx] == ' ' || source[idx] == '\t') {
+		idx++
+	}
+
+	for idx < contentEnd && source[idx] == '>' {
+		idx++
+		if idx < contentEnd && source[idx] == ' ' {
+			idx++
+		}
+		for idx < contentEnd && (source[idx] == ' ' || source[idx] == '\t') {
+			idx++
+		}
+	}
+
+	if idx >= contentEnd || source[idx] != '[' {
+		return 0, 0, "", false
+	}
+
+	closeBracketIdx := -1
+	for k := idx + 1; k < contentEnd; k++ {
+		if source[k] == ']' && !isEscaped(source, k) {
+			closeBracketIdx = k
+			break
+		}
+	}
+	if closeBracketIdx == -1 || closeBracketIdx+1 >= contentEnd || source[closeBracketIdx+1] != ':' {
+		return 0, 0, "", false
+	}
+
+	idx = closeBracketIdx + 2
+	for idx < contentEnd && (source[idx] == ' ' || source[idx] == '\t') {
+		idx++
+	}
+	if idx >= contentEnd {
+		return 0, 0, "", false
+	}
+
+	if source[idx] == '<' {
+		destStart = idx
+		closeAngle := -1
+		for k := idx + 1; k < contentEnd; k++ {
+			if source[k] == '>' && !isEscaped(source, k) {
+				closeAngle = k
+				break
+			}
+		}
+		if closeAngle == -1 {
+			return 0, 0, "", false
+		}
+		destEnd = closeAngle + 1
+		destVal = removeBackslashEscapes([]byte(source[idx+1 : closeAngle]))
+	} else {
+		destStart = idx
+		k := idx
+		for k < contentEnd && source[k] != ' ' && source[k] != '\t' {
+			k++
+		}
+		destEnd = k
+		destVal = removeBackslashEscapes([]byte(source[destStart:destEnd]))
+	}
+
+	if destStart == destEnd || len(destVal) == 0 {
+		return 0, 0, "", false
+	}
+
+	return destStart, destEnd, destVal, true
+}
+
+func pathsMatch(dest, argPath string) bool {
+	d, ok1 := normalizePath(dest)
+	if !ok1 {
+		return false
+	}
+	a, ok2 := normalizePath(argPath)
+	if !ok2 {
+		return false
+	}
+	for _, cand := range destCandidates(d) {
+		if cand == a {
+			return true
+		}
+		absD, errD := filepath.Abs(cand)
+		absA, errA := filepath.Abs(a)
+		if errD == nil && errA == nil && absD == absA {
+			return true
+		}
+	}
+	return false
+}
+
+func destCandidates(dest string) []string {
+	unescaped := removeBackslashEscapes([]byte(dest))
+	if unescaped != dest {
+		return []string{dest, unescaped}
+	}
+	return []string{dest}
+}
+
+func normalizePath(s string) (string, bool) {
+	if len(s) == 0 || strings.HasPrefix(s, "#") || strings.HasPrefix(s, "//") {
+		return "", false
+	}
+	if colonIdx := strings.Index(s, ":"); colonIdx > 1 {
+		prefix := s[:colonIdx]
+		if isLetter(prefix[0]) && isSchemeRest(prefix[1:]) {
+			return "", false
+		}
+	}
+	if unescaped, err := url.PathUnescape(s); err == nil {
+		s = unescaped
+	}
+	return s, true
+}
+
+func isLetter(c byte) bool {
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+func isSchemeRest(s string) bool {
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if !isLetter(c) && !(c >= '0' && c <= '9') && c != '+' && c != '-' && c != '.' {
+			return false
+		}
+	}
+	return true
+}
+
+func inSkipRange(pos int, ranges [][2]int) (int, bool) {
+	for _, r := range ranges {
+		if pos >= r[0] && pos < r[1] {
+			return r[1], true
+		}
+	}
+	return 0, false
+}
+
+func isEscaped(source string, pos int) bool {
+	count := 0
+	for k := pos - 1; k >= 0; k-- {
+		if source[k] == '\\' {
+			count++
+		} else {
+			break
+		}
+	}
+	return count%2 == 1
+}
+
+func isASCIIPunctuation(c byte) bool {
+	return (c >= 33 && c <= 47) || (c >= 58 && c <= 64) || (c >= 91 && c <= 96) || (c >= 123 && c <= 126)
+}
+
+func isASCIIWhitespace(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f'
+}
+
+func removeBackslashEscapes(raw []byte) string {
+	var sb strings.Builder
+	for i := 0; i < len(raw); i++ {
+		if raw[i] == '\\' && i+1 < len(raw) && isASCIIPunctuation(raw[i+1]) {
+			sb.WriteByte(raw[i+1])
+			i++
+		} else {
+			sb.WriteByte(raw[i])
+		}
+	}
+	return sb.String()
+}
