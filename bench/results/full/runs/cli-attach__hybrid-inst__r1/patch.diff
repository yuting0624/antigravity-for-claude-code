+package attachments
+
+import (
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/httpmock"
+)
+
+// UploadStub describes one stubbed upload response for tests.
+type UploadStub struct {
+	Name   string
+	Status int
+	Body   string
+}
+
+// StubUpload registers a stubbed upload of name to repositoryID on any host for tests.
+func StubUpload(reg *httpmock.Registry, repositoryID int64, name string, status int, body string) {
+	repoIDStr := strconv.FormatInt(repositoryID, 10)
+	reg.Register(
+		func(req *http.Request) bool {
+			if !strings.EqualFold(req.Method, "POST") {
+				return false
+			}
+			if !strings.HasSuffix(req.URL.Path, "/user-attachments/assets") {
+				return false
+			}
+			q := req.URL.Query()
+			return q.Get("name") == name && q.Get("repository_id") == repoIDStr
+		},
+		httpmock.StatusStringResponse(status, body),
+	)
+}
+
+// StubUploadToHost registers a stubbed upload that only matches requests to host for tests.
+func StubUploadToHost(t *testing.T, reg *httpmock.Registry, host string, repositoryID int64, name string, status int, body string) {
+	t.Helper()
+	repoIDStr := strconv.FormatInt(repositoryID, 10)
+	reg.Register(
+		func(req *http.Request) bool {
+			if req.URL.Host != host {
+				return false
+			}
+			if !strings.EqualFold(req.Method, "POST") {
+				return false
+			}
+			if !strings.HasSuffix(req.URL.Path, "/user-attachments/assets") {
+				return false
+			}
+			q := req.URL.Query()
+			return q.Get("name") == name && q.Get("repository_id") == repoIDStr
+		},
+		httpmock.StatusStringResponse(status, body),
+	)
+}
+
+// NewTestAssets writes each name into a fresh working directory and resolves it,
+// so a test can attach real files. It is intended for tests.
+func NewTestAssets(t *testing.T, names ...string) []UserAsset {
+	t.Helper()
+	t.Chdir(t.TempDir())
+	assets := make([]UserAsset, 0, len(names))
+	for _, name := range names {
+		if err := os.WriteFile(name, []byte("the bytes"), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		a, err := newAsset("./"+name, "")
+		if err != nil {
+			t.Fatal(err)
+		}
+		assets = append(assets, a)
+	}
+	return assets
+}
diff --git a/internal/attachments/userasset.go b/internal/attachments/userasset.go
