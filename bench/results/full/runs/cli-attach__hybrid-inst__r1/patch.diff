@@ -0,0 +1,147 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+const (
+	maxImageBytes = 10 * 1024 * 1024
+	maxVideoBytes = 100 * 1024 * 1024
+)
+
+// UserAsset is a local file gh can attach.
+type UserAsset interface {
+	// Path is the path the user typed.
+	Path() string
+	getAsset() *asset
+	// markdown renders the asset at the uploaded URL.
+	markdown(assetURL string) string
+	// rendersAsPlayer reports whether a bare URL renders as a player.
+	rendersAsPlayer() bool
+}
+
+type asset struct {
+	path        string
+	alt         string
+	contentType string
+	info        fs.FileInfo
+}
+
+func (a *asset) Path() string     { return a.path }
+func (a *asset) getAsset() *asset { return a }
+
+type imageAsset struct {
+	asset
+}
+
+type videoAsset struct {
+	asset
+}
+
+func (a *imageAsset) rendersAsPlayer() bool {
+	return false
+}
+
+func (a *videoAsset) rendersAsPlayer() bool {
+	return true
+}
+
+func (a *imageAsset) markdown(assetURL string) string {
+	return "![" + escapeAltText(a.alt) + "](" + assetURL + ")"
+}
+
+func (a *videoAsset) markdown(assetURL string) string {
+	return assetURL
+}
+
+func escapeAltText(alt string) string {
+	s := strings.ReplaceAll(alt, `\`, `\\`)
+	s = strings.ReplaceAll(s, `[`, `\[`)
+	s = strings.ReplaceAll(s, `]`, `\]`)
+	s = strings.ReplaceAll(s, "\r", " ")
+	s = strings.ReplaceAll(s, "\n", " ")
+	return s
+}
+
+var mediaTypes = map[string]string{
+	"png":  "image/png",
+	"jpg":  "image/jpeg",
+	"jpeg": "image/jpeg",
+	"gif":  "image/gif",
+	"webp": "image/webp",
+	"svg":  "image/svg+xml",
+	"mp4":  "video/mp4",
+	"mov":  "video/quicktime",
+	"webm": "video/webm",
+}
+
+// newAsset validates path and describes how it will be attached. It reads
+// metadata only; the bytes are read at upload time.
+func newAsset(path, alt string) (UserAsset, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		var pathErr *fs.PathError
+		if errors.As(err, &pathErr) {
+			return nil, fmt.Errorf("%s: %w", path, pathErr.Err)
+		}
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+
+	if info.IsDir() {
+		return nil, fmt.Errorf("%s is a directory", path)
+	}
+
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%s is not a regular file", path)
+	}
+
+	ext := strings.ToLower(filepath.Ext(path))
+	ext = strings.TrimPrefix(ext, ".")
+	contentType, ok := mediaTypes[ext]
+	if !ok {
+		return nil, fmt.Errorf("%s is not a supported file type (supported: png, jpg, jpeg, gif, webp, svg, mp4, mov, webm)", path)
+	}
+
+	if info.Size() == 0 {
+		return nil, fmt.Errorf("%s is empty", path)
+	}
+
+	isVideo := strings.HasPrefix(contentType, "video/")
+	if !isVideo && info.Size() > maxImageBytes {
+		return nil, fmt.Errorf("%s: images must be at most %.1f MB", path, float64(maxImageBytes)/(1024*1024))
+	}
+	if isVideo && info.Size() > maxVideoBytes {
+		return nil, fmt.Errorf("%s: videos must be at most %.1f MB", path, float64(maxVideoBytes)/(1024*1024))
+	}
+
+	if isVideo && alt != "" {
+		return nil, errors.New("cannot set alt text on video")
+	}
+
+	if alt == "" {
+		if isVideo {
+			alt = filepath.Base(path)
+		} else {
+			base := filepath.Base(path)
+			nameWithoutExt := strings.TrimSuffix(base, filepath.Ext(base))
+			alt = strings.ReplaceAll(nameWithoutExt, ".", " ")
+		}
+	}
+
+	baseAsset := asset{
+		path:        path,
+		alt:         alt,
+		contentType: contentType,
+		info:        info,
+	}
+
+	if isVideo {
+		return &videoAsset{asset: baseAsset}, nil
+	}
+	return &imageAsset{asset: baseAsset}, nil
+}
