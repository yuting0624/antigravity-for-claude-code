 	err := s.serveHTTP(w, r)
 	duration = time.Since(start)
 
@@ -779,6 +818,59 @@ func (s *Server) serveHTTP(w http.ResponseWriter, r *http.Request) error {
 	return s.primaryHandlerChain.ServeHTTP(w, r)
 }
 
+// wrapIdleTimeouts wraps the request body and the response writer so that the
+// read and write deadlines of the connection are reset on every successful
+// transfer, bounded both by the hard ReadTimeout/WriteTimeout (if any) and by
+// the configured minimum transfer rates. w and r are returned unchanged if no
+// idle timeout or minimum rate is configured.
+func (s *Server) wrapIdleTimeouts(start time.Time, w http.ResponseWriter, r *http.Request) (http.ResponseWriter, *http.Request) {
+	readOn := s.ReadIdleTimeout > 0 || s.ReadMinRate > 0
+	writeOn := s.WriteIdleTimeout > 0 || s.WriteMinRate > 0
+	if !readOn && !writeOn {
+		return w, r
+	}
+
+	//nolint:bodyclose
+	ctrl := http.NewResponseController(w)
+
+	if readOn && r.Body != nil {
+		deadline := IdleDeadline{
+			Start:   start,
+			Timeout: time.Duration(s.ReadIdleTimeout),
+			MinRate: s.ReadMinRate,
+		}
+		if s.ReadTimeout > 0 {
+			deadline.HardDeadline = start.Add(time.Duration(s.ReadTimeout))
+		}
+		r.Body = &IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       ctrl,
+			Deadline:   deadline,
+			Logger:     s.logger,
+		}
+	}
+
+	if writeOn {
+		deadline := IdleDeadline{
+			Start:   start,
+			Timeout: time.Duration(s.WriteIdleTimeout),
+			MinRate: s.WriteMinRate,
+		}
+		if s.WriteTimeout > 0 {
+			deadline.HardDeadline = start.Add(time.Duration(s.WriteTimeout))
+		}
+		w = &IdleTimeoutWriter{
+			ResponseWriterWrapper: &ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  ctrl,
+			Deadline:              deadline,
+			MaxChunk:              s.MaxWriteChunk,
+			Logger:                s.logger,
+		}
+	}
+
+	return w, r
+}
+
