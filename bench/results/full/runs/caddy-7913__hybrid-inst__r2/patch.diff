+
+package caddyhttp
+
+import (
+	"bufio"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+)
+
+// DefaultMaxWriteChunk is the default maximum number of bytes written to the
+// underlying connection by a single write while an idle write deadline is in
+// effect. A write deadline bounds the whole write call it precedes, not merely
+// a stall within it, so large writes are split into chunks of at most this
+// size, with the deadline reset between them.
+const DefaultMaxWriteChunk = 64 * 1024
+
+// IdleDeadline describes how to compute the deadline to install before each
+// read or write of a transfer. Unlike a hard deadline, which bounds the whole
+// transfer, it is recomputed as bytes move, so a connection that keeps making
+// progress is not punished for being slow -- only one that stops making
+// progress, or that never sustains a required minimum rate, is cut off.
+type IdleDeadline struct {
+	// Start is when the transfer began. It is the fixed base from which the
+	// MinRate allowance grows. If zero, it is filled in on first use.
+	Start time.Time
+
+	// Timeout is the idle window: the deadline is pushed out to now+Timeout
+	// before every read or write. Zero disables the idle window.
+	Timeout time.Duration
+
+	// MinRate is the minimum acceptable transfer rate, in bytes per second.
+	// Zero disables the rate floor.
+	MinRate int64
+
+	// HardDeadline, if non-zero, is an absolute ceiling: the computed
+	// deadline is never allowed past it.
+	HardDeadline time.Time
+}
+
+// next returns the deadline to install before the next read or write, given
+// the current time and the number of bytes transferred so far.
+func (d IdleDeadline) next(now time.Time, transferred int64) time.Time {
+	var deadline time.Time
+	if d.Timeout > 0 {
+		deadline = now.Add(d.Timeout)
+	}
+	if d.MinRate > 0 {
+		start := d.Start
+		if start.IsZero() {
+			start = now
+		}
+		// the allowance grows from the fixed start: the idle window serves as
+		// the initial grace, plus a second of extra credit for every MinRate
+		// bytes actually moved
+		allowed := d.Timeout + time.Duration(float64(transferred)/float64(d.MinRate)*float64(time.Second))
+		rateDeadline := start.Add(allowed)
+		if deadline.IsZero() || rateDeadline.Before(deadline) {
+			deadline = rateDeadline
+		}
+	}
+	if !d.HardDeadline.IsZero() && (deadline.IsZero() || d.HardDeadline.Before(deadline)) {
+		deadline = d.HardDeadline
+	}
+	return deadline
+}
+
+// IdleTimeoutReader wraps a request body and resets the read deadline of the
+// connection before every read, so a stalled upload is cut off while a slow
+// but steadily progressing one survives.
+type IdleTimeoutReader struct {
+	// ReadCloser is the underlying request body.
+	io.ReadCloser
+
+	// Ctrl is the response controller used to set the read deadline.
+	Ctrl *http.ResponseController
+
+	// Deadline describes how the read deadline is computed.
+	Deadline IdleDeadline
+
+	// Logger logs deadlines that could not be set.
+	Logger *zap.Logger
+
+	read int64
+}
+
+// Read implements io.Reader, resetting the read deadline before each read.
+func (r *IdleTimeoutReader) Read(p []byte) (int, error) {
+	if r.Deadline.Start.IsZero() {
+		r.Deadline.Start = time.Now()
+	}
+	setDeadline(r.Ctrl.SetReadDeadline, r.Deadline.next(time.Now(), r.read), "read", r.Logger)
+	n, err := r.ReadCloser.Read(p)
+	r.read += int64(n)
+	return n, err
+}
+
+// Close implements io.Closer. It clears the deadline we installed so that it
+// cannot leak into the next request on a keep-alive connection.
+func (r *IdleTimeoutReader) Close() error {
+	_ = r.Ctrl.SetReadDeadline(time.Time{})
+	return r.ReadCloser.Close()
+}
+
+// IdleTimeoutWriter wraps a response writer and resets the write deadline of
+// the connection before every write, chunking large writes so that no single
+// write call can outlive one deadline window.
+type IdleTimeoutWriter struct {
+	// ResponseWriterWrapper is the underlying response writer.
+	*ResponseWriterWrapper
+
+	// Ctrl is the response controller used to set the write deadline.
+	Ctrl *http.ResponseController
+
+	// Deadline describes how the write deadline is computed.
+	Deadline IdleDeadline
+
+	// MaxChunk is the largest number of bytes covered by a single underlying
+	// write; if zero, DefaultMaxWriteChunk is used.
+	MaxChunk int
+
+	// Logger logs deadlines that could not be set.
+	Logger *zap.Logger
+
+	written int64
+}
+
+func (w *IdleTimeoutWriter) maxChunk() int {
+	if w.MaxChunk > 0 {
+		return w.MaxChunk
+	}
+	return DefaultMaxWriteChunk
+}
+
+func (w *IdleTimeoutWriter) resetDeadline() {
+	if w.Deadline.Start.IsZero() {
+		w.Deadline.Start = time.Now()
+	}
+	setDeadline(w.Ctrl.SetWriteDeadline, w.Deadline.next(time.Now(), w.written), "write", w.Logger)
+}
+
+// WriteHeader implements http.ResponseWriter.
+func (w *IdleTimeoutWriter) WriteHeader(statusCode int) {
+	w.resetDeadline()
+	w.ResponseWriterWrapper.WriteHeader(statusCode)
+}
+
+// Write implements http.ResponseWriter. It splits p into chunks of at most
+// maxChunk bytes, resetting the write deadline before each one.
+func (w *IdleTimeoutWriter) Write(p []byte) (int, error) {
+	maxSize := w.maxChunk()
+	var total int
+	for {
+		chunk := p[total:]
+		if len(chunk) > maxSize {
+			chunk = chunk[:maxSize]
+		}
+		w.resetDeadline()
+		n, err := w.ResponseWriterWrapper.Write(chunk)
+		total += n
+		w.written += int64(n)
+		if err != nil {
+			return total, err
+		}
+		if total >= len(p) {
+			return total, nil
+		}
+	}
+}
+
+// ReadFrom implements io.ReaderFrom, bounding each underlying ReadFrom call to
+// maxChunk bytes so the fast path cannot outlive a single deadline window.
+func (w *IdleTimeoutWriter) ReadFrom(r io.Reader) (int64, error) {
+	maxSize := int64(w.maxChunk())
+	var total int64
+	for {
+		w.resetDeadline()
+		n, err := w.ResponseWriterWrapper.ReadFrom(io.LimitReader(r, maxSize))
+		total += n
+		w.written += n
+		if err != nil {
+			return total, err
+		}
+		if n < maxSize {
+			return total, nil
+		}
+	}
+}
+
+// Hijack implements http.Hijacker. A hijacked connection is no longer governed
+// by this response writer, so the deadlines we installed are cleared before
+// handing it over.
+func (w *IdleTimeoutWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	_ = w.Ctrl.SetWriteDeadline(time.Time{})
+	_ = w.Ctrl.SetReadDeadline(time.Time{})
+	return w.Ctrl.Hijack()
+}
+
+// setDeadline installs t using set, logging failures. Transports that do not
+// support deadlines (some HTTP/3 stacks, for example) are logged at debug
+// level only, since they would otherwise be noisy on every write.
+func setDeadline(set func(time.Time) error, t time.Time, kind string, logger *zap.Logger) {
+	err := set(t)
+	if err == nil || logger == nil {
+		return
+	}
+	level := zapcore.ErrorLevel
+	if errors.Is(err, http.ErrNotSupported) {
+		level = zapcore.DebugLevel
+	}
+	if c := logger.Check(level, "could not set "+kind+" deadline"); c != nil {
+		c.Write(zap.Error(err))
+	}
+}
+
+// Interface guards
+var (
+	_ io.ReadCloser       = (*IdleTimeoutReader)(nil)
+	_ http.ResponseWriter = (*IdleTimeoutWriter)(nil)
+	_ io.ReaderFrom       = (*IdleTimeoutWriter)(nil)
+	_ http.Hijacker       = (*IdleTimeoutWriter)(nil)
+)
