+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/caddyconfig/caddyfile"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func init() {
+	caddy.RegisterModule(Timeouts{})
+}
+
+// Timeouts applies idle-reset read and write deadlines, plus optional minimum
+// transfer rates, to a single route -- mitigating slowloris-style clients without
+// the collateral damage of the hard server-wide read and write timeouts.
+type Timeouts struct {
+	// ReadTimeout is how long to wait for progress while reading the request
+	// body. The deadline is reset after every successful read, so a slow but
+	// steadily progressing upload is not cut off; only a stalled one is.
+	ReadTimeout time.Duration `json:"read_timeout,omitempty"`
+
+	// ReadMinRate is the minimum rate, in bytes per second, at which the
+	// request body must be delivered. Zero disables the rate floor.
+	ReadMinRate int64 `json:"read_min_rate,omitempty"`
+
+	// WriteTimeout is how long to wait for progress while writing the
+	// response. The deadline is reset after every successful write.
+	WriteTimeout time.Duration `json:"write_timeout,omitempty"`
+
+	// WriteMinRate is the minimum rate, in bytes per second, at which the
+	// response must be consumed. Zero disables the rate floor.
+	WriteMinRate int64 `json:"write_min_rate,omitempty"`
+
+	// MaxWriteChunk is the maximum number of bytes covered by a single
+	// underlying write. Zero means caddyhttp.DefaultMaxWriteChunk.
+	MaxWriteChunk int `json:"max_write_chunk,omitempty"`
+
+	logger *zap.Logger
+}
+
+// CaddyModule returns the Caddy module information.
+func (Timeouts) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{
+		ID:  "http.handlers.timeouts",
+		New: func() caddy.Module { return new(Timeouts) },
+	}
+}
+
+// Provision sets up the module.
+func (t *Timeouts) Provision(ctx caddy.Context) error {
+	t.logger = ctx.Logger()
+	return nil
+}
+
+// ServeHTTP implements caddyhttp.MiddlewareHandler.
+func (t Timeouts) ServeHTTP(w http.ResponseWriter, r *http.Request, next caddyhttp.Handler) error {
+	readOn := t.ReadTimeout > 0 || t.ReadMinRate > 0
+	writeOn := t.WriteTimeout > 0 || t.WriteMinRate > 0
+	if !readOn && !writeOn {
+		return next.ServeHTTP(w, r)
+	}
+
+	logger := t.logger
+	if logger == nil {
+		logger = zap.NewNop()
+	}
+
+	now := time.Now()
+	//nolint:bodyclose
+	ctrl := http.NewResponseController(w)
+
+	if readOn && r.Body != nil {
+		r.Body = &caddyhttp.IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       ctrl,
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   now,
+				Timeout: t.ReadTimeout,
+				MinRate: t.ReadMinRate,
+			},
+			Logger: logger,
+		}
+	}
+
+	if writeOn {
+		w = &caddyhttp.IdleTimeoutWriter{
+			ResponseWriterWrapper: &caddyhttp.ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  ctrl,
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   now,
+				Timeout: t.WriteTimeout,
+				MinRate: t.WriteMinRate,
+			},
+			MaxChunk: t.MaxWriteChunk,
+			Logger:   logger,
+		}
+	}
+
+	return next.ServeHTTP(w, r)
+}
+
+// Interface guards
+var (
+	_ caddy.Provisioner           = (*Timeouts)(nil)
+	_ caddyhttp.MiddlewareHandler = (*Timeouts)(nil)
+	_ caddyfile.Unmarshaler       = (*Timeouts)(nil)
+)
