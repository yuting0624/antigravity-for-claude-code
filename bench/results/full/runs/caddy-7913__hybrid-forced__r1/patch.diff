+			}
+			if chunk == 0 {
+				return d.Errf("write_max_chunk must be greater than zero")
+			}
+			if chunk > uint64(^uint(0)>>1) {
+				return d.Errf("write_max_chunk value overflows int: %s", d.Val())
+			}
+			t.MaxWriteChunk = int(chunk)
+			if d.NextArg() {
+				return d.ArgErr()
+			}
+
+		default:
+			return d.Errf("unrecognized subdirective %s", d.Val())
+		}
+	}
+	return nil
+}
