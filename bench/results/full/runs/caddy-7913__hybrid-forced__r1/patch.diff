+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package timeouts
+
+import (
+	"net/http"
+	"time"
+
+	"github.com/dustin/go-humanize"
+	"go.uber.org/zap"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/caddyconfig/caddyfile"
+	"github.com/caddyserver/caddy/v2/caddyconfig/httpcaddyfile"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func init() {
+	caddy.RegisterModule(Timeouts{})
+	httpcaddyfile.RegisterHandlerDirective("timeouts", parseCaddyfile)
+}
+
+// Timeouts implements per-route idle-based read and write timeouts. Unlike the
+// server hard read/write timeouts, the deadline is reset on every successful read
+// of the request body or write of the response, so a stalled connection is cut off
+// while a slow-but-progressing transfer survives.
+type Timeouts struct {
+	// How long to allow between successful reads from the request body.
+	// Zero disables the read timeout.
+	ReadTimeout time.Duration `json:"read_timeout,omitempty"`
+
+	// The minimum read rate, in bytes per second, required to keep the
+	// connection alive. Zero disables the rate floor.
+	ReadMinRate int64 `json:"read_min_rate,omitempty"`
+
+	// How long to allow between successful writes of the response.
+	// Zero disables the write timeout.
+	WriteTimeout time.Duration `json:"write_timeout,omitempty"`
+
+	// The minimum write rate, in bytes per second, required to keep the
+	// connection alive. Zero disables the rate floor.
+	WriteMinRate int64 `json:"write_min_rate,omitempty"`
+
+	// The maximum number of bytes written to the connection in a single write,
+	// so that a deadline window bounds a chunk rather than the whole transfer.
+	// Defaults to caddyhttp.DefaultMaxWriteChunk (64 KiB).
+	MaxWriteChunk int `json:"max_write_chunk,omitempty"`
+
+	logger *zap.Logger
+}
+
+// CaddyModule returns the Caddy module information.
+func (Timeouts) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{
+		ID:  "http.handlers.timeouts",
+		New: func() caddy.Module { return new(Timeouts) },
+	}
+}
+
+// Provision sets up the module.
+func (t *Timeouts) Provision(ctx caddy.Context) error {
+	t.logger = ctx.Logger()
+	return nil
+}
+
+// ServeHTTP implements caddyhttp.MiddlewareHandler.
+func (t Timeouts) ServeHTTP(w http.ResponseWriter, r *http.Request, next caddyhttp.Handler) error {
+	start := time.Now()
+	ctrl := http.NewResponseController(w)
+
+	if t.ReadTimeout > 0 && r.Body != nil {
+		r.Body = &caddyhttp.IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       ctrl,
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   start,
+				Timeout: t.ReadTimeout,
+				MinRate: t.ReadMinRate,
+			},
+			Logger: t.logger,
+		}
+	}
+
+	if t.WriteTimeout > 0 {
+		w = &caddyhttp.IdleTimeoutWriter{
+			ResponseWriterWrapper: &caddyhttp.ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  ctrl,
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   start,
+				Timeout: t.WriteTimeout,
+				MinRate: t.WriteMinRate,
+			},
+			MaxChunk: t.MaxWriteChunk,
+			Logger:   t.logger,
+		}
+	}
+
+	return next.ServeHTTP(w, r)
+}
+
+// UnmarshalCaddyfile sets up the handler from Caddyfile tokens. Syntax:
+//
+//	timeouts {
+//	    read_timeout    <duration> [<min_rate>]
+//	    write_timeout   <duration> [<min_rate>]
+//	    write_max_chunk <size>
+//	}
+func (t *Timeouts) UnmarshalCaddyfile(d *caddyfile.Dispenser) error {
+	d.Next() // consume directive name
+
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		switch d.Val() {
+		case "read_timeout":
+			if !d.NextArg() {
+				return d.ArgErr()
+			}
+			dur, err := caddy.ParseDuration(d.Val())
+			if err != nil {
+				return d.Errf("parsing read_timeout duration: %v", err)
+			}
+			t.ReadTimeout = dur
+
+			if d.NextArg() {
+				rate, err := humanize.ParseBytes(d.Val())
+				if err != nil {
+					return d.Errf("parsing read_timeout min_rate: %v", err)
+				}
+				t.ReadMinRate = int64(rate)
+			}
+			if d.NextArg() {
+				return d.ArgErr()
+			}
+
+		case "write_timeout":
+			if !d.NextArg() {
+				return d.ArgErr()
+			}
+			dur, err := caddy.ParseDuration(d.Val())
+			if err != nil {
+				return d.Errf("parsing write_timeout duration: %v", err)
+			}
+			t.WriteTimeout = dur
+
+			if d.NextArg() {
+				rate, err := humanize.ParseBytes(d.Val())
+				if err != nil {
+					return d.Errf("parsing write_timeout min_rate: %v", err)
+				}
+				t.WriteMinRate = int64(rate)
+			}
+			if d.NextArg() {
+				return d.ArgErr()
+			}
+
+		case "write_max_chunk":
+			if !d.NextArg() {
+				return d.ArgErr()
+			}
+			chunk, err := humanize.ParseBytes(d.Val())
+			if err != nil {
