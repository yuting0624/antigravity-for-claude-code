+// applyIdleTimeouts wraps the request body and the response writer so that
+// read and write deadlines are reset on every successful transfer, rather
+// than bounding the transfer as a whole. Any configured hard ReadTimeout or
+// WriteTimeout is used as a ceiling that the reset deadline cannot exceed.
+func (s *Server) applyIdleTimeouts(w http.ResponseWriter, r *http.Request) (http.ResponseWriter, *http.Request) {
+	readIdle := time.Duration(s.ReadIdleTimeout)
+	writeIdle := time.Duration(s.WriteIdleTimeout)
+	if readIdle <= 0 && writeIdle <= 0 {
+		return w, r
+	}
+
+	start := time.Now()
+	ctrl := http.NewResponseController(w)
+
+	if readIdle > 0 && r.Body != nil && r.Body != http.NoBody {
+		var hard time.Time
+		if s.ReadTimeout > 0 {
+			hard = start.Add(time.Duration(s.ReadTimeout))
+		}
+		r.Body = &IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       ctrl,
+			Deadline: IdleDeadline{
+				Start:        start,
+				Timeout:      readIdle,
+				MinRate:      s.ReadMinRate,
+				HardDeadline: hard,
+			},
+			Logger: s.logger,
+		}
+	}
+
+	if writeIdle > 0 {
+		var hard time.Time
+		if s.WriteTimeout > 0 {
+			hard = start.Add(time.Duration(s.WriteTimeout))
+		}
+		w = &IdleTimeoutWriter{
+			ResponseWriterWrapper: &ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  ctrl,
+			Deadline: IdleDeadline{
+				Start:        start,
+				Timeout:      writeIdle,
+				MinRate:      s.WriteMinRate,
+				HardDeadline: hard,
+			},
+			MaxChunk: s.MaxWriteChunk,
+			Logger:   s.logger,
+		}
+	}
+
+	return w, r
+}
