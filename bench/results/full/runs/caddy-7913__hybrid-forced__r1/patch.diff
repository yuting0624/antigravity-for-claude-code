+
+package caddyhttp
+
+import (
+	"bufio"
+	"io"
+	"math"
+	"net"
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+)
+
+// DefaultMaxWriteChunk is the default maximum number of bytes written to the
+// underlying writer in a single call, so that a write deadline bounds a small
+// chunk rather than an entire large transfer.
+const DefaultMaxWriteChunk = 64 * 1024
+
+// IdleDeadline configures idle timeout and rate-based deadlines for transfers.
+type IdleDeadline struct {
+	// Start is when the transfer began; base for MinRate credit.
+	Start time.Time
+
+	// Timeout is the idle window; deadline is pushed to now+Timeout after every successful transfer.
+	Timeout time.Duration
+
+	// MinRate is the minimum transfer rate in bytes per second; 0 disables.
+	MinRate int64
+
+	// HardDeadline is the absolute ceiling; zero means none.
+	HardDeadline time.Time
+}
+
+func (d IdleDeadline) next(now time.Time, transferred int64) (time.Time, bool) {
+	if d.Timeout <= 0 && d.HardDeadline.IsZero() {
+		return time.Time{}, false
+	}
+	start := d.Start
+	if start.IsZero() {
+		start = now
+	}
+	var deadline time.Time
+	if d.Timeout > 0 {
+		deadline = now.Add(d.Timeout)
+	}
+	if d.MinRate > 0 && d.Timeout > 0 {
+		// credit: how much extra time the bytes transferred so far have earned
+		const maxCredit = time.Duration(math.MaxInt64)
+		credit := maxCredit
+		if transferred < math.MaxInt64/int64(time.Second) {
+			credit = time.Duration(transferred) * time.Second / time.Duration(d.MinRate)
+		}
+		var rateDeadline time.Time
+		if credit > maxCredit-d.Timeout {
+			rateDeadline = start.Add(maxCredit)
+		} else {
+			rateDeadline = start.Add(d.Timeout + credit)
+		}
+		if rateDeadline.Before(deadline) {
+			deadline = rateDeadline
+		}
+	}
+	if !d.HardDeadline.IsZero() && (deadline.IsZero() || d.HardDeadline.Before(deadline)) {
+		deadline = d.HardDeadline
+	}
+	return deadline, !deadline.IsZero()
+}
+
+// IdleTimeoutReader wraps an io.ReadCloser to enforce read deadlines based on
+// idle timeout, minimum transfer rate, and hard deadline settings.
+type IdleTimeoutReader struct {
+	// ReadCloser is the underlying reader being wrapped.
+	io.ReadCloser
+
+	// Ctrl provides access to the underlying connection's deadlines.
+	Ctrl *http.ResponseController
+
+	// Deadline contains the idle, rate, and hard deadline configuration.
+	Deadline IdleDeadline
+
+	// Logger receives debug log messages when setting deadlines fails.
+	Logger *zap.Logger
+
+	read int64
+}
+
+// Read reads from the underlying ReadCloser after updating the read deadline.
+func (r *IdleTimeoutReader) Read(p []byte) (int, error) {
+	deadline, ok := r.Deadline.next(time.Now(), r.read)
+	if ok && r.Ctrl != nil {
+		if err := r.Ctrl.SetReadDeadline(deadline); err != nil && r.Logger != nil {
+			if c := r.Logger.Check(zapcore.DebugLevel, "could not set read deadline"); c != nil {
+				c.Write(zap.Error(err))
+			}
+		}
+	}
+	n, err := r.ReadCloser.Read(p)
+	r.read += int64(n)
+	if err != nil && r.Ctrl != nil {
+		_ = r.Ctrl.SetReadDeadline(r.Deadline.HardDeadline)
+	}
+	return n, err
+}
+
+// IdleTimeoutWriter wraps a ResponseWriterWrapper to enforce write deadlines
+// and chunk large writes so deadlines can bound partial transfers.
+type IdleTimeoutWriter struct {
+	// ResponseWriterWrapper is the wrapped ResponseWriter.
+	*ResponseWriterWrapper
+
+	// Ctrl provides access to the underlying connection's deadlines.
+	Ctrl *http.ResponseController
+
+	// Deadline contains the idle, rate, and hard deadline configuration.
+	Deadline IdleDeadline
+
+	// MaxChunk is the maximum number of bytes written in a single underlying call;
+	// 0 means DefaultMaxWriteChunk.
+	MaxChunk int
+
+	// Logger receives debug log messages when setting deadlines fails.
+	Logger *zap.Logger
+
+	written int64
+}
+
+func (w *IdleTimeoutWriter) maxChunk() int {
+	if w.MaxChunk > 0 {
+		return w.MaxChunk
+	}
+	return DefaultMaxWriteChunk
+}
+
+func (w *IdleTimeoutWriter) setDeadline() {
+	deadline, ok := w.Deadline.next(time.Now(), w.written)
+	if !ok {
+		return
+	}
+	if w.Ctrl != nil {
+		if err := w.Ctrl.SetWriteDeadline(deadline); err != nil && w.Logger != nil {
+			if c := w.Logger.Check(zapcore.DebugLevel, "could not set write deadline"); c != nil {
+				c.Write(zap.Error(err))
+			}
+		}
+	}
+}
+
+// Write writes data in chunks no larger than maxChunk, updating write deadlines before each write.
+func (w *IdleTimeoutWriter) Write(data []byte) (int, error) {
+	if len(data) == 0 {
+		w.setDeadline()
+		return w.ResponseWriterWrapper.Write(data)
+	}
+	total := 0
+	max := w.maxChunk()
+	for total < len(data) {
+		chunk := data[total:]
+		if len(chunk) > max {
+			chunk = chunk[:max]
+		}
+		w.setDeadline()
+		n, err := w.ResponseWriterWrapper.Write(chunk)
+		total += n
+		w.written += int64(n)
+		if err != nil {
+			return total, err
+		}
+		if n == 0 {
+			return total, io.ErrShortWrite
+		}
+	}
+	return total, nil
+}
+
+// ReadFrom reads data from src and writes it in chunks, updating write deadlines before each chunk.
+func (w *IdleTimeoutWriter) ReadFrom(src io.Reader) (int64, error) {
+	var total int64
+	max := int64(w.maxChunk())
+	for {
+		w.setDeadline()
+		n, err := w.ResponseWriterWrapper.ReadFrom(io.LimitReader(src, max))
+		total += n
+		w.written += n
+		if err != nil {
+			return total, err
+		}
+		if n < max {
+			return total, nil
+		}
+	}
+}
+
+// WriteHeader sends an HTTP response header with the provided status code after setting the write deadline.
+func (w *IdleTimeoutWriter) WriteHeader(statusCode int) {
+	w.setDeadline()
+	w.ResponseWriterWrapper.WriteHeader(statusCode)
+}
+
+// FlushError flushes buffered data to the client.
+func (w *IdleTimeoutWriter) FlushError() error {
+	//nolint:bodyclose
+	return http.NewResponseController(w.ResponseWriterWrapper).Flush()
+}
+
+// Unwrap returns the underlying ResponseWriter.
+func (w *IdleTimeoutWriter) Unwrap() http.ResponseWriter {
+	return w.ResponseWriterWrapper
+}
+
+// Hijack implements http.Hijacker. It clears any deadline set by this writer
+// first, since the caller takes over the connection and will manage its own
+// deadlines.
+func (w *IdleTimeoutWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	if w.Ctrl != nil {
+		_ = w.Ctrl.SetReadDeadline(time.Time{})
+		_ = w.Ctrl.SetWriteDeadline(time.Time{})
+	}
+	//nolint:bodyclose
+	return http.NewResponseController(w.ResponseWriterWrapper).Hijack()
+}
+
+// Interface guards
+var (
+	_ io.ReadCloser       = (*IdleTimeoutReader)(nil)
+	_ http.ResponseWriter = (*IdleTimeoutWriter)(nil)
+	_ io.ReaderFrom       = (*IdleTimeoutWriter)(nil)
+	_ http.Hijacker       = (*IdleTimeoutWriter)(nil)
+)
