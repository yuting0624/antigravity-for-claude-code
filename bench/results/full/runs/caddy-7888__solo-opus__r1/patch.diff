+// SetCookieFilter is a Caddy log field filter that filters
+// cookies set by the response.
+//
+// This filter updates the logged `Set-Cookie` header values
+// to remove, replace or hash cookies containing sensitive data. For instance,
+// it can be used to redact any kind of secrets, such as session IDs.
+//
+// Only the `name=value` pair of each header value is transformed; the
+// attributes which follow it (`Path`, `Expires`, `Secure`, etc.) are
+// preserved as they were logged.
+//
+// If several actions are configured for the same cookie name, only the first
+// will be applied.
+type SetCookieFilter struct {
+	// A list of actions to apply to the cookies.
+	Actions []cookieFilterAction `json:"actions"`
+}
+
+// Validate checks that action types are correct.
+func (f *SetCookieFilter) Validate() error {
+	for _, a := range f.Actions {
+		if err := a.Type.IsValid(); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+// CaddyModule returns the Caddy module information.
+func (SetCookieFilter) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{
+		ID:  "caddy.logging.encoders.filter.set_cookie",
+		New: func() caddy.Module { return new(SetCookieFilter) },
+	}
+}
+
+// UnmarshalCaddyfile sets up the module from Caddyfile tokens.
+func (m *SetCookieFilter) UnmarshalCaddyfile(d *caddyfile.Dispenser) error {
+	actions, err := unmarshalCookieFilterActions(d)
+	if err != nil {
+		return err
+	}
+	m.Actions = append(m.Actions, actions...)
+	return nil
+}
+
+// Filter filters the input field.
+func (m SetCookieFilter) Filter(in zapcore.Field) zapcore.Field {
+	setCookiesSlice, ok := in.Interface.(internal.LoggableStringArray)
+	if !ok {
+		return in
+	}
+
+	transformed := make(internal.LoggableStringArray, 0, len(setCookiesSlice))
+
+OUTER:
+	for _, setCookie := range setCookiesSlice {
+		// using a dummy Response to make use of the Cookies() function to parse it;
+		// values which cannot be parsed are kept as they are
+		originResponse := http.Response{Header: http.Header{"Set-Cookie": []string{setCookie}}}
+		cookies := originResponse.Cookies()
+		if len(cookies) != 1 {
+			transformed = append(transformed, setCookie)
+			continue
+		}
+		c := cookies[0]
+
+		for _, a := range m.Actions {
+			if c.Name != a.Name {
+				continue
+			}
+
+			switch a.Type {
+			case replaceAction:
+				transformed = append(transformed, replaceSetCookieValue(setCookie, c, a.Value))
+				continue OUTER
+
+			case hashAction:
+				transformed = append(transformed, replaceSetCookieValue(setCookie, c, hash(c.Value)))
+				continue OUTER
+
+			case deleteAction:
+				continue OUTER
+			}
+		}
+
+		transformed = append(transformed, setCookie)
+	}
+
+	in.Interface = transformed
+
+	return in
+}
+
+// replaceSetCookieValue returns the given `Set-Cookie` header value with the
+// value of its leading `name=value` pair replaced by newValue. The attributes
+// which follow the pair are copied verbatim, and the value keeps its original
+// quoting.
+func replaceSetCookieValue(setCookie string, c *http.Cookie, newValue string) string {
+	var attributes string
+	if i := strings.IndexByte(setCookie, ';'); i >= 0 {
+		attributes = setCookie[i:]
+	}
+
+	if c.Quoted {
+		newValue = `"` + newValue + `"`
+	}
+
+	return c.Name + "=" + newValue + attributes
+}
