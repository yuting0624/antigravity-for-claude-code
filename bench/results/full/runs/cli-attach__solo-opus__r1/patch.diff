+package attachments
+
+import (
+	"net/http"
+	"os"
+	"strconv"
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/httpmock"
+)
+
+// UploadStub describes one stubbed response from the user-attachments
+// endpoint, so a table-driven test can state its uploads as data.
+type UploadStub struct {
+	// Name is the file name the upload carries, which is how the stub is
+	// matched to the asset it answers for.
+	Name string
+	// Status is the HTTP status to answer with.
+	Status int
+	// Body is the response body to answer with.
+	Body string
+}
+
+// StubUpload registers a response for the upload of one file to the default
+// host.
+func StubUpload(reg *httpmock.Registry, repositoryID int64, name string, status int, body string) {
+	reg.Register(uploadMatcher("", repositoryID, name), httpmock.StatusStringResponse(status, body))
+}
+
+// StubUploadToHost is StubUpload for a test that also cares which host the
+// upload was sent to.
+func StubUploadToHost(t *testing.T, reg *httpmock.Registry, host string, repositoryID int64, name string, status int, body string) {
+	t.Helper()
+	reg.Register(uploadMatcher(host, repositoryID, name), httpmock.StatusStringResponse(status, body))
+}
+
+func uploadMatcher(host string, repositoryID int64, name string) httpmock.Matcher {
+	rest := httpmock.REST("POST", userAssetPath)
+	return func(req *http.Request) bool {
+		if host != "" && req.URL.Host != host {
+			return false
+		}
+		if !rest(req) {
+			return false
+		}
+		query := req.URL.Query()
+		return query.Get("name") == name &&
+			query.Get("repository_id") == strconv.FormatInt(repositoryID, 10)
+	}
+}
+
+// NewTestAssets writes the named files into a temporary working directory and
+// resolves them, giving a test the assets a command would have built from
+// `--attach`. It moves the process into that directory, so it has to run before
+// anything else reads a relative path.
+func NewTestAssets(t *testing.T, names ...string) []UserAsset {
+	t.Helper()
+	t.Chdir(t.TempDir())
+
+	assets := make([]UserAsset, 0, len(names))
+	for _, name := range names {
+		if err := os.WriteFile(name, []byte("the bytes"), 0o600); err != nil {
+			t.Fatalf("could not write %s: %v", name, err)
+		}
+		a, err := newAsset("./"+name, "")
+		if err != nil {
+			t.Fatalf("could not resolve %s: %v", name, err)
+		}
+		assets = append(assets, a)
+	}
+
+	return assets
+}
diff --git a/internal/attachments/userasset.go b/internal/attachments/userasset.go
new file mode 100644
index 000000000..0b14a73f3
--- /dev/null
+++ b/internal/attachments/userasset.go
@@ -0,0 +1,179 @@
+// Package attachments uploads local images and videos to GitHub's
+// user-attachments endpoint and writes the resulting asset URLs into the
+// markdown body of an issue or pull request.
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// The endpoint enforces its own limits, which depend on the plan behind the
+// account, but refusing here saves a doomed upload of a large file.
+const (
+	maxImageBytes int64 = 10 * 1024 * 1024
+	maxVideoBytes int64 = 100 * 1024 * 1024
+)
+
+// supportedExtension is one of the file types gh will attach, paired with the
+// content type the endpoint expects for it.
+type supportedExtension struct {
+	ext         string
+	contentType string
+	video       bool
+}
+
+// supportedExtensions is written in the order the "not a supported file type"
+// message lists them, images first.
+var supportedExtensions = []supportedExtension{
+	{".png", "image/png", false},
+	{".jpg", "image/jpeg", false},
+	{".jpeg", "image/jpeg", false},
+	{".gif", "image/gif", false},
+	{".webp", "image/webp", false},
+	{".svg", "image/svg+xml", false},
+	{".mp4", "video/mp4", true},
+	{".mov", "video/quicktime", true},
+	{".webm", "video/webm", true},
+}
+
+// UserAsset is a local file that has been validated and is ready to upload.
+type UserAsset interface {
+	// Path returns the path the user wrote, which is what messages name it by.
+	Path() string
+
+	// markdown renders the reference that shows the uploaded asset.
+	markdown(assetURL string) string
+
+	// rendersAsPlayer reports whether a bare URL alone in a paragraph renders
+	// as a player rather than as a link.
+	rendersAsPlayer() bool
+
+	getAsset() *asset
+}
+
+// asset is what every kind of attachment has in common.
+type asset struct {
+	path        string
+	alt         string
+	contentType string
+	info        fs.FileInfo
+}
+
+func (a *asset) Path() string { return a.path }
+
+func (a *asset) getAsset() *asset { return a }
+
+type imageAsset struct{ asset }
+
+type videoAsset struct{ asset }
+
+func (a *imageAsset) rendersAsPlayer() bool { return false }
+
+func (a *videoAsset) rendersAsPlayer() bool { return true }
+
+func (a *imageAsset) markdown(assetURL string) string {
+	embed := fmt.Sprintf("![%s](%s)", escapeLabel(a.alt), assetURL)
+	// Escaping the label should make this impossible, but alt text that closed
+	// the embed early would leave markdown pointing somewhere the author did
+	// not choose, which is worse than an embed with no label at all.
+	if !isSingleImage(embed, assetURL) {
+		return fmt.Sprintf("![](%s)", assetURL)
+	}
+	return embed
+}
+
+// A video only plays when its URL stands alone, so there is nowhere to put a
+// label and the alt text the author gave never reaches the markdown.
+func (a *videoAsset) markdown(assetURL string) string { return assetURL }
+
+// labelEscaper keeps alt text inside the label it was written for. A bracket
+// would otherwise close the label early and let the rest of the alt text become
+// markdown of its own, and a line break would end the paragraph.
+var labelEscaper = strings.NewReplacer(
+	`\`, `\\`,
+	`[`, `\[`,
+	`]`, `\]`,
+	"\r", " ",
+	"\n", " ",
+)
+
+func escapeLabel(s string) string { return labelEscaper.Replace(s) }
+
+// newAsset validates path and returns the asset gh would upload for it. It
+// reads the file's metadata only, never its contents.
+func newAsset(path, alt string) (UserAsset, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		// The syscall gh happened to make is noise; the path the user typed is
+		// what they can act on.
+		var pathErr *fs.PathError
+		if errors.As(err, &pathErr) {
+			return nil, fmt.Errorf("%s: %w", path, pathErr.Err)
+		}
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+	if info.IsDir() {
+		return nil, fmt.Errorf("%s is a directory", path)
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%s is not a regular file", path)
+	}
+
+	supported, ok := supportedExtensionFor(path)
+	if !ok {
+		return nil, fmt.Errorf("%s is not a supported file type (supported: %s)", path, supportedExtensionNames())
+	}
+
+	if info.Size() == 0 {
+		return nil, fmt.Errorf("%s is empty", path)
+	}
+	limit, kind := maxImageBytes, "images"
+	if supported.video {
+		limit, kind = maxVideoBytes, "videos"
+	}
+	if info.Size() > limit {
+		return nil, fmt.Errorf("%s: %s must be at most %.1f MB", path, kind, float64(limit)/(1024*1024))
+	}
+
+	base := filepath.Base(path)
+	if supported.video {
+		if alt != "" {
+			return nil, errors.New("cannot set alt text on video")
+		}
+		// A video has no alt attribute to fill. The file name stands in,
+		// extension included, because it becomes the link text when an embed
+		// degrades to a link.
+		alt = base
+	} else if alt == "" {
+		alt = strings.ReplaceAll(strings.TrimSuffix(base, filepath.Ext(base)), ".", " ")
+	}
+
+	a := asset{path: path, alt: alt, contentType: supported.contentType, info: info}
+	if supported.video {
+		return &videoAsset{a}, nil
+	}
+	return &imageAsset{a}, nil
+}
+
+func supportedExtensionFor(path string) (supportedExtension, bool) {
+	ext := strings.ToLower(filepath.Ext(path))
+	for _, s := range supportedExtensions {
+		if s.ext == ext {
+			return s, true
+		}
+	}
+	return supportedExtension{}, false
+}
+
+func supportedExtensionNames() string {
+	names := make([]string, len(supportedExtensions))
+	for i, s := range supportedExtensions {
+		names[i] = strings.TrimPrefix(s.ext, ".")
+	}
+	return strings.Join(names, ", ")
+}
