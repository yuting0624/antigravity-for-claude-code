diff --git a/internal/attachments/attach.go b/internal/attachments/attach.go
new file mode 100644
index 000000000..a9646680d
--- /dev/null
+++ b/internal/attachments/attach.go
@@ -0,0 +1,94 @@
+package attachments
+
+import (
+	"context"
+	"strings"
+)
+
+// UploadAndAttach uploads every asset and writes the resulting URLs into body.
+// A reference the body already makes to an attached file is rewritten where it
+// stands; anything the body never mentions is appended below it.
+//
+// It returns the body to write, how many assets reached the server, and the
+// failure that stopped it. An upload cannot be undone, so a caller that gets a
+// non-zero count must write the body it was handed even though the call failed,
+// or the assets that did upload are stranded with nothing pointing at them.
+func (u *Uploader) UploadAndAttach(ctx context.Context, body string, assets []UserAsset) (string, int, error) {
+	if len(assets) == 0 {
+		return body, 0, nil
+	}
+
+	args := make([]attachmentArg, len(assets))
+	for i, a := range assets {
+		args[i] = attachmentArg{
+			Path:            a.Path(),
+			Alt:             a.getAsset().alt,
+			RendersAsPlayer: a.rendersAsPlayer(),
+		}
+	}
+
+	// A body no asset can be written into is refused before anything is
+	// uploaded, so nothing is stranded.
+	if _, err := newAttachableMarkdown(body, args); err != nil {
+		return body, 0, err
+	}
+
+	uploaded := 0
+	var uploadErr error
+	for i, a := range assets {
+		assetURL, err := u.upload(ctx, a)
+		if err != nil {
+			uploadErr = err
+			break
+		}
+		args[i].URL = assetURL
+		uploaded++
+	}
+	if uploaded == 0 {
+		return body, 0, uploadErr
+	}
+
+	// Validated above, and an asset that failed to upload carries no URL and is
+	// left as the author wrote it.
+	v, err := newAttachableMarkdown(body, args)
+	if err != nil {
+		return body, uploaded, err
+	}
+	attached, err := attachAssetsToMarkdown(v)
+	if err != nil {
+		return body, uploaded, err
+	}
+
+	written := attached.Rewritten
+	for i, a := range assets {
+		if args[i].URL == "" || !shouldAppend(attached.ToAppend, args[i].Path) {
+			continue
+		}
+		written = appendParagraph(written, a.markdown(args[i].URL))
+	}
+
+	return written, uploaded, uploadErr
+}
+
+func shouldAppend(toAppend []attachmentArg, path string) bool {
+	for _, arg := range toAppend {
+		if arg.Path == path {
+			return true
+		}
+	}
+	return false
+}
+
+// appendParagraph puts addition in a paragraph of its own below md. A bare
+// video URL only renders as a player when nothing shares its paragraph, so the
+// blank line is what makes the attachment work rather than decoration.
+func appendParagraph(md, addition string) string {
+	if addition == "" {
+		return md
+	}
+	md = strings.TrimRight(md, " \t\r\n")
+	if md == "" {
+		return addition
+	}
+	return md + "\n\n" + addition
+}
diff --git a/internal/attachments/client.go b/internal/attachments/client.go
new file mode 100644
index 000000000..39fa58ea0
--- /dev/null
+++ b/internal/attachments/client.go
@@ -0,0 +1,232 @@
+package attachments
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/cli/cli/v2/api"
+	"github.com/cli/cli/v2/internal/gh"
+	"github.com/cli/cli/v2/internal/ghinstance"
+	ghauth "github.com/cli/go-gh/v2/pkg/auth"
+)
+
+// The path of the endpoint, relative to the upload host.
+const userAssetPath = "user-attachments/assets"
+
+// openFile is swapped out in tests so an upload can be exercised without a file
+// behind it.
+var openFile = func(path string) (io.ReadCloser, error) {
+	return os.Open(path)
+}
+
+// Uploader posts files to the user-attachments endpoint of one repository.
+type Uploader struct {
+	httpClient       *http.Client
+	host             string
+	targetRepository int64
+}
+
+// NewUploader refuses everything the endpoint would refuse, before any file is
+// read, because an upload cannot be taken back once it is accepted.
+func NewUploader(httpClient *http.Client, tokenType gh.TokenType, host string, targetRepository int64, viewerPermission string) (*Uploader, error) {
+	// The host is reported first: on an enterprise server the token message
+	// would tell the user to authenticate again, and that remedy does not work
+	// there.
+	if err := checkHost(host); err != nil {
+		return nil, err
+	}
+	if err := checkTokenType(tokenType); err != nil {
+		return nil, err
+	}
+	if targetRepository <= 0 {
+		return nil, errors.New("could not determine which repository to attach files to")
+	}
+	if err := checkViewerPermission(viewerPermission); err != nil {
+		return nil, err
+	}
+
+	return &Uploader{
+		httpClient:       httpClient,
+		host:             host,
+		targetRepository: targetRepository,
+	}, nil
+}
+
+// checkHost refuses the hosts that have no user-attachments endpoint.
+func checkHost(host string) error {
+	if ghauth.IsEnterprise(host) {
+		return errors.New("attaching files is not supported on GitHub Enterprise Server")
+	}
+	return nil
+}
+
+// checkTokenType refuses the credentials the endpoint does not accept. A
+// GitHub App token has no user to own the asset, and a refresh token is not a
+// credential for the API at all.
+func checkTokenType(tokenType gh.TokenType) error {
+	switch tokenType {
+	case gh.TokenTypeOAuth, gh.TokenTypePersonalAccess, gh.TokenTypeFineGrainedPAT:
+		return nil
+	}
+	return errors.New("unsupported authentication type")
+}
+
+func checkViewerPermission(viewerPermission string) error {
+	switch viewerPermission {
+	case "":
+		// The command did not ask for the field, which is a different fault
+		// from a permission that is merely too low, and only one of the two is
+		// something the user can fix.
+		return errors.New("could not determine your permission on the repository to attach files")
+	case "ADMIN", "MAINTAIN", "WRITE":
+		return nil
+	}
+	return errors.New("attaching files requires write access to the repository")
+}
+
+// upload posts one asset and returns the URL the server assigned it. It makes
+// a single attempt whatever the failure, since a retry of a request the server
+// had already accepted would orphan an asset nobody can delete.
+func (u *Uploader) upload(ctx context.Context, a UserAsset) (string, error) {
+	base := a.getAsset()
+
+	query := url.Values{}
+	query.Set("name", filepath.Base(base.path))
+	query.Set("content_type", base.contentType)
+	query.Set("repository_id", strconv.FormatInt(u.targetRepository, 10))
+	requestURL := ghinstance.UserAssetUploadPrefix(u.host) + userAssetPath + "?" + query.Encode()
+
+	f, err := openFile(base.path)
+	if err != nil {
+		return "", &uploadError{Path: base.path, err: err}
+	}
+	defer f.Close()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, requestURL, f)
+	if err != nil {
+		return "", &uploadError{Path: base.path, err: err}
+	}
+	req.ContentLength = base.info.Size()
+	req.Header.Set("Content-Type", "application/octet-stream")
+	req.Header.Set("Accept", "application/vnd.github+json")
+
+	resp, err := u.httpClient.Do(req)
+	if err != nil {
+		return "", &uploadError{Path: base.path, err: err}
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode > 299 {
+		return "", uploadRejected(base.path, resp)
+	}
+
+	var payload struct {
+		URL string `json:"url"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&payload); err != nil {
+		return "", &uploadError{Path: base.path, err: err}
+	}
+	if payload.URL == "" {
+		return "", &uploadError{Path: base.path, err: errors.New("the server returned no asset URL")}
+	}
+
+	return payload.URL, nil
+}
+
+// uploadError is a failed upload of one file. The status code is kept so a
+// caller can tell a refusal apart from a server fault.
+type uploadError struct {
+	Path       string
+	StatusCode int
+
+	// reason is gh's own wording for a refusal it recognises.
+	reason string
+	// err is the error being passed through when gh has nothing better to say.
+	err error
+}
+
+func (e *uploadError) Error() string {
+	if e.reason != "" {
+		return fmt.Sprintf("could not upload %s: %s", e.Path, e.reason)
+	}
+	if e.err != nil {
+		return fmt.Sprintf("failed to upload %s: %v", e.Path, e.err)
+	}
+	return fmt.Sprintf("could not upload %s", e.Path)
+}
+
+func (e *uploadError) Unwrap() error { return e.err }
+
+// uploadRejected turns a refusal into something the user can act on. A status
+// gh does not recognise keeps the server's own words, since they may name a
+// limit that depends on an account plan gh cannot see.
+func uploadRejected(path string, resp *http.Response) error {
+	e := &uploadError{Path: path, StatusCode: resp.StatusCode}
+
+	switch resp.StatusCode {
+	case http.StatusForbidden, http.StatusNotFound:
+		e.reason = "attaching files requires write access to the repository"
+	case http.StatusUnprocessableEntity:
+		e.reason = validationReason(resp)
+	case http.StatusTooManyRequests:
+		e.reason = rateLimitReason(resp)
+	default:
+		e.err = api.HandleHTTPError(resp)
+	}
+
+	return e
+}
+
+// validationReason repeats what the server said was wrong, on one line.
+func validationReason(resp *http.Response) string {
+	var payload struct {
+		Message string `json:"message"`
+		Errors  []struct {
+			Resource string `json:"resource"`
+			Field    string `json:"field"`
+			Code     string `json:"code"`
+			Message  string `json:"message"`
+		} `json:"errors"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&payload); err != nil {
+		return ""
+	}
+
+	causes := []string{}
+	for _, item := range payload.Errors {
+		switch {
+		case item.Message != "":
+			causes = append(causes, item.Message)
+		case item.Code != "":
+			causes = append(causes, fmt.Sprintf("%s.%s is %s", item.Resource, item.Field, item.Code))
+		}
+	}
+
+	parts := causes
+	if payload.Message != "" {
+		parts = append([]string{payload.Message}, causes...)
+	}
+	return strings.Join(parts, "; ")
+}
+
+// rateLimitReason reports the retry window the server gave, which is either a
+// number of seconds or a date.
+func rateLimitReason(resp *http.Response) string {
+	retryAfter := resp.Header.Get("Retry-After")
+	if retryAfter == "" {
+		return "rate limited; wait and try again"
+	}
+	if _, err := strconv.Atoi(retryAfter); err == nil {
+		return fmt.Sprintf("rate limited; retry after %s seconds", retryAfter)
+	}
+	return fmt.Sprintf("rate limited; retry after %s", retryAfter)
+}
diff --git a/internal/attachments/flags.go b/internal/attachments/flags.go
new file mode 100644
index 000000000..396c52f01
--- /dev/null
+++ b/internal/attachments/flags.go
@@ -0,0 +1,95 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"os"
+
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+)
+
+const flagName = "attach"
+
+// Flag is the `--attach` flag of a command, and the resolver for the values it
+// collected.
+type Flag struct {
+	flag   *pflag.Flag
+	values *[]string
+}
+
+// AddFlag registers `--attach` on cmd. It is a string array rather than a
+// string slice because a comma is legal in a file name.
+func AddFlag(cmd *cobra.Command) *Flag {
+	values := new([]string)
+	cmd.Flags().StringArrayVar(values, flagName, []string{},
+		"Attach an image or video `file`, in '<file>#<image alt text>' format")
+
+	return &Flag{flag: cmd.Flags().Lookup(flagName), values: values}
+}
+
+// Changed reports whether the flag was passed at all, which is what tells an
+// empty attachment apart from no attachment.
+func (f *Flag) Changed() bool { return f.flag.Changed }
+
+// UserAssets validates every value the flag collected and returns the assets in
+// the order they were written. The first value that cannot be attached stops
+// the whole set, so a command never uploads half of what it was given.
+func (f *Flag) UserAssets() ([]UserAsset, error) {
+	var assets []UserAsset
+
+	for _, value := range *f.values {
+		switch value {
+		case "":
+			return nil, errors.New("cannot attach an empty path; --attach needs a file path")
+		case "-":
+			return nil, errors.New("cannot attach standard input; --attach needs a file path")
+		}
+
+		path, alt := splitAttachValue(value)
+		a, err := newAsset(path, alt)
+		if err != nil {
+			return nil, err
+		}
+
+		// The same bytes uploaded twice get two asset URLs, so the same file
+		// named twice is a mistake rather than two attachments.
+		for _, previous := range assets {
+			if os.SameFile(previous.getAsset().info, a.getAsset().info) {
+				return nil, fmt.Errorf("%s and %s are the same file; attached files must be unique",
+					previous.Path(), a.Path())
+			}
+		}
+		assets = append(assets, a)
+	}
+
+	return assets, nil
+}
+
+// splitAttachValue separates a value into the file it names and the alt text
+// that follows it. Both halves may contain a "#", so the longest prefix that
+// names something on disk wins, and a value naming nothing splits at its last
+// "#" so the error reports the path the user most likely meant.
+func splitAttachValue(value string) (path, alt string) {
+	if _, err := os.Stat(value); err == nil {
+		return value, ""
+	}
+
+	lastHash := -1
+	for i := len(value) - 1; i >= 0; i-- {
+		if value[i] != '#' {
+			continue
+		}
+		if lastHash < 0 {
+			lastHash = i
+		}
+		if _, err := os.Stat(value[:i]); err == nil {
+			return value[:i], value[i+1:]
+		}
+	}
+
+	if lastHash >= 0 {
+		return value[:lastHash], value[lastHash+1:]
+	}
+	return value, ""
+}
diff --git a/internal/attachments/references.go b/internal/attachments/references.go
new file mode 100644
index 000000000..ebb0414c3
--- /dev/null
+++ b/internal/attachments/references.go
@@ -0,0 +1,746 @@
+package attachments
+
+import (
+	"fmt"
+	"net/url"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/yuin/goldmark"
+	"github.com/yuin/goldmark/ast"
+	"github.com/yuin/goldmark/text"
+)
+
+// attachmentArg is one attached file as the rewriter sees it: where the author
+// would have written it, where it now lives, and how it renders.
+type attachmentArg struct {
+	// Path is the path the user attached, which is also what a reference in the
+	// markdown has to name for it to be rewritten.
+	Path string
+	// URL is where the file was uploaded to. It is empty until the upload
+	// succeeds, and a reference to a file with no URL is left as written.
+	URL string
+	// Alt is the label to use when the markdown supplies none.
+	Alt string
+	// RendersAsPlayer is true for a video, which only plays when its URL stands
+	// alone in a paragraph.
+	RendersAsPlayer bool
+}
+
+// attachableMarkdown is markdown that has been checked against the files being
+// attached to it. It only exists once the pairing is known to be writable, so
+// nothing uploads for a body the assets cannot be written into.
+type attachableMarkdown struct {
+	markdown string
+	args     []attachmentArg
+}
+
+// attachedMarkdown is the result of writing the uploaded assets into a body.
+type attachedMarkdown struct {
+	// Rewritten is the body with every reference pointing at its asset URL.
+	Rewritten string
+	// ToAppend is the attachments the body never referenced, in the order they
+	// were passed, for the caller to append below it.
+	ToAppend []attachmentArg
+}
+
+// newAttachableMarkdown pairs markdown with the files being attached to it and
+// refuses the pairings that cannot work.
+//
+// A video is embedded as a bare URL, and a reference-style image gives the
+// rewriter nowhere to put one: the destination lives in a definition shared
+// with every other use of that label, so turning it into a player would change
+// the other uses too. The author has to write that one as a link instead.
+func newAttachableMarkdown(markdown string, args []attachmentArg) (attachableMarkdown, error) {
+	source := []byte(markdown)
+	doc := parseMarkdown(source)
+
+	var offending []string
+	reported := map[int]bool{}
+	forEachNode(doc, func(n ast.Node) {
+		image, ok := n.(*ast.Image)
+		if !ok || image.Reference == nil {
+			return
+		}
+		i := matchArgIndex(args, nodeDestination(image.Destination))
+		if i < 0 || !args[i].RendersAsPlayer || reported[i] {
+			return
+		}
+		reported[i] = true
+		offending = append(offending, args[i].Path)
+	})
+
+	if len(offending) > 0 {
+		return attachableMarkdown{}, fmt.Errorf(
+			"cannot embed a video as a reference-style image: %s", strings.Join(offending, ", "))
+	}
+
+	return attachableMarkdown{markdown: markdown, args: args}, nil
+}
+
+// attachAssetsToMarkdown rewrites every reference the markdown makes to an
+// attached file so that it points at the uploaded asset, and reports the
+// attachments nothing referenced.
+func attachAssetsToMarkdown(v attachableMarkdown) (attachedMarkdown, error) {
+	source := []byte(v.markdown)
+	doc := parseMarkdown(source)
+
+	skips := rawRanges(doc)
+	paragraphs := paragraphRanges(doc)
+
+	edits := inlineEdits(source, skips, paragraphs, v.args)
+	edits = append(edits, definitionEdits(source, doc, v.args)...)
+
+	rewritten, rewrote := applyEdits(source, edits)
+
+	var toAppend []attachmentArg
+	for i, arg := range v.args {
+		// An upload that produced no URL has nothing to append, and its
+		// reference was left as the author wrote it.
+		if arg.URL == "" || rewrote[i] {
+			continue
+		}
+		toAppend = append(toAppend, arg)
+	}
+
+	return attachedMarkdown{Rewritten: rewritten, ToAppend: toAppend}, nil
+}
+
+// isSingleImage reports whether markdown is nothing but one image embed
+// pointing at assetURL. Alt text that closes the image early, or anything
+// beside it, makes it something else.
+func isSingleImage(markdown, assetURL string) bool {
+	doc := parseMarkdown([]byte(markdown))
+
+	block := doc.FirstChild()
+	if block == nil || block != doc.LastChild() {
+		return false
+	}
+	if _, ok := block.(*ast.Paragraph); !ok {
+		return false
+	}
+
+	inline := block.FirstChild()
+	if inline == nil || inline != block.LastChild() {
+		return false
+	}
+	image, ok := inline.(*ast.Image)
+	if !ok {
+		return false
+	}
+
+	return string(image.Destination) == assetURL
+}
+
+func parseMarkdown(source []byte) ast.Node {
+	return goldmark.New().Parser().Parse(text.NewReader(source))
+}
+
+func forEachNode(root ast.Node, fn func(ast.Node)) {
+	_ = ast.Walk(root, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if entering {
+			fn(n)
+		}
+		return ast.WalkContinue, nil
+	})
+}
+
+// byteRange is a half-open range of the markdown source.
+type byteRange struct {
+	start, stop int
+}
+
+// edit replaces one range of the source. Ranges that overlap are resolved in
+// favour of the widest one starting earliest, which is how a video embed
+// swallows whatever was written inside it.
+type edit struct {
+	byteRange
+	text string
+	// arg is the attachment this edit points at, or -1 when the edit only
+	// keeps the surrounding markdown intact.
+	arg int
+}
+
+func applyEdits(source []byte, edits []edit) (string, map[int]bool) {
+	sort.SliceStable(edits, func(i, j int) bool {
+		if edits[i].start != edits[j].start {
+			return edits[i].start < edits[j].start
+		}
+		return edits[i].stop > edits[j].stop
+	})
+
+	rewrote := map[int]bool{}
+	var b strings.Builder
+	written := 0
+	for _, e := range edits {
+		if e.start < written {
+			// Swallowed by an edit that already covered these bytes.
+			continue
+		}
+		b.Write(source[written:e.start])
+		b.WriteString(e.text)
+		written = e.stop
+		if e.arg >= 0 {
+			rewrote[e.arg] = true
+		}
+	}
+	b.Write(source[written:])
+
+	return b.String(), rewrote
+}
+
+// rawRanges collects the parts of the source that are code or raw HTML, where a
+// path that looks like a reference is only text the author wrote.
+func rawRanges(doc ast.Node) []byteRange {
+	var ranges []byteRange
+
+	forEachNode(doc, func(n ast.Node) {
+		switch n := n.(type) {
+		case *ast.FencedCodeBlock, *ast.CodeBlock, *ast.HTMLBlock:
+			if r, ok := linesRange(n); ok {
+				ranges = append(ranges, r)
+			}
+		case *ast.CodeSpan:
+			// The backticks hold nothing that matters here, so the content of
+			// the span is enough to skip.
+			first, last := n.FirstChild(), n.LastChild()
+			if first == nil || last == nil {
+				return
+			}
+			start, startOK := textSegment(first)
+			stop, stopOK := textSegment(last)
+			if startOK && stopOK {
+				ranges = append(ranges, byteRange{start.Start, stop.Stop})
+			}
+		case *ast.RawHTML:
+			if n.Segments.Len() == 0 {
+				return
+			}
+			ranges = append(ranges, byteRange{
+				n.Segments.At(0).Start,
+				n.Segments.At(n.Segments.Len() - 1).Stop,
+			})
+		}
+	})
+
+	sort.Slice(ranges, func(i, j int) bool { return ranges[i].start < ranges[j].start })
+	return ranges
+}
+
+func textSegment(n ast.Node) (text.Segment, bool) {
+	t, ok := n.(*ast.Text)
+	if !ok {
+		return text.Segment{}, false
+	}
+	return t.Segment, true
+}
+
+func linesRange(n ast.Node) (byteRange, bool) {
+	lines := n.Lines()
+	if lines == nil || lines.Len() == 0 {
+		return byteRange{}, false
+	}
+	return byteRange{lines.At(0).Start, lines.At(lines.Len() - 1).Stop}, true
+}
+
+// paragraphRanges collects the content of every paragraph, which is the only
+// block where a bare URL renders as a player.
+func paragraphRanges(doc ast.Node) []byteRange {
+	var ranges []byteRange
+	forEachNode(doc, func(n ast.Node) {
+		if _, ok := n.(*ast.Paragraph); !ok {
+			return
+		}
+		if r, ok := linesRange(n); ok {
+			ranges = append(ranges, r)
+		}
+	})
+	return ranges
+}
+
+// skipTo reports the end of the raw range holding i, if any.
+func skipTo(ranges []byteRange, i int) (int, bool) {
+	for _, r := range ranges {
+		if i >= r.start && i < r.stop {
+			return r.stop, true
+		}
+	}
+	return 0, false
+}
+
+// openBracket is a "[" the scan has seen and not yet closed.
+type openBracket struct {
+	bracket int // index of the "["
+	bang    int // index of the "!" before it, or -1 for a link
+}
+
+// inlineEdits walks the source for inline links and images and returns the
+// edits that point them at their asset URLs.
+//
+// The scan is over the whole source rather than over the parsed nodes, because
+// what has to change is the bytes the author wrote, and only some of those
+// survive into the tree. Every "](" is a candidate, and one that does not parse
+// as a link tail is stepped over rather than claimed, so a malformed one ahead
+// of a real reference cannot swallow it.
+func inlineEdits(source []byte, skips, paragraphs []byteRange, args []attachmentArg) []edit {
+	var edits []edit
+	var open []openBracket
+
+	i := 0
+	for i < len(source) {
+		if stop, skip := skipTo(skips, i); skip {
+			i = stop
+			continue
+		}
+
+		switch source[i] {
+		case '\\':
+			i += 2
+			continue
+		case '!':
+			if i+1 < len(source) && source[i+1] == '[' {
+				open = append(open, openBracket{bracket: i + 1, bang: i})
+				i += 2
+				continue
+			}
+		case '[':
+			open = append(open, openBracket{bracket: i, bang: -1})
+		case ']':
+			if len(open) == 0 {
+				break
+			}
+			last := open[len(open)-1]
+			if i+1 < len(source) && source[i+1] == '(' {
+				if tail, ok := parseLinkTail(source, i+2); ok {
+					open = open[:len(open)-1]
+					edits = append(edits,
+						referenceEdits(source, paragraphs, args, last, i, tail)...)
+					i = tail.end
+					continue
+				}
+			}
+			open = open[:len(open)-1]
+		}
+		i++
+	}
+
+	return edits
+}
+
+// referenceEdits turns one inline reference into the edits that rewrite it.
+func referenceEdits(source []byte, paragraphs []byteRange, args []attachmentArg, open openBracket, labelClose int, tail linkTail) []edit {
+	i := matchArgIndex(args, tail.destination)
+	if i < 0 || args[i].URL == "" {
+		return nil
+	}
+	arg := args[i]
+
+	destination := edit{byteRange{tail.destStart, tail.destStop}, arg.URL, i}
+
+	// A link keeps its shape whatever it points at: only the destination moves.
+	if open.bang < 0 || !arg.RendersAsPlayer {
+		return []edit{destination}
+	}
+
+	// A video embed alone in a paragraph becomes the bare URL that plays.
+	node := byteRange{open.bang, tail.end}
+	if isAloneInParagraph(source, paragraphs, node) {
+		return []edit{{node, arg.URL, i}}
+	}
+
+	// Anywhere else a player cannot render, so the embed degrades to a link.
+	edits := []edit{destination, dropBang(source, open.bang)}
+	if labelClose == open.bracket+1 {
+		// Nothing labels the link once the embed is gone, so the name of the
+		// file stands in.
+		edits = append(edits, edit{byteRange{labelClose, labelClose}, escapeLabel(arg.Alt), -1})
+	}
+	return edits
+}
+
+// dropBang removes the "!" that made a reference an embed. A literal "!"
+// immediately before it would touch the "[" once ours is gone and re-form an
+// embed, so it is escaped unless it already is.
+func dropBang(source []byte, bang int) edit {
+	if bang > 0 && source[bang-1] == '!' && !isEscaped(source, bang-1) {
+		return edit{byteRange{bang - 1, bang + 1}, `\!`, -1}
+	}
+	return edit{byteRange{bang, bang + 1}, "", -1}
+}
+
+func isEscaped(source []byte, i int) bool {
+	backslashes := 0
+	for j := i - 1; j >= 0 && source[j] == '\\'; j-- {
+		backslashes++
+	}
+	return backslashes%2 == 1
+}
+
+// isAloneInParagraph reports whether node is the whole content of a paragraph,
+// ignoring the whitespace around it.
+func isAloneInParagraph(source []byte, paragraphs []byteRange, node byteRange) bool {
+	for _, p := range paragraphs {
+		start, stop := p.start, p.stop
+		for start < stop && isMarkdownSpace(source[start]) {
+			start++
+		}
+		for stop > start && isMarkdownSpace(source[stop-1]) {
+			stop--
+		}
+		if start == node.start && stop == node.stop {
+			return true
+		}
+	}
+	return false
+}
+
+func isMarkdownSpace(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r'
+}
+
+// linkTail is the "(destination "title")" half of an inline reference.
+type linkTail struct {
+	destStart, destStop int
+	destination         string
+	end                 int // just past the closing ")"
+}
+
+// parseLinkTail reads an inline destination and title starting just after the
+// "](" that opened them. It reports false for anything that is not a complete
+// link tail, since only a complete one is a reference at all.
+func parseLinkTail(source []byte, i int) (linkTail, bool) {
+	var tail linkTail
+
+	i = skipSpaceAndTabs(source, i)
+
+	var raw []byte
+	if i < len(source) && source[i] == '<' {
+		j := i + 1
+		for j < len(source) {
+			c := source[j]
+			if c == '\\' && j+1 < len(source) {
+				j += 2
+				continue
+			}
+			// An angle destination cannot hold a line break or a second "<",
+			// so one that reaches either never closes.
+			if c == '\n' || c == '\r' || c == '<' {
+				return tail, false
+			}
+			if c == '>' {
+				break
+			}
+			j++
+		}
+		if j >= len(source) || source[j] != '>' {
+			return tail, false
+		}
+		raw = source[i+1 : j]
+		tail.destStart, tail.destStop = i, j+1
+		i = j + 1
+	} else {
+		j := i
+		depth := 0
+		for j < len(source) {
+			c := source[j]
+			if c == '\\' && j+1 < len(source) {
+				j += 2
+				continue
+			}
+			// Anything at or below a space ends a bare destination, which is
+			// why a line break in one means this was never a link tail.
+			if c <= ' ' {
+				break
+			}
+			if c == '(' {
+				depth++
+			} else if c == ')' {
+				if depth == 0 {
+					break
+				}
+				depth--
+			}
+			j++
+		}
+		// Parentheses inside a bare destination have to balance, or the whole
+		// thing is literal text.
+		if depth != 0 {
+			return tail, false
+		}
+		raw = source[i:j]
+		tail.destStart, tail.destStop = i, j
+		i = j
+	}
+
+	i = skipSpaceAndTabs(source, i)
+	if i < len(source) && (source[i] == '"' || source[i] == '\'' || source[i] == '(') {
+		closer := source[i]
+		if closer == '(' {
+			closer = ')'
+		}
+		j := i + 1
+		for j < len(source) {
+			c := source[j]
+			if c == '\\' && j+1 < len(source) {
+				j += 2
+				continue
+			}
+			if c == closer {
+				break
+			}
+			j++
+		}
+		if j >= len(source) {
+			return tail, false
+		}
+		i = skipSpaceAndTabs(source, j+1)
+	}
+
+	if i >= len(source) || source[i] != ')' {
+		return tail, false
+	}
+
+	tail.destination = normalizeDestination(unescapeMarkdown(raw))
+	tail.end = i + 1
+	return tail, true
+}
+
+func skipSpaceAndTabs(source []byte, i int) int {
+	for i < len(source) && (source[i] == ' ' || source[i] == '\t') {
+		i++
+	}
+	return i
+}
+
+// definitionEdits rewrites the destination of every link reference definition
+// that a usage in the markdown resolves through. Rewriting the definition once
+// carries every usage of that label with it.
+func definitionEdits(source []byte, doc ast.Node, args []attachmentArg) []edit {
+	// A definition nothing uses renders nothing, so rewriting it would leave
+	// the file invisible rather than appended.
+	used := map[int]bool{}
+	forEachNode(doc, func(n ast.Node) {
+		var destination []byte
+		switch n := n.(type) {
+		case *ast.Image:
+			if n.Reference == nil {
+				return
+			}
+			destination = n.Destination
+		case *ast.Link:
+			if n.Reference == nil {
+				return
+			}
+			destination = n.Destination
+		default:
+			return
+		}
+		if i := matchArgIndex(args, nodeDestination(destination)); i >= 0 {
+			used[i] = true
+		}
+	})
+
+	var edits []edit
+	forEachNode(doc, func(n ast.Node) {
+		definition, ok := n.(*ast.LinkReferenceDefinition)
+		if !ok {
+			return
+		}
+		i := matchArgIndex(args, nodeDestination(definition.Destination))
+		if i < 0 || !used[i] || args[i].URL == "" {
+			return
+		}
+
+		lines := definition.Lines()
+		if lines == nil || lines.Len() == 0 {
+			return
+		}
+		line := lines.At(0)
+		span, destination, ok := parseDefinitionDestination(source, line.Start, line.Stop)
+		// A definition continued onto the next line leaves whatever the block
+		// starts with on the first one, which is not the path. Rewriting that
+		// would eat the markdown around it, so it is left alone and the file is
+		// appended instead.
+		if !ok || matchArgIndex(args, destination) != i {
+			return
+		}
+		edits = append(edits, edit{span, args[i].URL, i})
+	})
+
+	return edits
+}
+
+// parseDefinitionDestination locates the destination of a "[label]: dest"
+// definition inside one line of the source.
+func parseDefinitionDestination(source []byte, start, stop int) (byteRange, string, bool) {
+	i := skipSpaceAndTabs(source, start)
+	if i >= stop || source[i] != '[' {
+		return byteRange{}, "", false
+	}
+
+	// The label can hold an escaped "]", which is not where it ends.
+	i++
+	for i < stop {
+		c := source[i]
+		if c == '\\' && i+1 < stop {
+			i += 2
+			continue
+		}
+		if c == ']' {
+			break
+		}
+		i++
+	}
+	if i >= stop || source[i] != ']' {
+		return byteRange{}, "", false
+	}
+	i++
+	if i >= stop || source[i] != ':' {
+		return byteRange{}, "", false
+	}
+
+	i = skipSpaceAndTabs(source, i+1)
+	if i >= stop {
+		return byteRange{}, "", false
+	}
+
+	var raw []byte
+	var span byteRange
+	if source[i] == '<' {
+		j := i + 1
+		for j < stop {
+			c := source[j]
+			if c == '\\' && j+1 < stop {
+				j += 2
+				continue
+			}
+			if c == '\n' || c == '\r' || c == '<' {
+				return byteRange{}, "", false
+			}
+			if c == '>' {
+				break
+			}
+			j++
+		}
+		if j >= stop || source[j] != '>' {
+			return byteRange{}, "", false
+		}
+		raw = source[i+1 : j]
+		span = byteRange{i, j + 1}
+	} else {
+		j := i
+		for j < stop && !isMarkdownSpace(source[j]) {
+			if source[j] == '\\' && j+1 < stop {
+				j += 2
+				continue
+			}
+			j++
+		}
+		if j == i {
+			return byteRange{}, "", false
+		}
+		raw = source[i:j]
+		span = byteRange{i, j}
+	}
+
+	return span, normalizeDestination(unescapeMarkdown(raw)), true
+}
+
+// matchArgIndex returns the attachment a destination names, or -1.
+func matchArgIndex(args []attachmentArg, destination string) int {
+	if destination == "" || looksLikeURL(destination) {
+		return -1
+	}
+
+	absolute, absoluteOK := absolutePath(destination)
+	for i := range args {
+		if args[i].Path == destination {
+			return i
+		}
+		if !absoluteOK {
+			continue
+		}
+		if other, ok := absolutePath(args[i].Path); ok && other == absolute {
+			return i
+		}
+	}
+
+	return -1
+}
+
+func absolutePath(path string) (string, bool) {
+	absolute, err := filepath.Abs(path)
+	if err != nil {
+		return "", false
+	}
+	return absolute, true
+}
+
+// looksLikeURL reports whether a destination addresses something other than a
+// file beside the markdown.
+func looksLikeURL(destination string) bool {
+	if strings.HasPrefix(destination, "#") || strings.HasPrefix(destination, "//") {
+		return true
+	}
+	i := 0
+	for i < len(destination) && isSchemeByte(destination[i], i == 0) {
+		i++
+	}
+	// A single letter before the colon is how Windows names a volume, so only a
+	// longer run of them is a scheme.
+	return i >= 2 && i < len(destination) && destination[i] == ':'
+}
+
+func isSchemeByte(c byte, first bool) bool {
+	switch {
+	case c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z':
+		return true
+	case first:
+		return false
+	}
+	return c >= '0' && c <= '9' || c == '+' || c == '-' || c == '.'
+}
+
+// nodeDestination spells the destination goldmark recorded for a node the way
+// the file system does. goldmark keeps the destination as the author wrote it,
+// escapes and all.
+func nodeDestination(destination []byte) string {
+	return normalizeDestination(unescapeMarkdown(destination))
+}
+
+// normalizeDestination spells a destination the way the file system does, so
+// the percent encoding markdown needs for a space does not hide the file.
+func normalizeDestination(destination string) string {
+	if decoded, err := url.PathUnescape(destination); err == nil {
+		return decoded
+	}
+	return destination
+}
+
+// unescapeMarkdown drops the backslashes markdown uses to keep punctuation
+// literal, leaving the name the file actually has.
+func unescapeMarkdown(raw []byte) string {
+	if !strings.ContainsRune(string(raw), '\\') {
+		return string(raw)
+	}
+
+	var b strings.Builder
+	for i := 0; i < len(raw); i++ {
+		if raw[i] == '\\' && i+1 < len(raw) && isASCIIPunctuation(raw[i+1]) {
+			b.WriteByte(raw[i+1])
+			i++
+			continue
+		}
+		b.WriteByte(raw[i])
+	}
+	return b.String()
+}
+
+func isASCIIPunctuation(c byte) bool {
+	switch {
+	case c >= '!' && c <= '/', c >= ':' && c <= '@', c >= '[' && c <= '`', c >= '{' && c <= '~':
+		return true
+	}
+	return false
+}
