--- /dev/null
+++ b/pkg/cmd/pr/shared/attach.go
@@ -0,0 +1,37 @@
+package shared
+
+import (
+	"context"
+
+	"github.com/cli/cli/v2/internal/attachments"
+)
+
+// AttachToEditableBody uploads the attachments of an edit and writes them into
+// the body it will send. An edit that says nothing about the body appends to
+// currentBody, the text already on the issue or pull request.
+//
+// Nothing uploaded means nothing to write, so the body is dropped from the edit
+// rather than sent back unchanged, and the rest of the edit still goes through.
+// The error it returns is the upload failure, which the caller reports
+// alongside whatever the write did.
+func AttachToEditableBody(uploader *attachments.Uploader, assets []attachments.UserAsset, currentBody string, editable *Editable) error {
+	if uploader == nil {
+		return nil
+	}
+
+	body := currentBody
+	if editable.Body.Edited {
+		body = editable.Body.Value
+	}
+
+	body, uploaded, err := uploader.UploadAndAttach(context.Background(), body, assets)
+	if uploaded == 0 {
+		editable.Body.Edited = false
+		editable.Body.Value = ""
+		return err
+	}
+
+	editable.Body.Value = body
+	editable.Body.Edited = true
+	return err
+}
