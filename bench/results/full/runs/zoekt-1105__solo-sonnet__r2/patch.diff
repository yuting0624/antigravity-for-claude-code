+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+// Repository is a git repository discovered on disk beneath one of the
+// configured roots.
+type Repository struct {
+	// Name is derived from the repository's path relative to the root it
+	// was discovered under, with a trailing ".git" suffix (as used by bare
+	// repositories) stripped.
+	Name string
+
+	// Path is the absolute path to the repository: the working tree root
+	// for a normal or linked checkout, or the bare repository directory
+	// for a bare repository.
+	Path string
+
+	// Root is the absolute path to the root directory this repository was
+	// discovered under.
+	Root string
+}
+
+// discoverRepositories finds the git repositories beneath the given root
+// directories. A root that is itself a git repository counts. Each
+// repository's name is derived from its path relative to the root it was
+// found under; discoverRepositories fails if two discovered repositories
+// would be assigned the same name.
+func discoverRepositories(roots []string) ([]Repository, error) {
+	var repositories []Repository
+	nameSources := map[string]string{}
+
+	for _, root := range roots {
+		root, err := filepath.Abs(root)
+		if err != nil {
+			return nil, fmt.Errorf("resolving root %q: %w", root, err)
+		}
+		root = filepath.Clean(root)
+
+		paths, err := findRepositoriesUnder(root)
+		if err != nil {
+			return nil, fmt.Errorf("scanning root %q: %w", root, err)
+		}
+
+		for _, path := range paths {
+			rel, err := filepath.Rel(root, path)
+			if err != nil {
+				return nil, err
+			}
+
+			var name string
+			if rel == "." {
+				name = strings.TrimSuffix(filepath.Base(root), ".git")
+			} else {
+				name = strings.TrimSuffix(filepath.ToSlash(rel), ".git")
+			}
+
+			if existing, ok := nameSources[name]; ok {
+				return nil, fmt.Errorf("duplicate repository name %q for %s and %s", name, existing, path)
+			}
+			nameSources[name] = path
+
+			repositories = append(repositories, Repository{Name: name, Path: path, Root: root})
+		}
+	}
+
+	sort.Slice(repositories, func(i, j int) bool { return repositories[i].Name < repositories[j].Name })
+
+	return repositories, nil
+}
+
+// findRepositoriesUnder walks the directory tree rooted at root and returns
+// the absolute paths of the git repositories found beneath it (root
+// included). It does not descend into a directory once it has been
+// identified as a repository.
+func findRepositoriesUnder(root string) ([]string, error) {
+	var found []string
+
+	err := filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if !d.IsDir() {
+			return nil
+		}
+
+		if isBareRepoDir(path) || hasGitEntry(path) {
+			found = append(found, path)
+			return filepath.SkipDir
+		}
+
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	return found, nil
+}
+
+// hasGitEntry reports whether dir contains a ".git" entry, either a
+// directory (a normal checkout) or a file (a linked worktree or submodule).
+func hasGitEntry(dir string) bool {
+	info, err := os.Lstat(filepath.Join(dir, ".git"))
+	if err != nil {
+		return false
+	}
+	return info.IsDir() || info.Mode().IsRegular()
+}
+
+// isBareRepoDir reports whether dir looks like a bare git repository: its
+// name ends in ".git" and it holds an "objects" directory.
+func isBareRepoDir(dir string) bool {
+	if !strings.HasSuffix(dir, ".git") {
+		return false
+	}
+	info, err := os.Stat(filepath.Join(dir, "objects"))
+	return err == nil && info.IsDir()
+}
diff --git a/cmd/zoekt-local-sync/index.go b/cmd/zoekt-local-sync/index.go
new file mode 100644
index 00000000..11930afa
--- /dev/null
+++ b/cmd/zoekt-local-sync/index.go
@@ -0,0 +1,187 @@
+// Copyright 2026 Sourcegraph, Inc. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/sourcegraph/zoekt/gitindex"
+	"github.com/sourcegraph/zoekt/index"
+)
+
+// record describes a repository as currently reflected in a single index
+// shard on disk.
+type record struct {
+	Name   string
+	Source string
+	Shard  string
+}
+
+// readInventory returns the paths of the non-compound shard files present
+// in indexDir.
+func readInventory(indexDir string) ([]string, error) {
+	matches, err := filepath.Glob(filepath.Join(indexDir, "*.zoekt"))
+	if err != nil {
+		return nil, err
+	}
+
+	var shards []string
+	for _, m := range matches {
+		if strings.HasPrefix(filepath.Base(m), "compound-") {
+			continue
+		}
+		shards = append(shards, m)
+	}
+
+	sort.Strings(shards)
+
+	return shards, nil
+}
+
+// recordsFromShards reads the repository metadata out of the given shard
+// files.
+func recordsFromShards(shards []string) []record {
+	var records []record
+	for _, shard := range shards {
+		repos, _, err := index.ReadMetadataPath(shard)
+		if err != nil || len(repos) == 0 {
+			continue
+		}
+		records = append(records, record{
+			Name:   repos[0].Name,
+			Source: repos[0].Source,
+			Shard:  shard,
+		})
+	}
+	return records
+}
+
+// removeShardFiles reports (dry run) or removes (apply) all of the files
+// that make up the shard identified by rec.Shard.
+func removeShardFiles(rec record, apply bool, out io.Writer) error {
+	paths, err := index.IndexFilePaths(rec.Shard)
+	if err != nil {
+		return err
+	}
+
+	if !apply {
+		for _, p := range paths {
+			fmt.Fprintf(out, "Would remove %s\n", p)
+		}
+		return nil
+	}
+
+	for _, p := range paths {
+		if err := os.Remove(p); err != nil && !os.IsNotExist(err) {
+			return err
+		}
+	}
+	fmt.Fprintf(out, "Removed %s\n", rec.Shard)
+
+	return nil
+}
+
+// syncOptions bundles the options needed to index a discovered repository.
+type syncOptions struct {
+	buildOptions       index.Options
+	branches           []string
+	branchPrefix       string
+	submodules         bool
+	allowMissingBranch bool
+	repoCacheDir       string
+	isDelta            bool
+	deltaThreshold     uint64
+}
+
+// gitOptionsFor builds the gitindex.Options used to index repo.
+func gitOptionsFor(repo Repository, opts syncOptions) gitindex.Options {
+	buildOptions := opts.buildOptions
+	buildOptions.RepositoryDescription.Name = repo.Name
+	buildOptions.IsDelta = opts.isDelta
+
+	return gitindex.Options{
+		RepoDir:                           repo.Path,
+		Submodules:                        opts.submodules,
+		Incremental:                       true,
+		AllowMissingBranch:                opts.allowMissingBranch,
+		RepoCacheDir:                      opts.repoCacheDir,
+		BuildOptions:                      buildOptions,
+		BranchPrefix:                      opts.branchPrefix,
+		Branches:                          opts.branches,
+		DeltaShardNumberFallbackThreshold: opts.deltaThreshold,
+	}
+}
+
+// runSyncPlan indexes the discovered repositories and prunes shards for
+// repositories that are no longer discovered under any root. When apply is
+// false nothing is written or removed; the actions that would be taken are
+// reported to out instead.
+func runSyncPlan(repositories []Repository, opts syncOptions, apply bool, out io.Writer) error {
+	discovered := make(map[string]bool, len(repositories))
+	for _, repo := range repositories {
+		discovered[repo.Name] = true
+	}
+
+	for _, repo := range repositories {
+		gitOpts := gitOptionsFor(repo, opts)
+		gitOpts.DryRun = true
+
+		needsIndex, err := gitindex.IndexGitRepo(gitOpts)
+		if err != nil {
+			return fmt.Errorf("checking %s: %w", repo.Name, err)
+		}
+
+		if !needsIndex {
+			fmt.Fprintf(out, "Up to date %q\n", repo.Name)
+			continue
+		}
+
+		if !apply {
+			fmt.Fprintf(out, "Would index %q\n", repo.Name)
+			continue
+		}
+
+		fmt.Fprintf(out, "Indexing %q from %s\n", repo.Name, repo.Path)
+		if _, err := gitindex.IndexGitRepo(gitOptionsFor(repo, opts)); err != nil {
+			return fmt.Errorf("indexing %s: %w", repo.Name, err)
+		}
+		fmt.Fprintf(out, "Indexed %q\n", repo.Name)
+	}
+
+	shards, err := readInventory(opts.buildOptions.IndexDir)
+	if err != nil {
+		return err
+	}
+
+	for _, rec := range recordsFromShards(shards) {
+		if discovered[rec.Name] {
+			continue
+		}
+		if err := removeShardFiles(rec, apply, out); err != nil {
+			return fmt.Errorf("removing %s: %w", rec.Name, err)
+		}
+	}
+
+	if !apply {
+		fmt.Fprintln(out, "Pass -f to apply these changes.")
+	}
+
+	return nil
+}
