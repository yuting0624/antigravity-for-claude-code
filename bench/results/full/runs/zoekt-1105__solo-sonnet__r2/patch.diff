+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+
+	"golang.org/x/sys/unix"
+)
+
+// lockFileName is the name of the advisory lock file placed in an index
+// directory to prevent two zoekt-local-sync processes from writing to it
+// concurrently.
+const lockFileName = ".zoekt-local-sync.lock"
+
+// acquireDirectoryLock takes an exclusive, non-blocking advisory lock on
+// dir. The returned io.Closer releases the lock. It fails if another
+// process already holds the lock.
+func acquireDirectoryLock(dir string) (io.Closer, error) {
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return nil, fmt.Errorf("creating index directory %s: %w", dir, err)
+	}
+
+	f, err := os.OpenFile(filepath.Join(dir, lockFileName), os.O_CREATE|os.O_RDWR, 0o644)
+	if err != nil {
+		return nil, fmt.Errorf("opening lock file: %w", err)
+	}
+
+	if err := unix.Flock(int(f.Fd()), unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		f.Close()
+		return nil, fmt.Errorf("another zoekt-local-sync process is already syncing %s: %w", dir, err)
+	}
+
+	return &directoryLock{file: f}, nil
+}
+
+type directoryLock struct {
+	file *os.File
+}
+
+func (l *directoryLock) Close() error {
+	defer l.file.Close()
+	return unix.Flock(int(l.file.Fd()), unix.LOCK_UN)
+}
diff --git a/cmd/zoekt-local-sync/main.go b/cmd/zoekt-local-sync/main.go
new file mode 100644
index 00000000..ebe8a67c
--- /dev/null
+++ b/cmd/zoekt-local-sync/main.go
@@ -0,0 +1,260 @@
+// Copyright 2026 Sourcegraph, Inc. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Command zoekt-local-sync keeps a local zoekt index in sync with the git
+// repositories found beneath one or more root directories.
+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strings"
+	"text/tabwriter"
+
+	"github.com/sourcegraph/zoekt/index"
+)
+
+func main() {
+	if err := execute(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			os.Exit(2)
+		}
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+// execute runs zoekt-local-sync with the given arguments, writing normal
+// output to out and diagnostics/usage to errOut. It is the entry point
+// used by both main and the tests.
+func execute(args []string, out, errOut io.Writer) error {
+	if len(args) > 0 {
+		switch args[0] {
+		case "-h", "--help", "help":
+			printTopLevelHelp(out)
+			return nil
+		case "sync":
+			return runSync(args[1:], out, errOut)
+		case "list":
+			return runList(args[1:], out, errOut)
+		case "remove":
+			return runRemove(args[1:], out, errOut)
+		}
+	}
+
+	return runSync(args, out, errOut)
+}
+
+func printTopLevelHelp(out io.Writer) {
+	fmt.Fprint(out, `Usage: zoekt-local-sync <command> [options] <root>...
+
+zoekt-local-sync discovers the git repositories beneath one or more root
+directories and keeps a zoekt index in sync with them. A repository's name
+is derived from its path relative to the root it was found under.
+
+Commands:
+  zoekt-local-sync sync [options] <root>...
+        (default) discover repositories under the given roots; preview the
+        indexing/pruning plan, or apply it with -f.
+  zoekt-local-sync list [options]
+        list the repositories currently present in the index.
+  zoekt-local-sync remove [options] <name-or-source>...
+        preview, or with -f apply, removal of the named repositories.
+
+Run "zoekt-local-sync list -h" or "zoekt-local-sync remove -h" for a
+subcommand's own options.
+
+`)
+	fs := newSyncFlagSet(out)
+	fmt.Fprintln(out, "Default sync options:")
+	fs.PrintDefaults()
+}
+
+func newSyncFlagSet(output io.Writer) *flag.FlagSet {
+	fs := flag.NewFlagSet("sync", flag.ContinueOnError)
+	fs.SetOutput(output)
+	fs.Bool("f", false, "apply the plan instead of previewing it")
+	fs.String("branches", "HEAD", "comma separated list of git branches to index")
+	fs.String("prefix", "refs/heads/", "prefix for branch names")
+	fs.Bool("submodules", true, "if set to false, do not recurse into submodules")
+	fs.Bool("allow_missing_branches", false, "allow missing branches")
+	fs.String("repo_cache", "", "directory holding bare git repos, used to find repositories for submodules")
+	fs.Bool("delta", false, "whether we should use delta build")
+	fs.Uint64("delta_threshold", 0, "upper limit on the number of preexisting shards that can exist before attempting a delta build (0 to disable fallback behavior)")
+	(&index.Options{}).Flags(fs)
+	return fs
+}
+
+func runSync(args []string, out, errOut io.Writer) error {
+	fs := flag.NewFlagSet("sync", flag.ContinueOnError)
+	fs.SetOutput(errOut)
+
+	force := fs.Bool("f", false, "apply the plan instead of previewing it")
+	branchesStr := fs.String("branches", "HEAD", "comma separated list of git branches to index")
+	branchPrefix := fs.String("prefix", "refs/heads/", "prefix for branch names")
+	submodules := fs.Bool("submodules", true, "if set to false, do not recurse into submodules")
+	allowMissingBranch := fs.Bool("allow_missing_branches", false, "allow missing branches")
+	repoCacheDir := fs.String("repo_cache", "", "directory holding bare git repos, used to find repositories for submodules")
+	isDelta := fs.Bool("delta", false, "whether we should use delta build")
+	deltaThreshold := fs.Uint64("delta_threshold", 0, "upper limit on the number of preexisting shards that can exist before attempting a delta build (0 to disable fallback behavior)")
+	buildOptions := &index.Options{}
+	buildOptions.Flags(fs)
+
+	fs.Usage = func() {
+		fmt.Fprint(fs.Output(), `Usage: zoekt-local-sync sync [options] <root>...
+
+Discover the git repositories beneath the given roots; preview the
+indexing/pruning plan, or apply it with -f.
+
+`)
+		fs.PrintDefaults()
+	}
+
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	roots := fs.Args()
+	if len(roots) == 0 {
+		return fmt.Errorf("zoekt-local-sync: at least one root directory is required")
+	}
+
+	buildOptions.SetDefaults()
+
+	lock, err := acquireDirectoryLock(buildOptions.IndexDir)
+	if err != nil {
+		return err
+	}
+	defer lock.Close()
+
+	repositories, err := discoverRepositories(roots)
+	if err != nil {
+		return err
+	}
+
+	var branches []string
+	if *branchesStr != "" {
+		branches = strings.Split(*branchesStr, ",")
+	}
+
+	opts := syncOptions{
+		buildOptions:       *buildOptions,
+		branches:           branches,
+		branchPrefix:       *branchPrefix,
+		submodules:         *submodules,
+		allowMissingBranch: *allowMissingBranch,
+		repoCacheDir:       *repoCacheDir,
+		isDelta:            *isDelta,
+		deltaThreshold:     *deltaThreshold,
+	}
+
+	return runSyncPlan(repositories, opts, *force, out)
+}
+
+func runList(args []string, out, errOut io.Writer) error {
+	fs := flag.NewFlagSet("list", flag.ContinueOnError)
+	fs.SetOutput(errOut)
+	indexDir := fs.String("index", index.DefaultDir, "directory holding search indices")
+
+	fs.Usage = func() {
+		fmt.Fprint(fs.Output(), `Usage: zoekt-local-sync list [options]
+
+List the repositories currently present in the index.
+
+`)
+		fs.PrintDefaults()
+	}
+
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	shards, err := readInventory(*indexDir)
+	if err != nil {
+		return err
+	}
+
+	records := recordsFromShards(shards)
+	sort.Slice(records, func(i, j int) bool { return records[i].Name < records[j].Name })
+
+	tw := tabwriter.NewWriter(out, 0, 4, 2, ' ', 0)
+	fmt.Fprintln(tw, "NAME\tSOURCE\tSHARD")
+	for _, rec := range records {
+		fmt.Fprintf(tw, "%s\t%s\t%s\n", rec.Name, rec.Source, rec.Shard)
+	}
+
+	return tw.Flush()
+}
+
+func runRemove(args []string, out, errOut io.Writer) error {
+	fs := flag.NewFlagSet("remove", flag.ContinueOnError)
+	fs.SetOutput(errOut)
+	indexDir := fs.String("index", index.DefaultDir, "directory holding search indices")
+	force := fs.Bool("f", false, "apply the removal instead of previewing it")
+
+	fs.Usage = func() {
+		fmt.Fprint(fs.Output(), `Usage: zoekt-local-sync remove [options] <name-or-source>...
+
+Preview, or with -f apply, removal of the named repositories. Each
+argument may be either a repository's name or its source path, as shown by
+"zoekt-local-sync list".
+
+`)
+		fs.PrintDefaults()
+	}
+
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	targets := fs.Args()
+	if len(targets) == 0 {
+		return fmt.Errorf("zoekt-local-sync: at least one repository name or source is required")
+	}
+
+	lock, err := acquireDirectoryLock(*indexDir)
+	if err != nil {
+		return err
+	}
+	defer lock.Close()
+
+	want := make(map[string]bool, len(targets))
+	for _, t := range targets {
+		want[t] = true
+	}
+
+	shards, err := readInventory(*indexDir)
+	if err != nil {
+		return err
+	}
+
+	for _, rec := range recordsFromShards(shards) {
+		if !want[rec.Name] && !want[rec.Source] {
+			continue
+		}
+		if err := removeShardFiles(rec, *force, out); err != nil {
+			return fmt.Errorf("removing %s: %w", rec.Name, err)
+		}
+	}
+
+	if !*force {
+		fmt.Fprintln(out, "Pass -f to apply these changes.")
+	}
+
+	return nil
+}
