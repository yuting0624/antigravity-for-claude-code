diff --git a/internal/attachments/attach.go b/internal/attachments/attach.go
new file mode 100644
index 000000000..c88db9d2b
--- /dev/null
+++ b/internal/attachments/attach.go
@@ -0,0 +1,83 @@
+package attachments
+
+import (
+	"context"
+	"strings"
+)
+
+// UploadAndAttach uploads every asset and writes it into body: a reference the
+// author already wrote is pointed at the asset URL in place, and anything the
+// body never referenced is appended below it.
+//
+// It returns the body to write and how many assets got up. An upload cannot be
+// deleted, so whenever that count is above zero the caller has to write the
+// body it returns even though the call failed, or the assets are stranded
+// where nobody can reach them.
+func (u *Uploader) UploadAndAttach(ctx context.Context, body string, assets []UserAsset) (string, int, error) {
+	if len(assets) == 0 {
+		return body, 0, nil
+	}
+
+	args := make([]attachmentArg, len(assets))
+	for i, asset := range assets {
+		args[i] = attachmentArg{
+			Path:            asset.Path(),
+			Alt:             asset.getAsset().alt,
+			RendersAsPlayer: asset.rendersAsPlayer(),
+		}
+	}
+
+	// Refused here, before the upload loop, so that markdown the assets cannot
+	// be written into strands nothing.
+	attachable, err := newAttachableMarkdown(body, args)
+	if err != nil {
+		return body, 0, err
+	}
+
+	uploaded := 0
+	var uploadErr error
+	for i, asset := range assets {
+		assetURL, err := u.upload(ctx, asset)
+		if err != nil {
+			uploadErr = err
+			break
+		}
+		attachable.args[i].URL = assetURL
+		uploaded++
+	}
+
+	attached, err := attachAssetsToMarkdown(attachable)
+	if err != nil {
+		return body, uploaded, err
+	}
+
+	written := attached.Rewritten
+	for _, arg := range attached.ToAppend {
+		written = appendParagraph(written, arg.markdown())
+	}
+
+	return written, uploaded, uploadErr
+}
+
+// markdown renders an attachment below a body, which is where an attachment
+// the body never referenced ends up.
+func (a attachmentArg) markdown() string {
+	if a.RendersAsPlayer {
+		// A bare URL only renders as a player when nothing shares its
+		// paragraph.
+		return a.URL
+	}
+	return "![" + escapeAltText(a.Alt) + "](" + a.URL + ")"
+}
+
+// appendParagraph puts addition below md as a paragraph of its own.
+func appendParagraph(md, addition string) string {
+	if addition == "" {
+		return md
+	}
+	trimmed := strings.TrimRight(md, " \t\r\n")
+	if trimmed == "" {
+		return addition
+	}
+	return trimmed + "\n\n" + addition
+}
diff --git a/internal/attachments/client.go b/internal/attachments/client.go
new file mode 100644
index 000000000..fc8adc13e
--- /dev/null
+++ b/internal/attachments/client.go
@@ -0,0 +1,226 @@
+package attachments
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/cli/cli/v2/api"
+	"github.com/cli/cli/v2/internal/gh"
+	"github.com/cli/cli/v2/internal/ghinstance"
+	ghauth "github.com/cli/go-gh/v2/pkg/auth"
+)
+
+const uploadPath = "user-attachments/assets"
+
+// uploadableTokenTypes are the credentials the user attachments endpoint
+// accepts. A GitHub App token is not one of them, and neither is a refresh
+// token.
+var uploadableTokenTypes = map[gh.TokenType]bool{
+	gh.TokenTypeOAuth:          true,
+	gh.TokenTypePersonalAccess: true,
+	gh.TokenTypeFineGrainedPAT: true,
+}
+
+// writePermissions are the roles the endpoint accepts. Triage is the highest
+// one it still refuses.
+var writePermissions = map[string]bool{
+	"ADMIN":    true,
+	"MAINTAIN": true,
+	"WRITE":    true,
+}
+
+// Uploader posts files to the user attachments endpoint of one host, on behalf
+// of one repository.
+type Uploader struct {
+	httpClient       *http.Client
+	host             string
+	targetRepository int64
+}
+
+// NewUploader refuses everything it can before a byte goes anywhere, since an
+// upload cannot be taken back.
+func NewUploader(httpClient *http.Client, tokenType gh.TokenType, host string, targetRepository int64, viewerPermission string) (*Uploader, error) {
+	if err := checkHost(host); err != nil {
+		return nil, err
+	}
+	if !uploadableTokenTypes[tokenType] {
+		return nil, errors.New("unsupported authentication type")
+	}
+	if targetRepository <= 0 {
+		return nil, errors.New("could not determine which repository to attach files to")
+	}
+	if viewerPermission == "" {
+		return nil, errors.New("could not determine your permission on the repository to attach files")
+	}
+	if !writePermissions[strings.ToUpper(viewerPermission)] {
+		return nil, errors.New("attaching files requires write access to the repository")
+	}
+
+	return &Uploader{
+		httpClient:       httpClient,
+		host:             host,
+		targetRepository: targetRepository,
+	}, nil
+}
+
+// checkHost refuses a host that has no user attachments endpoint.
+func checkHost(host string) error {
+	if ghauth.IsEnterprise(host) {
+		return errors.New("attaching files is not supported on GitHub Enterprise Server")
+	}
+	return nil
+}
+
+// upload posts one asset and returns the URL GitHub gave it.
+func (u *Uploader) upload(ctx context.Context, a UserAsset) (string, error) {
+	asset := a.getAsset()
+
+	query := url.Values{}
+	query.Set("repository_id", strconv.FormatInt(u.targetRepository, 10))
+	query.Set("name", filepath.Base(asset.path))
+	query.Set("content_type", asset.contentType)
+
+	endpoint := ghinstance.UserAssetUploadPrefix(u.host) + uploadPath + "?" + query.Encode()
+
+	body, err := openFile(asset.path)
+	if err != nil {
+		return "", &uploadError{Path: asset.path, err: err}
+	}
+	defer body.Close()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, body)
+	if err != nil {
+		return "", &uploadError{Path: asset.path, err: err}
+	}
+	req.Header.Set("Content-Type", "application/octet-stream")
+	req.Header.Set("Accept", "application/vnd.github+json")
+	req.ContentLength = asset.info.Size()
+
+	// One attempt, whatever the failure: an upload cannot be deleted, so a
+	// retry of a request the server had already accepted would orphan an asset
+	// nobody can remove.
+	resp, err := u.httpClient.Do(req)
+	if err != nil {
+		return "", &uploadError{Path: asset.path, err: err}
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode > 299 {
+		return "", newUploadError(asset.path, resp)
+	}
+
+	var result struct {
+		URL string `json:"url"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
+		return "", &uploadError{Path: asset.path, err: err}
+	}
+	if result.URL == "" {
+		return "", &uploadError{Path: asset.path, err: errors.New("the server returned no asset URL")}
+	}
+	return result.URL, nil
+}
+
+// uploadError is an upload that did not produce an asset. It carries the path
+// the author wrote and the status the server answered with, and never the
+// asset URL, which a caller has to be able to write even when the call failed.
+type uploadError struct {
+	Path       string
+	StatusCode int
+
+	// reason is the server's refusal in gh's words, and err is a failure that
+	// has no words of its own.
+	reason string
+	err    error
+}
+
+func (e *uploadError) Error() string {
+	if e.err != nil {
+		return fmt.Sprintf("failed to upload %s: %v", e.Path, e.err)
+	}
+	if e.reason == "" {
+		return fmt.Sprintf("could not upload %s", e.Path)
+	}
+	return fmt.Sprintf("could not upload %s: %s", e.Path, e.reason)
+}
+
+func (e *uploadError) Unwrap() error { return e.err }
+
+// newUploadError turns a refusal into something the user can act on. Only the
+// statuses with a remedy get gh's own words; the rest keep the server's.
+func newUploadError(path string, resp *http.Response) error {
+	switch resp.StatusCode {
+	case http.StatusNotFound:
+		return &uploadError{
+			Path:       path,
+			StatusCode: resp.StatusCode,
+			reason:     "attaching files requires write access to the repository",
+		}
+	case http.StatusTooManyRequests:
+		return &uploadError{
+			Path:       path,
+			StatusCode: resp.StatusCode,
+			reason:     rateLimitReason(resp.Header.Get("Retry-After")),
+		}
+	case http.StatusUnprocessableEntity:
+		return &uploadError{
+			Path:       path,
+			StatusCode: resp.StatusCode,
+			reason:     validationReason(resp),
+		}
+	default:
+		return &uploadError{
+			Path:       path,
+			StatusCode: resp.StatusCode,
+			err:        api.HandleHTTPError(resp),
+		}
+	}
+}
+
+func rateLimitReason(retryAfter string) string {
+	if retryAfter == "" {
+		return "rate limited; wait and try again"
+	}
+	if _, err := strconv.Atoi(retryAfter); err == nil {
+		return fmt.Sprintf("rate limited; retry after %s seconds", retryAfter)
+	}
+	return fmt.Sprintf("rate limited; retry after %s", retryAfter)
+}
+
+// validationReason reads the causes the server stated, since only it knows
+// which of them applies.
+func validationReason(resp *http.Response) string {
+	var payload struct {
+		Message string `json:"message"`
+		Errors  []struct {
+			Resource string `json:"resource"`
+			Field    string `json:"field"`
+			Code     string `json:"code"`
+			Message  string `json:"message"`
+		} `json:"errors"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&payload); err != nil {
+		return ""
+	}
+	if payload.Message == "" {
+		return ""
+	}
+
+	causes := []string{payload.Message}
+	for _, e := range payload.Errors {
+		switch {
+		case e.Message != "":
+			causes = append(causes, e.Message)
+		case e.Code != "":
+			causes = append(causes, fmt.Sprintf("%s.%s is %s", e.Resource, e.Field, e.Code))
+		}
+	}
+	return strings.Join(causes, "; ")
+}
diff --git a/internal/attachments/flags.go b/internal/attachments/flags.go
new file mode 100644
index 000000000..b76e11002
--- /dev/null
+++ b/internal/attachments/flags.go
@@ -0,0 +1,105 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"os"
+
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+)
+
+const flagName = "attach"
+
+// Flag is the --attach flag of a command, and the resolver for the values it
+// collected.
+type Flag struct {
+	flag   *pflag.Flag
+	values *[]string
+}
+
+// AddFlag registers --attach on cmd and returns the handle a command uses to
+// resolve what was passed.
+func AddFlag(cmd *cobra.Command) *Flag {
+	// A string array rather than a string slice, because a comma is a legal
+	// character in a file name.
+	values := cmd.Flags().StringArray(flagName, nil,
+		"Attach an image or video `file`, in '<file>#<image alt text>' format")
+
+	return &Flag{
+		flag:   cmd.Flags().Lookup(flagName),
+		values: values,
+	}
+}
+
+// Changed reports whether the flag was passed at all.
+func (f *Flag) Changed() bool {
+	return f != nil && f.flag != nil && f.flag.Changed
+}
+
+// UserAssets validates every value the flag collected, in the order they were
+// written, and returns the assets they name. Nothing is uploaded here: a
+// command has to be able to refuse a bad file before it writes anything.
+func (f *Flag) UserAssets() ([]UserAsset, error) {
+	if !f.Changed() {
+		return nil, nil
+	}
+
+	values := *f.values
+	assets := make([]UserAsset, 0, len(values))
+	for _, value := range values {
+		switch value {
+		case "":
+			return nil, errors.New("cannot attach an empty path; --attach needs a file path")
+		case "-":
+			return nil, errors.New("cannot attach standard input; --attach needs a file path")
+		}
+
+		path, alt := splitPathAndAlt(value)
+		asset, err := newAsset(path, alt)
+		if err != nil {
+			return nil, err
+		}
+		for _, seen := range assets {
+			if os.SameFile(seen.getAsset().info, asset.getAsset().info) {
+				return nil, fmt.Errorf("%s and %s are the same file; attached files must be unique",
+					seen.Path(), asset.Path())
+			}
+		}
+		assets = append(assets, asset)
+	}
+
+	return assets, nil
+}
+
+// splitPathAndAlt cuts a value into the file it names and the alt text after
+// it. A "#" is legal in a file name, so the longest prefix that names an
+// existing file wins; when none does, the last "#" is the separator, leaving
+// the path to report itself as missing.
+func splitPathAndAlt(value string) (path, alt string) {
+	if _, err := os.Stat(value); err == nil {
+		return value, ""
+	}
+
+	lastHash := -1
+	for i := len(value) - 1; i >= 0; i-- {
+		if value[i] != '#' {
+			continue
+		}
+		if lastHash == -1 {
+			lastHash = i
+		}
+		candidate := value[:i]
+		if candidate == "" {
+			continue
+		}
+		if _, err := os.Stat(candidate); err == nil {
+			return candidate, value[i+1:]
+		}
+	}
+
+	if lastHash == -1 {
+		return value, ""
+	}
+	return value[:lastHash], value[lastHash+1:]
+}
diff --git a/internal/attachments/references.go b/internal/attachments/references.go
new file mode 100644
index 000000000..ef8bd69c0
--- /dev/null
+++ b/internal/attachments/references.go
@@ -0,0 +1,770 @@
+package attachments
+
+import (
+	"fmt"
+	"net/url"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/yuin/goldmark"
+	"github.com/yuin/goldmark/ast"
+	"github.com/yuin/goldmark/parser"
+	"github.com/yuin/goldmark/text"
+)
+
+// attachmentArg is one attached file as the rewriter sees it: where it came
+// from, where it went and how it should read once it is there. URL is empty
+// until the file has been uploaded, and stays empty when the upload failed.
+type attachmentArg struct {
+	Path            string
+	URL             string
+	Alt             string
+	RendersAsPlayer bool
+}
+
+// attachableMarkdown is markdown that has been checked against a set of
+// attachments and can carry them. Building one is the only way to reach the
+// rewriter, so markdown that cannot work is refused before anything uploads.
+type attachableMarkdown struct {
+	markdown string
+	args     []attachmentArg
+}
+
+// paths lists the files a set of attachments names, for a message about them.
+func paths(args []attachmentArg) string {
+	names := make([]string, 0, len(args))
+	for _, a := range args {
+		names = append(names, a.Path)
+	}
+	return strings.Join(names, ", ")
+}
+
+// attachedMarkdown is the result of writing the attachments into the markdown.
+type attachedMarkdown struct {
+	// Rewritten is the markdown with every reference to an attached file
+	// pointing at its asset URL.
+	Rewritten string
+	// ToAppend holds the attachments the markdown never referenced, in the
+	// order they were passed, for the caller to append.
+	ToAppend []attachmentArg
+}
+
+// newAttachableMarkdown refuses markdown that the attachments cannot be
+// written into. The only such case is a video embedded through a
+// reference-style image: the definition is shared with every other usage of
+// its label, so the embed cannot be degraded to a link the way an inline one
+// can.
+func newAttachableMarkdown(markdown string, args []attachmentArg) (attachableMarkdown, error) {
+	a := analyze(markdown, args)
+
+	var offending []attachmentArg
+	for i, arg := range args {
+		if !arg.RendersAsPlayer {
+			continue
+		}
+		if a.referenceStyleImages[i] > 0 {
+			offending = append(offending, arg)
+		}
+	}
+	if len(offending) > 0 {
+		return attachableMarkdown{}, fmt.Errorf("cannot embed a video as a reference-style image: %s", paths(offending))
+	}
+
+	return attachableMarkdown{markdown: markdown, args: args}, nil
+}
+
+// attachAssetsToMarkdown points every reference to an attached file at its
+// asset URL and reports the attachments nothing referenced.
+func attachAssetsToMarkdown(v attachableMarkdown) (attachedMarkdown, error) {
+	a := analyze(v.markdown, v.args)
+	src := []byte(v.markdown)
+
+	// Each group holds the edits one usage needs, so that a usage swallowed by
+	// an enclosing one is dropped whole rather than half-applied.
+	var groups []editGroup
+
+	for _, occ := range a.occurrences {
+		arg := v.args[occ.argIndex]
+		if arg.URL == "" {
+			continue
+		}
+		groups = append(groups, occ.edits(src, arg))
+	}
+
+	for _, def := range a.definitions {
+		arg := v.args[def.argIndex]
+		if arg.URL == "" || a.referenceStyleUsages[def.argIndex] == 0 {
+			continue
+		}
+		groups = append(groups, editGroup{
+			argIndex: def.argIndex,
+			edits:    []edit{{start: def.destStart, end: def.destEnd, text: arg.URL}},
+		})
+	}
+
+	rewritten, applied := applyEdits(src, groups)
+
+	var toAppend []attachmentArg
+	for i, arg := range v.args {
+		if arg.URL == "" || applied[i] {
+			continue
+		}
+		toAppend = append(toAppend, arg)
+	}
+
+	return attachedMarkdown{Rewritten: rewritten, ToAppend: toAppend}, nil
+}
+
+// isSingleImage reports whether markdown is exactly one image pointing at
+// assetURL and nothing else.
+func isSingleImage(markdown, assetURL string) bool {
+	src := []byte(markdown)
+	doc := goldmark.New().Parser().Parse(text.NewReader(src))
+
+	paragraph := doc.FirstChild()
+	if paragraph == nil || paragraph != doc.LastChild() || paragraph.Kind() != ast.KindParagraph {
+		return false
+	}
+	image, ok := paragraph.FirstChild().(*ast.Image)
+	if !ok || image != paragraph.LastChild() {
+		return false
+	}
+	return string(image.Destination) == assetURL
+}
+
+// analysis is everything the rewriter and the validator need to know about one
+// markdown document and the files attached to it.
+type analysis struct {
+	// occurrences are the inline usages, in source order.
+	occurrences []occurrence
+	// definitions are the link reference definitions whose destination names
+	// an attached file, keyed to it.
+	definitions []definition
+	// referenceStyleUsages counts, per attachment, the usages that take their
+	// destination from a definition rather than writing it inline.
+	referenceStyleUsages map[int]int
+	// referenceStyleImages counts only the embeds among those.
+	referenceStyleImages map[int]int
+}
+
+// occurrence is one inline link or image whose destination names an attached
+// file.
+type occurrence struct {
+	argIndex int
+	isImage  bool
+	// spanStart is the "!" of an image or the "[" of a link, and spanEnd is
+	// just past the closing ")".
+	spanStart int
+	spanEnd   int
+	// labelStart and labelEnd bound the text between the brackets.
+	labelStart int
+	labelEnd   int
+	destStart  int
+	destEnd    int
+	// aloneInParagraph reports whether nothing but whitespace shares the
+	// paragraph with this usage, which is what decides whether a video can
+	// render as a player.
+	aloneInParagraph bool
+}
+
+type definition struct {
+	argIndex  int
+	destStart int
+	destEnd   int
+}
+
+type edit struct {
+	start int
+	end   int
+	text  string
+}
+
+type editGroup struct {
+	argIndex int
+	edits    []edit
+}
+
+// edits returns the changes this usage needs to point at the uploaded asset.
+func (o occurrence) edits(src []byte, arg attachmentArg) editGroup {
+	group := editGroup{argIndex: o.argIndex}
+
+	if o.isImage && arg.RendersAsPlayer {
+		if o.aloneInParagraph {
+			// A bare URL on its own is the only form that renders as a player.
+			group.edits = append(group.edits, edit{start: o.spanStart, end: o.spanEnd, text: arg.URL})
+			return group
+		}
+
+		// Degrade the embed to a link. Dropping the "!" would leave a "!"
+		// in front of it touching the "[", re-forming an embed, so escape
+		// that one unless markdown already did.
+		start, text := o.spanStart, ""
+		if o.spanStart > 0 && src[o.spanStart-1] == '!' && !isEscaped(src, o.spanStart-1, 0) {
+			start, text = o.spanStart-1, `\!`
+		}
+		group.edits = append(group.edits, edit{start: start, end: o.spanStart + 1, text: text})
+
+		if o.labelEnd == o.labelStart {
+			// Nothing labels the link, so the file name stands in.
+			group.edits = append(group.edits, edit{
+				start: o.labelStart,
+				end:   o.labelStart,
+				text:  escapeAltText(arg.Alt),
+			})
+		}
+	}
+
+	group.edits = append(group.edits, edit{start: o.destStart, end: o.destEnd, text: arg.URL})
+	return group
+}
+
+// applyEdits writes the groups into src, dropping any group that overlaps one
+// already written, and reports which attachments ended up in the result.
+func applyEdits(src []byte, groups []editGroup) (string, map[int]bool) {
+	sort.SliceStable(groups, func(i, j int) bool {
+		return groups[i].start() < groups[j].start()
+	})
+
+	applied := map[int]bool{}
+	var accepted []edit
+	for _, group := range groups {
+		if overlapsAny(accepted, group.edits) {
+			continue
+		}
+		accepted = append(accepted, group.edits...)
+		applied[group.argIndex] = true
+	}
+
+	sort.SliceStable(accepted, func(i, j int) bool { return accepted[i].start < accepted[j].start })
+
+	var b strings.Builder
+	last := 0
+	for _, e := range accepted {
+		b.Write(src[last:e.start])
+		b.WriteString(e.text)
+		last = e.end
+	}
+	b.Write(src[last:])
+	return b.String(), applied
+}
+
+func (g editGroup) start() int {
+	start := g.edits[0].start
+	for _, e := range g.edits {
+		if e.start < start {
+			start = e.start
+		}
+	}
+	return start
+}
+
+func overlapsAny(accepted []edit, candidates []edit) bool {
+	for _, a := range accepted {
+		for _, c := range candidates {
+			// This also covers a zero width insertion, which conflicts only
+			// with a range it sits strictly inside.
+			if c.start < a.end && a.start < c.end {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// analyze parses markdown and works out how each attachment is referenced.
+func analyze(markdown string, args []attachmentArg) analysis {
+	a := analysis{
+		referenceStyleUsages: map[int]int{},
+		referenceStyleImages: map[int]int{},
+	}
+
+	src := []byte(markdown)
+	doc := goldmark.New().Parser().Parse(text.NewReader(src), parser.WithContext(parser.NewContext()))
+
+	normalized := make([]string, len(args))
+	for i, arg := range args {
+		normalized[i] = normalizePath(arg.Path)
+	}
+	match := func(destination string) int {
+		for i, want := range normalized {
+			if pathsMatch(destination, want) {
+				return i
+			}
+		}
+		return -1
+	}
+
+	codeSpans := collectCodeSpans(doc)
+
+	// goldmark resolves a reference-style usage into the same node an inline
+	// one produces, and records no label on it, so the two are told apart by
+	// counting: any usage the source scan cannot account for took its
+	// destination from a definition.
+	astUsages := map[int]int{}
+	astImages := map[int]int{}
+	var blocks []ast.Node
+	var definitionNodes []*ast.LinkReferenceDefinition
+
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		switch node := n.(type) {
+		case *ast.Image:
+			if i := match(unescapeMarkdown(string(node.Destination))); i >= 0 {
+				astUsages[i]++
+				astImages[i]++
+			}
+		case *ast.Link:
+			if i := match(unescapeMarkdown(string(node.Destination))); i >= 0 {
+				astUsages[i]++
+			}
+		case *ast.LinkReferenceDefinition:
+			definitionNodes = append(definitionNodes, node)
+		case *ast.Paragraph, *ast.Heading, *ast.TextBlock:
+			blocks = append(blocks, n)
+		}
+		return ast.WalkContinue, nil
+	})
+
+	scanUsages := map[int]int{}
+	scanImages := map[int]int{}
+	for _, block := range blocks {
+		_, isParagraph := block.(*ast.Paragraph)
+		lines := block.Lines()
+		for i := 0; i < lines.Len(); i++ {
+			segment := lines.At(i)
+			for _, occ := range scanSegment(src, segment.Start, segment.Stop, codeSpans, match) {
+				occ.aloneInParagraph = isParagraph && aloneInBlock(src, lines, occ.spanStart, occ.spanEnd)
+				a.occurrences = append(a.occurrences, occ)
+				scanUsages[occ.argIndex]++
+				if occ.isImage {
+					scanImages[occ.argIndex]++
+				}
+			}
+		}
+	}
+
+	for i := range args {
+		if n := astUsages[i] - scanUsages[i]; n > 0 {
+			a.referenceStyleUsages[i] = n
+		}
+		if n := astImages[i] - scanImages[i]; n > 0 {
+			a.referenceStyleImages[i] = n
+		}
+	}
+
+	for _, node := range definitionNodes {
+		lines := node.Lines()
+		if lines.Len() == 0 {
+			continue
+		}
+		// Only the first line is considered: a definition continued onto the
+		// next one has a block range that no longer lines up with the source,
+		// so rewriting it could eat the markup around it.
+		segment := lines.At(0)
+		start, end, destination, ok := scanDefinitionDestination(src, segment.Start, segment.Stop)
+		if !ok {
+			continue
+		}
+		if i := match(destination); i >= 0 {
+			a.definitions = append(a.definitions, definition{argIndex: i, destStart: start, destEnd: end})
+		}
+	}
+
+	return a
+}
+
+// aloneInBlock reports whether everything in the block outside [start, end) is
+// whitespace.
+func aloneInBlock(src []byte, lines *text.Segments, start, end int) bool {
+	for i := 0; i < lines.Len(); i++ {
+		segment := lines.At(i)
+		for j := segment.Start; j < segment.Stop; j++ {
+			if j >= start && j < end {
+				continue
+			}
+			if !isSpace(src[j]) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// byteRange is a half open range of source bytes.
+type byteRange struct {
+	start int
+	stop  int
+}
+
+// collectCodeSpans returns the source held by every inline code span, which
+// the scan has to step over: a "](" written there is not a reference, and a
+// bracket written there cannot pair with one outside it.
+func collectCodeSpans(doc ast.Node) []byteRange {
+	var spans []byteRange
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		code, ok := n.(*ast.CodeSpan)
+		if !ok {
+			return ast.WalkContinue, nil
+		}
+		span := byteRange{start: -1}
+		for child := code.FirstChild(); child != nil; child = child.NextSibling() {
+			t, ok := child.(*ast.Text)
+			if !ok {
+				continue
+			}
+			if span.start == -1 || t.Segment.Start < span.start {
+				span.start = t.Segment.Start
+			}
+			if t.Segment.Stop > span.stop {
+				span.stop = t.Segment.Stop
+			}
+		}
+		if span.start >= 0 {
+			spans = append(spans, span)
+		}
+		return ast.WalkSkipChildren, nil
+	})
+	return spans
+}
+
+func spanContaining(spans []byteRange, i int) (byteRange, bool) {
+	for _, s := range spans {
+		if i >= s.start && i < s.stop {
+			return s, true
+		}
+	}
+	return byteRange{}, false
+}
+
+// scanSegment walks one line of a block looking for inline links and images
+// whose destination names an attached file.
+func scanSegment(src []byte, start, stop int, codeSpans []byteRange, match func(string) int) []occurrence {
+	var found []occurrence
+
+	for i := start; i+1 < stop; i++ {
+		if span, ok := spanContaining(codeSpans, i); ok {
+			i = span.stop - 1
+			continue
+		}
+		if src[i] != ']' || src[i+1] != '(' || isEscaped(src, i, start) {
+			continue
+		}
+
+		destStart, destEnd, destination, ok := scanInlineDestination(src, i+2, stop)
+		if !ok {
+			continue
+		}
+		spanEnd, ok := scanInlineTail(src, destEnd, stop)
+		if !ok {
+			continue
+		}
+		bracket, ok := findOpeningBracket(src, i, start, codeSpans)
+		if !ok {
+			continue
+		}
+		argIndex := match(destination)
+		if argIndex < 0 {
+			continue
+		}
+
+		isImage := bracket > start && src[bracket-1] == '!' && !isEscaped(src, bracket-1, start)
+		spanStart := bracket
+		if isImage {
+			spanStart = bracket - 1
+		}
+
+		found = append(found, occurrence{
+			argIndex:   argIndex,
+			isImage:    isImage,
+			spanStart:  spanStart,
+			spanEnd:    spanEnd,
+			labelStart: bracket + 1,
+			labelEnd:   i,
+			destStart:  destStart,
+			destEnd:    destEnd,
+		})
+	}
+
+	return found
+}
+
+// findOpeningBracket walks back from the "]" at i to the "[" that opens it,
+// stepping over balanced pairs and over code spans.
+func findOpeningBracket(src []byte, i, start int, codeSpans []byteRange) (int, bool) {
+	depth := 0
+	for k := i; k >= start; k-- {
+		if span, ok := spanContaining(codeSpans, k); ok {
+			k = span.start
+			continue
+		}
+		if isEscaped(src, k, start) {
+			continue
+		}
+		switch src[k] {
+		case ']':
+			depth++
+		case '[':
+			depth--
+			if depth == 0 {
+				return k, true
+			}
+		}
+	}
+	return 0, false
+}
+
+// scanInlineDestination reads the destination of an inline link starting just
+// after the "(".
+func scanInlineDestination(src []byte, i, stop int) (start, end int, destination string, ok bool) {
+	for i < stop && (src[i] == ' ' || src[i] == '\t') {
+		i++
+	}
+	if i >= stop {
+		return 0, 0, "", false
+	}
+
+	if src[i] == '<' {
+		for k := i + 1; k < stop; k++ {
+			if src[k] == '\\' {
+				k++
+				continue
+			}
+			if src[k] == '\n' || src[k] == '\r' {
+				return 0, 0, "", false
+			}
+			if src[k] == '>' {
+				return i, k + 1, unescapeMarkdown(string(src[i+1 : k])), true
+			}
+		}
+		return 0, 0, "", false
+	}
+
+	depth := 0
+	k := i
+	for k < stop {
+		c := src[k]
+		if c == '\\' && k+1 < stop {
+			k += 2
+			continue
+		}
+		if isSpace(c) {
+			break
+		}
+		if c == '(' {
+			depth++
+		} else if c == ')' {
+			if depth == 0 {
+				break
+			}
+			depth--
+		}
+		k++
+	}
+	return i, k, unescapeMarkdown(string(src[i:k])), true
+}
+
+// scanInlineTail reads the optional title and the closing ")" that follow a
+// destination, and returns the offset just past the ")".
+func scanInlineTail(src []byte, i, stop int) (int, bool) {
+	for i < stop && (src[i] == ' ' || src[i] == '\t') {
+		i++
+	}
+	if i >= stop {
+		return 0, false
+	}
+	if src[i] == ')' {
+		return i + 1, true
+	}
+
+	var closer byte
+	switch src[i] {
+	case '"':
+		closer = '"'
+	case '\'':
+		closer = '\''
+	case '(':
+		closer = ')'
+	default:
+		return 0, false
+	}
+
+	i++
+	for i < stop {
+		if src[i] == '\\' {
+			i += 2
+			continue
+		}
+		if src[i] == closer {
+			i++
+			break
+		}
+		i++
+	}
+	if i > stop {
+		return 0, false
+	}
+
+	for i < stop && (src[i] == ' ' || src[i] == '\t') {
+		i++
+	}
+	if i >= stop || src[i] != ')' {
+		return 0, false
+	}
+	return i + 1, true
+}
+
+// scanDefinitionDestination reads the destination out of one line of a link
+// reference definition.
+func scanDefinitionDestination(src []byte, start, stop int) (destStart, destEnd int, destination string, ok bool) {
+	i := start
+	for i < stop && (src[i] == ' ' || src[i] == '\t') {
+		i++
+	}
+	if i >= stop || src[i] != '[' {
+		return 0, 0, "", false
+	}
+
+	// The label can hold an escaped "]", so only an unescaped one ends it.
+	i++
+	for i < stop {
+		if src[i] == '\\' {
+			i += 2
+			continue
+		}
+		if src[i] == ']' {
+			break
+		}
+		i++
+	}
+	if i >= stop || src[i] != ']' {
+		return 0, 0, "", false
+	}
+	i++
+	if i >= stop || src[i] != ':' {
+		return 0, 0, "", false
+	}
+	i++
+
+	for i < stop && (src[i] == ' ' || src[i] == '\t') {
+		i++
+	}
+	if i >= stop {
+		return 0, 0, "", false
+	}
+
+	if src[i] == '<' {
+		for k := i + 1; k < stop; k++ {
+			if src[k] == '\\' {
+				k++
+				continue
+			}
+			if src[k] == '\n' || src[k] == '\r' {
+				return 0, 0, "", false
+			}
+			if src[k] == '>' {
+				return i, k + 1, unescapeMarkdown(string(src[i+1 : k])), true
+			}
+		}
+		return 0, 0, "", false
+	}
+
+	k := i
+	for k < stop && !isSpace(src[k]) {
+		if src[k] == '\\' && k+1 < stop {
+			k += 2
+			continue
+		}
+		k++
+	}
+	if k == i {
+		return 0, 0, "", false
+	}
+	return i, k, unescapeMarkdown(string(src[i:k])), true
+}
+
+func isSpace(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f'
+}
+
+// isEscaped reports whether the byte at i is preceded by an odd number of
+// backslashes, and so is a literal rather than markup.
+func isEscaped(src []byte, i, start int) bool {
+	count := 0
+	for k := i - 1; k >= start && src[k] == '\\'; k-- {
+		count++
+	}
+	return count%2 == 1
+}
+
+// unescapeMarkdown drops the backslashes markdown uses to make punctuation
+// literal, leaving the name the file actually has.
+func unescapeMarkdown(s string) string {
+	if !strings.Contains(s, `\`) {
+		return s
+	}
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\\' && i+1 < len(s) && isASCIIPunctuation(s[i+1]) {
+			b.WriteByte(s[i+1])
+			i++
+			continue
+		}
+		b.WriteByte(s[i])
+	}
+	return b.String()
+}
+
+func isASCIIPunctuation(c byte) bool {
+	return strings.IndexByte("!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~", c) >= 0
+}
+
+// pathsMatch reports whether a markdown destination names the file at the
+// already normalized path.
+func pathsMatch(destination, normalized string) bool {
+	if destination == "" || !looksLikeAPath(destination) {
+		return false
+	}
+	if normalizePath(destination) == normalized {
+		return true
+	}
+	// A space in a name can only be written inline by percent encoding it.
+	if decoded, err := url.PathUnescape(destination); err == nil && decoded != destination {
+		return normalizePath(decoded) == normalized
+	}
+	return false
+}
+
+// looksLikeAPath rejects the destinations that name something other than a
+// local file: an anchor, a protocol relative URL, and anything carrying a
+// scheme. A single letter before the colon is let through, since that is how
+// Windows names a volume.
+func looksLikeAPath(destination string) bool {
+	if strings.HasPrefix(destination, "#") || strings.HasPrefix(destination, "//") {
+		return false
+	}
+	for i := 0; i < len(destination); i++ {
+		c := destination[i]
+		if c == ':' {
+			return i <= 1
+		}
+		isSchemeByte := (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+			(c >= '0' && c <= '9') || c == '+' || c == '-' || c == '.'
+		if !isSchemeByte {
+			return true
+		}
+	}
+	return true
+}
+
+func normalizePath(path string) string {
+	if absolute, err := filepath.Abs(path); err == nil {
+		return absolute
+	}
+	return filepath.Clean(path)
+}
