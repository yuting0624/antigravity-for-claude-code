@@ -0,0 +1,173 @@
+// Package attachments uploads local images and videos to GitHub's user
+// attachments endpoint and writes the resulting asset URLs into the markdown
+// body of an issue, a pull request or a comment.
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+const (
+	// maxImageBytes and maxVideoBytes are the limits the endpoint applies to
+	// the two kinds of asset. The server's own limit for a video also depends
+	// on the account plan, which gh cannot see, so a file under this one can
+	// still be refused on upload.
+	maxImageBytes = 10 * 1024 * 1024
+	maxVideoBytes = 100 * 1024 * 1024
+)
+
+// openFile is a seam so that a test can upload bytes without a file behind
+// them.
+var openFile = func(path string) (io.ReadCloser, error) {
+	return os.Open(path)
+}
+
+// contentTypes maps every extension gh will attach to the content type the
+// endpoint expects for it. The order of supportedExtensions is the order the
+// error message lists them in.
+var (
+	supportedExtensions = []string{"png", "jpg", "jpeg", "gif", "webp", "svg", "mp4", "mov", "webm"}
+
+	contentTypes = map[string]string{
+		".png":  "image/png",
+		".jpg":  "image/jpeg",
+		".jpeg": "image/jpeg",
+		".gif":  "image/gif",
+		".webp": "image/webp",
+		".svg":  "image/svg+xml",
+		".mp4":  "video/mp4",
+		".mov":  "video/quicktime",
+		".webm": "video/webm",
+	}
+)
+
+// UserAsset is a local file that has been accepted for upload.
+type UserAsset interface {
+	// Path is the path the author wrote, which is what every message about
+	// this file names it by.
+	Path() string
+
+	getAsset() *asset
+	// markdown renders the asset at the given URL in the form that makes
+	// GitHub display it.
+	markdown(assetURL string) string
+	// rendersAsPlayer reports whether a bare URL to this asset renders as a
+	// player rather than as a link.
+	rendersAsPlayer() bool
+}
+
+type asset struct {
+	path        string
+	alt         string
+	contentType string
+	info        fs.FileInfo
+}
+
+func (a *asset) Path() string { return a.path }
+
+func (a *asset) getAsset() *asset { return a }
+
+// imageAsset embeds as a markdown image.
+type imageAsset struct{ asset }
+
+func (a *imageAsset) markdown(assetURL string) string {
+	return "![" + escapeAltText(a.alt) + "](" + assetURL + ")"
+}
+
+func (a *imageAsset) rendersAsPlayer() bool { return false }
+
+// videoAsset renders as a bare URL, which is the only form GitHub turns into a
+// player.
+type videoAsset struct{ asset }
+
+func (a *videoAsset) markdown(assetURL string) string {
+	return assetURL
+}
+
+func (a *videoAsset) rendersAsPlayer() bool { return true }
+
+// newAsset validates path and returns the asset it names. Only metadata is
+// read; the bytes are not opened until the upload.
+func newAsset(path, alt string) (UserAsset, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		var pathErr *fs.PathError
+		if errors.As(err, &pathErr) {
+			// The syscall gh happened to make is noise; the path the author
+			// wrote is what they can act on.
+			return nil, fmt.Errorf("%s: %w", path, pathErr.Err)
+		}
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+	if info.IsDir() {
+		return nil, fmt.Errorf("%s is a directory", path)
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%s is not a regular file", path)
+	}
+
+	extension := strings.ToLower(filepath.Ext(path))
+	contentType, supported := contentTypes[extension]
+	if !supported {
+		return nil, fmt.Errorf("%s is not a supported file type (supported: %s)",
+			path, strings.Join(supportedExtensions, ", "))
+	}
+
+	if info.Size() == 0 {
+		return nil, fmt.Errorf("%s is empty", path)
+	}
+
+	base := asset{path: path, contentType: contentType, info: info}
+	name := filepath.Base(path)
+
+	if strings.HasPrefix(contentType, "video/") {
+		if alt != "" {
+			return nil, errors.New("cannot set alt text on video")
+		}
+		if info.Size() > maxVideoBytes {
+			return nil, fmt.Errorf("%s: videos must be at most %s", path, megabytes(maxVideoBytes))
+		}
+		// A video has no alt attribute to fill, so the file name stands in as
+		// the link text when an embed degrades to a link.
+		base.alt = name
+		return &videoAsset{base}, nil
+	}
+
+	if info.Size() > maxImageBytes {
+		return nil, fmt.Errorf("%s: images must be at most %s", path, megabytes(maxImageBytes))
+	}
+	if alt == "" {
+		alt = defaultAltText(name)
+	}
+	base.alt = alt
+	return &imageAsset{base}, nil
+}
+
+// defaultAltText turns a file name into something readable: the extension goes
+// and the dots that separate the rest become spaces.
+func defaultAltText(name string) string {
+	return strings.ReplaceAll(strings.TrimSuffix(name, filepath.Ext(name)), ".", " ")
+}
+
+func megabytes(size int64) string {
+	return fmt.Sprintf("%.1f MB", float64(size)/(1024*1024))
+}
+
+// escapeAltText keeps alt text inside the image it labels: a bracket would
+// close the label early and a line break would end the paragraph.
+func escapeAltText(alt string) string {
+	replacer := strings.NewReplacer(
+		`\`, `\\`,
+		`[`, `\[`,
+		`]`, `\]`,
+		"\r", " ",
+		"\n", " ",
+	)
+	return replacer.Replace(alt)
+}
