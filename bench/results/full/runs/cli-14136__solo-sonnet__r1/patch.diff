+// WorktreeAdd creates a linked worktree at path checked out to the existing
+// local branch via `git worktree add -- <path> <branch>`.
+func (c *Client) WorktreeAdd(ctx context.Context, path, branch string) error {
+	cmd, err := c.Command(ctx, "worktree", "add", "--", path, branch)
+	if err != nil {
+		return err
+	}
+	_, err = cmd.Output()
+	return err
+}
+
+// WorktreeAddNewBranch creates a linked worktree at path with a new branch
+// tracking remoteBranch (e.g. "origin/feature") via
+// `git worktree add --track -b <branch> -- <path> <remoteBranch>`.
+func (c *Client) WorktreeAddNewBranch(ctx context.Context, path, branch, remoteBranch string) error {
+	cmd, err := c.Command(ctx, "worktree", "add", "--track", "-b", branch, "--", path, remoteBranch)
+	if err != nil {
+		return err
+	}
+	_, err = cmd.Output()
+	return err
+}
+
