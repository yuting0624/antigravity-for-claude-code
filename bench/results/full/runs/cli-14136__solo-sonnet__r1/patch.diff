+// checkoutWorktree checks branch out into worktreeTarget: an existing linked
+// worktree is switched and fast-forwarded the same way an in-place checkout
+// is, while a fresh path is created via `git worktree add`, tracking the
+// remote branch when branch does not exist locally yet.
+func checkoutWorktree(opts *DevelopOptions, baseRemote *context.Remote, branch string, target prShared.WorktreeTarget) error {
+	gc := opts.GitClient
+	branchExists := gc.HasLocalBranch(ctx.Background(), branch)
+
+	if target.Reuse {
+		wt := gc.Copy()
+		wt.RepoDir = target.Path
+		if branchExists {
+			if err := wt.CheckoutBranch(ctx.Background(), branch); err != nil {
+				return err
+			}
+			if err := wt.Pull(ctx.Background(), baseRemote.Name, branch); err != nil {
+				warnFastForwardFailure(opts, branch)
+			}
+			return nil
+		}
+		return wt.CheckoutNewBranch(ctx.Background(), baseRemote.Name, branch)
+	}
+
+	if branchExists {
+		if err := gc.WorktreeAdd(ctx.Background(), target.Path, branch); err != nil {
+			return err
+		}
+		wt := gc.Copy()
+		wt.RepoDir = target.Path
+		if err := wt.Pull(ctx.Background(), baseRemote.Name, branch); err != nil {
+			warnFastForwardFailure(opts, branch)
+		}
+		return nil
+	}
+
+	remoteBranch := fmt.Sprintf("%s/%s", baseRemote.Name, branch)
+	return gc.WorktreeAddNewBranch(ctx.Background(), target.Path, branch, remoteBranch)
+}
+
+func warnFastForwardFailure(opts *DevelopOptions, branch string) {
+	_, _ = fmt.Fprintf(opts.IO.ErrOut, "%s warning: not possible to fast-forward to: %q\n", opts.IO.ColorScheme().WarningIcon(), branch)
+}
