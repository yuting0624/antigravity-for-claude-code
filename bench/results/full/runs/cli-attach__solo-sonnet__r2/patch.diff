+// TokenType represents the kind of GitHub API credential in use, as determined by the
+// well-known prefix of the token string. See
+// https://github.blog/engineering/platform-security/behind-githubs-new-authentication-token-formats/
+// for background on these prefixes.
+type TokenType string
+
+const (
+	// TokenTypeOAuth is a classic OAuth access token, prefixed "gho_".
+	TokenTypeOAuth TokenType = "oauth"
+	// TokenTypePersonalAccess is a classic personal access token, prefixed "ghp_".
+	TokenTypePersonalAccess TokenType = "personal_access"
+	// TokenTypeFineGrainedPAT is a fine-grained personal access token, prefixed "github_pat_".
+	TokenTypeFineGrainedPAT TokenType = "fine_grained_pat"
+	// TokenTypeUserToServer is a user-to-server GitHub App installation token, prefixed "ghu_".
+	TokenTypeUserToServer TokenType = "user_to_server"
+	// TokenTypeServerToServer is a server-to-server GitHub App installation token, prefixed "ghs_".
+	TokenTypeServerToServer TokenType = "server_to_server"
+	// TokenTypeRefresh is a GitHub App refresh token, prefixed "ghr_".
+	TokenTypeRefresh TokenType = "refresh"
+	// TokenTypeUnknown is any token whose prefix is not recognized, including no token at all.
+	TokenTypeUnknown TokenType = "unknown"
+)
+
+// ParseTokenType determines the TokenType of a token by inspecting its prefix.
+func ParseTokenType(token string) TokenType {
+	switch {
+	case strings.HasPrefix(token, "gho_"):
+		return TokenTypeOAuth
+	case strings.HasPrefix(token, "ghp_"):
+		return TokenTypePersonalAccess
+	case strings.HasPrefix(token, "github_pat_"):
+		return TokenTypeFineGrainedPAT
+	case strings.HasPrefix(token, "ghu_"):
+		return TokenTypeUserToServer
+	case strings.HasPrefix(token, "ghs_"):
+		return TokenTypeServerToServer
+	case strings.HasPrefix(token, "ghr_"):
+		return TokenTypeRefresh
+	default:
+		return TokenTypeUnknown
+	}
+}
