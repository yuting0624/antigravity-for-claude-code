+			return err
+		}
+	} else if err := gc.WorktreeAdd(ctx.Background(), worktree.Path, branch, ""); err != nil {
+		return err
+	}
+
+	if err := worktreeClient.Pull(ctx.Background(), remoteName, branch); err != nil {
+		_, _ = fmt.Fprintf(opts.IO.ErrOut, "%s warning: not possible to fast-forward to: %q\n", opts.IO.ColorScheme().WarningIcon(), branch)
+	}
+
+	return nil
+}
