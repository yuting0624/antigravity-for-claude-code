+// WorktreeAdd adds a worktree at path with branch checked out. When remote is
+// empty, branch must already exist locally and is checked out in the new
+// worktree via `git worktree add -- <path> <branch>`. Otherwise branch is
+// created in the new worktree as a tracking branch of the remote branch via
+// `git worktree add --track -b <branch> -- <path> <remote>/<branch>`.
+func (c *Client) WorktreeAdd(ctx context.Context, path, branch, remote string) error {
+	args := []string{"worktree", "add", "--", path, branch}
+	if remote != "" {
+		args = []string{"worktree", "add", "--track", "-b", branch, "--", path, fmt.Sprintf("%s/%s", remote, branch)}
+	}
+	cmd, err := c.Command(ctx, args...)
+	if err != nil {
+		return err
+	}
+	_, err = cmd.Output()
+	return err
+}
