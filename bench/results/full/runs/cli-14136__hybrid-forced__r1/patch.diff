+// checkoutBranchInWorktree checks the linked branch out in a Git worktree at the
+// target path instead of the current working copy, which is left on its current
+// branch. A branch that does not exist locally is created in the worktree as a
+// tracking branch of the remote branch; an existing branch is checked out and
+// then fast-forwarded, matching the behaviour of a regular checkout.
+func checkoutBranchInWorktree(opts *DevelopOptions, worktree prShared.WorktreeTarget, remoteName, branch string) error {
+	gc := opts.GitClient
+	// Scoping a copy of the client to the worktree runs its commands with
+	// 'git -C <path>' so they apply there and not in the current working copy.
+	worktreeClient := gc.Copy()
+	worktreeClient.RepoDir = worktree.Path
+
+	if !gc.HasLocalBranch(ctx.Background(), branch) {
+		if worktree.Reuse {
+			return worktreeClient.CheckoutNewBranch(ctx.Background(), remoteName, branch)
+		}
+		return gc.WorktreeAdd(ctx.Background(), worktree.Path, branch, remoteName)
+	}
