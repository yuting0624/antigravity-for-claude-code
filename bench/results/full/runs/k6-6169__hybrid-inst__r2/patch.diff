@@ -0,0 +1,71 @@
+package provisioning
+
+import "encoding/json"
+
+// MetricsConfig is the metrics section of the runtime config.
+type MetricsConfig struct {
+	PushURL               string  `json:"push_url"`
+	PushInterval          *string `json:"push_interval"`
+	PushConcurrency       *int32  `json:"push_concurrency"`
+	AggregationPeriod     *string `json:"aggregation_period"`
+	AggregationWaitPeriod *string `json:"aggregation_wait_period"`
+	AggregationMinSamples *int32  `json:"aggregation_min_samples"`
+	MaxSamplesPerPackage  *int32  `json:"max_samples_per_package"`
+}
+
+// SecretsConfig is the secrets section of the runtime config.
+type SecretsConfig struct {
+	Endpoint     string `json:"endpoint"`
+	ResponsePath string `json:"response_path"`
+}
+
+// RuntimeConfig is the runtime configuration the provisioning API returns for a
+// test run.
+type RuntimeConfig struct {
+	Metrics      MetricsConfig `json:"metrics"`
+	Secrets      SecretsConfig `json:"secrets"`
+	TestRunToken string        `json:"test_run_token"`
+}
+
+// StartLocalExecutionRequest is the body of the start_local_execution call.
+type StartLocalExecutionRequest struct {
+	Options       json.RawMessage
+	MaxVUs        int32
+	TotalDuration int32
+
+	// ArchiveSize is the size in bytes of the archive that will be uploaded.
+	// Zero means no archive is uploaded, and is sent as an explicit JSON null.
+	ArchiveSize int64
+}
+
+// startLocalExecutionWire is the wire representation of
+// [StartLocalExecutionRequest]. It exists so archive_size can be encoded as an
+// explicit null rather than being omitted or sent as a zero.
+type startLocalExecutionWire struct {
+	Options       json.RawMessage `json:"options"`
+	MaxVUs        int32           `json:"max_vus"`
+	TotalDuration int32           `json:"total_duration"`
+	ArchiveSize   *int64          `json:"archive_size"`
+}
+
+// MarshalJSON implements [json.Marshaler].
+func (r StartLocalExecutionRequest) MarshalJSON() ([]byte, error) {
+	wire := startLocalExecutionWire{
+		Options:       r.Options,
+		MaxVUs:        r.MaxVUs,
+		TotalDuration: r.TotalDuration,
+	}
+	if r.ArchiveSize > 0 {
+		size := r.ArchiveSize
+		wire.ArchiveSize = &size
+	}
+	return json.Marshal(wire)
+}
+
+// StartLocalExecutionResponse is the decoded start_local_execution response.
+type StartLocalExecutionResponse struct {
+	TestRunID             int64         `json:"test_run_id"`
+	RuntimeConfig         RuntimeConfig `json:"runtime_config"`
+	ArchiveUploadURL      *string       `json:"archive_upload_url"`
+	TestRunDetailsPageURL string        `json:"test_run_details_page_url"`
+}
