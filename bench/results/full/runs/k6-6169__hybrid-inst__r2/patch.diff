+// buildConfigFromRuntimeConfig translates the metrics tuning the provisioning
+// API returned into a [cloudapi.Config] that can be applied on top of the
+// locally consolidated one. Fields the API left unset are left unset here too,
+// so the local value survives the merge.
+func buildConfigFromRuntimeConfig(logger logrus.FieldLogger, rc provisioning.RuntimeConfig) cloudapi.Config {
+	var conf cloudapi.Config
+
+	metrics := rc.Metrics
+	if d, ok := parseRuntimeDuration(logger, "push_interval", metrics.PushInterval); ok {
+		conf.MetricPushInterval = types.NewNullDuration(d, true)
+	}
+	if d, ok := parseRuntimeDuration(logger, "aggregation_period", metrics.AggregationPeriod); ok {
+		conf.AggregationPeriod = types.NewNullDuration(d, true)
+	}
+	if d, ok := parseRuntimeDuration(logger, "aggregation_wait_period", metrics.AggregationWaitPeriod); ok {
+		conf.AggregationWaitPeriod = types.NewNullDuration(d, true)
+	}
+	if metrics.PushConcurrency != nil {
+		conf.MetricPushConcurrency = null.IntFrom(int64(*metrics.PushConcurrency))
+	}
+	if metrics.MaxSamplesPerPackage != nil {
+		conf.MaxTimeSeriesInBatch = null.IntFrom(int64(*metrics.MaxSamplesPerPackage))
+	}
+
+	// AggregationMinSamples is intentionally dropped: the v2 output has no
+	// equivalent knob. It is not an error, so nothing is logged for it.
+
+	return conf
+}
+
+// parseRuntimeDuration parses one of the runtime config's duration fields,
+// warning and reporting failure instead of aborting when it is unparseable.
+func parseRuntimeDuration(logger logrus.FieldLogger, field string, value *string) (time.Duration, bool) {
+	if value == nil {
+		return 0, false
+	}
+	d, err := types.ParseExtendedDuration(*value)
+	if err != nil {
+		logger.WithError(err).WithFields(logrus.Fields{
+			"field": field,
+			"value": *value,
+		}).Warn("Ignoring an unparseable duration in the cloud runtime configuration")
+		return 0, false
+	}
+	return d, true
+}
