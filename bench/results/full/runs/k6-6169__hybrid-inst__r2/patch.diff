diff --git a/internal/cloudapi/clientcfg/clientcfg.go b/internal/cloudapi/clientcfg/clientcfg.go
new file mode 100644
index 000000000..6858af435
--- /dev/null
+++ b/internal/cloudapi/clientcfg/clientcfg.go
@@ -0,0 +1,12 @@
+// Package clientcfg holds HTTP retry settings shared by the k6 Cloud API
+// clients (internal/cloudapi/v6, internal/cloudapi/provisioning).
+package clientcfg
+
+import "time"
+
+const (
+	// RetryInterval is the default cloud request retry interval.
+	RetryInterval = 500 * time.Millisecond
+	// MaxRetries specifies the max number of attempts for a cloud request.
+	MaxRetries = 3
+)
diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..9ef056dc2
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,156 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strconv"
+	"time"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// notifyEventScriptExecutionCompleted is the only event k6 reports to the
+// provisioning API: the local script execution has finished.
+const notifyEventScriptExecutionCompleted = "script_execution_completed"
+
+// notifyRequest is the body of the notify call. The error field is always
+// present, and null when the test run completed cleanly.
+type notifyRequest struct {
+	EventType string       `json:"event_type"`
+	Error     *notifyError `json:"error"`
+}
+
+// StartLocalExecution starts a local-execution test run for the given load test.
+func (c *Client) StartLocalExecution(
+	ctx context.Context, loadTestID int64, req StartLocalExecutionRequest,
+) (*StartLocalExecutionResponse, error) {
+	body, err := json.Marshal(req)
+	if err != nil {
+		return nil, fmt.Errorf("encoding start local execution request: %w", err)
+	}
+
+	url := fmt.Sprintf("%s/provisioning/v1/load_tests/%d/start_local_execution", c.host, loadTestID)
+	hr, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(body))
+	if err != nil {
+		return nil, err
+	}
+
+	key, err := idempotencyKey()
+	if err != nil {
+		return nil, err
+	}
+
+	hr.Header.Set("Content-Type", "application/json")
+	hr.Header.Set("X-Stack-Id", strconv.FormatInt(c.stackID, 10))
+	hr.Header.Set("K6-Idempotency-Key", key)
+
+	res := &StartLocalExecutionResponse{}
+	if err := c.httpClient.Do(hr, res); err != nil {
+		return nil, err
+	}
+
+	return res, nil
+}
+
+// UploadArchive uploads the test archive to a presigned URL. Presigned URLs
+// carry their own credentials, so the request must not be authenticated.
+func (c *Client) UploadArchive(ctx context.Context, uploadURL string, body []byte) error {
+	hr, err := http.NewRequestWithContext(ctx, http.MethodPut, uploadURL, bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	hr.Header.Set("Content-Type", "application/x-tar")
+	hr.ContentLength = int64(len(body))
+
+	return NewHTTPClient(c.httpDoer(), "", c.version, c.logger).Do(hr, nil)
+}
+
+// WaitForTestRunReady polls the test run until it reports initializing.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	var lastStatus v6.Status
+
+	for {
+		tp, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			return err
+		}
+
+		switch tp.Status {
+		case v6.StatusInitializing, v6.StatusRunning:
+			return nil
+		case v6.StatusAborted:
+			return abortedBeforeStartError(tp)
+		case v6.StatusCompleted:
+			return fmt.Errorf("test run %d has already completed", testRunID)
+		}
+
+		// Only the transitions are worth reporting: polling is frequent and
+		// the status rarely changes between two polls.
+		if tp.Status != lastStatus {
+			lastStatus = tp.Status
+			if c.logger != nil {
+				c.logger.WithField("status", tp.FormatStatus()).Info("Waiting for the cloud test run to be ready")
+			}
+		}
+
+		timer := time.NewTimer(pollInterval)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return fmt.Errorf("waiting for test run %d to be ready: %w", testRunID, ctx.Err())
+		case <-timer.C:
+		}
+	}
+}
+
+// abortedBeforeStartError builds the error for a test run the backend aborted
+// before it ever reached the initializing state, preferring the backend's own
+// explanation when there is one.
+func abortedBeforeStartError(tp *v6.TestProgress) error {
+	for _, e := range tp.StatusHistory {
+		if e.Status == v6.StatusAborted && e.Message != "" {
+			return fmt.Errorf("test run aborted before starting: %s", e.Message)
+		}
+	}
+	return errors.New("test run aborted before starting")
+}
+
+// NotifyTestRunCompleted reports the end of local script execution to the
+// provisioning API. It authenticates with the test-run-scoped token rather than
+// the long-lived one.
+func (c *Client) NotifyTestRunCompleted(
+	ctx context.Context, testRunID int64, testRunToken string, testErr error,
+) error {
+	body, err := json.Marshal(notifyRequest{
+		EventType: notifyEventScriptExecutionCompleted,
+		Error:     mapTestErrorToNotifyCode(testErr),
+	})
+	if err != nil {
+		return fmt.Errorf("encoding notify request: %w", err)
+	}
+
+	url := fmt.Sprintf("%s/provisioning/v1/test_runs/%d/notify", c.host, testRunID)
+	hr, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	hr.Header.Set("Content-Type", "application/json")
+
+	return NewHTTPClient(c.httpDoer(), testRunToken, c.version, c.logger).Do(hr, nil)
+}
+
+// idempotencyKey returns a random key so a retried start request is not
+// executed twice by the backend.
+func idempotencyKey() (string, error) {
+	var key [8]byte
+	if _, err := rand.Read(key[:]); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(key[:]), nil
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..c81415cd4
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,78 @@
+package provisioning
+
+import (
+	"fmt"
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client handles communication with the k6 Cloud provisioning API. The v6 API
+// endpoints the provisioning flow relies on are reached through an embedded
+// [v6.Client].
+type Client struct {
+	apiClient  *k6cloud.APIClient
+	v6Client   *v6.Client
+	httpClient *HTTPClient
+
+	token   string
+	stackID int64
+	host    string
+	version string
+
+	logger logrus.FieldLogger
+}
+
+// NewClient returns a new client for the k6 Cloud provisioning API.
+func NewClient(
+	logger logrus.FieldLogger, token, host, version string, stackID int64, timeout time.Duration,
+) (*Client, error) {
+	if token == "" {
+		return nil, fmt.Errorf("token is required to create the cloud provisioning API client")
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Global k6 Cloud API.",
+		},
+	}
+	cfg.HTTPClient = &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+
+	v6Client, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if err := v6Client.SetStackID(stackID); err != nil {
+		return nil, err
+	}
+
+	return &Client{
+		apiClient:  k6cloud.NewAPIClient(cfg),
+		v6Client:   v6Client,
+		httpClient: NewHTTPClient(cfg.HTTPClient, token, version, logger),
+		token:      token,
+		stackID:    stackID,
+		host:       host,
+		version:    version,
+		logger:     logger,
+	}, nil
+}
+
+// httpDoer returns the HTTP client shared by every provisioning request, so
+// timeouts and the transport are configured in a single place.
+func (c *Client) httpDoer() *http.Client {
+	return c.apiClient.GetConfig().HTTPClient
+}
