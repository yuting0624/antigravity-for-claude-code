diff --git a/internal/cloudapi/provisioning/errors.go b/internal/cloudapi/provisioning/errors.go
new file mode 100644
index 000000000..d5744724b
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,57 @@
+package provisioning
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+// errUnknown is returned when the provisioning API cannot be reached at all.
+var errUnknown = errors.New("an error occurred communicating with k6 Cloud")
+
+// ResponseError is an unexpected HTTP response from the provisioning API.
+type ResponseError struct {
+	// StatusCode is the HTTP status code of the response.
+	StatusCode int
+	// Body is the raw, undecoded response body.
+	Body string
+
+	// err is the classified 401/403 error, if any, so callers can match the
+	// response with errors.Is against the httperr sentinels.
+	err error
+}
+
+func (e *ResponseError) Error() string {
+	return fmt.Sprintf("unexpected response from the k6 Cloud provisioning API: %d %s", e.StatusCode, e.Body)
+}
+
+// Unwrap returns the classified error for the response's status code, if any.
+func (e *ResponseError) Unwrap() error {
+	return e.err
+}
+
+// CheckResponse returns nil if the response's status code is in the successful
+// range, and a [ResponseError] carrying the status code and the raw body
+// otherwise.
+func CheckResponse(r *http.Response) error {
+	if r == nil {
+		return errUnknown
+	}
+
+	if c := r.StatusCode; c >= 200 && c <= 299 {
+		return nil
+	}
+
+	// A malformed or unreadable body must not mask the status code, so
+	// whatever was read is reported as-is.
+	body, _ := io.ReadAll(r.Body)
+
+	return &ResponseError{
+		StatusCode: r.StatusCode,
+		Body:       string(body),
+		err:        httperr.ClassifyStatus(r.StatusCode),
+	}
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..f78e9b4a1
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,142 @@
+package provisioning
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient is a small retrying JSON-over-HTTP client for the provisioning endpoints.
+type HTTPClient struct {
+	client  *http.Client
+	token   string
+	version string
+	logger  logrus.FieldLogger
+}
+
+// NewHTTPClient returns a new HTTPClient.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	if client == nil {
+		client = http.DefaultClient
+	}
+	return &HTTPClient{
+		client:  client,
+		token:   token,
+		version: version,
+		logger:  logger,
+	}
+}
+
+// Do executes an HTTP request with retries and decodes the response body into v if non-nil.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	if req.Header == nil {
+		req.Header = make(http.Header)
+	}
+	req.Header.Set("User-Agent", "k6cloud/"+c.version)
+	if c.token != "" {
+		req.Header.Set("Authorization", "Bearer "+c.token)
+	}
+
+	if req.Body != nil && req.GetBody == nil {
+		bodyBytes, err := io.ReadAll(req.Body)
+		if err != nil {
+			_ = req.Body.Close()
+			return fmt.Errorf("read request body: %w", err)
+		}
+		_ = req.Body.Close()
+		req.GetBody = func() (io.ReadCloser, error) {
+			return io.NopCloser(bytes.NewReader(bodyBytes)), nil
+		}
+		req.Body, _ = req.GetBody()
+	}
+
+	httpClient := c.client
+	if httpClient == nil {
+		httpClient = http.DefaultClient
+	}
+
+	maxAttempts := clientcfg.MaxRetries
+	if maxAttempts <= 0 {
+		maxAttempts = 1
+	}
+
+	for attempt := 0; attempt < maxAttempts; attempt++ {
+		if attempt > 0 && req.GetBody != nil {
+			var err error
+			req.Body, err = req.GetBody()
+			if err != nil {
+				return fmt.Errorf("reset request body: %w", err)
+			}
+		}
+
+		resp, err := httpClient.Do(req)
+		if err != nil {
+			if req.Context().Err() != nil {
+				return fmt.Errorf("request cancelled: %w", req.Context().Err())
+			}
+			if attempt < maxAttempts-1 {
+				if c.logger != nil {
+					c.logger.Debugf("retrying provisioning request (attempt %d/%d) after error: %v", attempt+1, maxAttempts, err)
+				}
+				timer := time.NewTimer(clientcfg.RetryInterval)
+				select {
+				case <-req.Context().Done():
+					timer.Stop()
+					return fmt.Errorf("request cancelled: %w", req.Context().Err())
+				case <-timer.C:
+				}
+				continue
+			}
+			return err
+		}
+
+		// 2xx success
+		if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+			if v == nil {
+				_, _ = io.Copy(io.Discard, resp.Body)
+				_ = resp.Body.Close()
+				return nil
+			}
+			decodeErr := json.NewDecoder(resp.Body).Decode(v)
+			_, _ = io.Copy(io.Discard, resp.Body)
+			_ = resp.Body.Close()
+			if decodeErr != nil {
+				return fmt.Errorf("decode response: %w", decodeErr)
+			}
+			return nil
+		}
+
+		// 5xx server error: retry if attempts remaining.
+		if resp.StatusCode >= 500 && attempt < maxAttempts-1 {
+			_, _ = io.Copy(io.Discard, resp.Body)
+			_ = resp.Body.Close()
+
+			if c.logger != nil {
+				c.logger.Debugf("retrying provisioning request (attempt %d/%d) after status %d", attempt+1, maxAttempts, resp.StatusCode)
+			}
+			timer := time.NewTimer(clientcfg.RetryInterval)
+			select {
+			case <-req.Context().Done():
+				timer.Stop()
+				return fmt.Errorf("request cancelled: %w", req.Context().Err())
+			case <-timer.C:
+			}
+			continue
+		}
+
+		// Non-2xx final response (immediately for 4xx, or after last attempt for 5xx).
+		respErr := CheckResponse(resp)
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+		return respErr
+	}
+
+	return nil
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..98bf6cd44
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,55 @@
+package provisioning
+
+import (
+	"errors"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+// Error codes the provisioning API understands for a script_execution_completed
+// event.
+const (
+	// notifyCodeAborted reports a run stopped by the user or by the script.
+	notifyCodeAborted int32 = 8036
+	// notifyCodeScriptError reports a run stopped by a script error.
+	notifyCodeScriptError int32 = 8035
+	// notifyCodeSystem reports a run stopped by a timeout or an output failure.
+	notifyCodeSystem int32 = 8034
+)
+
+// notifyError is the error object in the notify request body.
+type notifyError struct {
+	Code   int32  `json:"code"`
+	Reason string `json:"reason"`
+}
+
+// mapTestErrorToNotifyCode translates the error k6 stopped with into the error
+// object reported to the provisioning API. It returns nil when the test run
+// itself completed normally, which includes the case of thresholds that only
+// failed after the test ended.
+func mapTestErrorToNotifyCode(err error) *notifyError {
+	if err == nil {
+		return nil
+	}
+
+	code := int32(0)
+
+	var abortErr errext.HasAbortReason
+	if errors.As(err, &abortErr) {
+		switch abortErr.AbortReason() {
+		case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+			code = notifyCodeAborted
+		case errext.AbortedByScriptError:
+			code = notifyCodeScriptError
+		case errext.AbortedByTimeout, errext.AbortedByOutput:
+			code = notifyCodeSystem
+		case errext.AbortedByThresholdsAfterTestEnd:
+			// The test run finished normally: the thresholds only failed once
+			// it had ended, so as far as the backend is concerned there is
+			// nothing to report.
+			return nil
+		}
+	}
+
+	return &notifyError{Code: code, Reason: err.Error()}
+}
diff --git a/internal/cloudapi/provisioning/provision.go b/internal/cloudapi/provisioning/provision.go
new file mode 100644
index 000000000..b71f6acda
--- /dev/null
+++ b/internal/cloudapi/provisioning/provision.go
@@ -0,0 +1,84 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"go.k6.io/k6/v2/lib"
+)
+
+// ProvisionParams are the inputs of ProvisionLocalExecution.
+type ProvisionParams struct {
+	Name          string
+	ProjectID     int64
+	MaxVUs        int32
+	TotalDuration int32
+	Options       json.RawMessage
+	Archive       *lib.Archive // go.k6.io/k6/v2/lib; nil means do not upload
+	PollInterval  time.Duration
+}
+
+// ProvisionResult is what the caller needs to run the test locally.
+type ProvisionResult struct {
+	TestRunID             int64
+	TestRunDetailsPageURL string
+	RuntimeConfig         RuntimeConfig
+}
+
+// ProvisionLocalExecution creates or finds the load test, starts a local execution
+// test run, optionally uploads the archive and waits until the run is ready.
+func (c *Client) ProvisionLocalExecution(ctx context.Context, params ProvisionParams) (*ProvisionResult, error) {
+	pollInterval := params.PollInterval
+	if pollInterval <= 0 {
+		pollInterval = time.Second
+	}
+
+	loadTestID, err := c.v6Client.CreateOrFindLoadTest(ctx, params.ProjectID, params.Name)
+	if err != nil {
+		return nil, fmt.Errorf("create or find load test: %w", err)
+	}
+
+	var archiveBytes []byte
+	var archiveSize int64
+	if params.Archive != nil {
+		var buf bytes.Buffer
+		if err := params.Archive.Write(&buf); err != nil {
+			return nil, fmt.Errorf("serialize test archive: %w", err)
+		}
+		archiveBytes = buf.Bytes()
+		archiveSize = int64(len(archiveBytes))
+	}
+
+	resp, err := c.StartLocalExecution(ctx, loadTestID, StartLocalExecutionRequest{
+		Options:       params.Options,
+		MaxVUs:        params.MaxVUs,
+		TotalDuration: params.TotalDuration,
+		ArchiveSize:   archiveSize,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("start local execution: %w", err)
+	}
+
+	if params.Archive != nil {
+		if resp.ArchiveUploadURL != nil && *resp.ArchiveUploadURL != "" {
+			if err := c.UploadArchive(ctx, *resp.ArchiveUploadURL, archiveBytes); err != nil {
+				return nil, fmt.Errorf("upload archive: %w", err)
+			}
+		} else if c.logger != nil {
+			c.logger.Warn("archive provided but no upload URL returned; skipping archive upload")
+		}
+	}
+
+	if err := c.WaitForTestRunReady(ctx, resp.TestRunID, pollInterval); err != nil {
+		return nil, fmt.Errorf("wait for test run ready: %w", err)
+	}
+
+	return &ProvisionResult{
+		TestRunID:             resp.TestRunID,
+		TestRunDetailsPageURL: resp.TestRunDetailsPageURL,
+		RuntimeConfig:         resp.RuntimeConfig,
+	}, nil
+}
diff --git a/internal/cloudapi/provisioning/test/server.go b/internal/cloudapi/provisioning/test/server.go
new file mode 100644
index 000000000..08a19e259
--- /dev/null
+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,144 @@
+// Package provtest provides an HTTP test server that simulates the k6 Cloud
+// provisioning API plus the v6 endpoints the provisioning flow uses.
+//
+// It keeps provisioning-specific encoding (nullable fields, SDK models, wire format)
+// out of the test files. Tests speak in domain terms; this server translates to the
+// wire format.
+package provtest
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	// DefaultLoadTestID is the load test id used by the default handlers.
+	DefaultLoadTestID int64 = 456
+	// DefaultTestRunID is the test run id used by the default handlers.
+	DefaultTestRunID int64 = 123
+	// PresignedUploadPath is the path the fake presigned archive upload is served on.
+	PresignedUploadPath = "/presigned/archive"
+)
+
+// Server is a test HTTP server for the k6 Cloud provisioning API and v6 endpoints.
+type Server struct {
+	*httptest.Server
+	Mux *http.ServeMux
+
+	fetchTestRunHits atomic.Int32
+}
+
+// NewServer creates a test server wrapping an httptest.Server.
+// It registers no routes by default.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+
+	mux := http.NewServeMux()
+	srv := httptest.NewServer(mux)
+	t.Cleanup(srv.Close)
+
+	return &Server{
+		Server: srv,
+		Mux:    mux,
+	}
+}
+
+// PresignedUploadURL returns the full URL to the fake presigned archive upload route.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// HandleCreateLoadTest registers h on the bare path /cloud/v6/projects/{projectID}/load_tests.
+func (s *Server) HandleCreateLoadTest(projectID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID), h)
+}
+
+// HandleStartLocalExecution registers h on the bare path /provisioning/v1/load_tests/{loadTestID}/start_local_execution.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/load_tests/%d/start_local_execution", loadTestID), h)
+}
+
+// HandleNotify registers h on the bare path /provisioning/v1/test_runs/{testRunID}/notify.
+func (s *Server) HandleNotify(testRunID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/test_runs/%d/notify", testRunID), h)
+}
+
+// HandlePresignedUpload registers h on the given bare path.
+func (s *Server) HandlePresignedUpload(path string, h http.HandlerFunc) {
+	s.Mux.HandleFunc(path, h)
+}
+
+// HandleFetchTestRun registers a handler on /cloud/v6/test_runs/{testRunID} that serves the v6 test-run model.
+func (s *Server) HandleFetchTestRun(testRunID int64, progress []v6.TestProgress) {
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/test_runs/%d", testRunID), func(w http.ResponseWriter, _ *http.Request) {
+		reqNum := s.fetchTestRunHits.Add(1)
+
+		var tp v6.TestProgress
+		if len(progress) > 0 {
+			idx := min(int(reqNum)-1, len(progress)-1)
+			tp = progress[idx]
+		}
+
+		res := k6cloud.NewTestRunApiModelWithDefaults()
+		res.SetStatus(tp.Status.String())
+		res.SetResult(tp.Result.String())
+		res.SetEstimatedDuration(tp.EstimatedDuration)
+		res.SetExecutionDuration(tp.ExecutionDuration)
+		res.SetStatusHistory(v6.ToStatusModel(tp.StatusHistory))
+		// SDK decoder requires these keys on the other end even when empty.
+		res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+		res.SetResultDetails(k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(k6cloud.NewResultDetailsApiModel("")))
+		res.SetOptions(map[string]any{})
+		writeJSON(w, http.StatusOK, res)
+	})
+}
+
+// FetchTestRunHitCount returns the number of requests handled by HandleFetchTestRun.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchTestRunHits.Load()
+}
+
+// DefaultStartLocalExecutionResponse returns a fresh default StartLocalExecutionTestResponse.
+func DefaultStartLocalExecutionResponse() *k6cloud.StartLocalExecutionTestResponse {
+	metrics := k6cloud.NewMetricsRuntimeConfigWithDefaults()
+	metrics.SetPushUrl("https://ingest.k6.io/v1/metrics")
+	metrics.SetPushInterval("2s")
+	metrics.SetPushConcurrency(5)
+	metrics.SetAggregationPeriod("3s")
+	metrics.SetAggregationWaitPeriod("1s")
+	metrics.SetAggregationMinSamples(50)
+	metrics.SetMaxSamplesPerPackage(2000)
+
+	secrets := k6cloud.NewSecretsRuntimeConfigWithDefaults()
+	secrets.SetEndpoint("https://api.k6.io/provisioning/v1/test_runs/123/decrypt_secret?name={key}")
+	secrets.SetResponsePath("plaintext")
+
+	runtimeConfig := k6cloud.NewRuntimeConfigWithDefaults()
+	runtimeConfig.SetTestRunToken("test-run-token-abc")
+	runtimeConfig.SetMetrics(*metrics)
+	runtimeConfig.SetSecrets(*secrets)
+
+	res := k6cloud.NewStartLocalExecutionTestResponseWithDefaults()
+	res.SetTestRunId(DefaultTestRunID)
+	res.SetArchiveUploadUrl("https://k6-test-archives.s3.amazonaws.com/uploads/123?X-Amz-Signature=deadbeef")
+	res.SetTestRunDetailsPageUrl("https://app.k6.io/runs/123")
+	res.SetRuntimeConfig(*runtimeConfig)
+
+	return res
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	if err := json.NewEncoder(w).Encode(v); err != nil {
+		panic(fmt.Errorf("provtest: encoding JSON: %w", err))
+	}
+}
