+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package timeouts
+
+import (
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func init() {
+	caddy.RegisterModule(Timeouts{})
+}
+
+// Timeouts is a middleware which applies idle-reset read/write
+// deadlines to just its route, guarding against a slow client that
+// trickles bytes just fast enough to defeat a hard deadline
+// (slowloris and friends) without punishing a legitimately slow but
+// steadily-progressing transfer.
+type Timeouts struct {
+	// ReadTimeout is the idle timeout for reading the request body:
+	// the deadline is reset on every successful read, rather than
+	// bounding the whole read with a single hard deadline. Zero
+	// disables the idle read timeout.
+	ReadTimeout time.Duration `json:"read_timeout,omitempty"`
+
+	// ReadMinRate is the minimum acceptable rate, in bytes per
+	// second, for reading the request body. If the transfer never
+	// sustains this rate, it is cut even if it never stalls long
+	// enough to trip ReadTimeout alone. Zero disables this check.
+	ReadMinRate int64 `json:"read_min_rate,omitempty"`
+
+	// WriteTimeout is the idle timeout for writing the response: the
+	// deadline is reset on every successful write, rather than
+	// bounding the whole response with a single hard deadline. Zero
+	// disables the idle write timeout.
+	WriteTimeout time.Duration `json:"write_timeout,omitempty"`
+
+	// WriteMinRate is the minimum acceptable rate, in bytes per
+	// second, for writing the response. If the transfer never
+	// sustains this rate, it is cut even if it never stalls long
+	// enough to trip WriteTimeout alone. Zero disables this check.
+	WriteMinRate int64 `json:"write_min_rate,omitempty"`
+
+	// MaxWriteChunk overrides caddyhttp.DefaultMaxWriteChunk: the
+	// maximum number of bytes covered by a single underlying write,
+	// so that a large write (or a ReadFrom fast path) is split into
+	// chunks with the deadline reset between them.
+	MaxWriteChunk int `json:"max_write_chunk,omitempty"`
+
+	logger *zap.Logger
+}
+
+// CaddyModule returns the Caddy module information.
+func (Timeouts) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{
+		ID:  "http.handlers.timeouts",
+		New: func() caddy.Module { return new(Timeouts) },
+	}
+}
+
+// Provision sets up t.
+func (t *Timeouts) Provision(ctx caddy.Context) error {
+	t.logger = ctx.Logger()
+	return nil
+}
+
+// ServeHTTP implements caddyhttp.MiddlewareHandler.
+func (t *Timeouts) ServeHTTP(w http.ResponseWriter, r *http.Request, next caddyhttp.Handler) error {
+	if r.Body != nil && (t.ReadTimeout > 0 || t.ReadMinRate > 0) {
+		r.Body = &caddyhttp.IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       http.NewResponseController(w), //nolint:bodyclose
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   time.Now(),
+				Timeout: t.ReadTimeout,
+				MinRate: t.ReadMinRate,
+			},
+			Logger: t.logger,
+		}
+	}
+
+	if t.WriteTimeout > 0 || t.WriteMinRate > 0 || t.MaxWriteChunk > 0 {
+		w = &caddyhttp.IdleTimeoutWriter{
+			ResponseWriterWrapper: &caddyhttp.ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  http.NewResponseController(w), //nolint:bodyclose
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   time.Now(),
+				Timeout: t.WriteTimeout,
+				MinRate: t.WriteMinRate,
+			},
+			MaxChunk: t.MaxWriteChunk,
+			Logger:   t.logger,
+		}
+	}
+
+	return next.ServeHTTP(w, r)
+}
+
+// Interface guards
+var (
+	_ caddy.Provisioner           = (*Timeouts)(nil)
+	_ caddyhttp.MiddlewareHandler = (*Timeouts)(nil)
+)
