+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package timeouts
+
+import (
+	"time"
+
+	"github.com/dustin/go-humanize"
+
+	"github.com/caddyserver/caddy/v2/caddyconfig/httpcaddyfile"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func init() {
+	httpcaddyfile.RegisterHandlerDirective("timeouts", parseCaddyfile)
+}
+
+// parseCaddyfile sets up the timeouts handler from Caddyfile tokens. Syntax:
+//
+//	timeouts {
+//	    read_timeout  <duration> [<min_rate>]
+//	    write_timeout <duration> [<min_rate>]
+//	    write_max_chunk <size>
+//	}
+//
+// The optional <min_rate> is a minimum acceptable transfer rate, in
+// bytes per second (e.g. "1KB" means 1000 bytes/second).
+func parseCaddyfile(h httpcaddyfile.Helper) (caddyhttp.MiddlewareHandler, error) {
+	h.Next() // consume directive name
+
+	t := new(Timeouts)
+
+	for h.NextBlock(0) {
+		switch h.Val() {
+		case "read_timeout":
+			args := h.RemainingArgs()
+			if len(args) < 1 || len(args) > 2 {
+				return nil, h.ArgErr()
+			}
+			dur, err := time.ParseDuration(args[0])
+			if err != nil {
+				return nil, h.Errf("parsing read_timeout: %v", err)
+			}
+			t.ReadTimeout = dur
+			if len(args) == 2 {
+				rate, err := humanize.ParseBytes(args[1])
+				if err != nil {
+					return nil, h.Errf("parsing read_timeout min rate: %v", err)
+				}
+				t.ReadMinRate = int64(rate)
+			}
+
+		case "write_timeout":
+			args := h.RemainingArgs()
+			if len(args) < 1 || len(args) > 2 {
+				return nil, h.ArgErr()
+			}
+			dur, err := time.ParseDuration(args[0])
+			if err != nil {
+				return nil, h.Errf("parsing write_timeout: %v", err)
+			}
+			t.WriteTimeout = dur
+			if len(args) == 2 {
+				rate, err := humanize.ParseBytes(args[1])
+				if err != nil {
+					return nil, h.Errf("parsing write_timeout min rate: %v", err)
+				}
+				t.WriteMinRate = int64(rate)
+			}
+
+		case "write_max_chunk":
+			var sizeStr string
+			if !h.AllArgs(&sizeStr) {
+				return nil, h.ArgErr()
+			}
+			size, err := humanize.ParseBytes(sizeStr)
+			if err != nil {
+				return nil, h.Errf("parsing write_max_chunk: %v", err)
+			}
+			t.MaxWriteChunk = int(size)
+
+		default:
+			return nil, h.Errf("unrecognized timeouts subdirective '%s'", h.Val())
+		}
+	}
+
+	return t, nil
+}
