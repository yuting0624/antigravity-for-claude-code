+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package caddyhttp
+
+import (
+	"io"
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+)
+
+// DefaultMaxWriteChunk is the default maximum number of bytes covered
+// by a single underlying write (or ReadFrom call) made by an
+// IdleTimeoutWriter. Bounding the size of each underlying write lets
+// a write deadline be reset between chunks, so a single large write
+// (or a ReadFrom fast path copying a large file) cannot run for
+// longer than one deadline window even though the deadline governs
+// the whole call, not just a stall within it.
+const DefaultMaxWriteChunk = 64 * 1024
+
+// IdleDeadline computes the next absolute deadline to apply to a
+// stream of reads or writes, given how the stream is configured.
+// A zero IdleDeadline (other than a positive Timeout) yields no
+// deadline growth beyond the idle reset, matching prior behavior
+// when only a hard timeout was used.
+type IdleDeadline struct {
+	// Start is the time the transfer began. It anchors the minimum
+	// rate calculation; it is unused if MinRate is 0.
+	Start time.Time
+
+	// Timeout is the idle timeout: the deadline is reset to
+	// now+Timeout after every successful read/write. Zero disables
+	// the idle-reset component.
+	Timeout time.Duration
+
+	// HardDeadline, if non-zero, is an absolute ceiling that the
+	// idle-reset deadline is never allowed to exceed.
+	HardDeadline time.Time
+
+	// MinRate, if greater than 0, is the minimum acceptable transfer
+	// rate in bytes per second. It grows the allowed deadline from
+	// Start according to bytes transferred so far, so a transfer that
+	// never sustains this rate is eventually cut even if it never
+	// stalls long enough to trip the idle timeout alone.
+	MinRate int64
+
+	transferred int64
+}
+
+// next records n additional bytes transferred and returns the new
+// deadline that should be applied, given the current time now. A
+// zero return value means no deadline should be set (unbounded).
+func (d *IdleDeadline) next(now time.Time, n int) time.Time {
+	d.transferred += int64(n)
+
+	var deadline time.Time
+	consider := func(t time.Time) {
+		if t.IsZero() {
+			return
+		}
+		if deadline.IsZero() || t.Before(deadline) {
+			deadline = t
+		}
+	}
+
+	if d.Timeout > 0 {
+		consider(now.Add(d.Timeout))
+	}
+	consider(d.HardDeadline)
+	if d.MinRate > 0 {
+		secs := float64(d.transferred) / float64(d.MinRate)
+		consider(d.Start.Add(d.Timeout).Add(time.Duration(secs * float64(time.Second))))
+	}
+
+	return deadline
+}
+
+// IdleTimeoutReader wraps a request body so that the read deadline is
+// reset on every successful read, instead of bounding the whole
+// transfer with a single hard deadline. This lets a slow-but-steady
+// client survive an otherwise-too-short deadline, while a stalled
+// connection is still cut loose.
+type IdleTimeoutReader struct {
+	io.ReadCloser
+	Ctrl     *http.ResponseController
+	Deadline IdleDeadline
+	Logger   *zap.Logger
+
+	initialized bool
+}
+
+func (r *IdleTimeoutReader) setDeadline(n int) {
+	deadline := r.Deadline.next(time.Now(), n)
+	if err := r.Ctrl.SetReadDeadline(deadline); err != nil {
+		if c := r.Logger.Check(zapcore.WarnLevel, "failed to set idle read deadline"); c != nil {
+			c.Write(zap.Error(err))
+		}
+	}
+}
+
+// Read implements io.Reader.
+func (r *IdleTimeoutReader) Read(p []byte) (int, error) {
+	if !r.initialized {
+		r.initialized = true
+		r.setDeadline(0)
+	}
+	n, err := r.ReadCloser.Read(p)
+	if n > 0 {
+		r.setDeadline(n)
+	}
+	return n, err
+}
+
+// IdleTimeoutWriter wraps a response writer so that the write deadline
+// is reset on every successful write, instead of bounding the whole
+// response with a single hard deadline. Large writes (and the
+// io.ReaderFrom fast path) are split into chunks no larger than
+// MaxChunk so that the deadline is reset between chunks rather than
+// covering one huge underlying write or copy.
+type IdleTimeoutWriter struct {
+	*ResponseWriterWrapper
+	Ctrl     *http.ResponseController
+	Deadline IdleDeadline
+	// MaxChunk overrides DefaultMaxWriteChunk when greater than 0.
+	MaxChunk int
+	Logger   *zap.Logger
+
+	initialized bool
+}
+
+func (w *IdleTimeoutWriter) maxChunk() int {
+	if w.MaxChunk > 0 {
+		return w.MaxChunk
+	}
+	return DefaultMaxWriteChunk
+}
+
+func (w *IdleTimeoutWriter) setDeadline(n int) {
+	deadline := w.Deadline.next(time.Now(), n)
+	if err := w.Ctrl.SetWriteDeadline(deadline); err != nil {
+		if c := w.Logger.Check(zapcore.WarnLevel, "failed to set idle write deadline"); c != nil {
+			c.Write(zap.Error(err))
+		}
+	}
+}
+
+// Write implements io.Writer, splitting p into chunks of at most
+// maxChunk() bytes so the deadline can be reset between chunks.
+func (w *IdleTimeoutWriter) Write(p []byte) (int, error) {
+	if !w.initialized {
+		w.initialized = true
+		w.setDeadline(0)
+	}
+	chunk := w.maxChunk()
+	var written int
+	for len(p) > 0 {
+		sz := len(p)
+		if sz > chunk {
+			sz = chunk
+		}
+		n, err := w.ResponseWriterWrapper.Write(p[:sz])
+		written += n
+		if n > 0 {
+			w.setDeadline(n)
+		}
+		if err != nil {
+			return written, err
+		}
+		p = p[sz:]
+	}
+	return written, nil
+}
+
+// ReadFrom implements io.ReaderFrom, reading from r in chunks of at
+// most maxChunk() bytes so the deadline can be reset between chunks,
+// rather than letting a single ReadFrom fast-path call (e.g. sendfile)
+// run for the entire transfer under one deadline.
+func (w *IdleTimeoutWriter) ReadFrom(r io.Reader) (int64, error) {
+	if !w.initialized {
+		w.initialized = true
+		w.setDeadline(0)
+	}
+	chunk := int64(w.maxChunk())
+	var total int64
+	for {
+		n, err := w.ResponseWriterWrapper.ReadFrom(io.LimitReader(r, chunk))
+		total += n
+		if n > 0 {
+			w.setDeadline(int(n))
+		}
+		if err != nil {
+			return total, err
+		}
+		if n < chunk {
+			return total, nil
+		}
+	}
+}
+
+// Interface guards
+var (
+	_ io.ReadCloser       = (*IdleTimeoutReader)(nil)
+	_ http.ResponseWriter = (*IdleTimeoutWriter)(nil)
+	_ io.ReaderFrom       = (*IdleTimeoutWriter)(nil)
+)
