diff --git a/modules/caddyhttp/idletimeout.go b/modules/caddyhttp/idletimeout.go
new file mode 100644
index 000000000..e14fde640
--- /dev/null
+++ b/modules/caddyhttp/idletimeout.go
@@ -0,0 +1,352 @@
+// Copyright 2015 Matthew Holt and The Caddy Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package caddyhttp
+
+import (
+	"bufio"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+)
+
+// DefaultMaxWriteChunk is the largest number of bytes handed to the
+// underlying ResponseWriter by a single write when an idle write
+// deadline is in effect. A deadline bounds the whole write call it
+// precedes, not merely a stall within it, so writes are split into
+// chunks of at most this size with the deadline reset in between;
+// otherwise one big write (or a ReadFrom fast path) would have to
+// finish within a single deadline window no matter how large it is.
+const DefaultMaxWriteChunk = 64 * 1024
+
+// maxRateCreditSeconds caps the amount of extra time a transfer can
+// earn from its minimum rate, so that absurd byte counts or tiny rates
+// cannot overflow a time.Duration.
+const maxRateCreditSeconds = 1 << 30
+
+// IdleDeadline describes a deadline which is extended every time a
+// transfer makes progress, so that a connection which is stalled is
+// cut off while one which is slow but progressing is left alone.
+//
+// This is a mitigation for slowloris-style attacks, which defeat hard
+// timeouts from below: a hard timeout short enough to stop a client
+// that trickles bytes forever is also short enough to kill legitimate
+// large transfers.
+type IdleDeadline struct {
+	// Start is when the transfer began. It is the fixed point from
+	// which the MinRate budget grows; it is ignored if MinRate is 0.
+	Start time.Time
+
+	// Timeout is how long a transfer may make no progress before it
+	// is cut off. If 0, no idle deadline is applied (only the hard
+	// deadline, if any, is enforced).
+	Timeout time.Duration
+
+	// MinRate, if positive, is the minimum number of bytes per second
+	// the transfer must sustain. The deadline then grows from Start by
+	// one second for every MinRate bytes transferred, so a trickle that
+	// is never idle but never sustains the rate is still cut off, while
+	// a transfer at or above the rate is allowed to run past the idle
+	// window.
+	MinRate int64
+
+	// HardDeadline, if not zero, is an absolute ceiling: the deadline
+	// resulting from idle resets and rate credit is never pushed past
+	// it.
+	HardDeadline time.Time
+}
+
+// Enabled returns true if d imposes any deadline at all.
+func (d IdleDeadline) Enabled() bool {
+	return d.Timeout > 0 || !d.HardDeadline.IsZero()
+}
+
+// deadlineAfter returns the deadline to apply to the next read or
+// write, given that n bytes have been transferred so far. It returns
+// the zero time if no deadline should be applied.
+func (d IdleDeadline) deadlineAfter(n int64) time.Time {
+	var deadline time.Time
+	if d.Timeout > 0 {
+		deadline = time.Now().Add(d.Timeout)
+		if d.MinRate > 0 && !d.Start.IsZero() {
+			// the transfer has earned one second of budget for every
+			// MinRate bytes it has moved since it started; if that is
+			// sooner than a full idle window from now, it wins
+			seconds := float64(n) / float64(d.MinRate)
+			if seconds > maxRateCreditSeconds {
+				seconds = maxRateCreditSeconds
+			}
+			earned := d.Start.Add(d.Timeout + time.Duration(seconds*float64(time.Second)))
+			if earned.Before(deadline) {
+				deadline = earned
+			}
+		}
+	}
+	if !d.HardDeadline.IsZero() && (deadline.IsZero() || d.HardDeadline.Before(deadline)) {
+		deadline = d.HardDeadline
+	}
+	return deadline
+}
+
+// IdleTimeoutReader wraps a request body and resets the connection's
+// read deadline before every read, so that the deadline bounds how
+// long the client may stall rather than how long the whole upload may
+// take. See IdleDeadline.
+type IdleTimeoutReader struct {
+	io.ReadCloser
+
+	// Ctrl is the response controller of the underlying (unwrapped)
+	// ResponseWriter, used to set read deadlines.
+	Ctrl *http.ResponseController
+
+	// Deadline configures the deadline to enforce.
+	Deadline IdleDeadline
+
+	// Logger is used to report deadlines that cannot be set.
+	Logger *zap.Logger
+
+	read     int64
+	started  bool
+	disabled bool
+}
+
+// Read implements io.Reader.
+func (r *IdleTimeoutReader) Read(p []byte) (int, error) {
+	r.arm()
+	n, err := r.ReadCloser.Read(p)
+	r.read += int64(n)
+	return n, err
+}
+
+// Close implements io.Closer. It releases the idle deadline before
+// closing the underlying body.
+func (r *IdleTimeoutReader) Close() error {
+	r.Done()
+	return r.ReadCloser.Close()
+}
+
+// Done releases the idle deadline, leaving only the hard deadline (if
+// any) in effect. It should be called once the handler chain is done
+// reading the request body.
+func (r *IdleTimeoutReader) Done() {
+	if r.started && !r.disabled {
+		r.setDeadline(r.Deadline.HardDeadline)
+	}
+}
+
+// arm sets the read deadline for the read that is about to happen.
+func (r *IdleTimeoutReader) arm() {
+	if r.disabled {
+		return
+	}
+	if !r.started {
+		r.started = true
+		if r.Deadline.Start.IsZero() {
+			r.Deadline.Start = time.Now()
+		}
+	}
+	r.setDeadline(r.Deadline.deadlineAfter(r.read))
+}
+
+func (r *IdleTimeoutReader) setDeadline(deadline time.Time) {
+	if err := r.Ctrl.SetReadDeadline(deadline); err != nil {
+		// no point in trying again for every subsequent read
+		r.disabled = true
+		logDeadlineError(r.Logger, "could not set read deadline", err)
+	}
+}
+
+// logDeadlineError reports a deadline that could not be set. A writer
+// that simply doesn't support deadlines is not the operator's fault, so
+// it is only worth a debug message.
+func logDeadlineError(logger *zap.Logger, msg string, err error) {
+	level := zapcore.ErrorLevel
+	if errors.Is(err, http.ErrNotSupported) {
+		level = zapcore.DebugLevel
+	}
+	if c := logger.Check(level, msg); c != nil {
+		c.Write(zap.Error(err))
+	}
+}
+
+// IdleTimeoutWriter wraps a response writer and resets the
+// connection's write deadline before every write, so that the deadline
+// bounds how long the client may stall rather than how long the whole
+// response may take. Large writes are split into chunks of at most
+// MaxChunk bytes so that no single write has to complete within one
+// deadline window. See IdleDeadline.
+type IdleTimeoutWriter struct {
+	*ResponseWriterWrapper
+
+	// Ctrl is the response controller of the underlying (unwrapped)
+	// ResponseWriter, used to set write deadlines.
+	Ctrl *http.ResponseController
+
+	// Deadline configures the deadline to enforce.
+	Deadline IdleDeadline
+
+	// MaxChunk is the maximum number of bytes to write to the
+	// underlying writer at a time. If 0, DefaultMaxWriteChunk is used.
+	MaxChunk int
+
+	// Logger is used to report deadlines that cannot be set.
+	Logger *zap.Logger
+
+	written  int64
+	started  bool
+	disabled bool
+}
+
+// WriteHeader implements http.ResponseWriter.
+func (w *IdleTimeoutWriter) WriteHeader(statusCode int) {
+	w.arm()
+	w.ResponseWriterWrapper.WriteHeader(statusCode)
+}
+
+// Write implements http.ResponseWriter, splitting p into chunks of at
+// most MaxChunk bytes and resetting the write deadline before each one.
+func (w *IdleTimeoutWriter) Write(p []byte) (int, error) {
+	if len(p) == 0 {
+		w.arm()
+		return w.ResponseWriterWrapper.Write(p)
+	}
+
+	maxChunk := w.maxChunk()
+	var written int
+	for len(p) > 0 {
+		chunk := p
+		if len(chunk) > maxChunk {
+			chunk = chunk[:maxChunk]
+		}
+		w.arm()
+		n, err := w.ResponseWriterWrapper.Write(chunk)
+		written += n
+		w.written += int64(n)
+		if err != nil {
+			return written, err
+		}
+		if n < len(chunk) {
+			return written, io.ErrShortWrite
+		}
+		p = p[n:]
+	}
+	return written, nil
+}
+
+// ReadFrom implements io.ReaderFrom. It copies at most MaxChunk bytes
+// per underlying write, resetting the write deadline in between, so
+// that a large transfer taken by a ReadFrom fast path is not bounded
+// as a whole by a single deadline.
+func (w *IdleTimeoutWriter) ReadFrom(r io.Reader) (int64, error) {
+	maxChunk := int64(w.maxChunk())
+	var copied int64
+	for {
+		w.arm()
+		n, err := w.ResponseWriterWrapper.ReadFrom(io.LimitReader(r, maxChunk))
+		copied += n
+		w.written += n
+		if err != nil {
+			return copied, err
+		}
+		if n < maxChunk {
+			// the source is drained
+			return copied, nil
+		}
+	}
+}
+
+// Flush implements http.Flusher, so that handlers doing a plain
+// w.(http.Flusher) assertion still find one, as they do on the real
+// writer. Flushing pushes bytes to the client, so it resets the
+// deadline like any other write.
+func (w *IdleTimeoutWriter) Flush() {
+	_ = w.FlushError()
+}
+
+// FlushError is the same, for http.ResponseController.Flush, which
+// prefers FlushError over Flush.
+// See https://github.com/caddyserver/caddy/issues/6144.
+func (w *IdleTimeoutWriter) FlushError() error {
+	w.arm()
+	return w.Ctrl.Flush()
+}
+
+// Hijack implements http.Hijacker. Deadlines are cleared before the
+// connection is handed over, since the caller takes over responsibility
+// for it and is no longer writing through this writer (e.g. WebSocket
+// connections, which may legitimately be idle for a long time).
+func (w *IdleTimeoutWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	conn, brw, err := w.Ctrl.Hijack()
+	if err != nil {
+		return conn, brw, err
+	}
+	w.disabled = true
+	if err := conn.SetDeadline(time.Time{}); err != nil {
+		logDeadlineError(w.Logger, "could not clear deadlines on hijacked connection", err)
+	}
+	return conn, brw, nil
+}
+
+// Done releases the idle deadline, leaving only the hard deadline (if
+// any) in effect. It should be called once the handler chain is done
+// writing the response.
+func (w *IdleTimeoutWriter) Done() {
+	if w.started && !w.disabled {
+		w.setDeadline(w.Deadline.HardDeadline)
+	}
+}
+
+// maxChunk returns the configured chunk size, or the default.
+func (w *IdleTimeoutWriter) maxChunk() int {
+	if w.MaxChunk > 0 {
+		return w.MaxChunk
+	}
+	return DefaultMaxWriteChunk
+}
+
+// arm sets the write deadline for the write that is about to happen.
+func (w *IdleTimeoutWriter) arm() {
+	if w.disabled {
+		return
+	}
+	if !w.started {
+		w.started = true
+		if w.Deadline.Start.IsZero() {
+			w.Deadline.Start = time.Now()
+		}
+	}
+	w.setDeadline(w.Deadline.deadlineAfter(w.written))
+}
+
+func (w *IdleTimeoutWriter) setDeadline(deadline time.Time) {
+	if err := w.Ctrl.SetWriteDeadline(deadline); err != nil {
+		// no point in trying again for every subsequent write
+		w.disabled = true
+		logDeadlineError(w.Logger, "could not set write deadline", err)
+	}
+}
+
+// Interface guards
+var (
+	_ io.ReadCloser       = (*IdleTimeoutReader)(nil)
+	_ http.ResponseWriter = (*IdleTimeoutWriter)(nil)
+	_ http.Hijacker       = (*IdleTimeoutWriter)(nil)
+	_ http.Flusher        = (*IdleTimeoutWriter)(nil)
+	_ io.ReaderFrom       = (*IdleTimeoutWriter)(nil)
+)
diff --git a/modules/caddyhttp/idletimeout_server_test.go b/modules/caddyhttp/idletimeout_server_test.go
