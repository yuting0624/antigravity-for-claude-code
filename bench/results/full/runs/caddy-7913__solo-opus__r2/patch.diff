+package timeouts
+
+import (
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func init() {
+	caddy.RegisterModule(Timeouts{})
+}
+
+// Timeouts is a middleware that applies idle-based read and write
+// timeouts to a single route, as a more targeted alternative to the
+// server-wide `read_idle_timeout` and `write_idle_timeout` options.
+//
+// Unlike a hard timeout, the deadline is reset every time the transfer
+// makes progress, so a connection which stalls is cut off while one
+// which is slow but progressing is left alone. Optional minimum
+// transfer rates additionally cut off transfers which trickle along
+// without ever stalling.
+type Timeouts struct {
+	// How long a read from the request body may make no progress
+	// before it is aborted. The deadline is reset on every successful
+	// read. If 0, no read deadline is applied by this handler.
+	ReadTimeout time.Duration `json:"read_timeout,omitempty"`
+
+	// The minimum number of bytes per second the request body must be
+	// uploaded at. The allowed deadline grows from the start of the
+	// transfer by one second for every this many bytes read, so an
+	// upload that never stalls but never sustains this rate is still
+	// aborted. If 0 (default), no minimum rate is enforced.
+	ReadMinRate int64 `json:"read_min_rate,omitempty"`
+
+	// How long a write of the response may make no progress before it
+	// is aborted. The deadline is reset on every successful write. If
+	// 0, no write deadline is applied by this handler.
+	WriteTimeout time.Duration `json:"write_timeout,omitempty"`
+
+	// The minimum number of bytes per second the response must be
+	// downloaded at. The allowed deadline grows from the start of the
+	// transfer by one second for every this many bytes written, so a
+	// download that never stalls but never sustains this rate is still
+	// aborted. If 0 (default), no minimum rate is enforced.
+	WriteMinRate int64 `json:"write_min_rate,omitempty"`
+
+	// The maximum number of bytes to write to the client at a time
+	// while a write deadline is in effect; the deadline is reset
+	// between chunks. Default: 64KiB.
+	MaxWriteChunk int `json:"max_write_chunk,omitempty"`
+
+	logger *zap.Logger
+}
+
+// CaddyModule returns the Caddy module information.
+func (Timeouts) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{
+		ID:  "http.handlers.timeouts",
+		New: func() caddy.Module { return new(Timeouts) },
+	}
+}
+
+// Provision sets up the handler.
+func (t *Timeouts) Provision(ctx caddy.Context) error {
+	t.logger = ctx.Logger()
+	return nil
+}
+
+// ServeHTTP implements caddyhttp.MiddlewareHandler.
+func (t Timeouts) ServeHTTP(w http.ResponseWriter, r *http.Request, next caddyhttp.Handler) error {
+	if t.ReadTimeout <= 0 && t.WriteTimeout <= 0 {
+		return next.ServeHTTP(w, r)
+	}
+
+	//nolint:bodyclose
+	ctrl := http.NewResponseController(w)
+	start := time.Now()
+
+	if t.ReadTimeout > 0 && r.Body != nil && r.Body != http.NoBody {
+		r.Body = &caddyhttp.IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       ctrl,
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   start,
+				Timeout: t.ReadTimeout,
+				MinRate: t.ReadMinRate,
+			},
+			Logger: t.logger,
+		}
+	}
+
+	if t.WriteTimeout > 0 {
+		itw := &caddyhttp.IdleTimeoutWriter{
+			ResponseWriterWrapper: &caddyhttp.ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  ctrl,
+			// the response transfer only begins once a handler writes
+			// something, so the deadline's start is left to be set then
+			Deadline: caddyhttp.IdleDeadline{
+				Timeout: t.WriteTimeout,
+				MinRate: t.WriteMinRate,
+			},
+			MaxChunk: t.MaxWriteChunk,
+			Logger:   t.logger,
+		}
+		// the deadline only governs this route; release it once the
+		// rest of the chain is done writing
+		defer itw.Done()
+		w = itw
+	}
+
+	return next.ServeHTTP(w, r)
+}
+
+// Interface guards
+var (
+	_ caddy.Provisioner           = (*Timeouts)(nil)
+	_ caddyhttp.MiddlewareHandler = (*Timeouts)(nil)
+)
