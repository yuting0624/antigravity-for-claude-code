+		Start:   start,
+		Timeout: time.Duration(s.ReadIdleTimeout),
+		MinRate: s.ReadMinRate,
+	}
+	// the response transfer only begins once a handler writes something,
+	// so the write deadline's start is left to be set then; the minimum
+	// rate should not be measured across the time spent generating the
+	// response
+	writeDeadline := IdleDeadline{
+		Timeout: time.Duration(s.WriteIdleTimeout),
+		MinRate: s.WriteMinRate,
+	}
+	if s.ReadTimeout > 0 {
+		readDeadline.HardDeadline = start.Add(time.Duration(s.ReadTimeout))
+	}
+	if s.WriteTimeout > 0 {
+		writeDeadline.HardDeadline = start.Add(time.Duration(s.WriteTimeout))
+	}
