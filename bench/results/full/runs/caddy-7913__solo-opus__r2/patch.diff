+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package caddyhttp
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"go.uber.org/zap"
+
+	"github.com/caddyserver/caddy/v2"
+)
+
+func TestServerApplyIdleTimeouts(t *testing.T) {
+	start := time.Now()
+
+	for _, tc := range []struct {
+		name        string
+		server      *Server
+		req         *http.Request
+		wantReader  bool
+		wantWriter  bool
+		wantReadEnd time.Time // expected hard read deadline, if any
+	}{
+		{
+			name:       "both idle timeouts wrap the transfer",
+			server:     &Server{ReadIdleTimeout: caddy.Duration(time.Minute), WriteIdleTimeout: caddy.Duration(time.Minute)},
+			req:        httptest.NewRequest(http.MethodPost, "/", strings.NewReader("body")),
+			wantReader: true,
+			wantWriter: true,
+		},
+		{
+			name:       "negative timeouts disable wrapping",
+			server:     &Server{ReadIdleTimeout: caddy.Duration(-1), WriteIdleTimeout: caddy.Duration(-1)},
+			req:        httptest.NewRequest(http.MethodPost, "/", strings.NewReader("body")),
+			wantReader: false,
+			wantWriter: false,
+		},
+		{
+			name:       "bodyless requests are not wrapped for reading",
+			server:     &Server{ReadIdleTimeout: caddy.Duration(time.Minute), WriteIdleTimeout: caddy.Duration(-1)},
+			req:        httptest.NewRequest(http.MethodGet, "/", nil),
+			wantReader: false,
+			wantWriter: false,
+		},
+		{
+			name:       "protocol upgrades are left alone",
+			server:     &Server{ReadIdleTimeout: caddy.Duration(time.Minute), WriteIdleTimeout: caddy.Duration(time.Minute)},
+			req:        upgradeRequest(),
+			wantReader: false,
+			wantWriter: false,
+		},
+		{
+			name: "hard read timeout caps the idle deadline",
+			server: &Server{
+				ReadIdleTimeout: caddy.Duration(time.Minute),
+				ReadTimeout:     caddy.Duration(10 * time.Second),
+			},
+			req:         httptest.NewRequest(http.MethodPost, "/", strings.NewReader("body")),
+			wantReader:  true,
+			wantWriter:  false,
+			wantReadEnd: start.Add(10 * time.Second),
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			tc.server.logger = zap.NewNop()
+			reader, writer := tc.server.applyIdleTimeouts(httptest.NewRecorder(), tc.req, start)
+
+			if got := reader != nil; got != tc.wantReader {
+				t.Errorf("wrapped request body = %v, want %v", got, tc.wantReader)
+			}
+			if got := writer != nil; got != tc.wantWriter {
+				t.Errorf("wrapped response writer = %v, want %v", got, tc.wantWriter)
+			}
+			if reader != nil && tc.req.Body != io.ReadCloser(reader) {
+				t.Error("request body was not replaced with the wrapped reader")
+			}
+			if reader != nil && !reader.Deadline.HardDeadline.Equal(tc.wantReadEnd) {
+				t.Errorf("hard read deadline = %v, want %v", reader.Deadline.HardDeadline, tc.wantReadEnd)
+			}
+		})
+	}
+}
+
+func upgradeRequest() *http.Request {
+	r := httptest.NewRequest(http.MethodGet, "/", nil)
+	r.Header.Set("Connection", "Upgrade")
+	r.Header.Set("Upgrade", "websocket")
+	return r
+}
+
+func TestIdleDeadlineNeverExceedsHardDeadline(t *testing.T) {
+	start := time.Now()
+	hard := start.Add(50 * time.Millisecond)
+	d := IdleDeadline{
+		Start:        start,
+		Timeout:      time.Hour,
+		MinRate:      1,
+		HardDeadline: hard,
+	}
+	// neither a fresh idle window nor a large amount of rate credit may
+	// push the deadline past the hard ceiling
+	if got := d.deadlineAfter(1 << 40); !got.Equal(hard) {
+		t.Errorf("deadline = %v, want the hard deadline %v", got, hard)
+	}
+}
+
+func TestIdleTimeoutReaderCountsTowardMinRate(t *testing.T) {
+	body := io.NopCloser(strings.NewReader(strings.Repeat("a", 100)))
+	r := &IdleTimeoutReader{
+		ReadCloser: body,
+		Ctrl:       http.NewResponseController(httptest.NewRecorder()), //nolint:bodyclose
+		Deadline:   IdleDeadline{Timeout: time.Minute, MinRate: 10},
+		Logger:     zap.NewNop(),
+	}
+	n, err := io.Copy(io.Discard, r)
+	if err != nil {
+		t.Fatalf("copying body: %v", err)
+	}
+	if n != 100 {
+		t.Fatalf("read %d bytes, want 100", n)
+	}
+	if r.read != 100 {
+		t.Errorf("tracked %d bytes read, want 100", r.read)
+	}
+	// httptest's recorder cannot set deadlines, so the reader must have
+	// given up on them rather than failing the read
+	if !r.disabled {
+		t.Error("expected deadline enforcement to be disabled after an unsupported writer")
+	}
+}
