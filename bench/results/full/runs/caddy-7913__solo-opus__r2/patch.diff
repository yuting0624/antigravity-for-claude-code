+// The wrappers that were installed are returned, if any; their Done
+// methods must be called once the request has been handled, and the
+// returned writer (if not nil) must be used in place of w. The request
+// body is replaced in place.
+func (s *Server) applyIdleTimeouts(w http.ResponseWriter, r *http.Request, start time.Time) (*IdleTimeoutReader, *IdleTimeoutWriter) {
