+			ReadCloser: r.Body,
+			//nolint:bodyclose
+			Ctrl:     http.NewResponseController(w),
+			Deadline: readDeadline,
+			Logger:   s.logger,
+		}
+		r.Body = reader
+	}
+
+	if !writeDeadline.Enabled() {
+		return reader, nil
+	}
+	return reader, &IdleTimeoutWriter{
+		ResponseWriterWrapper: &ResponseWriterWrapper{ResponseWriter: w},
+		//nolint:bodyclose
+		Ctrl:     http.NewResponseController(w),
+		Deadline: writeDeadline,
+		MaxChunk: s.MaxWriteChunk,
+		Logger:   s.logger,
+	}
