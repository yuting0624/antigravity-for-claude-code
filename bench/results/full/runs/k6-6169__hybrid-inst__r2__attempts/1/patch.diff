diff --git a/internal/cloudapi/clientcfg/clientcfg.go b/internal/cloudapi/clientcfg/clientcfg.go
new file mode 100644
index 000000000..7bc0609b9
--- /dev/null
+++ b/internal/cloudapi/clientcfg/clientcfg.go
@@ -0,0 +1,12 @@
+// Package clientcfg provides the HTTP retry tuning shared by the k6 Cloud API
+// clients, so the SDK-backed clients and the hand-rolled ones agree on it.
+package clientcfg
+
+import "time"
+
+const (
+	// RetryInterval is the default cloud request retry interval.
+	RetryInterval = 500 * time.Millisecond
+	// MaxRetries specifies the max retry attempts.
+	MaxRetries = 3
+)
diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..1dbb0ab63
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,275 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// StartLocalExecutionRequest is the payload of a start-local-execution call.
+type StartLocalExecutionRequest struct {
+	Options       json.RawMessage
+	MaxVUs        int32
+	TotalDuration int32
+	// ArchiveSize is the size in bytes of the archive that will be uploaded.
+	// Zero means no archive is uploaded and is sent as an explicit JSON null.
+	ArchiveSize int64
+}
+
+// StartLocalExecutionResponse is the decoded start-local-execution response.
+type StartLocalExecutionResponse struct {
+	TestRunID             int64
+	ArchiveUploadURL      *string
+	TestRunDetailsPageURL string
+	RuntimeConfig         RuntimeConfig
+}
+
+// RuntimeConfig is the per-test-run configuration the cloud hands back.
+type RuntimeConfig struct {
+	Metrics      MetricsConfig
+	TestRunToken string
+	Secrets      SecretsConfig
+}
+
+// MetricsConfig tunes how the cloud output pushes metrics.
+type MetricsConfig struct {
+	PushURL               string
+	PushInterval          *string
+	PushConcurrency       *int32
+	AggregationPeriod     *string
+	AggregationWaitPeriod *string
+	AggregationMinSamples *int32
+	MaxSamplesPerPackage  *int32
+}
+
+// SecretsConfig points at the test-run-scoped secrets endpoint.
+type SecretsConfig struct {
+	Endpoint     string
+	ResponsePath string
+}
+
+func checkSDKResponse(hr *http.Response, err error) error {
+	if err != nil {
+		var aerr *k6cloud.GenericOpenAPIError
+		if !errors.As(err, &aerr) {
+			return err
+		}
+	}
+	if hr == nil {
+		return errUnknown
+	}
+	return CheckResponse(hr)
+}
+
+func nullableStringPtr(n k6cloud.NullableString) *string {
+	if n.IsSet() && n.Get() != nil {
+		v := *n.Get()
+		return &v
+	}
+	return nil
+}
+
+func nullableInt32Ptr(n k6cloud.NullableInt32) *int32 {
+	if n.IsSet() && n.Get() != nil {
+		v := *n.Get()
+		return &v
+	}
+	return nil
+}
+
+// StartLocalExecution starts a local-execution test run for the given load test.
+func (c *Client) StartLocalExecution(
+	ctx context.Context, loadTestID int64, req StartLocalExecutionRequest,
+) (_ *StartLocalExecutionResponse, err error) {
+	reqModel := k6cloud.NewStartLocalExecutionTestRequestWithDefaults()
+	if len(req.Options) > 0 {
+		var opts map[string]any
+		if err := json.Unmarshal(req.Options, &opts); err != nil {
+			return nil, fmt.Errorf("unmarshal options: %w", err)
+		}
+		reqModel.SetOptions(opts)
+	}
+	reqModel.SetMaxVus(req.MaxVUs)
+	reqModel.SetTotalDuration(req.TotalDuration)
+	if req.ArchiveSize > 0 {
+		reqModel.SetArchiveSize(int32(req.ArchiveSize))
+	} else {
+		reqModel.SetArchiveSizeNil()
+	}
+
+	var key [8]byte
+	if _, err := rand.Read(key[:]); err != nil {
+		return nil, err
+	}
+	idempKey := hex.EncodeToString(key[:])
+
+	var (
+		res *k6cloud.StartLocalExecutionTestResponse
+		hr  *http.Response
+	)
+	res, hr, err = c.apiClient.ProvisioningAPI.
+		StartLocalExecutionTest(c.authCtx(ctx), loadTestID).
+		K6IdempotencyKey(idempKey).
+		StartLocalExecutionTestRequest(reqModel).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if err := checkSDKResponse(hr, err); err != nil {
+		return nil, err
+	}
+	if res == nil {
+		return nil, errUnknown
+	}
+
+	rc := res.GetRuntimeConfig()
+	met := rc.GetMetrics()
+	sec := rc.GetSecrets()
+
+	return &StartLocalExecutionResponse{
+		TestRunID:             res.GetTestRunId(),
+		ArchiveUploadURL:      nullableStringPtr(res.ArchiveUploadUrl),
+		TestRunDetailsPageURL: res.GetTestRunDetailsPageUrl(),
+		RuntimeConfig: RuntimeConfig{
+			Metrics: MetricsConfig{
+				PushURL:               met.GetPushUrl(),
+				PushInterval:          nullableStringPtr(met.PushInterval),
+				PushConcurrency:       nullableInt32Ptr(met.PushConcurrency),
+				AggregationPeriod:     nullableStringPtr(met.AggregationPeriod),
+				AggregationWaitPeriod: nullableStringPtr(met.AggregationWaitPeriod),
+				AggregationMinSamples: nullableInt32Ptr(met.AggregationMinSamples),
+				MaxSamplesPerPackage:  nullableInt32Ptr(met.MaxSamplesPerPackage),
+			},
+			TestRunToken: rc.GetTestRunToken(),
+			Secrets: SecretsConfig{
+				Endpoint:     sec.GetEndpoint(),
+				ResponsePath: sec.GetResponsePath(),
+			},
+		},
+	}, nil
+}
+
+// UploadArchive uploads the test archive to a presigned URL returned by the
+// provisioning API.
+func (c *Client) UploadArchive(ctx context.Context, uploadURL string, archive []byte) error {
+	httpClient := c.apiClient.GetConfig().HTTPClient
+	if httpClient == nil {
+		httpClient = http.DefaultClient
+	}
+
+	for attempt := 0; attempt <= clientcfg.MaxRetries; attempt++ {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+
+		req, err := http.NewRequestWithContext(ctx, http.MethodPut, uploadURL, bytes.NewReader(archive))
+		if err != nil {
+			return err
+		}
+		req.Header.Set("Content-Type", "application/x-tar")
+
+		resp, err := httpClient.Do(req)
+		if err != nil {
+			if attempt < clientcfg.MaxRetries {
+				select {
+				case <-ctx.Done():
+					return ctx.Err()
+				case <-time.After(clientcfg.RetryInterval):
+				}
+				continue
+			}
+			return err
+		}
+
+		chkErr := CheckResponse(resp)
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+
+		if resp.StatusCode >= 200 && resp.StatusCode <= 299 {
+			return nil
+		}
+
+		if (resp.StatusCode >= 500 && resp.StatusCode <= 599 || resp.StatusCode == http.StatusTooManyRequests) && attempt < clientcfg.MaxRetries {
+			select {
+			case <-ctx.Done():
+				return ctx.Err()
+			case <-time.After(clientcfg.RetryInterval):
+			}
+			continue
+		}
+
+		return chkErr
+	}
+
+	return errUnknown
+}
+
+// WaitForTestRunReady polls the test run until the cloud reports it is
+// initializing and therefore ready to receive metrics.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	var lastLogged v6.Status
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		tp, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			return err
+		}
+		switch tp.Status {
+		case v6.StatusInitializing, v6.StatusRunning:
+			return nil
+		case v6.StatusAborted:
+			for _, event := range tp.StatusHistory {
+				if event.Status == v6.StatusAborted && event.Message != "" {
+					return fmt.Errorf("test run aborted: %s", event.Message)
+				}
+			}
+			return errors.New("test run aborted before starting")
+		case v6.StatusCompleted, v6.StatusProcessingMetrics:
+			return fmt.Errorf("test run %d already completed before local execution could start", testRunID)
+		default:
+			if tp.Status != lastLogged {
+				lastLogged = tp.Status
+				c.logger.WithField("status", tp.FormatStatus()).Info("Waiting for the cloud test run to be ready")
+			}
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(pollInterval):
+		}
+	}
+}
+
+// NotifyTestRunCompleted reports the end of the local script execution to the
+// provisioning API.
+func (c *Client) NotifyTestRunCompleted(
+	ctx context.Context, testRunID int64, token string, testErr error,
+) (err error) {
+	model := k6cloud.NewScriptExecutionCompletedNotificationApiModel("script_execution_completed")
+	if ne := mapTestErrorToNotifyCode(testErr); ne != nil {
+		model.SetError(*k6cloud.NewScriptExecutionError(ne.Code, ne.Reason))
+	}
+
+	authCtx := context.WithValue(ctx, k6cloud.ContextAccessToken, token)
+	var hr *http.Response
+	hr, err = c.apiClient.ProvisioningAPI.
+		TestRunsNotify(authCtx, testRunID).
+		ScriptExecutionCompletedNotificationApiModel(model).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	return checkSDKResponse(hr, err)
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..8e06aaf0c
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,86 @@
+package provisioning
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client talks to the k6 Cloud provisioning API, and to the v6 API for the
+// pieces of the local-execution flow that live there.
+type Client struct {
+	apiClient *k6cloud.APIClient
+	v6Client  *v6.Client
+
+	token   string
+	stackID int64
+	version string
+
+	logger logrus.FieldLogger
+}
+
+// NewClient returns a client for the k6 Cloud provisioning API.
+func NewClient(logger logrus.FieldLogger, token, host, version string, stackID int64, timeout time.Duration) (*Client, error) {
+	if token == "" {
+		return nil, fmt.Errorf("token is required to create cloud API client")
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Global k6 Cloud API.",
+		},
+	}
+	cfg.HTTPClient = &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+
+	if stackID != 0 {
+		cfg.AddDefaultHeader("X-Stack-Id", strconv.FormatInt(stackID, 10))
+	}
+
+	v6Client, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if err := v6Client.SetStackID(stackID); err != nil {
+		return nil, err
+	}
+
+	return &Client{
+		apiClient: k6cloud.NewAPIClient(cfg),
+		v6Client:  v6Client,
+		token:     token,
+		stackID:   stackID,
+		version:   version,
+		logger:    logger,
+	}, nil
+}
+
+func (c *Client) authCtx(ctx context.Context) context.Context {
+	return context.WithValue(ctx, k6cloud.ContextAccessToken, c.token)
+}
+
+func closeResponse(res *http.Response, rerr *error) {
+	if res == nil {
+		return
+	}
+	_, _ = io.Copy(io.Discard, res.Body)
+	if err := res.Body.Close(); err != nil && *rerr == nil {
+		*rerr = err
+	}
+}
