+// CreateOrFindLoadTest makes sure a load test with the given name exists in
+// the project and returns its id. The test is created without a script: on a
+// 409 conflict the existing one is looked up by name instead.
+func (c *Client) CreateOrFindLoadTest(ctx context.Context, projectID int64, name string) (int64, error) {
+	lt, err := c.createLoadTest(ctx, projectID, name)
+	if err == nil {
+		return lt.GetId(), nil
+	}
+
+	var rerr ResponseError
+	if !errors.As(err, &rerr) || rerr.Response == nil || rerr.Response.StatusCode != http.StatusConflict {
+		return 0, err
+	}
+
+	// 409: a test with this name already exists in this project.
+	lt, err = c.findTestByName(ctx, projectID, name)
+	if err != nil {
+		return 0, err
+	}
+	return lt.GetId(), nil
+}
+
+// createLoadTest creates a new cloud load test with no script attached.
+func (c *Client) createLoadTest(ctx context.Context, projectID int64, name string) (_ *k6cloud.LoadTestApiModel, err error) {
+	res, hr, err := c.apiClient.LoadTestsAPI.
+		ProjectsLoadTestsCreate(c.authCtx(ctx), projectID).
+		XStackId(c.stackID).
+		Name(name).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if err := CheckResponse(hr, err); err != nil {
+		return nil, err
+	}
+	if res == nil {
+		return nil, errUnknown
+	}
+
+	return res, nil
+}
