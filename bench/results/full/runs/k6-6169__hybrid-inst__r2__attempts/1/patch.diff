+// Package provtest provides an HTTP test server that simulates the k6 Cloud
+// provisioning API and the v6 endpoints used alongside it.
+//
+// The package name intentionally differs from the directory name ("test") so
+// callers can import it cleanly as:
+//
+//	provtest "go.k6.io/k6/v2/internal/cloudapi/provisioning/test"
+//
+// It keeps provisioning-specific wire encoding (OpenAPI SDK models, nullable
+// fields, runtime configs) out of consumer test files. Consumer tests configure
+// endpoints and verify behavior against high-level models; this server handles
+// the wire format.
+package provtest
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	// DefaultLoadTestID is the load test id served by the fake API.
+	DefaultLoadTestID int64 = 456
+	// DefaultTestRunID is the test run id served by the fake API.
+	DefaultTestRunID int64 = 123
+	// PresignedUploadPath is the path the fake presigned archive upload is served on.
+	PresignedUploadPath = "/presigned-upload/archive.tar"
+)
+
+// Server is a test HTTP server for the k6 Cloud provisioning API and the
+// v6 endpoints used alongside it.
+type Server struct {
+	*httptest.Server
+	// Mux is exposed so tests can register extra routes, e.g. a catch-all.
+	Mux *http.ServeMux
+
+	fetchTestRunHits atomic.Int32
+}
+
+// NewServer creates a new test server for the provisioning API.
+// It registers no routes by default.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+
+	mux := http.NewServeMux()
+	srv := httptest.NewServer(mux)
+	t.Cleanup(srv.Close)
+
+	return &Server{
+		Server: srv,
+		Mux:    mux,
+	}
+}
+
+// HandleCreateLoadTest registers a handler on the path for creating load tests
+// under the specified project.
+func (s *Server) HandleCreateLoadTest(projectID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID), h)
+}
+
+// HandleStartLocalExecution registers a handler for starting local execution of a load test.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/load_tests/%d/start_local_execution", loadTestID), h)
+}
+
+// HandlePresignedUpload registers a handler at the given upload path.
+func (s *Server) HandlePresignedUpload(path string, h http.HandlerFunc) {
+	s.Mux.HandleFunc(path, h)
+}
+
+// HandleNotify registers a handler for test run completion notification.
+func (s *Server) HandleNotify(testRunID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/test_runs/%d/notify", testRunID), h)
+}
+
+// HandleFetchTestRun registers a handler for fetching test run progress.
+// On each request, it increments the fetch hit counter and serves progresses in
+// order. Once exhausted, it continues serving the last progress element. If
+// progresses is empty, a zero TestProgress is served.
+func (s *Server) HandleFetchTestRun(testRunID int64, progresses []v6.TestProgress) {
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/test_runs/%d", testRunID), func(w http.ResponseWriter, _ *http.Request) {
+		hit := int(s.fetchTestRunHits.Add(1)) - 1
+		var tp v6.TestProgress
+		if len(progresses) > 0 {
+			if hit >= len(progresses) {
+				hit = len(progresses) - 1
+			}
+			tp = progresses[hit]
+		}
+
+		res := k6cloud.NewTestRunApiModelWithDefaults()
+		res.SetStatus(tp.Status.String())
+		res.SetResult(tp.Result.String())
+		res.SetEstimatedDuration(tp.EstimatedDuration)
+		res.SetExecutionDuration(tp.ExecutionDuration)
+		res.SetStatusHistory(v6.ToStatusModel(tp.StatusHistory))
+		res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+		res.SetResultDetails(k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(k6cloud.NewResultDetailsApiModel("")))
+		res.SetOptions(map[string]any{})
+
+		writeJSON(w, http.StatusOK, res)
+	})
+}
+
+// FetchTestRunHitCount returns the number of times the fetch-test-run route was hit.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchTestRunHits.Load()
+}
+
+// PresignedUploadURL returns the full URL for the fake presigned archive upload endpoint.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// DefaultStartLocalExecutionResponse returns a fully populated
+// StartLocalExecutionTestResponse with default values for tests.
+func DefaultStartLocalExecutionResponse() *k6cloud.StartLocalExecutionTestResponse {
+	pushInterval := "2s"
+	pushConcurrency := int32(5)
+	aggregationPeriod := "3s"
+	aggregationWaitPeriod := "1s"
+	aggregationMinSamples := int32(50)
+	maxSamplesPerPackage := int32(2000)
+
+	metrics := k6cloud.NewMetricsRuntimeConfig(
+		"https://ingest.k6.io/v1/metrics",
+		*k6cloud.NewNullableString(&pushInterval),
+		*k6cloud.NewNullableInt32(&pushConcurrency),
+		*k6cloud.NewNullableString(&aggregationPeriod),
+		*k6cloud.NewNullableString(&aggregationWaitPeriod),
+		*k6cloud.NewNullableInt32(&aggregationMinSamples),
+		*k6cloud.NewNullableInt32(&maxSamplesPerPackage),
+	)
+
+	traces := k6cloud.NewTracesRuntimeConfig("", map[string]string{}, "")
+	files := k6cloud.NewFilesRuntimeConfig("", "", map[string]string{}, "")
+	logs := k6cloud.NewLogsRuntimeConfig("", "", 0, "", "", 0, []string{})
+	secrets := k6cloud.NewSecretsRuntimeConfig(
+		"https://api.k6.io/provisioning/v1/test_runs/123/decrypt_secret?name={key}",
+		"plaintext",
+	)
+
+	runtimeConfig := k6cloud.NewRuntimeConfig(
+		*metrics,
+		*traces,
+		*files,
+		*logs,
+		*secrets,
+		"test-run-token-abc",
+	)
+
+	archiveUploadURL := "https://s3.amazonaws.com/k6-cloud-archives/456/archive.tar"
+	testRunDetailsPageURL := fmt.Sprintf("https://app.k6.io/runs/%d", DefaultTestRunID)
+
+	return k6cloud.NewStartLocalExecutionTestResponse(
+		DefaultTestRunID,
+		*runtimeConfig,
+		*k6cloud.NewNullableString(&archiveUploadURL),
+		testRunDetailsPageURL,
+	)
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	if err := json.NewEncoder(w).Encode(v); err != nil {
+		panic(fmt.Errorf("provtest: encoding JSON: %w", err))
+	}
+}
