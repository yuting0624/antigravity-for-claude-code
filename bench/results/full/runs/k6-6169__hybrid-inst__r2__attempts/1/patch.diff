+// buildConfigFromRuntimeConfig translates the metrics tuning the cloud
+// returned in the provisioning runtime config into a cloudapi.Config that can
+// be applied on top of the user configuration. Fields the cloud left unset
+// stay unset so the local defaults win.
+func buildConfigFromRuntimeConfig(logger logrus.FieldLogger, rc provisioning.RuntimeConfig) cloudapi.Config {
+	var conf cloudapi.Config
+	m := rc.Metrics
+
+	if d, ok := parseRuntimeConfigDuration(logger, "push_interval", m.PushInterval); ok {
+		conf.MetricPushInterval = types.NewNullDuration(d, true)
+	}
+	if m.PushConcurrency != nil {
+		conf.MetricPushConcurrency = null.IntFrom(int64(*m.PushConcurrency))
+	}
+	if d, ok := parseRuntimeConfigDuration(logger, "aggregation_period", m.AggregationPeriod); ok {
+		conf.AggregationPeriod = types.NewNullDuration(d, true)
+	}
+	if d, ok := parseRuntimeConfigDuration(logger, "aggregation_wait_period", m.AggregationWaitPeriod); ok {
+		conf.AggregationWaitPeriod = types.NewNullDuration(d, true)
+	}
+	if m.MaxSamplesPerPackage != nil {
+		conf.MaxTimeSeriesInBatch = null.IntFrom(int64(*m.MaxSamplesPerPackage))
+	}
+
+	// aggregation_min_samples has no cloudapi.Config counterpart: it is
+	// intentionally dropped, and that is not worth a warning.
+
+	return conf
+}
+
+// parseRuntimeConfigDuration parses an optional Go duration from the cloud
+// runtime config, warning and falling back to the local default when the
+// cloud sent something k6 cannot parse.
+func parseRuntimeConfigDuration(logger logrus.FieldLogger, field string, v *string) (time.Duration, bool) {
+	if v == nil {
+		return 0, false
+	}
+	d, err := time.ParseDuration(*v)
+	if err != nil {
+		logger.WithField("field", field).WithError(err).
+			Warn("Ignoring an unparseable duration in the cloud runtime config")
+		return 0, false
+	}
+	return d, true
+}
