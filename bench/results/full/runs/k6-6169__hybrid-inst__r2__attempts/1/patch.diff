index 000000000..d01e9aebb
--- /dev/null
+++ b/internal/cloudapi/provisioning/provision.go
@@ -0,0 +1,88 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"go.k6.io/k6/v2/lib"
+)
+
+// defaultPollInterval is how often the test run status is polled while waiting
+// for the cloud to be ready for the local execution to start.
+const defaultPollInterval = 1 * time.Second
+
+// ProvisionParams describes the test run to provision.
+type ProvisionParams struct {
+	Name          string
+	ProjectID     int64
+	MaxVUs        int32
+	TotalDuration int32
+	Options       json.RawMessage
+	// Archive is the test archive to upload; nil skips the upload.
+	Archive      *lib.Archive
+	PollInterval time.Duration
+}
+
+// ProvisionResult is everything the command layer needs to run the test locally
+// and stream its results to the cloud.
+type ProvisionResult struct {
+	TestRunID             int64
+	TestRunDetailsPageURL string
+	RuntimeConfig         RuntimeConfig
+}
+
+// ProvisionLocalExecution ensures the load test exists, starts a local-execution
+// test run, uploads the archive when there is one, and waits until the run is
+// ready to receive metrics.
+func (c *Client) ProvisionLocalExecution(ctx context.Context, p ProvisionParams) (*ProvisionResult, error) {
+	id, err := c.v6Client.CreateOrFindLoadTest(ctx, p.ProjectID, p.Name)
+	if err != nil {
+		return nil, fmt.Errorf("create or find load test: %w", err)
+	}
+
+	var archiveBytes []byte
+	if p.Archive != nil {
+		var buf bytes.Buffer
+		if err := p.Archive.Write(&buf); err != nil {
+			return nil, fmt.Errorf("serialize test archive: %w", err)
+		}
+		archiveBytes = buf.Bytes()
+	}
+
+	res, err := c.StartLocalExecution(ctx, id, StartLocalExecutionRequest{
+		Options:       p.Options,
+		MaxVUs:        p.MaxVUs,
+		TotalDuration: p.TotalDuration,
+		ArchiveSize:   int64(len(archiveBytes)),
+	})
+	if err != nil {
+		return nil, fmt.Errorf("start local execution: %w", err)
+	}
+
+	if len(archiveBytes) > 0 {
+		if res.ArchiveUploadURL == nil || *res.ArchiveUploadURL == "" {
+			c.logger.Warn("Cloud did not return an archive upload URL, skipping archive upload")
+		} else {
+			if err := c.UploadArchive(ctx, *res.ArchiveUploadURL, archiveBytes); err != nil {
+				return nil, fmt.Errorf("upload archive: %w", err)
+			}
+		}
+	}
+
+	interval := p.PollInterval
+	if interval <= 0 {
+		interval = defaultPollInterval
+	}
+	if err := c.WaitForTestRunReady(ctx, res.TestRunID, interval); err != nil {
+		return nil, fmt.Errorf("wait for test run ready: %w", err)
+	}
+
+	return &ProvisionResult{
+		TestRunID:             res.TestRunID,
+		TestRunDetailsPageURL: res.TestRunDetailsPageURL,
+		RuntimeConfig:         res.RuntimeConfig,
+	}, nil
+}
