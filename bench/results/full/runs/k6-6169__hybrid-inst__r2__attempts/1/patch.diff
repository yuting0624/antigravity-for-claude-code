diff --git a/internal/cloudapi/provisioning/errors.go b/internal/cloudapi/provisioning/errors.go
new file mode 100644
index 000000000..55ab454e4
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,51 @@
+package provisioning
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+var errUnknown = errors.New("an error occurred communicating with k6 Cloud")
+
+// ResponseError represents an error returned by a k6 Cloud provisioning endpoint.
+type ResponseError struct {
+	StatusCode int
+	Body       string
+}
+
+func (e *ResponseError) Error() string {
+	return fmt.Sprintf("unexpected response from k6 Cloud: %d %s", e.StatusCode, e.Body)
+}
+
+// Unwrap classifies 401 and 403 the same way the v6 client does, so callers can
+// match them with errors.Is.
+func (e *ResponseError) Unwrap() error {
+	return httperr.ClassifyStatus(e.StatusCode)
+}
+
+// CheckResponse returns nil if the response code is in the successful range,
+// otherwise it returns a ResponseError carrying the status code and the body.
+func CheckResponse(r *http.Response) error {
+	if r == nil {
+		return errUnknown
+	}
+
+	if c := r.StatusCode; c >= 200 && c <= 299 {
+		return nil
+	}
+
+	data, err := io.ReadAll(r.Body)
+	if err != nil {
+		return &ResponseError{StatusCode: r.StatusCode}
+	}
+
+	return &ResponseError{
+		StatusCode: r.StatusCode,
+		Body:       strings.TrimSpace(string(data)),
+	}
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..e9d005b07
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,103 @@
+package provisioning
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient is a thin JSON-over-HTTP client that authenticates every request
+// with a test-run-scoped bearer token. It is handed to the cloud output so
+// metric pushes reuse the same auth and retry policy as the rest of the
+// provisioning flow.
+type HTTPClient struct {
+	client  *http.Client
+	token   string
+	version string
+	logger  logrus.FieldLogger
+}
+
+// NewHTTPClient returns an HTTPClient signing its requests with the given
+// test-run-scoped token.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	return &HTTPClient{
+		client:  client,
+		token:   token,
+		version: version,
+		logger:  logger,
+	}
+}
+
+// Do sends req, retrying transient failures, and decodes a JSON response body
+// into v when v is non-nil.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	req.Header.Set("Authorization", "Bearer "+c.token)
+	req.Header.Set("User-Agent", "k6cloud/"+c.version)
+
+	var lastErr error
+	for attempt := 0; attempt <= clientcfg.MaxRetries; attempt++ {
+		if attempt > 0 {
+			select {
+			case <-req.Context().Done():
+				return req.Context().Err()
+			case <-time.After(clientcfg.RetryInterval):
+			}
+
+			if req.GetBody != nil {
+				body, err := req.GetBody()
+				if err != nil {
+					return err
+				}
+				req.Body = body
+			}
+		}
+
+		retry, err := c.do(req, v)
+		if err == nil {
+			return nil
+		}
+		lastErr = err
+		if !retry {
+			return err
+		}
+		c.logger.WithError(err).WithField("attempt", attempt+1).Debug("Retrying the k6 Cloud request")
+	}
+
+	return lastErr
+}
+
+// do performs a single attempt. It reports whether the failure is worth
+// retrying.
+func (c *HTTPClient) do(req *http.Request, v any) (bool, error) {
+	resp, err := c.client.Do(req)
+	if err != nil {
+		// A cancelled or expired context is final: retrying would only fail
+		// the same way.
+		if req.Context().Err() != nil {
+			return false, err
+		}
+		return true, err
+	}
+	defer func() {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+	}()
+
+	if resp.StatusCode < 200 || resp.StatusCode > 299 {
+		retry := resp.StatusCode >= 500 || resp.StatusCode == http.StatusTooManyRequests
+		return retry, CheckResponse(resp)
+	}
+
+	if v == nil {
+		return false, nil
+	}
+	if err := json.NewDecoder(resp.Body).Decode(v); err != nil {
+		return false, err
+	}
+	return false, nil
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..774d2249b
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,51 @@
+package provisioning
+
+import (
+	"errors"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+// k6 Cloud error codes reported when a locally executed script stops early.
+const (
+	notifyCodeTimeoutOrOutput int32 = 8034
+	notifyCodeScriptError     int32 = 8035
+	notifyCodeAborted         int32 = 8036
+)
+
+// notifyError is the error payload of a script_execution_completed event.
+type notifyError struct {
+	Code   int32  `json:"code"`
+	Reason string `json:"reason"`
+}
+
+// mapTestErrorToNotifyCode maps how k6 stopped onto the k6 Cloud error code
+// reported at the end of a locally executed test run. It returns nil when the
+// run completed cleanly, including the case where thresholds only failed after
+// the test had already ended.
+func mapTestErrorToNotifyCode(testErr error) *notifyError {
+	if testErr == nil {
+		return nil
+	}
+
+	code := int32(0)
+
+	var hasReason errext.HasAbortReason
+	if errors.As(testErr, &hasReason) {
+		switch hasReason.AbortReason() {
+		case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+			code = notifyCodeAborted
+		case errext.AbortedByScriptError:
+			code = notifyCodeScriptError
+		case errext.AbortedByOutput, errext.AbortedByTimeout:
+			code = notifyCodeTimeoutOrOutput
+		case errext.AbortedByThresholdsAfterTestEnd:
+			// The test run itself finished normally: k6 only returns an error
+			// because the thresholds failed once the test had ended, which the
+			// cloud tracks separately from the run status.
+			return nil
+		}
+	}
+
+	return &notifyError{Code: code, Reason: testErr.Error()}
+}
diff --git a/internal/cloudapi/provisioning/provision.go b/internal/cloudapi/provisioning/provision.go
