diff --git a/internal/cloudapi/provisioning/errors.go b/internal/cloudapi/provisioning/errors.go
new file mode 100644
index 000000000..d4d582568
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,56 @@
+package provisioning
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+var errUnknown = errors.New("an error occurred communicating with k6 Cloud")
+
+// ResponseError is an HTTP error returned by the k6 Cloud provisioning API or by
+// an object storage presigned upload URL.
+type ResponseError struct {
+	// StatusCode is the HTTP status code of the response.
+	StatusCode int
+	// Body is the raw response body, kept verbatim because the provisioning
+	// API and object storage services use different error encodings.
+	Body string
+
+	// classified is the 401/403 classification, if any, so callers can use
+	// errors.Is with httperr.ErrNotAuthenticated / httperr.ErrNotAuthorized.
+	classified error
+}
+
+func (e *ResponseError) Error() string {
+	return fmt.Sprintf("(%d) %s", e.StatusCode, e.Body)
+}
+
+func (e *ResponseError) Unwrap() error {
+	return e.classified
+}
+
+// newResponseError builds a ResponseError, classifying 401 and 403 the same way
+// the v6 client does.
+func newResponseError(statusCode int, body string) *ResponseError {
+	return &ResponseError{StatusCode: statusCode, Body: body, classified: httperr.ClassifyStatus(statusCode)}
+}
+
+// CheckResponse returns nil when the response status is in the 2xx range,
+// otherwise it drains the body and returns a *ResponseError.
+func CheckResponse(r *http.Response) error {
+	if r == nil {
+		return errUnknown
+	}
+	if c := r.StatusCode; c >= 200 && c <= 299 {
+		return nil
+	}
+	data, err := io.ReadAll(r.Body)
+	if err != nil {
+		return err
+	}
+	return newResponseError(r.StatusCode, string(data))
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..3bcd05bf7
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,113 @@
+package provisioning
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient is a small JSON-over-HTTP client for the k6 Cloud endpoints that
+// are authenticated with a test-run-scoped bearer token. It retries server-side
+// failures with the shared retry settings and never retries 4xx.
+type HTTPClient struct {
+	client  *http.Client
+	token   string
+	version string
+	logger  logrus.FieldLogger
+}
+
+// NewHTTPClient returns an HTTPClient using the given http.Client. When token is
+// empty no Authorization header is sent, which is what presigned object storage
+// URLs require.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	return &HTTPClient{
+		client:  client,
+		token:   token,
+		version: version,
+		logger:  logger,
+	}
+}
+
+// Do executes req, retrying transport errors, 429 and 5xx responses. When v is
+// non-nil and the request succeeds, the response body is JSON-decoded into it.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	if req.Header == nil {
+		req.Header = make(http.Header)
+	}
+
+	req.Header.Set("User-Agent", "k6cloud/"+c.version)
+	if c.token != "" {
+		req.Header.Set("Authorization", "Bearer "+c.token)
+	}
+	if req.Header.Get("Content-Type") == "" {
+		req.Header.Set("Content-Type", "application/json")
+	}
+
+	var (
+		resp *http.Response
+		err  error
+	)
+
+	for attempt := 0; attempt <= clientcfg.MaxRetries; attempt++ {
+		if attempt > 0 && req.GetBody != nil {
+			var bErr error
+			req.Body, bErr = req.GetBody()
+			if bErr != nil {
+				return fmt.Errorf("resetting request body: %w", bErr)
+			}
+		}
+
+		resp, err = c.client.Do(req)
+
+		retryable := err != nil || (resp != nil && (resp.StatusCode >= 500 || resp.StatusCode == http.StatusTooManyRequests))
+		if retryable && attempt < clientcfg.MaxRetries {
+			if resp != nil {
+				_, _ = io.Copy(io.Discard, resp.Body)
+				_ = resp.Body.Close()
+			}
+
+			if c.logger != nil {
+				c.logger.Debugf("retrying cloud request (attempt %d/%d)", attempt+1, clientcfg.MaxRetries)
+			}
+
+			timer := time.NewTimer(clientcfg.RetryInterval)
+			select {
+			case <-req.Context().Done():
+				timer.Stop()
+				return req.Context().Err()
+			case <-timer.C:
+				timer.Stop()
+			}
+			continue
+		}
+
+		break
+	}
+
+	if err != nil {
+		return fmt.Errorf("cloud request failed: %w", err)
+	}
+
+	defer func() {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+	}()
+
+	if err := CheckResponse(resp); err != nil {
+		return err
+	}
+
+	if v != nil {
+		if err := json.NewDecoder(resp.Body).Decode(v); err != nil {
+			return fmt.Errorf("decoding response body: %w", err)
+		}
+	}
+
+	return nil
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..686d46fef
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,67 @@
+package provisioning
+
+import (
+	"context"
+	"errors"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+// k6 Cloud error codes reported at the end of a locally executed test run.
+const (
+	notifyCodeTimeoutOrOutput int32 = 8034
+	notifyCodeScriptError     int32 = 8035
+	notifyCodeAborted         int32 = 8036
+)
+
+// scriptExecutionCompletedEvent is the event type reported when the local script execution finished.
+const scriptExecutionCompletedEvent = "script_execution_completed"
+
+// notifyError is the error payload of an end-of-test notification.
+type notifyError struct {
+	Code   int32
+	Reason string
+}
+
+// mapTestErrorToNotifyCode maps how k6 stopped to the cloud error code reported
+// at the end of the test. It returns nil when the test finished cleanly,
+// including when thresholds only failed after the test ended.
+func mapTestErrorToNotifyCode(testErr error) *notifyError {
+	if testErr == nil {
+		return nil
+	}
+
+	var hasReason errext.HasAbortReason
+	if errors.As(testErr, &hasReason) {
+		switch hasReason.AbortReason() {
+		case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+			return &notifyError{Code: notifyCodeAborted, Reason: testErr.Error()}
+		case errext.AbortedByScriptError:
+			return &notifyError{Code: notifyCodeScriptError, Reason: testErr.Error()}
+		case errext.AbortedByOutput, errext.AbortedByTimeout:
+			return &notifyError{Code: notifyCodeTimeoutOrOutput, Reason: testErr.Error()}
+		case errext.AbortedByThresholdsAfterTestEnd:
+			return nil
+		default:
+			return &notifyError{Code: 0, Reason: testErr.Error()}
+		}
+	}
+
+	return &notifyError{Code: 0, Reason: testErr.Error()}
+}
+
+// NotifyTestRunCompleted reports the end of the locally executed script to the
+// cloud. It authenticates with the test-run-scoped token rather than the
+// long-lived user token.
+func (c *Client) NotifyTestRunCompleted(ctx context.Context, testRunID int64, token string, testErr error) (err error) {
+	model := k6cloud.NewScriptExecutionCompletedNotificationApiModel(scriptExecutionCompletedEvent)
+	if ne := mapTestErrorToNotifyCode(testErr); ne != nil {
+		model.SetError(*k6cloud.NewScriptExecutionError(ne.Code, ne.Reason))
+	}
+	hr, err := c.apiClient.ProvisioningAPI.TestRunsNotify(authCtx(ctx, token), testRunID).
+		ScriptExecutionCompletedNotificationApiModel(model).Execute()
+	defer closeResponse(hr, &err)
+	return checkAPIResponse(hr, err)
+}
diff --git a/internal/cloudapi/provisioning/provision.go b/internal/cloudapi/provisioning/provision.go
new file mode 100644
index 000000000..d87ad7467
--- /dev/null
+++ b/internal/cloudapi/provisioning/provision.go
@@ -0,0 +1,79 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"go.k6.io/k6/v2/lib"
+)
+
+// ProvisionParams are the inputs needed to provision a locally executed test run.
+type ProvisionParams struct {
+	Name          string
+	ProjectID     int64
+	MaxVUs        int32
+	TotalDuration int32
+	// Options is the resolved lib.Options of the test, as JSON.
+	Options json.RawMessage
+	// Archive is the test archive to upload. Nil skips the upload.
+	Archive *lib.Archive
+	// PollInterval is how often the test run status is polled while waiting for the cloud to be ready.
+	PollInterval time.Duration
+}
+
+// ProvisionResult is everything the caller needs to run the test locally and stream its results to the cloud.
+type ProvisionResult struct {
+	TestRunID             int64
+	TestRunDetailsPageURL string
+	RuntimeConfig         RuntimeConfig
+}
+
+// ProvisionLocalExecution creates or finds the load test, starts a local
+// execution test run, uploads the archive when there is one and waits until the
+// cloud is ready for the test to start.
+func (c *Client) ProvisionLocalExecution(ctx context.Context, params ProvisionParams) (*ProvisionResult, error) {
+	var archive []byte
+	if params.Archive != nil {
+		var buf bytes.Buffer
+		if err := params.Archive.Write(&buf); err != nil {
+			return nil, fmt.Errorf("serialize archive: %w", err)
+		}
+		archive = buf.Bytes()
+	}
+
+	loadTestID, err := c.v6Client.CreateOrFindLoadTest(ctx, params.ProjectID, params.Name)
+	if err != nil {
+		return nil, fmt.Errorf("create or find load test: %w", err)
+	}
+
+	start, err := c.StartLocalExecution(ctx, loadTestID, StartLocalExecutionRequest{
+		Options:       params.Options,
+		MaxVUs:        params.MaxVUs,
