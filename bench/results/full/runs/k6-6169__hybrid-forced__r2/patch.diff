--- /dev/null
+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,138 @@
+// Package provtest provides an HTTP test server that simulates the k6 Cloud
+// provisioning API and the v6 endpoints used by local-execution provisioning.
+//
+// It keeps SDK-specific encoding (nullable fields, runtime config models) out
+// of the tests that use it.
+package provtest
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	// DefaultLoadTestID is the load test id served by default.
+	DefaultLoadTestID int64 = 456
+	// DefaultTestRunID is the test run id served by default.
+	DefaultTestRunID int64 = 123
+	// PresignedUploadPath is the path the fake presigned archive upload is served on.
+	PresignedUploadPath = "/presigned-upload/archive.tar"
+)
+
+// Server is a test HTTP server for the k6 Cloud provisioning API.
+type Server struct {
+	*httptest.Server
+	// Mux is the request multiplexer, exposed so tests can register extra handlers.
+	Mux *http.ServeMux
+
+	fetchTestRunHits atomic.Int32
+}
+
+// NewServer creates a test server that serves provisioning API endpoints.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+	mux := http.NewServeMux()
+	srv := httptest.NewServer(mux)
+	t.Cleanup(srv.Close)
+	return &Server{Server: srv, Mux: mux}
+}
+
+// HandleCreateLoadTest registers a handler for creating or listing load tests for a project.
+func (s *Server) HandleCreateLoadTest(projectID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID), h)
+}
+
+// HandleStartLocalExecution registers a handler for starting local execution of a load test.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("POST /provisioning/v1/load_tests/%d/start_local_execution", loadTestID), h)
+}
+
+// HandleNotify registers a handler for notifying test run events.
+func (s *Server) HandleNotify(testRunID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("POST /provisioning/v1/test_runs/%d/notify", testRunID), h)
+}
+
+// HandlePresignedUpload registers a handler for the presigned archive upload endpoint.
+func (s *Server) HandlePresignedUpload(path string, h http.HandlerFunc) {
+	s.Mux.HandleFunc(path, h)
+}
+
+// PresignedUploadURL returns the full URL to the fake presigned upload endpoint.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// HandleFetchTestRun registers a handler for GET /cloud/v6/test_runs/{testRunID}.
+func (s *Server) HandleFetchTestRun(testRunID int64, progresses []v6.TestProgress) {
+	s.Mux.HandleFunc(fmt.Sprintf("GET /cloud/v6/test_runs/%d", testRunID), func(w http.ResponseWriter, _ *http.Request) {
+		n := int(s.fetchTestRunHits.Add(1)) - 1
+		var tp v6.TestProgress
+		if len(progresses) > 0 {
+			if n >= len(progresses) {
+				n = len(progresses) - 1
+			}
+			tp = progresses[n]
+		}
+		res := k6cloud.NewTestRunApiModelWithDefaults()
+		res.SetStatus(tp.Status.String())
+		res.SetResult(tp.Result.String())
+		res.SetEstimatedDuration(tp.EstimatedDuration)
+		res.SetExecutionDuration(tp.ExecutionDuration)
+		res.SetStatusHistory(v6.ToStatusModel(tp.StatusHistory))
+		res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+		res.SetResultDetails(k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(k6cloud.NewResultDetailsApiModel("")))
+		res.SetOptions(map[string]any{})
+		writeJSON(w, http.StatusOK, res)
+	})
+}
+
+// FetchTestRunHitCount returns the number of times the fetch test run handler was hit.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchTestRunHits.Load()
+}
+
+// DefaultStartLocalExecutionResponse returns a default StartLocalExecutionTestResponse with all fields populated.
+func DefaultStartLocalExecutionResponse() *k6cloud.StartLocalExecutionTestResponse {
+	pushInterval := "2s"
+	pushConcurrency := int32(5)
+	aggPeriod := "3s"
+	aggWaitPeriod := "1s"
+	aggMinSamples := int32(25)
+	maxSamplesPerPackage := int32(2000)
+
+	metrics := k6cloud.NewMetricsRuntimeConfig(
+		"https://ingest.k6.io/v1/metrics",
+		*k6cloud.NewNullableString(&pushInterval),
+		*k6cloud.NewNullableInt32(&pushConcurrency),
+		*k6cloud.NewNullableString(&aggPeriod),
+		*k6cloud.NewNullableString(&aggWaitPeriod),
+		*k6cloud.NewNullableInt32(&aggMinSamples),
+		*k6cloud.NewNullableInt32(&maxSamplesPerPackage),
+	)
+	traces := k6cloud.NewTracesRuntimeConfig("https://ingest.k6.io/v1/traces", map[string]string{}, "grpc")
+	files := k6cloud.NewFilesRuntimeConfig("https://ingest.k6.io/v1/files", "/screenshots", map[string]string{}, "PUT")
+	logs := k6cloud.NewLogsRuntimeConfig("https://ingest.k6.io/v1/logs", "wss://cloudlogs.k6.io/api/v1/tail", 100, "1", "info", 1024, []string{})
+	secrets := k6cloud.NewSecretsRuntimeConfig(
+		fmt.Sprintf("https://api.k6.io/provisioning/v1/test_runs/%d/decrypt_secret?name={key}", DefaultTestRunID),
+		"plaintext",
+	)
+	rc := k6cloud.NewRuntimeConfig(*metrics, *traces, *files, *logs, *secrets, "test-run-token-abc")
+	uploadURL := fmt.Sprintf("https://s3.amazonaws.com/k6-archives/%d/archive.tar?X-Amz-Signature=fake", DefaultTestRunID)
+	return k6cloud.NewStartLocalExecutionTestResponse(DefaultTestRunID, *rc, *k6cloud.NewNullableString(&uploadURL), fmt.Sprintf("https://app.k6.io/runs/%d", DefaultTestRunID))
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	if err := json.NewEncoder(w).Encode(v); err != nil {
+		panic(fmt.Errorf("provtest: encoding JSON: %w", err))
+	}
+}
