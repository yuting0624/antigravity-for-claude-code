--- /dev/null
+++ b/internal/cloudapi/clientcfg/clientcfg.go
@@ -0,0 +1,12 @@
+// Package clientcfg holds the HTTP client tuning values shared by k6 Cloud's
+// API clients (internal/cloudapi/v6, internal/cloudapi/provisioning).
+package clientcfg
+
+import "time"
+
+const (
+	// RetryInterval is the default cloud request retry interval.
+	RetryInterval = 500 * time.Millisecond
+	// MaxRetries specifies max retry attempts.
+	MaxRetries = 3
+)
diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..e089c72dd
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,204 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// MetricsConfig contains configuration for pushing metrics to k6 Cloud.
+type MetricsConfig struct {
+	PushURL               string
+	PushInterval          *string
+	PushConcurrency       *int32
+	AggregationPeriod     *string
+	AggregationWaitPeriod *string
+	AggregationMinSamples *int32
+	MaxSamplesPerPackage  *int32
+}
+
+// SecretsConfig contains settings for decrypting secrets during test execution.
+type SecretsConfig struct {
+	Endpoint     string
+	ResponsePath string
+}
+
+// RuntimeConfig contains runtime execution settings for a test run.
+type RuntimeConfig struct {
+	Metrics      MetricsConfig
+	Secrets      SecretsConfig
+	TestRunToken string
+}
+
+// StartLocalExecutionRequest contains parameters for starting a local execution run.
+type StartLocalExecutionRequest struct {
+	Options       json.RawMessage
+	MaxVUs        int32
+	TotalDuration int32
+	ArchiveSize   int64
+}
+
+// StartLocalExecutionResponse contains the response from starting a local execution run.
+type StartLocalExecutionResponse struct {
+	TestRunID             int64
+	ArchiveUploadURL      *string
+	TestRunDetailsPageURL string
+	RuntimeConfig         RuntimeConfig
+}
+
+// StartLocalExecution starts a cloud-provisioned local execution test run.
+func (c *Client) StartLocalExecution(ctx context.Context, loadTestID int64, req StartLocalExecutionRequest) (_ *StartLocalExecutionResponse, err error) {
+	opts := map[string]any{}
+	if len(req.Options) > 0 {
+		if err := json.Unmarshal(req.Options, &opts); err != nil {
+			return nil, err
+		}
+	}
+
+	body := k6cloud.NewStartLocalExecutionTestRequest(opts, req.MaxVUs, req.TotalDuration)
+	if req.ArchiveSize > 0 {
+		if req.ArchiveSize > math.MaxInt32 {
+			return nil, fmt.Errorf("archive size %d overflows int32", req.ArchiveSize)
+		}
+		body.SetArchiveSize(int32(req.ArchiveSize))
+	} else {
+		body.SetArchiveSizeNil()
+	}
+
+	var key [8]byte
+	if _, err := rand.Read(key[:]); err != nil {
+		return nil, err
+	}
+
+	res, hr, err := c.apiClient.ProvisioningAPI.
+		StartLocalExecutionTest(authCtx(ctx, c.token), loadTestID).
+		K6IdempotencyKey(hex.EncodeToString(key[:])).
+		StartLocalExecutionTestRequest(body).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if err := checkAPIResponse(hr, err); err != nil {
+		return nil, err
+	}
+	if res == nil {
+		return nil, errUnknown
+	}
+
+	out := &StartLocalExecutionResponse{
+		TestRunID:             res.GetTestRunId(),
+		TestRunDetailsPageURL: res.GetTestRunDetailsPageUrl(),
+		RuntimeConfig:         runtimeConfigFromAPI(res.GetRuntimeConfig()),
+	}
+	if u, ok := res.GetArchiveUploadUrlOk(); ok && u != nil {
+		cp := *u
+		out.ArchiveUploadURL = &cp
+	}
+
+	return out, nil
+}
+
+func runtimeConfigFromAPI(rc k6cloud.RuntimeConfig) RuntimeConfig {
+	secrets := rc.GetSecrets()
+	m := rc.GetMetrics()
+
+	out := MetricsConfig{
+		PushURL: m.GetPushUrl(),
+	}
+	if v, ok := m.GetPushIntervalOk(); ok && v != nil {
+		cp := *v
+		out.PushInterval = &cp
+	}
+	if v, ok := m.GetPushConcurrencyOk(); ok && v != nil {
+		cp := *v
+		out.PushConcurrency = &cp
+	}
+	if v, ok := m.GetAggregationPeriodOk(); ok && v != nil {
+		cp := *v
+		out.AggregationPeriod = &cp
+	}
+	if v, ok := m.GetAggregationWaitPeriodOk(); ok && v != nil {
+		cp := *v
+		out.AggregationWaitPeriod = &cp
+	}
+	if v, ok := m.GetAggregationMinSamplesOk(); ok && v != nil {
+		cp := *v
+		out.AggregationMinSamples = &cp
+	}
+	if v, ok := m.GetMaxSamplesPerPackageOk(); ok && v != nil {
+		cp := *v
+		out.MaxSamplesPerPackage = &cp
+	}
+
+	return RuntimeConfig{
+		Metrics: out,
+		Secrets: SecretsConfig{
+			Endpoint:     secrets.GetEndpoint(),
+			ResponsePath: secrets.GetResponsePath(),
+		},
+		TestRunToken: rc.GetTestRunToken(),
+	}
+}
+
+// UploadArchive uploads a test archive to the given presigned object storage URL.
+func (c *Client) UploadArchive(ctx context.Context, url string, archive []byte) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPut, url, bytes.NewReader(archive))
+	if err != nil {
+		return fmt.Errorf("creating upload request: %w", err)
+	}
+
+	req.Header.Set("Content-Type", "application/x-tar")
+	req.ContentLength = int64(len(archive))
+
+	return c.uploadClient.Do(req, nil)
+}
+
+// WaitForTestRunReady polls the cloud test run until it reaches the initializing or running state.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	if pollInterval <= 0 {
+		pollInterval = time.Second
+	}
+
+	var lastLogged v6.Status
+	for {
+		tp, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			return err
+		}
+
+		switch tp.Status {
+		case v6.StatusInitializing, v6.StatusRunning:
+			return nil
+		case v6.StatusAborted:
+			for _, e := range tp.StatusHistory {
+				if e.Status == v6.StatusAborted && e.Message != "" {
+					return fmt.Errorf("test run aborted before starting: %s", e.Message)
+				}
+			}
+			return errors.New("test run aborted before starting")
+		case v6.StatusCompleted:
+			return errors.New("test run completed before the local execution could start")
+		default:
+			if tp.Status != lastLogged {
+				lastLogged = tp.Status
+				c.logger.WithField("status", tp.FormatStatus()).Info("Waiting for the cloud test run to be ready")
+			}
+		}
+
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(pollInterval):
+		}
+	}
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..6c6eb4d2c
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,103 @@
+package provisioning
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client handles communication with the k6 Cloud provisioning API.
+type Client struct {
+	apiClient *k6cloud.APIClient
+	v6Client  *v6.Client
+	// uploadClient performs unauthenticated PUTs to presigned object storage URLs.
+	uploadClient *HTTPClient
+	token        string
+	stackID      int64
+	version      string
+	logger       logrus.FieldLogger
+}
+
+// NewClient returns a new client for the cloud provisioning API.
+func NewClient(logger logrus.FieldLogger, token, host, version string, stackID int64, timeout time.Duration) (*Client, error) {
+	if token == "" {
+		return nil, fmt.Errorf("token is required to create cloud API client")
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Global k6 Cloud API.",
+		},
+	}
+
+	httpClient := &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+	cfg.HTTPClient = httpClient
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+
+	// The provisioning endpoints take the stack ID as a plain header so it is
+	// set once instead of per request.
+	cfg.AddDefaultHeader("X-Stack-Id", strconv.FormatInt(stackID, 10))
+
+	v6Client, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if err := v6Client.SetStackID(stackID); err != nil {
+		return nil, err
+	}
+
+	return &Client{
+		apiClient:    k6cloud.NewAPIClient(cfg),
+		v6Client:     v6Client,
+		uploadClient: NewHTTPClient(httpClient, "", version, logger),
+		token:        token,
+		stackID:      stackID,
+		version:      version,
+		logger:       logger,
+	}, nil
+}
+
+// authCtx returns a context carrying the given bearer token for the SDK.
+func authCtx(ctx context.Context, token string) context.Context {
+	return context.WithValue(ctx, k6cloud.ContextAccessToken, token)
+}
+
+// checkAPIResponse converts an SDK call result into a *ResponseError.
+func checkAPIResponse(hr *http.Response, err error) error {
+	if err == nil {
+		return nil
+	}
+	var aerr *k6cloud.GenericOpenAPIError
+	if errors.As(err, &aerr) && hr != nil {
+		return newResponseError(hr.StatusCode, string(aerr.Body()))
+	}
+	return err
+}
+
+// closeResponse drains and closes an SDK response body.
+func closeResponse(res *http.Response, rerr *error) {
+	if res == nil {
+		return
+	}
+	_, _ = io.Copy(io.Discard, res.Body)
+	if err := res.Body.Close(); err != nil && *rerr == nil {
+		*rerr = err
+	}
+}
