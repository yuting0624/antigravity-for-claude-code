+// buildConfigFromRuntimeConfig translates the runtime configuration returned by
+// the provisioning API into the cloud output's configuration overrides. Fields
+// the cloud output does not support are intentionally dropped.
+func buildConfigFromRuntimeConfig(logger logrus.FieldLogger, rc provisioning.RuntimeConfig) cloudapi.Config {
+	var cfg cloudapi.Config
+
+	cfg.MetricPushInterval = nullDurationFromAPI(logger, "push_interval", rc.Metrics.PushInterval)
+	cfg.AggregationPeriod = nullDurationFromAPI(logger, "aggregation_period", rc.Metrics.AggregationPeriod)
+	cfg.AggregationWaitPeriod = nullDurationFromAPI(logger, "aggregation_wait_period", rc.Metrics.AggregationWaitPeriod)
+
+	if rc.Metrics.PushConcurrency != nil {
+		cfg.MetricPushConcurrency = null.IntFrom(int64(*rc.Metrics.PushConcurrency))
+	}
+	if rc.Metrics.MaxSamplesPerPackage != nil {
+		cfg.MaxTimeSeriesInBatch = null.IntFrom(int64(*rc.Metrics.MaxSamplesPerPackage))
+	}
+
+	// rc.Metrics.AggregationMinSamples is deliberately ignored: the cloud output has
+	// no equivalent setting.
+
+	return cfg
+}
+
+func nullDurationFromAPI(logger logrus.FieldLogger, field string, raw *string) types.NullDuration {
+	if raw == nil {
+		return types.NullDuration{}
+	}
+	d, err := time.ParseDuration(*raw)
+	if err != nil {
+		logger.WithFields(logrus.Fields{"field": field, "value": *raw}).
+			WithError(err).Warn("Ignoring an invalid duration in the cloud runtime configuration")
+		return types.NullDuration{}
+	}
+	return types.NewNullDuration(d, true)
+}
