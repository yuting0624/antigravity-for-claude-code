diff --git a/internal/attachments/attach.go b/internal/attachments/attach.go
new file mode 100644
index 000000000..f760e6297
--- /dev/null
+++ b/internal/attachments/attach.go
@@ -0,0 +1,81 @@
+package attachments
+
+import (
+	"context"
+	"errors"
+	"strings"
+)
+
+func appendParagraph(markdown, addition string) string {
+	if addition == "" {
+		return markdown
+	}
+	if strings.TrimSpace(markdown) == "" {
+		return addition
+	}
+	trimmed := strings.TrimRight(markdown, " \t\r\n")
+	return trimmed + "\n\n" + addition
+}
+
+func (u *Uploader) UploadAndAttach(ctx context.Context, body string, assets []UserAsset) (string, int, error) {
+	if len(assets) == 0 {
+		return body, 0, nil
+	}
+
+	args := make([]attachmentArg, len(assets))
+	for i, a := range assets {
+		args[i] = attachmentArg{
+			Path:            a.Path(),
+			Alt:             a.getAsset().alt,
+			RendersAsPlayer: a.rendersAsPlayer(),
+		}
+	}
+
+	attachable, err := newAttachableMarkdown(body, args)
+	if err != nil {
+		return body, 0, err
+	}
+
+	var uploadedCount int
+	var uploadErr error
+	for i, a := range assets {
+		assetURL, err := u.upload(ctx, a)
+		if err != nil {
+			uploadErr = err
+			break
+		}
+		args[i].URL = assetURL
+		uploadedCount++
+	}
+
+	attachable.args = args
+	res, attachErr := attachAssetsToMarkdown(attachable)
+	if attachErr != nil && uploadErr == nil {
+		uploadErr = attachErr
+	}
+
+	body = res.Rewritten
+	assetByPath := make(map[string]UserAsset, len(assets))
+	for _, a := range assets {
+		assetByPath[a.Path()] = a
+	}
+	for _, arg := range res.ToAppend {
+		if a, ok := assetByPath[arg.Path]; ok {
+			body = appendParagraph(body, a.markdown(arg.URL))
+		}
+	}
+
+	if uploadErr != nil {
+		errMsg := uploadErr.Error()
+		for _, arg := range args {
+			if arg.URL != "" && strings.Contains(errMsg, arg.URL) {
+				errMsg = strings.ReplaceAll(errMsg, arg.URL, "")
+			}
+		}
+		if errMsg != uploadErr.Error() {
+			uploadErr = errors.New(errMsg)
+		}
+	}
+
+	return body, uploadedCount, uploadErr
+}
diff --git a/internal/attachments/client.go b/internal/attachments/client.go
new file mode 100644
index 000000000..c0ae412fa
--- /dev/null
+++ b/internal/attachments/client.go
@@ -0,0 +1,231 @@
+package attachments
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+
+	"github.com/cli/cli/v2/api"
+	"github.com/cli/cli/v2/internal/gh"
+	"github.com/cli/cli/v2/internal/ghinstance"
+	ghauth "github.com/cli/go-gh/v2/pkg/auth"
+)
+
+type Uploader struct {
+	httpClient       *http.Client
+	host             string
+	targetRepository int64
+}
+
+type uploadError struct {
+	Path       string
+	StatusCode int
+	Err        error
+}
+
+func (e *uploadError) Error() string {
+	if e.Err == nil {
+		return ""
+	}
+	return strings.ReplaceAll(e.Err.Error(), "\n", " ")
+}
+
+func (e *uploadError) Unwrap() error {
+	return e.Err
+}
+
+func checkHost(host string) error {
+	if strings.EqualFold(host, "github.com") || strings.EqualFold(host, "github.localhost") || ghauth.IsTenancy(host) {
+		return nil
+	}
+	return errors.New("attaching files is not supported on GitHub Enterprise Server")
+}
+
+func NewUploader(httpClient *http.Client, tokenType gh.TokenType, host string, targetRepository int64, viewerPermission string) (*Uploader, error) {
+	if err := checkHost(host); err != nil {
+		return nil, err
+	}
+
+	switch tokenType {
+	case gh.TokenTypeOAuth, gh.TokenTypePersonalAccess, gh.TokenTypeFineGrainedPAT:
+	default:
+		return nil, errors.New("unsupported authentication type")
+	}
+
+	if targetRepository <= 0 {
+		return nil, errors.New("could not determine which repository to attach files to")
+	}
+
+	if viewerPermission == "" {
+		return nil, errors.New("could not determine your permission on the repository to attach files")
+	}
+
+	switch viewerPermission {
+	case "ADMIN", "MAINTAIN", "WRITE":
+	default:
+		return nil, errors.New("attaching files requires write access to the repository")
+	}
+
+	return &Uploader{
+		httpClient:       httpClient,
+		host:             host,
+		targetRepository: targetRepository,
+	}, nil
+}
+
+func (u *Uploader) upload(ctx context.Context, a UserAsset) (string, error) {
+	fileBody, err := openFile(a.Path())
+	if err != nil {
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			Err:        fmt.Errorf("failed to upload %s: %w", a.Path(), err),
+		}
+	}
+	defer fileBody.Close()
+
+	q := url.Values{
+		"content_type":  {a.getAsset().contentType},
+		"name":          {a.getAsset().info.Name()},
+		"repository_id": {strconv.FormatInt(u.targetRepository, 10)},
+	}
+
+	endpoint := ghinstance.UserAssetUploadPrefix(u.host) + "user-attachments/assets?" + q.Encode()
+
+	req, err := http.NewRequestWithContext(ctx, "POST", endpoint, fileBody)
+	if err != nil {
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			Err:        fmt.Errorf("failed to upload %s: %w", a.Path(), err),
+		}
+	}
+
+	req.Header.Set("Content-Type", "application/octet-stream")
+	req.Header.Set("Accept", "application/vnd.github+json")
+	req.ContentLength = a.getAsset().info.Size()
+
+	resp, err := u.httpClient.Do(req)
+	if err != nil {
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			Err:        fmt.Errorf("failed to upload %s: %w", a.Path(), err),
+		}
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode == http.StatusNotFound {
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: http.StatusNotFound,
+			Err:        fmt.Errorf("could not upload %s: attaching files requires write access to the repository", a.Path()),
+		}
+	}
+
+	if resp.StatusCode == 422 {
+		bodyBytes, _ := io.ReadAll(resp.Body)
+		var errResp struct {
+			Message string `json:"message"`
+			Errors  []struct {
+				Resource string `json:"resource"`
+				Field    string `json:"field"`
+				Code     string `json:"code"`
+				Message  string `json:"message"`
+			} `json:"errors"`
+		}
+		var parts []string
+		if err := json.Unmarshal(bodyBytes, &errResp); err == nil {
+			if errResp.Message != "" {
+				parts = append(parts, errResp.Message)
+			}
+			for _, item := range errResp.Errors {
+				if item.Message != "" {
+					parts = append(parts, item.Message)
+				} else if item.Code != "" {
+					if item.Resource != "" && item.Field != "" {
+						parts = append(parts, fmt.Sprintf("%s.%s is %s", item.Resource, item.Field, item.Code))
+					} else if item.Field != "" {
+						parts = append(parts, fmt.Sprintf("%s is %s", item.Field, item.Code))
+					} else {
+						parts = append(parts, item.Code)
+					}
+				}
+			}
+		}
+		var msg string
+		if len(parts) > 0 {
+			msg = fmt.Sprintf("could not upload %s: %s", a.Path(), strings.Join(parts, "; "))
+		} else {
+			msg = fmt.Sprintf("could not upload %s", a.Path())
+		}
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 422,
+			Err:        errors.New(msg),
+		}
+	}
+
+	if resp.StatusCode == 429 {
+		retryAfter := resp.Header.Get("Retry-After")
+		var msg string
+		if retryAfter == "" {
+			msg = fmt.Sprintf("could not upload %s: rate limited; wait and try again", a.Path())
+		} else if _, err := strconv.Atoi(retryAfter); err == nil {
+			msg = fmt.Sprintf("could not upload %s: rate limited; retry after %s seconds", a.Path(), retryAfter)
+		} else {
+			msg = fmt.Sprintf("could not upload %s: rate limited; retry after %s", a.Path(), retryAfter)
+		}
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 429,
+			Err:        errors.New(msg),
+		}
+	}
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		apiErr := api.HandleHTTPError(resp)
+		cleanMsg := strings.ReplaceAll(apiErr.Error(), "\n", " ")
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: resp.StatusCode,
+			Err:        fmt.Errorf("failed to upload %s: %s", a.Path(), cleanMsg),
+		}
+	}
+
+	bodyBytes, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			Err:        fmt.Errorf("failed to upload %s: %w", a.Path(), err),
+		}
+	}
+
+	var successResp struct {
+		URL string `json:"url"`
+	}
+	if err := json.Unmarshal(bodyBytes, &successResp); err != nil {
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			Err:        fmt.Errorf("failed to upload %s: %w", a.Path(), err),
+		}
+	}
+
+	if successResp.URL == "" {
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			Err:        fmt.Errorf("failed to upload %s: the server returned no asset URL", a.Path()),
+		}
+	}
+
+	return successResp.URL, nil
+}
diff --git a/internal/attachments/flags.go b/internal/attachments/flags.go
new file mode 100644
index 000000000..9cab2a2b7
--- /dev/null
+++ b/internal/attachments/flags.go
@@ -0,0 +1,86 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+)
+
+const flagName = "attach"
+
+type Flag struct {
+	flag *pflag.Flag
+}
+
+func AddFlag(cmd *cobra.Command) *Flag {
+	cmd.Flags().StringArray(flagName, []string{}, "Attach an image or video `file`, in '<file>#<image alt text>' format")
+	return &Flag{flag: cmd.Flags().Lookup(flagName)}
+}
+
+func (f *Flag) Changed() bool {
+	return f.flag != nil && f.flag.Changed
+}
+
+func splitPathAndAlt(raw string) (string, string) {
+	if _, err := os.Stat(raw); err == nil {
+		return raw, ""
+	}
+	curr := raw
+	for {
+		idx := strings.LastIndex(curr, "#")
+		if idx == -1 {
+			break
+		}
+		candidate := curr[:idx]
+		if _, err := os.Stat(candidate); err == nil {
+			return candidate, raw[idx+1:]
+		}
+		curr = candidate
+	}
+	if idx := strings.LastIndex(raw, "#"); idx != -1 {
+		return raw[:idx], raw[idx+1:]
+	}
+	return raw, ""
+}
+
+func (f *Flag) UserAssets() ([]UserAsset, error) {
+	if f.flag == nil {
+		return nil, nil
+	}
+	slice, ok := f.flag.Value.(pflag.SliceValue)
+	if !ok {
+		return nil, nil
+	}
+	rawArgs := slice.GetSlice()
+	if len(rawArgs) == 0 {
+		return nil, nil
+	}
+
+	var assets []UserAsset
+	for _, raw := range rawArgs {
+		if raw == "" {
+			return nil, errors.New("cannot attach an empty path; --attach needs a file path")
+		}
+		if raw == "-" {
+			return nil, errors.New("cannot attach standard input; --attach needs a file path")
+		}
+
+		path, alt := splitPathAndAlt(raw)
+		a, err := newAsset(path, alt)
+		if err != nil {
+			return nil, err
+		}
+
+		for _, prev := range assets {
+			if os.SameFile(prev.getAsset().info, a.getAsset().info) {
+				return nil, fmt.Errorf("%s and %s are the same file; attached files must be unique", prev.Path(), a.Path())
+			}
+		}
+		assets = append(assets, a)
+	}
+	return assets, nil
+}
diff --git a/internal/attachments/references.go b/internal/attachments/references.go
new file mode 100644
index 000000000..b06ffd75c
--- /dev/null
+++ b/internal/attachments/references.go
@@ -0,0 +1,955 @@
+package attachments
+
+import (
+	"errors"
+	"net/url"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/yuin/goldmark"
+	"github.com/yuin/goldmark/ast"
+	"github.com/yuin/goldmark/text"
+)
+
+type attachmentArg struct {
+	Path            string
+	URL             string
+	Alt             string
+	RendersAsPlayer bool
+}
+
+type attachableMarkdown struct {
+	markdown string
+	args     []attachmentArg
+}
+
+type attachResult struct {
+	Rewritten string
+	ToAppend  []attachmentArg
+}
+
+// scannedTail stores details of a parsed inline link or image tail.
+type scannedTail struct {
+	wholeStart         int
+	wholeEnd           int
+	destStart          int
+	destEnd            int
+	labelStart         int
+	labelEnd           int
+	dest               string
+	isImage            bool
+	isAloneInParagraph bool
+}
+
+// replacement represents a byte replacement in the markdown source.
+type replacement struct {
+	start    int
+	end      int
+	text     string
+	argIndex int
+}
+
+func unescapeMarkdownBackslashes(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\\' && i+1 < len(s) {
+			b.WriteByte(s[i+1])
+			i++
+			continue
+		}
+		b.WriteByte(s[i])
+	}
+	return b.String()
+}
+
+func newAttachableMarkdown(markdown string, args []attachmentArg) (attachableMarkdown, error) {
+	reader := text.NewReader([]byte(markdown))
+	doc := goldmark.New().Parser().Parse(reader)
+
+	var astImages []string
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if entering {
+			if img, ok := n.(*ast.Image); ok {
+				astImages = append(astImages, unescapeMarkdownBackslashes(string(img.Destination)))
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+
+	scannedTails := scanAllInlineTails(doc, []byte(markdown))
+
+	var offendingPaths []string
+	for _, arg := range args {
+		if !arg.RendersAsPlayer {
+			continue
+		}
+		astImgCount := 0
+		for _, dest := range astImages {
+			if matchDestination(dest, arg.Path) {
+				astImgCount++
+			}
+		}
+		inlineImgCount := 0
+		for _, tail := range scannedTails {
+			if tail.isImage && matchDestination(tail.dest, arg.Path) {
+				inlineImgCount++
+			}
+		}
+		if astImgCount-inlineImgCount > 0 {
+			offendingPaths = append(offendingPaths, arg.Path)
+		}
+	}
+
+	if len(offendingPaths) > 0 {
+		return attachableMarkdown{}, errors.New("cannot embed a video as a reference-style image: " + strings.Join(offendingPaths, ", "))
+	}
+
+	return attachableMarkdown{markdown: markdown, args: args}, nil
+}
+
+func attachAssetsToMarkdown(v attachableMarkdown) (attachResult, error) {
+	reader := text.NewReader([]byte(v.markdown))
+	doc := goldmark.New().Parser().Parse(reader)
+	source := []byte(v.markdown)
+
+	var astImages []string
+	var astLinks []string
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if entering {
+			if img, ok := n.(*ast.Image); ok {
+				astImages = append(astImages, unescapeMarkdownBackslashes(string(img.Destination)))
+			} else if link, ok := n.(*ast.Link); ok {
+				astLinks = append(astLinks, unescapeMarkdownBackslashes(string(link.Destination)))
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+
+	scannedTails := scanAllInlineTails(doc, source)
+
+	usedThroughRef := make([]bool, len(v.args))
+	for i, arg := range v.args {
+		if arg.URL == "" {
+			continue
+		}
+		astTotalCount := 0
+		for _, dest := range astImages {
+			if matchDestination(dest, arg.Path) {
+				astTotalCount++
+			}
+		}
+		for _, dest := range astLinks {
+			if matchDestination(dest, arg.Path) {
+				astTotalCount++
+			}
+		}
+		inlineTotalCount := 0
+		for _, tail := range scannedTails {
+			if matchDestination(tail.dest, arg.Path) {
+				inlineTotalCount++
+			}
+		}
+		if astTotalCount-inlineTotalCount > 0 {
+			usedThroughRef[i] = true
+		}
+	}
+
+	var replacements []replacement
+
+	for _, tail := range scannedTails {
+		argIdx := -1
+		for i, arg := range v.args {
+			if arg.URL == "" {
+				continue
+			}
+			if matchDestination(tail.dest, arg.Path) {
+				argIdx = i
+				break
+			}
+		}
+		if argIdx == -1 {
+			continue
+		}
+		arg := v.args[argIdx]
+
+		if !tail.isImage {
+			// Link tail: replace only the destination range.
+			replacements = append(replacements, replacement{
+				start:    tail.destStart,
+				end:      tail.destEnd,
+				text:     arg.URL,
+				argIndex: argIdx,
+			})
+		} else {
+			// Image tail
+			if !arg.RendersAsPlayer {
+				// Non-player image: replace only destination range.
+				replacements = append(replacements, replacement{
+					start:    tail.destStart,
+					end:      tail.destEnd,
+					text:     arg.URL,
+					argIndex: argIdx,
+				})
+			} else {
+				// Player arg (video)
+				if tail.isAloneInParagraph {
+					// Replace the whole node range with bare URL.
+					replacements = append(replacements, replacement{
+						start:    tail.wholeStart,
+						end:      tail.wholeEnd,
+						text:     arg.URL,
+						argIndex: argIdx,
+					})
+				} else {
+					// Degrade to link: delete '!' and replace destination.
+					bangIdx := tail.wholeStart
+					if bangIdx > 0 && source[bangIdx-1] == '!' {
+						slashes := 0
+						for k := bangIdx - 2; k >= 0 && source[k] == '\\'; k-- {
+							slashes++
+						}
+						if slashes%2 == 0 {
+							replacements = append(replacements, replacement{
+								start:    bangIdx - 1,
+								end:      bangIdx + 1,
+								text:     `\!`,
+								argIndex: argIdx,
+							})
+						} else {
+							replacements = append(replacements, replacement{
+								start:    bangIdx,
+								end:      bangIdx + 1,
+								text:     "",
+								argIndex: argIdx,
+							})
+						}
+					} else {
+						replacements = append(replacements, replacement{
+							start:    bangIdx,
+							end:      bangIdx + 1,
+							text:     "",
+							argIndex: argIdx,
+						})
+					}
+
+					if tail.labelStart == tail.labelEnd {
+						replacements = append(replacements, replacement{
+							start:    tail.labelStart,
+							end:      tail.labelEnd,
+							text:     escapeAlt(arg.Alt),
+							argIndex: argIdx,
+						})
+					}
+
+					replacements = append(replacements, replacement{
+						start:    tail.destStart,
+						end:      tail.destEnd,
+						text:     arg.URL,
+						argIndex: argIdx,
+					})
+				}
+			}
+		}
+	}
+
+	defReplacements := scanReferenceDefinitions(doc, source, v.args, usedThroughRef)
+	replacements = append(replacements, defReplacements...)
+
+	// Outer wins: drop replacements fully contained in another replacement.
+	var surviving []replacement
+	for i, a := range replacements {
+		dropped := false
+		for j, b := range replacements {
+			if i == j {
+				continue
+			}
+			if b.start <= a.start && b.end >= a.end && (b.start < a.start || b.end > a.end) {
+				dropped = true
+				break
+			}
+		}
+		if !dropped {
+			surviving = append(surviving, a)
+		}
+	}
+
+	// Apply surviving replacements right-to-left.
+	sort.Slice(surviving, func(i, j int) bool {
+		if surviving[i].start != surviving[j].start {
+			return surviving[i].start > surviving[j].start
+		}
+		return surviving[i].end > surviving[j].end
+	})
+
+	rewritten := v.markdown
+	for _, r := range surviving {
+		rewritten = rewritten[:r.start] + r.text + rewritten[r.end:]
+	}
+
+	survivingCount := make(map[int]int)
+	for _, r := range surviving {
+		if r.argIndex >= 0 {
+			survivingCount[r.argIndex]++
+		}
+	}
+
+	var toAppend []attachmentArg
+	for idx, arg := range v.args {
+		if arg.URL != "" && survivingCount[idx] == 0 {
+			toAppend = append(toAppend, arg)
+		}
+	}
+
+	return attachResult{
+		Rewritten: rewritten,
+		ToAppend:  toAppend,
+	}, nil
+}
+
+func isLocalPath(dest string) bool {
+	if dest == "" || strings.HasPrefix(dest, "#") || strings.HasPrefix(dest, "//") {
+		return false
+	}
+	colonIdx := strings.IndexByte(dest, ':')
+	if colonIdx != -1 {
+		scheme := dest[:colonIdx]
+		if len(scheme) > 1 && isValidScheme(scheme) {
+			return false
+		}
+	}
+	return true
+}
+
+func isValidScheme(s string) bool {
+	if len(s) == 0 {
+		return false
+	}
+	if !((s[0] >= 'a' && s[0] <= 'z') || (s[0] >= 'A' && s[0] <= 'Z')) {
+		return false
+	}
+	for i := 1; i < len(s); i++ {
+		c := s[i]
+		if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '+' || c == '.' || c == '-') {
+			return false
+		}
+	}
+	return true
+}
+
+func absClean(p string) (string, bool) {
+	abs, err := filepath.Abs(p)
+	if err != nil {
+		return filepath.Clean(p), false
+	}
+	return filepath.Clean(abs), true
+}
+
+func matchDestination(dest string, argPath string) bool {
+	if !isLocalPath(dest) {
+		return false
+	}
+	if dest == argPath {
+		return true
+	}
+	unescapedDest, err := url.PathUnescape(dest)
+	if err == nil && unescapedDest == argPath {
+		return true
+	}
+	absDest, ok1 := absClean(dest)
+	absArg, ok2 := absClean(argPath)
+	if ok1 && ok2 && absDest == absArg {
+		return true
+	}
+	if err == nil {
+		absUnescaped, ok3 := absClean(unescapedDest)
+		if ok3 && ok2 && absUnescaped == absArg {
+			return true
+		}
+	}
+	return false
+}
+
+func scanAllInlineTails(doc ast.Node, source []byte) []scannedTail {
+	var allTails []scannedTail
+
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering || !isInlineHoldingBlock(n) {
+			return ast.WalkContinue, nil
+		}
+
+		lines := n.Lines()
+		if lines == nil || lines.Len() == 0 {
+			return ast.WalkContinue, nil
+		}
+
+		var codeSpans [][2]int
+		_ = ast.Walk(n, func(child ast.Node, childEntering bool) (ast.WalkStatus, error) {
+			if childEntering && child.Kind() == ast.KindCodeSpan {
+				if span, ok := getCodeSpanSourceRange(child, source); ok {
+					codeSpans = append(codeSpans, span)
+				}
+			}
+			return ast.WalkContinue, nil
+		})
+
+		var buf []byte
+		var bufToSourceMap []int
+		for i := 0; i < lines.Len(); i++ {
+			seg := lines.At(i)
+			segBytes := seg.Value(source)
+			for offset := 0; offset < len(segBytes); offset++ {
+				buf = append(buf, segBytes[offset])
+				bufToSourceMap = append(bufToSourceMap, seg.Start+offset)
+			}
+		}
+
+		inCodeSpan := make([]bool, len(buf))
+		for i, srcIdx := range bufToSourceMap {
+			for _, span := range codeSpans {
+				if srcIdx >= span[0] && srcIdx < span[1] {
+					inCodeSpan[i] = true
+					break
+				}
+			}
+		}
+
+		isSingleImageParagraph := false
+		if p, ok := n.(*ast.Paragraph); ok {
+			if p.ChildCount() == 1 && p.FirstChild().Kind() == ast.KindImage {
+				isSingleImageParagraph = true
+			}
+		}
+
+		var tailsInBlock []scannedTail
+		for i := 0; i+1 < len(buf); i++ {
+			if buf[i] == ']' && buf[i+1] == '(' {
+				if inCodeSpan[i] || inCodeSpan[i+1] {
+					continue
+				}
+				slashes := 0
+				for k := i - 1; k >= 0 && buf[k] == '\\'; k-- {
+					slashes++
+				}
+				if slashes%2 == 1 {
+					continue
+				}
+
+				tail, ok := parseLinkTail(buf, i+1)
+				if !ok {
+					continue
+				}
+
+				openBracketIdx, isImage, ok := findMatchingOpenBracket(buf, i, inCodeSpan)
+				if !ok {
+					continue
+				}
+
+				wholeStartBuf := openBracketIdx
+				if isImage {
+					wholeStartBuf = openBracketIdx - 1
+				}
+				wholeEndBuf := tail.endBuf
+				labelStartBuf := openBracketIdx + 1
+				labelEndBuf := i
+				destStartBuf := tail.destStartBuf
+				destEndBuf := tail.destEndBuf
+
+				wholeStartSrc := bufToSourceMap[wholeStartBuf]
+				wholeEndSrc := bufToSourceMap[wholeEndBuf-1] + 1
+				destStartSrc := bufToSourceMap[destStartBuf]
+				destEndSrc := bufToSourceMap[destEndBuf-1] + 1
+
+				var labelStartSrc, labelEndSrc int
+				if labelStartBuf < labelEndBuf {
+					labelStartSrc = bufToSourceMap[labelStartBuf]
+					labelEndSrc = bufToSourceMap[labelEndBuf-1] + 1
+				} else {
+					labelStartSrc = bufToSourceMap[openBracketIdx] + 1
+					labelEndSrc = labelStartSrc
+				}
+
+				tailsInBlock = append(tailsInBlock, scannedTail{
+					wholeStart: wholeStartSrc,
+					wholeEnd:   wholeEndSrc,
+					destStart:  destStartSrc,
+					destEnd:    destEndSrc,
+					labelStart: labelStartSrc,
+					labelEnd:   labelEndSrc,
+					dest:       tail.dest,
+					isImage:    isImage,
+				})
+			}
+		}
+
+		for i := range tailsInBlock {
+			if isSingleImageParagraph && tailsInBlock[i].isImage {
+				contained := false
+				for j := range tailsInBlock {
+					if i != j {
+						if tailsInBlock[j].wholeStart <= tailsInBlock[i].wholeStart &&
+							tailsInBlock[j].wholeEnd >= tailsInBlock[i].wholeEnd &&
+							(tailsInBlock[j].wholeStart < tailsInBlock[i].wholeStart || tailsInBlock[j].wholeEnd > tailsInBlock[i].wholeEnd) {
+							contained = true
+							break
+						}
+					}
+				}
+				if !contained {
+					tailsInBlock[i].isAloneInParagraph = true
+				}
+			}
+		}
+
+		allTails = append(allTails, tailsInBlock...)
+		return ast.WalkContinue, nil
+	})
+
+	return allTails
+}
+
+func isInlineHoldingBlock(n ast.Node) bool {
+	switch n.Kind() {
+	case ast.KindParagraph, ast.KindHeading, ast.KindTextBlock:
+		return true
+	default:
+		return false
+	}
+}
+
+func getCodeSpanSourceRange(n ast.Node, source []byte) ([2]int, bool) {
+	firstChild := n.FirstChild()
+	if firstChild == nil {
+		return [2]int{0, 0}, false
+	}
+	firstText, ok1 := firstChild.(*ast.Text)
+	lastText, ok2 := n.LastChild().(*ast.Text)
+	if !ok1 || !ok2 {
+		return [2]int{0, 0}, false
+	}
+	start := firstText.Segment.Start
+	stop := lastText.Segment.Stop
+
+	pos := start
+	if pos > 0 && (source[pos-1] == ' ' || source[pos-1] == '\n' || source[pos-1] == '\r') {
+		if pos > 1 && source[pos-2] == '`' {
+			pos--
+		}
+	}
+	for pos > 0 && source[pos-1] == '`' {
+		pos--
+	}
+
+	pos2 := stop
+	if pos2 < len(source) && (source[pos2] == ' ' || source[pos2] == '\n' || source[pos2] == '\r') {
+		if pos2+1 < len(source) && source[pos2+1] == '`' {
+			pos2++
+		}
+	}
+	for pos2 < len(source) && source[pos2] == '`' {
+		pos2++
+	}
+
+	return [2]int{pos, pos2}, true
+}
+
+type parsedTail struct {
+	dest         string
+	destStartBuf int
+	destEndBuf   int
+	endBuf       int
+}
+
+func parseLinkTail(buf []byte, openParenIdx int) (parsedTail, bool) {
+	p := openParenIdx + 1
+	for p < len(buf) && (buf[p] == ' ' || buf[p] == '\t' || buf[p] == '\n' || buf[p] == '\r') {
+		p++
+	}
+	if p >= len(buf) {
+		return parsedTail{}, false
+	}
+
+	var destStartBuf, destEndBuf int
+	var rawDest []byte
+
+	if buf[p] == '<' {
+		destStartBuf = p
+		p++
+		closed := false
+		for p < len(buf) {
+			if buf[p] == '\n' || buf[p] == '\r' {
+				return parsedTail{}, false
+			}
+			if buf[p] == '\\' {
+				if p+1 < len(buf) {
+					if buf[p+1] == '\n' || buf[p+1] == '\r' {
+						return parsedTail{}, false
+					}
+					rawDest = append(rawDest, buf[p+1])
+					p += 2
+					continue
+				}
+				return parsedTail{}, false
+			}
+			if buf[p] == '>' {
+				closed = true
+				p++
+				break
+			}
+			rawDest = append(rawDest, buf[p])
+			p++
+		}
+		if !closed {
+			return parsedTail{}, false
+		}
+		destEndBuf = p
+	} else {
+		destStartBuf = p
+		parenDepth := 0
+		for p < len(buf) {
+			c := buf[p]
+			if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
+				break
+			}
+			if c == '\\' {
+				if p+1 < len(buf) {
+					if buf[p+1] == '\n' || buf[p+1] == '\r' {
+						return parsedTail{}, false
+					}
+					rawDest = append(rawDest, buf[p+1])
+					p += 2
+					continue
+				}
+				return parsedTail{}, false
+			}
+			if c == '(' {
+				parenDepth++
+				rawDest = append(rawDest, c)
+				p++
+				continue
+			}
+			if c == ')' {
+				if parenDepth > 0 {
+					parenDepth--
+					rawDest = append(rawDest, c)
+					p++
+					continue
+				}
+				break
+			}
+			rawDest = append(rawDest, c)
+			p++
+		}
+		if parenDepth != 0 {
+			return parsedTail{}, false
+		}
+		destEndBuf = p
+		if destStartBuf == destEndBuf {
+			return parsedTail{}, false
+		}
+	}
+
+	pAfterDest := p
+	for p < len(buf) && (buf[p] == ' ' || buf[p] == '\t' || buf[p] == '\n' || buf[p] == '\r') {
+		p++
+	}
+	if p >= len(buf) {
+		return parsedTail{}, false
+	}
+
+	if buf[p] == ')' {
+		return parsedTail{
+			dest:         string(rawDest),
+			destStartBuf: destStartBuf,
+			destEndBuf:   destEndBuf,
+			endBuf:       p + 1,
+		}, true
+	}
+
+	if p == pAfterDest {
+		return parsedTail{}, false
+	}
+
+	delim := buf[p]
+	var closeDelim byte
+	if delim == '"' {
+		closeDelim = '"'
+	} else if delim == '\'' {
+		closeDelim = '\''
+	} else if delim == '(' {
+		closeDelim = ')'
+	} else {
+		return parsedTail{}, false
+	}
+	p++
+	titleClosed := false
+	for p < len(buf) {
+		if buf[p] == '\\' {
+			p += 2
+			continue
+		}
+		if buf[p] == closeDelim {
+			titleClosed = true
+			p++
+			break
+		}
+		p++
+	}
+	if !titleClosed {
+		return parsedTail{}, false
+	}
+
+	for p < len(buf) && (buf[p] == ' ' || buf[p] == '\t' || buf[p] == '\n' || buf[p] == '\r') {
+		p++
+	}
+	if p >= len(buf) || buf[p] != ')' {
+		return parsedTail{}, false
+	}
+
+	return parsedTail{
+		dest:         string(rawDest),
+		destStartBuf: destStartBuf,
+		destEndBuf:   destEndBuf,
+		endBuf:       p + 1,
+	}, true
+}
+
+func findMatchingOpenBracket(buf []byte, closeBracketIdx int, inCodeSpan []bool) (int, bool, bool) {
+	depth := 1
+	openBracketIdx := -1
+	for i := closeBracketIdx - 1; i >= 0; i-- {
+		if inCodeSpan[i] {
+			continue
+		}
+		slashes := 0
+		for k := i - 1; k >= 0 && buf[k] == '\\'; k-- {
+			slashes++
+		}
+		if slashes%2 == 1 {
+			continue
+		}
+		if buf[i] == ']' {
+			depth++
+		} else if buf[i] == '[' {
+			depth--
+			if depth == 0 {
+				openBracketIdx = i
+				break
+			}
+		}
+	}
+	if openBracketIdx == -1 {
+		return -1, false, false
+	}
+
+	isImage := false
+	if openBracketIdx > 0 && buf[openBracketIdx-1] == '!' {
+		slashes := 0
+		for k := openBracketIdx - 2; k >= 0 && buf[k] == '\\'; k-- {
+			slashes++
+		}
+		if slashes%2 == 0 {
+			isImage = true
+		}
+	}
+
+	return openBracketIdx, isImage, true
+}
+
+func scanReferenceDefinitions(doc ast.Node, source []byte, args []attachmentArg, usedThroughRef []bool) []replacement {
+	var codeBlockRanges [][2]int
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if entering {
+			if n.Kind() == ast.KindCodeBlock || n.Kind() == ast.KindFencedCodeBlock {
+				lines := n.Lines()
+				if lines != nil {
+					for i := 0; i < lines.Len(); i++ {
+						seg := lines.At(i)
+						codeBlockRanges = append(codeBlockRanges, [2]int{seg.Start, seg.Stop})
+					}
+				}
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+
+	var defReplacements []replacement
+
+	lineStart := 0
+	for lineStart < len(source) {
+		lineEnd := lineStart
+		for lineEnd < len(source) && source[lineEnd] != '\n' && source[lineEnd] != '\r' {
+			lineEnd++
+		}
+		nextLineStart := lineEnd
+		if nextLineStart < len(source) && source[nextLineStart] == '\r' {
+			nextLineStart++
+		}
+		if nextLineStart < len(source) && source[nextLineStart] == '\n' {
+			nextLineStart++
+		}
+
+		inCodeBlock := false
+		for _, r := range codeBlockRanges {
+			if lineStart >= r[0] && lineStart < r[1] {
+				inCodeBlock = true
+				break
+			}
+		}
+		if inCodeBlock {
+			lineStart = nextLineStart
+			continue
+		}
+
+		p := lineStart
+		spaces := 0
+		for p < lineEnd && source[p] == ' ' && spaces < 3 {
+			p++
+			spaces++
+		}
+
+		for {
+			if p < lineEnd && source[p] == '>' {
+				p++
+				if p < lineEnd && source[p] == ' ' {
+					p++
+				}
+				sp := 0
+				for p < lineEnd && source[p] == ' ' && sp < 3 {
+					p++
+					sp++
+				}
+				continue
+			}
+			break
+		}
+
+		if p >= lineEnd || source[p] != '[' {
+			lineStart = nextLineStart
+			continue
+		}
+		p++
+
+		labelFound := false
+		for p < lineEnd {
+			if source[p] == '\\' {
+				p += 2
+				continue
+			}
+			if source[p] == ']' {
+				if p+1 < lineEnd && source[p+1] == ':' {
+					labelFound = true
+					p += 2
+					break
+				}
+				break
+			}
+			p++
+		}
+		if !labelFound {
+			lineStart = nextLineStart
+			continue
+		}
+
+		if p >= lineEnd || (source[p] != ' ' && source[p] != '\t') {
+			lineStart = nextLineStart
+			continue
+		}
+		for p < lineEnd && (source[p] == ' ' || source[p] == '\t') {
+			p++
+		}
+		if p >= lineEnd {
+			lineStart = nextLineStart
+			continue
+		}
+
+		destStart := p
+		var destEnd int
+		var rawDest []byte
+		if source[p] == '<' {
+			p++
+			closed := false
+			for p < lineEnd {
+				if source[p] == '\\' {
+					if p+1 < lineEnd {
+						rawDest = append(rawDest, source[p+1])
+						p += 2
+						continue
+					}
+					break
+				}
+				if source[p] == '>' {
+					closed = true
+					p++
+					break
+				}
+				rawDest = append(rawDest, source[p])
+				p++
+			}
+			if !closed {
+				lineStart = nextLineStart
+				continue
+			}
+			destEnd = p
+		} else {
+			for p < lineEnd && source[p] != ' ' && source[p] != '\t' {
+				if source[p] == '\\' {
+					if p+1 < lineEnd {
+						rawDest = append(rawDest, source[p+1])
+						p += 2
+						continue
+					}
+					break
+				}
+				rawDest = append(rawDest, source[p])
+				p++
+			}
+			destEnd = p
+			if destStart == destEnd {
+				lineStart = nextLineStart
+				continue
+			}
+		}
+
+		destStr := string(rawDest)
+		for argIdx, arg := range args {
+			if arg.URL == "" {
+				continue
+			}
+			if matchDestination(destStr, arg.Path) && usedThroughRef[argIdx] {
+				defReplacements = append(defReplacements, replacement{
+					start:    destStart,
+					end:      destEnd,
+					text:     arg.URL,
+					argIndex: argIdx,
+				})
+				break
+			}
+		}
+
+		lineStart = nextLineStart
+	}
+
+	return defReplacements
+}
+
+func isSingleImage(markdown, assetURL string) bool {
+	reader := text.NewReader([]byte(markdown))
+	doc := goldmark.New().Parser().Parse(reader)
+
+	if doc.ChildCount() != 1 {
+		return false
+	}
+	p, ok := doc.FirstChild().(*ast.Paragraph)
+	if !ok {
+		return false
+	}
+	if p.ChildCount() != 1 {
+		return false
+	}
+	img, ok := p.FirstChild().(*ast.Image)
+	if !ok {
+		return false
+	}
+	return string(img.Destination) == assetURL
+}
