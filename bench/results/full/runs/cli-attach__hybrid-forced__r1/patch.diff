diff --git a/internal/attachments/userasset.go b/internal/attachments/userasset.go
new file mode 100644
index 000000000..91e283654
--- /dev/null
+++ b/internal/attachments/userasset.go
@@ -0,0 +1,173 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+const (
+	maxImageBytes = 10 * 1024 * 1024
+	maxVideoBytes = 100 * 1024 * 1024
+)
+
+var openFile = func(path string) (io.ReadCloser, error) {
+	return os.Open(path)
+}
+
+type asset struct {
+	path        string
+	alt         string
+	contentType string
+	info        fs.FileInfo
+}
+
+func (a asset) Path() string {
+	return a.path
+}
+
+func (a asset) getAsset() asset {
+	return a
+}
+
+type UserAsset interface {
+	Path() string
+	getAsset() asset
+	markdown(assetURL string) string
+	rendersAsPlayer() bool
+}
+
+type imageAsset struct {
+	asset
+}
+
+func (a *imageAsset) rendersAsPlayer() bool {
+	return false
+}
+
+func (a *imageAsset) markdown(assetURL string) string {
+	return fmt.Sprintf("![%s](%s)", escapeAlt(a.alt), assetURL)
+}
+
+type videoAsset struct {
+	asset
+}
+
+func (a *videoAsset) rendersAsPlayer() bool {
+	return true
+}
+
+func (a *videoAsset) markdown(assetURL string) string {
+	return assetURL
+}
+
+func escapeAlt(alt string) string {
+	var b strings.Builder
+	for _, r := range alt {
+		switch r {
+		case '\\':
+			b.WriteString(`\\`)
+		case '[':
+			b.WriteString(`\[`)
+		case ']':
+			b.WriteString(`\]`)
+		case '\r', '\n':
+			b.WriteByte(' ')
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+type extInfo struct {
+	ext         string
+	contentType string
+	isVideo     bool
+}
+
+var supportedExts = []extInfo{
+	{"png", "image/png", false},
+	{"jpg", "image/jpeg", false},
+	{"jpeg", "image/jpeg", false},
+	{"gif", "image/gif", false},
+	{"webp", "image/webp", false},
+	{"svg", "image/svg+xml", false},
+	{"mp4", "video/mp4", true},
+	{"mov", "video/quicktime", true},
+	{"webm", "video/webm", true},
+}
+
+func newAsset(path, alt string) (UserAsset, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		var pathErr *fs.PathError
+		if errors.As(err, &pathErr) {
+			return nil, fmt.Errorf("%s: %w", path, pathErr.Err)
+		}
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+
+	if info.IsDir() {
+		return nil, fmt.Errorf("%s is a directory", path)
+	}
+
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%s is not a regular file", path)
+	}
+
+	ext := strings.TrimPrefix(filepath.Ext(path), ".")
+	extLower := strings.ToLower(ext)
+	var found *extInfo
+	for i := range supportedExts {
+		if supportedExts[i].ext == extLower {
+			found = &supportedExts[i]
+			break
+		}
+	}
+	if found == nil {
+		return nil, fmt.Errorf("%s is not a supported file type (supported: png, jpg, jpeg, gif, webp, svg, mp4, mov, webm)", path)
+	}
+
+	if info.Size() == 0 {
+		return nil, fmt.Errorf("%s is empty", path)
+	}
+
+	if found.isVideo {
+		if info.Size() > maxVideoBytes {
+			return nil, fmt.Errorf("%s: videos must be at most 100.0 MB", path)
+		}
+	} else {
+		if info.Size() > maxImageBytes {
+			return nil, fmt.Errorf("%s: images must be at most 10.0 MB", path)
+		}
+	}
+
+	if found.isVideo && alt != "" {
+		return nil, errors.New("cannot set alt text on video")
+	}
+
+	base := filepath.Base(path)
+	if found.isVideo {
+		alt = base
+	} else if alt == "" {
+		baseWithoutExt := strings.TrimSuffix(base, filepath.Ext(base))
+		alt = strings.ReplaceAll(baseWithoutExt, ".", " ")
+	}
+
+	baseAsset := asset{
+		path:        path,
+		alt:         alt,
+		contentType: found.contentType,
+		info:        info,
+	}
+
+	if found.isVideo {
+		return &videoAsset{asset: baseAsset}, nil
+	}
+	return &imageAsset{asset: baseAsset}, nil
+}
