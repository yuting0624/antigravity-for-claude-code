+++ b/internal/cloudapi/clientcfg/clientcfg.go
@@ -0,0 +1,12 @@
+// Package clientcfg holds tuning constants shared by the k6 Cloud API HTTP clients
+// (cloudapi, internal/cloudapi/v6, internal/cloudapi/provisioning).
+package clientcfg
+
+import "time"
+
+const (
+	// RetryInterval is the default cloud request retry interval.
+	RetryInterval = 500 * time.Millisecond
+	// MaxRetries specifies max retry attempts.
+	MaxRetries = 3
+)
diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..be3c8d953
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,210 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// MetricsConfig contains cloud metric push runtime configurations.
+type MetricsConfig struct {
+	PushURL               string
+	PushInterval          *string
+	PushConcurrency       *int32
+	AggregationPeriod     *string
+	AggregationWaitPeriod *string
+	AggregationMinSamples *int32
+	MaxSamplesPerPackage  *int32
+}
+
+// SecretsConfig contains configuration for decrypting secrets.
+type SecretsConfig struct {
+	Endpoint     string
+	ResponsePath string
+}
+
+// RuntimeConfig contains runtime configurations for the test run.
+type RuntimeConfig struct {
+	Metrics      MetricsConfig
+	TestRunToken string
+	Secrets      SecretsConfig
+}
+
+// StartLocalExecutionRequest contains the parameters needed to start a test run
+// in local execution mode.
+type StartLocalExecutionRequest struct {
+	Options       json.RawMessage
+	MaxVUs        int32
+	TotalDuration int32
+	ArchiveSize   int64
+}
+
+// StartLocalExecutionResponse contains the details of the provisioned test run.
+type StartLocalExecutionResponse struct {
+	TestRunID             int64
+	ArchiveUploadURL      *string
+	TestRunDetailsPageURL string
+	RuntimeConfig         RuntimeConfig
+}
+
+// StartLocalExecution provisions a test run in local execution mode on k6 Cloud.
+func (c *Client) StartLocalExecution(
+	ctx context.Context, loadTestID int64, req StartLocalExecutionRequest,
+) (_ *StartLocalExecutionResponse, err error) {
+	sdkReq := k6cloud.NewStartLocalExecutionTestRequestWithDefaults()
+
+	opts := make(map[string]interface{})
+	if len(req.Options) > 0 {
+		if err := json.Unmarshal(req.Options, &opts); err != nil {
+			return nil, fmt.Errorf("failed to decode options: %w", err)
+		}
+		if opts == nil {
+			opts = make(map[string]interface{})
+		}
+	}
+	sdkReq.SetOptions(opts)
+
+	sdkReq.SetMaxVus(req.MaxVUs)
+	sdkReq.SetTotalDuration(req.TotalDuration)
+
+	if req.ArchiveSize > 0 {
+		sdkReq.SetArchiveSize(int32(req.ArchiveSize)) //nolint:gosec
+	} else {
+		sdkReq.SetArchiveSizeNil()
+	}
+
+	var key [8]byte
+	if _, err := rand.Read(key[:]); err != nil {
+		return nil, err
+	}
+
+	res, hr, err := c.apiClient.ProvisioningAPI.
+		StartLocalExecutionTest(c.authCtx(ctx), loadTestID).
+		StartLocalExecutionTestRequest(sdkReq).
+		K6IdempotencyKey(hex.EncodeToString(key[:])).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if cerr := checkResponse(hr, err); cerr != nil {
+		return nil, cerr
+	}
+	if res == nil {
+		return nil, errUnknown
+	}
+
+	archiveUploadURL := copyNullableString(res.GetArchiveUploadUrlOk())
+
+	rc := res.GetRuntimeConfig()
+	mc := rc.GetMetrics()
+	sc := rc.GetSecrets()
+
+	return &StartLocalExecutionResponse{
+		TestRunID:             res.GetTestRunId(),
+		ArchiveUploadURL:      archiveUploadURL,
+		TestRunDetailsPageURL: res.GetTestRunDetailsPageUrl(),
+		RuntimeConfig: RuntimeConfig{
+			Metrics: MetricsConfig{
+				PushURL:               mc.GetPushUrl(),
+				PushInterval:          copyNullableString(mc.GetPushIntervalOk()),
+				PushConcurrency:       copyNullableInt32(mc.GetPushConcurrencyOk()),
+				AggregationPeriod:     copyNullableString(mc.GetAggregationPeriodOk()),
+				AggregationWaitPeriod: copyNullableString(mc.GetAggregationWaitPeriodOk()),
+				AggregationMinSamples: copyNullableInt32(mc.GetAggregationMinSamplesOk()),
+				MaxSamplesPerPackage:  copyNullableInt32(mc.GetMaxSamplesPerPackageOk()),
+			},
+			TestRunToken: rc.GetTestRunToken(),
+			Secrets: SecretsConfig{
+				Endpoint:     sc.GetEndpoint(),
+				ResponsePath: sc.GetResponsePath(),
+			},
+		},
+	}, nil
+}
+
+// UploadArchive uploads the test archive to the given presigned URL.
+func (c *Client) UploadArchive(ctx context.Context, uploadURL string, archive []byte) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPut, uploadURL, bytes.NewReader(archive))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/x-tar")
+	req.ContentLength = int64(len(archive))
+
+	return c.httpClient.Do(req, nil)
+}
+
+// WaitForTestRunReady polls the test run progress until it is ready to run or terminates.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	if pollInterval <= 0 {
+		pollInterval = 2 * time.Second
+	}
+
+	var lastLoggedStatus v6.Status
+
+	for {
+		tp, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			return fmt.Errorf("failed to fetch test run progress: %w", err)
+		}
+
+		switch tp.Status {
+		case v6.StatusInitializing, v6.StatusRunning:
+			return nil
+		case v6.StatusAborted:
+			var msg string
+			for i := len(tp.StatusHistory) - 1; i >= 0; i-- {
+				if tp.StatusHistory[i].Status == v6.StatusAborted && tp.StatusHistory[i].Message != "" {
+					msg = tp.StatusHistory[i].Message
+					break
+				}
+			}
+			if msg != "" {
+				return fmt.Errorf("test run aborted before starting: %s", msg)
+			}
+			return errors.New("test run aborted before starting")
+		case v6.StatusCompleted:
+			return errors.New("test run completed before it could be started locally")
+		default:
+			if tp.Status != lastLoggedStatus {
+				if c.logger != nil {
+					c.logger.WithField("status", tp.FormatStatus()).Info("Waiting for the cloud test run to be ready")
+				}
+				lastLoggedStatus = tp.Status
+			}
+		}
+
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(pollInterval):
+		}
+	}
+}
+
+func copyNullableString(val *string, ok bool) *string {
+	if !ok || val == nil {
+		return nil
+	}
+	cp := *val
+	return &cp
+}
+
+func copyNullableInt32(val *int32, ok bool) *int32 {
+	if !ok || val == nil {
+		return nil
+	}
+	cp := *val
+	return &cp
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..f20e56bfc
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,81 @@
+package provisioning
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"strconv"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client talks to the k6 Cloud provisioning API and to the parts of the v6
+// API needed to provision a local test run.
+type Client struct {
+	apiClient *k6cloud.APIClient
+	v6Client  *v6.Client
+	// httpClient is used for presigned archive uploads; it deliberately
+	// carries no token so no Authorization header is sent.
+	httpClient *HTTPClient
+	token      string
+	stackID    int64
+	logger     logrus.FieldLogger
+}
+
+// NewClient returns a new provisioning API client.
+func NewClient(
+	logger logrus.FieldLogger, token, host, version string, stackID int64, timeout time.Duration,
+) (*Client, error) {
+	if token == "" {
+		return nil, fmt.Errorf("token is required to create provisioning API client")
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Global k6 Cloud API.",
+		},
+	}
+	cfg.HTTPClient = &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+	cfg.AddDefaultHeader("X-Stack-Id", strconv.FormatInt(stackID, 10))
+
+	v6c, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if err := v6c.SetStackID(stackID); err != nil {
+		return nil, err
+	}
+
+	httpClient := NewHTTPClient(cfg.HTTPClient, "", version, logger)
+
+	return &Client{
+		apiClient:  k6cloud.NewAPIClient(cfg),
+		v6Client:   v6c,
+		httpClient: httpClient,
+		token:      token,
+		stackID:    stackID,
+		logger:     logger,
+	}, nil
+}
+
+// authCtx returns a context carrying the long-lived access token.
+func (c *Client) authCtx(ctx context.Context) context.Context {
+	return context.WithValue(ctx, k6cloud.ContextAccessToken, c.token)
+}
+
+// authCtxWithToken returns a context carrying the given access token.
+func (c *Client) authCtxWithToken(ctx context.Context, token string) context.Context {
+	return context.WithValue(ctx, k6cloud.ContextAccessToken, token)
+}
