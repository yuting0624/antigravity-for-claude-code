+
+// buildConfigFromRuntimeConfig translates the metrics tuning knobs the cloud
+// provisioning API returns into a cloudapi.Config override. Unset fields are
+// left unset so the local defaults survive; unparseable values are logged and
+// skipped.
+func buildConfigFromRuntimeConfig(logger logrus.FieldLogger, rc provisioning.RuntimeConfig) cloudapi.Config {
+	var cfg cloudapi.Config
+
+	parseDuration := func(s *string, wireName string) types.NullDuration {
+		if s == nil {
+			return types.NullDuration{}
+		}
+		d, err := types.ParseExtendedDuration(*s)
+		if err != nil {
+			logger.WithError(err).WithField("field", wireName).Warn("Ignoring invalid duration in the cloud runtime config")
+			return types.NullDuration{}
+		}
+		return types.NewNullDuration(d, true)
+	}
+
+	cfg.MetricPushInterval = parseDuration(rc.Metrics.PushInterval, "push_interval")
+	cfg.AggregationPeriod = parseDuration(rc.Metrics.AggregationPeriod, "aggregation_period")
+	cfg.AggregationWaitPeriod = parseDuration(rc.Metrics.AggregationWaitPeriod, "aggregation_wait_period")
+
+	if rc.Metrics.PushConcurrency != nil {
+		cfg.MetricPushConcurrency = null.IntFrom(int64(*rc.Metrics.PushConcurrency))
+	}
+	if rc.Metrics.MaxSamplesPerPackage != nil {
+		cfg.MaxTimeSeriesInBatch = null.IntFrom(int64(*rc.Metrics.MaxSamplesPerPackage))
+	}
+
+	return cfg
+}
