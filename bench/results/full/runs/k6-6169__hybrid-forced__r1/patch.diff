index 000000000..6d70af98b
--- /dev/null
+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,194 @@
+// Package provtest provides an HTTP test server that simulates the k6 Cloud
+// provisioning API.
+//
+// It keeps provisioning-specific encoding (nullable fields, runtime config,
+// SDK models) out of caller tests. Test specs configure endpoint handlers
+// and progress sequences; this server translates to the wire format.
+package provtest
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	// DefaultLoadTestID is the load test id used by the default routes.
+	DefaultLoadTestID int64 = 456
+	// DefaultTestRunID is the test run id used by the default routes.
+	DefaultTestRunID int64 = 123
+	// PresignedUploadPath is the path served as a stand-in for the S3 presigned archive upload URL.
+	PresignedUploadPath = "/presigned-upload/archive.tar"
+)
+
+// Server is a test HTTP server for the k6 Cloud provisioning API.
+type Server struct {
+	*httptest.Server
+	// Mux is the request multiplexer; tests may register extra routes on it,
+	// including a "/" catch-all.
+	Mux *http.ServeMux
+
+	fetchTestRunHits atomic.Int32
+}
+
+// NewServer creates a test server that serves provisioning API endpoints.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+
+	s := &Server{
+		Mux: http.NewServeMux(),
+	}
+	srv := httptest.NewServer(s.Mux)
+	s.Server = srv
+	t.Cleanup(srv.Close)
+
+	return s
+}
+
+// HandleCreateLoadTest registers the handler on the pattern
+// "/cloud/v6/projects/{id}/load_tests" with the concrete projectID substituted,
+// and without a method prefix.
+func (s *Server) HandleCreateLoadTest(projectID int64, h http.HandlerFunc) {
+	pattern := fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID)
+	s.Mux.HandleFunc(pattern, h)
+}
+
+// HandleStartLocalExecution registers the handler on
+// "POST /provisioning/v1/load_tests/{id}/start_local_execution" with the
+// concrete loadTestID substituted.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, h http.HandlerFunc) {
+	pattern := fmt.Sprintf("POST /provisioning/v1/load_tests/%d/start_local_execution", loadTestID)
+	s.Mux.HandleFunc(pattern, h)
+}
+
+// HandlePresignedUpload registers the handler on the given path with no method
+// prefix.
+func (s *Server) HandlePresignedUpload(path string, h http.HandlerFunc) {
+	s.Mux.HandleFunc(path, h)
+}
+
+// PresignedUploadURL returns s.URL + PresignedUploadPath.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// HandleNotify registers the handler on
+// "POST /provisioning/v1/test_runs/{id}/notify" with the concrete testRunID
+// substituted.
+func (s *Server) HandleNotify(testRunID int64, h http.HandlerFunc) {
+	pattern := fmt.Sprintf("POST /provisioning/v1/test_runs/%d/notify", testRunID)
+	s.Mux.HandleFunc(pattern, h)
+}
+
+// HandleFetchTestRun registers a handler on "GET /cloud/v6/test_runs/{id}" that
+// serves the supplied progresses in order: the Nth request (1-based) returns
+// progresses[N-1], and every request past the end keeps returning the last
+// element. It increments an atomic counter on every request.
+func (s *Server) HandleFetchTestRun(testRunID int64, progresses []v6.TestProgress) {
+	if len(progresses) == 0 {
+		panic("provtest: progresses must not be empty")
+	}
+
+	progs := append([]v6.TestProgress(nil), progresses...)
+	pattern := fmt.Sprintf("GET /cloud/v6/test_runs/%d", testRunID)
+	s.Mux.HandleFunc(pattern, func(w http.ResponseWriter, _ *http.Request) {
+		hit := s.fetchTestRunHits.Add(1)
+		idx := int(hit - 1)
+		if idx >= len(progs) {
+			idx = len(progs) - 1
+		}
+		tp := progs[idx]
+
+		res := k6cloud.NewTestRunApiModelWithDefaults()
+		res.SetStatus(tp.Status.String())
+		res.SetResult(tp.Result.String())
+		res.SetEstimatedDuration(tp.EstimatedDuration)
+		res.SetExecutionDuration(tp.ExecutionDuration)
+		res.SetStatusHistory(v6.ToStatusModel(tp.StatusHistory))
+		res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+		resultDetails := k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(k6cloud.NewResultDetailsApiModel(""))
+		res.SetResultDetails(resultDetails)
+		res.SetOptions(map[string]any{})
+		writeJSON(w, http.StatusOK, res)
+	})
+}
+
+// FetchTestRunHitCount returns the number of requests received by the
+// test-run fetch handler.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchTestRunHits.Load()
+}
+
+// DefaultStartLocalExecutionResponse returns a fully-populated
+// StartLocalExecutionTestResponse suitable for test assertions.
+func DefaultStartLocalExecutionResponse() *k6cloud.StartLocalExecutionTestResponse {
+	metrics := k6cloud.NewMetricsRuntimeConfig(
+		"https://ingest.k6.io/v1/metrics",
+		*k6cloud.NewNullableString(k6cloud.PtrString("2s")),
+		*k6cloud.NewNullableInt32(k6cloud.PtrInt32(5)),
+		*k6cloud.NewNullableString(k6cloud.PtrString("3s")),
+		*k6cloud.NewNullableString(k6cloud.PtrString("1s")),
+		*k6cloud.NewNullableInt32(k6cloud.PtrInt32(50)),
+		*k6cloud.NewNullableInt32(k6cloud.PtrInt32(2000)),
+	)
+
+	traces := k6cloud.NewTracesRuntimeConfig(
+		"https://traces.k6.io",
+		map[string]string{},
+		"grpc",
+	)
+
+	files := k6cloud.NewFilesRuntimeConfig(
+		"https://files.k6.io",
+		"/screenshots",
+		map[string]string{},
+		"PUT",
+	)
+
+	logs := k6cloud.NewLogsRuntimeConfig(
+		"https://logs.k6.io",
+		"wss://logs.k6.io/tail",
+		100,
+		"1s",
+		"info",
+		1024,
+		[]string{},
+	)
+
+	secrets := k6cloud.NewSecretsRuntimeConfig(
+		"https://api.k6.io/provisioning/v1/test_runs/123/decrypt_secret?name={key}",
+		"plaintext",
+	)
+
+	rc := k6cloud.NewRuntimeConfig(
+		*metrics,
+		*traces,
+		*files,
+		*logs,
+		*secrets,
+		"test-run-token-abc",
+	)
+
+	archiveURL := "https://k6-archives.s3.amazonaws.com/test-run-123/archive.tar?X-Amz-Signature=fake"
+	return k6cloud.NewStartLocalExecutionTestResponse(
+		DefaultTestRunID,
+		*rc,
+		*k6cloud.NewNullableString(k6cloud.PtrString(archiveURL)),
+		"https://app.k6.io/runs/123",
+	)
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	if err := json.NewEncoder(w).Encode(v); err != nil {
+		panic(fmt.Errorf("provtest: encoding JSON: %w", err))
+	}
+}
