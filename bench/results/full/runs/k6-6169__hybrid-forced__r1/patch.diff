+// CreateOrFindLoadTest ensures a load test with the given name exists in the
+// given project and returns its id. It creates the test without uploading a
+// script; when the cloud reports a 409 conflict (a test with that name already
+// exists) it looks the existing test up by name instead.
+func (c *Client) CreateOrFindLoadTest(ctx context.Context, projectID int64, name string) (int64, error) {
+	lt, err := c.createTestWithoutScript(ctx, name, projectID)
+	if err == nil {
+		return lt.GetId(), nil
+	}
+	var rerr ResponseError
+	if !errors.As(err, &rerr) || rerr.Response == nil || rerr.Response.StatusCode != http.StatusConflict {
