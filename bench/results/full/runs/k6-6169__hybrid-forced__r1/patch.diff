diff --git a/internal/cloudapi/provisioning/errors.go b/internal/cloudapi/provisioning/errors.go
new file mode 100644
index 000000000..0c376d219
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,69 @@
+package provisioning
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+var errUnknown = errors.New("an error occurred communicating with k6 Cloud")
+
+// ResponseError is an HTTP error returned by the provisioning API or by a
+// presigned upload endpoint. The raw body is kept verbatim because these
+// endpoints do not share a single error envelope.
+type ResponseError struct {
+	StatusCode int
+	Body       string
+}
+
+func (e *ResponseError) Error() string {
+	return fmt.Sprintf("unexpected HTTP error: %d %s: %s", e.StatusCode, http.StatusText(e.StatusCode), e.Body)
+}
+
+// CheckResponse returns nil when the response status is in the 2xx range.
+// Otherwise it reads the body and returns a *ResponseError, wrapped with the
+// classified authentication/authorization error for 401 and 403.
+func CheckResponse(r *http.Response) error {
+	if r == nil {
+		return errUnknown
+	}
+	if r.StatusCode >= 200 && r.StatusCode <= 299 {
+		return nil
+	}
+	var data []byte
+	if r.Body != nil {
+		data, _ = io.ReadAll(r.Body)
+	}
+	re := &ResponseError{
+		StatusCode: r.StatusCode,
+		Body:       string(data),
+	}
+	if classified := httperr.ClassifyStatus(r.StatusCode); classified != nil {
+		return fmt.Errorf("%w: %w", classified, re)
+	}
+	return re
+}
+
+// checkResponse combines an SDK transport error with the HTTP response.
+func checkResponse(r *http.Response, err error) error {
+	if r == nil {
+		if err != nil {
+			return err
+		}
+		return errUnknown
+	}
+	return CheckResponse(r)
+}
+
+func closeResponse(res *http.Response, rerr *error) {
+	if res == nil {
+		return
+	}
+	_, _ = io.Copy(io.Discard, res.Body)
+	if err := res.Body.Close(); err != nil && rerr != nil && *rerr == nil {
+		*rerr = err
+	}
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..f03a4ceb5
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,116 @@
+package provisioning
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient is a small retrying HTTP client used for the provisioning
+// endpoints that are not covered by the generated SDK, and for presigned
+// archive uploads.
+type HTTPClient struct {
+	client  *http.Client
+	token   string
+	version string
+	logger  logrus.FieldLogger
+}
+
+// NewHTTPClient returns an HTTPClient that authenticates with the given
+// bearer token. An empty token means no Authorization header is sent, which
+// is what presigned URLs require.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	if client == nil {
+		client = http.DefaultClient
+	}
+	return &HTTPClient{
+		client:  client,
+		token:   token,
+		version: version,
+		logger:  logger,
+	}
+}
+
+// Do sends req, retrying on transport errors and 5xx/429 responses, and
+// decodes a successful JSON response into v when v is not nil.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	var buf []byte
+	hasBody := req.Body != nil
+	if hasBody {
+		var err error
+		buf, err = io.ReadAll(req.Body)
+		_ = req.Body.Close()
+		if err != nil {
+			return err
+		}
+	}
+
+	ctx := req.Context()
+	var lastErr error
+
+	for attempt := 0; attempt <= clientcfg.MaxRetries; attempt++ {
+		if attempt > 0 {
+			select {
+			case <-ctx.Done():
+				return ctx.Err()
+			case <-time.After(clientcfg.RetryInterval):
+			}
+		}
+
+		clonedReq := req.Clone(ctx)
+		if hasBody {
+			clonedReq.Body = io.NopCloser(bytes.NewReader(buf))
+			clonedReq.ContentLength = int64(len(buf))
+			clonedReq.GetBody = func() (io.ReadCloser, error) {
+				return io.NopCloser(bytes.NewReader(buf)), nil
+			}
+		}
+
+		clonedReq.Header.Set("User-Agent", "k6cloud/"+c.version)
+		if c.token != "" {
+			clonedReq.Header.Set("Authorization", "Bearer "+c.token)
+		} else {
+			clonedReq.Header.Del("Authorization")
+		}
+
+		resp, err := c.client.Do(clonedReq)
+		if err != nil {
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			lastErr = err
+			if c.logger != nil {
+				c.logger.WithError(err).Debug("transport error, retrying")
+			}
+			continue
+		}
+
+		if resp.StatusCode >= 500 || resp.StatusCode == http.StatusTooManyRequests {
+			lastErr = CheckResponse(resp)
+			_ = resp.Body.Close()
+			continue
+		}
+
+		if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+			err := CheckResponse(resp)
+			_ = resp.Body.Close()
+			return err
+		}
+
+		if v == nil {
+			_, _ = io.Copy(io.Discard, resp.Body)
+			_ = resp.Body.Close()
+			return nil
+		}
+		decodeErr := json.NewDecoder(resp.Body).Decode(v)
+		_ = resp.Body.Close()
+		return decodeErr
+	}
+
+	return lastErr
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..084aadc28
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,64 @@
+package provisioning
+
+import (
+	"context"
+	"errors"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"go.k6.io/k6/v2/errext"
+)
+
+const scriptExecutionCompletedEventType = "script_execution_completed"
+
+// Error codes reported to the cloud provisioning API.
+const (
+	notifyCodeAborted     int32 = 8036 // aborted by the user or by the script
+	notifyCodeScriptError int32 = 8035 // the script itself errored
+	notifyCodeSystem      int32 = 8034 // timeout or output failure
+)
+
+// mapTestErrorToNotifyCode maps the error k6 stopped with onto the error object
+// reported to the provisioning API. It returns nil when the run should be
+// reported as a clean finish.
+func mapTestErrorToNotifyCode(testErr error) *k6cloud.ScriptExecutionError {
+	if testErr == nil {
+		return nil
+	}
+
+	var code int32
+	var hasReason errext.HasAbortReason
+	if errors.As(testErr, &hasReason) {
+		switch hasReason.AbortReason() {
+		case errext.AbortedByThresholdsAfterTestEnd:
+			return nil
+		case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+			code = notifyCodeAborted
+		case errext.AbortedByScriptError:
+			code = notifyCodeScriptError
+		case errext.AbortedByOutput, errext.AbortedByTimeout:
+			code = notifyCodeSystem
+		default:
+			code = 0
+		}
+	} else {
+		code = 0
+	}
+
+	return k6cloud.NewScriptExecutionError(code, testErr.Error())
+}
+
+// NotifyTestRunCompleted reports to the provisioning API that the local script
+// execution finished. token must be the test-run-scoped token handed out by
+// start_local_execution.
+func (c *Client) NotifyTestRunCompleted(ctx context.Context, testRunID int64, token string, testErr error) (err error) {
+	body := k6cloud.NewScriptExecutionCompletedNotificationApiModel(scriptExecutionCompletedEventType)
+	if e := mapTestErrorToNotifyCode(testErr); e != nil {
+		body.Error = *k6cloud.NewNullableScriptExecutionError(e)
+	}
+	hr, err := c.apiClient.ProvisioningAPI.
+		TestRunsNotify(c.authCtxWithToken(ctx, token), testRunID).
+		ScriptExecutionCompletedNotificationApiModel(body).
+		Execute()
+	defer closeResponse(hr, &err)
+	return checkResponse(hr, err)
+}
diff --git a/internal/cloudapi/provisioning/provision.go b/internal/cloudapi/provisioning/provision.go
new file mode 100644
index 000000000..352bcdb9f
--- /dev/null
+++ b/internal/cloudapi/provisioning/provision.go
@@ -0,0 +1,85 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"go.k6.io/k6/v2/lib"
+)
+
+// ProvisionParams describes the local test run to provision.
+type ProvisionParams struct {
+	Name      string
+	ProjectID int64
+	MaxVUs    int32
+	// TotalDuration is the total test duration in seconds.
+	TotalDuration int32
+	// Options is the resolved script options, serialised as JSON.
+	Options json.RawMessage
+	// Archive is the test archive to upload; nil skips the upload.
+	Archive *lib.Archive
+	// PollInterval is how often the test run status is polled while waiting
+	// for the run to become ready.
+	PollInterval time.Duration
+}
+
+// ProvisionResult is everything a provisioned local test run needs to start.
+type ProvisionResult struct {
+	TestRunID             int64
+	TestRunDetailsPageURL string
+	RuntimeConfig         RuntimeConfig
+}
+
+// ProvisionLocalExecution creates or finds the load test, starts it in local
+// execution mode, uploads the archive when one is given and the cloud returned
+// a presigned URL, and waits until the run is ready to receive metrics.
+func (c *Client) ProvisionLocalExecution(ctx context.Context, p ProvisionParams) (*ProvisionResult, error) {
+	var archiveBytes []byte
+	if p.Archive != nil {
+		var buf bytes.Buffer
+		if err := p.Archive.Write(&buf); err != nil {
+			return nil, fmt.Errorf("serialize archive: %w", err)
+		}
+		archiveBytes = buf.Bytes()
+	}
+
+	loadTestID, err := c.v6Client.CreateOrFindLoadTest(ctx, p.ProjectID, p.Name)
+	if err != nil {
+		return nil, fmt.Errorf("create or find load test: %w", err)
+	}
+
+	res, err := c.StartLocalExecution(ctx, loadTestID, StartLocalExecutionRequest{
+		Options:       p.Options,
+		MaxVUs:        p.MaxVUs,
+		TotalDuration: p.TotalDuration,
+		ArchiveSize:   int64(len(archiveBytes)),
+	})
+	if err != nil {
+		return nil, fmt.Errorf("start local execution: %w", err)
+	}
+
+	if len(archiveBytes) > 0 {
+		if res.ArchiveUploadURL == nil || *res.ArchiveUploadURL == "" {
+			if c.logger != nil {
+				c.logger.Warn("the cloud returned no archive upload URL so the archive was not uploaded")
+			}
+		} else {
+			if err := c.UploadArchive(ctx, *res.ArchiveUploadURL, archiveBytes); err != nil {
+				return nil, fmt.Errorf("upload archive: %w", err)
+			}
+		}
+	}
+
+	if err := c.WaitForTestRunReady(ctx, res.TestRunID, p.PollInterval); err != nil {
+		return nil, fmt.Errorf("wait for test run ready: %w", err)
+	}
+
+	return &ProvisionResult{
+		TestRunID:             res.TestRunID,
+		TestRunDetailsPageURL: res.TestRunDetailsPageURL,
+		RuntimeConfig:         res.RuntimeConfig,
+	}, nil
+}
diff --git a/internal/cloudapi/provisioning/test/server.go b/internal/cloudapi/provisioning/test/server.go
