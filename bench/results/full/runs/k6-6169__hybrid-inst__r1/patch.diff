diff --git a/internal/cloudapi/provisioning/errors.go b/internal/cloudapi/provisioning/errors.go
new file mode 100644
index 000000000..89e1b08bd
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,67 @@
+package provisioning
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+var errUnknown = errors.New("an error occurred communicating with k6 Cloud")
+
+// ResponseError represents a non-2xx HTTP response from the provisioning API.
+type ResponseError struct {
+	StatusCode int
+	Body       string
+}
+
+// Error returns a formatted error string containing the status code and response body.
+func (e *ResponseError) Error() string {
+	return fmt.Sprintf("HTTP %d: %s", e.StatusCode, e.Body)
+}
+
+// CheckResponse checks the HTTP response from the provisioning API or upload endpoints.
+// It returns nil on 2xx responses, or a formatted error otherwise.
+func CheckResponse(r *http.Response) error {
+	if r == nil {
+		return errUnknown
+	}
+
+	if c := r.StatusCode; c >= 200 && c <= 299 {
+		return nil
+	}
+
+	data, err := io.ReadAll(r.Body)
+	if err != nil {
+		return err
+	}
+
+	// ClassifyStatus is only used for 401 because 403 must preserve the response body
+	// (e.g. presigned S3 upload expiration details) in a ResponseError.
+	if r.StatusCode == http.StatusUnauthorized {
+		if classified := httperr.ClassifyStatus(r.StatusCode); classified != nil {
+			return classified
+		}
+	}
+
+	return &ResponseError{
+		StatusCode: r.StatusCode,
+		Body:       strings.TrimSpace(string(data)),
+	}
+}
+
+func checkAPIResponse(hr *http.Response, err error) error {
+	if err != nil {
+		var aerr *k6cloud.GenericOpenAPIError
+		if !errors.As(err, &aerr) {
+			return err
+		}
+	}
+
+	return CheckResponse(hr)
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..ac9f7400e
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,141 @@
+package provisioning
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient is a small retrying HTTP client for endpoints not covered by the generated cloud SDK
+// (presigned archive uploads and the metrics ingest endpoint).
+type HTTPClient struct {
+	client        *http.Client
+	token         string
+	version       string
+	logger        logrus.FieldLogger
+	retries       int
+	retryInterval time.Duration
+}
+
+// NewHTTPClient creates a new retrying HTTPClient.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	if client == nil {
+		client = http.DefaultClient
+	}
+
+	return &HTTPClient{
+		client:        client,
+		token:         token,
+		version:       version,
+		logger:        logger,
+		retries:       clientcfg.MaxRetries,
+		retryInterval: clientcfg.RetryInterval,
+	}
+}
+
+// Do executes an HTTP request, retrying on transient errors, and decodes any JSON response into v.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	if req.Body != nil && req.GetBody == nil {
+		originalBody, err := io.ReadAll(req.Body)
+		if err != nil {
+			return err
+		}
+		if err = req.Body.Close(); err != nil {
+			return err
+		}
+
+		req.GetBody = func() (io.ReadCloser, error) {
+			return io.NopCloser(bytes.NewReader(originalBody)), nil
+		}
+		req.Body, _ = req.GetBody()
+	}
+
+	c.prepareHeaders(req)
+
+	for attempt := 1; attempt <= c.retries; attempt++ {
+		retry, err := c.do(req, v, attempt)
+		if retry {
+			select {
+			case <-req.Context().Done():
+				return req.Context().Err()
+			case <-time.After(c.retryInterval):
+			}
+			if req.GetBody != nil {
+				req.Body, _ = req.GetBody()
+			}
+			continue
+		}
+
+		return err
+	}
+
+	return nil
+}
+
+func (c *HTTPClient) prepareHeaders(req *http.Request) {
+	if req.Header.Get("Content-Type") == "" {
+		req.Header.Set("Content-Type", "application/json")
+	}
+
+	req.Header.Set("User-Agent", "k6cloud/"+c.version)
+
+	if c.token != "" {
+		req.Header.Set("Authorization", "Bearer "+c.token)
+	}
+}
+
+func (c *HTTPClient) do(req *http.Request, v any, attempt int) (retry bool, err error) {
+	resp, err := c.client.Do(req)
+
+	defer func() {
+		if resp != nil {
+			_, _ = io.Copy(io.Discard, resp.Body)
+			if cerr := resp.Body.Close(); cerr != nil && err == nil {
+				err = cerr
+			}
+		}
+	}()
+
+	if shouldRetry(resp, err, attempt, c.retries) {
+		return true, err
+	}
+
+	if err != nil {
+		return false, err
+	}
+
+	if err = CheckResponse(resp); err != nil {
+		return false, err
+	}
+
+	if v != nil {
+		if err = json.NewDecoder(resp.Body).Decode(v); errors.Is(err, io.EOF) {
+			err = nil // Ignore EOF from empty body
+		}
+	}
+
+	return false, err
+}
+
+func shouldRetry(resp *http.Response, err error, attempt, maxAttempts int) bool {
+	if attempt >= maxAttempts {
+		return false
+	}
+
+	if resp == nil || err != nil {
+		return true
+	}
+
+	if resp.StatusCode >= 500 || resp.StatusCode == http.StatusTooManyRequests {
+		return true
+	}
+
+	return false
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..aad3e9497
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,82 @@
+package provisioning
+
+import (
+	"context"
+	"errors"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+const (
+	// notifyCodeUnknown indicates an unclassified test error.
+	notifyCodeUnknown int32 = 0
+	// notifyCodeAbortedBySystem indicates a test aborted by output failure or timeout.
+	notifyCodeAbortedBySystem int32 = 8034
+	// notifyCodeAbortedByScriptError indicates a test aborted by a JavaScript or runtime error.
+	notifyCodeAbortedByScriptError int32 = 8035
+	// notifyCodeAbortedByUserOrThreshold indicates a test aborted by user intervention, script abort(), or threshold failure.
+	notifyCodeAbortedByUserOrThreshold int32 = 8036
+)
+
+// notifyError is the error payload of a script_execution_completed notification.
+type notifyError struct {
+	Code   int32
+	Reason string
+}
+
+func mapTestErrorToNotifyCode(err error) *notifyError {
+	if err == nil {
+		return nil
+	}
+
+	var arerr errext.HasAbortReason
+	if errors.As(err, &arerr) {
+		switch arerr.AbortReason() {
+		case errext.AbortedByThresholdsAfterTestEnd:
+			return nil
+		case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+			return &notifyError{
+				Code:   notifyCodeAbortedByUserOrThreshold,
+				Reason: err.Error(),
+			}
+		case errext.AbortedByScriptError:
+			return &notifyError{
+				Code:   notifyCodeAbortedByScriptError,
+				Reason: err.Error(),
+			}
+		case errext.AbortedByOutput, errext.AbortedByTimeout:
+			return &notifyError{
+				Code:   notifyCodeAbortedBySystem,
+				Reason: err.Error(),
+			}
+		}
+	}
+
+	return &notifyError{
+		Code:   notifyCodeUnknown,
+		Reason: err.Error(),
+	}
+}
+
+// NotifyTestRunCompleted reports a test run completion lifecycle event to the provisioning API.
+func (c *Client) NotifyTestRunCompleted(
+	ctx context.Context, testRunID int64, testRunToken string, testErr error,
+) error {
+	body := k6cloud.NewScriptExecutionCompletedNotificationApiModel("script_execution_completed")
+	if nErr := mapTestErrorToNotifyCode(testErr); nErr != nil {
+		apiErr := k6cloud.NewScriptExecutionError(nErr.Code, nErr.Reason)
+		body.SetError(*apiErr)
+	} else {
+		body.SetErrorNil()
+	}
+
+	hr, err := c.apiClient.ProvisioningAPI.
+		TestRunsNotify(c.authCtxWithToken(ctx, testRunToken), testRunID).
+		ScriptExecutionCompletedNotificationApiModel(body).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	return checkAPIResponse(hr, err)
+}
diff --git a/internal/cloudapi/provisioning/provision.go b/internal/cloudapi/provisioning/provision.go
new file mode 100644
index 000000000..97afc62db
--- /dev/null
+++ b/internal/cloudapi/provisioning/provision.go
@@ -0,0 +1,89 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"go.k6.io/k6/v2/lib"
+)
+
+// ProvisionParams are the inputs for provisioning a local execution test run.
+type ProvisionParams struct {
+	Name          string
+	ProjectID     int64
+	MaxVUs        int32
+	TotalDuration int32
+	Options       json.RawMessage
+	Archive       *lib.Archive // nil when --no-archive-upload was given
+	PollInterval  time.Duration
+}
+
+// ProvisionResult is the outcome of a successful provisioning.
+type ProvisionResult struct {
+	TestRunID             int64
+	TestRunDetailsPageURL string
+	RuntimeConfig         RuntimeConfig
+}
+
+// ProvisionLocalExecution orchestrates local execution test run provisioning against the cloud API.
+func (c *Client) ProvisionLocalExecution(ctx context.Context, params ProvisionParams) (*ProvisionResult, error) {
+	// 1. Create or find load test.
+	loadTestID, err := c.v6Client.CreateOrFindLoadTest(ctx, params.ProjectID, params.Name)
+	if err != nil {
+		return nil, fmt.Errorf("create or find load test: %w", err)
+	}
+
+	// 2. Serialize archive if present.
+	var (
+		archiveSize int64
+		buf         bytes.Buffer
+	)
+	if params.Archive != nil {
+		if err := params.Archive.Write(&buf); err != nil {
+			return nil, fmt.Errorf("serialize test archive: %w", err)
+		}
+		archiveSize = int64(buf.Len())
+	}
+
+	// 3. Start local execution test run.
+	sleReq := StartLocalExecutionRequest{
+		Options:       params.Options,
+		MaxVUs:        params.MaxVUs,
+		TotalDuration: params.TotalDuration,
+		ArchiveSize:   archiveSize,
+	}
+	res, err := c.StartLocalExecution(ctx, loadTestID, sleReq)
+	if err != nil {
+		return nil, fmt.Errorf("start local execution: %w", err)
+	}
+
+	// 4. Upload archive if applicable.
+	if params.Archive != nil {
+		if res.ArchiveUploadURL != nil && *res.ArchiveUploadURL != "" {
+			if err := c.UploadArchive(ctx, *res.ArchiveUploadURL, buf.Bytes()); err != nil {
+				return nil, fmt.Errorf("upload archive: %w", err)
+			}
+		} else {
+			c.logger.Warn("Archive was provided, but no archive upload URL was returned by the provisioning API; skipping archive upload")
+		}
+	}
+
+	// 5. Wait for test run to be ready.
+	pollInterval := params.PollInterval
+	if pollInterval <= 0 {
+		pollInterval = time.Second
+	}
+	if err := c.WaitForTestRunReady(ctx, res.TestRunID, pollInterval); err != nil {
+		return nil, fmt.Errorf("wait for test run ready: %w", err)
+	}
+
+	// 6. Return provision result.
+	return &ProvisionResult{
+		TestRunID:             res.TestRunID,
+		TestRunDetailsPageURL: res.TestRunDetailsPageURL,
+		RuntimeConfig:         res.RuntimeConfig,
