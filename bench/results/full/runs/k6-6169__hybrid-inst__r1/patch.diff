diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..a5b366720
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,148 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// StartLocalExecutionRequest is the payload for starting a local execution test run.
+type StartLocalExecutionRequest struct {
+	Options       json.RawMessage
+	MaxVUs        int32
+	TotalDuration int32
+	ArchiveSize   int64 // 0 means no archive; sent as an explicit JSON null
+}
+
+// StartLocalExecutionResponse is the provisioning API start response.
+type StartLocalExecutionResponse struct {
+	TestRunID             int64
+	ArchiveUploadURL      *string
+	TestRunDetailsPageURL string
+	RuntimeConfig         RuntimeConfig
+}
+
+// StartLocalExecution starts a local execution test run on the cloud provisioning API.
+func (c *Client) StartLocalExecution(
+	ctx context.Context, loadTestID int64, req StartLocalExecutionRequest,
+) (*StartLocalExecutionResponse, error) {
+	opts := make(map[string]interface{})
+	if len(req.Options) > 0 {
+		if err := json.Unmarshal(req.Options, &opts); err != nil {
+			return nil, fmt.Errorf("unmarshal options: %w", err)
+		}
+	}
+
+	apiReq := k6cloud.NewStartLocalExecutionTestRequest(opts, req.MaxVUs, req.TotalDuration)
+	if req.ArchiveSize > 0 {
+		if req.ArchiveSize > math.MaxInt32 {
+			return nil, fmt.Errorf("archive size %d overflows int32", req.ArchiveSize)
+		}
+		apiReq.SetArchiveSize(int32(req.ArchiveSize))
+	} else {
+		apiReq.SetArchiveSizeNil()
+	}
+
+	b := make([]byte, 8)
+	if _, err := rand.Read(b); err != nil {
+		return nil, fmt.Errorf("generate idempotency key: %w", err)
+	}
+	idempotencyKey := hex.EncodeToString(b)
+
+	res, hr, err := c.apiClient.ProvisioningAPI.
+		StartLocalExecutionTest(c.authCtx(ctx), loadTestID).
+		StartLocalExecutionTestRequest(apiReq).
+		K6IdempotencyKey(idempotencyKey).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if err := checkAPIResponse(hr, err); err != nil {
+		return nil, err
+	}
+	if res == nil {
+		return nil, errUnknown
+	}
+
+	var uploadURL *string
+	if val, ok := res.GetArchiveUploadUrlOk(); ok && val != nil {
+		s := *val
+		uploadURL = &s
+	}
+
+	return &StartLocalExecutionResponse{
+		TestRunID:             res.GetTestRunId(),
+		ArchiveUploadURL:      uploadURL,
+		TestRunDetailsPageURL: res.GetTestRunDetailsPageUrl(),
+		RuntimeConfig:         runtimeConfigFromAPI(res.GetRuntimeConfig()),
+	}, nil
+}
+
+// UploadArchive uploads the test archive tarball to the presigned upload URL.
+func (c *Client) UploadArchive(ctx context.Context, uploadURL string, archive []byte) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPut, uploadURL, bytes.NewReader(archive))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/x-tar")
+	req.ContentLength = int64(len(archive))
+	req.GetBody = func() (io.ReadCloser, error) {
+		return io.NopCloser(bytes.NewReader(archive)), nil
+	}
+	return c.uploader.Do(req, nil)
+}
+
+// WaitForTestRunReady polls the test run progress until it reaches an active or terminal state.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	lastStatus := v6.Status("")
+	for {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		tp, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			if ctx.Err() != nil {
+				return ctx.Err() // callers must get context.Canceled
+			}
+			return err
+		}
+		switch tp.Status {
+		case v6.StatusInitializing, v6.StatusRunning:
+			return nil
+		case v6.StatusAborted:
+			var msg string
+			for _, ev := range tp.StatusHistory {
+				if ev.Message != "" {
+					msg = ev.Message
+				}
+			}
+			if msg != "" {
+				return fmt.Errorf("test run aborted before starting: %s", msg)
+			}
+			return errors.New("test run aborted before starting")
+		case v6.StatusCompleted, v6.StatusProcessingMetrics:
+			return fmt.Errorf("test run is already %s", tp.Status)
+		default:
+			if tp.Status != lastStatus {
+				lastStatus = tp.Status
+				c.logger.WithField("status", tp.FormatStatus()).Info("Waiting for the cloud test run to be ready...")
+			}
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(pollInterval):
+		}
+	}
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..46a7c095e
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,88 @@
+package provisioning
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client talks to the Grafana Cloud k6 provisioning API.
+type Client struct {
+	apiClient *k6cloud.APIClient
+	v6Client  *v6.Client
+	token     string
+	stackID   int64
+	logger    logrus.FieldLogger
+	uploader  *HTTPClient
+}
+
+// NewClient returns a new client for the provisioning API.
+func NewClient(logger logrus.FieldLogger, token, host, version string, stackID int64, timeout time.Duration) (*Client, error) {
+	if token == "" {
+		return nil, fmt.Errorf("token is required to create cloud API client")
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Global k6 Cloud API.",
+		},
+	}
+	cfg.HTTPClient = &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+	if stackID != 0 {
+		cfg.AddDefaultHeader("X-Stack-Id", strconv.FormatInt(stackID, 10))
+	}
+
+	v6c, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if err := v6c.SetStackID(stackID); err != nil {
+		return nil, err
+	}
+
+	uploader := NewHTTPClient(&http.Client{Timeout: timeout}, "", version, logger)
+
+	return &Client{
+		apiClient: k6cloud.NewAPIClient(cfg),
+		v6Client:  v6c,
+		token:     token,
+		stackID:   stackID,
+		logger:    logger,
+		uploader:  uploader,
+	}, nil
+}
+
+func (c *Client) authCtx(ctx context.Context) context.Context {
+	return c.authCtxWithToken(ctx, c.token)
+}
+
+func (c *Client) authCtxWithToken(ctx context.Context, token string) context.Context {
+	return context.WithValue(ctx, k6cloud.ContextAccessToken, token)
+}
+
+func closeResponse(res *http.Response, rerr *error) {
+	if res == nil {
+		return
+	}
+	_, _ = io.Copy(io.Discard, res.Body)
+	if err := res.Body.Close(); err != nil && *rerr == nil {
+		*rerr = err
+	}
+}
