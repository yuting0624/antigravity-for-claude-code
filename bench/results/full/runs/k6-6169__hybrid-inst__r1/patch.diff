+// CreateOrFindLoadTest makes sure a load test named name exists in the given
+// project and returns its id.
+//
+// Unlike UploadTest it never sends a script: local execution uploads the test
+// archive out of band, through the presigned URL the provisioning API returns.
+// On a 409 conflict the existing test is looked up by its exact name.
+func (c *Client) CreateOrFindLoadTest(ctx context.Context, projectID int64, name string) (int64, error) {
+	lt, err := c.createTestWithoutScript(ctx, projectID, name)
+	if err == nil {
+		return lt.GetId(), nil
+	}
+
+	var rerr ResponseError
+	if !errors.As(err, &rerr) || rerr.Response == nil || rerr.Response.StatusCode != http.StatusConflict {
+		return 0, err
+	}
+
+	lt, err = c.findTestByName(ctx, projectID, name)
+	if err != nil {
+		return 0, err
+	}
+
+	return lt.GetId(), nil
+}
+
+// createTestWithoutScript creates a new cloud load test with no script attached.
+func (c *Client) createTestWithoutScript(
+	ctx context.Context, projectID int64, name string,
+) (_ *k6cloud.LoadTestApiModel, err error) {
+	res, hr, err := c.apiClient.LoadTestsAPI.
+		ProjectsLoadTestsCreate(c.authCtx(ctx), projectID).
+		XStackId(c.stackID).
+		Name(name).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if err := CheckResponse(hr, err); err != nil {
+		return nil, err
+	}
+	if res == nil {
+		return nil, errUnknown
+	}
+
+	return res, nil
+}
