@@ -0,0 +1,68 @@
+package provisioning
+
+import (
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+)
+
+// RuntimeConfig is the runtime configuration returned by the provisioning API
+// when a local execution test run is started.
+type RuntimeConfig struct {
+	Metrics      MetricsConfig
+	TestRunToken string
+	Secrets      SecretsConfig
+}
+
+// MetricsConfig is the metrics ingest configuration for a test run.
+type MetricsConfig struct {
+	PushURL               string
+	PushInterval          *string
+	PushConcurrency       *int32
+	AggregationPeriod     *string
+	AggregationWaitPeriod *string
+	AggregationMinSamples *int32
+	MaxSamplesPerPackage  *int32
+}
+
+// SecretsConfig is the cloud secrets configuration for a test run.
+type SecretsConfig struct {
+	Endpoint     string
+	ResponsePath string
+}
+
+func stringPtr(val *string, ok bool) *string {
+	if !ok || val == nil {
+		return nil
+	}
+	s := *val
+	return &s
+}
+
+func int32Ptr(val *int32, ok bool) *int32 {
+	if !ok || val == nil {
+		return nil
+	}
+	i := *val
+	return &i
+}
+
+func runtimeConfigFromAPI(rc k6cloud.RuntimeConfig) RuntimeConfig {
+	m := rc.GetMetrics()
+	s := rc.GetSecrets()
+
+	return RuntimeConfig{
+		Metrics: MetricsConfig{
+			PushURL:               m.GetPushUrl(),
+			PushInterval:          stringPtr(m.GetPushIntervalOk()),
+			PushConcurrency:       int32Ptr(m.GetPushConcurrencyOk()),
+			AggregationPeriod:     stringPtr(m.GetAggregationPeriodOk()),
+			AggregationWaitPeriod: stringPtr(m.GetAggregationWaitPeriodOk()),
+			AggregationMinSamples: int32Ptr(m.GetAggregationMinSamplesOk()),
+			MaxSamplesPerPackage:  int32Ptr(m.GetMaxSamplesPerPackageOk()),
+		},
+		TestRunToken: rc.GetTestRunToken(),
+		Secrets: SecretsConfig{
+			Endpoint:     s.GetEndpoint(),
+			ResponsePath: s.GetResponsePath(),
+		},
+	}
+}
