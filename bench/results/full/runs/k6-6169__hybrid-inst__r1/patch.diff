new file mode 100644
index 000000000..71fabd733
--- /dev/null
+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,182 @@
+// Package provtest provides an HTTP test server that simulates the cloud API
+// endpoints used during the local-execution provisioning flow.
+//
+// It keeps cloud-specific wire encoding out of provisioning tests, allowing
+// tests to mock load test creation, execution starts, presigned archive uploads,
+// and polling of test run progress.
+package provtest
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	// DefaultLoadTestID is the default load test ID used in provisioning tests.
+	DefaultLoadTestID int64 = 456
+	// DefaultTestRunID is the default test run ID used in provisioning tests.
+	DefaultTestRunID int64 = 123
+)
+
+// PresignedUploadPath is the default URL path for presigned archive uploads.
+const PresignedUploadPath = "/presigned/archive-upload"
+
+// Server is a test HTTP server for the provisioning API.
+type Server struct {
+	*httptest.Server
+	Mux *http.ServeMux
+
+	mu                   sync.Mutex
+	fetchTestRunHitCount atomic.Int32
+	progressIndex        int
+}
+
+// NewServer creates a new test server for the provisioning API.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+
+	mux := http.NewServeMux()
+	srv := httptest.NewServer(mux)
+	t.Cleanup(srv.Close)
+
+	return &Server{
+		Server: srv,
+		Mux:    mux,
+	}
+}
+
+// PresignedUploadURL returns the full URL for archive uploads on this server.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// HandleCreateLoadTest registers a handler on the project load tests endpoint.
+func (s *Server) HandleCreateLoadTest(projectID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID), h)
+}
+
+// HandleStartLocalExecution registers a handler on the start local execution endpoint.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/load_tests/%d/start_local_execution", loadTestID), h)
+}
+
+// HandlePresignedUpload registers a handler on the given presigned upload path.
+func (s *Server) HandlePresignedUpload(path string, h http.HandlerFunc) {
+	s.Mux.HandleFunc(path, h)
+}
+
+// HandleNotify registers a handler on the test run notification endpoint.
+func (s *Server) HandleNotify(testRunID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/test_runs/%d/notify", testRunID), h)
+}
+
+// HandleFetchTestRun registers a handler that simulates polling test run progress.
+func (s *Server) HandleFetchTestRun(testRunID int64, progresses []v6.TestProgress) {
+	progs := slices.Clone(progresses)
+
+	s.mu.Lock()
+	s.progressIndex = 0
+	s.mu.Unlock()
+
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/test_runs/%d", testRunID), func(w http.ResponseWriter, _ *http.Request) {
+		s.fetchTestRunHitCount.Add(1)
+
+		s.mu.Lock()
+		var tp v6.TestProgress
+		if len(progs) > 0 {
+			if s.progressIndex < len(progs) {
+				tp = progs[s.progressIndex]
+				s.progressIndex++
+			} else {
+				tp = progs[len(progs)-1]
+			}
+		}
+		s.mu.Unlock()
+
+		res := k6cloud.NewTestRunApiModelWithDefaults()
+		res.SetStatus(tp.Status.String())
+		res.SetResult(tp.Result.String())
+		res.SetEstimatedDuration(tp.EstimatedDuration)
+		res.SetExecutionDuration(tp.ExecutionDuration)
+		res.SetStatusHistory(v6.ToStatusModel(tp.StatusHistory))
+		res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+		res.SetResultDetails(k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(k6cloud.NewResultDetailsApiModel("")))
+		res.SetOptions(map[string]any{})
+
+		writeJSON(w, http.StatusOK, res)
+	})
+}
+
+// FetchTestRunHitCount returns the number of times the fetch test run endpoint was called.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchTestRunHitCount.Load()
+}
+
+// DefaultStartLocalExecutionResponse builds a fully populated start local execution response.
+func DefaultStartLocalExecutionResponse() *k6cloud.StartLocalExecutionTestResponse {
+	metrics := k6cloud.NewMetricsRuntimeConfigWithDefaults()
+	metrics.SetPushUrl("https://ingest.k6.io/v1/metrics")
+	metrics.SetPushInterval("2s")
+	metrics.SetPushConcurrency(5)
+	metrics.SetAggregationPeriod("3s")
+	metrics.SetAggregationWaitPeriod("1s")
+	metrics.SetMaxSamplesPerPackage(2000)
+
+	traces := k6cloud.NewTracesRuntimeConfigWithDefaults()
+	traces.SetPushUrl("")
+	traces.SetTracesMetadata(map[string]string{})
+	traces.SetProto("")
+
+	files := k6cloud.NewFilesRuntimeConfigWithDefaults()
+	files.SetPushUrl("")
+	files.SetScreenshotsBasePath("")
+	files.SetHeaders(map[string]string{})
+	files.SetMethod("")
+
+	logs := k6cloud.NewLogsRuntimeConfigWithDefaults()
+	logs.SetPushUrl("")
+	logs.SetTailUrl("")
+	logs.SetLimit(0)
+	logs.SetPushPeriodSeconds("")
+	logs.SetLevel("")
+	logs.SetMessageMaxSize(0)
+	logs.SetAllowedLabels([]string{})
+
+	secrets := k6cloud.NewSecretsRuntimeConfigWithDefaults()
+	secrets.SetEndpoint("https://api.k6.io/provisioning/v1/test_runs/123/decrypt_secret?name={key}")
+	secrets.SetResponsePath("plaintext")
+
+	rc := k6cloud.NewRuntimeConfigWithDefaults()
+	rc.SetMetrics(*metrics)
+	rc.SetTraces(*traces)
+	rc.SetFiles(*files)
+	rc.SetLogs(*logs)
+	rc.SetSecrets(*secrets)
+	rc.SetTestRunToken("test-run-token-abc")
+
+	resp := k6cloud.NewStartLocalExecutionTestResponseWithDefaults()
+	resp.SetTestRunId(DefaultTestRunID)
+	resp.SetArchiveUploadUrl("https://s3.amazonaws.com/k6-archives/456/archive.tar?X-Amz-Signature=deadbeef")
+	resp.SetTestRunDetailsPageUrl(fmt.Sprintf("https://app.k6.io/runs/%d", DefaultTestRunID))
+	resp.SetRuntimeConfig(*rc)
+
+	return resp
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	if err := json.NewEncoder(w).Encode(v); err != nil {
+		panic(fmt.Errorf("provtest: encoding JSON: %w", err))
+	}
+}
