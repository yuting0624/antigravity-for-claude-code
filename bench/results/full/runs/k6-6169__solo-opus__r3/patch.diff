diff --git a/internal/cloudapi/clientcfg/clientcfg.go b/internal/cloudapi/clientcfg/clientcfg.go
new file mode 100644
index 000000000..39b73398f
--- /dev/null
+++ b/internal/cloudapi/clientcfg/clientcfg.go
@@ -0,0 +1,14 @@
+// Package clientcfg holds the HTTP retry settings shared by the k6 Cloud API
+// clients (internal/cloudapi/v6, internal/cloudapi/provisioning), so that every
+// client talking to the Cloud backs off the same way.
+package clientcfg
+
+import "time"
+
+const (
+	// RetryInterval is the default cloud request retry interval.
+	RetryInterval = 500 * time.Millisecond
+
+	// MaxRetries specifies the max number of retry attempts.
+	MaxRetries = 3
+)
diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..3c4007520
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,313 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// defaultPollInterval is how often the test run is polled while waiting for
+// the cloud to be ready to receive metrics.
+const defaultPollInterval = time.Second
+
+// archiveContentType is the content type of the k6 archive uploaded to the
+// presigned URL.
+const archiveContentType = "application/x-tar"
+
+// MetricsConfig is the metrics section of the runtime configuration handed out
+// by the provisioning API. Only PushURL is guaranteed to be set; the tuning
+// fields are optional overrides.
+type MetricsConfig struct {
+	PushURL               string
+	PushInterval          *string
+	PushConcurrency       *int32
+	AggregationPeriod     *string
+	AggregationWaitPeriod *string
+	AggregationMinSamples *int32
+	MaxSamplesPerPackage  *int32
+}
+
+// SecretsConfig is the secrets section of the runtime configuration.
+type SecretsConfig struct {
+	Endpoint     string
+	ResponsePath string
+}
+
+// RuntimeConfig is the subset of the provisioning API's runtime configuration
+// a locally executed test run needs.
+type RuntimeConfig struct {
+	Metrics MetricsConfig
+
+	// TestRunToken is a short-lived token scoped to this test run. It is what
+	// authenticates the metrics pushes, the secret lookups and the end-of-test
+	// notification.
+	TestRunToken string
+
+	Secrets SecretsConfig
+}
+
+// StartLocalExecutionRequest describes the test that is about to run locally.
+type StartLocalExecutionRequest struct {
+	// Options is the resolved script options, as JSON.
+	Options json.RawMessage
+
+	// MaxVUs is the maximum number of VUs the test can reach.
+	MaxVUs int32
+
+	// TotalDuration is the total duration of the test, in seconds.
+	TotalDuration int32
+
+	// ArchiveSize is the size of the test archive in bytes. Zero means no
+	// archive is going to be uploaded and is sent as an explicit JSON null.
+	ArchiveSize int64
+}
+
+// StartLocalExecutionResponse is what the provisioning API returns once the
+// test run has been created.
+type StartLocalExecutionResponse struct {
+	// TestRunID identifies the newly created test run.
+	TestRunID int64
+
+	// ArchiveUploadURL is the presigned URL the test archive has to be PUT to.
+	// It is nil when the backend does not expect an archive.
+	ArchiveUploadURL *string
+
+	// TestRunDetailsPageURL is the URL of the test run's page.
+	TestRunDetailsPageURL string
+
+	RuntimeConfig RuntimeConfig
+}
+
+// StartLocalExecution creates a test run for the given load test, in local
+// execution mode.
+func (c *Client) StartLocalExecution(
+	ctx context.Context, loadTestID int64, req StartLocalExecutionRequest,
+) (_ *StartLocalExecutionResponse, err error) {
+	body, err := newStartLocalExecutionTestRequest(req)
+	if err != nil {
+		return nil, err
+	}
+
+	key, err := idempotencyKey()
+	if err != nil {
+		return nil, err
+	}
+
+	res, hr, err := c.apiClient.ProvisioningAPI.
+		StartLocalExecutionTest(c.authCtx(ctx), loadTestID).
+		StartLocalExecutionTestRequest(body).
+		K6IdempotencyKey(key).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if rerr := checkAPIResponse(hr, err); rerr != nil {
+		return nil, rerr
+	}
+	if res == nil {
+		return nil, errUnknown
+	}
+
+	return newStartLocalExecutionResponse(res), nil
+}
+
+// NotifyTestRunCompleted tells the provisioning API that the local script
+// execution is over. The request is authenticated with the test run's own
+// token, not with the user's long-lived one.
+func (c *Client) NotifyTestRunCompleted(
+	ctx context.Context, testRunID int64, testRunToken string, testErr error,
+) (err error) {
+	body := k6cloud.NewScriptExecutionCompletedNotificationApiModel(scriptExecutionCompletedEvent)
+	if ne := mapTestErrorToNotifyCode(testErr); ne != nil {
+		body.SetError(*k6cloud.NewScriptExecutionError(ne.Code, ne.Reason))
+	}
+
+	hr, err := c.apiClient.ProvisioningAPI.
+		TestRunsNotify(c.tokenCtx(ctx, testRunToken), testRunID).
+		ScriptExecutionCompletedNotificationApiModel(body).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	return checkAPIResponse(hr, err)
+}
+
+// UploadArchive uploads the test archive to a presigned URL. Presigned URLs
+// carry their own credentials, so the request is deliberately sent without an
+// Authorization header.
+func (c *Client) UploadArchive(ctx context.Context, uploadURL string, archive []byte) error {
+	for attempt := 0; ; attempt++ {
+		if attempt > 0 {
+			if err := waitBeforeRetry(ctx); err != nil {
+				return err
+			}
+		}
+
+		req, err := http.NewRequestWithContext(ctx, http.MethodPut, uploadURL, bytes.NewReader(archive))
+		if err != nil {
+			return err
+		}
+		req.Header.Set("Content-Type", archiveContentType)
+		req.ContentLength = int64(len(archive))
+
+		//nolint:bodyclose // the body is closed by drainAndClose below
+		res, err := c.httpClient.Do(req)
+		if err != nil {
+			if ctxErr := ctx.Err(); ctxErr != nil {
+				return ctxErr
+			}
+			if attempt >= clientcfg.MaxRetries {
+				return err
+			}
+			c.logger.WithError(err).Debug("Uploading the test archive failed, retrying")
+			continue
+		}
+
+		rerr := CheckResponse(res)
+		drainAndClose(res)
+		if rerr == nil {
+			return nil
+		}
+
+		var respErr *ResponseError
+		if errors.As(rerr, &respErr) &&
+			respErr.StatusCode >= http.StatusInternalServerError &&
+			attempt < clientcfg.MaxRetries {
+			continue
+		}
+
+		return rerr
+	}
+}
+
+// WaitForTestRunReady polls the test run until the cloud reports it as ready
+// to receive the locally generated metrics.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	if pollInterval <= 0 {
+		pollInterval = defaultPollInterval
+	}
+
+	var lastStatus v6.Status
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+
+		progress, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			if ctxErr := ctx.Err(); ctxErr != nil {
+				return ctxErr
+			}
+			return fmt.Errorf("fetching the test run %d: %w", testRunID, err)
+		}
+
+		switch progress.Status {
+		case v6.StatusInitializing, v6.StatusRunning:
+			return nil
+		case v6.StatusAborted:
+			return abortedBeforeStartError(progress)
+		case v6.StatusCompleted:
+			return fmt.Errorf("the test run %d completed before the local execution could start", testRunID)
+		default:
+			if progress.Status != lastStatus {
+				lastStatus = progress.Status
+				c.logger.WithField("status", progress.FormatStatus()).
+					Info("Waiting for the cloud test run to be ready")
+			}
+		}
+
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(pollInterval):
+		}
+	}
+}
+
+// abortedBeforeStartError builds the error for a test run the cloud aborted
+// while k6 was still waiting for it, preferring the backend's own message.
+func abortedBeforeStartError(progress *v6.TestProgress) error {
+	for i := len(progress.StatusHistory) - 1; i >= 0; i-- {
+		event := progress.StatusHistory[i]
+		if event.Status == v6.StatusAborted && event.Message != "" {
+			return fmt.Errorf("test run aborted before starting: %s", event.Message)
+		}
+	}
+
+	return errors.New("test run aborted before starting")
+}
+
+func newStartLocalExecutionTestRequest(
+	req StartLocalExecutionRequest,
+) (*k6cloud.StartLocalExecutionTestRequest, error) {
+	options := map[string]any{}
+	if len(req.Options) > 0 {
+		if err := json.Unmarshal(req.Options, &options); err != nil {
+			return nil, fmt.Errorf("encoding the script options: %w", err)
+		}
+	}
+
+	body := k6cloud.NewStartLocalExecutionTestRequest(options, req.MaxVUs, req.TotalDuration)
+	switch {
+	case req.ArchiveSize <= 0:
+		// The backend distinguishes "no archive" from "an empty archive": the
+		// key has to be present and explicitly null.
+		body.SetArchiveSizeNil()
+	case req.ArchiveSize > math.MaxInt32:
+		return nil, fmt.Errorf("the test archive is too large: %d bytes", req.ArchiveSize)
+	default:
+		body.SetArchiveSize(int32(req.ArchiveSize))
+	}
+
+	return body, nil
+}
+
+func newStartLocalExecutionResponse(res *k6cloud.StartLocalExecutionTestResponse) *StartLocalExecutionResponse {
+	runtimeConfig := res.GetRuntimeConfig()
+	metrics := runtimeConfig.GetMetrics()
+	secrets := runtimeConfig.GetSecrets()
+
+	out := &StartLocalExecutionResponse{
+		TestRunID:             res.GetTestRunId(),
+		TestRunDetailsPageURL: res.GetTestRunDetailsPageUrl(),
+		RuntimeConfig: RuntimeConfig{
+			TestRunToken: runtimeConfig.GetTestRunToken(),
+			Metrics: MetricsConfig{
+				PushURL:               metrics.GetPushUrl(),
+				PushInterval:          metrics.PushInterval.Get(),
+				PushConcurrency:       metrics.PushConcurrency.Get(),
+				AggregationPeriod:     metrics.AggregationPeriod.Get(),
+				AggregationWaitPeriod: metrics.AggregationWaitPeriod.Get(),
+				AggregationMinSamples: metrics.AggregationMinSamples.Get(),
+				MaxSamplesPerPackage:  metrics.MaxSamplesPerPackage.Get(),
+			},
+			Secrets: SecretsConfig{
+				Endpoint:     secrets.GetEndpoint(),
+				ResponsePath: secrets.GetResponsePath(),
+			},
+		},
+	}
+	if res.ArchiveUploadUrl.IsSet() {
+		out.ArchiveUploadURL = res.ArchiveUploadUrl.Get()
+	}
+
+	return out
+}
+
+func idempotencyKey() (string, error) {
+	var key [8]byte
+	if _, err := rand.Read(key[:]); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(key[:]), nil
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..41e6eee6f
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,102 @@
+package provisioning
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client handles communication with the k6 Cloud provisioning API.
+//
+// It owns a v6 client too, because provisioning a local execution also needs
+// the v6 load-test and test-run endpoints.
+type Client struct {
+	apiClient *k6cloud.APIClient
+	v6Client  *v6.Client
+
+	// httpClient is the plain client used for requests that must not carry
+	// the SDK's authentication, most notably the presigned archive upload.
+	httpClient *http.Client
+
+	token   string
+	stackID int64
+
+	logger logrus.FieldLogger
+}
+
+// NewClient returns a new client for the k6 Cloud provisioning API.
+func NewClient(
+	logger logrus.FieldLogger, token, host, version string, stackID int64, timeout time.Duration,
+) (*Client, error) {
+	if token == "" {
+		return nil, errors.New("token is required to create the cloud provisioning API client")
+	}
+
+	httpClient := &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Global k6 Cloud API.",
+		},
+	}
+	cfg.HTTPClient = httpClient
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+	if stackID != 0 {
+		// The provisioning endpoints are scoped by stack, but the generated
+		// SDK does not expose the header as a request parameter for them.
+		cfg.AddDefaultHeader("X-Stack-Id", strconv.FormatInt(stackID, 10))
+	}
+
+	v6Client, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if err := v6Client.SetStackID(stackID); err != nil {
+		return nil, err
+	}
+
+	return &Client{
+		apiClient:  k6cloud.NewAPIClient(cfg),
+		v6Client:   v6Client,
+		httpClient: httpClient,
+		token:      token,
+		stackID:    stackID,
+		logger:     logger,
+	}, nil
+}
+
+// authCtx returns a context carrying the long-lived cloud token.
+func (c *Client) authCtx(ctx context.Context) context.Context {
+	return c.tokenCtx(ctx, c.token)
+}
+
+// tokenCtx returns a context carrying the given bearer token.
+func (c *Client) tokenCtx(ctx context.Context, token string) context.Context {
+	return context.WithValue(ctx, k6cloud.ContextAccessToken, token)
+}
+
+func closeResponse(res *http.Response, rerr *error) {
+	if res == nil {
+		return
+	}
+	_, _ = io.Copy(io.Discard, res.Body)
+	if err := res.Body.Close(); err != nil && *rerr == nil {
+		*rerr = err
+	}
+}
