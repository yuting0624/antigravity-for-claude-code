--- /dev/null
+++ b/internal/cloudapi/provisioning/doc.go
@@ -0,0 +1,11 @@
+// Package provisioning orchestrates the k6 Cloud calls needed to run a test
+// locally while streaming its results to Grafana Cloud k6.
+//
+// It composes the v6 load-test API (creating or finding the load test, polling
+// the test run) with the provisioning API (starting the local execution,
+// uploading the archive, notifying the end of the script execution) behind a
+// single entry point, [Client.ProvisionLocalExecution].
+//
+// The cloud-execution path (`k6 cloud run` without --local-execution) and the
+// legacy `k6 run --out cloud` path do not go through this package.
+package provisioning
diff --git a/internal/cloudapi/provisioning/errors.go b/internal/cloudapi/provisioning/errors.go
new file mode 100644
index 000000000..6fcb8aac5
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,79 @@
+package provisioning
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+var errUnknown = errors.New("an error occurred communicating with k6 Cloud")
+
+// ResponseError is an unsuccessful HTTP response from one of the endpoints
+// this package talks to.
+//
+// The provisioning API and the presigned archive upload do not share a single
+// error body shape, so the raw body is kept verbatim to make sure whatever the
+// remote service reported reaches the user.
+type ResponseError struct {
+	// StatusCode is the HTTP status code of the response.
+	StatusCode int
+
+	// Body is the raw response body.
+	Body string
+}
+
+// Error implements the error interface.
+func (e *ResponseError) Error() string {
+	msg := fmt.Sprintf("unexpected response from k6 Cloud: %d %s", e.StatusCode, http.StatusText(e.StatusCode))
+	if e.Body != "" {
+		msg += ": " + e.Body
+	}
+	return msg
+}
+
+// Unwrap classifies authentication and authorization failures the same way the
+// v6 client does, so callers can match them with [errors.Is] without having to
+// know the status code.
+func (e *ResponseError) Unwrap() error {
+	return httperr.ClassifyStatus(e.StatusCode)
+}
+
+// CheckResponse returns nil when the response status is in the successful
+// range, and a [*ResponseError] carrying the status code and the raw body
+// otherwise.
+func CheckResponse(r *http.Response) error {
+	if r == nil {
+		return errUnknown
+	}
+
+	if c := r.StatusCode; c >= 200 && c <= 299 {
+		return nil
+	}
+
+	data, err := io.ReadAll(r.Body)
+	if err != nil {
+		return err
+	}
+
+	return &ResponseError{StatusCode: r.StatusCode, Body: strings.TrimSpace(string(data))}
+}
+
+// checkAPIResponse adapts the (response, error) pair returned by the generated
+// SDK: transport-level failures are returned as they are, while the errors the
+// SDK builds from an unsuccessful response are replaced by a [*ResponseError].
+func checkAPIResponse(r *http.Response, err error) error {
+	if err != nil {
+		var aerr *k6cloud.GenericOpenAPIError
+		if !errors.As(err, &aerr) {
+			return err
+		}
+	}
+
+	return CheckResponse(r)
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..10c20d91b
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,130 @@
+package provisioning
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// defaultHTTPTimeout is used when the caller does not provide its own
+// [http.Client].
+const defaultHTTPTimeout = time.Minute
+
+// HTTPClient performs requests scoped to a single test run: it authenticates
+// with the short-lived test-run token handed out by the provisioning API
+// instead of the user's long-lived cloud token.
+//
+// It is what the cloud output uses to push metrics to the runtime config's
+// push URL, so it implements the same Do(request, target) contract as the
+// legacy cloudapi.Client.
+type HTTPClient struct {
+	client  *http.Client
+	token   string
+	version string
+	logger  logrus.FieldLogger
+}
+
+// NewHTTPClient returns an [HTTPClient] authenticating with the given
+// test-run token. A nil client falls back to a default one.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	if client == nil {
+		client = &http.Client{Timeout: defaultHTTPTimeout, Transport: http.DefaultTransport}
+	}
+
+	return &HTTPClient{
+		client:  client,
+		token:   token,
+		version: version,
+		logger:  logger,
+	}
+}
+
+// Do sends the request, retrying transient failures, and decodes a JSON
+// response body into v when v is not nil.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	req.Header.Set("Authorization", "Bearer "+c.token)
+	req.Header.Set("User-Agent", "k6cloud/"+c.version)
+
+	ctx := req.Context()
+
+	for attempt := 0; ; attempt++ {
+		if attempt > 0 {
+			// http.Client.Do consumes the body, so it has to be rewound
+			// before every retry. GetBody is non-nil only for rewindable
+			// bodies; streaming ones are left untouched.
+			if req.GetBody != nil {
+				body, err := req.GetBody()
+				if err != nil {
+					return err
+				}
+				req.Body = body
+			}
+			if err := waitBeforeRetry(ctx); err != nil {
+				return err
+			}
+		}
+
+		//nolint:bodyclose // the body is closed by decodeResponse or drainAndClose
+		res, err := c.client.Do(req)
+		if err != nil {
+			if ctxErr := ctx.Err(); ctxErr != nil {
+				return ctxErr
+			}
+			if attempt >= clientcfg.MaxRetries {
+				return err
+			}
+			c.logger.WithError(err).Debug("Request to k6 Cloud failed, retrying")
+			continue
+		}
+
+		if res.StatusCode >= http.StatusInternalServerError && attempt < clientcfg.MaxRetries {
+			drainAndClose(res)
+			continue
+		}
+
+		return decodeResponse(res, v)
+	}
+}
+
+// decodeResponse checks the response status and, on success, decodes the body
+// into v when v is not nil.
+func decodeResponse(res *http.Response, v any) error {
+	defer drainAndClose(res)
+
+	if err := CheckResponse(res); err != nil {
+		return err
+	}
+	if v == nil {
+		return nil
+	}
+
+	return json.NewDecoder(res.Body).Decode(v)
+}
+
+// waitBeforeRetry sleeps for the retry interval, returning early when the
+// context is done so a cancellation is not delayed by the backoff.
+func waitBeforeRetry(ctx context.Context) error {
+	t := time.NewTimer(clientcfg.RetryInterval)
+	defer t.Stop()
+
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-t.C:
+		return nil
+	}
+}
+
+func drainAndClose(res *http.Response) {
+	if res == nil {
+		return
+	}
+	_, _ = io.Copy(io.Discard, res.Body)
+	_ = res.Body.Close()
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..cfa8f98fd
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,62 @@
+package provisioning
+
+import (
+	"errors"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+// scriptExecutionCompletedEvent is the only event type k6 reports to the
+// provisioning API at the end of a locally executed test run.
+const scriptExecutionCompletedEvent = "script_execution_completed"
+
+// Error codes understood by the provisioning API's notify endpoint.
+const (
+	// notifyCodeSystemAbort covers an execution stopped by something outside
+	// the script itself: a timeout or a failing output.
+	notifyCodeSystemAbort int32 = 8034
+
+	// notifyCodeScriptError covers an execution stopped by a script error.
+	notifyCodeScriptError int32 = 8035
+
+	// notifyCodeAborted covers an execution deliberately stopped, by the user
+	// or by the script (test.abort(), an abortOnFail threshold).
+	notifyCodeAborted int32 = 8036
+)
+
+// notifyError is the error payload of a script_execution_completed event.
+type notifyError struct {
+	Code   int32
+	Reason string
+}
+
+// mapTestErrorToNotifyCode translates the error k6 stopped the test with into
+// the code the provisioning API expects. It returns nil when the test run is
+// to be reported as completed without an error: either nothing went wrong, or
+// only the thresholds failed once the test had already ended, which the cloud
+// tracks as a result and not as a run failure.
+func mapTestErrorToNotifyCode(testErr error) *notifyError {
+	if testErr == nil {
+		return nil
+	}
+
+	var withReason errext.HasAbortReason
+	if !errors.As(testErr, &withReason) {
+		return &notifyError{Reason: testErr.Error()}
+	}
+
+	switch withReason.AbortReason() {
+	case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+		return &notifyError{Code: notifyCodeAborted, Reason: testErr.Error()}
+	case errext.AbortedByScriptError:
+		return &notifyError{Code: notifyCodeScriptError, Reason: testErr.Error()}
+	case errext.AbortedByTimeout, errext.AbortedByOutput:
+		return &notifyError{Code: notifyCodeSystemAbort, Reason: testErr.Error()}
+	case errext.AbortedByThresholdsAfterTestEnd:
+		return nil
+	default:
+		// An abort reason k6 does not map yet: report it as unknown rather
+		// than guessing a code the backend would misinterpret.
+		return &notifyError{Reason: testErr.Error()}
+	}
+}
diff --git a/internal/cloudapi/provisioning/provision.go b/internal/cloudapi/provisioning/provision.go
new file mode 100644
index 000000000..17d7a0d9e
--- /dev/null
+++ b/internal/cloudapi/provisioning/provision.go
@@ -0,0 +1,113 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"go.k6.io/k6/v2/lib"
+)
+
+// ProvisionParams describes the test run to provision for local execution.
+type ProvisionParams struct {
+	// Name is the load test's name within the project.
+	Name string
+
+	// ProjectID is the project the load test belongs to.
+	ProjectID int64
+
+	// MaxVUs is the maximum number of VUs the test can reach.
+	MaxVUs int32
+
+	// TotalDuration is the total duration of the test, in seconds.
+	TotalDuration int32
+
+	// Options is the resolved script options, as JSON.
+	Options json.RawMessage
+
+	// Archive is the test archive to upload. When nil, no archive is uploaded
+	// and the backend is told so explicitly.
+	Archive *lib.Archive
+
+	// PollInterval is how often the test run is polled while waiting for the
+	// cloud to be ready. Defaults to one second.
+	PollInterval time.Duration
+}
+
+// ProvisionResult is everything the command layer needs once the cloud is
+// ready to receive the locally generated metrics.
+type ProvisionResult struct {
+	// TestRunID identifies the test run that was created.
+	TestRunID int64
+
+	// TestRunDetailsPageURL is the URL of the test run's page.
+	TestRunDetailsPageURL string
+
+	RuntimeConfig RuntimeConfig
+}
+
+// ProvisionLocalExecution prepares a local test run in the cloud: it makes
+// sure the load test exists, starts a local execution test run, uploads the
+// test archive when there is one, and waits until the cloud is ready to
+// receive metrics.
+func (c *Client) ProvisionLocalExecution(
+	ctx context.Context, params ProvisionParams,
+) (*ProvisionResult, error) {
+	loadTestID, err := c.v6Client.CreateOrFindLoadTest(ctx, params.ProjectID, params.Name)
+	if err != nil {
+		return nil, fmt.Errorf("create or find load test: %w", err)
+	}
+
+	archive, err := encodeArchive(params.Archive)
+	if err != nil {
+		return nil, err
+	}
+
+	res, err := c.StartLocalExecution(ctx, loadTestID, StartLocalExecutionRequest{
+		Options:       params.Options,
+		MaxVUs:        params.MaxVUs,
+		TotalDuration: params.TotalDuration,
+		ArchiveSize:   int64(len(archive)),
+	})
+	if err != nil {
+		return nil, fmt.Errorf("start local execution: %w", err)
+	}
+
+	switch {
+	case len(archive) == 0:
+	case res.ArchiveUploadURL == nil || *res.ArchiveUploadURL == "":
+		c.logger.Warn("The cloud did not return an archive upload URL, skipping the test archive upload")
+	default:
+		if err := c.UploadArchive(ctx, *res.ArchiveUploadURL, archive); err != nil {
+			return nil, fmt.Errorf("upload archive: %w", err)
+		}
+	}
+
+	if err := c.WaitForTestRunReady(ctx, res.TestRunID, params.PollInterval); err != nil {
+		return nil, fmt.Errorf("wait for test run ready: %w", err)
+	}
+
+	return &ProvisionResult{
+		TestRunID:             res.TestRunID,
+		TestRunDetailsPageURL: res.TestRunDetailsPageURL,
+		RuntimeConfig:         res.RuntimeConfig,
+	}, nil
+}
+
+// encodeArchive serialises the archive so that its size can be announced to
+// the backend before the upload, and so that a retried upload replays the
+// exact same bytes.
+func encodeArchive(archive *lib.Archive) ([]byte, error) {
+	if archive == nil {
+		return nil, nil
+	}
+
+	var buf bytes.Buffer
+	if err := archive.Write(&buf); err != nil {
+		return nil, fmt.Errorf("serializing the test archive: %w", err)
+	}
+
+	return buf.Bytes(), nil
+}
diff --git a/internal/cloudapi/provisioning/test/server.go b/internal/cloudapi/provisioning/test/server.go
new file mode 100644
index 000000000..a20e7d322
--- /dev/null
+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,188 @@
+// Package provtest provides an HTTP test server that simulates the k6 Cloud
+// provisioning API, together with the v6 endpoints the local-execution flow
+// touches.
+//
+// It keeps the wire-level details (nullable fields, SDK models, runtime config
+// shapes) out of the tests: they register handlers per endpoint and speak in
+// domain terms, and only this package has to change when the API does.
+package provtest
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	// DefaultLoadTestID is the load test id the canned responses use.
+	DefaultLoadTestID int64 = 456
+
+	// DefaultTestRunID is the test run id the canned responses use.
+	DefaultTestRunID int64 = 123
+
+	// PresignedUploadPath is the path the fake presigned archive upload URL
+	// points to.
+	PresignedUploadPath = "/presigned-upload/archive.tar"
+)
+
+// Server is a test HTTP server for the k6 Cloud provisioning API.
+//
+// Handlers are opt-in: a test registers only the endpoints it expects to be
+// called, so an unexpected call fails with a 404 instead of silently
+// succeeding. Mux is exported so tests can add their own routes, e.g. a
+// catch-all for the metrics pushes.
+type Server struct {
+	*httptest.Server
+
+	// Mux is the server's router.
+	Mux *http.ServeMux
+
+	fetchTestRunHits atomic.Int32
+}
+
+// NewServer creates and starts a provisioning API test server.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+
+	mux := http.NewServeMux()
+	s := &Server{Mux: mux}
+
+	srv := httptest.NewServer(mux)
+	s.Server = srv
+	t.Cleanup(srv.Close)
+
+	return s
+}
+
+// PresignedUploadURL returns the absolute URL of the fake presigned upload.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// HandleCreateLoadTest registers the v6 load-tests endpoint of a project. The
+// handler receives both the create (POST) and the find-by-name (GET) requests.
+func (s *Server) HandleCreateLoadTest(projectID int64, handler http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID), handler)
+}
+
+// HandleStartLocalExecution registers the start-local-execution endpoint of a
+// load test.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, handler http.HandlerFunc) {
+	s.Mux.HandleFunc(
+		fmt.Sprintf("POST /provisioning/v1/load_tests/%d/start_local_execution", loadTestID),
+		handler,
+	)
+}
+
+// HandlePresignedUpload registers the presigned archive upload endpoint.
+func (s *Server) HandlePresignedUpload(path string, handler http.HandlerFunc) {
+	s.Mux.HandleFunc("PUT "+path, handler)
+}
+
+// HandleNotify registers the end-of-script-execution notification endpoint of
+// a test run.
+func (s *Server) HandleNotify(testRunID int64, handler http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("POST /provisioning/v1/test_runs/%d/notify", testRunID), handler)
+}
+
+// HandleFetchTestRun registers the v6 test-run endpoint, serving one progress
+// per call. Once the sequence is exhausted, the last entry is repeated.
+func (s *Server) HandleFetchTestRun(testRunID int64, progress []v6.TestProgress) {
+	s.Mux.HandleFunc(fmt.Sprintf("GET /cloud/v6/test_runs/%d", testRunID), func(w http.ResponseWriter, _ *http.Request) {
+		if len(progress) == 0 {
+			http.Error(w, "no test run progress configured", http.StatusInternalServerError)
+			return
+		}
+
+		i := int(s.fetchTestRunHits.Add(1)) - 1
+		if i >= len(progress) {
+			i = len(progress) - 1
+		}
+
+		writeJSON(w, http.StatusOK, testRunModel(progress[i]))
+	})
+}
+
+// FetchTestRunHitCount returns how many times the test-run endpoint was hit.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchTestRunHits.Load()
+}
+
+// DefaultStartLocalExecutionResponse returns a fully populated
+// start-local-execution response. Tests override the fields they care about.
+func DefaultStartLocalExecutionResponse() *k6cloud.StartLocalExecutionTestResponse {
+	var (
+		pushInterval          = "2s"
+		pushConcurrency       = int32(5)
+		aggregationPeriod     = "3s"
+		aggregationWaitPeriod = "1s"
+		aggregationMinSamples = int32(100)
+		maxSamplesPerPackage  = int32(2000)
+		archiveUploadURL      = "https://s3.amazonaws.com/k6-archives/" + fmt.Sprint(DefaultTestRunID) + "?signature=abc"
+	)
+
+	metrics := k6cloud.NewMetricsRuntimeConfig(
+		"https://ingest.k6.io/v1/metrics",
+		*k6cloud.NewNullableString(&pushInterval),
+		*k6cloud.NewNullableInt32(&pushConcurrency),
+		*k6cloud.NewNullableString(&aggregationPeriod),
+		*k6cloud.NewNullableString(&aggregationWaitPeriod),
+		*k6cloud.NewNullableInt32(&aggregationMinSamples),
+		*k6cloud.NewNullableInt32(&maxSamplesPerPackage),
+	)
+	traces := k6cloud.NewTracesRuntimeConfig("https://ingest.k6.io/v1/traces", map[string]string{}, "grpc")
+	files := k6cloud.NewFilesRuntimeConfig("https://ingest.k6.io/v1/files", "screenshots", map[string]string{}, "PUT")
+	logs := k6cloud.NewLogsRuntimeConfig(
+		"https://ingest.k6.io/v1/logs",
+		"wss://cloudlogs.k6.io/api/v1/tail",
+		100,
+		"1s",
+		"info",
+		1024,
+		[]string{},
+	)
+	secrets := k6cloud.NewSecretsRuntimeConfig(
+		fmt.Sprintf("https://api.k6.io/provisioning/v1/test_runs/%d/decrypt_secret?name={key}", DefaultTestRunID),
+		"plaintext",
+	)
+
+	runtimeConfig := k6cloud.NewRuntimeConfig(*metrics, *traces, *files, *logs, *secrets, "test-run-token-abc")
+
+	return k6cloud.NewStartLocalExecutionTestResponse(
+		DefaultTestRunID,
+		*runtimeConfig,
+		*k6cloud.NewNullableString(&archiveUploadURL),
+		fmt.Sprintf("https://app.k6.io/runs/%d", DefaultTestRunID),
+	)
+}
+
+// testRunModel encodes a [v6.TestProgress] in the v6 wire format.
+func testRunModel(progress v6.TestProgress) *k6cloud.TestRunApiModel {
+	res := k6cloud.NewTestRunApiModelWithDefaults()
+	res.SetStatus(progress.Status.String())
+	res.SetResult(progress.Result.String())
+	res.SetEstimatedDuration(progress.EstimatedDuration)
+	res.SetExecutionDuration(progress.ExecutionDuration)
+	res.SetStatusHistory(v6.ToStatusModel(progress.StatusHistory))
+	// The SDK decoder requires these keys on the other end even when empty.
+	res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+	res.SetResultDetails(k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(k6cloud.NewResultDetailsApiModel("")))
+	res.SetOptions(map[string]any{})
+
+	return res
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	if err := json.NewEncoder(w).Encode(v); err != nil {
+		panic(fmt.Errorf("provtest: encoding JSON: %w", err))
+	}
+}
