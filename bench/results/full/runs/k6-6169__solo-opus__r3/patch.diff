+// buildConfigFromRuntimeConfig translates the metrics tuning handed out by the
+// provisioning API into the cloud output's configuration.
+//
+// Values k6 cannot make sense of are skipped with a warning instead of failing
+// the run: the local defaults are good enough to keep the test going.
+func buildConfigFromRuntimeConfig(
+	logger logrus.FieldLogger, runtimeConfig provisioning.RuntimeConfig,
+) cloudapi.Config {
+	var conf cloudapi.Config
+	m := runtimeConfig.Metrics
+
+	if d, ok := parseRuntimeConfigDuration(logger, "push_interval", m.PushInterval); ok {
+		conf.MetricPushInterval = types.NewNullDuration(d, true)
+	}
+	if d, ok := parseRuntimeConfigDuration(logger, "aggregation_period", m.AggregationPeriod); ok {
+		conf.AggregationPeriod = types.NewNullDuration(d, true)
+	}
+	if d, ok := parseRuntimeConfigDuration(logger, "aggregation_wait_period", m.AggregationWaitPeriod); ok {
+		conf.AggregationWaitPeriod = types.NewNullDuration(d, true)
+	}
+	if m.PushConcurrency != nil {
+		conf.MetricPushConcurrency = null.IntFrom(int64(*m.PushConcurrency))
+	}
+	if m.MaxSamplesPerPackage != nil {
+		conf.MaxTimeSeriesInBatch = null.IntFrom(int64(*m.MaxSamplesPerPackage))
+	}
+
+	// aggregation_min_samples has no counterpart in the local aggregation, so
+	// it is intentionally dropped, quietly.
+
+	return conf
+}
+
+func parseRuntimeConfigDuration(logger logrus.FieldLogger, field string, value *string) (time.Duration, bool) {
+	if value == nil || *value == "" {
+		return 0, false
+	}
+
+	d, err := time.ParseDuration(*value)
+	if err != nil {
+		logger.WithError(err).
+			WithFields(logrus.Fields{"field": field, "value": *value}).
+			Warn("Ignoring an unparseable duration returned by the k6 Cloud")
+		return 0, false
+	}
+
+	return d, true
+}
