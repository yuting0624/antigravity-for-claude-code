+
+package main
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+
+	git "github.com/go-git/go-git/v5"
+	"github.com/go-git/go-git/v5/plumbing"
+	"github.com/sourcegraph/zoekt"
+	"github.com/sourcegraph/zoekt/gitindex"
+	"github.com/sourcegraph/zoekt/index"
+)
+
+// shardInventory is a shard file together with the repositories it holds.
+type shardInventory struct {
+	Path         string
+	Repositories []*zoekt.Repository
+}
+
+// readInventory returns the shards in indexDir, sorted by path.
+func readInventory(indexDir string) ([]shardInventory, error) {
+	paths, err := filepath.Glob(filepath.Join(indexDir, "*.zoekt"))
+	if err != nil {
+		return nil, fmt.Errorf("read inventory: %w", err)
+	}
+	sort.Strings(paths)
+
+	var inventory []shardInventory
+	for _, p := range paths {
+		repos, _, err := index.ReadMetadataPath(p)
+		if err != nil {
+			continue
+		}
+		inventory = append(inventory, shardInventory{
+			Path:         p,
+			Repositories: repos,
+		})
+	}
+	return inventory, nil
+}
+
+// repositoryRecord is a repository present in the index.
+type repositoryRecord struct {
+	Name   string
+	Source string
+	Shards []string
+}
+
+// recordsFromShards groups the shard inventory by repository, sorted by name.
+func recordsFromShards(shards []shardInventory) []repositoryRecord {
+	byName := make(map[string]*repositoryRecord)
+	seenShards := make(map[string]map[string]bool)
+
+	for _, s := range shards {
+		for _, r := range s.Repositories {
+			if r == nil {
+				continue
+			}
+			rec, ok := byName[r.Name]
+			if !ok {
+				rec = &repositoryRecord{
+					Name:   r.Name,
+					Source: r.Source,
+				}
+				byName[r.Name] = rec
+				seenShards[r.Name] = make(map[string]bool)
+			}
+			if rec.Source == "" && r.Source != "" {
+				rec.Source = r.Source
+			}
+			if !seenShards[r.Name][s.Path] {
+				seenShards[r.Name][s.Path] = true
+				rec.Shards = append(rec.Shards, s.Path)
+			}
+		}
+	}
+
+	records := make([]repositoryRecord, 0, len(byName))
+	for _, rec := range byName {
+		records = append(records, *rec)
+	}
+	sort.Slice(records, func(i, j int) bool {
+		return records[i].Name < records[j].Name
+	})
+	return records
+}
+
+// shardsToRemove splits the shards holding the named repositories into those
+// that can be deleted and those shared with repositories that must be kept.
+func shardsToRemove(shards []shardInventory, names map[string]bool) (removable, shared []string) {
+	for _, s := range shards {
+		var hasNamed, hasKept bool
+		for _, r := range s.Repositories {
+			if r == nil {
+				continue
+			}
+			if names[r.Name] {
+				hasNamed = true
+			} else {
+				hasKept = true
+			}
+		}
+		if hasNamed && !hasKept {
+			removable = append(removable, s.Path)
+		} else if hasNamed && hasKept {
+			shared = append(shared, s.Path)
+		}
+	}
+	return removable, shared
+}
+
+// removeShard deletes a shard and its optional metadata sidecar.
+func removeShard(path string) error {
+	if err := os.Remove(path); err != nil {
+		return fmt.Errorf("remove shard %s: %w", path, err)
+	}
+	if err := os.Remove(path + ".meta"); err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return fmt.Errorf("remove shard metadata %s: %w", path+".meta", err)
+	}
+	return nil
+}
+
+// repositoryBranches resolves the branches to index to their current commits,
+// mirroring how gitindex records them in a shard.
+func repositoryBranches(repoDir string, branches []string, prefix string, allowMissing bool) ([]zoekt.RepositoryBranch, error) {
+	repo, err := git.PlainOpenWithOptions(repoDir, &git.PlainOpenOptions{
+		DetectDotGit:          true,
+		EnableDotGitCommonDir: true,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("open repository %s: %w", repoDir, err)
+	}
+
+	var expanded []string
+	for _, b := range branches {
+		if strings.Contains(b, "*") {
+			iter, err := repo.Branches()
+			if err != nil {
+				return nil, fmt.Errorf("list branches %s: %w", repoDir, err)
+			}
+			for {
+				ref, err := iter.Next()
+				if err == io.EOF {
+					break
+				}
+				if err != nil {
+					iter.Close()
+					return nil, fmt.Errorf("iterate branches %s: %w", repoDir, err)
+				}
+				shortName := ref.Name().Short()
+				matched, err := filepath.Match(b, shortName)
+				if err != nil {
+					iter.Close()
+					return nil, fmt.Errorf("match branch pattern %s: %w", b, err)
+				}
+				if !matched {
+					continue
+				}
+				expanded = append(expanded, strings.TrimPrefix(shortName, prefix))
+			}
+			iter.Close()
+			continue
+		}
+		expanded = append(expanded, b)
+	}
+
+	var result []zoekt.RepositoryBranch
+	for _, b := range expanded {
+		hash, err := repo.ResolveRevision(plumbing.Revision(b))
+		if err != nil {
+			hash, err = repo.ResolveRevision(plumbing.Revision(filepath.Join(prefix, b)))
+		}
+		if err != nil {
+			if allowMissing && err.Error() == "reference not found" {
+				continue
+			}
+			return nil, fmt.Errorf("resolve branch %s: %w", b, err)
+		}
+		commit, err := repo.CommitObject(*hash)
+		if err != nil {
+			if allowMissing && err.Error() == "reference not found" {
+				continue
+			}
+			return nil, fmt.Errorf("commit object for branch %s: %w", b, err)
+		}
+		result = append(result, zoekt.RepositoryBranch{
+			Name:    b,
+			Version: commit.Hash.String(),
+		})
+	}
+
+	return result, nil
+}
+
+// indexUpToDate reports whether the index directory already holds the
+// repository at these branch versions and build options.
+func indexUpToDate(opts index.Options, branches []zoekt.RepositoryBranch) bool {
+	repo, _, ok, err := opts.FindRepositoryMetadata()
+	if err != nil || !ok {
+		return false
+	}
+	return repo.IndexOptions == opts.GetHash() && reflect.DeepEqual(repo.Branches, branches)
+}
+
+// indexRepository indexes one discovered repository with the git indexer,
+// keeping the name chosen by discovery. It reports whether shards changed.
+func indexRepository(opts index.Options, repo repository, gitOpts gitindex.Options) (bool, error) {
+	opts.RepositoryDescription.Name = repo.Name
+	gitOpts.RepoDir = repo.Path
+	gitOpts.BuildOptions = opts
+	return gitindex.IndexGitRepo(gitOpts)
+}
