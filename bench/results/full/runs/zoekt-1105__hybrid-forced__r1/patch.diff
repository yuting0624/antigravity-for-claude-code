+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Command zoekt-local-sync synchronizes Zoekt search indexes with git repositories
+// discovered on the local filesystem.
+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"text/tabwriter"
+
+	"github.com/sourcegraph/zoekt"
+	"github.com/sourcegraph/zoekt/gitindex"
+	"github.com/sourcegraph/zoekt/index"
+	"golang.org/x/sys/unix"
+)
+
+func main() {
+	if err := execute(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if !errors.Is(err, flag.ErrHelp) {
+			fmt.Fprintf(os.Stderr, "zoekt-local-sync: %v\n", err)
+		}
+		os.Exit(1)
+	}
+}
+
+// directoryLock is an exclusive lock on an index directory.
+type directoryLock struct {
+	file *os.File
+}
+
+// acquireDirectoryLock acquires an exclusive lock on indexDir.
+func acquireDirectoryLock(indexDir string) (*directoryLock, error) {
+	lockPath := filepath.Join(indexDir, ".zoekt-local-sync.lock")
+	f, err := os.OpenFile(lockPath, os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		return nil, fmt.Errorf("open lock file %s: %w", lockPath, err)
+	}
+	if err := unix.Flock(int(f.Fd()), unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		f.Close()
+		return nil, fmt.Errorf("another zoekt-local-sync holds the index directory %s: %w", indexDir, err)
+	}
+	return &directoryLock{file: f}, nil
+}
+
+// Close releases the directory lock.
+func (l *directoryLock) Close() error {
+	if l == nil || l.file == nil {
+		return nil
+	}
+	unlockErr := unix.Flock(int(l.file.Fd()), unix.LOCK_UN)
+	closeErr := l.file.Close()
+	l.file = nil
+	if unlockErr != nil {
+		return unlockErr
+	}
+	return closeErr
+}
+
+// execute dispatches command-line arguments to the appropriate subcommand.
+func execute(args []string, out io.Writer, errOut io.Writer) error {
+	if len(args) > 0 {
+		switch args[0] {
+		case "-h", "--help", "-help", "help":
+			printTopLevelHelp(out)
+			return nil
+		case "list":
+			return list(args[1:], out, errOut)
+		case "remove":
+			return remove(args[1:], out, errOut)
+		case "sync":
+			return sync(args[1:], "zoekt-local-sync sync", out, errOut)
+		}
+	}
+	return sync(args, "zoekt-local-sync", out, errOut)
+}
+
+// syncFlags holds command-line flags for the sync subcommand.
+type syncFlags struct {
+	force          bool
+	branches       string
+	prefix         string
+	submodules     bool
+	incremental    bool
+	allowMissing   bool
+	repoCache      string
+	delta          bool
+	deltaThreshold uint64
+}
+
+// newSyncFlagSet constructs a flag set and options for the sync subcommand.
+func newSyncFlagSet(name string) (*flag.FlagSet, *index.Options, *syncFlags) {
+	opts := &index.Options{IndexDir: index.DefaultDir}
+	fs := flag.NewFlagSet(name, flag.ContinueOnError)
+	opts.Flags(fs)
+
+	flags := &syncFlags{}
+	fs.BoolVar(&flags.force, "f", false, "apply the changes; without it nothing is written")
+	fs.StringVar(&flags.branches, "branches", "HEAD", "git branches to index.")
+	fs.StringVar(&flags.prefix, "prefix", "refs/heads/", "prefix for branch names")
+	fs.BoolVar(&flags.submodules, "submodules", true, "if set to false, do not recurse into submodules")
+	fs.BoolVar(&flags.incremental, "incremental", true, "only index changed repositories")
+	fs.BoolVar(&flags.allowMissing, "allow_missing_branches", false, "allow missing branches.")
+	fs.StringVar(&flags.repoCache, "repo_cache", "", "directory holding bare git repos, named by URL. this is used to find repositories for submodules.")
+	fs.BoolVar(&flags.delta, "delta", false, "whether we should use delta build")
+	fs.Uint64Var(&flags.deltaThreshold, "delta_threshold", 0, "upper limit on the number of preexisting shards that can exist before attempting a delta build (0 to disable fallback behavior)")
+
+	fs.Usage = func() {
+		fmt.Fprintf(fs.Output(), "Usage: %s [options] <root>...\n\nSynchronize search indexes for git repositories discovered under root directories.\n\n", name)
+		fs.PrintDefaults()
+	}
+
+	return fs, opts, flags
+}
+
+// printTopLevelHelp writes the top-level help text to out.
+func printTopLevelHelp(out io.Writer) {
+	fmt.Fprintf(out, "zoekt-local-sync discovers and indexes git repositories on the local filesystem.\n\n")
+	fmt.Fprintf(out, "Usage:\n")
+	fmt.Fprintf(out, "  zoekt-local-sync [options] <root>...         Synchronize search indexes for git repositories found under roots (default)\n")
+	fmt.Fprintf(out, "  zoekt-local-sync sync [options] <root>...    Synchronize search indexes for git repositories found under roots\n")
+	fmt.Fprintf(out, "  zoekt-local-sync list [options]              List indexed repositories\n")
+	fmt.Fprintf(out, "  zoekt-local-sync remove [options] <repo>...  Remove indexed repositories\n\n")
+	fmt.Fprintf(out, "Without -f, everything is only a preview; no changes are written.\n\n")
+	fmt.Fprintf(out, "Run \"zoekt-local-sync sync -h\", \"zoekt-local-sync list -h\" or \"zoekt-local-sync remove -h\" for per-subcommand options.\n\n")
+	fmt.Fprintf(out, "Default sync options:\n")
+	fs, _, _ := newSyncFlagSet("zoekt-local-sync")
+	fs.SetOutput(out)
+	fs.PrintDefaults()
+}
+
+// sync synchronizes search indexes for git repositories found under roots.
+func sync(args []string, name string, out, errOut io.Writer) error {
+	fs, opts, flags := newSyncFlagSet(name)
+	fs.SetOutput(errOut)
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	roots := fs.Args()
+	if len(roots) == 0 {
+		fs.Usage()
+		return errors.New("zoekt-local-sync needs at least one root directory")
+	}
+
+	var branches []string
+	if flags.branches != "" {
+		branches = strings.Split(flags.branches, ",")
+	}
+	if opts.IndexDir == "" {
+		opts.IndexDir = index.DefaultDir
+	}
+	opts.IsDelta = flags.delta
+	opts.SetDefaults()
+
+	repositories, err := discoverRepositories(roots)
+	if err != nil {
+		return err
+	}
+
+	if flags.force {
+		if err := os.MkdirAll(opts.IndexDir, 0o755); err != nil {
+			return fmt.Errorf("create index directory %s: %w", opts.IndexDir, err)
+		}
+		lock, err := acquireDirectoryLock(opts.IndexDir)
+		if err != nil {
+			return err
+		}
+		defer lock.Close()
+	}
+
+	gitOpts := gitindex.Options{
+		BranchPrefix:                      flags.prefix,
+		Incremental:                       flags.incremental,
+		Submodules:                        flags.submodules,
+		RepoCacheDir:                      flags.repoCache,
+		AllowMissingBranch:                flags.allowMissing,
+		Branches:                          branches,
+		DeltaShardNumberFallbackThreshold: flags.deltaThreshold,
+	}
+
+	for _, repo := range repositories {
+		repoOpts := *opts
+		repoOpts.RepositoryDescription = zoekt.Repository{
+			Name:   repo.Name,
+			Source: repo.Path,
+		}
+		repoOpts.SetDefaults()
+
+		var upToDate bool
+		versions, err := repositoryBranches(repo.Path, branches, flags.prefix, flags.allowMissing)
+		if err != nil {
+			fmt.Fprintf(errOut, "zoekt-local-sync: warning: %v\n", err)
+		} else {
+			upToDate = flags.incremental && indexUpToDate(repoOpts, versions)
+		}
+
+		if !flags.force {
+			if upToDate {
+				fmt.Fprintf(out, "Up to date %q\n", repo.Name)
+			} else {
+				fmt.Fprintf(out, "Would index %q\n", repo.Name)
+			}
+		} else {
+			if upToDate {
+				fmt.Fprintf(out, "Up to date %q\n", repo.Name)
+			} else {
+				fmt.Fprintf(out, "Indexing %q from %s\n", repo.Name, repo.Path)
+				updated, err := indexRepository(repoOpts, repo, gitOpts)
+				if err != nil {
+					return fmt.Errorf("indexing %q: %w", repo.Name, err)
+				}
+				if updated {
+					fmt.Fprintf(out, "Indexed %q\n", repo.Name)
+				} else {
+					fmt.Fprintf(out, "Up to date %q\n", repo.Name)
+				}
+			}
+		}
+	}
+
+	shards, err := readInventory(opts.IndexDir)
+	if err != nil {
+		return err
+	}
+
+	discoveredNames := make(map[string]bool, len(repositories))
+	for _, repo := range repositories {
+		discoveredNames[repo.Name] = true
+	}
+
+	stale := make(map[string]bool)
+	for _, s := range shards {
+		for _, r := range s.Repositories {
+			if r != nil && !discoveredNames[r.Name] {
+				stale[r.Name] = true
+			}
+		}
+	}
+
+	removable, shared := shardsToRemove(shards, stale)
+	for _, path := range shared {
+		fmt.Fprintf(errOut, "skipping shard %s: it also holds repositories that are still indexed\n", path)
+	}
+
+	for _, path := range removable {
+		if !flags.force {
+			fmt.Fprintf(out, "Would remove %s\n", path)
+		} else {
+			fmt.Fprintf(out, "Removing %s\n", path)
+			if err := removeShard(path); err != nil {
+				return err
+			}
+		}
+	}
+
+	if !flags.force {
+		fmt.Fprintln(out, "Pass -f to apply these changes.")
+	}
+
+	return nil
+}
+
+// list prints the repositories currently present in the index.
+func list(args []string, out, errOut io.Writer) error {
+	fs := flag.NewFlagSet("zoekt-local-sync list", flag.ContinueOnError)
+	fs.SetOutput(errOut)
+	indexDir := fs.String("index", index.DefaultDir, "directory for search indices")
+	fs.Usage = func() {
+		fmt.Fprintf(fs.Output(), "Usage: zoekt-local-sync list [options]\n\nLists the repositories currently present in the index.\n\n")
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	shards, err := readInventory(*indexDir)
+	if err != nil {
+		return err
+	}
+	records := recordsFromShards(shards)
+
+	w := tabwriter.NewWriter(out, 0, 8, 2, ' ', 0)
+	fmt.Fprintln(w, "NAME\tSOURCE\tSHARDS")
+	for _, rec := range records {
+		fmt.Fprintf(w, "%s\t%s\t%s\n", rec.Name, rec.Source, strings.Join(rec.Shards, ", "))
+	}
+	return w.Flush()
+}
+
+// remove removes the named repositories from the index.
+func remove(args []string, out, errOut io.Writer) error {
+	fs := flag.NewFlagSet("zoekt-local-sync remove", flag.ContinueOnError)
+	fs.SetOutput(errOut)
+	indexDir := fs.String("index", index.DefaultDir, "directory for search indices")
+	force := fs.Bool("f", false, "apply the changes; without it nothing is removed")
+	fs.Usage = func() {
+		fmt.Fprintf(fs.Output(), "Usage: zoekt-local-sync remove [options] <repository>...\n\nRemoves the named repositories from the index. A repository can be named by\nits index name or by its source path.\n\n")
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	if fs.NArg() == 0 {
+		fs.Usage()
+		return errors.New("zoekt-local-sync remove needs at least one repository")
+	}
+
+	shards, err := readInventory(*indexDir)
+	if err != nil {
+		return err
+	}
+	records := recordsFromShards(shards)
+
+	names := make(map[string]bool)
+	for _, arg := range fs.Args() {
+		var matched bool
+		for _, rec := range records {
+			if rec.Name == arg || rec.Source == arg {
+				names[rec.Name] = true
+				matched = true
+			}
+		}
+		if !matched {
+			return fmt.Errorf("no indexed repository matches %q", arg)
+		}
+	}
+
+	removable, shared := shardsToRemove(shards, names)
+	for _, path := range shared {
+		fmt.Fprintf(errOut, "skipping shard %s: it also holds repositories that are still indexed\n", path)
+	}
+
+	if *force {
+		lock, err := acquireDirectoryLock(*indexDir)
+		if err != nil {
+			return err
+		}
+		defer lock.Close()
+
+		for _, path := range removable {
+			fmt.Fprintf(out, "Removing %s\n", path)
+			if err := removeShard(path); err != nil {
+				return err
+			}
+		}
+	} else {
+		for _, path := range removable {
+			fmt.Fprintf(out, "Would remove %s\n", path)
+		}
+		fmt.Fprintln(out, "Pass -f to apply these changes.")
+	}
+
+	return nil
+}
