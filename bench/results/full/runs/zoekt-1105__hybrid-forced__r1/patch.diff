+package main
+
+import (
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+// repository is a git repository discovered under one of the roots.
+type repository struct {
+	// Name identifies the repository in the index. It is the slash separated
+	// path of the repository relative to the root it was found under.
+	Name string
+
+	// Path is the absolute path of the repository.
+	Path string
+}
+
+// discoverRepositories returns the git repositories below roots, sorted by
+// name. A root that is itself a repository counts.
+func discoverRepositories(roots []string) ([]repository, error) {
+	var repos []repository
+	for _, root := range roots {
+		absRoot, err := filepath.Abs(root)
+		if err != nil {
+			return nil, err
+		}
+		absRoot = filepath.Clean(absRoot)
+
+		err = filepath.WalkDir(absRoot, func(path string, d fs.DirEntry, err error) error {
+			if err != nil {
+				if path == absRoot {
+					return err
+				}
+				return nil
+			}
+			if !d.IsDir() {
+				return nil
+			}
+			if d.Name() == ".git" {
+				return filepath.SkipDir
+			}
+			if isRepository(path) {
+				rel, err := filepath.Rel(absRoot, path)
+				if err != nil {
+					return err
+				}
+				name := rel
+				if name == "." {
+					name = filepath.Base(absRoot)
+				}
+				name = filepath.ToSlash(name)
+				name = strings.TrimSuffix(name, ".git")
+
+				repos = append(repos, repository{
+					Name: name,
+					Path: path,
+				})
+				return filepath.SkipDir
+			}
+			return nil
+		})
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	sort.Slice(repos, func(i, j int) bool {
+		if repos[i].Name == repos[j].Name {
+			return repos[i].Path < repos[j].Path
+		}
+		return repos[i].Name < repos[j].Name
+	})
+
+	for i := 1; i < len(repos); i++ {
+		if repos[i-1].Name == repos[i].Name {
+			return nil, fmt.Errorf("duplicate repository name %q: %s and %s", repos[i].Name, repos[i-1].Path, repos[i].Path)
+		}
+	}
+
+	return repos, nil
+}
+
+// isRepository reports whether dir is the root of a git repository, worktree or bare.
+func isRepository(dir string) bool {
+	if _, err := os.Lstat(filepath.Join(dir, ".git")); err == nil {
+		return true
+	}
+
+	if fi, err := os.Stat(filepath.Join(dir, "objects")); err == nil && fi.IsDir() {
+		if strings.HasSuffix(filepath.Base(dir), ".git") {
+			return true
+		}
+		if _, err := os.Lstat(filepath.Join(dir, "HEAD")); err == nil {
+			return true
+		}
+		if fi, err := os.Stat(filepath.Join(dir, "refs")); err == nil && fi.IsDir() {
+			return true
+		}
+	}
+
+	return false
+}
