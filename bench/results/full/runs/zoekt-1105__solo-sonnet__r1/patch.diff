+// limitations under the License.
+
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+// Repository describes a git repository discovered under one of the sync
+// roots.
+type Repository struct {
+	// Name is the repository's path relative to the root it was discovered
+	// under, with a trailing ".git" suffix stripped. It is used as the
+	// repository name recorded in the index.
+	Name string
+
+	// Path is the absolute path to the repository's root: the working tree
+	// root for a normal repository, or the repository directory itself for
+	// a bare repository.
+	Path string
+}
+
+// discoverRepositories finds the git repositories located at or below the
+// given root directories. A root that is itself a repository counts as one.
+// Each repository's name is derived from its path relative to the root it
+// was discovered under. It is an error for two discovered repositories to
+// resolve to the same name.
+func discoverRepositories(roots []string) ([]Repository, error) {
+	named := map[string]string{}
+	var repositories []Repository
+
+	for _, root := range roots {
+		absRoot, err := filepath.Abs(root)
+		if err != nil {
+			return nil, err
+		}
+		absRoot = filepath.Clean(absRoot)
+
+		paths, err := findRepositoryRoots(absRoot)
+		if err != nil {
+			return nil, err
+		}
+
+		for _, path := range paths {
+			name, err := repositoryName(absRoot, path)
+			if err != nil {
+				return nil, err
+			}
+			if existing, ok := named[name]; ok {
+				return nil, fmt.Errorf("duplicate repository name %q for %q and %q", name, existing, path)
+			}
+			named[name] = path
+			repositories = append(repositories, Repository{Name: name, Path: path})
+		}
+	}
+
+	sort.Slice(repositories, func(i, j int) bool { return repositories[i].Name < repositories[j].Name })
+	return repositories, nil
+}
+
+// findRepositoryRoots finds the roots of git repositories at or below dir. A
+// directory is a repository root if it contains a ".git" entry (worktree or
+// linked worktree/submodule), or if its name ends in ".git" and it contains
+// a git "objects" directory (a bare repository). Repository roots are not
+// searched recursively.
+func findRepositoryRoots(dir string) ([]string, error) {
+	fi, err := os.Stat(dir)
+	if err != nil {
+		return nil, err
+	}
+	if !fi.IsDir() {
+		return nil, fmt.Errorf("%s is not a directory", dir)
+	}
+
+	var found []string
+	err = filepath.Walk(dir, func(path string, info os.FileInfo, err error) error {
+		// Best-effort, mirroring gitindex.FindGitRepos.
+		if err != nil {
+			return nil
+		}
+		if !info.IsDir() {
+			return nil
+		}
+		if isRepositoryRoot(path) {
+			found = append(found, path)
+			return filepath.SkipDir
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return found, nil
+}
+
+func isRepositoryRoot(dir string) bool {
+	if _, err := os.Lstat(filepath.Join(dir, ".git")); err == nil {
+		return true
+	}
+	if strings.HasSuffix(dir, ".git") {
+		if fi, err := os.Stat(filepath.Join(dir, "objects")); err == nil && fi.IsDir() {
+			return true
+		}
+	}
+	return false
+}
+
+// repositoryName derives a repository's name from its path relative to
+// root, stripping a trailing ".git" suffix. If path is root itself, the
+// root's base name is used.
+func repositoryName(root, path string) (string, error) {
+	rel, err := filepath.Rel(root, path)
+	if err != nil {
+		return "", err
+	}
+	if rel == "." {
+		rel = filepath.Base(path)
+	}
+	rel = filepath.ToSlash(rel)
+	rel = strings.TrimSuffix(rel, ".git")
+	return rel, nil
+}
