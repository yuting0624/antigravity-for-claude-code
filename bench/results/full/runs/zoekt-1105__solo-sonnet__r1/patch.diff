+// limitations under the License.
+
+package main
+
+import (
+	"fmt"
+	"log"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/sourcegraph/zoekt"
+	"github.com/sourcegraph/zoekt/gitindex"
+	"github.com/sourcegraph/zoekt/index"
+)
+
+// needsIndexing reports whether the repository at repoPath, indexed with the
+// given build options and branches, is out of date with respect to the
+// shard(s) already on disk. It only resolves the current commit for each
+// requested branch and the repository's URL/templates from its git config;
+// it does not read or write any file content, so it is safe to call during
+// a dry run.
+func needsIndexing(buildOptions index.Options, repoPath string, branches []string, branchPrefix string) (bool, error) {
+	resolved, err := resolveBranchVersions(repoPath, branches, branchPrefix)
+	if err != nil {
+		return false, err
+	}
+
+	if err := gitindex.SetTemplatesFromConfig(&buildOptions.RepositoryDescription, repoPath); err != nil {
+		log.Printf("SetTemplatesFromConfig(%s): %v", repoPath, err)
+	}
+	buildOptions.RepositoryDescription.Branches = resolved
+	buildOptions.SetDefaults()
+
+	return !buildOptions.IncrementalSkipIndexing(), nil
+}
+
+// resolveBranchVersions resolves each of the given branch names to its
+// current commit in the git repository at repoDir, trying branchPrefix
+// joined with the name if the bare name doesn't resolve.
+func resolveBranchVersions(repoDir string, branches []string, branchPrefix string) ([]zoekt.RepositoryBranch, error) {
+	var resolved []zoekt.RepositoryBranch
+	for _, b := range branches {
+		version, err := gitRevParse(repoDir, b)
+		if err != nil {
+			version, err = gitRevParse(repoDir, filepath.Join(branchPrefix, b))
+		}
+		if err != nil {
+			return nil, fmt.Errorf("resolving branch %q in %s: %w", b, repoDir, err)
+		}
+		resolved = append(resolved, zoekt.RepositoryBranch{Name: b, Version: version})
+	}
+	return resolved, nil
+}
+
+func gitRevParse(repoDir, ref string) (string, error) {
+	cmd := exec.Command("git", "rev-parse", "--verify", ref)
+	cmd.Dir = repoDir
+	out, err := cmd.Output()
+	if err != nil {
+		return "", err
+	}
+	return strings.TrimSpace(string(out)), nil
+}
+
+// readInventory returns the paths of the index shards in indexDir.
+func readInventory(indexDir string) ([]string, error) {
+	return filepath.Glob(filepath.Join(indexDir, "*.zoekt"))
+}
+
+// recordsFromShards reads the repository metadata stored in the given
+// shards. Shards that can't be read are skipped.
+func recordsFromShards(shards []string) []*zoekt.Repository {
+	var records []*zoekt.Repository
+	for _, shard := range shards {
+		repos, _, err := index.ReadMetadataPath(shard)
+		if err != nil {
+			continue
+		}
+		records = append(records, repos...)
+	}
+	return records
+}
+
+// inventoryEntry pairs an indexed repository's metadata with the shard file
+// it was read from.
+type inventoryEntry struct {
+	Name   string
+	Source string
+	Shard  string
+}
+
+// listInventory returns the repositories currently indexed in indexDir,
+// sorted by name.
+func listInventory(indexDir string) ([]inventoryEntry, error) {
+	shards, err := readInventory(indexDir)
+	if err != nil {
+		return nil, err
+	}
+
+	var entries []inventoryEntry
+	for _, shard := range shards {
+		for _, r := range recordsFromShards([]string{shard}) {
+			entries = append(entries, inventoryEntry{Name: r.Name, Source: r.Source, Shard: shard})
+		}
+	}
+
+	sort.Slice(entries, func(i, j int) bool { return entries[i].Name < entries[j].Name })
+	return entries, nil
+}
diff --git a/cmd/zoekt-local-sync/main.go b/cmd/zoekt-local-sync/main.go
