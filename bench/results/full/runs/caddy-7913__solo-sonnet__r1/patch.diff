@@ -0,0 +1,108 @@
+// Copyright 2015 Matthew Holt and The Caddy Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package timeouts
+
+import (
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func init() {
+	caddy.RegisterModule(Timeouts{})
+}
+
+// Timeouts is a middleware that applies idle-reset read and write
+// deadlines to just its route, so a slow client can't hold the
+// connection open indefinitely as long as it keeps trickling bytes
+// (slowloris), while a legitimately slow-but-progressing transfer is
+// not punished by a single hard deadline.
+type Timeouts struct {
+	// ReadTimeout is the idle timeout for reading the request body:
+	// it is reset on every successful read. Zero disables it.
+	ReadTimeout time.Duration `json:"read_timeout,omitempty"`
+
+	// ReadMinRate is the minimum required rate, in bytes per second,
+	// for reading the request body. Zero disables it.
+	ReadMinRate int64 `json:"read_min_rate,omitempty"`
+
+	// WriteTimeout is the idle timeout for writing the response: it
+	// is reset on every successful write. Zero disables it.
+	WriteTimeout time.Duration `json:"write_timeout,omitempty"`
+
+	// WriteMinRate is the minimum required rate, in bytes per second,
+	// for writing the response. Zero disables it.
+	WriteMinRate int64 `json:"write_min_rate,omitempty"`
+
+	// MaxWriteChunk is the largest number of bytes covered by a single
+	// underlying write (or ReadFrom) call. Default: caddyhttp.DefaultMaxWriteChunk.
+	MaxWriteChunk int `json:"write_max_chunk,omitempty"`
+
+	logger *zap.Logger
+}
+
+// CaddyModule returns the Caddy module information.
+func (Timeouts) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{
+		ID:  "http.handlers.timeouts",
+		New: func() caddy.Module { return new(Timeouts) },
+	}
+}
+
+// Provision sets up t.
+func (t *Timeouts) Provision(ctx caddy.Context) error {
+	t.logger = ctx.Logger()
+	return nil
+}
+
+// ServeHTTP implements caddyhttp.MiddlewareHandler.
+func (t Timeouts) ServeHTTP(w http.ResponseWriter, r *http.Request, next caddyhttp.Handler) error {
+	if (t.ReadTimeout > 0 || t.ReadMinRate > 0) && r.Body != nil {
+		r.Body = &caddyhttp.IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       http.NewResponseController(w),
+			Deadline: caddyhttp.IdleDeadline{
+				Timeout: t.ReadTimeout,
+				MinRate: float64(t.ReadMinRate),
+			},
+			Logger: t.logger,
+		}
+	}
+
+	if t.WriteTimeout > 0 || t.WriteMinRate > 0 {
+		w = &caddyhttp.IdleTimeoutWriter{
+			ResponseWriterWrapper: &caddyhttp.ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  http.NewResponseController(w),
+			Deadline: caddyhttp.IdleDeadline{
+				Timeout: t.WriteTimeout,
+				MinRate: float64(t.WriteMinRate),
+			},
+			MaxChunk: t.MaxWriteChunk,
+			Logger:   t.logger,
+		}
+	}
+
+	return next.ServeHTTP(w, r)
+}
+
+// Interface guards
+var (
+	_ caddyhttp.MiddlewareHandler = (*Timeouts)(nil)
+	_ caddy.Provisioner           = (*Timeouts)(nil)
+)
