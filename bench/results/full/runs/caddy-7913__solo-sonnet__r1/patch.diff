+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package caddyhttp
+
+import (
+	"io"
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+)
+
+// DefaultMaxWriteChunk is the default maximum number of bytes covered by a
+// single underlying write (or ReadFrom) call made by an IdleTimeoutWriter.
+// Bounding each underlying write keeps a single large write, or a ReadFrom
+// fast path, from running past a single deadline window: the deadline is
+// reset between chunks, just like it is between separate Write calls.
+const DefaultMaxWriteChunk = 64 * 1024
+
+// IdleDeadline computes a deadline for a stream of reads or writes that
+// resets on progress, so a connection that is merely idle (not stalled)
+// never trips it purely from a hard, fixed deadline. It optionally grows
+// more slowly than idle-reset alone would allow, based on a minimum
+// required transfer rate, so a trickle that never fully stalls but never
+// sustains the rate is still cut off.
+type IdleDeadline struct {
+	// Start is the reference time from which a MinRate-based deadline
+	// grows. If zero, it is set to the time of first use.
+	Start time.Time
+
+	// Timeout is the idle timeout: it is reset on every successful
+	// read/write. Zero disables idle-based enforcement (though
+	// HardDeadline or MinRate may still apply).
+	Timeout time.Duration
+
+	// HardDeadline, if set, is an absolute point in time that the
+	// computed deadline must never be pushed past, no matter how much
+	// progress is made. This preserves the meaning of a pre-existing
+	// hard timeout even once idle-reset (and/or MinRate) is layered on
+	// top of it.
+	HardDeadline time.Time
+
+	// MinRate is the minimum required transfer rate, in bytes per
+	// second. Zero disables rate enforcement.
+	MinRate float64
+
+	// credit is the cumulative allowance, earned from bytes already
+	// transferred at MinRate, added on top of the Start+Timeout baseline.
+	credit time.Duration
+}
+
+// next computes the deadline that should be in effect for the next
+// read/write, given the current time and everything transferred so far.
+func (d *IdleDeadline) next(now time.Time) time.Time {
+	if d.Start.IsZero() {
+		d.Start = now
+	}
+
+	var deadline time.Time
+	if d.Timeout > 0 {
+		deadline = now.Add(d.Timeout)
+	}
+	if d.MinRate > 0 {
+		rateDeadline := d.Start.Add(d.Timeout).Add(d.credit)
+		if deadline.IsZero() || rateDeadline.Before(deadline) {
+			deadline = rateDeadline
+		}
+	}
+	if !d.HardDeadline.IsZero() && (deadline.IsZero() || d.HardDeadline.Before(deadline)) {
+		deadline = d.HardDeadline
+	}
+	return deadline
+}
+
+// progress records that n bytes were just successfully transferred,
+// earning MinRate-based credit toward future deadlines.
+func (d *IdleDeadline) progress(n int) {
+	if n > 0 && d.MinRate > 0 {
+		d.credit += time.Duration(float64(n) / d.MinRate * float64(time.Second))
+	}
+}
+
+// IdleTimeoutReader wraps a request body so that the read deadline is
+// reset on every successful read (an idle-reset deadline) rather than
+// being a single hard deadline set once for the entire transfer. This
+// defeats slowloris-style attacks that trickle bytes just fast enough to
+// avoid a hard timeout, while not punishing legitimately slow clients
+// that are still making progress.
+type IdleTimeoutReader struct {
+	io.ReadCloser
+	Ctrl     *http.ResponseController
+	Deadline IdleDeadline
+	Logger   *zap.Logger
+}
+
+func (r *IdleTimeoutReader) Read(p []byte) (int, error) {
+	if deadline := r.Deadline.next(time.Now()); !deadline.IsZero() {
+		if err := r.Ctrl.SetReadDeadline(deadline); err != nil {
+			if c := r.Logger.Check(zapcore.DebugLevel, "failed to set idle read deadline"); c != nil {
+				c.Write(zap.Error(err))
+			}
+		}
+	}
+	n, err := r.ReadCloser.Read(p)
+	r.Deadline.progress(n)
+	return n, err
+}
+
+// IdleTimeoutWriter wraps a response writer so that the write deadline is
+// reset on every successful write (an idle-reset deadline) rather than
+// being a single hard deadline set once for the entire response. Large
+// writes, and the ReadFrom fast path, are broken into chunks no larger
+// than MaxChunk so that a single underlying write call can never cover
+// more than one deadline window.
+type IdleTimeoutWriter struct {
+	*ResponseWriterWrapper
+	Ctrl     *http.ResponseController
+	Deadline IdleDeadline
+	MaxChunk int
+	Logger   *zap.Logger
+}
+
+func (w *IdleTimeoutWriter) maxChunk() int {
+	if w.MaxChunk > 0 {
+		return w.MaxChunk
+	}
+	return DefaultMaxWriteChunk
+}
+
+func (w *IdleTimeoutWriter) setDeadline() {
+	deadline := w.Deadline.next(time.Now())
+	if deadline.IsZero() {
+		return
+	}
+	if err := w.Ctrl.SetWriteDeadline(deadline); err != nil {
+		if c := w.Logger.Check(zapcore.DebugLevel, "failed to set idle write deadline"); c != nil {
+			c.Write(zap.Error(err))
+		}
+	}
+}
+
+func (w *IdleTimeoutWriter) Write(p []byte) (int, error) {
+	chunk := w.maxChunk()
+	var written int
+	for len(p) > 0 {
+		n := len(p)
+		if n > chunk {
+			n = chunk
+		}
+		w.setDeadline()
+		wn, err := w.ResponseWriterWrapper.Write(p[:n])
+		written += wn
+		w.Deadline.progress(wn)
+		if err != nil {
+			return written, err
+		}
+		p = p[n:]
+	}
+	return written, nil
+}
+
+// ReadFrom implements io.ReaderFrom, chunking the transfer so that no
+// single underlying ReadFrom call (which may use an OS-level fast path
+// such as sendfile/splice) can run past a single deadline window.
+func (w *IdleTimeoutWriter) ReadFrom(r io.Reader) (int64, error) {
+	chunk := int64(w.maxChunk())
+	var total int64
+	for {
+		w.setDeadline()
+		n, err := w.ResponseWriterWrapper.ReadFrom(io.LimitReader(r, chunk))
+		total += n
+		w.Deadline.progress(int(n))
+		if err != nil {
+			return total, err
+		}
+		if n < chunk {
+			// the source was exhausted before filling this chunk
+			return total, nil
+		}
+	}
+}
+
+// Interface guards
+var (
+	_ io.ReadCloser       = (*IdleTimeoutReader)(nil)
+	_ http.ResponseWriter = (*IdleTimeoutWriter)(nil)
+	_ io.ReaderFrom       = (*IdleTimeoutWriter)(nil)
+)
