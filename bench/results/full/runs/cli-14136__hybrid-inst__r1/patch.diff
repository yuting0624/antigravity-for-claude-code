+// checkoutBranchInWorktree checks the linked branch out in a worktree at
+// target.Path instead of the current working copy. A branch that does not exist
+// locally is created there as a tracking branch of the remote branch; an
+// existing branch is checked out and then fast-forwarded like the regular
+// checkout flow, scoped to the new worktree.
+func checkoutBranchInWorktree(opts *DevelopOptions, remoteName, branchName string, target prShared.WorktreeTarget) error {
+	gc := opts.GitClient
+	remoteBranch := fmt.Sprintf("%s/%s", remoteName, branchName)
+
+	// Git commands that act on the worktree's own HEAD have to run inside it.
+	wtClient := gc.Copy()
+	wtClient.RepoDir = target.Path
+
+	if !gc.HasLocalBranch(ctx.Background(), branchName) {
+		if target.Reuse {
+			return wtClient.CheckoutNewBranch(ctx.Background(), remoteName, branchName)
+		}
+		return gc.WorktreeAdd(ctx.Background(), target.Path, branchName, remoteBranch)
+	}
+
+	if target.Reuse {
+		if err := wtClient.CheckoutBranch(ctx.Background(), branchName); err != nil {
+			return err
+		}
+	} else if err := gc.WorktreeAdd(ctx.Background(), target.Path, branchName, ""); err != nil {
+		return err
+	}
+
+	if err := wtClient.Pull(ctx.Background(), remoteName, branchName); err != nil {
+		_, _ = fmt.Fprintf(opts.IO.ErrOut, "%s warning: not possible to fast-forward to: %q\n", opts.IO.ColorScheme().WarningIcon(), branchName)
+	}
+	return nil
+}
