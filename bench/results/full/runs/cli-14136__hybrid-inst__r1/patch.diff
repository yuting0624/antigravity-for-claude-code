+// WorktreeTarget describes a worktree destination. Path is the absolute path of
+// the worktree target; Reuse reports whether an existing linked worktree at
+// Path should be reused rather than creating a new one.
+type WorktreeTarget struct {
+	Path  string
+	Reuse bool
+}
+
+// ResolveWorktreeTarget normalises path to an absolute path and asks git where
+// it lives, letting git resolve symlinks, "..", case, and trailing slashes for
+// us instead of comparing paths ourselves. The returned target reports whether
+// an existing linked worktree there should be reused, and an error is returned
+// when the path cannot host a new worktree: a path inside a different
+// repository, a subdirectory of another worktree, or the worktree we are already
+// running in. Detection is best-effort: if git cannot resolve the current or
+// target worktree (e.g. the path does not exist yet), Reuse is false so git
+// worktree add handles the path.
+func ResolveWorktreeTarget(client *git.Client, path string) (WorktreeTarget, error) {
+	if err := ensureWorktreePathSafe(path); err != nil {
+		return WorktreeTarget{}, err
+	}
+
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		return WorktreeTarget{}, err
+	}
+
+	// git emits one line per flag, so we expect exactly two lines here.
+	current, ok := revParseFacts(client, "", "--show-toplevel", "--git-common-dir")
+	if !ok || len(current) != 2 {
+		return WorktreeTarget{Path: abs}, nil
+	}
+	currentToplevel, currentCommonDir := current[0], current[1]
+
+	// A non-existent or non-git target fails here: it is a fresh path for a new worktree.
+	target, ok := revParseFacts(client, abs, "--show-toplevel", "--show-prefix", "--git-common-dir")
+	if !ok || len(target) != 3 {
+		return WorktreeTarget{Path: abs}, nil
+	}
+	targetToplevel, targetPrefix, targetCommonDir := target[0], target[1], target[2]
+
+	switch {
+	case targetCommonDir != currentCommonDir:
+		return WorktreeTarget{}, fmt.Errorf("--worktree path is inside a different repository")
+	case targetToplevel == currentToplevel:
+		return WorktreeTarget{}, fmt.Errorf("--worktree path points to the repository you're already in; omit --worktree to check out here")
+	case targetPrefix != "":
+		return WorktreeTarget{}, fmt.Errorf("--worktree path is inside an existing worktree")
+	}
+	return WorktreeTarget{Path: abs, Reuse: true}, nil
+}
+
+// revParseFacts runs `git rev-parse --path-format=absolute <flags...>` and
+// returns one absolute path per flag, in flag order (an empty --show-prefix
+// yields an empty string), with ok=false if git fails. When dir is non-empty
+// the query is scoped there with -C.
+func revParseFacts(client *git.Client, dir string, flags ...string) (fields []string, ok bool) {
+	args := append([]string{"rev-parse", "--path-format=absolute"}, flags...)
+	if dir != "" {
+		args = append([]string{"-C", dir}, args...)
+	}
+	cmd, err := client.Command(context.Background(), args...)
+	if err != nil {
+		return nil, false
+	}
+	out, err := cmd.Output()
+	if err != nil {
+		return nil, false
+	}
+	return strings.Split(strings.TrimRight(string(out), "\n"), "\n"), true
+}
+
+// ensureWorktreePathSafe validates a --worktree target before we write to it:
+// it must be a non-existent path (git will create it) or an existing directory,
+// and never a symlink at its final component. A symlinked ancestor (e.g. macOS
+// /tmp -> /private/tmp) is fine; os.Lstat checks only the leaf so it is not
+// followed. Rejecting a leaf symlink guards against writing PR content through a
+// planted link.
+func ensureWorktreePathSafe(path string) error {
+	fi, err := os.Lstat(path)
+	switch {
+	case os.IsNotExist(err):
+		return nil
+	case err != nil:
+		return err
+	case fi.Mode()&os.ModeSymlink != 0:
+		return fmt.Errorf("--worktree path must not be a symlink: %s", path)
+	case !fi.IsDir():
+		return fmt.Errorf("--worktree path must be a directory: %s", path)
+	}
+	return nil
+}
+
+// WorktreeCheckoutCommands returns the git commands that put branch into the
+// worktree described by target, and reports whether branch already exists
+// locally. Callers can use branchExists to decide whether the branch still
+// needs to be synced with remoteBranch after checkout.
+func WorktreeCheckoutCommands(client *git.Client, target WorktreeTarget, branch, remoteBranch string) (cmds [][]string, branchExists bool) {
+	branchExists = client.HasLocalBranch(context.Background(), branch)
+	switch {
+	case target.Reuse && branchExists:
+		cmds = [][]string{{"-C", target.Path, "checkout", branch}}
+	case target.Reuse:
+		cmds = [][]string{{"-C", target.Path, "checkout", "-b", branch, "--track", remoteBranch}}
+	case branchExists:
+		cmds = [][]string{{"worktree", "add", "--", target.Path, branch}}
+	default:
+		cmds = [][]string{{"worktree", "add", "--track", "-b", branch, "--", target.Path, remoteBranch}}
+	}
+	return cmds, branchExists
+}
