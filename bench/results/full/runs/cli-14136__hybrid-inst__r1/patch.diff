+// WorktreeAdd adds a worktree for branch at path. When remoteBranch is empty,
+// branch must already exist locally and is checked out in the new worktree;
+// otherwise branch is created in the new worktree as a branch tracking
+// remoteBranch (e.g. "origin/my-branch").
+func (c *Client) WorktreeAdd(ctx context.Context, path, branch, remoteBranch string) error {
+	args := []string{"worktree", "add"}
+	if remoteBranch == "" {
+		args = append(args, "--", path, branch)
+	} else {
+		args = append(args, "--track", "-b", branch, "--", path, remoteBranch)
+	}
+	cmd, err := c.Command(ctx, args...)
+	if err != nil {
+		return err
+	}
+	_, err = cmd.Output()
+	return err
+}
