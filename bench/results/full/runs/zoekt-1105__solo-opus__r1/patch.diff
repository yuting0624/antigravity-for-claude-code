+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Command zoekt-local-sync keeps an index in sync with the git repositories
+// found below one or more local directories. It previews what it would do,
+// and only writes to the index directory when -f is given.
+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"text/tabwriter"
+
+	"go.uber.org/automaxprocs/maxprocs"
+	"golang.org/x/sys/unix"
+
+	"github.com/sourcegraph/zoekt/index"
+)
+
+const programName = "zoekt-local-sync"
+
+func main() {
+	// Tune GOMAXPROCS to match Linux container CPU quota.
+	_, _ = maxprocs.Set()
+
+	if err := execute(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			// The usage was printed already.
+			return
+		}
+		fmt.Fprintf(os.Stderr, "%s: %v\n", programName, err)
+		os.Exit(1)
+	}
+}
+
+// execute runs the command line in args, printing its report to out and usage
+// and diagnostics to errOut. Without a subcommand, it syncs.
+func execute(args []string, out, errOut io.Writer) error {
+	if len(args) > 0 {
+		switch args[0] {
+		case "help", "-h", "-help", "--help":
+			writeHelp(out)
+			return nil
+		case "sync":
+			return runSync(args[1:], out, errOut)
+		case "list":
+			return runList(args[1:], out, errOut)
+		case "remove":
+			return runRemove(args[1:], out, errOut)
+		}
+	}
+
+	return runSync(args, out, errOut)
+}
+
+func writeHelp(out io.Writer) {
+	fmt.Fprintf(out, `%[1]s indexes the git repositories below one or more local root
+directories, and prunes the repositories that are no longer below any of them.
+
+Usage:
+  %[1]s sync [options] <root>...    index the repositories below each root
+  %[1]s list [options]              print the repositories in the index
+  %[1]s remove [options] <repo>...  remove repositories from the index
+
+Sync is the default subcommand, so "%[1]s <root>" syncs <root>. Every
+subcommand only reports what it would do until -f is given.
+
+Run "%[1]s list -h" or "%[1]s remove -h" for the options of those
+subcommands.
+
+Default sync options:
+`, programName)
+
+	fs, _ := newSyncFlagSet(out)
+	fs.PrintDefaults()
+}
+
+// newSyncFlagSet returns the flags of the sync subcommand, and the options
+// they fill in.
+func newSyncFlagSet(output io.Writer) (*flag.FlagSet, *syncOptions) {
+	fs := flag.NewFlagSet(programName+" sync", flag.ContinueOnError)
+	fs.SetOutput(output)
+
+	opts := &syncOptions{build: index.Options{IndexDir: defaultIndexDir()}}
+	opts.build.Flags(fs)
+
+	fs.BoolVar(&opts.force, "f", false, "apply the plan. Without it, nothing is written or deleted.")
+	fs.StringVar(&opts.branches, "branches", "HEAD", "comma separated list of git branches to index.")
+	fs.StringVar(&opts.branchPrefix, "prefix", "refs/heads/", "prefix for branch names")
+	fs.BoolVar(&opts.submodules, "submodules", true, "if set to false, do not recurse into submodules")
+	fs.BoolVar(&opts.incremental, "incremental", true, "only index changed repositories")
+	fs.BoolVar(&opts.allowMissing, "allow_missing_branches", false, "allow missing branches.")
+	fs.StringVar(&opts.repoCacheDir, "repo_cache", "", "directory holding bare git repos, named by URL. "+
+		"this is used to find repositories for submodules.")
+
+	fs.Usage = func() {
+		fmt.Fprintf(output, "Usage: %s sync [options] <root>...\n\n", programName)
+		fmt.Fprintf(output, "Index the git repositories below each root, and remove the shards of the\n"+
+			"repositories in the index that are not below any of them.\n\n")
+		fs.PrintDefaults()
+	}
+
+	return fs, opts
+}
+
+func runSync(args []string, out, errOut io.Writer) error {
+	fs, opts := newSyncFlagSet(errOut)
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	roots := fs.Args()
+	if len(roots) == 0 {
+		fs.Usage()
+		return errors.New("sync needs at least one root directory")
+	}
+
+	opts.build.SetDefaults()
+	if opts.build.IndexDir == "" {
+		return errors.New("no index directory, use -index")
+	}
+
+	return sync(opts, roots, out, errOut)
+}
+
+func runList(args []string, out, errOut io.Writer) error {
+	fs := flag.NewFlagSet(programName+" list", flag.ContinueOnError)
+	fs.SetOutput(errOut)
+	indexDir := fs.String("index", defaultIndexDir(), "directory for search indices")
+	fs.Usage = func() {
+		fmt.Fprintf(errOut, "Usage: %s list [options]\n\nPrint the repositories in the index.\n\n", programName)
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	if fs.NArg() > 0 {
+		fs.Usage()
+		return fmt.Errorf("list takes no arguments, got %q", fs.Arg(0))
+	}
+
+	shards, err := readInventory(*indexDir)
+	if err != nil {
+		return err
+	}
+
+	w := tabwriter.NewWriter(out, 0, 8, 2, ' ', 0)
+	fmt.Fprintln(w, "NAME\tSOURCE\tSHARDS")
+	for _, rec := range recordsFromShards(shards) {
+		fmt.Fprintf(w, "%s\t%s\t%s\n", rec.Name, rec.Source, strings.Join(rec.Shards, ", "))
+	}
+	return w.Flush()
+}
+
+func runRemove(args []string, out, errOut io.Writer) error {
+	fs := flag.NewFlagSet(programName+" remove", flag.ContinueOnError)
+	fs.SetOutput(errOut)
+	indexDir := fs.String("index", defaultIndexDir(), "directory for search indices")
+	force := fs.Bool("f", false, "apply the removal. Without it, nothing is deleted.")
+	fs.Usage = func() {
+		fmt.Fprintf(errOut, "Usage: %s remove [options] <repo>...\n\n"+
+			"Remove repositories, named by their name in the index or by the directory\n"+
+			"they were indexed from, from the index.\n\n", programName)
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	if fs.NArg() == 0 {
+		fs.Usage()
+		return errors.New("remove needs at least one repository")
+	}
+
+	if *force {
+		lock, err := acquireDirectoryLock(*indexDir)
+		if err != nil {
+			return err
+		}
+		defer func() { _ = lock.Close() }()
+	}
+
+	shards, err := readInventory(*indexDir)
+	if err != nil {
+		return err
+	}
+	records := recordsFromShards(shards)
+
+	remove := map[string]bool{}
+	var unknown []string
+	for _, arg := range fs.Args() {
+		found := false
+		for _, rec := range records {
+			if rec.Name == arg || rec.Source == arg {
+				remove[rec.Name] = true
+				found = true
+			}
+		}
+		if !found {
+			unknown = append(unknown, arg)
+		}
+	}
+	if len(unknown) > 0 {
+		return fmt.Errorf("not in the index: %s", strings.Join(unknown, ", "))
+	}
+
+	if err := removeShards(shards, remove, *force, out, errOut); err != nil {
+		return err
+	}
+	if !*force {
+		fmt.Fprintln(out, "Pass -f to apply these changes.")
+	}
+	return nil
+}
+
+// defaultIndexDir is where the zoekt command line searcher looks for shards.
+func defaultIndexDir() string {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return ""
+	}
+	return filepath.Join(home, ".zoekt")
+}
+
+const lockFileName = ".zoekt-local-sync.lock"
+
+// directoryLock is an exclusive lock on an index directory, so that two runs
+// cannot interleave their writes.
+type directoryLock struct {
+	file *os.File
+}
+
+// acquireDirectoryLock locks indexDir, which must exist. It fails rather than
+// waits if the directory is locked already.
+func acquireDirectoryLock(indexDir string) (*directoryLock, error) {
+	path := filepath.Join(indexDir, lockFileName)
+	f, err := os.OpenFile(path, os.O_RDWR|os.O_CREATE, 0o600)
+	if err != nil {
+		return nil, fmt.Errorf("locking index directory: %w", err)
+	}
+
+	if err := unix.Flock(int(f.Fd()), unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		f.Close()
+		return nil, fmt.Errorf("%s is locked, another %s is working on it: %w", indexDir, programName, err)
+	}
+
+	return &directoryLock{file: f}, nil
+}
+
+func (l *directoryLock) Close() error {
+	// Closing the file releases the lock, unlocking first only makes it
+	// explicit. The lock file itself stays behind for the next run.
+	if err := unix.Flock(int(l.file.Fd()), unix.LOCK_UN); err != nil {
+		l.file.Close()
+		return err
+	}
+	return l.file.Close()
+}
