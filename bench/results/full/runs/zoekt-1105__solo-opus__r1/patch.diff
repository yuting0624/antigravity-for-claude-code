+// limitations under the License.
+
+package main
+
+import (
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+// repository is a git repository found below one of the roots.
+type repository struct {
+	// Name is the name the repository is indexed under. It is the path of the
+	// repository relative to the root it was found in.
+	Name string
+
+	// Path is the directory holding the repository: the working tree for a
+	// normal repository, the git directory for a bare one.
+	Path string
+}
+
+// discoverRepositories finds the git repositories below the given roots. A
+// root that is a repository itself is returned as well. The repositories are
+// sorted by name, and it is an error for two of them to share a name, since
+// the name determines the shards they are indexed into.
+func discoverRepositories(roots []string) ([]repository, error) {
+	var repositories []repository
+	byName := map[string]repository{}
+	seenRoots := map[string]bool{}
+
+	for _, root := range roots {
+		abs, err := filepath.Abs(root)
+		if err != nil {
+			return nil, err
+		}
+		abs = filepath.Clean(abs)
+		if seenRoots[abs] {
+			continue
+		}
+		seenRoots[abs] = true
+
+		// Fail loudly on a root that we cannot look at: silently finding no
+		// repositories below it would prune everything indexed from it.
+		if fi, err := os.Stat(abs); err != nil {
+			return nil, fmt.Errorf("root %s: %w", root, err)
+		} else if !fi.IsDir() {
+			return nil, fmt.Errorf("root %s is not a directory", root)
+		}
+
+		found, err := findRepositories(abs)
+		if err != nil {
+			return nil, err
+		}
+		for _, repo := range found {
+			if other, ok := byName[repo.Name]; ok {
+				return nil, fmt.Errorf("duplicate repository name %q: %s and %s", repo.Name, other.Path, repo.Path)
+			}
+			byName[repo.Name] = repo
+			repositories = append(repositories, repo)
+		}
+	}
+
+	sort.Slice(repositories, func(i, j int) bool { return repositories[i].Name < repositories[j].Name })
+	return repositories, nil
+}
+
+// findRepositories returns the repositories at or below root, named relative
+// to root.
+func findRepositories(root string) ([]repository, error) {
+	var repositories []repository
+	err := filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			if path == root {
+				return err
+			}
+			// Best effort: a directory we cannot read holds no repository we
+			// could index anyway.
+			return nil
+		}
+		if !d.IsDir() || !isGitRepository(path) {
+			return nil
+		}
+
+		name, err := repositoryName(root, path)
+		if err != nil {
+			return err
+		}
+		repositories = append(repositories, repository{Name: name, Path: path})
+
+		// Repositories are not nested, and the contents of a git directory
+		// never are a repository of their own.
+		return fs.SkipDir
+	})
+	if err != nil {
+		return nil, err
+	}
+	return repositories, nil
+}
+
+// isGitRepository reports whether dir holds a git repository.
+func isGitRepository(dir string) bool {
+	// A working tree has a .git directory, or a .git file pointing at the git
+	// directory elsewhere (linked worktrees and submodules).
+	if _, err := os.Lstat(filepath.Join(dir, ".git")); err == nil {
+		return true
+	}
+
+	// A bare repository is a directory named *.git holding the object store.
+	if strings.HasSuffix(dir, ".git") {
+		if fi, err := os.Lstat(filepath.Join(dir, "objects")); err == nil && fi.IsDir() {
+			return true
+		}
+	}
+
+	return false
+}
+
+// repositoryName derives the name of the repository in dir from its path
+// relative to root. The root itself is named after its last path element.
+func repositoryName(root, dir string) (string, error) {
+	rel, err := filepath.Rel(root, dir)
+	if err != nil {
+		return "", err
+	}
+	if rel == "." {
+		rel = filepath.Base(dir)
+	}
+
+	name := filepath.ToSlash(rel)
+	if trimmed := strings.TrimSuffix(name, ".git"); trimmed != "" {
+		name = trimmed
+	}
+	return name, nil
+}
diff --git a/cmd/zoekt-local-sync/index.go b/cmd/zoekt-local-sync/index.go
