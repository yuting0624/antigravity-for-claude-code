+
+func TestSyncPreviewDetectsNewCommits(t *testing.T) {
+	root := t.TempDir()
+	repositoryPath := filepath.Join(root, "repo")
+	createGitRepository(t, repositoryPath)
+	indexDir := t.TempDir()
+
+	args := []string{"-index", indexDir, "-disable_ctags", "-submodules=false", root}
+	if err := execute(append([]string{"-f"}, args...), &bytes.Buffer{}, &bytes.Buffer{}); err != nil {
+		t.Fatal(err)
+	}
+
+	var out bytes.Buffer
+	if err := execute(args, &out, &bytes.Buffer{}); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(out.String(), `Up to date "repo"`) {
+		t.Fatalf("preview of an unchanged repository:\n%s", out.String())
+	}
+
+	if err := os.WriteFile(filepath.Join(repositoryPath, "second.md"), []byte("more\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	runGit(t, repositoryPath, "add", ".")
+	runGit(t, repositoryPath, "commit", "-m", "second commit")
+
+	out.Reset()
+	if err := execute(args, &out, &bytes.Buffer{}); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(out.String(), `Would index "repo"`) {
+		t.Fatalf("preview did not notice the new commit:\n%s", out.String())
+	}
+}
+
+func TestSyncRejectsMissingRoot(t *testing.T) {
+	indexDir := t.TempDir()
+	createTestShard(t, indexDir, "repo", filepath.Join(t.TempDir(), "repo"))
+	missing := filepath.Join(t.TempDir(), "gone")
+
+	// A root that is not there must not prune the whole index.
+	err := execute([]string{"-index", indexDir, "-f", missing}, &bytes.Buffer{}, &bytes.Buffer{})
+	if err == nil || !strings.Contains(err.Error(), missing) {
+		t.Fatalf("got error %v, want a complaint about the root", err)
+	}
+	if shards, err := readInventory(indexDir); err != nil {
+		t.Fatal(err)
+	} else if len(shards) != 1 {
+		t.Fatalf("got %d shards, want the index untouched", len(shards))
+	}
+}
+
+func TestRemoveRejectsUnknownRepository(t *testing.T) {
+	indexDir := t.TempDir()
+	err := execute([]string{"remove", "-index", indexDir, "missing"}, &bytes.Buffer{}, &bytes.Buffer{})
+	if err == nil || !strings.Contains(err.Error(), "not in the index: missing") {
+		t.Fatalf("got error %v, want unknown repository", err)
+	}
+}
