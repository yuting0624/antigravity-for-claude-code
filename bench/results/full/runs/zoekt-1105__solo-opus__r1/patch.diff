index 00000000..1bca7d75
--- /dev/null
+++ b/cmd/zoekt-local-sync/index.go
@@ -0,0 +1,371 @@
+// Copyright 2026 Sourcegraph, Inc. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+
+	git "github.com/go-git/go-git/v5"
+	"github.com/go-git/go-git/v5/plumbing"
+
+	"github.com/sourcegraph/zoekt"
+	"github.com/sourcegraph/zoekt/gitindex"
+	"github.com/sourcegraph/zoekt/index"
+)
+
+// syncOptions holds the options of the sync subcommand.
+type syncOptions struct {
+	build index.Options
+
+	force        bool
+	branches     string
+	branchPrefix string
+	submodules   bool
+	incremental  bool
+	allowMissing bool
+	repoCacheDir string
+}
+
+// gitOptions returns the options to index repo with. The name found by
+// discovery is kept, so that the index agrees with what is below the roots.
+func (o *syncOptions) gitOptions(repo repository) gitindex.Options {
+	build := o.build
+	build.RepositoryDescription = zoekt.Repository{Name: repo.Name}
+
+	var branches []string
+	if o.branches != "" {
+		branches = strings.Split(o.branches, ",")
+	}
+
+	return gitindex.Options{
+		RepoDir:            repo.Path,
+		Submodules:         o.submodules,
+		Incremental:        o.incremental,
+		AllowMissingBranch: o.allowMissing,
+		RepoCacheDir:       o.repoCacheDir,
+		BuildOptions:       build,
+		BranchPrefix:       o.branchPrefix,
+		Branches:           branches,
+	}
+}
+
+// sync indexes the repositories below roots, and removes the shards of the
+// repositories in the index that are not below any of them. Without
+// opts.force, the plan is printed and nothing is written or deleted.
+func sync(opts *syncOptions, roots []string, out, errOut io.Writer) error {
+	repositories, err := discoverRepositories(roots)
+	if err != nil {
+		return err
+	}
+
+	if opts.force {
+		if err := os.MkdirAll(opts.build.IndexDir, 0o755); err != nil {
+			return err
+		}
+		lock, err := acquireDirectoryLock(opts.build.IndexDir)
+		if err != nil {
+			return err
+		}
+		defer func() { _ = lock.Close() }()
+	}
+
+	shards, err := readInventory(opts.build.IndexDir)
+	if err != nil {
+		return err
+	}
+	indexed := recordsFromShards(shards)
+
+	failed := 0
+	for _, repo := range repositories {
+		gitOpts := opts.gitOptions(repo)
+
+		if !opts.force {
+			if upToDate(findRecord(indexed, repo.Name), gitOpts) {
+				fmt.Fprintf(out, "Up to date %q\n", repo.Name)
+			} else {
+				fmt.Fprintf(out, "Would index %q\n", repo.Name)
+			}
+			continue
+		}
+
+		// Announce the repository before indexing it, since that can take a
+		// while. Whether there was anything to do is only known afterwards.
+		fmt.Fprintf(out, "Indexing %q from %s\n", repo.Name, repo.Path)
+		switch updated, err := gitindex.IndexGitRepo(gitOpts); {
+		case err != nil:
+			fmt.Fprintf(errOut, "%s: indexing %s: %v\n", programName, repo.Path, err)
+			failed++
+		case updated:
+			fmt.Fprintf(out, "Indexed %q\n", repo.Name)
+		default:
+			fmt.Fprintf(out, "Up to date %q\n", repo.Name)
+		}
+	}
+
+	// Everything in the index that discovery did not find is outside of the
+	// selected roots, so its shards are stale.
+	selected := make(map[string]bool, len(repositories))
+	for _, repo := range repositories {
+		selected[repo.Name] = true
+	}
+	stale := map[string]bool{}
+	for _, rec := range indexed {
+		if !selected[rec.Name] {
+			stale[rec.Name] = true
+		}
+	}
+
+	removeErr := removeShards(shards, stale, opts.force, out, errOut)
+
+	if !opts.force {
+		fmt.Fprintln(out, "Pass -f to apply these changes.")
+	}
+
+	if failed > 0 {
+		// The failures themselves were reported as they happened.
+		return errors.Join(fmt.Errorf("%d of %d repositories failed to index", failed, len(repositories)), removeErr)
+	}
+	return removeErr
+}
+
+// indexShard is a shard in the index directory, and the repositories it holds.
+type indexShard struct {
+	Path         string
+	Repositories []*zoekt.Repository
+}
+
+// record is a repository in the index, and the shards holding it.
+type record struct {
+	Name       string
+	Source     string
+	Shards     []string
+	Repository *zoekt.Repository
+}
+
+// readInventory returns the shards in the index directory. A directory that
+// does not exist holds no shards.
+func readInventory(indexDir string) ([]indexShard, error) {
+	paths, err := filepath.Glob(filepath.Join(indexDir, "*.zoekt"))
+	if err != nil {
+		return nil, err
+	}
+
+	shards := make([]indexShard, 0, len(paths))
+	for _, path := range paths {
+		repositories, _, err := index.ReadMetadataPathAlive(path)
+		if errors.Is(err, index.ErrEmptyShard) {
+			// All repositories in the shard are tombstoned.
+			repositories = nil
+		} else if err != nil {
+			return nil, fmt.Errorf("reading %s: %w", path, err)
+		}
+		shards = append(shards, indexShard{Path: path, Repositories: repositories})
+	}
+
+	return shards, nil
+}
+
+// recordsFromShards groups the repositories of the shards by name, sorted by
+// name. A repository can be spread over several shards.
+func recordsFromShards(shards []indexShard) []record {
+	byName := map[string]*record{}
+	var names []string
+	for _, shard := range shards {
+		for _, repository := range shard.Repositories {
+			rec, ok := byName[repository.Name]
+			if !ok {
+				rec = &record{Name: repository.Name, Source: repository.Source, Repository: repository}
+				byName[repository.Name] = rec
+				names = append(names, repository.Name)
+			}
+			rec.Shards = append(rec.Shards, shard.Path)
+		}
+	}
+
+	sort.Strings(names)
+	records := make([]record, 0, len(names))
+	for _, name := range names {
+		records = append(records, *byName[name])
+	}
+	return records
+}
+
+func findRecord(records []record, name string) *record {
+	for i, rec := range records {
+		if rec.Name == name {
+			return &records[i]
+		}
+	}
+	return nil
+}
+
+// removeShards removes the shards that only hold repositories in remove, or
+// reports what it would remove if force is not set. A shard shared with a
+// repository that stays in the index is kept.
+func removeShards(shards []indexShard, remove map[string]bool, force bool, out, errOut io.Writer) error {
+	for _, shard := range shards {
+		removed, kept := 0, 0
+		for _, repository := range shard.Repositories {
+			if remove[repository.Name] {
+				removed++
+			} else {
+				kept++
+			}
+		}
+		if removed == 0 {
+			continue
+		}
+		if kept > 0 {
+			fmt.Fprintf(errOut, "%s: keeping %s, it also holds repositories that stay in the index\n", programName, shard.Path)
+			continue
+		}
+
+		if !force {
+			fmt.Fprintf(out, "Would remove %s\n", shard.Path)
+			continue
+		}
+
+		paths, err := index.IndexFilePaths(shard.Path)
+		if err != nil {
+			return fmt.Errorf("removing %s: %w", shard.Path, err)
+		}
+		for _, path := range paths {
+			if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+				return fmt.Errorf("removing %s: %w", path, err)
+			}
+		}
+		fmt.Fprintf(out, "Removed %s\n", shard.Path)
+	}
+
+	return nil
+}
+
+// upToDate reports whether the shards of rec already hold the current state of
+// the repository. This is the check IndexGitRepo does for incremental
+// indexing, but without any of the writing.
+func upToDate(rec *record, opts gitindex.Options) bool {
+	if rec == nil || rec.Repository == nil {
+		return false
+	}
+	if rec.Repository.IndexOptions != opts.BuildOptions.GetHash() {
+		return false
+	}
+
+	branches, err := resolveBranches(opts)
+	if err != nil {
+		return false
+	}
+	return reflect.DeepEqual(branches, rec.Repository.Branches)
+}
+
+// resolveBranches returns the branches IndexGitRepo would index, with the
+// commit each of them points at.
+func resolveBranches(opts gitindex.Options) ([]zoekt.RepositoryBranch, error) {
+	repo, err := openRepository(opts.RepoDir)
+	if err != nil {
+		return nil, err
+	}
+
+	names, err := expandBranches(repo, opts.Branches, opts.BranchPrefix)
+	if err != nil {
+		return nil, err
+	}
+
+	var branches []zoekt.RepositoryBranch
+	for _, name := range names {
+		commit, err := resolveCommit(repo, opts.BranchPrefix, name)
+		if err != nil {
+			if opts.AllowMissingBranch && errors.Is(err, plumbing.ErrReferenceNotFound) {
+				continue
+			}
+			return nil, err
+		}
+		branches = append(branches, zoekt.RepositoryBranch{Name: name, Version: commit.String()})
+	}
+
+	return branches, nil
+}
+
+// openRepository opens the repository in dir, bare or not.
+func openRepository(dir string) (*git.Repository, error) {
+	repo, err := git.PlainOpenWithOptions(dir, &git.PlainOpenOptions{
+		EnableDotGitCommonDir: true,
+	})
+	if err == nil || !errors.Is(err, git.ErrRepositoryNotExists) {
+		return repo, err
+	}
+
+	return git.PlainOpenWithOptions(dir, &git.PlainOpenOptions{
+		DetectDotGit:          true,
+		EnableDotGitCommonDir: true,
+	})
+}
+
+// expandBranches expands the branch patterns in branches to the branches of
+// the repository.
+func expandBranches(repo *git.Repository, branches []string, prefix string) ([]string, error) {
+	var result []string
+	for _, branch := range branches {
+		if !strings.Contains(branch, "*") {
+			result = append(result, branch)
+			continue
+		}
+
+		iter, err := repo.Branches()
+		if err != nil {
+			return nil, err
+		}
+		err = iter.ForEach(func(ref *plumbing.Reference) error {
+			name := ref.Name().Short()
+			matched, err := filepath.Match(branch, name)
+			if err != nil || !matched {
+				return err
+			}
+			result = append(result, strings.TrimPrefix(name, prefix))
+			return nil
+		})
+		iter.Close()
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	return result, nil
+}
+
+// resolveCommit returns the commit ref points at, looking it up below prefix
+// if it is not a revision of its own.
+func resolveCommit(repo *git.Repository, prefix, ref string) (plumbing.Hash, error) {
+	hash, err := repo.ResolveRevision(plumbing.Revision(ref))
+	if err != nil {
+		hash, err = repo.ResolveRevision(plumbing.Revision(filepath.Join(prefix, ref)))
+	}
+	if err != nil {
+		return plumbing.ZeroHash, err
+	}
+
+	commit, err := repo.CommitObject(*hash)
+	if err != nil {
+		return plumbing.ZeroHash, err
+	}
+	return commit.Hash, nil
+}
