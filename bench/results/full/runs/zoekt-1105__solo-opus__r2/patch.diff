+// BranchVersions resolves the branches named in opts.Branches to the commits
+// they currently point at, exactly like IndexGitRepo does. It opens the
+// repository read-only and indexes nothing, so callers can use it to find out
+// whether the repository changed since it was last indexed.
+func BranchVersions(opts Options) ([]zoekt.RepositoryBranch, error) {
+	if opts.RepoDir == "" {
+		return nil, fmt.Errorf("gitindex: must set RepoDir")
+	}
+
+	repo, err := plainOpenRepo(opts.RepoDir)
+	if err != nil {
+		return nil, fmt.Errorf("plainOpenRepo: %w", err)
+	}
+
+	branches, _, err := branchVersions(repo, opts)
+	return branches, err
+}
+
+// branchVersions returns the branches to index along with the date of the most
+// recent commit across them.
+func branchVersions(repo *git.Repository, opts Options) ([]zoekt.RepositoryBranch, time.Time, error) {
+	names, err := expandBranches(repo, opts.Branches, opts.BranchPrefix)
+	if err != nil {
+		return nil, time.Time{}, fmt.Errorf("expandBranches: %w", err)
+	}
+
+	var branches []zoekt.RepositoryBranch
+	var latestCommitDate time.Time
+	for _, b := range names {
