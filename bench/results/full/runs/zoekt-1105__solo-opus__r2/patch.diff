+package main
+
+import (
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+// repository is a git repository found below one of the roots.
+type repository struct {
+	// Name is the repository's path relative to the root it was found under.
+	// It is the name the repository is indexed under.
+	Name string
+
+	// Path is the directory holding the repository: the working tree for
+	// normal repositories, the git directory for bare ones.
+	Path string
+}
+
+// discoverRepositories finds the git repositories below each of the roots. A
+// root that is itself a repository is returned as well. The repositories are
+// returned sorted by name; it is an error for two of them to share a name,
+// since the name determines which shards belong to which repository.
+func discoverRepositories(roots []string) ([]repository, error) {
+	var repositories []repository
+	byName := map[string]string{}
+
+	for _, root := range roots {
+		root, err := filepath.Abs(root)
+		if err != nil {
+			return nil, err
+		}
+
+		found, err := discoverRoot(root)
+		if err != nil {
+			return nil, err
+		}
+
+		for _, repo := range found {
+			if other, ok := byName[repo.Name]; ok {
+				return nil, fmt.Errorf("duplicate repository name %q: %s and %s", repo.Name, other, repo.Path)
+			}
+			byName[repo.Name] = repo.Path
+			repositories = append(repositories, repo)
+		}
+	}
+
+	sort.Slice(repositories, func(i, j int) bool {
+		return repositories[i].Name < repositories[j].Name
+	})
+	return repositories, nil
+}
+
+// discoverRoot finds the git repositories below the absolute path root.
+func discoverRoot(root string) ([]repository, error) {
+	if fi, err := os.Stat(root); err != nil {
+		return nil, err
+	} else if !fi.IsDir() {
+		return nil, fmt.Errorf("root %s is not a directory", root)
+	}
+
+	var repositories []repository
+	err := filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
+		// Best-effort: ignore directories we cannot read.
+		if err != nil || !d.IsDir() {
+			return nil //nolint:nilerr
+		}
+
+		bare, ok := gitRepositoryKind(path)
+		if !ok {
+			return nil
+		}
+
+		name, err := repositoryName(root, path, bare)
+		if err != nil {
+			return err
+		}
+		repositories = append(repositories, repository{Name: name, Path: path})
+		return fs.SkipDir
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	return repositories, nil
+}
+
+// gitRepositoryKind reports whether dir holds a git repository, and if so
+// whether it is a bare one. A ".git" entry marks a working tree; it can be a
+// directory or, for worktrees and submodules, a file pointing at the real git
+// directory. Bare repositories are recognised the same way as the rest of
+// zoekt does it: a ".git" suffixed directory holding an "objects" directory.
+func gitRepositoryKind(dir string) (bare, ok bool) {
+	if _, err := os.Lstat(filepath.Join(dir, ".git")); err == nil {
+		return false, true
+	}
+
+	if !strings.HasSuffix(dir, ".git") {
+		return false, false
+	}
+	if fi, err := os.Lstat(filepath.Join(dir, "objects")); err != nil || !fi.IsDir() {
+		return false, false
+	}
+	return true, true
+}
+
+// repositoryName derives the name of the repository at path from its location
+// relative to root. A root that is itself a repository is named after its last
+// path element.
+func repositoryName(root, path string, bare bool) (string, error) {
+	rel, err := filepath.Rel(root, path)
+	if err != nil {
+		return "", err
+	}
+	if rel == "." {
+		rel = filepath.Base(root)
+	}
+
+	name := filepath.ToSlash(rel)
+	if bare {
+		name = strings.TrimSuffix(name, ".git")
+	}
+	if name == "" || name == "/" {
+		return "", fmt.Errorf("cannot derive a repository name for %s", path)
+	}
+	return name, nil
+}
