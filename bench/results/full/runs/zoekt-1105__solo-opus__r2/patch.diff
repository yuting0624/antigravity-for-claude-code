+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+	"text/tabwriter"
+
+	"github.com/sourcegraph/zoekt"
+	"github.com/sourcegraph/zoekt/gitindex"
+	"github.com/sourcegraph/zoekt/index"
+)
+
+// shard is one index shard on disk together with the repositories it holds.
+// Simple shards hold a single repository, compound shards hold several.
+type shard struct {
+	Path string
+
+	// Repositories are the repositories in the shard that are not tombstoned.
+	Repositories []*zoekt.Repository
+}
+
+// record aggregates everything the index knows about one repository.
+type record struct {
+	Name         string
+	Source       string
+	IndexOptions string
+	Branches     []zoekt.RepositoryBranch
+
+	// Shards are the shards holding the repository, in lexical order.
+	Shards []string
+}
+
+// readInventory reads the metadata of every shard in indexDir. A missing
+// index directory is reported as an empty index rather than as an error, so
+// previewing a sync into a directory that does not exist yet works.
+func readInventory(indexDir string) ([]shard, error) {
+	paths, err := filepath.Glob(filepath.Join(indexDir, "*.zoekt"))
+	if err != nil {
+		return nil, err
+	}
+	sort.Strings(paths)
+
+	shards := make([]shard, 0, len(paths))
+	for _, path := range paths {
+		repositories, _, err := index.ReadMetadataPath(path)
+		if err != nil {
+			return nil, fmt.Errorf("reading metadata of %s: %w", path, err)
+		}
+
+		alive := make([]*zoekt.Repository, 0, len(repositories))
+		for _, repository := range repositories {
+			if !repository.Tombstone {
+				alive = append(alive, repository)
+			}
+		}
+		shards = append(shards, shard{Path: path, Repositories: alive})
+	}
+
+	return shards, nil
+}
+
+// recordsFromShards collects the shards per repository. The records are
+// returned sorted by repository name.
+func recordsFromShards(shards []shard) []record {
+	byName := map[string]*record{}
+	var names []string
+
+	for _, shard := range shards {
+		for _, repository := range shard.Repositories {
+			rec, ok := byName[repository.Name]
+			if !ok {
+				rec = &record{
+					Name:         repository.Name,
+					Source:       repository.Source,
+					IndexOptions: repository.IndexOptions,
+					Branches:     repository.Branches,
+				}
+				byName[repository.Name] = rec
+				names = append(names, repository.Name)
+			}
+			rec.Shards = append(rec.Shards, shard.Path)
+		}
+	}
+
+	sort.Strings(names)
+	records := make([]record, 0, len(names))
+	for _, name := range names {
+		records = append(records, *byName[name])
+	}
+	return records
+}
+
+// repositoryPlan is what a sync intends to do with a single repository.
+type repositoryPlan struct {
+	repository
+
+	// upToDate is set when the shards on disk already match the repository.
+	upToDate bool
+}
+
+// syncPlan is the set of changes a sync would make to the index directory.
+type syncPlan struct {
+	repositories []repositoryPlan
+
+	// remove holds the shards of repositories that are no longer below any of
+	// the roots.
+	remove []string
+
+	// shared holds shards that hold such a repository but cannot be removed
+	// because they also hold repositories that stay in the index.
+	shared []string
+}
+
+// planSync works out what syncing the repositories below roots into the index
+// directory would change. It only reads from disk.
+func planSync(opts *syncOptions, roots []string, errOut io.Writer) (*syncPlan, error) {
+	repositories, err := discoverRepositories(roots)
+	if err != nil {
+		return nil, err
+	}
+
+	inventory, err := readInventory(opts.build.IndexDir)
+	if err != nil {
+		return nil, err
+	}
+
+	indexed := map[string]record{}
+	for _, rec := range recordsFromShards(inventory) {
+		indexed[rec.Name] = rec
+	}
+
+	plan := &syncPlan{}
+	discovered := map[string]bool{}
+	for _, repo := range repositories {
+		discovered[repo.Name] = true
+
+		upToDate, err := isUpToDate(indexed[repo.Name], opts.gitOptions(repo))
+		if err != nil && !opts.force {
+			// Indexing will run into the same problem and report it properly.
+			fmt.Fprintf(errOut, "warning: cannot read the branches of %q: %v\n", repo.Name, err)
+		}
+		plan.repositories = append(plan.repositories, repositoryPlan{repository: repo, upToDate: upToDate})
+	}
+
+	stale := map[string]bool{}
+	for name := range indexed {
+		if !discovered[name] {
+			stale[name] = true
+		}
+	}
+	plan.remove, plan.shared = shardsHolding(inventory, stale)
+
+	return plan, nil
+}
+
+// isUpToDate reports whether the shards described by rec already hold the
+// current contents of the repository described by opts.
+func isUpToDate(rec record, opts gitindex.Options) (bool, error) {
+	if len(rec.Shards) == 0 {
+		return false, nil
+	}
+	if rec.Source != opts.RepoDir {
+		return false, nil
+	}
+	if rec.IndexOptions != opts.BuildOptions.GetHash() {
+		return false, nil
+	}
+
+	branches, err := gitindex.BranchVersions(opts)
+	if err != nil {
+		return false, err
+	}
+	return reflect.DeepEqual(rec.Branches, branches), nil
+}
+
+// shardsHolding splits the shards holding one of the named repositories into
+// the ones that can be removed and the ones that also hold other
+// repositories, which therefore have to stay.
+func shardsHolding(inventory []shard, names map[string]bool) (remove, shared []string) {
+	for _, shard := range inventory {
+		var holdsNamed, holdsOther bool
+		for _, repository := range shard.Repositories {
+			if names[repository.Name] {
+				holdsNamed = true
+			} else {
+				holdsOther = true
+			}
+		}
+
+		switch {
+		case !holdsNamed:
+		case holdsOther:
+			shared = append(shared, shard.Path)
+		default:
+			remove = append(remove, shard.Path)
+		}
+	}
+	return remove, shared
+}
+
+// runSync previews, or with -f applies, the plan for the roots.
+func runSync(opts *syncOptions, roots []string, out, errOut io.Writer) error {
+	if opts.build.IndexDir == "" {
+		return fmt.Errorf("no index directory, pass -index")
+	}
+
+	if !opts.force {
+		plan, err := planSync(opts, roots, errOut)
+		if err != nil {
+			return err
+		}
+
+		for _, repo := range plan.repositories {
+			if repo.upToDate {
+				fmt.Fprintf(out, "Up to date %q\n", repo.Name)
+			} else {
+				fmt.Fprintf(out, "Would index %q from %s\n", repo.Name, repo.Path)
+			}
+		}
+		reportRemovals(plan.remove, plan.shared, false, out, errOut)
+		fmt.Fprintln(out, "Pass -f to apply these changes.")
+		return nil
+	}
+
+	if err := os.MkdirAll(opts.build.IndexDir, 0o755); err != nil {
+		return err
+	}
+	lock, err := acquireDirectoryLock(opts.build.IndexDir)
+	if err != nil {
+		return err
+	}
+	defer lock.Close()
+
+	plan, err := planSync(opts, roots, errOut)
+	if err != nil {
+		return err
+	}
+
+	var failed int
+	for _, repo := range plan.repositories {
+		if repo.upToDate {
+			fmt.Fprintf(out, "Up to date %q\n", repo.Name)
+			continue
+		}
+
+		fmt.Fprintf(out, "Indexing %q from %s\n", repo.Name, repo.Path)
+		updated, err := gitindex.IndexGitRepo(opts.gitOptions(repo.repository))
+		switch {
+		case err != nil:
+			fmt.Fprintf(errOut, "failed to index %q: %v\n", repo.Name, err)
+			failed++
+		case updated:
+			fmt.Fprintf(out, "Indexed %q\n", repo.Name)
+		default:
+			fmt.Fprintf(out, "Up to date %q\n", repo.Name)
+		}
+	}
+
+	if err := removeShards(plan.remove, plan.shared, out, errOut); err != nil {
+		return err
+	}
+	if failed > 0 {
+		return fmt.Errorf("%d of %d repositories failed to index", failed, len(plan.repositories))
+	}
+	return nil
+}
+
+// runList prints the repositories in the index directory.
+func runList(indexDir string, out io.Writer) error {
+	inventory, err := readInventory(indexDir)
+	if err != nil {
+		return err
+	}
+
+	w := tabwriter.NewWriter(out, 0, 0, 2, ' ', 0)
+	fmt.Fprintln(w, "NAME\tSOURCE\tSHARDS")
+	for _, rec := range recordsFromShards(inventory) {
+		fmt.Fprintf(w, "%s\t%s\t%s\n", rec.Name, rec.Source, strings.Join(rec.Shards, " "))
+	}
+	return w.Flush()
+}
+
+// runRemove previews, or with -f applies, the removal of the named
+// repositories. A repository can be named by its index name or by its source
+// directory.
+func runRemove(indexDir string, names []string, force bool, out, errOut io.Writer) error {
+	if indexDir == "" {
+		return fmt.Errorf("no index directory, pass -index")
+	}
+
+	if force {
+		lock, err := acquireDirectoryLock(indexDir)
+		if err != nil {
+			return err
+		}
+		defer lock.Close()
+
+		remove, shared, err := selectShards(indexDir, names)
+		if err != nil {
+			return err
+		}
+		return removeShards(remove, shared, out, errOut)
+	}
+
+	remove, shared, err := selectShards(indexDir, names)
+	if err != nil {
+		return err
+	}
+	reportRemovals(remove, shared, false, out, errOut)
+	fmt.Fprintln(out, "Pass -f to apply these changes.")
+	return nil
+}
+
+// selectShards resolves the repository names to the shards holding them.
+func selectShards(indexDir string, names []string) (remove, shared []string, err error) {
+	inventory, err := readInventory(indexDir)
+	if err != nil {
+		return nil, nil, err
+	}
+	records := recordsFromShards(inventory)
+
+	selected := map[string]bool{}
+	for _, name := range names {
+		var matched bool
+		for _, rec := range records {
+			if rec.Name == name || rec.Source == name || rec.Source == filepath.Clean(name) {
+				selected[rec.Name] = true
+				matched = true
+			}
+		}
+		if !matched {
+			return nil, nil, fmt.Errorf("no indexed repository matches %q", name)
+		}
+	}
+
+	remove, shared = shardsHolding(inventory, selected)
+	return remove, shared, nil
+}
+
+// reportRemovals announces the shards that are about to be, or would be,
+// removed and warns about the ones that have to stay.
+func reportRemovals(remove, shared []string, applied bool, out, errOut io.Writer) {
+	verb := "Would remove"
+	if applied {
+		verb = "Removing"
+	}
+	for _, path := range remove {
+		fmt.Fprintf(out, "%s %s\n", verb, path)
+	}
+	for _, path := range shared {
+		fmt.Fprintf(errOut, "not removing %s: it also holds repositories that stay in the index\n", path)
+	}
+}
+
+// removeShards deletes the shards and their metadata sidecars.
+func removeShards(remove, shared []string, out, errOut io.Writer) error {
+	reportRemovals(remove, shared, true, out, errOut)
+
+	for _, shard := range remove {
+		paths, err := index.IndexFilePaths(shard)
+		if err != nil {
+			return fmt.Errorf("listing the files of %s: %w", shard, err)
+		}
+		for _, path := range paths {
+			if err := os.Remove(path); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
