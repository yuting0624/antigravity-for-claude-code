@@ -0,0 +1,228 @@
+// Copyright 2026 Sourcegraph, Inc. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Command zoekt-local-sync keeps an index in sync with the git repositories
+// found below a set of directories on the same machine. It indexes the
+// repositories it discovers and drops the shards of repositories that are no
+// longer below any of the roots. Everything it does is a preview until -f is
+// passed.
+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+
+	"github.com/sourcegraph/zoekt"
+	"github.com/sourcegraph/zoekt/gitindex"
+	"github.com/sourcegraph/zoekt/index"
+	"github.com/sourcegraph/zoekt/internal/ctags"
+)
+
+// commandName is how the command names itself in usage and error messages.
+const commandName = "zoekt-local-sync"
+
+func main() {
+	if err := execute(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if !errors.Is(err, flag.ErrHelp) {
+			fmt.Fprintf(os.Stderr, "%s: %v\n", commandName, err)
+		}
+		os.Exit(1)
+	}
+}
+
+// execute runs a single command line, writing its report to out and anything
+// the user did not ask for to errOut.
+func execute(args []string, out, errOut io.Writer) error {
+	if len(args) > 0 {
+		switch args[0] {
+		case "help", "-h", "-help", "--help":
+			printUsage(out)
+			return nil
+		case "sync":
+			return syncCommand(args[1:], out, errOut)
+		case "list":
+			return listCommand(args[1:], out, errOut)
+		case "remove":
+			return removeCommand(args[1:], out, errOut)
+		}
+	}
+
+	// Syncing is what the command is for, so it needs no subcommand.
+	return syncCommand(args, out, errOut)
+}
+
+// syncOptions holds the options of a sync. They are also the options used to
+// index a single repository.
+type syncOptions struct {
+	build index.Options
+
+	force        bool
+	submodules   bool
+	branches     string
+	branchPrefix string
+	allowMissing bool
+	repoCacheDir string
+	languageMap  string
+}
+
+// flagSet registers the sync options on a new flag set writing to out.
+func (o *syncOptions) flagSet(out io.Writer) *flag.FlagSet {
+	fs := flag.NewFlagSet(commandName+" sync", flag.ContinueOnError)
+	fs.SetOutput(out)
+
+	o.build.IndexDir = index.DefaultDir
+	o.build.Flags(fs)
+
+	fs.BoolVar(&o.force, "f", false, "apply the plan. Without it the sync only reports what it would do.")
+	fs.StringVar(&o.branches, "branches", "HEAD", "comma separated list of git branches to index.")
+	fs.StringVar(&o.branchPrefix, "prefix", "refs/heads/", "prefix for branch names")
+	fs.BoolVar(&o.submodules, "submodules", true, "if set to false, do not recurse into submodules")
+	fs.BoolVar(&o.allowMissing, "allow_missing_branches", false, "allow missing branches.")
+	fs.StringVar(&o.repoCacheDir, "repo_cache", "", "directory holding bare git repos. this is used to find repositories for submodules.")
+	fs.StringVar(&o.languageMap, "language_map", "", "a mapping between a language and its ctags processor (a:0,b:3).")
+
+	fs.Usage = func() {
+		fmt.Fprintf(fs.Output(), "Usage: %s sync [options] <root>...\n\n", commandName)
+		fmt.Fprintf(fs.Output(), "Indexes the git repositories below each <root> and removes the shards of\n")
+		fmt.Fprintf(fs.Output(), "repositories that are no longer below one of them.\n\n")
+		fs.PrintDefaults()
+	}
+	return fs
+}
+
+// finish fills in the defaults that depend on the parsed flags.
+func (o *syncOptions) finish() {
+	o.build.SetDefaults()
+
+	o.build.LanguageMap = make(ctags.LanguageMap)
+	for mapping := range strings.SplitSeq(o.languageMap, ",") {
+		m := strings.Split(mapping, ":")
+		if len(m) != 2 {
+			continue
+		}
+		o.build.LanguageMap[m[0]] = ctags.StringToParser(m[1])
+	}
+}
+
+// gitOptions returns the options for indexing a single discovered repository.
+// The name discovery picked is kept, so the shards of a repository can be
+// found back from its location on disk.
+func (o *syncOptions) gitOptions(repo repository) gitindex.Options {
+	build := o.build
+	build.RepositoryDescription = zoekt.Repository{Name: repo.Name, Source: repo.Path}
+
+	var branches []string
+	if o.branches != "" {
+		branches = strings.Split(o.branches, ",")
+	}
+
+	return gitindex.Options{
+		RepoDir:            repo.Path,
+		Branches:           branches,
+		BranchPrefix:       o.branchPrefix,
+		Submodules:         o.submodules,
+		RepoCacheDir:       o.repoCacheDir,
+		AllowMissingBranch: o.allowMissing,
+		Incremental:        true,
+		BuildOptions:       build,
+	}
+}
+
+func syncCommand(args []string, out, errOut io.Writer) error {
+	var opts syncOptions
+	fs := opts.flagSet(errOut)
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	roots := fs.Args()
+	if len(roots) == 0 {
+		fs.Usage()
+		return fmt.Errorf("need at least one root directory to sync")
+	}
+	opts.finish()
+
+	return runSync(&opts, roots, out, errOut)
+}
+
+func listCommand(args []string, out, errOut io.Writer) error {
+	fs := flag.NewFlagSet(commandName+" list", flag.ContinueOnError)
+	fs.SetOutput(errOut)
+	indexDir := fs.String("index", index.DefaultDir, "directory for search indices")
+	fs.Usage = func() {
+		fmt.Fprintf(fs.Output(), "Usage: %s list [options]\n\n", commandName)
+		fmt.Fprintf(fs.Output(), "Prints the repositories currently in the index.\n\n")
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	if fs.NArg() > 0 {
+		fs.Usage()
+		return fmt.Errorf("list takes no arguments")
+	}
+
+	return runList(*indexDir, out)
+}
+
+func removeCommand(args []string, out, errOut io.Writer) error {
+	fs := flag.NewFlagSet(commandName+" remove", flag.ContinueOnError)
+	fs.SetOutput(errOut)
+	indexDir := fs.String("index", index.DefaultDir, "directory for search indices")
+	force := fs.Bool("f", false, "apply the removal. Without it the removal is only reported.")
+	fs.Usage = func() {
+		fmt.Fprintf(fs.Output(), "Usage: %s remove [options] <repository>...\n\n", commandName)
+		fmt.Fprintf(fs.Output(), "Removes repositories from the index. A repository is named either by the\n")
+		fmt.Fprintf(fs.Output(), "name it is indexed under or by the directory it was indexed from.\n\n")
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	if fs.NArg() == 0 {
+		fs.Usage()
+		return fmt.Errorf("need at least one repository to remove")
+	}
+
+	return runRemove(*indexDir, fs.Args(), *force, out, errOut)
+}
+
+// printUsage writes the overview of the command and the defaults of the sync
+// options to out.
+func printUsage(out io.Writer) {
+	fmt.Fprintf(out, `%[1]s keeps an index in sync with the git repositories found below one
+or more local root directories. A repository is indexed under its path
+relative to the root it was found under.
+
+Usage:
+  %[1]s [options] <root>...          same as "%[1]s sync"
+  %[1]s sync [options] <root>...     index the repositories below <root>
+  %[1]s list [options]               list the repositories in the index
+  %[1]s remove [options] <repo>...   remove repositories from the index
+
+Every command only reports what it would do until -f is passed. Run
+"%[1]s sync -h", "%[1]s list -h" or
+"%[1]s remove -h" for the options of a single subcommand.
+
+Default sync options:
+`, commandName)
+
+	var opts syncOptions
+	fs := opts.flagSet(out)
+	fs.PrintDefaults()
+}
