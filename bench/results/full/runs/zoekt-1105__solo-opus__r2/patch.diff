+		if err != nil {
+			if opts.AllowMissingBranch && err.Error() == "reference not found" {
+				continue
+			}
+
+			return nil, time.Time{}, fmt.Errorf("getCommit(%q, %q): %w", opts.BranchPrefix, b, err)
+		}
+
+		branches = append(branches, zoekt.RepositoryBranch{
+			Name:    b,
+			Version: commit.Hash.String(),
+		})
+
+		if when := commit.Committer.When; when.After(latestCommitDate) {
+			latestCommitDate = when
+		}
+	}
+
+	return branches, latestCommitDate, nil
+}
