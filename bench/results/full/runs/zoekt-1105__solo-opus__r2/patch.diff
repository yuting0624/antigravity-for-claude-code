+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"syscall"
+)
+
+// lockFileName is the file in the index directory that runs writing to the
+// index hold a lock on.
+const lockFileName = ".zoekt-local-sync.lock"
+
+// directoryLock is an exclusive lock on an index directory.
+type directoryLock struct {
+	file *os.File
+}
+
+// acquireDirectoryLock takes the exclusive lock on the index directory so two
+// runs cannot interleave their writes. It does not wait: if another run holds
+// the lock, it fails right away. The kernel drops the lock if the process
+// holding it dies, so a crashed run never leaves the directory locked.
+func acquireDirectoryLock(indexDir string) (*directoryLock, error) {
+	path := filepath.Join(indexDir, lockFileName)
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		return nil, fmt.Errorf("locking %s: %w", indexDir, err)
+	}
+
+	if err := syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		f.Close()
+		return nil, fmt.Errorf("another %s is working on %s: %w", commandName, indexDir, err)
+	}
+	return &directoryLock{file: f}, nil
+}
+
+// Close releases the lock. The lock file itself is left behind: removing it
+// would race with a run that has opened it but not locked it yet.
+func (l *directoryLock) Close() error {
+	err := syscall.Flock(int(l.file.Fd()), syscall.LOCK_UN)
+	if closeErr := l.file.Close(); err == nil {
+		err = closeErr
+	}
+	return err
+}
diff --git a/cmd/zoekt-local-sync/main.go b/cmd/zoekt-local-sync/main.go
