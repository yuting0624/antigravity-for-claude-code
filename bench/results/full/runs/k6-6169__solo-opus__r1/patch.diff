diff --git a/internal/cloudapi/clientcfg/clientcfg.go b/internal/cloudapi/clientcfg/clientcfg.go
new file mode 100644
index 000000000..3b994aaa2
--- /dev/null
+++ b/internal/cloudapi/clientcfg/clientcfg.go
@@ -0,0 +1,15 @@
+// Package clientcfg holds the HTTP retry knobs shared by k6 Cloud's API
+// clients. They live in their own package so the generated-SDK clients
+// (internal/cloudapi/v6) and the hand-written ones
+// (internal/cloudapi/provisioning) cannot drift apart.
+package clientcfg
+
+import "time"
+
+const (
+	// RetryInterval is the wait between two attempts of the same request.
+	RetryInterval = 500 * time.Millisecond
+
+	// MaxRetries is how many times a failed request is retried.
+	MaxRetries = 3
+)
diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..fe6994100
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,292 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// archiveContentType is the media type of a k6 archive.
+const archiveContentType = "application/x-tar"
+
+// StartLocalExecutionRequest describes the test run to provision.
+type StartLocalExecutionRequest struct {
+	// Options is the resolved set of k6 script options, as JSON.
+	Options json.RawMessage
+	// MaxVUs is the maximum number of VUs the test can reach.
+	MaxVUs int64
+	// TotalDuration is the total duration of the test, in seconds.
+	TotalDuration int64
+	// ArchiveSize is the size of the k6 archive in bytes. Zero means no
+	// archive is going to be uploaded.
+	ArchiveSize int64
+}
+
+// StartLocalExecutionResponse is the outcome of starting a local execution.
+type StartLocalExecutionResponse struct {
+	// TestRunID is the id of the test run that was created.
+	TestRunID int64
+	// ArchiveUploadURL is the presigned URL to PUT the archive to, if the
+	// backend expects one.
+	ArchiveUploadURL *string
+	// TestRunDetailsPageURL is the Grafana web app URL of the test run.
+	TestRunDetailsPageURL string
+	// RuntimeConfig tells k6 where and how to report the run's data.
+	RuntimeConfig RuntimeConfig
+}
+
+// RuntimeConfig is the part of the provisioning API's runtime config that
+// local execution acts on.
+type RuntimeConfig struct {
+	// Metrics configures the metrics ingestion endpoint.
+	Metrics MetricsConfig
+	// TestRunToken is a short-lived token scoped to this test run. It
+	// authenticates the metrics pushes, the secret lookups and the
+	// end-of-test notification.
+	TestRunToken string
+	// Secrets configures the cloud secret source.
+	Secrets SecretsConfig
+}
+
+// MetricsConfig is the metrics section of the runtime config. Every field
+// but the push URL is optional: a nil pointer means "keep the k6 default".
+type MetricsConfig struct {
+	// PushURL is the absolute URL metrics batches are pushed to.
+	PushURL string
+	// PushInterval is the interval between two pushes, as a duration string.
+	PushInterval *string
+	// PushConcurrency is how many pushes may be in flight at once.
+	PushConcurrency *int32
+	// AggregationPeriod is the sample aggregation period, as a duration string.
+	AggregationPeriod *string
+	// AggregationWaitPeriod is how long to wait for a period's samples to
+	// accumulate before aggregating them, as a duration string.
+	AggregationWaitPeriod *string
+	// AggregationMinSamples is the minimum number of samples to aggregate.
+	AggregationMinSamples *int32
+	// MaxSamplesPerPackage is the max number of time series in one batch.
+	MaxSamplesPerPackage *int32
+}
+
+// SecretsConfig is the secrets section of the runtime config.
+type SecretsConfig struct {
+	// Endpoint is the URL template of the secret decryption endpoint.
+	Endpoint string
+	// ResponsePath is the JSON path of the secret value in the response.
+	ResponsePath string
+}
+
+// StartLocalExecution starts a test run of the given load test in local
+// execution mode.
+func (c *Client) StartLocalExecution(
+	ctx context.Context, loadTestID int64, req StartLocalExecutionRequest,
+) (_ *StartLocalExecutionResponse, err error) {
+	body, err := newStartLocalExecutionBody(req)
+	if err != nil {
+		return nil, err
+	}
+
+	key, err := idempotencyKey()
+	if err != nil {
+		return nil, err
+	}
+
+	res, hr, err := c.apiClient.ProvisioningAPI.
+		StartLocalExecutionTest(c.authCtx(ctx), loadTestID).
+		K6IdempotencyKey(key).
+		StartLocalExecutionTestRequest(body).
+		Execute()
+	defer drainAndClose(hr, &err)
+
+	if err := checkAPIResponse(hr, err); err != nil {
+		return nil, err
+	}
+	if res == nil {
+		return nil, errUnknown
+	}
+
+	return newStartLocalExecutionResponse(res), nil
+}
+
+func newStartLocalExecutionBody(req StartLocalExecutionRequest) (*k6cloud.StartLocalExecutionTestRequest, error) {
+	opts := map[string]any{}
+	if len(req.Options) > 0 {
+		if err := json.Unmarshal(req.Options, &opts); err != nil {
+			return nil, fmt.Errorf("decoding the script options: %w", err)
+		}
+	}
+
+	maxVUs, err := toInt32("max VUs", req.MaxVUs)
+	if err != nil {
+		return nil, err
+	}
+	totalDuration, err := toInt32("total duration", req.TotalDuration)
+	if err != nil {
+		return nil, err
+	}
+
+	body := k6cloud.NewStartLocalExecutionTestRequest(opts, maxVUs, totalDuration)
+
+	// The field must always be present: an explicit null tells the backend
+	// not to expect an archive, while omitting it is a validation error.
+	var archiveSize *int32
+	if req.ArchiveSize > 0 {
+		size, err := toInt32("archive size", req.ArchiveSize)
+		if err != nil {
+			return nil, err
+		}
+		archiveSize = &size
+	}
+	body.ArchiveSize = *k6cloud.NewNullableInt32(archiveSize)
+
+	return body, nil
+}
+
+func newStartLocalExecutionResponse(res *k6cloud.StartLocalExecutionTestResponse) *StartLocalExecutionResponse {
+	rc := res.GetRuntimeConfig()
+	metrics := rc.GetMetrics()
+	secrets := rc.GetSecrets()
+
+	return &StartLocalExecutionResponse{
+		TestRunID:             res.GetTestRunId(),
+		ArchiveUploadURL:      res.ArchiveUploadUrl.Get(),
+		TestRunDetailsPageURL: res.GetTestRunDetailsPageUrl(),
+		RuntimeConfig: RuntimeConfig{
+			TestRunToken: rc.GetTestRunToken(),
+			Metrics: MetricsConfig{
+				PushURL:               metrics.GetPushUrl(),
+				PushInterval:          metrics.PushInterval.Get(),
+				PushConcurrency:       metrics.PushConcurrency.Get(),
+				AggregationPeriod:     metrics.AggregationPeriod.Get(),
+				AggregationWaitPeriod: metrics.AggregationWaitPeriod.Get(),
+				AggregationMinSamples: metrics.AggregationMinSamples.Get(),
+				MaxSamplesPerPackage:  metrics.MaxSamplesPerPackage.Get(),
+			},
+			Secrets: SecretsConfig{
+				Endpoint:     secrets.GetEndpoint(),
+				ResponsePath: secrets.GetResponsePath(),
+			},
+		},
+	}
+}
+
+// UploadArchive PUTs the k6 archive to a presigned URL.
+//
+// Presigned URLs carry their own credentials in the query string, so the
+// request must not be signed again: an extra Authorization header makes S3
+// reject it.
+func (c *Client) UploadArchive(ctx context.Context, uploadURL string, archive []byte) error {
+	var err error
+	for attempt := 0; attempt <= clientcfg.MaxRetries; attempt++ {
+		if attempt > 0 {
+			if werr := wait(ctx, clientcfg.RetryInterval); werr != nil {
+				return werr
+			}
+		}
+
+		var retry bool
+		retry, err = c.uploadArchive(ctx, uploadURL, archive)
+		if err == nil {
+			return nil
+		}
+		if !retry {
+			return err
+		}
+
+		c.logger.WithError(err).Debugf(
+			"Uploading the archive failed, retrying (%d/%d)", attempt+1, clientcfg.MaxRetries)
+	}
+
+	return err
+}
+
+func (c *Client) uploadArchive(ctx context.Context, uploadURL string, archive []byte) (retry bool, err error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPut, uploadURL, bytes.NewReader(archive))
+	if err != nil {
+		return false, err
+	}
+	req.Header.Set("Content-Type", archiveContentType)
+
+	res, err := c.httpClient.Do(req) //nolint:bodyclose // closed by drainAndClose below
+	if err != nil {
+		return !isCanceled(err), err
+	}
+	defer drainAndClose(res, &err)
+
+	if err := CheckResponse(res); err != nil {
+		return isRetriableStatus(res.StatusCode), err
+	}
+
+	return false, nil
+}
+
+// WaitForTestRunReady polls the test run until the backend reports it is
+// initializing, which is when it starts accepting metrics.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	var lastStatus v6.Status
+
+	for {
+		progress, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			return err
+		}
+
+		switch progress.Status {
+		case v6.StatusInitializing:
+			return nil
+		case v6.StatusAborted:
+			return abortedError(progress)
+		case v6.StatusCompleted:
+			return fmt.Errorf("test run %d is already completed", testRunID)
+		}
+
+		if progress.Status != lastStatus {
+			lastStatus = progress.Status
+			c.logger.WithField("status", progress.FormatStatus()).Info("Waiting for the test run to be ready...")
+		}
+
+		if err := wait(ctx, pollInterval); err != nil {
+			return err
+		}
+	}
+}
+
+func abortedError(progress *v6.TestProgress) error {
+	for i := len(progress.StatusHistory) - 1; i >= 0; i-- {
+		e := progress.StatusHistory[i]
+		if e.Status == v6.StatusAborted && e.Message != "" {
+			return fmt.Errorf("test run aborted before starting: %s", e.Message)
+		}
+	}
+
+	return errors.New("test run aborted before starting")
+}
+
+func idempotencyKey() (string, error) {
+	var key [8]byte
+	if _, err := rand.Read(key[:]); err != nil {
+		return "", err
+	}
+
+	return hex.EncodeToString(key[:]), nil
+}
+
+func toInt32(name string, v int64) (int32, error) {
+	if v < math.MinInt32 || v > math.MaxInt32 {
+		return 0, fmt.Errorf("%s %d overflows int32", name, v)
+	}
+
+	return int32(v), nil
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..d08ce275e
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,88 @@
+package provisioning
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strconv"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client talks to the Grafana Cloud k6 provisioning API.
+//
+// It owns a v6 client too: provisioning a local execution needs the v6
+// load-test and test-run endpoints, and both APIs are served by the same
+// host with the same credentials.
+type Client struct {
+	apiClient  *k6cloud.APIClient
+	v6Client   *v6.Client
+	httpClient *http.Client
+
+	logger  logrus.FieldLogger
+	token   string
+	version string
+	stackID int64
+}
+
+// NewClient returns a client for the provisioning API of the given host.
+func NewClient(
+	logger logrus.FieldLogger, token, host, version string, stackID int64, timeout time.Duration,
+) (*Client, error) {
+	if token == "" {
+		return nil, errors.New("token is required to create the provisioning API client")
+	}
+
+	v6Client, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if err := v6Client.SetStackID(stackID); err != nil {
+		return nil, err
+	}
+
+	httpClient := &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Global k6 Cloud API.",
+		},
+	}
+	cfg.HTTPClient = httpClient
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+	// Unlike the v6 endpoints, the provisioning ones don't take the stack as
+	// a per-request parameter, so it's pinned on the client instead.
+	cfg.AddDefaultHeader("X-Stack-Id", strconv.FormatInt(stackID, 10))
+
+	return &Client{
+		apiClient:  k6cloud.NewAPIClient(cfg),
+		v6Client:   v6Client,
+		httpClient: httpClient,
+		logger:     logger,
+		token:      token,
+		version:    version,
+		stackID:    stackID,
+	}, nil
+}
+
+// authCtx returns a context authenticating with the user's token.
+func (c *Client) authCtx(ctx context.Context) context.Context {
+	return context.WithValue(ctx, k6cloud.ContextAccessToken, c.token)
+}
+
+// scopedCtx returns a context authenticating with a test-run-scoped token.
+func (c *Client) scopedCtx(ctx context.Context, token string) context.Context {
+	return context.WithValue(ctx, k6cloud.ContextAccessToken, token)
+}
