index 000000000..0ecb6002c
--- /dev/null
+++ b/internal/cloudapi/provisioning/doc.go
@@ -0,0 +1,14 @@
+// Package provisioning talks to the Grafana Cloud k6 provisioning API on
+// behalf of `k6 cloud run --local-execution`.
+//
+// The local-execution flow is a composition of three APIs: the v6 load-test
+// API creates (or finds) the load test, the provisioning API starts a
+// test run for it and hands back a runtime config, and the v6 test-run API
+// reports when that run is ready for metrics. [Client.ProvisionLocalExecution]
+// drives all of them, so the command layer only deals in
+// [ProvisionParams] and [ProvisionResult].
+//
+// The runtime config returned by the provisioning API carries a short-lived,
+// test-run-scoped token. It is only ever kept in memory: it must not be
+// written to the archive, the config file, or the environment.
+package provisioning
diff --git a/internal/cloudapi/provisioning/errors.go b/internal/cloudapi/provisioning/errors.go
new file mode 100644
index 000000000..a7d8ea7c0
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,95 @@
+package provisioning
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+// errUnknown is returned when a call fails without leaving a response behind.
+var errUnknown = errors.New("an error occurred communicating with k6 Cloud")
+
+// ResponseError is the error returned for any non-2xx HTTP response coming
+// from the provisioning API or from a presigned upload URL.
+//
+// 401 and 403 responses additionally wrap the shared sentinels from
+// [httperr], so callers can classify them with [errors.Is] exactly like they
+// do for the v6 client.
+type ResponseError struct {
+	// StatusCode is the HTTP status code of the response.
+	StatusCode int
+	// Body is the (trimmed) response body, kept verbatim: the provisioning
+	// API and S3 don't share an error envelope, so there's nothing to parse.
+	Body string
+
+	// classified is the [httperr] sentinel for StatusCode, if any.
+	classified error
+}
+
+// Error implements the error interface.
+func (e *ResponseError) Error() string {
+	msg := fmt.Sprintf("unexpected HTTP response from k6 Cloud: %d %s",
+		e.StatusCode, http.StatusText(e.StatusCode))
+	if e.Body == "" {
+		return msg
+	}
+	return msg + ": " + e.Body
+}
+
+// Unwrap returns the [httperr] sentinel matching the status code, if any.
+func (e *ResponseError) Unwrap() error { return e.classified }
+
+// CheckResponse returns nil when the response status is in the successful
+// range, and a [ResponseError] carrying the response body otherwise.
+func CheckResponse(r *http.Response) error {
+	if r == nil {
+		return errUnknown
+	}
+	if c := r.StatusCode; c >= 200 && c <= 299 {
+		return nil
+	}
+
+	var body string
+	if r.Body != nil {
+		data, err := io.ReadAll(r.Body)
+		if err != nil {
+			return err
+		}
+		body = strings.TrimSpace(string(data))
+	}
+
+	return &ResponseError{
+		StatusCode: r.StatusCode,
+		Body:       body,
+		classified: httperr.ClassifyStatus(r.StatusCode),
+	}
+}
+
+// checkAPIResponse adapts [CheckResponse] to the (response, error) pair the
+// generated SDK returns. The SDK reports every non-2xx status as a
+// [k6cloud.GenericOpenAPIError] while leaving the response body readable, so
+// such errors are dropped in favour of the richer [ResponseError]; any other
+// error is a transport failure and is returned as is.
+func checkAPIResponse(r *http.Response, err error) error {
+	if err != nil {
+		var aerr *k6cloud.GenericOpenAPIError
+		if !errors.As(err, &aerr) {
+			return err
+		}
+	}
+	if r == nil {
+		return errUnknown
+	}
+	if c := r.StatusCode; c >= 200 && c <= 299 {
+		// A 2xx with an error means the response body failed to decode.
+		return err
+	}
+
+	return CheckResponse(r)
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..f75aecc3e
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,139 @@
+package provisioning
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient is a small JSON-over-HTTP client for the endpoints that are
+// scoped to a single test run: they authenticate with the short-lived
+// test-run token instead of the user's personal token, so they can't reuse
+// the generated SDK client, which is built once per process.
+//
+// It retries server-side failures with the same budget as the other cloud
+// clients, and it decodes successful responses into the caller's value.
+type HTTPClient struct {
+	client  *http.Client
+	token   string
+	version string
+	logger  logrus.FieldLogger
+}
+
+// NewHTTPClient returns an HTTPClient sending every request with the given
+// test-run-scoped token.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	return &HTTPClient{
+		client:  client,
+		token:   token,
+		version: version,
+		logger:  logger,
+	}
+}
+
+// Do sends req and, when v is not nil, decodes the JSON response body into it.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	req.Header.Set("Authorization", "Bearer "+c.token)
+	req.Header.Set("User-Agent", "k6cloud/"+c.version)
+
+	var err error
+	for attempt := 0; attempt <= clientcfg.MaxRetries; attempt++ {
+		if attempt > 0 {
+			if werr := wait(req.Context(), clientcfg.RetryInterval); werr != nil {
+				return werr
+			}
+			if rerr := rewind(req); rerr != nil {
+				return rerr
+			}
+		}
+
+		var retry bool
+		retry, err = c.do(req, v)
+		if err == nil {
+			return nil
+		}
+		if !retry {
+			return err
+		}
+
+		c.logger.WithError(err).Debugf(
+			"Request to %s failed, retrying (%d/%d)", req.URL, attempt+1, clientcfg.MaxRetries)
+	}
+
+	return err
+}
+
+// do performs a single attempt. It reports whether the failure is worth
+// retrying.
+func (c *HTTPClient) do(req *http.Request, v any) (retry bool, err error) {
+	res, err := c.client.Do(req) //nolint:bodyclose // closed by drainAndClose below
+	if err != nil {
+		return !isCanceled(err), err
+	}
+	defer drainAndClose(res, &err)
+
+	if err := CheckResponse(res); err != nil {
+		return isRetriableStatus(res.StatusCode), err
+	}
+	if v == nil {
+		return false, nil
+	}
+
+	return false, json.NewDecoder(res.Body).Decode(v)
+}
+
+// isRetriableStatus reports whether a response with the given status code is
+// worth another attempt.
+func isRetriableStatus(statusCode int) bool {
+	return statusCode >= http.StatusInternalServerError || statusCode == http.StatusTooManyRequests
+}
+
+func isCanceled(err error) bool {
+	return errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded)
+}
+
+// wait sleeps for d, or returns early with the context's error if it is done
+// first, so a canceled test doesn't have to sit through the retry interval.
+func wait(ctx context.Context, d time.Duration) error {
+	t := time.NewTimer(d)
+	defer t.Stop()
+
+	select {
+	case <-t.C:
+		return nil
+	case <-ctx.Done():
+		return fmt.Errorf("waiting to retry the request: %w", ctx.Err())
+	}
+}
+
+// rewind restores a consumed request body so the request can be sent again.
+func rewind(req *http.Request) error {
+	if req.GetBody == nil {
+		return nil
+	}
+	body, err := req.GetBody()
+	if err != nil {
+		return fmt.Errorf("rewinding the request body: %w", err)
+	}
+	req.Body = body
+
+	return nil
+}
+
+func drainAndClose(res *http.Response, rerr *error) {
+	if res == nil {
+		return
+	}
+	_, _ = io.Copy(io.Discard, res.Body)
+	if err := res.Body.Close(); err != nil && *rerr == nil {
+		*rerr = err
+	}
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..a4dfb8568
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,92 @@
+package provisioning
+
+import (
+	"context"
+	"errors"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+// scriptExecutionCompletedEvent is the only lifecycle event local execution
+// reports: k6 tells the backend the script is done, and how it ended.
+const scriptExecutionCompletedEvent = "script_execution_completed"
+
+// Error codes the backend uses to classify how a local execution ended.
+const (
+	// notifyCodeTimeout covers the failures k6 itself didn't cause: the test
+	// ran out of time, or an output gave up.
+	notifyCodeTimeout int32 = 8034
+	// notifyCodeScriptError is a script that threw.
+	notifyCodeScriptError int32 = 8035
+	// notifyCodeAborted is a test stopped on purpose, by the user or by the
+	// script.
+	notifyCodeAborted int32 = 8036
+)
+
+// notifyError is the error k6 reports at the end of a local execution.
+type notifyError struct {
+	// Code is the backend's classification of the failure. It is zero when
+	// k6 stopped for a reason the backend has no code for.
+	Code int32
+	// Reason is the human-readable error message.
+	Reason string
+}
+
+// NotifyTestRunCompleted tells the provisioning API that the local script
+// execution is over, reporting testErr (if any) as the reason.
+//
+// The call authenticates with the test-run-scoped token rather than the
+// user's, since by this point the run is the only thing k6 still owns.
+func (c *Client) NotifyTestRunCompleted(
+	ctx context.Context, testRunID int64, token string, testErr error,
+) (err error) {
+	body := k6cloud.NewScriptExecutionCompletedNotificationApiModel(scriptExecutionCompletedEvent)
+	// The field is always sent: an explicit null is how a clean run is
+	// reported, so it can't be left out of the payload.
+	var reportedErr *k6cloud.ScriptExecutionError
+	if nerr := mapTestErrorToNotifyCode(testErr); nerr != nil {
+		reportedErr = k6cloud.NewScriptExecutionError(nerr.Code, nerr.Reason)
+	}
+	body.Error = *k6cloud.NewNullableScriptExecutionError(reportedErr)
+
+	hr, err := c.apiClient.ProvisioningAPI.
+		TestRunsNotify(c.scopedCtx(ctx, token), testRunID).
+		ScriptExecutionCompletedNotificationApiModel(body).
+		Execute()
+	defer drainAndClose(hr, &err)
+
+	return checkAPIResponse(hr, err)
+}
+
+// mapTestErrorToNotifyCode translates the error k6 ended the test with into
+// the notification's error payload. It returns nil when there's nothing to
+// report, which is both a clean run and a run whose only failure was
+// thresholds crossing after the test had already ended: in the latter case
+// the run itself completed, and the backend learns about the thresholds
+// from the metrics.
+func mapTestErrorToNotifyCode(err error) *notifyError {
+	if err == nil {
+		return nil
+	}
+
+	var abortErr errext.HasAbortReason
+	if !errors.As(err, &abortErr) {
+		return &notifyError{Reason: err.Error()}
+	}
+
+	var code int32
+	switch abortErr.AbortReason() {
+	case errext.AbortedByThresholdsAfterTestEnd:
+		return nil
+	case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+		code = notifyCodeAborted
+	case errext.AbortedByScriptError:
+		code = notifyCodeScriptError
+	case errext.AbortedByTimeout, errext.AbortedByOutput:
+		code = notifyCodeTimeout
+	}
+
+	return &notifyError{Code: code, Reason: err.Error()}
+}
diff --git a/internal/cloudapi/provisioning/provision.go b/internal/cloudapi/provisioning/provision.go
new file mode 100644
index 000000000..e95220db5
--- /dev/null
+++ b/internal/cloudapi/provisioning/provision.go
@@ -0,0 +1,123 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"go.k6.io/k6/v2/lib"
+)
+
+// DefaultPollInterval is how often the test run is polled while waiting for
+// the backend to make it ready.
+const DefaultPollInterval = 1 * time.Second
+
+// ProvisionParams describes the test run to provision for local execution.
+type ProvisionParams struct {
+	// Name is the load test's name in the cloud.
+	Name string
+	// ProjectID is the project the load test belongs to.
+	ProjectID int64
+	// MaxVUs is the maximum number of VUs the test can reach.
+	MaxVUs int64
+	// TotalDuration is the total duration of the test, in seconds.
+	TotalDuration int64
+	// Options is the resolved set of k6 script options, as JSON.
+	Options json.RawMessage
+	// Archive is the test archive to upload. When nil, no archive is sent.
+	Archive *lib.Archive
+	// PollInterval overrides [DefaultPollInterval] while waiting for the
+	// test run to become ready.
+	PollInterval time.Duration
+}
+
+// ProvisionResult is everything the caller needs to run the test locally and
+// report it to the cloud.
+type ProvisionResult struct {
+	// TestRunID is the id of the provisioned test run.
+	TestRunID int64
+	// TestRunDetailsPageURL is the Grafana web app URL of the test run.
+	TestRunDetailsPageURL string
+	// RuntimeConfig tells k6 where and how to report the run's data.
+	RuntimeConfig RuntimeConfig
+}
+
+// ProvisionLocalExecution prepares a cloud test run for a test executed on
+// this machine: it makes sure the load test exists, starts a run for it,
+// uploads the archive when the backend asks for one, and waits until the run
+// is ready to receive metrics.
+func (c *Client) ProvisionLocalExecution(
+	ctx context.Context, params ProvisionParams,
+) (*ProvisionResult, error) {
+	loadTestID, err := c.v6Client.CreateOrFindLoadTest(ctx, params.ProjectID, params.Name)
+	if err != nil {
+		return nil, fmt.Errorf("create or find load test: %w", err)
+	}
+
+	var archive []byte
+	if params.Archive != nil {
+		if archive, err = encodeArchive(params.Archive); err != nil {
+			return nil, err
+		}
+	}
+
+	started, err := c.StartLocalExecution(ctx, loadTestID, StartLocalExecutionRequest{
+		Options:       params.Options,
+		MaxVUs:        params.MaxVUs,
+		TotalDuration: params.TotalDuration,
+		ArchiveSize:   int64(len(archive)),
+	})
+	if err != nil {
+		return nil, fmt.Errorf("start local execution: %w", err)
+	}
+
+	if err := c.uploadArchiveIfRequested(ctx, started, archive); err != nil {
+		return nil, err
+	}
+
+	pollInterval := params.PollInterval
+	if pollInterval <= 0 {
+		pollInterval = DefaultPollInterval
+	}
+	if err := c.WaitForTestRunReady(ctx, started.TestRunID, pollInterval); err != nil {
+		return nil, fmt.Errorf("wait for test run ready: %w", err)
+	}
+
+	return &ProvisionResult{
+		TestRunID:             started.TestRunID,
+		TestRunDetailsPageURL: started.TestRunDetailsPageURL,
+		RuntimeConfig:         started.RuntimeConfig,
+	}, nil
+}
+
+// uploadArchiveIfRequested uploads the archive when there is one and the
+// backend handed out a URL for it. A missing URL is not fatal: the run can
+// still go ahead, it just won't have the script attached to it.
+func (c *Client) uploadArchiveIfRequested(
+	ctx context.Context, started *StartLocalExecutionResponse, archive []byte,
+) error {
+	if len(archive) == 0 {
+		return nil
+	}
+	if started.ArchiveUploadURL == nil || *started.ArchiveUploadURL == "" {
+		c.logger.Warn("The cloud returned no archive upload URL, the test archive won't be uploaded")
+		return nil
+	}
+
+	if err := c.UploadArchive(ctx, *started.ArchiveUploadURL, archive); err != nil {
+		return fmt.Errorf("upload archive: %w", err)
+	}
+
+	return nil
+}
+
+func encodeArchive(arc *lib.Archive) ([]byte, error) {
+	var buf bytes.Buffer
+	if err := arc.Write(&buf); err != nil {
+		return nil, fmt.Errorf("encoding the test archive: %w", err)
+	}
+
+	return buf.Bytes(), nil
+}
diff --git a/internal/cloudapi/provisioning/test/server.go b/internal/cloudapi/provisioning/test/server.go
new file mode 100644
index 000000000..640cf2aff
--- /dev/null
+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,191 @@
+// Package provtest provides an HTTP test server that simulates the parts of
+// the Grafana Cloud k6 API that `k6 cloud run --local-execution` talks to:
+// the v6 load-test and test-run endpoints, the provisioning endpoints, and
+// the presigned archive upload.
+//
+// It keeps the wire format (nullable fields, SDK models, v6 status models)
+// out of the test files: tests register handlers per endpoint and speak in
+// domain terms.
+package provtest
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	// DefaultLoadTestID is the load test id the default responses use.
+	DefaultLoadTestID int64 = 456
+
+	// DefaultTestRunID is the test run id the default responses use.
+	DefaultTestRunID int64 = 123
+
+	// PresignedUploadPath is the path [Server.PresignedUploadURL] points at.
+	// It stands in for the S3 URL the real API hands out.
+	PresignedUploadPath = "/presigned/archive-upload"
+)
+
+// Server is a test HTTP server for the local-execution flow.
+type Server struct {
+	*httptest.Server
+
+	// Mux is the server's request multiplexer. Tests can register extra
+	// routes on it, e.g. a catch-all for the metrics pushes.
+	Mux *http.ServeMux
+
+	fetchTestRunHits atomic.Int32
+
+	mu            sync.Mutex
+	testRunStates []v6.TestProgress
+}
+
+// NewServer starts a test server with no routes registered. Use the Handle*
+// methods to add the endpoints the test under test needs.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+
+	mux := http.NewServeMux()
+	srv := httptest.NewServer(mux)
+	t.Cleanup(srv.Close)
+
+	return &Server{Server: srv, Mux: mux}
+}
+
+// PresignedUploadURL returns the absolute URL of the stubbed presigned
+// archive upload endpoint.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// HandleCreateLoadTest registers the v6 create-load-test endpoint for the
+// given project. The handler receives both the POST (create) and the GET
+// (find by name) requests, so a test can simulate a 409 conflict.
+func (s *Server) HandleCreateLoadTest(projectID int64, handler http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID), handler)
+}
+
+// HandleStartLocalExecution registers the provisioning start endpoint for
+// the given load test.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, handler http.HandlerFunc) {
+	s.Mux.HandleFunc(
+		fmt.Sprintf("/provisioning/v1/load_tests/%d/start_local_execution", loadTestID), handler)
+}
+
+// HandlePresignedUpload registers the stubbed presigned upload endpoint.
+func (s *Server) HandlePresignedUpload(path string, handler http.HandlerFunc) {
+	s.Mux.HandleFunc(path, handler)
+}
+
+// HandleNotify registers the provisioning notify endpoint for the given
+// test run.
+func (s *Server) HandleNotify(testRunID int64, handler http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/test_runs/%d/notify", testRunID), handler)
+}
+
+// HandleFetchTestRun registers the v6 test-run endpoint for the given test
+// run. Each request reports the next state in states; once they run out the
+// last one is repeated, so a single-element slice is a steady state.
+func (s *Server) HandleFetchTestRun(testRunID int64, states []v6.TestProgress) {
+	s.mu.Lock()
+	s.testRunStates = states
+	s.mu.Unlock()
+
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/test_runs/%d", testRunID), s.handleFetchTestRun)
+}
+
+// FetchTestRunHitCount returns how many times the test-run endpoint was hit.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchTestRunHits.Load()
+}
+
+func (s *Server) handleFetchTestRun(w http.ResponseWriter, _ *http.Request) {
+	hit := s.fetchTestRunHits.Add(1)
+
+	s.mu.Lock()
+	states := s.testRunStates
+	s.mu.Unlock()
+
+	if len(states) == 0 {
+		http.Error(w, "no test run states configured", http.StatusInternalServerError)
+		return
+	}
+	tp := states[min(int(hit)-1, len(states)-1)]
+
+	res := k6cloud.NewTestRunApiModelWithDefaults()
+	res.SetStatus(tp.Status.String())
+	res.SetResult(tp.Result.String())
+	res.SetEstimatedDuration(tp.EstimatedDuration)
+	res.SetExecutionDuration(tp.ExecutionDuration)
+	res.SetStatusHistory(v6.ToStatusModel(tp.StatusHistory))
+	// The SDK decoder requires these keys even when they're empty.
+	res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+	res.SetResultDetails(k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(
+		k6cloud.NewResultDetailsApiModel("")))
+	res.SetOptions(map[string]any{})
+
+	WriteJSON(w, http.StatusOK, res)
+}
+
+// DefaultStartLocalExecutionResponse returns a fully populated
+// start-local-execution response. Tests override the fields they care about.
+func DefaultStartLocalExecutionResponse() *k6cloud.StartLocalExecutionTestResponse {
+	res := k6cloud.NewStartLocalExecutionTestResponseWithDefaults()
+	res.SetTestRunId(DefaultTestRunID)
+	res.SetArchiveUploadUrl(fmt.Sprintf(
+		"https://k6-archives.s3.amazonaws.com/test_runs/%d/archive.tar?X-Amz-Signature=deadbeef",
+		DefaultTestRunID))
+	res.SetTestRunDetailsPageUrl(fmt.Sprintf("https://app.k6.io/runs/%d", DefaultTestRunID))
+	res.SetRuntimeConfig(DefaultRuntimeConfig())
+
+	return res
+}
+
+// DefaultRuntimeConfig returns the runtime config embedded in
+// [DefaultStartLocalExecutionResponse].
+func DefaultRuntimeConfig() k6cloud.RuntimeConfig {
+	pushInterval, aggPeriod, aggWaitPeriod := "2s", "3s", "1s"
+	pushConcurrency, aggMinSamples, maxSamples := int32(5), int32(50), int32(2000)
+
+	metrics := k6cloud.NewMetricsRuntimeConfig(
+		"https://ingest.k6.io/v1/metrics",
+		*k6cloud.NewNullableString(&pushInterval),
+		*k6cloud.NewNullableInt32(&pushConcurrency),
+		*k6cloud.NewNullableString(&aggPeriod),
+		*k6cloud.NewNullableString(&aggWaitPeriod),
+		*k6cloud.NewNullableInt32(&aggMinSamples),
+		*k6cloud.NewNullableInt32(&maxSamples),
+	)
+
+	secrets := k6cloud.NewSecretsRuntimeConfig(
+		fmt.Sprintf("https://api.k6.io/provisioning/v1/test_runs/%d/decrypt_secret?name={key}", DefaultTestRunID),
+		"plaintext",
+	)
+
+	rc := k6cloud.NewRuntimeConfigWithDefaults()
+	rc.SetMetrics(*metrics)
+	rc.SetSecrets(*secrets)
+	rc.SetTraces(*k6cloud.NewTracesRuntimeConfigWithDefaults())
+	rc.SetFiles(*k6cloud.NewFilesRuntimeConfigWithDefaults())
+	rc.SetLogs(*k6cloud.NewLogsRuntimeConfigWithDefaults())
+	rc.SetTestRunToken("test-run-token-abc")
+
+	return *rc
+}
+
+// WriteJSON encodes v as a JSON response with the given status code.
+func WriteJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	if err := json.NewEncoder(w).Encode(v); err != nil {
+		panic(fmt.Errorf("provtest: encoding JSON: %w", err))
+	}
+}
