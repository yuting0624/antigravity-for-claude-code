diff --git a/internal/cloudapi/clientcfg/clientcfg.go b/internal/cloudapi/clientcfg/clientcfg.go
new file mode 100644
index 000000000..c6a72bc61
--- /dev/null
+++ b/internal/cloudapi/clientcfg/clientcfg.go
@@ -0,0 +1,13 @@
+// Package clientcfg holds the retry settings shared by k6 Cloud's API
+// clients (cloudapi/v6, cloudapi/provisioning), so they all back off the
+// same way without importing each other.
+package clientcfg
+
+import "time"
+
+const (
+	// RetryInterval is the default cloud request retry interval.
+	RetryInterval = 500 * time.Millisecond
+	// MaxRetries specifies max retry attempts.
+	MaxRetries = 3
+)
diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..a68338adc
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,230 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// archiveContentType is what the presigned upload expects the k6 archive to
+// be sent as.
+const archiveContentType = "application/x-tar"
+
+// StartLocalExecutionRequest is the payload of a start-local-execution call.
+type StartLocalExecutionRequest struct {
+	// Options are the fully resolved script options, as JSON.
+	Options json.RawMessage
+
+	// MaxVUs is the maximum number of VUs the test can reach.
+	MaxVUs int32
+
+	// TotalDuration is the total duration of the test, in seconds.
+	TotalDuration int32
+
+	// ArchiveSize is the size of the k6 archive in bytes. Zero means no
+	// archive is going to be uploaded, and is sent as an explicit JSON null.
+	ArchiveSize int64
+}
+
+// StartLocalExecutionResponse is what the provisioning API answers with once
+// it has created the test run.
+type StartLocalExecutionResponse struct {
+	// TestRunID identifies the newly created test run.
+	TestRunID int64
+
+	// ArchiveUploadURL is the presigned URL the archive must be PUT to. It is
+	// nil when the API doesn't expect an upload.
+	ArchiveUploadURL *string
+
+	// TestRunDetailsPageURL points at the run's page in the Grafana web app.
+	TestRunDetailsPageURL string
+
+	// RuntimeConfig carries the metrics push URL, the test-run token and the
+	// secrets endpoint for this run.
+	RuntimeConfig RuntimeConfig
+}
+
+// StartLocalExecution creates a test run for the given load test, to be
+// executed on this machine.
+func (c *Client) StartLocalExecution(
+	ctx context.Context, loadTestID int64, req StartLocalExecutionRequest,
+) (_ *StartLocalExecutionResponse, err error) {
+	opts := map[string]any{}
+	if len(req.Options) > 0 {
+		if err := json.Unmarshal(req.Options, &opts); err != nil {
+			return nil, fmt.Errorf("decoding the test options: %w", err)
+		}
+	}
+
+	body := k6cloud.NewStartLocalExecutionTestRequest(opts, req.MaxVUs, req.TotalDuration)
+	body.ArchiveSize = *k6cloud.NewNullableInt32(archiveSizeOrNull(req.ArchiveSize))
+
+	key, err := idempotencyKey()
+	if err != nil {
+		return nil, err
+	}
+
+	res, hr, err := c.apiClient.ProvisioningAPI.
+		StartLocalExecutionTest(c.authCtx(ctx), loadTestID).
+		StartLocalExecutionTestRequest(body).
+		K6IdempotencyKey(key).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if err := checkSDKResponse(hr, err); err != nil {
+		return nil, err
+	}
+	if res == nil {
+		return nil, errUnknown
+	}
+
+	out := &StartLocalExecutionResponse{
+		TestRunID:             res.GetTestRunId(),
+		TestRunDetailsPageURL: res.GetTestRunDetailsPageUrl(),
+		RuntimeConfig:         newRuntimeConfig(res.GetRuntimeConfig()),
+	}
+	if url := res.ArchiveUploadUrl.Get(); url != nil && *url != "" {
+		out.ArchiveUploadURL = url
+	}
+
+	return out, nil
+}
+
+// UploadArchive PUTs the k6 archive to a presigned URL. The URL carries its
+// own authorization, so no credentials are attached to the request.
+func (c *Client) UploadArchive(ctx context.Context, uploadURL string, archive []byte) error {
+	req, err := http.NewRequestWithContext(
+		ctx, http.MethodPut, uploadURL, bytes.NewReader(archive))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", archiveContentType)
+	req.ContentLength = int64(len(archive))
+
+	return c.uploadClient.Do(req, nil)
+}
+
+// WaitForTestRunReady polls the test run until the cloud reports it has
+// started initializing, which is when it is ready to accept metrics.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	var logged v6.Status
+
+	for {
+		progress, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			// A canceled context surfaces as a transport error; report the
+			// cancellation itself, it's what the caller acts on.
+			if ctxErr := ctx.Err(); ctxErr != nil {
+				return ctxErr
+			}
+			return err
+		}
+
+		switch progress.Status {
+		case v6.StatusInitializing, v6.StatusRunning:
+			return nil
+		case v6.StatusAborted:
+			return abortedBeforeStartError(progress)
+		case v6.StatusCompleted:
+			return fmt.Errorf("test run reached status %q before starting", progress.Status)
+		}
+
+		if progress.Status != logged {
+			logged = progress.Status
+			c.logger.WithField("status", progress.FormatStatus()).
+				Info("Waiting for the cloud test run to be ready")
+		}
+
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(pollInterval):
+		}
+	}
+}
+
+func abortedBeforeStartError(progress *v6.TestProgress) error {
+	for _, event := range progress.StatusHistory {
+		if event.Status == v6.StatusAborted && event.Message != "" {
+			return fmt.Errorf("test run aborted before starting: %s", event.Message)
+		}
+	}
+	return errors.New("test run aborted before starting")
+}
+
+// NotifyTestRunCompleted tells the cloud that the local script execution is
+// over. testErr, when not nil, is mapped to the error code the backend
+// expects; a nil error, or thresholds that only failed after the test ended,
+// are reported as a clean finish.
+func (c *Client) NotifyTestRunCompleted(
+	ctx context.Context, testRunID int64, testRunToken string, testErr error,
+) (err error) {
+	notification := k6cloud.NewScriptExecutionCompletedNotificationApiModel(scriptExecutionCompletedEvent)
+	if nerr := mapTestErrorToNotifyCode(testErr); nerr != nil {
+		notification.SetError(*k6cloud.NewScriptExecutionError(nerr.Code, nerr.Reason))
+	}
+
+	hr, err := c.apiClient.ProvisioningAPI.
+		TestRunsNotify(scopedCtx(ctx, testRunToken), testRunID).
+		ScriptExecutionCompletedNotificationApiModel(notification).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	return checkSDKResponse(hr, err)
+}
+
+// checkSDKResponse turns a cloud SDK call's outcome into either nil or a
+// *ResponseError. Transport-level failures are returned as they are.
+func checkSDKResponse(res *http.Response, err error) error {
+	if err != nil {
+		var aerr *k6cloud.GenericOpenAPIError
+		if !errors.As(err, &aerr) {
+			return err
+		}
+	}
+
+	return CheckResponse(res)
+}
+
+func closeResponse(res *http.Response, rerr *error) {
+	if res == nil {
+		return
+	}
+	_, _ = io.Copy(io.Discard, res.Body)
+	if err := res.Body.Close(); err != nil && *rerr == nil {
+		*rerr = err
+	}
+}
+
+// archiveSizeOrNull clamps the archive size into the int32 the API takes, and
+// returns nil - an explicit JSON null - when there is no archive to upload.
+func archiveSizeOrNull(size int64) *int32 {
+	if size <= 0 {
+		return nil
+	}
+	if size > math.MaxInt32 {
+		size = math.MaxInt32
+	}
+	v := int32(size)
+	return &v
+}
+
+func idempotencyKey() (string, error) {
+	var key [8]byte
+	if _, err := rand.Read(key[:]); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(key[:]), nil
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..7621a3fd1
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,90 @@
+package provisioning
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"strconv"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// stackIDHeader is set on every provisioning request: unlike the v6 routes,
+// the generated provisioning API doesn't take the stack id as a parameter.
+const stackIDHeader = "X-Stack-Id"
+
+// Client talks to the Grafana Cloud k6 provisioning API.
+type Client struct {
+	apiClient *k6cloud.APIClient
+	token     string
+	stackID   int64
+
+	// v6Client serves the test-run reads the provisioning flow needs, so the
+	// polling shares the v6 decoding of statuses and errors.
+	v6Client *v6.Client
+
+	// uploadClient sends the archive to the presigned URL. It carries no
+	// credentials of its own: presigned URLs authorize the request.
+	uploadClient *HTTPClient
+
+	logger logrus.FieldLogger
+}
+
+// NewClient returns a new client for the provisioning API.
+func NewClient(
+	logger logrus.FieldLogger, token, host, version string, stackID int64, timeout time.Duration,
+) (*Client, error) {
+	if token == "" {
+		return nil, fmt.Errorf("token is required to create the provisioning API client")
+	}
+
+	httpClient := &http.Client{
+		Timeout:   timeout,
+		Transport: http.DefaultTransport,
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Global k6 Cloud API.",
+		},
+	}
+	cfg.HTTPClient = httpClient
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+	cfg.AddDefaultHeader(stackIDHeader, strconv.FormatInt(stackID, 10))
+
+	v6Client, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if err := v6Client.SetStackID(stackID); err != nil {
+		return nil, err
+	}
+
+	return &Client{
+		apiClient:    k6cloud.NewAPIClient(cfg),
+		token:        token,
+		stackID:      stackID,
+		v6Client:     v6Client,
+		uploadClient: NewHTTPClient(httpClient, "", version, logger),
+		logger:       logger,
+	}, nil
+}
+
+// authCtx returns a context carrying the long-lived account token.
+func (c *Client) authCtx(ctx context.Context) context.Context {
+	return context.WithValue(ctx, k6cloud.ContextAccessToken, c.token)
+}
+
+// scopedCtx returns a context carrying a test-run-scoped token.
+func scopedCtx(ctx context.Context, token string) context.Context {
+	return context.WithValue(ctx, k6cloud.ContextAccessToken, token)
+}
diff --git a/internal/cloudapi/provisioning/doc.go b/internal/cloudapi/provisioning/doc.go
new file mode 100644
index 000000000..4c563a92c
--- /dev/null
+++ b/internal/cloudapi/provisioning/doc.go
@@ -0,0 +1,11 @@
+// Package provisioning talks to the Grafana Cloud k6 provisioning API on
+// behalf of `k6 cloud run --local-execution`.
+//
+// It owns the whole orchestration of a locally executed cloud test run:
+// making sure the load test exists (via the v6 API), starting a local
+// execution, uploading the archive to the returned presigned URL and
+// waiting until the test run is ready to receive metrics. The runtime
+// config returned by the API - metrics push URL, test-run-scoped token and
+// secrets endpoint - is decoded into the types of this package so that the
+// rest of k6 doesn't depend on the cloud SDK's wire models.
+package provisioning
diff --git a/internal/cloudapi/provisioning/errors.go b/internal/cloudapi/provisioning/errors.go
new file mode 100644
index 000000000..beb6695ba
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,62 @@
+package provisioning
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+
+	"go.k6.io/k6/v2/internal/cloudapi/httperr"
+)
+
+var errUnknown = errors.New("an error occurred communicating with k6 Cloud")
+
+// ResponseError is an error returned by the provisioning API, or by a
+// presigned upload endpoint. It keeps the raw body around: the provisioning
+// API answers with the v6 error envelope, while presigned URLs answer with
+// whatever the storage provider produces, so there is no single shape to
+// decode into.
+type ResponseError struct {
+	StatusCode int
+	Body       string
+
+	// classified is the sentinel error 401/403 responses map to, so callers
+	// can errors.Is them the same way they do with the v6 client.
+	classified error
+}
+
+func (e *ResponseError) Error() string {
+	if e.Body == "" {
+		return fmt.Sprintf("(%d) %s", e.StatusCode, http.StatusText(e.StatusCode))
+	}
+	return fmt.Sprintf("(%d) %s", e.StatusCode, e.Body)
+}
+
+// Unwrap returns the sentinel this response was classified as, if any.
+func (e *ResponseError) Unwrap() error { return e.classified }
+
+// CheckResponse returns nil if the response status is in the successful
+// range, and a *ResponseError carrying the status code and the body
+// otherwise.
+func CheckResponse(r *http.Response) error {
+	if r == nil {
+		return errUnknown
+	}
+
+	if c := r.StatusCode; c >= 200 && c <= 299 {
+		return nil
+	}
+
+	var body []byte
+	if r.Body != nil {
+		// A read failure here shouldn't mask the status code the server sent,
+		// so the body is simply left empty.
+		body, _ = io.ReadAll(r.Body)
+	}
+
+	return &ResponseError{
+		StatusCode: r.StatusCode,
+		Body:       string(body),
+		classified: httperr.ClassifyStatus(r.StatusCode),
+	}
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..126481205
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,142 @@
+package provisioning
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient is a small HTTP client for the endpoints the cloud SDK doesn't
+// cover: the presigned archive upload, and any provisioning route that has to
+// be called with a test-run-scoped bearer token instead of the long-lived
+// account token.
+//
+// It retries the same responses the SDK does (5xx and 429) with the shared
+// [clientcfg] settings, and replays the request body on every attempt.
+type HTTPClient struct {
+	client  *http.Client
+	token   string
+	version string
+	logger  logrus.FieldLogger
+
+	retries       int
+	retryInterval time.Duration
+}
+
+// NewHTTPClient returns an HTTPClient sending requests with the given token
+// as a bearer credential. An empty token leaves the Authorization header out,
+// which is what presigned URLs require.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	return &HTTPClient{
+		client:        client,
+		token:         token,
+		version:       version,
+		logger:        logger,
+		retries:       clientcfg.MaxRetries,
+		retryInterval: clientcfg.RetryInterval,
+	}
+}
+
+// Do sends the request and, when v is not nil, decodes a successful JSON
+// response body into it.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	if req.Body != nil && req.GetBody == nil {
+		body, err := io.ReadAll(req.Body)
+		if err != nil {
+			return err
+		}
+		if err := req.Body.Close(); err != nil {
+			return err
+		}
+		req.GetBody = func() (io.ReadCloser, error) {
+			return io.NopCloser(bytes.NewReader(body)), nil
+		}
+		req.Body, _ = req.GetBody()
+	}
+
+	c.prepareHeaders(req)
+
+	for attempt := 1; attempt <= c.retries; attempt++ {
+		retry, err := c.do(req, v, attempt)
+		if !retry {
+			return err
+		}
+
+		// Wait before retrying, but give up as soon as the request's context
+		// is done so a canceled call returns at once instead of sleeping
+		// through the remaining attempts.
+		select {
+		case <-req.Context().Done():
+			return req.Context().Err()
+		case <-time.After(c.retryInterval):
+		}
+
+		if req.GetBody != nil {
+			req.Body, _ = req.GetBody()
+		}
+	}
+
+	return nil
+}
+
+func (c *HTTPClient) prepareHeaders(req *http.Request) {
+	if c.token != "" {
+		req.Header.Set("Authorization", "Bearer "+c.token)
+	}
+	req.Header.Set("User-Agent", "k6cloud/"+c.version)
+}
+
+func (c *HTTPClient) do(req *http.Request, v any, attempt int) (retry bool, err error) {
+	res, err := c.client.Do(req) //nolint:bodyclose // closed by the deferred func below
+
+	defer func() {
+		if res == nil {
+			return
+		}
+		_, _ = io.Copy(io.Discard, res.Body)
+		if cerr := res.Body.Close(); cerr != nil && err == nil {
+			err = cerr
+		}
+	}()
+
+	if shouldRetry(res, err, attempt, c.retries) {
+		if c.logger != nil {
+			c.logger.WithField("url", req.URL.String()).
+				Debugf("Retrying cloud request, attempt %d/%d", attempt, c.retries)
+		}
+		return true, err
+	}
+	if err != nil {
+		return false, err
+	}
+
+	if err := CheckResponse(res); err != nil {
+		return false, err
+	}
+
+	if v != nil {
+		if err := json.NewDecoder(res.Body).Decode(v); err != nil && !errors.Is(err, io.EOF) {
+			return false, err
+		}
+	}
+
+	return false, nil
+}
+
+func shouldRetry(res *http.Response, err error, attempt, maxAttempts int) bool {
+	if attempt >= maxAttempts {
+		return false
+	}
+	if res == nil || err != nil {
+		return true
+	}
+	return res.StatusCode >= http.StatusInternalServerError ||
+		res.StatusCode == http.StatusTooManyRequests
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..bd56ece72
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,61 @@
+package provisioning
+
+import (
+	"errors"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+// scriptExecutionCompletedEvent is the only notification event k6 sends: the
+// local script execution is over, whatever the outcome.
+const scriptExecutionCompletedEvent = "script_execution_completed"
+
+// Error codes the backend uses to classify how a locally executed test run
+// ended.
+const (
+	// notifyCodeUnknown is sent for errors k6 can't attribute to anything
+	// more specific.
+	notifyCodeUnknown int32 = 0
+	// notifyCodeTimeoutOrOutput covers a test timeout and an output failure.
+	notifyCodeTimeoutOrOutput int32 = 8034
+	// notifyCodeScriptError covers a script that threw.
+	notifyCodeScriptError int32 = 8035
+	// notifyCodeAborted covers a run stopped on purpose: by the user, by the
+	// script, or by a failing threshold while the test was still running.
+	notifyCodeAborted int32 = 8036
+)
+
+// notifyError is the error part of a completion notification.
+type notifyError struct {
+	Code   int32
+	Reason string
+}
+
+// mapTestErrorToNotifyCode translates the error k6 stopped with into the code
+// the provisioning API expects. It returns nil when the run should be
+// reported as a clean finish: no error at all, or thresholds that only failed
+// once the test had already ended - the run itself completed normally, and
+// the threshold outcome is tracked separately by the cloud.
+func mapTestErrorToNotifyCode(testErr error) *notifyError {
+	if testErr == nil {
+		return nil
+	}
+
+	code := notifyCodeUnknown
+
+	var abortErr errext.HasAbortReason
+	if errors.As(testErr, &abortErr) {
+		switch abortErr.AbortReason() {
+		case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+			code = notifyCodeAborted
+		case errext.AbortedByScriptError:
+			code = notifyCodeScriptError
+		case errext.AbortedByTimeout, errext.AbortedByOutput:
+			code = notifyCodeTimeoutOrOutput
+		case errext.AbortedByThresholdsAfterTestEnd:
+			return nil
+		}
+	}
+
+	return &notifyError{Code: code, Reason: testErr.Error()}
+}
