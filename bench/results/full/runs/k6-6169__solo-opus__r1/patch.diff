--- /dev/null
+++ b/internal/cmd/outputs_cloud_local.go
@@ -0,0 +1,161 @@
+package cmd
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strconv"
+	"time"
+
+	"github.com/sirupsen/logrus"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/cloudapi"
+	"go.k6.io/k6/v2/cmd/state"
+	"go.k6.io/k6/v2/internal/build"
+	"go.k6.io/k6/v2/internal/cloudapi/provisioning"
+	cloudsecrets "go.k6.io/k6/v2/internal/secretsource/cloud"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+// createCloudTestLocalExecution prepares a cloud test run for a test that is
+// executed on this machine: the load test and its run are created through
+// the v6 and provisioning APIs, and what they hand back (the test run id,
+// the metrics endpoint, the scoped token and the secrets endpoint) is
+// threaded into the configuration the cloud output will consume.
+//
+// As with the cloud-executed flow, a PushRefID short-circuits everything:
+// k6 then only streams metrics into a test run somebody else created.
+func createCloudTestLocalExecution(gs *state.GlobalState, test *loadedAndConfiguredTest) error {
+	prep, err := prepareCloudTest(gs, test)
+	if err != nil {
+		return err
+	}
+	conf, logger := prep.conf, prep.logger
+
+	if conf.PushRefID.Valid && conf.PushRefID.String != "" {
+		test.preInitState.RuntimeOptions.Env[testRunIDKey] = conf.PushRefID.String
+		gs.Logger.Debug("using PushRefID, skipping the test run provisioning")
+		return nil
+	}
+
+	projectID := conf.ProjectID.Int64
+	if projectID == 0 {
+		if projectID, err = resolveDefaultProjectID(gs, &conf); err != nil {
+			return err
+		}
+	}
+	if projectID == 0 {
+		return errors.New("a project ID is required to run a test in the cloud, " +
+			"please specify K6_CLOUD_PROJECT_ID or options.cloud.projectID")
+	}
+
+	options, err := json.Marshal(test.derivedConfig.Options)
+	if err != nil {
+		return fmt.Errorf("could not serialize the test options: %w", err)
+	}
+
+	var testArchive *lib.Archive
+	if !test.derivedConfig.NoArchiveUpload.Bool {
+		testArchive = test.makeArchive()
+	}
+
+	client, err := provisioning.NewClient(
+		logger, conf.Token.String, conf.Hostv6.String, build.Version,
+		conf.StackID.Int64, conf.Timeout.TimeDuration(),
+	)
+	if err != nil {
+		return err
+	}
+
+	result, err := client.ProvisionLocalExecution(gs.Ctx, provisioning.ProvisionParams{
+		Name:          conf.Name.String,
+		ProjectID:     projectID,
+		MaxVUs:        int64(lib.GetMaxPossibleVUs(prep.executionPlan)), //nolint:gosec
+		TotalDuration: int64(prep.duration / time.Second),
+		Options:       options,
+		Archive:       testArchive,
+	})
+	if err != nil {
+		return err
+	}
+
+	// The script and the cloud output find the test run through the environment.
+	test.preInitState.RuntimeOptions.Env[testRunIDKey] = strconv.FormatInt(result.TestRunID, 10)
+
+	if gs.CloudSecretSource != nil {
+		gs.CloudSecretSource.SetConfig(&cloudsecrets.Config{
+			Token:        result.RuntimeConfig.TestRunToken,
+			Endpoint:     result.RuntimeConfig.Secrets.Endpoint,
+			ResponsePath: result.RuntimeConfig.Secrets.ResponsePath,
+		})
+	}
+
+	// Hand the runtime config to the cloud output, through the only channel
+	// it reads: the serialized cloud collector configuration.
+	conf = conf.Apply(buildConfigFromRuntimeConfig(logger, result.RuntimeConfig))
+	conf.MetricsPushURL = null.StringFrom(result.RuntimeConfig.Metrics.PushURL)
+	conf.TestRunToken = null.StringFrom(result.RuntimeConfig.TestRunToken)
+	if result.TestRunDetailsPageURL != "" {
+		conf.TestRunDetails = null.StringFrom(result.TestRunDetailsPageURL)
+	}
+
+	raw, err := cloudConfToRawMessage(conf)
+	if err != nil {
+		return fmt.Errorf("could not serialize the cloud configuration: %w", err)
+	}
+	if test.derivedConfig.Collectors == nil {
+		test.derivedConfig.Collectors = make(map[string]json.RawMessage)
+	}
+	test.derivedConfig.Collectors[builtinOutputCloud.String()] = raw
+
+	return nil
+}
+
+// buildConfigFromRuntimeConfig translates the provisioning API's metrics
+// runtime config into the cloud output's configuration.
+//
+// Every field is optional: when the cloud doesn't express an opinion, or
+// expresses one k6 can't parse, the corresponding config field is left unset
+// so the k6 default applies.
+func buildConfigFromRuntimeConfig(logger logrus.FieldLogger, rc provisioning.RuntimeConfig) cloudapi.Config {
+	var conf cloudapi.Config
+	metrics := rc.Metrics
+
+	if d, ok := parseRuntimeDuration(logger, "push_interval", metrics.PushInterval); ok {
+		conf.MetricPushInterval = d
+	}
+	if d, ok := parseRuntimeDuration(logger, "aggregation_period", metrics.AggregationPeriod); ok {
+		conf.AggregationPeriod = d
+	}
+	if d, ok := parseRuntimeDuration(logger, "aggregation_wait_period", metrics.AggregationWaitPeriod); ok {
+		conf.AggregationWaitPeriod = d
+	}
+	if metrics.PushConcurrency != nil {
+		conf.MetricPushConcurrency = null.IntFrom(int64(*metrics.PushConcurrency))
+	}
+	if metrics.MaxSamplesPerPackage != nil {
+		conf.MaxTimeSeriesInBatch = null.IntFrom(int64(*metrics.MaxSamplesPerPackage))
+	}
+
+	// metrics.AggregationMinSamples is intentionally dropped: the k6 output
+	// has no equivalent knob, so there's nothing to warn about.
+
+	return conf
+}
+
+func parseRuntimeDuration(logger logrus.FieldLogger, field string, value *string) (types.NullDuration, bool) {
+	if value == nil {
+		return types.NullDuration{}, false
+	}
+
+	d, err := time.ParseDuration(*value)
+	if err != nil {
+		logger.WithError(err).WithFields(logrus.Fields{"field": field, "value": *value}).
+			Warn("The cloud returned a duration k6 could not parse, using the default instead")
+		return types.NullDuration{}, false
+	}
+
+	return types.NewNullDuration(d, true), true
+}
