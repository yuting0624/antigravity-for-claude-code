+package provisioning
+
+import (
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+)
+
+// RuntimeConfig is the subset of the provisioning API's runtime config k6
+// needs when it executes a cloud test run locally.
+type RuntimeConfig struct {
+	Metrics MetricsConfig
+	Secrets SecretsConfig
+
+	// TestRunToken is the short-lived, test-run-scoped token. It authorizes
+	// the metrics pushes, the secrets lookups and the end-of-test
+	// notification, and it never leaves the process.
+	TestRunToken string
+}
+
+// MetricsConfig tells the cloud output where to push metrics and, optionally,
+// how to tune the batching. The pointer fields are nullable on the wire: nil
+// means "keep k6's default".
+type MetricsConfig struct {
+	PushURL               string
+	PushInterval          *string
+	PushConcurrency       *int32
+	AggregationPeriod     *string
+	AggregationWaitPeriod *string
+	AggregationMinSamples *int32
+	MaxSamplesPerPackage  *int32
+}
+
+// SecretsConfig configures the cloud secret source for this test run.
+type SecretsConfig struct {
+	Endpoint     string
+	ResponsePath string
+}
+
+func newRuntimeConfig(rc k6cloud.RuntimeConfig) RuntimeConfig {
+	metrics := rc.GetMetrics()
+	secrets := rc.GetSecrets()
+
+	return RuntimeConfig{
+		TestRunToken: rc.GetTestRunToken(),
+		Metrics: MetricsConfig{
+			PushURL:               metrics.GetPushUrl(),
+			PushInterval:          metrics.PushInterval.Get(),
+			PushConcurrency:       metrics.PushConcurrency.Get(),
+			AggregationPeriod:     metrics.AggregationPeriod.Get(),
+			AggregationWaitPeriod: metrics.AggregationWaitPeriod.Get(),
+			AggregationMinSamples: metrics.AggregationMinSamples.Get(),
+			MaxSamplesPerPackage:  metrics.MaxSamplesPerPackage.Get(),
+		},
+		Secrets: SecretsConfig{
+			Endpoint:     secrets.GetEndpoint(),
+			ResponsePath: secrets.GetResponsePath(),
+		},
+	}
+}
diff --git a/internal/cloudapi/provisioning/test/server.go b/internal/cloudapi/provisioning/test/server.go
new file mode 100644
index 000000000..4e750cbe5
--- /dev/null
+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,189 @@
+// Package provtest provides an HTTP test server that simulates the Grafana
+// Cloud k6 provisioning API, together with the v6 routes the local-execution
+// flow touches.
+//
+// It keeps the wire encoding (nullable fields, SDK models, status history)
+// out of the tests: callers register plain handlers per endpoint and speak in
+// domain terms (v6.TestProgress, v6.Status*). When the API moves on, only
+// this package changes.
+package provtest
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	// DefaultLoadTestID is the load test id the canned responses use.
+	DefaultLoadTestID int64 = 456
+
+	// DefaultTestRunID is the test run id the canned responses use.
+	DefaultTestRunID int64 = 123
+
+	// PresignedUploadPath is the path the server serves as a stand-in for
+	// the storage provider's presigned archive upload URL.
+	PresignedUploadPath = "/presigned/archive-upload"
+)
+
+// Server is a test HTTP server for the provisioning API.
+type Server struct {
+	*httptest.Server
+
+	// Mux is the server's router. Tests can register extra routes on it,
+	// including a "/" catch-all.
+	Mux *http.ServeMux
+
+	fetchTestRunHits atomic.Int32
+}
+
+// NewServer starts a provisioning API test server with no routes registered.
+// Use the Handle* methods to add the endpoints a test needs.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+
+	mux := http.NewServeMux()
+	s := &Server{Mux: mux}
+
+	srv := httptest.NewServer(mux)
+	s.Server = srv
+	t.Cleanup(srv.Close)
+
+	return s
+}
+
+// PresignedUploadURL returns the absolute URL of the server's stand-in for a
+// presigned archive upload.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// HandleCreateLoadTest registers the v6 create-or-find load test endpoint for
+// the given project. The handler receives both the POST (create) and the GET
+// (find by name) requests.
+func (s *Server) HandleCreateLoadTest(projectID int64, handler http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID), handler)
+}
+
+// HandleStartLocalExecution registers the start-local-execution endpoint for
+// the given load test.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, handler http.HandlerFunc) {
+	s.Mux.HandleFunc(
+		fmt.Sprintf("POST /provisioning/v1/load_tests/%d/start_local_execution", loadTestID),
+		handler,
+	)
+}
+
+// HandlePresignedUpload registers the stand-in for the presigned archive
+// upload at the given path.
+func (s *Server) HandlePresignedUpload(path string, handler http.HandlerFunc) {
+	s.Mux.HandleFunc(path, handler)
+}
+
+// HandleNotify registers the end-of-test notification endpoint for the given
+// test run.
+func (s *Server) HandleNotify(testRunID int64, handler http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("POST /provisioning/v1/test_runs/%d/notify", testRunID), handler)
+}
+
+// HandleFetchTestRun registers the v6 test run endpoint, serving the given
+// progresses one per request. The last one is repeated for any further call,
+// so a single-element slice pins the status.
+func (s *Server) HandleFetchTestRun(testRunID int64, progresses []v6.TestProgress) {
+	s.Mux.HandleFunc(
+		fmt.Sprintf("GET /cloud/v6/test_runs/%d", testRunID),
+		func(w http.ResponseWriter, _ *http.Request) {
+			hit := int(s.fetchTestRunHits.Add(1))
+
+			progress := v6.TestProgress{}
+			if len(progresses) > 0 {
+				progress = progresses[min(hit-1, len(progresses)-1)]
+			}
+
+			writeJSON(w, http.StatusOK, testRunModel(progress))
+		},
+	)
+}
+
+// FetchTestRunHitCount returns how many times the test run endpoint was hit.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchTestRunHits.Load()
+}
+
+// DefaultStartLocalExecutionResponse returns a fully populated
+// start-local-execution response. Tests override only the fields they care
+// about.
+func DefaultStartLocalExecutionResponse() *k6cloud.StartLocalExecutionTestResponse {
+	res := k6cloud.NewStartLocalExecutionTestResponseWithDefaults()
+	res.SetTestRunId(DefaultTestRunID)
+	res.SetArchiveUploadUrl(fmt.Sprintf(
+		"https://k6-archives.s3.amazonaws.com/test_runs/%d/archive.tar?X-Amz-Signature=deadbeef",
+		DefaultTestRunID,
+	))
+	res.SetTestRunDetailsPageUrl(fmt.Sprintf("https://app.k6.io/runs/%d", DefaultTestRunID))
+	res.SetRuntimeConfig(defaultRuntimeConfig())
+
+	return res
+}
+
+func defaultRuntimeConfig() k6cloud.RuntimeConfig {
+	pushInterval, aggPeriod, aggWaitPeriod := "2s", "3s", "1s"
+	pushConcurrency, aggMinSamples, maxSamples := int32(5), int32(100), int32(2000)
+
+	metrics := k6cloud.NewMetricsRuntimeConfig(
+		"https://ingest.k6.io/v1/metrics",
+		*k6cloud.NewNullableString(&pushInterval),
+		*k6cloud.NewNullableInt32(&pushConcurrency),
+		*k6cloud.NewNullableString(&aggPeriod),
+		*k6cloud.NewNullableString(&aggWaitPeriod),
+		*k6cloud.NewNullableInt32(&aggMinSamples),
+		*k6cloud.NewNullableInt32(&maxSamples),
+	)
+	traces := k6cloud.NewTracesRuntimeConfig("https://ingest.k6.io/v1/traces", map[string]string{}, "grpc")
+	files := k6cloud.NewFilesRuntimeConfig("https://ingest.k6.io/v1/files", "screenshots", map[string]string{}, "PUT")
+	logs := k6cloud.NewLogsRuntimeConfig(
+		"https://ingest.k6.io/v1/logs",
+		"wss://cloudlogs.k6.io/api/v1/tail",
+		100, "3s", "info", 1024, []string{},
+	)
+	secrets := k6cloud.NewSecretsRuntimeConfig(
+		fmt.Sprintf(
+			"https://api.k6.io/provisioning/v1/test_runs/%d/decrypt_secret?name={key}",
+			DefaultTestRunID,
+		),
+		"plaintext",
+	)
+
+	return *k6cloud.NewRuntimeConfig(*metrics, *traces, *files, *logs, *secrets, "test-run-token-abc")
+}
+
+func testRunModel(progress v6.TestProgress) *k6cloud.TestRunApiModel {
+	res := k6cloud.NewTestRunApiModelWithDefaults()
+	res.SetStatus(progress.Status.String())
+	res.SetResult(progress.Result.String())
+	res.SetEstimatedDuration(progress.EstimatedDuration)
+	res.SetExecutionDuration(progress.ExecutionDuration)
+	res.SetStatusHistory(v6.ToStatusModel(progress.StatusHistory))
+	// The SDK decoder requires these keys on the other end even when empty.
+	res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+	res.SetResultDetails(k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(
+		k6cloud.NewResultDetailsApiModel("")))
+	res.SetOptions(map[string]any{})
+
+	return res
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	if err := json.NewEncoder(w).Encode(v); err != nil {
+		panic(fmt.Errorf("provtest: encoding the response: %w", err))
+	}
+}
