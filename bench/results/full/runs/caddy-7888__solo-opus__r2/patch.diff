diff --git a/modules/logging/setcookiefilter_caddyfile_test.go b/modules/logging/setcookiefilter_caddyfile_test.go
new file mode 100644
index 000000000..19dc98967
--- /dev/null
+++ b/modules/logging/setcookiefilter_caddyfile_test.go
@@ -0,0 +1,57 @@
+package logging
+
+import (
+	"testing"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/caddyconfig/caddyfile"
+)
+
+func TestSetCookieFilterUnmarshalCaddyfile(t *testing.T) {
+	d := caddyfile.NewTestDispenser(`
+		set_cookie {
+			replace foo REDACTED
+			delete bar
+			hash baz
+		}`)
+
+	f := new(SetCookieFilter)
+	if err := f.UnmarshalCaddyfile(d); err != nil {
+		t.Fatalf("unmarshalling Caddyfile: %v", err)
+	}
+	if err := f.Validate(); err != nil {
+		t.Fatalf("validating filter: %v", err)
+	}
+
+	expected := []cookieFilterAction{
+		{replaceAction, "foo", "REDACTED"},
+		{deleteAction, "bar", ""},
+		{hashAction, "baz", ""},
+	}
+	if len(f.Actions) != len(expected) {
+		t.Fatalf("unexpected number of actions: got %d, want %d", len(f.Actions), len(expected))
+	}
+	for i := range expected {
+		if f.Actions[i] != expected[i] {
+			t.Fatalf("action %d was not parsed correctly: got %+v, want %+v", i, f.Actions[i], expected[i])
+		}
+	}
+
+	d = caddyfile.NewTestDispenser(`
+		set_cookie {
+			frobnicate foo
+		}`)
+	if err := new(SetCookieFilter).UnmarshalCaddyfile(d); err == nil {
+		t.Fatal("unknown subdirective must be rejected")
+	}
+}
+
+func TestSetCookieFilterIsRegistered(t *testing.T) {
+	mod, err := caddy.GetModule("caddy.logging.encoders.filter.set_cookie")
+	if err != nil {
+		t.Fatalf("getting module: %v", err)
+	}
+	if _, ok := mod.New().(LogFieldFilter); !ok {
+		t.Fatal("module is not a LogFieldFilter")
+	}
+}
