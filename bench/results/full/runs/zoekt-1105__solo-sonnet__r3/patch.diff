index 00000000..0996bbe9
--- /dev/null
+++ b/cmd/zoekt-local-sync/discover.go
@@ -0,0 +1,139 @@
+// Copyright 2026 Sourcegraph, Inc. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+// Repository is a git repository discovered beneath one of the root
+// directories passed to zoekt-local-sync. Name is derived from the
+// repository's path relative to the root it was found under, and is used as
+// both the name to index it under and the key used to detect stale entries
+// in the index directory.
+type Repository struct {
+	Name string
+	Path string
+}
+
+// discoverRepositories finds the git repositories beneath roots. A root that
+// is itself a git repository counts as a single repository. Repository names
+// are derived from each repository's path relative to the root it was found
+// under; discoverRepositories returns an error if two repositories would
+// resolve to the same name.
+func discoverRepositories(roots []string) ([]Repository, error) {
+	byName := map[string]string{}
+	var repos []Repository
+
+	for _, root := range roots {
+		absRoot, err := filepath.Abs(root)
+		if err != nil {
+			return nil, err
+		}
+		absRoot = filepath.Clean(absRoot)
+
+		paths, err := findRepositories(absRoot)
+		if err != nil {
+			return nil, err
+		}
+
+		for _, path := range paths {
+			name, err := repositoryName(absRoot, path)
+			if err != nil {
+				return nil, err
+			}
+
+			if existing, ok := byName[name]; ok {
+				return nil, fmt.Errorf("duplicate repository name %q: found at both %s and %s", name, existing, path)
+			}
+			byName[name] = path
+
+			repos = append(repos, Repository{Name: name, Path: path})
+		}
+	}
+
+	sort.Slice(repos, func(i, j int) bool { return repos[i].Name < repos[j].Name })
+
+	return repos, nil
+}
+
+// repositoryName derives a repository name from its path relative to root.
+func repositoryName(root, path string) (string, error) {
+	rel, err := filepath.Rel(root, path)
+	if err != nil {
+		return "", err
+	}
+
+	if rel == "." {
+		rel = filepath.Base(root)
+	}
+
+	rel = filepath.ToSlash(rel)
+	dir, base := "", rel
+	if i := strings.LastIndex(rel, "/"); i >= 0 {
+		dir, base = rel[:i+1], rel[i+1:]
+	}
+
+	return dir + strings.TrimSuffix(base, ".git"), nil
+}
+
+// findRepositories walks root looking for git repositories, both normal
+// worktrees (identified by a ".git" file or directory) and bare repositories
+// (a directory whose name ends in ".git" and which contains "objects"). It
+// does not descend into a directory once it has been identified as a
+// repository.
+func findRepositories(root string) ([]string, error) {
+	var found []string
+
+	err := filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			// Best-effort, matching gitindex.FindGitRepos.
+			return nil
+		}
+		if !d.IsDir() {
+			return nil
+		}
+
+		if isGitWorktree(path) || isBareRepository(path) {
+			found = append(found, path)
+			return filepath.SkipDir
+		}
+
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	return found, nil
+}
+
+func isGitWorktree(dir string) bool {
+	_, err := os.Lstat(filepath.Join(dir, ".git"))
+	return err == nil
+}
+
+func isBareRepository(dir string) bool {
+	if !strings.HasSuffix(dir, ".git") {
+		return false
+	}
+	fi, err := os.Stat(filepath.Join(dir, "objects"))
+	return err == nil && fi.IsDir()
+}
