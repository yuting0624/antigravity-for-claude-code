+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+
+	"github.com/sourcegraph/zoekt/index"
+)
+
+// record describes a single repository currently present in an index
+// directory, aggregated across all of the shard files that back it.
+type record struct {
+	Name       string
+	Source     string
+	ID         uint32
+	ShardPaths []string
+}
+
+// readInventory returns the paths of the shard files present in indexDir.
+func readInventory(indexDir string) ([]string, error) {
+	shards, err := filepath.Glob(filepath.Join(indexDir, "*.zoekt"))
+	if err != nil {
+		return nil, err
+	}
+	sort.Strings(shards)
+	return shards, nil
+}
+
+// recordsFromShards reads the repository metadata out of shards and groups
+// it by repository name, since a single repository's content can be spread
+// across more than one shard file. Shards that cannot be read are skipped.
+func recordsFromShards(shards []string) []record {
+	byName := map[string]*record{}
+	var names []string
+
+	for _, shard := range shards {
+		repos, _, err := index.ReadMetadataPathAlive(shard)
+		if err != nil {
+			continue
+		}
+
+		for _, repo := range repos {
+			r, ok := byName[repo.Name]
+			if !ok {
+				r = &record{Name: repo.Name, Source: repo.Source, ID: repo.ID}
+				byName[repo.Name] = r
+				names = append(names, repo.Name)
+			}
+			r.ShardPaths = append(r.ShardPaths, shard)
+		}
+	}
+
+	sort.Strings(names)
+	records := make([]record, 0, len(names))
+	for _, name := range names {
+		records = append(records, *byName[name])
+	}
+	return records
+}
+
+// removeRecords deletes the shard files (and any associated sidecar files)
+// backing records when force is true; otherwise it reports the shards that
+// would be removed. It always prints a reminder of how to apply the change
+// when force is false, even if there is nothing to remove.
+func removeRecords(w io.Writer, records []record, force bool) error {
+	for _, r := range records {
+		for _, shard := range r.ShardPaths {
+			if !force {
+				fmt.Fprintf(w, "Would remove %s\n", shard)
+				continue
+			}
+
+			paths, err := index.IndexFilePaths(shard)
+			if err != nil {
+				return err
+			}
+			for _, p := range paths {
+				if err := os.Remove(p); err != nil && !os.IsNotExist(err) {
+					return err
+				}
+			}
+		}
+	}
+
+	if !force {
+		fmt.Fprintln(w, "Pass -f to apply these changes.")
+	}
+
+	return nil
+}
