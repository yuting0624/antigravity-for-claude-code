+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"flag"
+	"fmt"
+	"io"
+	"strings"
+	"text/tabwriter"
+
+	"github.com/sourcegraph/zoekt/index"
+)
+
+func runList(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("zoekt-local-sync list", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	indexDir := fs.String("index", index.DefaultDir, "directory holding search indices")
+	fs.Usage = func() {
+		fmt.Fprintf(stderr, "Usage: zoekt-local-sync list [options]\n\n")
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	shards, err := readInventory(*indexDir)
+	if err != nil {
+		return err
+	}
+	records := recordsFromShards(shards)
+
+	tw := tabwriter.NewWriter(stdout, 0, 4, 2, ' ', 0)
+	fmt.Fprintln(tw, "NAME\tSOURCE\tSHARDS")
+	for _, r := range records {
+		fmt.Fprintf(tw, "%s\t%s\t%s\n", r.Name, r.Source, strings.Join(r.ShardPaths, ","))
+	}
+	return tw.Flush()
+}
