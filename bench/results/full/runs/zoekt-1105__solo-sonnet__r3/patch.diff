@@ -0,0 +1,67 @@
+// Copyright 2026 Sourcegraph, Inc. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"flag"
+	"fmt"
+	"io"
+
+	"github.com/sourcegraph/zoekt/index"
+)
+
+func runRemove(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("zoekt-local-sync remove", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	indexDir := fs.String("index", index.DefaultDir, "directory holding search indices")
+	force := fs.Bool("f", false, "apply the removal instead of only previewing it")
+	fs.Usage = func() {
+		fmt.Fprintf(stderr, "Usage: zoekt-local-sync remove [options] name-or-source...\n\n")
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	targets := fs.Args()
+	if len(targets) == 0 {
+		return fmt.Errorf("zoekt-local-sync remove: at least one repository name or source is required")
+	}
+	wanted := map[string]bool{}
+	for _, t := range targets {
+		wanted[t] = true
+	}
+
+	lock, err := acquireDirectoryLock(*indexDir)
+	if err != nil {
+		return err
+	}
+	defer lock.Close()
+
+	shards, err := readInventory(*indexDir)
+	if err != nil {
+		return err
+	}
+	records := recordsFromShards(shards)
+
+	var selected []record
+	for _, r := range records {
+		if wanted[r.Name] || wanted[r.Source] {
+			selected = append(selected, r)
+		}
+	}
+
+	return removeRecords(stdout, selected, *force)
+}
diff --git a/cmd/zoekt-local-sync/sync.go b/cmd/zoekt-local-sync/sync.go
new file mode 100644
index 00000000..f24e1a50
--- /dev/null
+++ b/cmd/zoekt-local-sync/sync.go
@@ -0,0 +1,162 @@
+// Copyright 2026 Sourcegraph, Inc. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"flag"
+	"fmt"
+	"io"
+	"strings"
+
+	"github.com/sourcegraph/zoekt"
+	"github.com/sourcegraph/zoekt/gitindex"
+	"github.com/sourcegraph/zoekt/index"
+)
+
+// syncFlags holds the options accepted by the "sync" command (also the
+// default command when no subcommand is given).
+type syncFlags struct {
+	force                bool
+	branches             string
+	branchPrefix         string
+	submodules           bool
+	incremental          bool
+	allowMissingBranches bool
+	repoCacheDir         string
+	buildOptions         *index.Options
+}
+
+// newSyncFlagSet builds the flag set shared by the sync command and by the
+// top-level help output (which prints its defaults).
+func newSyncFlagSet(name string, output io.Writer) (*flag.FlagSet, *syncFlags) {
+	fs := flag.NewFlagSet(name, flag.ContinueOnError)
+	fs.SetOutput(output)
+
+	sf := &syncFlags{
+		buildOptions: &index.Options{IndexDir: index.DefaultDir},
+	}
+	sf.buildOptions.Flags(fs)
+
+	fs.BoolVar(&sf.force, "f", false, "apply the planned changes instead of only previewing them")
+	fs.StringVar(&sf.branches, "branches", "HEAD", "comma-separated list of git branches to index")
+	fs.StringVar(&sf.branchPrefix, "prefix", "refs/heads/", "prefix for branch names")
+	fs.BoolVar(&sf.submodules, "submodules", true, "if set to false, do not recurse into submodules")
+	fs.BoolVar(&sf.incremental, "incremental", true, "only index repositories that changed")
+	fs.BoolVar(&sf.allowMissingBranches, "allow_missing_branches", false, "allow missing branches")
+	fs.StringVar(&sf.repoCacheDir, "repo_cache", "", "directory holding bare git repos, named by URL; used to find repositories for submodules")
+
+	return fs, sf
+}
+
+// gitIndexOptions builds the gitindex.Options for indexing repo, preserving
+// the name that discovery derived for it.
+func (sf *syncFlags) gitIndexOptions(repo Repository) gitindex.Options {
+	buildOptions := *sf.buildOptions
+	buildOptions.RepositoryDescription = zoekt.Repository{Name: repo.Name}
+
+	var branches []string
+	if sf.branches != "" {
+		branches = strings.Split(sf.branches, ",")
+	}
+
+	return gitindex.Options{
+		RepoDir:            repo.Path,
+		Submodules:         sf.submodules,
+		Incremental:        sf.incremental,
+		AllowMissingBranch: sf.allowMissingBranches,
+		RepoCacheDir:       sf.repoCacheDir,
+		BuildOptions:       buildOptions,
+		Branches:           branches,
+		BranchPrefix:       sf.branchPrefix,
+	}
+}
+
+func runSync(args []string, stdout, stderr io.Writer) error {
+	fs, sf := newSyncFlagSet("zoekt-local-sync sync", stderr)
+	fs.Usage = func() {
+		fmt.Fprintf(stderr, "Usage: zoekt-local-sync sync [options] root...\n\n")
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	roots := fs.Args()
+	if len(roots) == 0 {
+		return fmt.Errorf("zoekt-local-sync: at least one root directory is required")
+	}
+
+	repos, err := discoverRepositories(roots)
+	if err != nil {
+		return err
+	}
+
+	indexDir := sf.buildOptions.IndexDir
+	lock, err := acquireDirectoryLock(indexDir)
+	if err != nil {
+		return err
+	}
+	defer lock.Close()
+
+	shards, err := readInventory(indexDir)
+	if err != nil {
+		return err
+	}
+	existing := recordsFromShards(shards)
+
+	discovered := map[string]bool{}
+	for _, repo := range repos {
+		discovered[repo.Name] = true
+	}
+
+	var stale []record
+	for _, rec := range existing {
+		if !discovered[rec.Name] {
+			stale = append(stale, rec)
+		}
+	}
+
+	for _, repo := range repos {
+		gitOpts := sf.gitIndexOptions(repo)
+
+		needsIndexing, _, err := gitindex.PlanIndexGitRepo(gitOpts)
+		if err != nil {
+			return fmt.Errorf("planning %q: %w", repo.Name, err)
+		}
+
+		if !needsIndexing {
+			fmt.Fprintf(stdout, "Up to date %q\n", repo.Name)
+			continue
+		}
+
+		if !sf.force {
+			fmt.Fprintf(stdout, "Would index %q\n", repo.Name)
+			continue
+		}
+
+		fmt.Fprintf(stdout, "Indexing %q from %s\n", repo.Name, repo.Path)
+		updated, err := gitindex.IndexGitRepo(gitOpts)
+		if err != nil {
+			return fmt.Errorf("indexing %q: %w", repo.Name, err)
+		}
+		if updated {
+			fmt.Fprintf(stdout, "Indexed %q\n", repo.Name)
+		} else {
+			fmt.Fprintf(stdout, "Up to date %q\n", repo.Name)
+		}
+	}
+
+	return removeRecords(stdout, stale, sf.force)
+}
