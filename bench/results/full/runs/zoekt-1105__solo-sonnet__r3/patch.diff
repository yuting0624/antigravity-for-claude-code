+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Command zoekt-local-sync discovers git repositories beneath one or more
+// root directories on the local machine and keeps a zoekt index directory in
+// sync with them. By default it only previews the changes it would make;
+// pass -f to apply them.
+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+)
+
+func main() {
+	if err := execute(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if !errors.Is(err, flag.ErrHelp) {
+			fmt.Fprintln(os.Stderr, "zoekt-local-sync:", err)
+		}
+		os.Exit(1)
+	}
+}
+
+// execute runs zoekt-local-sync with the given arguments, writing to stdout
+// and stderr instead of the process' standard streams so it can be tested.
+func execute(args []string, stdout, stderr io.Writer) error {
+	if len(args) > 0 {
+		switch args[0] {
+		case "-h", "--help", "help":
+			printTopLevelHelp(stdout)
+			return nil
+		case "list":
+			return runList(args[1:], stdout, stderr)
+		case "remove":
+			return runRemove(args[1:], stdout, stderr)
+		case "sync":
+			return runSync(args[1:], stdout, stderr)
+		}
+	}
+
+	return runSync(args, stdout, stderr)
+}
+
+func printTopLevelHelp(w io.Writer) {
+	fmt.Fprint(w, `Usage: zoekt-local-sync sync [options] root...
+       zoekt-local-sync list [options]
+       zoekt-local-sync remove [options] name-or-source...
+
+zoekt-local-sync discovers git repositories beneath one or more root
+directories and keeps a zoekt index directory in sync with them. Repository
+names are derived from each repository's path relative to the root it was
+found under.
+
+Running zoekt-local-sync (or "zoekt-local-sync sync") without -f only
+previews the repositories that would be indexed and the ones that would be
+pruned because they are outside the selected roots; pass -f to apply the
+changes. "zoekt-local-sync list" prints the repositories currently in the
+index, and "zoekt-local-sync remove" previews or, with -f, applies removal of
+the named repositories.
+
+`)
+
+	fmt.Fprintln(w, "Default sync options:")
+	fs, _ := newSyncFlagSet("zoekt-local-sync sync", w)
+	fs.PrintDefaults()
+	fmt.Fprintln(w)
+
+	fmt.Fprintln(w, `Run "zoekt-local-sync list -h" or "zoekt-local-sync remove -h" for subcommand options.`)
+}
diff --git a/cmd/zoekt-local-sync/remove.go b/cmd/zoekt-local-sync/remove.go
