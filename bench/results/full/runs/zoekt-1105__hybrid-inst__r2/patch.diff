+
+package main
+
+import (
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+// repository is a git repository discovered under one of the roots.
+type repository struct {
+	// Name is the slash separated name of the repository, derived from its
+	// path relative to the root it was found under.
+	Name string
+	// Path is the absolute path of the repository: the work tree root, or
+	// the directory of a bare repository.
+	Path string
+	// Root is the absolute root directory the repository was found under.
+	Root string
+}
+
+// discoverRepositories walks roots and returns the git repositories below
+// them, sorted by name.
+func discoverRepositories(roots []string) ([]repository, error) {
+	var cleanRoots []string
+	for _, root := range roots {
+		absRoot, err := filepath.Abs(root)
+		if err != nil {
+			return nil, fmt.Errorf("root %q: %w", root, err)
+		}
+		absRoot = filepath.Clean(absRoot)
+		if _, err := os.Stat(absRoot); err != nil {
+			return nil, fmt.Errorf("root %q does not exist: %w", root, err)
+		}
+		cleanRoots = append(cleanRoots, absRoot)
+	}
+
+	seen := make(map[string]string)
+	var repos []repository
+
+	for _, absRoot := range cleanRoots {
+		err := filepath.WalkDir(absRoot, func(path string, d fs.DirEntry, err error) error {
+			if err != nil {
+				// Skip directories that cannot be read rather than aborting the walk.
+				return nil
+			}
+			if !d.IsDir() {
+				return nil
+			}
+			if !isRepository(path) {
+				return nil
+			}
+
+			var name string
+			if path == absRoot {
+				name = strings.TrimSuffix(filepath.Base(absRoot), ".git")
+			} else {
+				rel, err := filepath.Rel(absRoot, path)
+				if err != nil {
+					return err
+				}
+				name = strings.TrimSuffix(filepath.ToSlash(rel), ".git")
+			}
+
+			if prev, ok := seen[name]; ok {
+				return fmt.Errorf("duplicate repository name %q: %s and %s", name, prev, path)
+			}
+			seen[name] = path
+
+			repos = append(repos, repository{
+				Name: name,
+				Path: path,
+				Root: absRoot,
+			})
+			return filepath.SkipDir
+		})
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	sort.Slice(repos, func(i, j int) bool {
+		return repos[i].Name < repos[j].Name
+	})
+
+	return repos, nil
+}
+
+func isRepository(dir string) bool {
+	// (a) an entry named ".git" exists inside it (a directory OR a plain file, as used by worktrees and submodules)
+	if _, err := os.Lstat(filepath.Join(dir, ".git")); err == nil {
+		return true
+	}
+
+	// (b) it looks like a bare repository: it contains a subdirectory named "objects" AND
+	// (it contains an entry named "HEAD" OR its base name ends in ".git").
+	if fi, err := os.Stat(filepath.Join(dir, "objects")); err == nil && fi.IsDir() {
+		if strings.HasSuffix(filepath.Base(dir), ".git") {
+			return true
+		}
+		if _, err := os.Lstat(filepath.Join(dir, "HEAD")); err == nil {
+			return true
+		}
+	}
+
+	return false
+}
