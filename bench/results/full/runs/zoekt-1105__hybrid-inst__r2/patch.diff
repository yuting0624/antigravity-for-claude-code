+// limitations under the License.
+
+package main
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+
+	"github.com/go-git/go-git/v5"
+	"github.com/go-git/go-git/v5/plumbing"
+	"github.com/sourcegraph/zoekt"
+	"github.com/sourcegraph/zoekt/gitindex"
+	"github.com/sourcegraph/zoekt/index"
+)
+
+type shardInfo struct {
+	Path         string
+	Repositories []*zoekt.Repository
+}
+
+func readInventory(indexDir string) ([]shardInfo, error) {
+	if _, err := os.Stat(indexDir); os.IsNotExist(err) {
+		return nil, nil
+	}
+	matches, err := filepath.Glob(filepath.Join(indexDir, "*.zoekt"))
+	if err != nil {
+		return nil, err
+	}
+	sort.Strings(matches)
+
+	var shards []shardInfo
+	for _, match := range matches {
+		repos, _, err := index.ReadMetadataPath(match)
+		if err != nil {
+			continue
+		}
+		shards = append(shards, shardInfo{
+			Path:         match,
+			Repositories: repos,
+		})
+	}
+	return shards, nil
+}
+
+type repositoryRecord struct {
+	Name   string
+	Source string
+	Shards []string
+}
+
+func recordsFromShards(shards []shardInfo) []repositoryRecord {
+	groups := make(map[string]*repositoryRecord)
+	shardSets := make(map[string]map[string]struct{})
+	var names []string
+
+	for _, s := range shards {
+		for _, repo := range s.Repositories {
+			if repo == nil {
+				continue
+			}
+			rec, ok := groups[repo.Name]
+			if !ok {
+				rec = &repositoryRecord{Name: repo.Name}
+				groups[repo.Name] = rec
+				shardSets[repo.Name] = make(map[string]struct{})
+				names = append(names, repo.Name)
+			}
+			if rec.Source == "" && repo.Source != "" {
+				rec.Source = repo.Source
+			}
+			if s.Path != "" {
+				shardSets[repo.Name][s.Path] = struct{}{}
+			}
+		}
+	}
+
+	sort.Strings(names)
+	records := make([]repositoryRecord, 0, len(names))
+	for _, name := range names {
+		rec := *groups[name]
+		var shardList []string
+		for sp := range shardSets[name] {
+			shardList = append(shardList, sp)
+		}
+		sort.Strings(shardList)
+		rec.Shards = shardList
+		records = append(records, rec)
+	}
+	return records
+}
+
+func removeRecord(rec repositoryRecord) error {
+	for _, shard := range rec.Shards {
+		for _, path := range []string{shard, shard + ".meta"} {
+			if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func repositoryUpToDate(opts gitindex.Options) (bool, error) {
+	repo, err := git.PlainOpenWithOptions(opts.RepoDir, &git.PlainOpenOptions{
+		EnableDotGitCommonDir: true,
+	})
+	if errors.Is(err, git.ErrRepositoryNotExists) {
+		repo, err = git.PlainOpenWithOptions(opts.RepoDir, &git.PlainOpenOptions{
+			DetectDotGit:          true,
+			EnableDotGitCommonDir: true,
+		})
+	}
+	if err != nil {
+		return false, nil
+	}
+
+	var expandedBranches []string
+	for _, b := range opts.Branches {
+		if strings.Contains(b, "*") {
+			iter, err := repo.Branches()
+			if err != nil {
+				return false, nil
+			}
+			for {
+				ref, err := iter.Next()
+				if errors.Is(err, io.EOF) {
+					break
+				}
+				if err != nil {
+					iter.Close()
+					return false, nil
+				}
+				name := ref.Name().Short()
+				matched, err := filepath.Match(b, name)
+				if err != nil {
+					iter.Close()
+					return false, nil
+				}
+				if matched {
+					expandedBranches = append(expandedBranches, name)
+				}
+			}
+			iter.Close()
+		} else {
+			expandedBranches = append(expandedBranches, b)
+		}
+	}
+
+	var branches []zoekt.RepositoryBranch
+	for _, b := range expandedBranches {
+		hash, err := repo.ResolveRevision(plumbing.Revision(b))
+		if err != nil {
+			hash, err = repo.ResolveRevision(plumbing.Revision(filepath.Join(opts.BranchPrefix, b)))
+		}
+		if err != nil {
+			if opts.AllowMissingBranch {
+				continue
+			}
+			return false, nil
+		}
+		branches = append(branches, zoekt.RepositoryBranch{
+			Name:    b,
+			Version: hash.String(),
+		})
+	}
+
+	shards := opts.BuildOptions.FindAllShards()
+	if len(shards) == 0 {
+		return false, nil
+	}
+
+	repos, _, err := index.ReadMetadataPath(shards[0])
+	if err != nil {
+		return false, fmt.Errorf("read metadata %s: %w", shards[0], err)
+	}
+
+	var targetRepo *zoekt.Repository
+	for _, r := range repos {
+		if r != nil && r.Name == opts.BuildOptions.RepositoryDescription.Name {
+			targetRepo = r
+			break
+		}
+	}
+	if targetRepo == nil {
+		return false, nil
+	}
+
+	if targetRepo.IndexOptions != opts.BuildOptions.GetHash() {
+		return false, nil
+	}
+	if !reflect.DeepEqual(targetRepo.Branches, branches) {
+		return false, nil
+	}
+
+	return true, nil
+}
diff --git a/cmd/zoekt-local-sync/main.go b/cmd/zoekt-local-sync/main.go
