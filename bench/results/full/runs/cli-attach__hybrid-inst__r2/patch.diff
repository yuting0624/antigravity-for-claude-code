diff --git a/internal/attachments/attach.go b/internal/attachments/attach.go
new file mode 100644
index 000000000..4657eaf18
--- /dev/null
+++ b/internal/attachments/attach.go
@@ -0,0 +1,71 @@
+package attachments
+
+import (
+	"context"
+	"strings"
+)
+
+// UploadAndAttach uploads every asset and writes it into body, rewriting a
+// reference the body already carries and appending the rest. It returns the
+// body to write, how many assets reached the server, and the first upload
+// failure. An upload cannot be undone, so a body carrying an asset that did
+// reach the server is returned even when a later upload failed.
+func (u *Uploader) UploadAndAttach(ctx context.Context, body string, assets []UserAsset) (string, int, error) {
+	if len(assets) == 0 {
+		return body, 0, nil
+	}
+
+	args := make([]attachmentArg, len(assets))
+	for i, a := range assets {
+		args[i] = attachmentArg{
+			Path:            a.Path(),
+			Alt:             a.getAsset().alt,
+			RendersAsPlayer: a.rendersAsPlayer(),
+		}
+	}
+
+	v, err := newAttachableMarkdown(body, args)
+	if err != nil {
+		return body, 0, err
+	}
+
+	var uploadErr error
+	uploaded := 0
+	for i, a := range assets {
+		url, err := u.upload(ctx, a)
+		if err != nil {
+			uploadErr = err
+			break
+		}
+		args[i].URL = url
+		uploaded++
+	}
+
+	v.args = args
+	result, err := attachAssetsToMarkdown(v)
+	if err != nil {
+		if uploadErr != nil {
+			return body, uploaded, uploadErr
+		}
+		return body, uploaded, err
+	}
+
+	out := result.Rewritten
+	for _, r := range result.ToAppend {
+		out = appendParagraph(out, r.markdown())
+	}
+
+	return out, uploaded, uploadErr
+}
+
+// appendParagraph puts addition in a paragraph of its own below md.
+func appendParagraph(md, addition string) string {
+	if addition == "" {
+		return md
+	}
+	trimmed := strings.TrimRight(md, " \t\r\n")
+	if trimmed == "" {
+		return addition
+	}
+	return trimmed + "\n\n" + addition
+}
diff --git a/internal/attachments/client.go b/internal/attachments/client.go
new file mode 100644
index 000000000..b0c5948c3
--- /dev/null
+++ b/internal/attachments/client.go
@@ -0,0 +1,221 @@
+package attachments
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/cli/cli/v2/api"
+	"github.com/cli/cli/v2/internal/gh"
+	"github.com/cli/cli/v2/internal/ghinstance"
+)
+
+// Uploader posts files to a host's user-attachments endpoint.
+type Uploader struct {
+	httpClient       *http.Client
+	host             string
+	targetRepository int64
+}
+
+// NewUploader returns an uploader for host, or an error when the combination of
+// host, credential and repository role cannot upload.
+func NewUploader(httpClient *http.Client, tokenType gh.TokenType, host string, targetRepository int64, viewerPermission string) (*Uploader, error) {
+	if err := checkHost(host); err != nil {
+		return nil, err
+	}
+	switch tokenType {
+	case gh.TokenTypeOAuth, gh.TokenTypePersonalAccess, gh.TokenTypeFineGrainedPAT:
+	default:
+		return nil, errors.New("unsupported authentication type")
+	}
+	if targetRepository <= 0 {
+		return nil, errors.New("could not determine which repository to attach files to")
+	}
+	if viewerPermission == "" {
+		return nil, errors.New("could not determine your permission on the repository to attach files")
+	}
+	switch viewerPermission {
+	case "ADMIN", "MAINTAIN", "WRITE":
+	default:
+		return nil, errors.New("attaching files requires write access to the repository")
+	}
+	return &Uploader{
+		httpClient:       httpClient,
+		host:             host,
+		targetRepository: targetRepository,
+	}, nil
+}
+
+// checkHost reports whether host can accept user asset uploads at all.
+func checkHost(host string) error {
+	if ghinstance.CategorizeHost(host) == "ghes" {
+		return errors.New("attaching files is not supported on GitHub Enterprise Server")
+	}
+	return nil
+}
+
+// uploadError is the error every failed upload returns.
+type uploadError struct {
+	Path       string
+	StatusCode int
+	msg        string
+	err        error
+}
+
+func (e *uploadError) Error() string { return e.msg }
+func (e *uploadError) Unwrap() error { return e.err }
+
+func isDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// upload posts a single asset and returns the URL the server assigned it.
+func (u *Uploader) upload(ctx context.Context, a UserAsset) (string, error) {
+	base := a.getAsset()
+	path := base.path
+
+	f, err := openFile(path)
+	if err != nil {
+		return "", &uploadError{
+			Path:       path,
+			StatusCode: 0,
+			msg:        fmt.Sprintf("failed to upload %s: %v", path, err),
+			err:        err,
+		}
+	}
+	defer f.Close()
+
+	q := url.Values{}
+	q.Set("content_type", base.contentType)
+	q.Set("name", filepath.Base(path))
+	q.Set("repository_id", strconv.FormatInt(u.targetRepository, 10))
+
+	endpoint := ghinstance.UserAssetUploadPrefix(u.host) + "user-attachments/assets?" + q.Encode()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, f)
+	if err != nil {
+		return "", &uploadError{
+			Path:       path,
+			StatusCode: 0,
+			msg:        fmt.Sprintf("failed to upload %s: %v", path, err),
+			err:        err,
+		}
+	}
+
+	req.ContentLength = base.info.Size()
+	req.Header.Set("Content-Type", "application/octet-stream")
+	req.Header.Set("Accept", "application/vnd.github+json")
+
+	resp, err := u.httpClient.Do(req)
+	if err != nil {
+		return "", &uploadError{
+			Path:       path,
+			StatusCode: 0,
+			msg:        fmt.Sprintf("failed to upload %s: %v", path, err),
+			err:        err,
+		}
+	}
+	defer resp.Body.Close()
+
+	switch {
+	case resp.StatusCode >= 200 && resp.StatusCode <= 299:
+		var payload struct {
+			URL string `json:"url"`
+		}
+		if err := json.NewDecoder(resp.Body).Decode(&payload); err != nil {
+			return "", &uploadError{
+				Path:       path,
+				StatusCode: 0,
+				msg:        fmt.Sprintf("failed to upload %s: %v", path, err),
+				err:        err,
+			}
+		}
+		if payload.URL == "" {
+			return "", &uploadError{
+				Path:       path,
+				StatusCode: 0,
+				msg:        fmt.Sprintf("failed to upload %s: the server returned no asset URL", path),
+			}
+		}
+		return payload.URL, nil
+
+	case resp.StatusCode == 404:
+		return "", &uploadError{
+			Path:       path,
+			StatusCode: 404,
+			msg:        fmt.Sprintf("could not upload %s: attaching files requires write access to the repository", path),
+		}
+
+	case resp.StatusCode == 422:
+		var payload struct {
+			Message string `json:"message"`
+			Errors  []struct {
+				Resource string `json:"resource"`
+				Field    string `json:"field"`
+				Code     string `json:"code"`
+				Message  string `json:"message"`
+			} `json:"errors"`
+		}
+		_ = json.NewDecoder(resp.Body).Decode(&payload)
+
+		var parts []string
+		if payload.Message != "" {
+			parts = append(parts, payload.Message)
+		}
+		for _, entry := range payload.Errors {
+			if entry.Message != "" {
+				parts = append(parts, entry.Message)
+			} else if entry.Resource != "" && entry.Field != "" && entry.Code != "" {
+				parts = append(parts, fmt.Sprintf("%s.%s is %s", entry.Resource, entry.Field, entry.Code))
+			}
+		}
+		msg := "could not upload " + path
+		if len(parts) > 0 {
+			msg += ": " + strings.Join(parts, "; ")
+		}
+		return "", &uploadError{
+			Path:       path,
+			StatusCode: 422,
+			msg:        msg,
+		}
+
+	case resp.StatusCode == 429:
+		msg := fmt.Sprintf("could not upload %s: rate limited", path)
+		retryAfter := resp.Header.Get("Retry-After")
+		if retryAfter == "" {
+			msg += "; wait and try again"
+		} else if isDigits(retryAfter) {
+			msg += "; retry after " + retryAfter + " seconds"
+		} else {
+			msg += "; retry after " + retryAfter
+		}
+		return "", &uploadError{
+			Path:       path,
+			StatusCode: 429,
+			msg:        msg,
+		}
+
+	default:
+		httpErr := api.HandleHTTPError(resp)
+		return "", &uploadError{
+			Path:       path,
+			StatusCode: resp.StatusCode,
+			msg:        fmt.Sprintf("failed to upload %s: %v", path, httpErr),
+			err:        httpErr,
+		}
+	}
+}
diff --git a/internal/attachments/flags.go b/internal/attachments/flags.go
new file mode 100644
index 000000000..300e50d76
--- /dev/null
+++ b/internal/attachments/flags.go
@@ -0,0 +1,94 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"os"
+
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+)
+
+const flagName = "attach"
+
+// Flag is the repeatable --attach flag.
+type Flag struct {
+	flag   *pflag.Flag
+	values *[]string
+}
+
+// AddFlag registers --attach on cmd and returns the flag to resolve later.
+func AddFlag(cmd *cobra.Command) *Flag {
+	values := cmd.Flags().StringArray(flagName, []string{}, "Attach an image or video `file`, in '<file>#<image alt text>' format")
+	return &Flag{
+		flag:   cmd.Flags().Lookup(flagName),
+		values: values,
+	}
+}
+
+// Changed reports whether --attach was passed.
+func (f *Flag) Changed() bool {
+	return f != nil && f.flag != nil && f.flag.Changed
+}
+
+// UserAssets resolves every --attach value to a validated asset, in the
+// order the flags were written.
+func (f *Flag) UserAssets() ([]UserAsset, error) {
+	if f == nil || !f.Changed() || f.values == nil || len(*f.values) == 0 {
+		return nil, nil
+	}
+
+	var assets []UserAsset
+	for _, val := range *f.values {
+		if val == "" {
+			return nil, errors.New("cannot attach an empty path; --attach needs a file path")
+		}
+		if val == "-" {
+			return nil, errors.New("cannot attach standard input; --attach needs a file path")
+		}
+
+		path, alt := splitAttachValue(val)
+		a, err := newAsset(path, alt)
+		if err != nil {
+			return nil, err
+		}
+
+		for _, prev := range assets {
+			if os.SameFile(prev.getAsset().info, a.getAsset().info) {
+				return nil, fmt.Errorf("%s and %s are the same file; attached files must be unique", prev.Path(), a.Path())
+			}
+		}
+
+		assets = append(assets, a)
+	}
+
+	return assets, nil
+}
+
+func splitAttachValue(value string) (string, string) {
+	if _, err := os.Stat(value); err == nil {
+		return value, ""
+	}
+
+	var hashIndices []int
+	for i := 0; i < len(value); i++ {
+		if value[i] == '#' {
+			hashIndices = append(hashIndices, i)
+		}
+	}
+
+	for i := len(hashIndices) - 1; i >= 0; i-- {
+		idx := hashIndices[i]
+		candidate := value[:idx]
+		if _, err := os.Stat(candidate); err == nil {
+			return candidate, value[idx+1:]
+		}
+	}
+
+	if len(hashIndices) > 0 {
+		last := hashIndices[len(hashIndices)-1]
+		return value[:last], value[last+1:]
+	}
+
+	return value, ""
+}
diff --git a/internal/attachments/references.go b/internal/attachments/references.go
new file mode 100644
index 000000000..fe2a7b869
--- /dev/null
+++ b/internal/attachments/references.go
@@ -0,0 +1,766 @@
+package attachments
+
+import (
+	"fmt"
+	"net/url"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/yuin/goldmark"
+	"github.com/yuin/goldmark/ast"
+	"github.com/yuin/goldmark/parser"
+	"github.com/yuin/goldmark/text"
+)
+
+// attachmentArg is one attached file as the rewriter sees it.
+type attachmentArg struct {
+	Path            string
+	URL             string
+	Alt             string
+	RendersAsPlayer bool
+}
+
+// markdown renders the attachment as the markdown that embeds it.
+func (a attachmentArg) markdown() string {
+	if a.RendersAsPlayer {
+		return a.URL
+	}
+	return "![" + escapeAltText(a.Alt) + "](" + a.URL + ")"
+}
+
+// attachableMarkdown is a markdown body that has been checked against the
+// attachments it will carry.
+type attachableMarkdown struct {
+	markdown string
+	args     []attachmentArg
+}
+
+// attachResult is the rewritten body plus the attachments nothing referenced.
+type attachResult struct {
+	Rewritten string
+	ToAppend  []attachmentArg
+}
+
+// isSingleImage reports whether markdown is exactly one image pointing at url.
+func isSingleImage(markdown, url string) bool {
+	if markdown == "" {
+		return false
+	}
+	md := goldmark.New()
+	reader := text.NewReader([]byte(markdown))
+	doc := md.Parser().Parse(reader)
+	if doc.ChildCount() != 1 {
+		return false
+	}
+	p, ok := doc.FirstChild().(*ast.Paragraph)
+	if !ok {
+		return false
+	}
+	if p.ChildCount() != 1 {
+		return false
+	}
+	img, ok := p.FirstChild().(*ast.Image)
+	if !ok {
+		return false
+	}
+	return string(img.Destination) == url
+}
+
+type byteRange struct {
+	start int
+	stop  int
+}
+
+type inlineBlock struct {
+	start       int
+	stop        int
+	isParagraph bool
+}
+
+type replacement struct {
+	start int
+	end   int
+	text  string
+	arg   int
+}
+
+type analysisResult struct {
+	astImageCount             []int
+	astLinkCount              []int
+	inlineImageCandidateCount []int
+	inlineLinkCandidateCount  []int
+	replacements              []replacement
+	protectedRanges           []byteRange
+	inlineBlocks              []inlineBlock
+}
+
+func isASCIIPunctuation(b byte) bool {
+	return (b >= '!' && b <= '/') ||
+		(b >= ':' && b <= '@') ||
+		(b >= '[' && b <= '`') ||
+		(b >= '{' && b <= '~')
+}
+
+func decodeDestination(raw string) string {
+	var buf strings.Builder
+	for i := 0; i < len(raw); {
+		if raw[i] == '\\' && i+1 < len(raw) && isASCIIPunctuation(raw[i+1]) {
+			buf.WriteByte(raw[i+1])
+			i += 2
+			continue
+		}
+		buf.WriteByte(raw[i])
+		i++
+	}
+	s := buf.String()
+	unescaped, err := url.PathUnescape(s)
+	if err == nil {
+		return unescaped
+	}
+	return s
+}
+
+func isURIScheme(dest string) bool {
+	idx := strings.IndexByte(dest, ':')
+	if idx <= 1 {
+		return false
+	}
+	scheme := dest[:idx]
+	first := scheme[0]
+	if !((first >= 'a' && first <= 'z') || (first >= 'A' && first <= 'Z')) {
+		return false
+	}
+	for i := 1; i < len(scheme); i++ {
+		b := scheme[i]
+		if !((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '+' || b == '.' || b == '-') {
+			return false
+		}
+	}
+	return true
+}
+
+func matchAttachment(dest string, args []attachmentArg, requireURL bool) int {
+	if dest == "" || strings.HasPrefix(dest, "#") || strings.HasPrefix(dest, "//") || isURIScheme(dest) {
+		return -1
+	}
+	cleanDest := filepath.Clean(dest)
+	absDest, absDestErr := filepath.Abs(dest)
+
+	for i, arg := range args {
+		if requireURL && arg.URL == "" {
+			continue
+		}
+		if arg.Path == dest {
+			return i
+		}
+		if filepath.Clean(arg.Path) == cleanDest {
+			return i
+		}
+		if absDestErr == nil {
+			if absArg, err := filepath.Abs(arg.Path); err == nil && absArg == absDest {
+				return i
+			}
+		}
+	}
+	return -1
+}
+
+func isEscaped(src []byte, idx int) bool {
+	count := 0
+	for k := idx - 1; k >= 0 && src[k] == '\\'; k-- {
+		count++
+	}
+	return count%2 == 1
+}
+
+func inProtectedRange(idx int, ranges []byteRange) (int, bool) {
+	for _, r := range ranges {
+		if idx >= r.start && idx < r.stop {
+			return r.stop, true
+		}
+	}
+	return idx, false
+}
+
+func jumpBeforeProtectedRange(idx int, ranges []byteRange) int {
+	for _, r := range ranges {
+		if idx >= r.start && idx < r.stop {
+			return r.start - 1
+		}
+	}
+	return idx
+}
+
+func analyzeMarkdown(src []byte, args []attachmentArg, requireURL bool) analysisResult {
+	md := goldmark.New()
+	reader := text.NewReader(src)
+	ctx := parser.NewContext()
+	doc := md.Parser().Parse(reader, parser.WithContext(ctx))
+
+	var protectedRanges []byteRange
+	var inlineBlocks []inlineBlock
+
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		switch node := n.(type) {
+		case *ast.FencedCodeBlock:
+			if lines := node.Lines(); lines != nil && lines.Len() > 0 {
+				protectedRanges = append(protectedRanges, byteRange{
+					start: lines.At(0).Start,
+					stop:  lines.At(lines.Len() - 1).Stop,
+				})
+			}
+		case *ast.CodeBlock:
+			if lines := node.Lines(); lines != nil && lines.Len() > 0 {
+				protectedRanges = append(protectedRanges, byteRange{
+					start: lines.At(0).Start,
+					stop:  lines.At(lines.Len() - 1).Stop,
+				})
+			}
+		case *ast.CodeSpan:
+			var start, stop int
+			first := true
+			for c := node.FirstChild(); c != nil; c = c.NextSibling() {
+				if t, ok := c.(*ast.Text); ok {
+					if first || t.Segment.Start < start {
+						start = t.Segment.Start
+					}
+					if first || t.Segment.Stop > stop {
+						stop = t.Segment.Stop
+					}
+					first = false
+				}
+			}
+			if !first {
+				protectedRanges = append(protectedRanges, byteRange{start: start, stop: stop})
+			}
+		case *ast.Paragraph:
+			if lines := node.Lines(); lines != nil && lines.Len() > 0 {
+				inlineBlocks = append(inlineBlocks, inlineBlock{
+					start:       lines.At(0).Start,
+					stop:        lines.At(lines.Len() - 1).Stop,
+					isParagraph: true,
+				})
+			}
+		case *ast.Heading:
+			if lines := node.Lines(); lines != nil && lines.Len() > 0 {
+				inlineBlocks = append(inlineBlocks, inlineBlock{
+					start:       lines.At(0).Start,
+					stop:        lines.At(lines.Len() - 1).Stop,
+					isParagraph: false,
+				})
+			}
+		case *ast.TextBlock:
+			if lines := node.Lines(); lines != nil && lines.Len() > 0 {
+				inlineBlocks = append(inlineBlocks, inlineBlock{
+					start:       lines.At(0).Start,
+					stop:        lines.At(lines.Len() - 1).Stop,
+					isParagraph: false,
+				})
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+
+	inlineImageCandidateCount := make([]int, len(args))
+	inlineLinkCandidateCount := make([]int, len(args))
+	var replacements []replacement
+
+	for _, block := range inlineBlocks {
+		for i := block.start; i+1 < block.stop; {
+			if next, ok := inProtectedRange(i, protectedRanges); ok {
+				i = next
+				continue
+			}
+			if src[i] == ']' && src[i+1] == '(' && !isEscaped(src, i) {
+				p := i
+				if p+2 >= block.stop {
+					i = p + 2
+					continue
+				}
+
+				var destRaw string
+				var replStart, replEnd int
+				var curr int
+
+				if src[p+2] == '<' {
+					closingAngle := -1
+					for k := p + 3; k < block.stop; k++ {
+						if src[k] == '\n' || src[k] == '\r' {
+							break
+						}
+						if src[k] == '>' && !isEscaped(src, k) {
+							closingAngle = k
+							break
+						}
+					}
+					if closingAngle == -1 {
+						i = p + 2
+						continue
+					}
+					destRaw = string(src[p+3 : closingAngle])
+					replStart = p + 2
+					replEnd = closingAngle + 1
+					curr = closingAngle + 1
+				} else {
+					destStart := p + 2
+					destEnd := -1
+					depth := 0
+					rejected := false
+					for k := destStart; k < block.stop; k++ {
+						if src[k] == '\\' {
+							if k+1 >= block.stop || src[k+1] == '\n' || src[k+1] == '\r' {
+								rejected = true
+								break
+							}
+							k++
+							continue
+						}
+						if src[k] == '\n' || src[k] == '\r' {
+							rejected = true
+							break
+						}
+						if src[k] == ' ' || src[k] == '\t' {
+							destEnd = k
+							break
+						}
+						if src[k] == '(' {
+							depth++
+						} else if src[k] == ')' {
+							if depth == 0 {
+								destEnd = k
+								break
+							}
+							depth--
+						}
+					}
+					if rejected || destEnd == -1 {
+						i = p + 2
+						continue
+					}
+					destRaw = string(src[destStart:destEnd])
+					replStart = destStart
+					replEnd = destEnd
+					curr = destEnd
+				}
+
+				for curr < block.stop && (src[curr] == ' ' || src[curr] == '\t') {
+					curr++
+				}
+				if curr >= block.stop {
+					i = p + 2
+					continue
+				}
+
+				var closeParen int
+				if src[curr] == ')' {
+					closeParen = curr
+				} else if src[curr] == '"' || src[curr] == '\'' || src[curr] == '(' {
+					opener := src[curr]
+					var closer byte
+					switch opener {
+					case '"':
+						closer = '"'
+					case '\'':
+						closer = '\''
+					case '(':
+						closer = ')'
+					}
+					curr++
+					foundCloser := false
+					for curr < block.stop {
+						if src[curr] == '\\' {
+							if curr+1 < block.stop {
+								curr += 2
+								continue
+							}
+							break
+						}
+						if src[curr] == closer {
+							foundCloser = true
+							curr++
+							break
+						}
+						curr++
+					}
+					if !foundCloser {
+						i = p + 2
+						continue
+					}
+					for curr < block.stop && (src[curr] == ' ' || src[curr] == '\t') {
+						curr++
+					}
+					if curr < block.stop && src[curr] == ')' {
+						closeParen = curr
+					} else {
+						i = p + 2
+						continue
+					}
+				} else {
+					i = p + 2
+					continue
+				}
+
+				dest := decodeDestination(destRaw)
+				argIdx := matchAttachment(dest, args, requireURL)
+				if argIdx == -1 {
+					i = p + 2
+					continue
+				}
+
+				depth := 1
+				b := -1
+				for j := p - 1; j >= block.start; {
+					if prev := jumpBeforeProtectedRange(j, protectedRanges); prev != j {
+						j = prev
+						continue
+					}
+					if !isEscaped(src, j) {
+						if src[j] == ']' {
+							depth++
+						} else if src[j] == '[' {
+							depth--
+							if depth == 0 {
+								b = j
+								break
+							}
+						}
+					}
+					j--
+				}
+				if b == -1 {
+					i = p + 2
+					continue
+				}
+
+				isImage := false
+				embedStart := b
+				if b > block.start && src[b-1] == '!' && !isEscaped(src, b-1) {
+					isImage = true
+					embedStart = b - 1
+				}
+
+				if isImage {
+					inlineImageCandidateCount[argIdx]++
+				} else {
+					inlineLinkCandidateCount[argIdx]++
+				}
+
+				if requireURL {
+					arg := args[argIdx]
+					if !isImage || !arg.RendersAsPlayer {
+						replacements = append(replacements, replacement{
+							start: replStart,
+							end:   replEnd,
+							text:  arg.URL,
+							arg:   argIdx,
+						})
+					} else {
+						standsAlone := false
+						if block.isParagraph {
+							lead := block.start
+							for lead < block.stop && (src[lead] == ' ' || src[lead] == '\t' || src[lead] == '\n' || src[lead] == '\r') {
+								lead++
+							}
+							trail := block.stop
+							for trail > block.start && (src[trail-1] == ' ' || src[trail-1] == '\t' || src[trail-1] == '\n' || src[trail-1] == '\r') {
+								trail--
+							}
+							if embedStart == lead && closeParen+1 == trail {
+								standsAlone = true
+							}
+						}
+
+						if standsAlone {
+							replacements = append(replacements, replacement{
+								start: embedStart,
+								end:   closeParen + 1,
+								text:  arg.URL,
+								arg:   argIdx,
+							})
+						} else {
+							if embedStart > 0 && src[embedStart-1] == '!' && !isEscaped(src, embedStart-1) {
+								replacements = append(replacements, replacement{
+									start: embedStart - 1,
+									end:   embedStart + 2,
+									text:  `\![`,
+									arg:   argIdx,
+								})
+							} else {
+								replacements = append(replacements, replacement{
+									start: embedStart,
+									end:   embedStart + 2,
+									text:  `[`,
+									arg:   argIdx,
+								})
+							}
+							if b+1 == p {
+								replacements = append(replacements, replacement{
+									start: b + 1,
+									end:   b + 1,
+									text:  escapeAltText(arg.Alt),
+									arg:   argIdx,
+								})
+							}
+							replacements = append(replacements, replacement{
+								start: replStart,
+								end:   replEnd,
+								text:  arg.URL,
+								arg:   argIdx,
+							})
+						}
+					}
+				}
+
+				i = p + 2
+				continue
+			}
+			i++
+		}
+	}
+
+	astImageCount := make([]int, len(args))
+	astLinkCount := make([]int, len(args))
+
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		switch node := n.(type) {
+		case *ast.Image:
+			dest := decodeDestination(string(node.Destination))
+			if idx := matchAttachment(dest, args, requireURL); idx >= 0 {
+				astImageCount[idx]++
+			}
+		case *ast.Link:
+			dest := decodeDestination(string(node.Destination))
+			if idx := matchAttachment(dest, args, requireURL); idx >= 0 {
+				astLinkCount[idx]++
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+
+	return analysisResult{
+		astImageCount:             astImageCount,
+		astLinkCount:              astLinkCount,
+		inlineImageCandidateCount: inlineImageCandidateCount,
+		inlineLinkCandidateCount:  inlineLinkCandidateCount,
+		replacements:              replacements,
+		protectedRanges:           protectedRanges,
+		inlineBlocks:              inlineBlocks,
+	}
+}
+
+// newAttachableMarkdown refuses markdown the attachments cannot be written into,
+// before anything is uploaded.
+func newAttachableMarkdown(markdown string, args []attachmentArg) (attachableMarkdown, error) {
+	src := []byte(markdown)
+	analysis := analyzeMarkdown(src, args, false)
+
+	seen := make(map[string]bool)
+	var paths []string
+	for i, arg := range args {
+		if arg.RendersAsPlayer && analysis.astImageCount[i] > analysis.inlineImageCandidateCount[i] {
+			if !seen[arg.Path] {
+				seen[arg.Path] = true
+				paths = append(paths, arg.Path)
+			}
+		}
+	}
+
+	if len(paths) > 0 {
+		return attachableMarkdown{}, fmt.Errorf("cannot embed a video as a reference-style image: %s", strings.Join(paths, ", "))
+	}
+	return attachableMarkdown{markdown: markdown, args: args}, nil
+}
+
+// attachAssetsToMarkdown rewrites every reference to an attached file.
+func attachAssetsToMarkdown(v attachableMarkdown) (attachResult, error) {
+	src := []byte(v.markdown)
+	analysis := analyzeMarkdown(src, v.args, true)
+
+	usedThroughReference := make([]bool, len(v.args))
+	for i := range v.args {
+		totalAST := analysis.astImageCount[i] + analysis.astLinkCount[i]
+		totalInline := analysis.inlineImageCandidateCount[i] + analysis.inlineLinkCandidateCount[i]
+		if totalAST > totalInline {
+			usedThroughReference[i] = true
+		}
+	}
+
+	var allExcluded []byteRange
+	allExcluded = append(allExcluded, analysis.protectedRanges...)
+	for _, b := range analysis.inlineBlocks {
+		allExcluded = append(allExcluded, byteRange{start: b.start, stop: b.stop})
+	}
+	sort.Slice(allExcluded, func(i, j int) bool {
+		if allExcluded[i].start != allExcluded[j].start {
+			return allExcluded[i].start < allExcluded[j].start
+		}
+		return allExcluded[i].stop < allExcluded[j].stop
+	})
+
+	var merged []byteRange
+	for _, r := range allExcluded {
+		if r.start >= r.stop {
+			continue
+		}
+		if len(merged) == 0 {
+			merged = append(merged, r)
+			continue
+		}
+		last := &merged[len(merged)-1]
+		if r.start <= last.stop {
+			if r.stop > last.stop {
+				last.stop = r.stop
+			}
+		} else {
+			merged = append(merged, r)
+		}
+	}
+
+	var freeStretches []byteRange
+	curr := 0
+	for _, r := range merged {
+		if r.start > curr {
+			freeStretches = append(freeStretches, byteRange{start: curr, stop: r.start})
+		}
+		if r.stop > curr {
+			curr = r.stop
+		}
+	}
+	if curr < len(src) {
+		freeStretches = append(freeStretches, byteRange{start: curr, stop: len(src)})
+	}
+
+	replacements := analysis.replacements
+
+	for _, stretch := range freeStretches {
+		for i := stretch.start; i < stretch.stop; {
+			if src[i] == '[' && !isEscaped(src, i) {
+				labelStart := i + 1
+				labelEnd := -1
+				for k := labelStart; k < stretch.stop; k++ {
+					if src[k] == ']' && !isEscaped(src, k) {
+						labelEnd = k
+						break
+					}
+				}
+				if labelEnd == -1 || labelEnd+1 >= stretch.stop || src[labelEnd+1] != ':' {
+					i++
+					continue
+				}
+				curr := labelEnd + 2
+				for curr < stretch.stop && (src[curr] == ' ' || src[curr] == '\t') {
+					curr++
+				}
+				if curr >= stretch.stop || src[curr] == '\n' || src[curr] == '\r' {
+					i = labelEnd + 1
+					continue
+				}
+
+				var destRaw string
+				var replStart, replEnd int
+				var nextScan int
+
+				if src[curr] == '<' {
+					closingAngle := -1
+					for k := curr + 1; k < stretch.stop; k++ {
+						if src[k] == '\n' || src[k] == '\r' {
+							break
+						}
+						if src[k] == '>' && !isEscaped(src, k) {
+							closingAngle = k
+							break
+						}
+					}
+					if closingAngle == -1 {
+						i = labelEnd + 1
+						continue
+					}
+					destRaw = string(src[curr+1 : closingAngle])
+					replStart = curr
+					replEnd = closingAngle + 1
+					nextScan = closingAngle + 1
+				} else {
+					destStart := curr
+					for curr < stretch.stop && src[curr] != ' ' && src[curr] != '\t' && src[curr] != '\n' && src[curr] != '\r' {
+						curr++
+					}
+					if curr == destStart {
+						i = labelEnd + 1
+						continue
+					}
+					destRaw = string(src[destStart:curr])
+					replStart = destStart
+					replEnd = curr
+					nextScan = curr
+				}
+
+				dest := decodeDestination(destRaw)
+				argIdx := matchAttachment(dest, v.args, true)
+				if argIdx >= 0 && usedThroughReference[argIdx] {
+					replacements = append(replacements, replacement{
+						start: replStart,
+						end:   replEnd,
+						text:  v.args[argIdx].URL,
+						arg:   argIdx,
+					})
+				}
+
+				i = nextScan
+				continue
+			}
+			i++
+		}
+	}
+
+	sort.Slice(replacements, func(i, j int) bool {
+		if replacements[i].start != replacements[j].start {
+			return replacements[i].start < replacements[j].start
+		}
+		return replacements[i].end > replacements[j].end
+	})
+
+	var kept []replacement
+	lastEnd := -1
+	for _, r := range replacements {
+		if r.start >= lastEnd {
+			kept = append(kept, r)
+			lastEnd = r.end
+		}
+	}
+
+	var buf strings.Builder
+	currPos := 0
+	for _, r := range kept {
+		buf.Write(src[currPos:r.start])
+		buf.WriteString(r.text)
+		currPos = r.end
+	}
+	buf.Write(src[currPos:])
+	rewritten := buf.String()
+
+	referenced := make(map[int]bool)
+	for _, r := range kept {
+		if r.arg >= 0 {
+			referenced[r.arg] = true
+		}
+	}
+
+	var toAppend []attachmentArg
+	for i, arg := range v.args {
+		if arg.URL != "" && !referenced[i] {
+			toAppend = append(toAppend, arg)
+		}
+	}
+
+	return attachResult{
+		Rewritten: rewritten,
+		ToAppend:  toAppend,
+	}, nil
+}
diff --git a/internal/attachments/testing.go b/internal/attachments/testing.go
new file mode 100644
index 000000000..2a57810e1
--- /dev/null
+++ b/internal/attachments/testing.go
@@ -0,0 +1,72 @@
+// Helpers in this file are called by tests in other packages.
+// They live in a non-_test file so that other packages can import them.
+package attachments
+
+import (
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/httpmock"
+	"github.com/stretchr/testify/require"
+)
+
+// UploadStub describes one stubbed response from the user-attachments endpoint.
+type UploadStub struct {
+	Name   string
+	Status int
+	Body   string
+}
+
+// StubUpload registers a stubbed upload of name to repositoryID on the default upload host.
+func StubUpload(reg *httpmock.Registry, repositoryID int64, name string, status int, body string) {
+	stubUpload(reg, "", repositoryID, name, status, body)
+}
+
+// StubUploadToHost is StubUpload for an upload host other than uploads.github.com.
+func StubUploadToHost(t *testing.T, reg *httpmock.Registry, host string, repositoryID int64, name string, status int, body string) {
+	t.Helper()
+	stubUpload(reg, host, repositoryID, name, status, body)
+}
+
+func stubUpload(reg *httpmock.Registry, host string, repositoryID int64, name string, status int, body string) {
+	reg.Register(
+		func(req *http.Request) bool {
+			if req.Method != http.MethodPost {
+				return false
+			}
+			if req.URL.EscapedPath() != "/user-attachments/assets" {
+				return false
+			}
+			if req.URL.Query().Get("name") != name {
+				return false
+			}
+			if req.URL.Query().Get("repository_id") != strconv.FormatInt(repositoryID, 10) {
+				return false
+			}
+			if host != "" && !strings.EqualFold(req.URL.Host, host) {
+				return false
+			}
+			return true
+		},
+		httpmock.StatusStringResponse(status, body),
+	)
+}
+
+// NewTestAssets moves the test into a temporary directory, writes a file per name
+// there, and resolves them the way --attach does.
+func NewTestAssets(t *testing.T, names ...string) []UserAsset {
+	t.Helper()
+	t.Chdir(t.TempDir())
+	assets := make([]UserAsset, 0, len(names))
+	for _, name := range names {
+		err := os.WriteFile(name, []byte("the bytes"), 0o600)
+		require.NoError(t, err)
+		a, err := newAsset("./"+name, "")
+		require.NoError(t, err)
+		assets = append(assets, a)
+	}
+	return assets
+}
diff --git a/internal/attachments/userasset.go b/internal/attachments/userasset.go
new file mode 100644
index 000000000..9afe023ee
--- /dev/null
+++ b/internal/attachments/userasset.go
@@ -0,0 +1,157 @@
+// Package attachments decides what gh will attach to an issue or pull request body.
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+const (
+	maxImageBytes = 10 * 1024 * 1024
+	maxVideoBytes = 100 * 1024 * 1024
+)
+
+var openFile = func(path string) (io.ReadCloser, error) { return os.Open(path) }
+
+var supportedExtensions = []string{
+	"png", "jpg", "jpeg", "gif", "webp", "svg", "mp4", "mov", "webm",
+}
+
+var extensionContentTypes = map[string]string{
+	".png":  "image/png",
+	".jpg":  "image/jpeg",
+	".jpeg": "image/jpeg",
+	".gif":  "image/gif",
+	".webp": "image/webp",
+	".svg":  "image/svg+xml",
+	".mp4":  "video/mp4",
+	".mov":  "video/quicktime",
+	".webm": "video/webm",
+}
+
+type asset struct {
+	path        string
+	alt         string
+	contentType string
+	info        fs.FileInfo
+}
+
+type imageAsset struct{ asset }
+type videoAsset struct{ asset }
+
+// UserAsset is a local file gh will upload and reference from a markdown body.
+type UserAsset interface {
+	Path() string
+	getAsset() *asset
+	markdown(assetURL string) string
+	rendersAsPlayer() bool
+}
+
+// Path returns the asset's file path.
+func (a *asset) Path() string {
+	return a.path
+}
+
+func (a *asset) getAsset() *asset {
+	return a
+}
+
+func (a *imageAsset) rendersAsPlayer() bool {
+	return false
+}
+
+func (a *videoAsset) rendersAsPlayer() bool {
+	return true
+}
+
+func (a *imageAsset) markdown(assetURL string) string {
+	return "![" + escapeAltText(a.alt) + "](" + assetURL + ")"
+}
+
+func (a *videoAsset) markdown(assetURL string) string {
+	return assetURL
+}
+
+func escapeAltText(s string) string {
+	s = strings.ReplaceAll(s, `\`, `\\`)
+	s = strings.ReplaceAll(s, "[", `\[`)
+	s = strings.ReplaceAll(s, "]", `\]`)
+	s = strings.ReplaceAll(s, "\r", " ")
+	s = strings.ReplaceAll(s, "\n", " ")
+	return s
+}
+
+func formatMB(bytes int64) string {
+	return fmt.Sprintf("%.1f MB", float64(bytes)/(1024*1024))
+}
+
+// newAsset validates path and returns the asset gh will upload. It reads
+// metadata only, never the file contents.
+func newAsset(path, alt string) (UserAsset, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		var pe *fs.PathError
+		if errors.As(err, &pe) {
+			return nil, fmt.Errorf("%s: %w", path, pe.Err)
+		}
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+
+	if info.IsDir() {
+		return nil, fmt.Errorf("%s is a directory", path)
+	}
+
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%s is not a regular file", path)
+	}
+
+	contentType, ok := extensionContentTypes[strings.ToLower(filepath.Ext(path))]
+	if !ok {
+		return nil, fmt.Errorf("%s is not a supported file type (supported: %s)", path, strings.Join(supportedExtensions, ", "))
+	}
+
+	isVideo := strings.HasPrefix(contentType, "video/")
+	if isVideo && alt != "" {
+		return nil, errors.New("cannot set alt text on video")
+	}
+
+	if info.Size() == 0 {
+		return nil, fmt.Errorf("%s is empty", path)
+	}
+
+	if isVideo {
+		if info.Size() > maxVideoBytes {
+			return nil, fmt.Errorf("%s: videos must be at most %s", path, formatMB(maxVideoBytes))
+		}
+	} else {
+		if info.Size() > maxImageBytes {
+			return nil, fmt.Errorf("%s: images must be at most %s", path, formatMB(maxImageBytes))
+		}
+	}
+
+	if alt == "" {
+		base := filepath.Base(path)
+		if isVideo {
+			alt = base
+		} else {
+			nameWithoutExt := strings.TrimSuffix(base, filepath.Ext(base))
+			alt = strings.ReplaceAll(nameWithoutExt, ".", " ")
+		}
+	}
+
+	base := asset{
+		path:        path,
+		alt:         alt,
+		contentType: contentType,
+		info:        info,
+	}
+	if isVideo {
+		return &videoAsset{base}, nil
+	}
+	return &imageAsset{base}, nil
+}
