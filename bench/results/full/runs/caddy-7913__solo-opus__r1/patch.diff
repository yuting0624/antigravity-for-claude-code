+package timeouts
+
+import (
+	"time"
+
+	"github.com/dustin/go-humanize"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/caddyconfig/caddyfile"
+	"github.com/caddyserver/caddy/v2/caddyconfig/httpcaddyfile"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func init() {
+	httpcaddyfile.RegisterHandlerDirective("timeouts", parseCaddyfile)
+}
+
+// parseCaddyfile sets up the handler from Caddyfile tokens. Syntax:
+//
+//	timeouts {
+//	    read_timeout    <duration> [<min_rate>]
+//	    write_timeout   <duration> [<min_rate>]
+//	    write_max_chunk <size>
+//	}
+//
+// The optional second argument of read_timeout and write_timeout is a
+// minimum transfer rate in bytes per second.
+func parseCaddyfile(h httpcaddyfile.Helper) (caddyhttp.MiddlewareHandler, error) {
+	t := new(Timeouts)
+	if err := t.UnmarshalCaddyfile(h.Dispenser); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
+
+// UnmarshalCaddyfile implements caddyfile.Unmarshaler.
+func (t *Timeouts) UnmarshalCaddyfile(d *caddyfile.Dispenser) error {
+	d.Next() // consume directive name
+
+	if d.NextArg() {
+		return d.ArgErr()
+	}
+
+	for d.NextBlock(0) {
+		switch d.Val() {
+		case "read_timeout":
+			timeout, rate, err := parseTimeoutAndRate(d, "read_timeout")
+			if err != nil {
+				return err
+			}
+			t.ReadTimeout, t.ReadMinRate = timeout, rate
+
+		case "write_timeout":
+			timeout, rate, err := parseTimeoutAndRate(d, "write_timeout")
+			if err != nil {
+				return err
+			}
+			t.WriteTimeout, t.WriteMinRate = timeout, rate
+
+		case "write_max_chunk":
+			var sizeStr string
+			if !d.AllArgs(&sizeStr) {
+				return d.ArgErr()
+			}
+			size, err := humanize.ParseBytes(sizeStr)
+			if err != nil {
+				return d.Errf("parsing write_max_chunk: %v", err)
+			}
+			t.MaxWriteChunk = int(size)
+
+		default:
+			return d.Errf("unrecognized timeouts subdirective '%s'", d.Val())
+		}
+	}
+
+	return nil
+}
+
+// parseTimeoutAndRate parses a duration followed by an optional
+// minimum transfer rate in bytes per second.
+func parseTimeoutAndRate(d *caddyfile.Dispenser, name string) (time.Duration, int64, error) {
+	var timeoutStr, rateStr string
+	if !d.Args(&timeoutStr) {
+		return 0, 0, d.ArgErr()
+	}
+	timeout, err := caddy.ParseDuration(timeoutStr)
+	if err != nil {
+		return 0, 0, d.Errf("parsing %s duration: %v", name, err)
+	}
+	if d.NextArg() {
+		rateStr = d.Val()
+		if d.NextArg() {
+			return 0, 0, d.ArgErr()
+		}
+	}
+	if rateStr == "" {
+		return timeout, 0, nil
+	}
+	rate, err := humanize.ParseBytes(rateStr)
+	if err != nil {
+		return 0, 0, d.Errf("parsing minimum rate: %v", err)
+	}
+	return timeout, int64(rate), nil
+}
+
+// Interface guard
+var _ caddyfile.Unmarshaler = (*Timeouts)(nil)
