+package timeouts
+
+import (
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func init() {
+	caddy.RegisterModule(Timeouts{})
+}
+
+// Timeouts applies idle-based read and write deadlines to the requests
+// it handles. Unlike a hard timeout, which bounds a whole transfer, the
+// deadlines here are reset every time the request body yields bytes or
+// the response writer accepts them: a client that keeps making progress
+// is left alone, while one that stalls is cut off. A minimum transfer
+// rate can be required as well, which also catches clients that trickle
+// along without ever quite going idle.
+//
+// EXPERIMENTAL: Subject to change or removal.
+type Timeouts struct {
+	// How long a single read from the request body may take before
+	// the client is considered stalled. The deadline is reset on
+	// every read that returns bytes. If zero, reads are not subject
+	// to a deadline, unless read_min_rate is set, in which case the
+	// default idle window of 1m applies.
+	ReadTimeout time.Duration `json:"read_timeout,omitempty"`
+
+	// The minimum rate, in bytes per second, at which the request
+	// body must be received. Every received byte extends the
+	// allowance by 1/rate seconds, so a client that sustains the
+	// rate is never cut off, while one that stays below it is, even
+	// if it never goes idle. If zero, no minimum rate is required.
+	ReadMinRate int64 `json:"read_min_rate,omitempty"`
+
+	// How long a single write to the client may take before the
+	// client is considered stalled. The deadline is reset on every
+	// write that completes. If zero, writes are not subject to a
+	// deadline, unless write_min_rate is set, in which case the
+	// default idle window of 1m applies. On HTTP/2 and HTTP/3 the
+	// deadline is a stream-level timer, so a response that goes
+	// quiet for longer than this is cut off even between writes.
+	WriteTimeout time.Duration `json:"write_timeout,omitempty"`
+
+	// The minimum rate, in bytes per second, at which the response
+	// must be consumed; the counterpart of read_min_rate. If zero,
+	// no minimum rate is required.
+	WriteMinRate int64 `json:"write_min_rate,omitempty"`
+
+	// The maximum number of bytes to write to the client between
+	// two write deadline resets. Since a deadline bounds the whole
+	// write it precedes, large payloads are split into chunks of
+	// this size so the deadline measures progress instead of total
+	// response size. Default: 64KiB.
+	MaxWriteChunk int `json:"max_write_chunk,omitempty"`
+
+	logger *zap.Logger
+}
+
+// CaddyModule returns the Caddy module information.
+func (Timeouts) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{
+		ID:  "http.handlers.timeouts",
+		New: func() caddy.Module { return new(Timeouts) },
+	}
+}
+
+// Provision sets up the handler.
+func (t *Timeouts) Provision(ctx caddy.Context) error {
+	t.logger = ctx.Logger()
+	return nil
+}
+
+func (t Timeouts) ServeHTTP(w http.ResponseWriter, r *http.Request, next caddyhttp.Handler) error {
+	readEnabled := t.ReadTimeout > 0 || t.ReadMinRate > 0
+	writeEnabled := t.WriteTimeout > 0 || t.WriteMinRate > 0
+	if !readEnabled && !writeEnabled {
+		return next.ServeHTTP(w, r)
+	}
+
+	start := time.Now()
+	//nolint:bodyclose
+	ctrl := http.NewResponseController(w)
+
+	if readEnabled && r.Body != nil && r.Body != http.NoBody {
+		r.Body = &caddyhttp.IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       ctrl,
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   start,
+				Timeout: idleWindow(t.ReadTimeout),
+				MinRate: t.ReadMinRate,
+			},
+			Logger: t.logger,
+		}
+	}
+
+	if writeEnabled {
+		w = &caddyhttp.IdleTimeoutWriter{
+			ResponseWriterWrapper: &caddyhttp.ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  ctrl,
+			Deadline: caddyhttp.IdleDeadline{
+				Start:   start,
+				Timeout: idleWindow(t.WriteTimeout),
+				MinRate: t.WriteMinRate,
+			},
+			MaxChunk: t.MaxWriteChunk,
+			Logger:   t.logger,
+		}
+	}
+
+	return next.ServeHTTP(w, r)
+}
+
+// idleWindow returns the idle timeout to use, falling back to the
+// default when deadlines were enabled by a minimum rate alone.
+func idleWindow(configured time.Duration) time.Duration {
+	if configured <= 0 {
+		return caddyhttp.DefaultIdleTimeout
+	}
+	return configured
+}
+
+// Interface guards
+var (
+	_ caddy.Provisioner           = (*Timeouts)(nil)
+	_ caddyhttp.MiddlewareHandler = (*Timeouts)(nil)
+)
