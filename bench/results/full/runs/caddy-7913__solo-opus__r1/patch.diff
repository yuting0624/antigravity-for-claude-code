+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package caddyhttp
+
+import (
+	"bufio"
+	"errors"
+	"io"
+	"math"
+	"net"
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+)
+
+// DefaultMaxWriteChunk is the maximum number of bytes handed to the
+// underlying writer between two write deadline resets, unless
+// overridden. A deadline bounds the whole operation it precedes, not
+// just a stall within it, so writes have to be split up for the
+// deadline to be a meaningful measure of progress rather than of total
+// transfer size.
+const DefaultMaxWriteChunk = 64 * 1024
+
+// DefaultIdleTimeout is the idle window used when idle-based deadlines
+// are enabled by configuring a minimum transfer rate, but no idle
+// timeout was given explicitly.
+const DefaultIdleTimeout = time.Minute
+
+// IdleDeadline describes a deadline which is reset as a transfer makes
+// progress, so that a connection is cut when it stalls or falls below a
+// minimum rate, rather than when it simply takes a long time.
+//
+// EXPERIMENTAL: Subject to change or removal.
+type IdleDeadline struct {
+	// Start is when the transfer began; it is the origin from which
+	// the MinRate allowance grows. If zero, the time at which the
+	// first deadline is computed is used instead.
+	Start time.Time
+
+	// Timeout is how long a single read or write may take before the
+	// transfer is considered stalled. It is applied afresh to every
+	// operation, i.e. it is reset whenever progress is made. If zero,
+	// no idle deadline is imposed.
+	Timeout time.Duration
+
+	// MinRate, if greater than zero, is the minimum transfer rate in
+	// bytes per second. Every transferred byte extends the allowed
+	// deadline (measured from Start) by 1/MinRate seconds, so a
+	// transfer that sustains the rate is never cut off, while one
+	// that trickles along below it is, even if it never goes idle.
+	MinRate int64
+
+	// HardDeadline, if not zero, is an absolute ceiling that the
+	// idle-reset deadline is never allowed to push past.
+	HardDeadline time.Time
+}
+
+// deadline returns the deadline to impose on the operation starting at
+// now, given the number of bytes transferred so far, and whether any
+// deadline applies at all.
+func (d IdleDeadline) deadline(now time.Time, transferred int64) (time.Time, bool) {
+	var dl time.Time
+
+	// the idle window: every operation gets the full timeout again
+	if d.Timeout > 0 {
+		dl = now.Add(d.Timeout)
+	}
+
+	// the rate allowance grows from a fixed start with the bytes
+	// transferred so far, so a transfer that never sustains the
+	// rate runs out of allowance even if it never goes idle
+	if d.MinRate > 0 {
+		start := d.Start
+		if start.IsZero() {
+			start = now
+		}
+		allowed := start.Add(d.Timeout + creditFor(transferred, d.MinRate))
+		if dl.IsZero() || allowed.Before(dl) {
+			dl = allowed
+		}
+	}
+
+	// an explicit hard deadline always wins; resetting the deadline
+	// as progress is made must never extend a transfer past it
+	if !d.HardDeadline.IsZero() && (dl.IsZero() || d.HardDeadline.Before(dl)) {
+		dl = d.HardDeadline
+	}
+
+	return dl, !dl.IsZero()
+}
+
+// creditFor returns how much time transferring the given number of
+// bytes earns at rate bytes per second.
+func creditFor(transferred, rate int64) time.Duration {
+	seconds := float64(transferred) / float64(rate)
+	if seconds >= float64(math.MaxInt64)/float64(time.Second) {
+		return time.Duration(math.MaxInt64)
+	}
+	return time.Duration(seconds * float64(time.Second))
+}
+
+// IdleTimeoutReader wraps a request body so that the read deadline is
+// reset every time bytes are received. A client which keeps sending is
+// allowed to take as long as it needs (subject to the deadline's
+// MinRate and HardDeadline), but one that stalls is cut off.
+//
+// EXPERIMENTAL: Subject to change or removal.
+type IdleTimeoutReader struct {
+	io.ReadCloser
+
+	// Ctrl is the response controller of the request being served;
+	// it is how read deadlines reach the underlying connection,
+	// whatever protocol it speaks.
+	Ctrl *http.ResponseController
+
+	// Deadline describes the deadline to impose on each read.
+	Deadline IdleDeadline
+
+	// Logger is used to report deadlines that could not be set.
+	Logger *zap.Logger
+
+	read        int64
+	unsupported bool
+}
+
+// Read implements io.Reader.
+func (itr *IdleTimeoutReader) Read(p []byte) (int, error) {
+	if dl, ok := itr.Deadline.deadline(time.Now(), itr.read); ok && !itr.unsupported {
+		if err := itr.Ctrl.SetReadDeadline(dl); err != nil {
+			itr.unsupported = errors.Is(err, http.ErrNotSupported)
+			logDeadlineError(itr.Logger, "could not set read deadline", err)
+		}
+	}
+	n, err := itr.ReadCloser.Read(p)
+	itr.read += int64(n)
+	return n, err
+}
+
+// IdleTimeoutWriter wraps a response writer so that the write deadline
+// is reset every time bytes are handed to the client. Large payloads
+// are written in chunks of at most MaxChunk bytes, since a deadline
+// bounds the entire write it precedes: without chunking, a single big
+// write would have to fit in one deadline window no matter how well
+// the client keeps up.
+//
+// EXPERIMENTAL: Subject to change or removal.
+type IdleTimeoutWriter struct {
+	*ResponseWriterWrapper
+
+	// Ctrl is the response controller of the request being served;
+	// it is how write deadlines reach the underlying connection,
+	// whatever protocol it speaks.
+	Ctrl *http.ResponseController
+
+	// Deadline describes the deadline to impose on each write.
+	Deadline IdleDeadline
+
+	// MaxChunk is the maximum number of bytes to write between two
+	// deadline resets. If zero, DefaultMaxWriteChunk is used.
+	MaxChunk int
+
+	// Logger is used to report deadlines that could not be set.
+	Logger *zap.Logger
+
+	written     int64
+	unsupported bool
+}
+
+// WriteHeader implements http.ResponseWriter. The header is written to
+// the client like any other bytes, so it gets a deadline too; a
+// response consisting of nothing but a header would otherwise be sent
+// under whatever deadline was left over on the connection.
+func (itw *IdleTimeoutWriter) WriteHeader(statusCode int) {
+	itw.setDeadline()
+	itw.ResponseWriterWrapper.WriteHeader(statusCode)
+}
+
+// FlushError implements the FlushError method that
+// http.ResponseController looks for, resetting the deadline first,
+// since flushing is what actually hands buffered bytes to the client.
+func (itw *IdleTimeoutWriter) FlushError() error {
+	itw.setDeadline()
+	//nolint:bodyclose
+	return itw.Ctrl.Flush()
+}
+
+// Hijack implements http.Hijacker. Once the connection is taken over,
+// this writer no longer mediates its writes, so the deadline it last
+// set would fire at an arbitrary point in the new owner's lifetime
+// (a websocket, typically); it is therefore rolled back to the hard
+// deadline, which is what the connection would have had without any
+// idle-based deadlines. A zero hard deadline means no deadline.
+func (itw *IdleTimeoutWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	if !itw.unsupported {
+		if err := itw.Ctrl.SetWriteDeadline(itw.Deadline.HardDeadline); err != nil {
+			logDeadlineError(itw.Logger, "could not clear write deadline for hijacked connection", err)
+		}
+	}
+	//nolint:bodyclose
+	return itw.Ctrl.Hijack()
+}
+
+// Write implements io.Writer, splitting p into chunks of at most
+// MaxChunk bytes and resetting the write deadline before each one.
+func (itw *IdleTimeoutWriter) Write(p []byte) (int, error) {
+	maxChunk := itw.maxChunk()
+	var written int
+	for {
+		chunk := p[written:]
+		if len(chunk) > maxChunk {
+			chunk = chunk[:maxChunk]
+		}
+		itw.setDeadline()
+		n, err := itw.ResponseWriterWrapper.Write(chunk)
+		written += n
+		itw.written += int64(n)
+		if err != nil {
+			return written, err
+		}
+		if n < len(chunk) {
+			return written, io.ErrShortWrite
+		}
+		if written >= len(p) {
+			return written, nil
+		}
+	}
+}
+
+// ReadFrom implements io.ReaderFrom, copying at most MaxChunk bytes
+// per underlying operation and resetting the write deadline before
+// each one, so that the ReadFrom fast path cannot outrun a deadline.
+func (itw *IdleTimeoutWriter) ReadFrom(r io.Reader) (int64, error) {
+	maxChunk := int64(itw.maxChunk())
+	var written int64
+	for {
+		itw.setDeadline()
+		n, err := itw.ResponseWriterWrapper.ReadFrom(io.LimitReader(r, maxChunk))
+		written += n
+		itw.written += n
+		if err != nil {
+			return written, err
+		}
+		if n < maxChunk {
+			// the source is drained
+			return written, nil
+		}
+	}
+}
+
+func (itw *IdleTimeoutWriter) maxChunk() int {
+	if itw.MaxChunk > 0 {
+		return itw.MaxChunk
+	}
+	return DefaultMaxWriteChunk
+}
+
+func (itw *IdleTimeoutWriter) setDeadline() {
+	if itw.unsupported {
+		return
+	}
+	dl, ok := itw.Deadline.deadline(time.Now(), itw.written)
+	if !ok {
+		return
+	}
+	if err := itw.Ctrl.SetWriteDeadline(dl); err != nil {
+		itw.unsupported = errors.Is(err, http.ErrNotSupported)
+		logDeadlineError(itw.Logger, "could not set write deadline", err)
+	}
+}
+
+// logDeadlineError logs a deadline that could not be set; a protocol
+// that has no notion of deadlines is not the operator's fault, so it
+// is only worth a debug entry.
+func logDeadlineError(logger *zap.Logger, msg string, err error) {
+	if logger == nil {
+		return
+	}
+	level := zapcore.ErrorLevel
+	if errors.Is(err, http.ErrNotSupported) {
+		level = zapcore.DebugLevel
+	}
+	if c := logger.Check(level, msg); c != nil {
+		c.Write(zap.Error(err))
+	}
+}
+
+// Interface guards
+var (
+	_ io.ReadCloser       = (*IdleTimeoutReader)(nil)
+	_ http.ResponseWriter = (*IdleTimeoutWriter)(nil)
+	_ io.ReaderFrom       = (*IdleTimeoutWriter)(nil)
+	_ http.Hijacker       = (*IdleTimeoutWriter)(nil)
+)
