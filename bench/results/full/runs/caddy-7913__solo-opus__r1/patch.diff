+// applyIdleTimeouts wraps the request body and the response writer so
+// that the read and write deadlines are reset as the transfer makes
+// progress, rather than bounding it as a whole the way ReadTimeout and
+// WriteTimeout do. Those hard timeouts, when configured, are still
+// enforced as ceilings the idle resets may not push past; they are
+// measured from start, when this request began being served. The
+// (possibly wrapped) response writer to use is returned.
+func (s *Server) applyIdleTimeouts(w http.ResponseWriter, r *http.Request, start time.Time) http.ResponseWriter {
+	readEnabled := s.ReadIdleTimeout > 0 || s.ReadMinRate > 0
+	writeEnabled := s.WriteIdleTimeout > 0 || s.WriteMinRate > 0
+	if !readEnabled && !writeEnabled {
+		return w
+	}
+
+	//nolint:bodyclose
+	ctrl := http.NewResponseController(w)
+
+	if readEnabled && r.Body != nil && r.Body != http.NoBody {
+		var hard time.Time
+		if s.ReadTimeout > 0 {
+			hard = start.Add(time.Duration(s.ReadTimeout))
+		}
+		r.Body = &IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       ctrl,
+			Deadline: IdleDeadline{
+				Start:        start,
+				Timeout:      idleWindow(s.ReadIdleTimeout),
+				MinRate:      s.ReadMinRate,
+				HardDeadline: hard,
+			},
+			Logger: s.logger,
+		}
+	}
+
+	if writeEnabled {
+		var hard time.Time
+		if s.WriteTimeout > 0 {
+			hard = start.Add(time.Duration(s.WriteTimeout))
+		}
+		itw := &IdleTimeoutWriter{
+			ResponseWriterWrapper: &ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  ctrl,
+			Deadline: IdleDeadline{
+				Start:        start,
+				Timeout:      idleWindow(s.WriteIdleTimeout),
+				MinRate:      s.WriteMinRate,
+				HardDeadline: hard,
+			},
+			MaxChunk: s.MaxWriteChunk,
+			Logger:   s.logger,
+		}
