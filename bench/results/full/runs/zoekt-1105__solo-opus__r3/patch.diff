+// limitations under the License.
+
+package main
+
+import (
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+// repository is a git repository found underneath one of the roots.
+type repository struct {
+	// Name is the path of the repository relative to the root it was found
+	// in, with any ".git" suffix removed. It is the name the repository is
+	// indexed under.
+	Name string
+
+	// Path is the absolute path of the repository on disk.
+	Path string
+}
+
+// discoverRepositories returns the git repositories underneath the given
+// roots, sorted by name. A root that is itself a repository is returned as a
+// single repository named after the root directory.
+//
+// Repository names have to be unique, since they identify a repository in the
+// index, so it is an error for two repositories to map onto the same name.
+func discoverRepositories(roots []string) ([]repository, error) {
+	var repositories []repository
+	seen := map[string]string{}
+
+	for _, root := range roots {
+		root, err := filepath.Abs(root)
+		if err != nil {
+			return nil, err
+		}
+
+		err = filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			if !d.IsDir() || !isGitRepository(path) {
+				return nil
+			}
+
+			name, err := repositoryName(root, path)
+			if err != nil {
+				return err
+			}
+			if other, ok := seen[name]; ok {
+				return fmt.Errorf("duplicate repository name %q for %s and %s", name, other, path)
+			}
+			seen[name] = path
+			repositories = append(repositories, repository{Name: name, Path: path})
+
+			// Repositories are not nested, and the contents of a repository
+			// (its objects, its submodules) are not repositories we want to
+			// index on their own.
+			return fs.SkipDir
+		})
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	sort.Slice(repositories, func(i, j int) bool {
+		return repositories[i].Name < repositories[j].Name
+	})
+
+	return repositories, nil
+}
+
+// repositoryName derives the name to index dir under from its path relative
+// to root. A root that is itself a repository is named after its directory.
+func repositoryName(root, dir string) (string, error) {
+	rel, err := filepath.Rel(root, dir)
+	if err != nil {
+		return "", err
+	}
+	if rel == "." {
+		rel = filepath.Base(dir)
+	}
+
+	name := filepath.ToSlash(rel)
+	if trimmed := strings.TrimSuffix(name, ".git"); trimmed != "" {
+		name = trimmed
+	}
+
+	return name, nil
+}
+
+// isGitRepository reports whether dir holds a git repository: either a
+// worktree, which has a .git entry, or a bare repository, which has the
+// object database at its top level.
+func isGitRepository(dir string) bool {
+	if _, err := os.Lstat(filepath.Join(dir, ".git")); err == nil {
+		return true
+	}
+
+	fi, err := os.Stat(filepath.Join(dir, "objects"))
+	return err == nil && fi.IsDir()
+}
