+// TestSyncDetectsNewCommits checks that the preview notices a repository that
+// has moved on since it was indexed, and leaves the other ones alone.
+func TestSyncDetectsNewCommits(t *testing.T) {
+	root := t.TempDir()
+	changing := filepath.Join(root, "team", "changing")
+	createGitRepository(t, changing)
+	createGitRepository(t, filepath.Join(root, "steady"))
+	indexDir := t.TempDir()
+
+	args := []string{"-index", indexDir, "-disable_ctags", "-submodules=false", root}
+	if err := execute(append([]string{"-f"}, args...), &bytes.Buffer{}, &bytes.Buffer{}); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := os.WriteFile(filepath.Join(changing, "second.md"), []byte("more\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	runGit(t, changing, "add", ".")
+	runGit(t, changing, "commit", "-m", "second commit")
+
+	var out bytes.Buffer
+	if err := execute(args, &out, &bytes.Buffer{}); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(out.String(), `Would index "team/changing"`) {
+		t.Fatalf("preview did not report the changed repository:\n%s", out.String())
+	}
+	if !strings.Contains(out.String(), `Up to date "steady"`) {
+		t.Fatalf("preview did not report the unchanged repository as up to date:\n%s", out.String())
+	}
+
+	out.Reset()
+	if err := execute(append([]string{"-f"}, args...), &out, &bytes.Buffer{}); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(out.String(), `Indexed "team/changing"`) {
+		t.Fatalf("sync did not re-index the changed repository:\n%s", out.String())
+	}
+}
+
+// TestSyncHoldsTheIndexDirectoryLock checks that applying a plan takes the
+// index directory lock, so that two syncs cannot interleave their writes.
+func TestSyncHoldsTheIndexDirectoryLock(t *testing.T) {
+	root := t.TempDir()
+	createGitRepository(t, filepath.Join(root, "repo"))
+	indexDir := t.TempDir()
+
+	lock, err := acquireDirectoryLock(indexDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lock.Close()
+
+	err = execute([]string{"-index", indexDir, "-disable_ctags", "-submodules=false", "-f", root}, &bytes.Buffer{}, &bytes.Buffer{})
+	if err == nil {
+		t.Fatal("sync wrote to a locked index directory")
+	}
+
+	// A preview does not write, so it does not need the lock.
+	if err := execute([]string{"-index", indexDir, "-disable_ctags", "-submodules=false", root}, &bytes.Buffer{}, &bytes.Buffer{}); err != nil {
+		t.Fatal(err)
+	}
+}
