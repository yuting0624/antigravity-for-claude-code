+// trimPathSuffix is like strings.TrimSuffix, but customized for URI path suffix
+// matching. The string suffix will be trimmed from the end of escapedPath if
+// escapedPath ends with suffix. Both strings are iterated in lock-step from the
+// end; if the suffix has a '%' escape at a position, escapedPath must literally
+// use the same escape there; otherwise comparisons happen in normalized/unescaped
+// space. Comparisons are case-insensitive.
+func trimPathSuffix(escapedPath, suffix string) string {
+	iPath := len(escapedPath) - 1
+	iSuffix := len(suffix) - 1
+	for iPath >= 0 && iSuffix >= 0 {
+		suffixCh := suffix[iSuffix]
+		ch := string(escapedPath[iPath])
+
+		// if the path has a percent-encoded byte ending at this position and
+		// the suffix does not itself spell out an escape here, decode it so
+		// the comparison happens in normalized space
+		if iPath >= 2 && escapedPath[iPath-2] == '%' && !(iSuffix >= 2 && suffix[iSuffix-2] == '%') {
+			var err error
+			ch, err = url.PathUnescape(escapedPath[iPath-2 : iPath+1])
+			if err != nil {
+				// should be impossible unless EscapedPath() is returning invalid values!
+				return escapedPath
+			}
+			iPath -= 2
+		}
+
+		// comparisons are case-insensitive for consistency with the path matcher
+		if !strings.EqualFold(ch, string(suffixCh)) {
+			return escapedPath
+		}
+
+		iPath--
+		iSuffix--
 	}
-	return string(r)
+
+	// if we iterated through the entire suffix, we found it, so trim it
+	if iSuffix < 0 {
+		return escapedPath[:iPath+1]
+	}
+
+	// otherwise we did not find the suffix
+	return escapedPath
 }
 
