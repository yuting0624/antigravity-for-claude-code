+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"path/filepath"
+	"strings"
+
+	"github.com/sourcegraph/zoekt/index"
+	"github.com/sourcegraph/zoekt/internal/ctags"
+)
+
+// syncFlags holds the options of the sync command.
+type syncFlags struct {
+	build        index.Options
+	branches     string
+	branchPrefix string
+	submodules   bool
+	incremental  bool
+	allowMissing bool
+	repoCacheDir string
+	languageMap  string
+	force        bool
+}
+
+// newSyncFlagSet returns the flag set of the sync command together with the
+// options it fills in. Its output goes to w.
+func newSyncFlagSet(w io.Writer) (*flag.FlagSet, *syncFlags) {
+	fs := flag.NewFlagSet(programName+" sync", flag.ContinueOnError)
+	fs.SetOutput(w)
+
+	f := &syncFlags{}
+	f.build.IndexDir = index.DefaultDir
+	f.build.Flags(fs)
+
+	fs.StringVar(&f.branches, "branches", "HEAD", "comma separated list of git branches to index.")
+	fs.StringVar(&f.branchPrefix, "prefix", "refs/heads/", "prefix for branch names")
+	fs.BoolVar(&f.submodules, "submodules", true, "if set to false, do not recurse into submodules")
+	fs.BoolVar(&f.incremental, "incremental", true, "only index repositories that changed")
+	fs.BoolVar(&f.allowMissing, "allow_missing_branches", false, "allow missing branches.")
+	fs.StringVar(&f.repoCacheDir, "repo_cache", "", "directory holding bare git repos, used to resolve submodules.")
+	fs.StringVar(&f.languageMap, "language_map", "", "a mapping between a language and its ctags processor (a:0,b:3).")
+	fs.BoolVar(&f.force, "f", false, "apply the plan instead of only reporting it.")
+
+	fs.Usage = func() {
+		fmt.Fprintf(fs.Output(), "Usage: %s [options] <root directory>...\n\nOptions:\n", fs.Name())
+		fs.PrintDefaults()
+	}
+
+	return fs, f
+}
+
+// finish applies the defaults of the build options and derives the values
+// that the indexer needs from the raw flags. It must be called once after
+// the flag set has been parsed.
+func (f *syncFlags) finish() error {
+	f.build.SetDefaults()
+	if f.build.IndexDir == "" {
+		return errors.New("no index directory; pass -index")
+	}
+	f.build.LanguageMap = make(ctags.LanguageMap)
+	for mapping := range strings.SplitSeq(f.languageMap, ",") {
+		parts := strings.Split(mapping, ":")
+		if len(parts) != 2 {
+			continue
+		}
+		f.build.LanguageMap[parts[0]] = ctags.StringToParser(parts[1])
+	}
+	if f.repoCacheDir != "" {
+		dir, err := filepath.Abs(f.repoCacheDir)
+		if err != nil {
+			return err
+		}
+		f.repoCacheDir = dir
+	}
+	return nil
+}
+
+// branchList returns the branches to index.
+func (f *syncFlags) branchList() []string {
+	if f.branches == "" {
+		return nil
+	}
+	return strings.Split(f.branches, ",")
+}
