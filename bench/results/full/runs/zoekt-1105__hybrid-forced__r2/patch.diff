+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"text/tabwriter"
+
+	"github.com/sourcegraph/zoekt/index"
+)
+
+// runList prints the repositories currently present in the index.
+func runList(args []string, out, errOut io.Writer) error {
+	fs := flag.NewFlagSet(programName+" list", flag.ContinueOnError)
+	fs.SetOutput(errOut)
+	indexDir := fs.String("index", index.DefaultDir, "directory for search indices")
+	fs.Usage = func() {
+		fmt.Fprintf(fs.Output(), "Usage: %s [options]\n\nPrints the repositories currently present in the index.\n\nOptions:\n", fs.Name())
+		fs.PrintDefaults()
+	}
+
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	if fs.NArg() > 0 {
+		fs.Usage()
+		return fmt.Errorf("%s list: unexpected argument %q", programName, fs.Arg(0))
+	}
+
+	shards, err := readInventory(*indexDir)
+	if err != nil {
+		return err
+	}
+	records := recordsFromShards(shards)
+
+	w := tabwriter.NewWriter(out, 0, 0, 2, ' ', 0)
+	fmt.Fprintln(w, "NAME\tSOURCE\tSHARDS")
+	for _, rec := range records {
+		fmt.Fprintf(w, "%s\t%s\t%s\n", rec.Name, rec.Source, strings.Join(rec.Shards, " "))
+	}
+	return w.Flush()
+}
+
+// runRemove reports, or with -f applies, the removal of repositories from
+// the index.
+func runRemove(args []string, out, errOut io.Writer) error {
+	fs := flag.NewFlagSet(programName+" remove", flag.ContinueOnError)
+	fs.SetOutput(errOut)
+	indexDir := fs.String("index", index.DefaultDir, "directory for search indices")
+	force := fs.Bool("f", false, "apply the plan instead of only reporting it.")
+	fs.Usage = func() {
+		fmt.Fprintf(fs.Output(), "Usage: %s [options] <repository or path>...\n\nRemoves the named repositories from the index. A repository is named either\nby its name in the index or by the path it was indexed from.\n\nOptions:\n", fs.Name())
+		fs.PrintDefaults()
+	}
+
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	names := fs.Args()
+	if len(names) == 0 {
+		fs.Usage()
+		return fmt.Errorf("%s remove: need at least one repository name or path", programName)
+	}
+
+	shards, err := readInventory(*indexDir)
+	if err != nil {
+		return err
+	}
+	records := recordsFromShards(shards)
+
+	var selected []record
+	selectedIndices := make(map[int]bool)
+	for _, name := range names {
+		absName, absErr := filepath.Abs(name)
+		var matched bool
+		for i, rec := range records {
+			if rec.Name == name || rec.Source == name || (absErr == nil && rec.Source == absName) {
+				matched = true
+				if !selectedIndices[i] {
+					selectedIndices[i] = true
+					selected = append(selected, rec)
+				}
+			}
+		}
+		if !matched {
+			return fmt.Errorf("no indexed repository matches %q", name)
+		}
+	}
+
+	// A dry run must write nothing, so acquiring the lock only happens when force is true.
+	if *force {
+		lock, err := acquireDirectoryLock(*indexDir)
+		if err != nil {
+			return err
+		}
+		defer lock.Close()
+	}
+
+	var errs []error
+	for _, rec := range selected {
+		paths, err := rec.files()
+		if err != nil {
+			errs = append(errs, err)
+			continue
+		}
+		for _, path := range paths {
+			if !*force {
+				fmt.Fprintf(out, "Would remove %s\n", path)
+			} else if err := os.Remove(path); err != nil {
+				errs = append(errs, err)
+			} else {
+				fmt.Fprintf(out, "Removed %s\n", path)
+			}
+		}
+	}
+
+	if !*force {
+		fmt.Fprintf(out, "\nPass -f to apply these changes.\n")
+	}
+
+	return errors.Join(errs...)
+}
