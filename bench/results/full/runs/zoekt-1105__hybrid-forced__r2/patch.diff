+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"github.com/sourcegraph/zoekt"
+	"github.com/sourcegraph/zoekt/index"
+)
+
+// record describes one repository present in an index directory.
+type record struct {
+	// Name is the repository name stored in the shard metadata.
+	Name string
+	// Source is the path the repository was indexed from.
+	Source string
+	// Shards are the shard files that hold the repository.
+	Shards []string
+	// Repository is the metadata read from the first shard holding it.
+	Repository *zoekt.Repository
+}
+
+// readInventory returns the paths of the shards in indexDir, sorted.
+func readInventory(indexDir string) ([]string, error) {
+	shards, err := filepath.Glob(filepath.Join(indexDir, "*.zoekt"))
+	if err != nil {
+		return nil, err
+	}
+	slices.Sort(shards)
+	return shards, nil
+}
+
+// recordsFromShards groups shards by the repositories they hold. Shards
+// that cannot be read are skipped. The result is sorted by name.
+func recordsFromShards(shards []string) []record {
+	records := make(map[string]*record)
+	for _, shard := range shards {
+		repos, _, err := index.ReadMetadataPathAlive(shard)
+		if err != nil {
+			continue
+		}
+		for _, repo := range repos {
+			r, ok := records[repo.Name]
+			if !ok {
+				r = &record{
+					Name:       repo.Name,
+					Source:     repo.Source,
+					Repository: repo,
+				}
+				records[repo.Name] = r
+			}
+			r.Shards = append(r.Shards, shard)
+		}
+	}
+
+	result := make([]record, 0, len(records))
+	for _, r := range records {
+		result = append(result, *r)
+	}
+	slices.SortFunc(result, func(a, b record) int {
+		return strings.Compare(a.Name, b.Name)
+	})
+	return result
+}
+
+// files returns the files of r that exist on disk: every shard together
+// with its optional .meta sidecar.
+func (r record) files() ([]string, error) {
+	var files []string
+	for _, shard := range r.Shards {
+		paths, err := index.IndexFilePaths(shard)
+		if err != nil {
+			return nil, err
+		}
+		files = append(files, paths...)
+	}
+	return files, nil
+}
diff --git a/cmd/zoekt-local-sync/main.go b/cmd/zoekt-local-sync/main.go
new file mode 100644
index 00000000..117aaafe
--- /dev/null
+++ b/cmd/zoekt-local-sync/main.go
@@ -0,0 +1,136 @@
+// Copyright 2026 Sourcegraph, Inc. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Command zoekt-local-sync keeps a zoekt index in sync with the git
+// repositories found under one or more directories on the local machine. By
+// default it only reports what it would do; pass -f to apply the plan.
+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+
+	"go.uber.org/automaxprocs/maxprocs"
+)
+
+const programName = "zoekt-local-sync"
+
+func main() {
+	// Tune GOMAXPROCS to match Linux container CPU quota.
+	_, _ = maxprocs.Set()
+
+	err := execute(os.Args[1:], os.Stdout, os.Stderr)
+	if err == nil {
+		return
+	}
+	if errors.Is(err, flag.ErrHelp) {
+		os.Exit(2)
+	}
+	fmt.Fprintf(os.Stderr, "%s: %v\n", programName, err)
+	os.Exit(1)
+}
+
+// execute runs the command line in args, writing normal output to out and
+// diagnostics to errOut.
+func execute(args []string, out, errOut io.Writer) error {
+	if len(args) > 0 {
+		switch args[0] {
+		case "help", "-h", "--help", "-help":
+			writeUsage(out)
+			return nil
+		case "list":
+			return runList(args[1:], out, errOut)
+		case "remove":
+			return runRemove(args[1:], out, errOut)
+		case "sync":
+			return runSync(args[1:], out, errOut)
+		}
+	}
+	return runSync(args, out, errOut)
+}
+
+// writeUsage prints the top-level usage message to out.
+func writeUsage(out io.Writer) {
+	fmt.Fprintf(out, `%[1]s keeps a zoekt index in sync with the git repositories found under one
+or more directories on this machine.
+
+Usage:
+  %[1]s [options] <root directory>...
+  %[1]s sync [options] <root directory>...
+  %[1]s list [options]
+  %[1]s remove [options] <repository or path>...
+
+Commands:
+  sync    index the repositories found under the given roots and prune the
+          shards of repositories that are no longer under any of them. This
+          is also what %[1]s does when no command is given.
+  list    print the repositories currently present in the index.
+  remove  drop the named repositories from the index.
+
+Every command only reports what it would do. Pass -f to apply the changes.
+
+Default sync options:
+
+`, programName)
+	fs, _ := newSyncFlagSet(out)
+	fs.PrintDefaults()
+	fmt.Fprintf(out, `
+Run "%[1]s sync -h" for the sync options.
+Run "%[1]s list -h" for the list options.
+Run "%[1]s remove -h" for the remove options.
+`, programName)
+}
+
+// directoryLock is an exclusive lock on an index directory. It keeps two
+// concurrent runs from interleaving writes to the same shards.
+type directoryLock struct {
+	path string
+	file *os.File
+}
+
+// lockFileName is the name of the lock file inside an index directory.
+const lockFileName = ".zoekt-local-sync.lock"
+
+// acquireDirectoryLock takes the exclusive lock of indexDir. It fails when
+// another run already holds it.
+func acquireDirectoryLock(indexDir string) (*directoryLock, error) {
+	path := filepath.Join(indexDir, lockFileName)
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)
+	if err != nil {
+		if os.IsExist(err) {
+			return nil, fmt.Errorf("index directory %s is locked by %s; remove that file if no other %s is running: %w", indexDir, path, programName, err)
+		}
+		return nil, err
+	}
+	if _, err := fmt.Fprintf(file, "%d\n", os.Getpid()); err != nil {
+		file.Close()
+		os.Remove(path)
+		return nil, err
+	}
+	return &directoryLock{path: path, file: file}, nil
+}
+
+// Close releases the lock and removes the lock file.
+func (l *directoryLock) Close() error {
+	err := l.file.Close()
+	rmErr := os.Remove(l.path)
+	if err == nil {
+		err = rmErr
+	}
+	return err
+}
