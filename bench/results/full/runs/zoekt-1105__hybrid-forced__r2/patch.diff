+// limitations under the License.
+
+package main
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	gogit "github.com/go-git/go-git/v5"
+	"github.com/go-git/go-git/v5/plumbing"
+	"github.com/sourcegraph/zoekt"
+	"github.com/sourcegraph/zoekt/gitindex"
+	"github.com/sourcegraph/zoekt/index"
+)
+
+// runSync reports, or with -f applies, the plan that brings the index in
+// line with the git repositories found under the given roots.
+func runSync(args []string, out, errOut io.Writer) error {
+	fs, f := newSyncFlagSet(errOut)
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	roots := fs.Args()
+	if len(roots) == 0 {
+		fs.Usage()
+		return fmt.Errorf("%s: need at least one root directory", programName)
+	}
+
+	repos, err := discoverRepositories(roots)
+	if err != nil {
+		return err
+	}
+
+	if err := f.finish(); err != nil {
+		return err
+	}
+	branches := f.branchList()
+
+	// A dry run must create nothing, so neither MkdirAll nor acquiring the lock may happen when f.force is false.
+	if f.force {
+		if err := os.MkdirAll(f.build.IndexDir, 0o755); err != nil {
+			return fmt.Errorf("creating index directory: %w", err)
+		}
+		lock, err := acquireDirectoryLock(f.build.IndexDir)
+		if err != nil {
+			return err
+		}
+		defer lock.Close()
+	}
+
+	shards, err := readInventory(f.build.IndexDir)
+	if err != nil {
+		return err
+	}
+	records := recordsFromShards(shards)
+	indexed := make(map[string]record, len(records))
+	for _, rec := range records {
+		indexed[rec.Name] = rec
+	}
+	discovered := make(map[string]struct{}, len(repos))
+	for _, repo := range repos {
+		discovered[repo.Name] = struct{}{}
+	}
+
+	var errs []error
+	for _, repo := range repos {
+		opts := f.build
+		opts.RepositoryDescription = zoekt.Repository{Name: repo.Name}
+		current, cerr := currentBranches(repo.Path, branches, f.branchPrefix)
+		rec, found := indexed[repo.Name]
+		if cerr == nil && found && isUpToDate(rec.Repository, &opts, current) {
+			fmt.Fprintf(out, "Up to date %q\n", repo.Name)
+			continue
+		}
+		if !f.force {
+			fmt.Fprintf(out, "Would index %q from %s\n", repo.Name, repo.Path)
+			continue
+		}
+		fmt.Fprintf(out, "Indexing %q from %s\n", repo.Name, repo.Path)
+		// NameFromRemote stays unset so the name chosen by discovery reaches the shard metadata.
+		updated, err := gitindex.IndexGitRepo(gitindex.Options{
+			RepoDir:            repo.Path,
+			Submodules:         f.submodules,
+			Incremental:        f.incremental,
+			AllowMissingBranch: f.allowMissing,
+			RepoCacheDir:       f.repoCacheDir,
+			BuildOptions:       opts,
+			BranchPrefix:       f.branchPrefix,
+			Branches:           branches,
+		})
+		if err != nil {
+			errs = append(errs, fmt.Errorf("indexing %q: %w", repo.Name, err))
+			fmt.Fprintf(errOut, "%s: indexing %q: %v\n", programName, repo.Name, err)
+			continue
+		}
+		if updated {
+			fmt.Fprintf(out, "Indexed %q\n", repo.Name)
+		} else {
+			fmt.Fprintf(out, "Up to date %q\n", repo.Name)
+		}
+	}
+
+	for _, rec := range records {
+		if _, ok := discovered[rec.Name]; ok {
+			continue
+		}
+		paths, err := rec.files()
+		if err != nil {
+			errs = append(errs, err)
+			continue
+		}
+		for _, path := range paths {
+			if !f.force {
+				fmt.Fprintf(out, "Would remove %s\n", path)
+			} else if err := os.Remove(path); err != nil {
+				errs = append(errs, err)
+			} else {
+				fmt.Fprintf(out, "Removed %s\n", path)
+			}
+		}
+	}
+
+	if !f.force {
+		fmt.Fprintf(out, "\nPass -f to apply these changes.\n")
+	}
+
+	return errors.Join(errs...)
+}
+
+// currentBranches resolves the current heads of branches in the git
+// repository at dir.
+func currentBranches(dir string, branches []string, branchPrefix string) ([]zoekt.RepositoryBranch, error) {
+	repo, err := gogit.PlainOpenWithOptions(dir, &gogit.PlainOpenOptions{EnableDotGitCommonDir: true})
+	if errors.Is(err, gogit.ErrRepositoryNotExists) {
+		repo, err = gogit.PlainOpenWithOptions(dir, &gogit.PlainOpenOptions{
+			DetectDotGit:          true,
+			EnableDotGitCommonDir: true,
+		})
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	var result []zoekt.RepositoryBranch
+	for _, b := range branches {
+		if strings.Contains(b, "*") {
+			return nil, errors.New("branch patterns cannot be compared")
+		}
+		hash, err := repo.ResolveRevision(plumbing.Revision(b))
+		if err != nil {
+			hash, err = repo.ResolveRevision(plumbing.Revision(filepath.Join(branchPrefix, b)))
+			if err != nil {
+				return nil, err
+			}
+		}
+		result = append(result, zoekt.RepositoryBranch{
+			Name:    b,
+			Version: hash.String(),
+		})
+	}
+	return result, nil
+}
+
+// isUpToDate reports whether the repository already in the index was built
+// from the current branch heads with the same indexing options.
+func isUpToDate(indexed *zoekt.Repository, opts *index.Options, current []zoekt.RepositoryBranch) bool {
+	if indexed == nil {
+		return false
+	}
+	if indexed.IndexOptions != opts.GetHash() {
+		return false
+	}
+	return slices.Equal(indexed.Branches, current)
+}
