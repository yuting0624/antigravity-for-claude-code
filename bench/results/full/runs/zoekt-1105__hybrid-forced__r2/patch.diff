+// limitations under the License.
+
+package main
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+// repository is a git repository discovered under one of the sync roots.
+type repository struct {
+	// Name is the name of the repository in the index, derived from its
+	// path relative to the root it was found under.
+	Name string
+	// Path is the absolute path of the repository on disk: either a
+	// worktree directory or a bare repository directory.
+	Path string
+}
+
+// isGitRepository reports whether dir is a git repository, either a worktree
+// or a bare repository.
+func isGitRepository(dir string) bool {
+	dir = filepath.Clean(dir)
+	if _, err := os.Stat(filepath.Join(dir, ".git")); err == nil {
+		return true
+	}
+	base := filepath.Base(dir)
+	if strings.HasSuffix(base, ".git") && base != ".git" {
+		if fi, err := os.Stat(filepath.Join(dir, "objects")); err == nil && fi.IsDir() {
+			return true
+		}
+	}
+	return false
+}
+
+// discoverRepositories returns the git repositories under roots, sorted by
+// name. A root that is itself a repository is returned as a single
+// repository named after the root directory.
+func discoverRepositories(roots []string) ([]repository, error) {
+	repos := make([]repository, 0)
+	seen := make(map[string]string)
+
+	emit := func(name, path string) error {
+		if firstPath, ok := seen[name]; ok {
+			return fmt.Errorf("duplicate repository name %q: %s and %s", name, firstPath, path)
+		}
+		seen[name] = path
+		repos = append(repos, repository{
+			Name: name,
+			Path: path,
+		})
+		return nil
+	}
+
+	for _, root := range roots {
+		absRoot, err := filepath.Abs(root)
+		if err != nil {
+			return nil, err
+		}
+		absRoot = filepath.Clean(absRoot)
+
+		if _, err := os.Stat(absRoot); err != nil {
+			if errors.Is(err, fs.ErrNotExist) || os.IsNotExist(err) {
+				continue
+			}
+			return nil, err
+		}
+
+		if isGitRepository(absRoot) {
+			name := strings.TrimSuffix(filepath.Base(absRoot), ".git")
+			if err := emit(name, absRoot); err != nil {
+				return nil, err
+			}
+			continue
+		}
+
+		err = filepath.WalkDir(absRoot, func(path string, d fs.DirEntry, err error) error {
+			if err != nil {
+				if d != nil && d.IsDir() {
+					return fs.SkipDir
+				}
+				return nil
+			}
+
+			if !d.IsDir() {
+				return nil
+			}
+
+			if d.Name() == ".git" {
+				return fs.SkipDir
+			}
+
+			if path == absRoot {
+				return nil
+			}
+
+			if isGitRepository(path) {
+				rel, err := filepath.Rel(absRoot, path)
+				if err != nil {
+					return err
+				}
+				name := strings.TrimSuffix(filepath.ToSlash(rel), ".git")
+				if err := emit(name, path); err != nil {
+					return err
+				}
+				return fs.SkipDir
+			}
+
+			return nil
+		})
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	sort.Slice(repos, func(i, j int) bool {
+		return repos[i].Name < repos[j].Name
+	})
+
+	return repos, nil
+}
