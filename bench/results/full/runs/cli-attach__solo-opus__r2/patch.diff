diff --git a/internal/attachments/attach.go b/internal/attachments/attach.go
new file mode 100644
index 000000000..d9f918014
--- /dev/null
+++ b/internal/attachments/attach.go
@@ -0,0 +1,78 @@
+package attachments
+
+import (
+	"context"
+	"strings"
+)
+
+// UploadAndAttach uploads every asset and returns the body they belong in,
+// along with how many of them made it up.
+//
+// An upload cannot be undone, so the body comes back carrying whatever did
+// upload even when the call fails: a caller that has posted nothing yet should
+// write that body rather than orphan the assets. A body is only worth writing
+// when the count is above zero.
+func (u *Uploader) UploadAndAttach(ctx context.Context, markdown string, assets []UserAsset) (string, int, error) {
+	if len(assets) == 0 {
+		return markdown, 0, nil
+	}
+
+	args := make([]attachmentArg, len(assets))
+	for i, a := range assets {
+		args[i] = attachmentArg{
+			Path:            a.Path(),
+			Alt:             a.getAsset().alt,
+			RendersAsPlayer: a.rendersAsPlayer(),
+		}
+	}
+
+	// Markdown the assets cannot be written into is refused here, before
+	// anything is uploaded and so before anything can be stranded.
+	attachable, err := newAttachableMarkdown(markdown, args)
+	if err != nil {
+		return markdown, 0, err
+	}
+
+	uploaded := 0
+	var uploadErr error
+	for i := range args {
+		assetURL, err := u.upload(ctx, assets[i])
+		if err != nil {
+			// The assets after this one stay on disk, which is recoverable;
+			// pressing on past a failure is not necessarily.
+			uploadErr = err
+			break
+		}
+		attachable.args[i].URL = assetURL
+		uploaded++
+	}
+
+	if uploaded == 0 {
+		return markdown, 0, uploadErr
+	}
+
+	attached, err := attachAssetsToMarkdown(attachable)
+	if err != nil {
+		return markdown, uploaded, err
+	}
+
+	body := attached.Rewritten
+	for _, arg := range attached.ToAppend {
+		body = appendParagraph(body, arg.markdown())
+	}
+	return body, uploaded, uploadErr
+}
+
+// appendParagraph puts addition in a paragraph of its own below markdown. A
+// video only renders as a player when nothing shares its paragraph, so the
+// blank line is load bearing.
+func appendParagraph(markdown, addition string) string {
+	if addition == "" {
+		return markdown
+	}
+	trimmed := strings.TrimRight(markdown, " \t\r\n")
+	if trimmed == "" {
+		return addition
+	}
+	return trimmed + "\n\n" + addition
+}
diff --git a/internal/attachments/client.go b/internal/attachments/client.go
new file mode 100644
index 000000000..b263e58e0
--- /dev/null
+++ b/internal/attachments/client.go
@@ -0,0 +1,251 @@
+package attachments
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/cli/cli/v2/internal/gh"
+	"github.com/cli/cli/v2/internal/ghinstance"
+	ghauth "github.com/cli/go-gh/v2/pkg/auth"
+)
+
+// openFile is a seam for tests: the upload opens the path it was given rather
+// than holding the bytes from validation, because a large video should not sit
+// in memory while the ones before it upload.
+var openFile = func(path string) (io.ReadCloser, error) {
+	return os.Open(path)
+}
+
+// acceptedTokenTypes are the credentials the user-attachments endpoint accepts.
+// A GitHub App token is refused by the server, and a refresh token is not a
+// credential at all, so both are caught here rather than at the endpoint.
+var acceptedTokenTypes = []gh.TokenType{
+	gh.TokenTypeOAuth,
+	gh.TokenTypePersonalAccess,
+	gh.TokenTypeFineGrainedPAT,
+}
+
+// writePermissions are the roles the endpoint accepts. TRIAGE is the highest
+// one it still refuses.
+var writePermissions = []string{"ADMIN", "MAINTAIN", "WRITE"}
+
+// Uploader posts files to a host's user-attachments endpoint on behalf of one
+// repository.
+type Uploader struct {
+	httpClient       *http.Client
+	host             string
+	targetRepository int64
+}
+
+// NewUploader checks everything that can be known before a byte is sent and
+// returns the uploader when all of it holds. An upload cannot be taken back, so
+// anything that would be refused is refused here instead.
+func NewUploader(httpClient *http.Client, tokenType gh.TokenType, host string, targetRepository int64, viewerPermission string) (*Uploader, error) {
+	if err := checkHost(host); err != nil {
+		return nil, err
+	}
+	if !slices.Contains(acceptedTokenTypes, tokenType) {
+		return nil, errors.New("unsupported authentication type")
+	}
+	switch {
+	case viewerPermission == "":
+		// Distinct from too low a permission: this one means the command did
+		// not ask for the field, which the user cannot do anything about.
+		return nil, errors.New("could not determine your permission on the repository to attach files")
+	case !slices.Contains(writePermissions, strings.ToUpper(viewerPermission)):
+		return nil, errNoWriteAccess
+	}
+	if targetRepository <= 0 {
+		return nil, errors.New("could not determine which repository to attach files to")
+	}
+
+	return &Uploader{
+		httpClient:       httpClient,
+		host:             host,
+		targetRepository: targetRepository,
+	}, nil
+}
+
+var errNoWriteAccess = errors.New("attaching files requires write access to the repository")
+
+// checkHost reports whether host serves the user-attachments endpoint at all.
+func checkHost(host string) error {
+	if ghauth.IsEnterprise(host) {
+		return errors.New("attaching files is not supported on GitHub Enterprise Server")
+	}
+	return nil
+}
+
+// upload sends one asset and returns the URL the server gave it. It never
+// retries: the server may have accepted a request whose response was lost, and
+// a second copy of an asset cannot be deleted.
+func (u *Uploader) upload(ctx context.Context, a UserAsset) (string, error) {
+	as := a.getAsset()
+
+	body, err := openFile(as.path)
+	if err != nil {
+		return "", unexpectedUploadError(as.path, 0, err)
+	}
+	defer body.Close()
+
+	query := url.Values{}
+	query.Set("repository_id", strconv.FormatInt(u.targetRepository, 10))
+	query.Set("name", as.name())
+	query.Set("content_type", as.contentType)
+	requestURL := ghinstance.UserAssetUploadPrefix(u.host) + "user-attachments/assets?" + query.Encode()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, requestURL, body)
+	if err != nil {
+		return "", unexpectedUploadError(as.path, 0, err)
+	}
+	req.ContentLength = as.info.Size()
+	req.Header.Set("Content-Type", "application/octet-stream")
+	req.Header.Set("Accept", "application/vnd.github+json")
+
+	resp, err := u.httpClient.Do(req)
+	if err != nil {
+		return "", unexpectedUploadError(as.path, 0, err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode > 299 {
+		return "", responseUploadError(as.path, resp)
+	}
+
+	var result struct {
+		URL string `json:"url"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
+		return "", unexpectedUploadError(as.path, 0, err)
+	}
+	if result.URL == "" {
+		return "", unexpectedUploadError(as.path, 0, errors.New("the server returned no asset URL"))
+	}
+	return result.URL, nil
+}
+
+// uploadError names the file an upload failed for, so that a run attaching
+// several of them can say which one.
+type uploadError struct {
+	Path       string
+	StatusCode int
+
+	reason string
+	// unexpected separates a failure the user can act on from one gh has
+	// nothing useful to say about.
+	unexpected bool
+	err        error
+}
+
+func (e *uploadError) Error() string {
+	verb := "could not upload"
+	if e.unexpected {
+		verb = "failed to upload"
+	}
+	if e.reason == "" {
+		return fmt.Sprintf("%s %s", verb, e.Path)
+	}
+	return fmt.Sprintf("%s %s: %s", verb, e.Path, e.reason)
+}
+
+func (e *uploadError) Unwrap() error { return e.err }
+
+func unexpectedUploadError(path string, statusCode int, err error) *uploadError {
+	return &uploadError{
+		Path:       path,
+		StatusCode: statusCode,
+		reason:     oneLine(err.Error()),
+		unexpected: true,
+		err:        err,
+	}
+}
+
+// uploadErrorResponse is the shape the endpoint reports a refusal in.
+type uploadErrorResponse struct {
+	Message string `json:"message"`
+	Errors  []struct {
+		Resource string `json:"resource"`
+		Field    string `json:"field"`
+		Code     string `json:"code"`
+		Message  string `json:"message"`
+	} `json:"errors"`
+}
+
+// responseUploadError turns a refusal into the shortest thing a user can act
+// on. The server's own words are kept wherever gh cannot say anything better:
+// the size limit for a video, for instance, depends on an account plan gh
+// cannot see.
+func responseUploadError(path string, resp *http.Response) *uploadError {
+	var parsed uploadErrorResponse
+	if b, err := io.ReadAll(resp.Body); err == nil {
+		_ = json.Unmarshal(b, &parsed)
+	}
+
+	switch resp.StatusCode {
+	case http.StatusNotFound:
+		// The endpoint hides a repository the token cannot write to.
+		return &uploadError{Path: path, StatusCode: resp.StatusCode, reason: errNoWriteAccess.Error(), err: errNoWriteAccess}
+	case http.StatusUnprocessableEntity:
+		reasons := make([]string, 0, len(parsed.Errors)+1)
+		if parsed.Message != "" {
+			reasons = append(reasons, parsed.Message)
+		}
+		for _, cause := range parsed.Errors {
+			if stated := statedCause(cause.Resource, cause.Field, cause.Code, cause.Message); stated != "" {
+				reasons = append(reasons, stated)
+			}
+		}
+		return &uploadError{Path: path, StatusCode: resp.StatusCode, reason: oneLine(strings.Join(reasons, "; "))}
+	case http.StatusTooManyRequests:
+		reason := "rate limited; wait and try again"
+		if retryAfter := resp.Header.Get("Retry-After"); retryAfter != "" {
+			if _, err := strconv.Atoi(retryAfter); err == nil {
+				reason = fmt.Sprintf("rate limited; retry after %s seconds", retryAfter)
+			} else {
+				reason = fmt.Sprintf("rate limited; retry after %s", retryAfter)
+			}
+		}
+		return &uploadError{Path: path, StatusCode: resp.StatusCode, reason: reason}
+	}
+
+	message := parsed.Message
+	if message == "" {
+		message = http.StatusText(resp.StatusCode)
+	}
+	return &uploadError{
+		Path:       path,
+		StatusCode: resp.StatusCode,
+		reason:     oneLine(fmt.Sprintf("HTTP %d: %s", resp.StatusCode, message)),
+		unexpected: true,
+	}
+}
+
+// statedCause words one entry of a validation failure, preferring the sentence
+// the server wrote over the code it fell back to.
+func statedCause(resource, field, code, message string) string {
+	if message != "" {
+		return message
+	}
+	if field == "" || code == "" {
+		return ""
+	}
+	if resource == "" {
+		return fmt.Sprintf("%s is %s", field, code)
+	}
+	return fmt.Sprintf("%s.%s is %s", resource, field, code)
+}
+
+// oneLine keeps an error to a single line, because several of them can be
+// reported together.
+func oneLine(s string) string {
+	return strings.Join(strings.Fields(s), " ")
+}
diff --git a/internal/attachments/flags.go b/internal/attachments/flags.go
new file mode 100644
index 000000000..7522d460e
--- /dev/null
+++ b/internal/attachments/flags.go
@@ -0,0 +1,126 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/MakeNowJust/heredoc"
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+)
+
+const flagName = "attach"
+
+// Flag is the `--attach` flag, which a command adds with AddFlag and then reads
+// with UserAssets once it has decided the flag combination is legal.
+type Flag struct {
+	flag   *pflag.Flag
+	values *[]string
+}
+
+// AddFlag registers `--attach` on cmd and returns a handle on it.
+//
+// It is a string array rather than a string slice because a comma is a legal
+// character in a file name, and a slice would split a path on it.
+func AddFlag(cmd *cobra.Command) *Flag {
+	values := []string{}
+	cmd.Flags().StringArrayVar(&values, flagName, values,
+		"Attach an image or video `file`, in '<file>#<image alt text>' format")
+	return &Flag{flag: cmd.Flags().Lookup(flagName), values: &values}
+}
+
+// Changed reports whether the flag was passed at all, which counts as body
+// input even when no other body flag was given.
+func (f *Flag) Changed() bool {
+	return f != nil && f.flag.Changed
+}
+
+// UserAssets validates every value the flag collected and returns the
+// attachments they name, in the order they were written. Every file is
+// validated before any of them is uploaded, so a bad argument stops the command
+// rather than stranding assets nobody can delete.
+func (f *Flag) UserAssets() ([]UserAsset, error) {
+	if !f.Changed() {
+		return nil, nil
+	}
+
+	var assets []UserAsset
+	for _, value := range *f.values {
+		switch value {
+		case "":
+			return nil, errors.New("cannot attach an empty path; --attach needs a file path")
+		case "-":
+			return nil, errors.New("cannot attach standard input; --attach needs a file path")
+		}
+
+		path, alt := splitPathAndAlt(value)
+		a, err := newAsset(path, alt)
+		if err != nil {
+			return nil, err
+		}
+		// The endpoint gives each upload its own URL, so the same file attached
+		// twice would silently become two assets the body cannot tell apart.
+		for _, existing := range assets {
+			if os.SameFile(existing.getAsset().info, a.getAsset().info) {
+				return nil, fmt.Errorf("%s and %s are the same file; attached files must be unique", existing.Path(), a.Path())
+			}
+		}
+		assets = append(assets, a)
+	}
+	return assets, nil
+}
+
+// splitPathAndAlt separates `<file>#<alt text>` into its two halves.
+//
+// A "#" is legal in a file name, so the split cannot simply be at the first or
+// the last one. The longest prefix that names an existing file wins, and when
+// nothing exists the last "#" is used so that the error names the path the user
+// most likely meant.
+func splitPathAndAlt(value string) (path, alt string) {
+	if exists(value) {
+		return value, ""
+	}
+
+	lastHash := -1
+	for i := len(value) - 1; i >= 0; i-- {
+		if value[i] != '#' {
+			continue
+		}
+		if lastHash < 0 {
+			lastHash = i
+		}
+		if candidate := value[:i]; candidate != "" && exists(candidate) {
+			return candidate, value[i+1:]
+		}
+	}
+
+	if lastHash > 0 {
+		return value[:lastHash], value[lastHash+1:]
+	}
+	return value, ""
+}
+
+func exists(path string) bool {
+	_, err := os.Stat(path)
+	return err == nil
+}
+
+// AttachUsage documents `--attach` for the long help of the commands that take
+// it.
+func AttachUsage() string {
+	return strings.TrimSpace(heredoc.Docf(`
+		The %[1]s--attach%[1]s flag uploads an image or a video and writes it into the body.
+		Pass it once per file, as %[1]s<file>%[1]s or %[1]s<file>#<image alt text>%[1]s. Images may be
+		png, jpg, jpeg, gif, webp or svg and at most %[2]s; videos may be mp4, mov
+		or webm and at most %[3]s.
+
+		Where the file lands depends on the body: a link to or an embed of the file's
+		path is rewritten to the uploaded URL in place, and a file the body never
+		mentions is appended below it.
+
+		Attaching is not supported on GitHub Enterprise Server, and requires write
+		access to the repository.
+	`, "`", megabytes(maxImageBytes), megabytes(maxVideoBytes)))
+}
diff --git a/internal/attachments/references.go b/internal/attachments/references.go
new file mode 100644
index 000000000..7d8026690
--- /dev/null
+++ b/internal/attachments/references.go
@@ -0,0 +1,724 @@
+package attachments
+
+import (
+	"fmt"
+	"net/url"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"github.com/yuin/goldmark"
+	"github.com/yuin/goldmark/ast"
+	"github.com/yuin/goldmark/text"
+)
+
+// markdownParser is the CommonMark parser gh already depends on, with no
+// extensions, so that gh reads a body the way GitHub does.
+var markdownParser = goldmark.New().Parser()
+
+// attachmentArg is one attached file as the rewriter sees it: where the author
+// wrote it, where it ended up, and how it has to render.
+type attachmentArg struct {
+	Path            string
+	URL             string
+	Alt             string
+	RendersAsPlayer bool
+}
+
+// markdown renders the attachment for appending below a body.
+func (a attachmentArg) markdown() string {
+	if a.RendersAsPlayer {
+		return a.URL
+	}
+	embed := fmt.Sprintf("![%s](%s)", escapeLabel(a.Alt), a.URL)
+	if !isSingleImage(embed, a.URL) {
+		// The alt text escaped its brackets anyway, so drop it rather than let
+		// it take the destination with it.
+		embed = fmt.Sprintf("![](%s)", a.URL)
+	}
+	return embed
+}
+
+// attachableMarkdown is markdown that has been checked against the files being
+// attached to it. It only exists once that check has passed, so that nothing is
+// uploaded for a body the assets cannot be written into.
+type attachableMarkdown struct {
+	markdown string
+	args     []attachmentArg
+}
+
+// attachedMarkdown is the result of writing the uploaded assets into a body.
+type attachedMarkdown struct {
+	// Rewritten is the body with every reference pointed at its asset URL.
+	Rewritten string
+	// ToAppend are the attachments the body never referenced, in the order
+	// they were passed, for the caller to append.
+	ToAppend []attachmentArg
+}
+
+// newAttachableMarkdown refuses markdown that the attached files cannot be
+// written into, and otherwise pairs the two.
+//
+// The only such shape is a video used as a reference-style image: a video only
+// renders as a player when it is a bare URL, and the usage that would have to
+// change lives somewhere other than the definition that carries the path.
+func newAttachableMarkdown(markdown string, args []attachmentArg) (attachableMarkdown, error) {
+	r := newRewriter(markdown, args)
+
+	var offenders []string
+	reported := make([]bool, len(args))
+	for _, u := range r.usages {
+		if u.reference == nil || !u.isImage || u.argIndex < 0 {
+			continue
+		}
+		if !args[u.argIndex].RendersAsPlayer || reported[u.argIndex] {
+			continue
+		}
+		reported[u.argIndex] = true
+		offenders = append(offenders, args[u.argIndex].Path)
+	}
+	if len(offenders) > 0 {
+		return attachableMarkdown{}, fmt.Errorf("cannot embed a video as a reference-style image: %s", strings.Join(offenders, ", "))
+	}
+
+	return attachableMarkdown{markdown: markdown, args: args}, nil
+}
+
+// attachAssetsToMarkdown points every reference to an attached file at the URL
+// that file was uploaded to, and reports the attachments nothing referenced.
+func attachAssetsToMarkdown(v attachableMarkdown) (attachedMarkdown, error) {
+	r := newRewriter(v.markdown, v.args)
+
+	sites := r.inlineSites()
+
+	used := make([]bool, len(v.args))
+	var edits []edit
+	for _, s := range sites {
+		// A video that takes over its whole paragraph swallows anything
+		// written inside it, so a reference it covered is not referenced at
+		// all once it is gone.
+		if swallowed(s, sites) {
+			continue
+		}
+		used[s.argIndex] = true
+		edits = append(edits, s.edits...)
+	}
+
+	// A reference-style usage carries no destination of its own, so rewriting
+	// the definition once carries every usage of that label with it.
+	referenced := make([]bool, len(v.args))
+	for _, u := range r.usages {
+		if u.reference != nil && u.argIndex >= 0 {
+			referenced[u.argIndex] = true
+		}
+	}
+	for _, d := range r.definitions {
+		if d.argIndex < 0 || !referenced[d.argIndex] {
+			// Editing a definition nothing renders would hide the file instead
+			// of appending it.
+			continue
+		}
+		// A definition whose destination could not be located in the source is
+		// left as written, and its file is appended instead.
+		used[d.argIndex] = true
+		if arg := v.args[d.argIndex]; arg.URL != "" {
+			edits = append(edits, edit{d.destination, arg.URL})
+		}
+	}
+
+	var toAppend []attachmentArg
+	for i, arg := range v.args {
+		if !used[i] && arg.URL != "" {
+			toAppend = append(toAppend, arg)
+		}
+	}
+
+	return attachedMarkdown{Rewritten: applyEdits(v.markdown, edits), ToAppend: toAppend}, nil
+}
+
+// isSingleImage reports whether markdown is exactly one image embed pointing at
+// assetURL and nothing else. It is how gh checks that alt text it did not write
+// cannot close the image early and take the destination with it.
+func isSingleImage(markdown, assetURL string) bool {
+	src := []byte(markdown)
+	doc := markdownParser.Parse(text.NewReader(src))
+
+	paragraph, ok := doc.FirstChild().(*ast.Paragraph)
+	if !ok || doc.FirstChild() != doc.LastChild() {
+		return false
+	}
+	image, ok := paragraph.FirstChild().(*ast.Image)
+	if !ok || paragraph.FirstChild() != paragraph.LastChild() {
+		return false
+	}
+	return string(image.Destination) == assetURL
+}
+
+// byteRange is a half-open span of the original markdown.
+type byteRange struct {
+	start int
+	stop  int
+}
+
+func (r byteRange) contains(other byteRange) bool {
+	return r.start <= other.start && other.stop <= r.stop
+}
+
+// edit replaces a span of the original markdown with text.
+type edit struct {
+	byteRange
+	text string
+}
+
+// usage is a link or an image the parser found that points at an attached file.
+type usage struct {
+	node      ast.Node
+	isImage   bool
+	argIndex  int
+	reference *ast.ReferenceLink
+}
+
+// definition is a link reference definition whose destination names an attached
+// file and could be located in the source.
+type definition struct {
+	argIndex    int
+	destination byteRange
+}
+
+// site is one place the rewriter wants to change, as the edits it takes and the
+// span they sit in.
+type site struct {
+	span     byteRange
+	argIndex int
+	edits    []edit
+	// replacesSpan marks a site that overwrites everything in its span, which
+	// discards any site nested inside it.
+	replacesSpan bool
+}
+
+// rewriter holds one parse of a body and what it found in it.
+type rewriter struct {
+	src  []byte
+	args []attachmentArg
+
+	usages      []usage
+	definitions []definition
+	// codeSpans are the byte ranges of inline code, which the scanner steps
+	// over so that a bracket written as code cannot close a label.
+	codeSpans []byteRange
+}
+
+func newRewriter(markdown string, args []attachmentArg) *rewriter {
+	r := &rewriter{src: []byte(markdown), args: args}
+
+	doc := markdownParser.Parse(text.NewReader(r.src))
+
+	var links []ast.Node
+	var defs []*ast.LinkReferenceDefinition
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		switch node := n.(type) {
+		case *ast.CodeSpan:
+			if span, ok := childrenRange(node); ok {
+				r.codeSpans = append(r.codeSpans, span)
+			}
+		case *ast.Image, *ast.Link:
+			links = append(links, n)
+		case *ast.LinkReferenceDefinition:
+			defs = append(defs, node)
+		}
+		return ast.WalkContinue, nil
+	})
+
+	for _, n := range links {
+		u := usage{node: n, argIndex: -1}
+		switch node := n.(type) {
+		case *ast.Image:
+			u.isImage = true
+			u.reference = node.Reference
+			u.argIndex = r.match(string(node.Destination))
+		case *ast.Link:
+			u.reference = node.Reference
+			u.argIndex = r.match(string(node.Destination))
+		}
+		r.usages = append(r.usages, u)
+	}
+
+	for _, d := range defs {
+		argIndex := r.match(string(d.Destination))
+		if argIndex < 0 {
+			continue
+		}
+		destination, ok := r.definitionDestination(d)
+		if !ok {
+			continue
+		}
+		r.definitions = append(r.definitions, definition{argIndex: argIndex, destination: destination})
+	}
+
+	return r
+}
+
+// inlineSites turns every inline usage of an attached file into the edits that
+// point it at the asset URL.
+func (r *rewriter) inlineSites() []site {
+	var sites []site
+	for _, u := range r.usages {
+		if u.reference != nil || u.argIndex < 0 {
+			continue
+		}
+		parsed, ok := r.parseInline(u.node.Pos(), u.isImage)
+		if !ok {
+			continue
+		}
+		arg := r.args[u.argIndex]
+		s := site{span: parsed.span, argIndex: u.argIndex}
+
+		switch {
+		case arg.URL == "":
+			// Nothing uploaded for this file, so its reference stays as the
+			// author wrote it.
+		case !arg.RendersAsPlayer || !u.isImage:
+			// An image embed, or a link of any kind, only moves its
+			// destination.
+			s.edits = append(s.edits, edit{parsed.destination, arg.URL})
+		case r.aloneInParagraph(u.node, parsed.span):
+			// Nothing shares the paragraph, so the bare URL renders a player.
+			s.replacesSpan = true
+			s.edits = append(s.edits, edit{parsed.span, arg.URL})
+		default:
+			// A player cannot render here, so the embed degrades to a link
+			// that keeps whatever label the author wrote.
+			s.edits = append(s.edits, r.dropBang(parsed.span.start))
+			if parsed.label.start == parsed.label.stop {
+				s.edits = append(s.edits, edit{parsed.label, escapeLabel(arg.Alt)})
+			}
+			s.edits = append(s.edits, edit{parsed.destination, arg.URL})
+		}
+		sites = append(sites, s)
+	}
+	return sites
+}
+
+// dropBang removes the "!" that makes an embed, escaping the character before
+// it when deleting would let the two re-form an embed of the video.
+func (r *rewriter) dropBang(bang int) edit {
+	if bang > 0 && r.src[bang-1] == '!' && !isEscaped(r.src, bang-1) {
+		return edit{byteRange{bang - 1, bang + 1}, `\!`}
+	}
+	return edit{byteRange{bang, bang + 1}, ""}
+}
+
+func swallowed(s site, sites []site) bool {
+	for _, other := range sites {
+		if !other.replacesSpan || other.span == s.span {
+			continue
+		}
+		if other.span.contains(s.span) {
+			return true
+		}
+	}
+	return false
+}
+
+// inlineParse is where the pieces of an inline link sit in the source.
+type inlineParse struct {
+	span        byteRange
+	label       byteRange
+	destination byteRange
+}
+
+// parseInline reads the link or image that starts at pos. The parser has
+// already decided this is one, so the scan only has to find where its parts
+// end.
+func (r *rewriter) parseInline(pos int, isImage bool) (inlineParse, bool) {
+	var parsed inlineParse
+	if pos < 0 || pos >= len(r.src) {
+		return parsed, false
+	}
+
+	labelOpen := pos
+	if isImage {
+		labelOpen++
+	}
+	if labelOpen >= len(r.src) || r.src[labelOpen] != '[' {
+		return parsed, false
+	}
+
+	labelClose, ok := r.matchBracket(labelOpen)
+	if !ok || labelClose+1 >= len(r.src) || r.src[labelClose+1] != '(' {
+		return parsed, false
+	}
+
+	destination, tailEnd, ok := r.parseTail(labelClose + 1)
+	if !ok {
+		return parsed, false
+	}
+
+	parsed.span = byteRange{pos, tailEnd}
+	parsed.label = byteRange{labelOpen + 1, labelClose}
+	parsed.destination = destination
+	return parsed, true
+}
+
+// matchBracket returns the "]" that closes the "[" at open, stepping over
+// escapes, nested brackets and inline code.
+func (r *rewriter) matchBracket(open int) (int, bool) {
+	depth := 0
+	for i := open; i < len(r.src); {
+		if stop, ok := r.codeSpanEnd(i); ok {
+			i = stop
+			continue
+		}
+		switch r.src[i] {
+		case '\\':
+			i += 2
+			continue
+		case '[':
+			depth++
+		case ']':
+			depth--
+			if depth == 0 {
+				return i, true
+			}
+		}
+		i++
+	}
+	return 0, false
+}
+
+// parseTail reads "(destination "title")" starting at the "(" at open, and
+// returns where the destination sits and where the tail ends.
+func (r *rewriter) parseTail(open int) (byteRange, int, bool) {
+	i := r.skipSpaces(open + 1)
+
+	var destination byteRange
+	if i < len(r.src) && r.src[i] == '<' {
+		stop, ok := r.scanAngleDestination(i)
+		if !ok {
+			return destination, 0, false
+		}
+		destination = byteRange{i, stop}
+		i = stop
+	} else {
+		start := i
+		depth := 0
+	scan:
+		for i < len(r.src) {
+			switch c := r.src[i]; {
+			case c == '\\':
+				i += 2
+				continue
+			case isSpaceByte(c):
+				break scan
+			case c == '(':
+				depth++
+			case c == ')':
+				if depth == 0 {
+					break scan
+				}
+				depth--
+			}
+			i++
+		}
+		if i == start {
+			return destination, 0, false
+		}
+		destination = byteRange{start, i}
+	}
+
+	i = r.skipSpaces(i)
+	if i < len(r.src) && (r.src[i] == '"' || r.src[i] == '\'' || r.src[i] == '(') {
+		stop, ok := r.scanTitle(i)
+		if !ok {
+			return destination, 0, false
+		}
+		i = r.skipSpaces(stop)
+	}
+	if i >= len(r.src) || r.src[i] != ')' {
+		return destination, 0, false
+	}
+	return destination, i + 1, true
+}
+
+// scanAngleDestination returns the index just past the ">" that closes the "<"
+// at open. A destination cannot span a line break.
+func (r *rewriter) scanAngleDestination(open int) (int, bool) {
+	for i := open + 1; i < len(r.src); i++ {
+		switch r.src[i] {
+		case '\\':
+			i++
+		case '\n', '\r':
+			return 0, false
+		case '>':
+			return i + 1, true
+		}
+	}
+	return 0, false
+}
+
+// scanTitle returns the index just past the closing delimiter of the title that
+// starts at open.
+func (r *rewriter) scanTitle(open int) (int, bool) {
+	closer := r.src[open]
+	if closer == '(' {
+		closer = ')'
+	}
+	for i := open + 1; i < len(r.src); i++ {
+		switch r.src[i] {
+		case '\\':
+			i++
+		case closer:
+			return i + 1, true
+		}
+	}
+	return 0, false
+}
+
+// definitionDestination locates the destination of a link reference definition
+// in the source, so that it can be replaced without disturbing its label or
+// title.
+func (r *rewriter) definitionDestination(d *ast.LinkReferenceDefinition) (byteRange, bool) {
+	lines := d.Lines()
+	if lines == nil || lines.Len() == 0 {
+		return byteRange{}, false
+	}
+	start := lines.At(0).Start
+	stop := lines.At(lines.Len() - 1).Stop
+	if start >= len(r.src) || r.src[start] != '[' {
+		return byteRange{}, false
+	}
+
+	labelClose := -1
+	for i := start + 1; i < stop; i++ {
+		if r.src[i] == '\\' {
+			i++
+			continue
+		}
+		if r.src[i] == ']' {
+			labelClose = i
+			break
+		}
+	}
+	if labelClose < 0 || labelClose+1 >= stop || r.src[labelClose+1] != ':' {
+		return byteRange{}, false
+	}
+
+	i := labelClose + 2
+	for i < stop && (r.src[i] == ' ' || r.src[i] == '\t') {
+		i++
+	}
+	if i >= stop {
+		return byteRange{}, false
+	}
+
+	if r.src[i] == '<' {
+		end, ok := r.scanAngleDestination(i)
+		if !ok || end > stop {
+			return byteRange{}, false
+		}
+		return byteRange{i, end}, true
+	}
+
+	begin := i
+	for i < stop && !isSpaceByte(r.src[i]) {
+		i++
+	}
+	if i == begin {
+		// The destination is on a line of its own, and what the block range
+		// holds here is whatever prefixes that line rather than the path.
+		return byteRange{}, false
+	}
+	return byteRange{begin, i}, true
+}
+
+// aloneInParagraph reports whether span is the whole content of the paragraph
+// that holds it. Only a paragraph counts: a heading, a tight list item and a
+// soft-wrapped line all render a bare URL as a plain link rather than a player.
+func (r *rewriter) aloneInParagraph(n ast.Node, span byteRange) bool {
+	block := n.Parent()
+	for block != nil && block.Type() != ast.TypeBlock {
+		block = block.Parent()
+	}
+	if _, ok := block.(*ast.Paragraph); !ok {
+		return false
+	}
+
+	lines := block.Lines()
+	if lines == nil || lines.Len() == 0 {
+		return false
+	}
+	start := lines.At(0).Start
+	stop := lines.At(lines.Len() - 1).Stop
+	for start < stop && isSpaceByte(r.src[start]) {
+		start++
+	}
+	for stop > start && isSpaceByte(r.src[stop-1]) {
+		stop--
+	}
+	return start == span.start && stop == span.stop
+}
+
+func (r *rewriter) skipSpaces(i int) int {
+	for i < len(r.src) && isSpaceByte(r.src[i]) {
+		i++
+	}
+	return i
+}
+
+// codeSpanEnd reports whether i is the start of an inline code span's content,
+// and where that content ends.
+func (r *rewriter) codeSpanEnd(i int) (int, bool) {
+	for _, span := range r.codeSpans {
+		if span.start == i {
+			return span.stop, true
+		}
+	}
+	return 0, false
+}
+
+// match returns the index of the attachment a markdown destination names, or -1
+// when it names something else.
+func (r *rewriter) match(destination string) int {
+	if !isLocalPath(destination) {
+		return -1
+	}
+	for i, arg := range r.args {
+		for _, candidate := range spellingsOf(destination) {
+			if samePath(candidate, arg.Path) {
+				return i
+			}
+		}
+	}
+	return -1
+}
+
+// isLocalPath reports whether a markdown destination could name a file on this
+// machine at all.
+func isLocalPath(destination string) bool {
+	if destination == "" || strings.HasPrefix(destination, "#") || strings.HasPrefix(destination, "//") {
+		return false
+	}
+	colon := strings.IndexByte(destination, ':')
+	// A single letter before the colon is how Windows names a volume, which is
+	// the one spelling a scheme test has to let through.
+	if colon > 1 && isSchemeName(destination[:colon]) {
+		return false
+	}
+	return true
+}
+
+func isSchemeName(s string) bool {
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z':
+		case i > 0 && (c >= '0' && c <= '9' || c == '+' || c == '-' || c == '.'):
+		default:
+			return false
+		}
+	}
+	return s != ""
+}
+
+// spellingsOf returns the file names a markdown destination could stand for.
+// Markdown lets a name carrying a space or a parenthesis be written with
+// backslash escapes or percent encoding, and both spell the same file.
+func spellingsOf(destination string) []string {
+	spellings := []string{destination}
+	if unescaped := unescapeBackslashes(destination); unescaped != destination {
+		spellings = append(spellings, unescaped)
+	}
+	for _, s := range append([]string(nil), spellings...) {
+		if decoded, err := url.PathUnescape(s); err == nil && decoded != s {
+			spellings = append(spellings, decoded)
+		}
+	}
+	return spellings
+}
+
+// unescapeBackslashes drops the backslash from every escaped ASCII punctuation
+// character, which is what markdown means by it.
+func unescapeBackslashes(s string) string {
+	if !strings.ContainsRune(s, '\\') {
+		return s
+	}
+	var b strings.Builder
+	b.Grow(len(s))
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\\' && i+1 < len(s) && isASCIIPunct(s[i+1]) {
+			i++
+		}
+		b.WriteByte(s[i])
+	}
+	return b.String()
+}
+
+func samePath(a, b string) bool {
+	if a == b {
+		return true
+	}
+	absA, errA := filepath.Abs(a)
+	absB, errB := filepath.Abs(b)
+	return errA == nil && errB == nil && absA == absB
+}
+
+// applyEdits writes every edit into markdown, latest first so that the earlier
+// offsets stay valid. Overlapping edits cannot both apply, so the outer one
+// wins.
+func applyEdits(markdown string, edits []edit) string {
+	if len(edits) == 0 {
+		return markdown
+	}
+	// Descending by start, and widest first where two share a start.
+	sorted := slices.Clone(edits)
+	slices.SortFunc(sorted, func(a, b edit) int {
+		if a.start != b.start {
+			return b.start - a.start
+		}
+		return b.stop - a.stop
+	})
+
+	out := []byte(markdown)
+	next := len(markdown)
+	for _, e := range sorted {
+		if e.stop > next || e.start > e.stop {
+			continue
+		}
+		out = append(out[:e.start], append([]byte(e.text), out[e.stop:]...)...)
+		next = e.start
+	}
+	return string(out)
+}
+
+// childrenRange is the span from the first to the last child of an inline node
+// that holds text segments.
+func childrenRange(n ast.Node) (byteRange, bool) {
+	first, ok := n.FirstChild().(*ast.Text)
+	if !ok {
+		return byteRange{}, false
+	}
+	last, ok := n.LastChild().(*ast.Text)
+	if !ok {
+		return byteRange{}, false
+	}
+	return byteRange{first.Segment.Start, last.Segment.Stop}, true
+}
+
+func isEscaped(src []byte, i int) bool {
+	backslashes := 0
+	for j := i - 1; j >= 0 && src[j] == '\\'; j-- {
+		backslashes++
+	}
+	return backslashes%2 == 1
+}
+
+func isSpaceByte(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f'
+}
+
+func isASCIIPunct(c byte) bool {
+	return strings.IndexByte("!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~", c) >= 0
+}
