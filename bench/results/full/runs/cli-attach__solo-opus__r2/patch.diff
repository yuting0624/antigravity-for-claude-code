+package attachments
+
+import (
+	"net/http"
+	"os"
+	"strconv"
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/httpmock"
+)
+
+// UploadStub is one stubbed response from the user-attachments endpoint, for a
+// test that states its uploads as data.
+type UploadStub struct {
+	// Name is the file name the upload carries, which is what the stub matches
+	// on so that a row can fail one upload and not the others.
+	Name   string
+	Status int
+	Body   string
+}
+
+// StubUpload registers a response for the upload of name to the default host.
+func StubUpload(reg *httpmock.Registry, targetRepository int64, name string, status int, body string) {
+	reg.Register(uploadMatcher("", targetRepository, name), httpmock.StatusStringResponse(status, body))
+}
+
+// StubUploadToHost is StubUpload for a test that also cares which upload host
+// was reached, such as one covering a data residency tenant.
+func StubUploadToHost(t *testing.T, reg *httpmock.Registry, host string, targetRepository int64, name string, status int, body string) {
+	t.Helper()
+	reg.Register(uploadMatcher(host, targetRepository, name), httpmock.StatusStringResponse(status, body))
+}
+
+// uploadMatcher matches the upload of one named file to one repository. An
+// empty host matches any of them.
+func uploadMatcher(host string, targetRepository int64, name string) httpmock.Matcher {
+	rest := httpmock.REST(http.MethodPost, "user-attachments/assets")
+	return func(req *http.Request) bool {
+		if host != "" && req.URL.Host != host {
+			return false
+		}
+		query := req.URL.Query()
+		if query.Get("name") != name {
+			return false
+		}
+		if query.Get("repository_id") != strconv.FormatInt(targetRepository, 10) {
+			return false
+		}
+		return rest(req)
+	}
+}
+
+// NewTestAssets writes the named files into a temporary working directory and
+// resolves them the way `--attach` does, so that a test can state its
+// attachments as file names.
+func NewTestAssets(t *testing.T, names ...string) []UserAsset {
+	t.Helper()
+
+	t.Chdir(t.TempDir())
+
+	assets := make([]UserAsset, 0, len(names))
+	for _, name := range names {
+		if err := os.WriteFile(name, []byte("the bytes"), 0o600); err != nil {
+			t.Fatalf("could not write %s: %v", name, err)
+		}
+		a, err := newAsset("./"+name, "")
+		if err != nil {
+			t.Fatalf("could not resolve %s: %v", name, err)
+		}
+		assets = append(assets, a)
+	}
+	return assets
+}
