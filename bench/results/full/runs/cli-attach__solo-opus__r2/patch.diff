new file mode 100644
index 000000000..79ac39224
--- /dev/null
+++ b/internal/attachments/userasset.go
@@ -0,0 +1,182 @@
+// Package attachments uploads local images and videos to GitHub's
+// user-attachments endpoint and writes the resulting asset URLs into the
+// markdown body of an issue, a pull request or a comment.
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+const (
+	// maxImageBytes and maxVideoBytes are the limits the endpoint applies to a
+	// free account. A paid plan may allow a larger video, but gh cannot see
+	// which plan the account is on, so it refuses at the lower limit and lets
+	// the server have the last word on anything it lets through.
+	maxImageBytes = 10 * 1024 * 1024
+	maxVideoBytes = 100 * 1024 * 1024
+)
+
+// supportedContentTypes maps the extensions the endpoint accepts to the content
+// type it wants for each. The order is the order the error message lists them
+// in, so images come before videos.
+var supportedContentTypes = []struct {
+	extension   string
+	contentType string
+}{
+	{".png", "image/png"},
+	{".jpg", "image/jpeg"},
+	{".jpeg", "image/jpeg"},
+	{".gif", "image/gif"},
+	{".webp", "image/webp"},
+	{".svg", "image/svg+xml"},
+	{".mp4", "video/mp4"},
+	{".mov", "video/quicktime"},
+	{".webm", "video/webm"},
+}
+
+// UserAsset is a local file that has been accepted for upload.
+type UserAsset interface {
+	// Path returns the path the user wrote, which is what errors name.
+	Path() string
+	// markdown renders the asset at the given URL.
+	markdown(assetURL string) string
+	// rendersAsPlayer reports whether the markdown form only plays when it
+	// stands alone in a paragraph.
+	rendersAsPlayer() bool
+	getAsset() *asset
+}
+
+// asset holds what every kind of attachment has in common.
+type asset struct {
+	path        string
+	alt         string
+	contentType string
+	info        fs.FileInfo
+}
+
+func (a *asset) Path() string     { return a.path }
+func (a *asset) getAsset() *asset { return a }
+func (a *asset) name() string     { return filepath.Base(a.path) }
+
+// imageAsset embeds as a markdown image.
+type imageAsset struct {
+	asset
+}
+
+func (a *imageAsset) markdown(assetURL string) string {
+	return fmt.Sprintf("![%s](%s)", escapeLabel(a.alt), assetURL)
+}
+
+func (a *imageAsset) rendersAsPlayer() bool { return false }
+
+// videoAsset embeds as a bare URL, which is the only form GitHub turns into a
+// player.
+type videoAsset struct {
+	asset
+}
+
+func (a *videoAsset) markdown(assetURL string) string {
+	return assetURL
+}
+
+func (a *videoAsset) rendersAsPlayer() bool { return true }
+
+// newAsset validates path and returns the attachment it names. Only metadata is
+// read; the bytes are not opened until the upload.
+func newAsset(path, alt string) (UserAsset, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		var pathErr *fs.PathError
+		if errors.As(err, &pathErr) {
+			// The syscall gh happened to make is noise: name the path the user
+			// wrote and keep the reason the operating system gave.
+			err = pathErr.Err
+		}
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+	if info.IsDir() {
+		return nil, fmt.Errorf("%s is a directory", path)
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%s is not a regular file", path)
+	}
+
+	contentType, ok := contentTypeFor(path)
+	if !ok {
+		return nil, fmt.Errorf("%s is not a supported file type (supported: %s)", path, strings.Join(supportedExtensions(), ", "))
+	}
+	if info.Size() == 0 {
+		return nil, fmt.Errorf("%s is empty", path)
+	}
+
+	base := asset{path: path, alt: alt, contentType: contentType, info: info}
+
+	if strings.HasPrefix(contentType, "video/") {
+		if alt != "" {
+			return nil, errors.New("cannot set alt text on video")
+		}
+		if info.Size() > maxVideoBytes {
+			return nil, fmt.Errorf("%s: videos must be at most %s", path, megabytes(maxVideoBytes))
+		}
+		// A video has no alt attribute to fill, so the file name stands in as
+		// the link text for the shapes that degrade to a link.
+		base.alt = base.name()
+		return &videoAsset{base}, nil
+	}
+
+	if info.Size() > maxImageBytes {
+		return nil, fmt.Errorf("%s: images must be at most %s", path, megabytes(maxImageBytes))
+	}
+	if base.alt == "" {
+		base.alt = defaultImageAlt(base.name())
+	}
+	return &imageAsset{base}, nil
+}
+
+// contentTypeFor reports the content type the endpoint wants for path, and
+// whether the extension is one it accepts at all.
+func contentTypeFor(path string) (string, bool) {
+	extension := strings.ToLower(filepath.Ext(path))
+	for _, supported := range supportedContentTypes {
+		if supported.extension == extension {
+			return supported.contentType, true
+		}
+	}
+	return "", false
+}
+
+func supportedExtensions() []string {
+	extensions := make([]string, 0, len(supportedContentTypes))
+	for _, supported := range supportedContentTypes {
+		extensions = append(extensions, strings.TrimPrefix(supported.extension, "."))
+	}
+	return extensions
+}
+
+func megabytes(bytes int64) string {
+	return fmt.Sprintf("%.1f MB", float64(bytes)/(1024*1024))
+}
+
+// defaultImageAlt turns a file name into readable alt text: the extension goes,
+// and the dots a screenshot name is full of become spaces.
+func defaultImageAlt(name string) string {
+	return strings.ReplaceAll(strings.TrimSuffix(name, filepath.Ext(name)), ".", " ")
+}
+
+// escapeLabel makes text safe to sit between the brackets of a markdown label,
+// so that alt text cannot close the label early and take over the destination.
+func escapeLabel(text string) string {
+	replacer := strings.NewReplacer(
+		`\`, `\\`,
+		`[`, `\[`,
+		`]`, `\]`,
+		"\r", " ",
+		"\n", " ",
+	)
+	return replacer.Replace(text)
+}
