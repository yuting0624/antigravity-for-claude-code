+// limitations under the License.
+
+// Command zoekt-local-sync keeps a zoekt index in sync with the git repositories found
+// below one or more local directories; the default action is a preview and -f applies it.
+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+)
+
+func main() {
+	if err := execute(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			os.Exit(2)
+		}
+		fmt.Fprintf(os.Stderr, "zoekt-local-sync: %v\n", err)
+		os.Exit(1)
+	}
+}
+
+// execute runs the command with args, writing its report to out and
+// diagnostics to errOut.
+func execute(args []string, out, errOut io.Writer) error {
+	if len(args) > 0 {
+		switch args[0] {
+		case "help", "-h", "--help":
+			printHelp(out)
+			return nil
+		case "sync":
+			return runSync(args[1:], out, errOut)
+		case "list":
+			return runList(args[1:], out, errOut)
+		case "remove":
+			return runRemove(args[1:], out, errOut)
+		}
+	}
+	return runSync(args, out, errOut)
+}
+
+const overview = `zoekt-local-sync keeps a zoekt index in sync with the git repositories found
+below one or more local directories.
+
+Usage:
+
+  zoekt-local-sync [options] <root>...          preview a sync, -f applies it
+  zoekt-local-sync sync [options] <root>...     the same, spelled out
+  zoekt-local-sync list [options]               list the indexed repositories
+  zoekt-local-sync remove [options] <repo>...   preview a removal, -f applies it
+
+A repository is named after its path relative to the root it was found below.
+Repositories in the index that are no longer below a root are pruned.
+
+Run "zoekt-local-sync list -h" or "zoekt-local-sync remove -h" for the options
+of those subcommands.
+
+Default sync options:
+`
+
+// printHelp writes the command overview and the default sync options.
+func printHelp(out io.Writer) {
+	fmt.Fprint(out, overview)
+	fs, _ := newSyncFlagSet("zoekt-local-sync sync", out)
+	fs.PrintDefaults()
+}
+
+// directoryLock is an exclusive lock on an index directory.
+type directoryLock struct {
+	file *os.File
+	path string
+}
+
+// acquireDirectoryLock takes an exclusive lock on indexDir. It fails when
+// another process already holds it.
+func acquireDirectoryLock(indexDir string) (*directoryLock, error) {
+	path := filepath.Join(indexDir, ".zoekt-local-sync.lock")
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)
+	if err != nil {
+		if errors.Is(err, os.ErrExist) || os.IsExist(err) {
+			return nil, fmt.Errorf("another zoekt-local-sync is running against that index directory: %q", path)
+		}
+		return nil, err
+	}
+	if _, err := fmt.Fprintf(f, "%d\n", os.Getpid()); err != nil {
+		_ = f.Close()
+		_ = os.Remove(path)
+		return nil, err
+	}
+	return &directoryLock{
+		file: f,
+		path: path,
+	}, nil
+}
+
+// Close releases the lock.
+func (l *directoryLock) Close() error {
+	if l == nil {
+		return nil
+	}
+	closeErr := l.file.Close()
+	if err := os.Remove(l.path); err != nil && closeErr == nil {
+		closeErr = err
+	}
+	return closeErr
+}
diff --git a/cmd/zoekt-local-sync/sync.go b/cmd/zoekt-local-sync/sync.go
new file mode 100644
index 00000000..aace2d7d
--- /dev/null
+++ b/cmd/zoekt-local-sync/sync.go
@@ -0,0 +1,323 @@
+// Copyright 2026 Sourcegraph, Inc. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"text/tabwriter"
+
+	"github.com/sourcegraph/zoekt"
+	"github.com/sourcegraph/zoekt/gitindex"
+	"github.com/sourcegraph/zoekt/index"
+	"github.com/sourcegraph/zoekt/internal/ctags"
+)
+
+type syncOptions struct {
+	build        index.Options
+	branches     string
+	branchPrefix string
+	submodules   bool
+	allowMissing bool
+	incremental  bool
+	repoCacheDir string
+	languageMap  string
+	force        bool
+}
+
+// newSyncFlagSet returns the flag set of the sync command, named after the
+// subcommand it is invoked as.
+func newSyncFlagSet(name string, output io.Writer) (*flag.FlagSet, *syncOptions) {
+	fs := flag.NewFlagSet(name, flag.ContinueOnError)
+	fs.SetOutput(output)
+	opts := &syncOptions{}
+	opts.build.Flags(fs)
+	fs.StringVar(&opts.branches, "branches", "HEAD", "git branches to index.")
+	fs.StringVar(&opts.branchPrefix, "prefix", "refs/heads/", "prefix for branch names")
+	fs.BoolVar(&opts.submodules, "submodules", true, "if set to false, do not recurse into submodules")
+	fs.BoolVar(&opts.allowMissing, "allow_missing_branches", false, "allow missing branches.")
+	fs.BoolVar(&opts.incremental, "incremental", true, "only index changed repositories")
+	fs.StringVar(&opts.repoCacheDir, "repo_cache", "", "directory holding bare git repos, named by URL. "+
+		"this is used to find repositories for submodules. "+
+		"It also affects name if the indexed repository is under this directory.")
+	fs.StringVar(&opts.languageMap, "language_map", "", "a mapping between a language and its ctags processor (a:0,b:3).")
+	fs.BoolVar(&opts.force, "f", false, "apply the planned changes; without it nothing is written or deleted")
+	fs.Usage = func() {
+		fmt.Fprint(fs.Output(), "Usage: "+name+" [options] <root>...\n\n")
+		fs.PrintDefaults()
+	}
+	return fs, opts
+}
+
+// runSync previews, or with -f applies, the synchronisation of the index
+// directory with the repositories below the roots.
+func runSync(args []string, out, errOut io.Writer) error {
+	fs, opts := newSyncFlagSet("zoekt-local-sync sync", errOut)
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	roots := fs.Args()
+	if len(roots) == 0 {
+		fs.Usage()
+		return errors.New("sync needs at least one root directory")
+	}
+
+	if opts.build.IndexDir == "" {
+		return errors.New("-index must be specified")
+	}
+
+	opts.build.LanguageMap = make(ctags.LanguageMap)
+	for mapping := range strings.SplitSeq(opts.languageMap, ",") {
+		m := strings.Split(mapping, ":")
+		if len(m) != 2 {
+			continue
+		}
+		opts.build.LanguageMap[m[0]] = ctags.StringToParser(m[1])
+	}
+
+	if opts.repoCacheDir != "" {
+		dir, err := filepath.Abs(opts.repoCacheDir)
+		if err != nil {
+			return err
+		}
+		opts.repoCacheDir = dir
+	}
+
+	var branches []string
+	if opts.branches != "" {
+		branches = strings.Split(opts.branches, ",")
+	}
+
+	opts.build.SetDefaults()
+
+	repositories, err := discoverRepositories(roots)
+	if err != nil {
+		return err
+	}
+
+	if opts.force {
+		if err := os.MkdirAll(opts.build.IndexDir, 0o755); err != nil {
+			return err
+		}
+		lock, err := acquireDirectoryLock(opts.build.IndexDir)
+		if err != nil {
+			return err
+		}
+		defer lock.Close()
+	}
+
+	shards, err := readInventory(opts.build.IndexDir)
+	if err != nil {
+		return err
+	}
+	records := recordsFromShards(shards)
+
+	var errs []error
+	for _, repo := range repositories {
+		buildOptions := opts.build
+		buildOptions.RepositoryDescription = zoekt.Repository{Name: repo.Name}
+
+		gitOpts := gitindex.Options{
+			RepoDir:            repo.Path,
+			Submodules:         opts.submodules,
+			Incremental:        opts.incremental,
+			AllowMissingBranch: opts.allowMissing,
+			RepoCacheDir:       opts.repoCacheDir,
+			BuildOptions:       buildOptions,
+			BranchPrefix:       opts.branchPrefix,
+			Branches:           branches,
+		}
+
+		state, err := gitindex.IndexState(gitOpts)
+		if err != nil {
+			fmt.Fprintf(errOut, "warning: checking index state for %s: %v\n", repo.Name, err)
+		} else if state == index.IndexStateEqual {
+			fmt.Fprintf(out, "Up to date %q\n", repo.Name)
+			continue
+		}
+
+		if !opts.force {
+			fmt.Fprintf(out, "Would index %q from %s\n", repo.Name, repo.Path)
+			continue
+		}
+
+		fmt.Fprintf(out, "Indexing %q from %s\n", repo.Name, repo.Path)
+		if _, err := gitindex.IndexGitRepo(gitOpts); err != nil {
+			fmt.Fprintf(errOut, "indexing %s: %v\n", repo.Name, err)
+			errs = append(errs, err)
+			continue
+		}
+		fmt.Fprintf(out, "Indexed %q\n", repo.Name)
+	}
+
+	discoveredNames := make(map[string]struct{}, len(repositories))
+	for _, repo := range repositories {
+		discoveredNames[repo.Name] = struct{}{}
+	}
+
+	removedShards := make(map[string]bool)
+	for _, rec := range records {
+		if _, ok := discoveredNames[rec.Name]; ok {
+			continue
+		}
+		for _, shardPath := range rec.Shards {
+			if removedShards[shardPath] {
+				continue
+			}
+			removedShards[shardPath] = true
+
+			if !opts.force {
+				fmt.Fprintf(out, "Would remove %s\n", shardPath)
+			} else {
+				fmt.Fprintf(out, "Removing %s\n", shardPath)
+				if err := removeShard(shardPath); err != nil {
+					fmt.Fprintf(errOut, "removing %s: %v\n", shardPath, err)
+					errs = append(errs, err)
+				}
+			}
+		}
+	}
+
+	if !opts.force {
+		fmt.Fprintln(out, "Pass -f to apply these changes.")
+	}
+
+	return errors.Join(errs...)
+}
+
+// runList prints the repositories currently in the index.
+func runList(args []string, out, errOut io.Writer) error {
+	fs := flag.NewFlagSet("zoekt-local-sync list", flag.ContinueOnError)
+	fs.SetOutput(errOut)
+	var indexDir string
+	fs.StringVar(&indexDir, "index", "", "directory for search indices")
+	fs.Usage = func() {
+		fmt.Fprint(fs.Output(), "Usage: zoekt-local-sync list [options]\n\n")
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	if len(fs.Args()) > 0 {
+		fs.Usage()
+		return errors.New("list takes no positional arguments")
+	}
+	if indexDir == "" {
+		return errors.New("-index must be specified")
+	}
+
+	shards, err := readInventory(indexDir)
+	if err != nil {
+		return err
+	}
+	records := recordsFromShards(shards)
+
+	w := tabwriter.NewWriter(out, 0, 8, 2, ' ', 0)
+	fmt.Fprintln(w, "NAME\tSOURCE\tSHARDS")
+	for _, rec := range records {
+		fmt.Fprintf(w, "%s\t%s\t%s\n", rec.Name, rec.Source, strings.Join(rec.Shards, ", "))
+	}
+	return w.Flush()
+}
+
+// runRemove previews, or with -f applies, the removal of the named
+// repositories from the index.
+func runRemove(args []string, out, errOut io.Writer) error {
+	fs := flag.NewFlagSet("zoekt-local-sync remove", flag.ContinueOnError)
+	fs.SetOutput(errOut)
+	var indexDir string
+	var force bool
+	fs.StringVar(&indexDir, "index", "", "directory for search indices")
+	fs.BoolVar(&force, "f", false, "apply the planned changes; without it nothing is written or deleted")
+	fs.Usage = func() {
+		fmt.Fprint(fs.Output(), "Usage: zoekt-local-sync remove [options] <repository>...\n\n")
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	targets := fs.Args()
+	if len(targets) == 0 {
+		fs.Usage()
+		return errors.New("remove needs at least one repository")
+	}
+	if indexDir == "" {
+		return errors.New("-index must be specified")
+	}
+
+	if force {
+		lock, err := acquireDirectoryLock(indexDir)
+		if err != nil {
+			return err
+		}
+		defer lock.Close()
+	}
+
+	shards, err := readInventory(indexDir)
+	if err != nil {
+		return err
+	}
+	records := recordsFromShards(shards)
+
+	var matchedShards []string
+	seenShards := make(map[string]bool)
+
+	for _, target := range targets {
+		targetClean := filepath.Clean(target)
+		matched := false
+		for _, rec := range records {
+			var sourceClean string
+			if rec.Source != "" {
+				sourceClean = filepath.Clean(rec.Source)
+			}
+			if rec.Name == target || (sourceClean != "" && sourceClean == targetClean) {
+				matched = true
+				for _, s := range rec.Shards {
+					if !seenShards[s] {
+						seenShards[s] = true
+						matchedShards = append(matchedShards, s)
+					}
+				}
+			}
+		}
+		if !matched {
+			return fmt.Errorf("no indexed repository matches %q", target)
+		}
+	}
+
+	if force {
+		var errs []error
+		for _, shardPath := range matchedShards {
+			fmt.Fprintf(out, "Removing %s\n", shardPath)
+			if err := removeShard(shardPath); err != nil {
+				errs = append(errs, err)
+			}
+		}
+		return errors.Join(errs...)
+	}
+
+	for _, shardPath := range matchedShards {
+		fmt.Fprintf(out, "Would remove %s\n", shardPath)
+	}
+	fmt.Fprintln(out, "Pass -f to apply these changes.")
+	return nil
+}
