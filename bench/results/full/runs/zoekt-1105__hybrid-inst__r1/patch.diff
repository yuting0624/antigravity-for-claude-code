+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+// repository is a git repository discovered below one of the roots.
+type repository struct {
+	// Name is derived from the repository path relative to its root.
+	Name string
+	// Path is the absolute path of the repository.
+	Path string
+}
+
+// discoverRepositories finds the git repositories below each root. A root
+// that is itself a repository is returned on its own. Names must be unique
+// across all roots, since they identify the repository in the index.
+func discoverRepositories(roots []string) ([]repository, error) {
+	cleanedRoots := make([]string, 0, len(roots))
+	for _, r := range roots {
+		root, err := filepath.Abs(r)
+		if err != nil {
+			return nil, fmt.Errorf("root %s: %w", r, err)
+		}
+		root = filepath.Clean(root)
+		fi, err := os.Stat(root)
+		if err != nil {
+			return nil, fmt.Errorf("root %s: %w", root, err)
+		}
+		if !fi.IsDir() {
+			return nil, fmt.Errorf("root %s is not a directory", root)
+		}
+		cleanedRoots = append(cleanedRoots, root)
+	}
+
+	var repos []repository
+	for _, root := range cleanedRoots {
+		if isRepository(root) {
+			name := strings.TrimSuffix(filepath.Base(root), ".git")
+			repos = append(repos, repository{
+				Name: name,
+				Path: root,
+			})
+			continue
+		}
+
+		err := filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			if path == root {
+				return nil
+			}
+			if d.IsDir() && d.Name() == ".git" {
+				return fs.SkipDir
+			}
+			if !d.IsDir() {
+				return nil
+			}
+			if isRepository(path) {
+				rel, err := filepath.Rel(root, path)
+				if err != nil {
+					return err
+				}
+				name := strings.TrimSuffix(filepath.ToSlash(rel), ".git")
+				repos = append(repos, repository{
+					Name: name,
+					Path: path,
+				})
+				return fs.SkipDir
+			}
+			return nil
+		})
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	seen := make(map[string]string, len(repos))
+	for _, repo := range repos {
+		if firstPath, ok := seen[repo.Name]; ok {
+			return nil, fmt.Errorf("duplicate repository name %q: %s and %s", repo.Name, firstPath, repo.Path)
+		}
+		seen[repo.Name] = repo.Path
+	}
+
+	sort.Slice(repos, func(i, j int) bool {
+		return repos[i].Name < repos[j].Name
+	})
+
+	return repos, nil
+}
+
+func isRepository(d string) bool {
+	if filepath.Base(d) == ".git" {
+		return false
+	}
+	if entryExists(filepath.Join(d, ".git")) {
+		return true
+	}
+	base := filepath.Base(d)
+	if strings.HasSuffix(base, ".git") && isDir(filepath.Join(d, "objects")) {
+		return true
+	}
+	if isDir(filepath.Join(d, "objects")) && isDir(filepath.Join(d, "refs")) && entryExists(filepath.Join(d, "HEAD")) {
+		return true
+	}
+	return false
+}
+
+func entryExists(path string) bool {
+	_, err := os.Lstat(path)
+	return err == nil
+}
+
+func isDir(path string) bool {
+	fi, err := os.Stat(path)
+	return err == nil && fi.IsDir()
+}
