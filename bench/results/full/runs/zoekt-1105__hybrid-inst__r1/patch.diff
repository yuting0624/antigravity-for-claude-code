+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+
+	"github.com/sourcegraph/zoekt"
+	"github.com/sourcegraph/zoekt/index"
+)
+
+// shard is an index shard together with the repositories stored in it.
+type shard struct {
+	// Path is the path of the .zoekt file.
+	Path string
+	// Repositories are the live repositories the shard holds. A compound
+	// shard holds more than one.
+	Repositories []*zoekt.Repository
+}
+
+// readInventory returns the index shards in indexDir, ordered by path.
+func readInventory(indexDir string) ([]shard, error) {
+	matches, err := filepath.Glob(filepath.Join(indexDir, "*.zoekt"))
+	if err != nil {
+		return nil, err
+	}
+	if len(matches) == 0 {
+		return nil, nil
+	}
+
+	shards := make([]shard, 0, len(matches))
+	for _, path := range matches {
+		repos, _, err := index.ReadMetadataPathAlive(path)
+		if err != nil {
+			return nil, fmt.Errorf("reading shard %q: %w", path, err)
+		}
+		shards = append(shards, shard{
+			Path:         path,
+			Repositories: repos,
+		})
+	}
+
+	return shards, nil
+}
+
+// record is a repository present in the index.
+type record struct {
+	// Name is the repository name stored in the shard metadata.
+	Name string
+	// Source is the path the repository was indexed from.
+	Source string
+	// Shards are the shards holding the repository, ordered by path.
+	Shards []string
+}
+
+// recordsFromShards groups shards by the repositories they hold, ordered by
+// repository name.
+func recordsFromShards(shards []shard) []record {
+	byName := make(map[string]*record)
+	for _, s := range shards {
+		for _, repo := range s.Repositories {
+			if repo == nil {
+				continue
+			}
+			rec, ok := byName[repo.Name]
+			if !ok {
+				rec = &record{
+					Name:   repo.Name,
+					Source: repo.Source,
+				}
+				byName[repo.Name] = rec
+			} else if rec.Source == "" && repo.Source != "" {
+				rec.Source = repo.Source
+			}
+			rec.Shards = append(rec.Shards, s.Path)
+		}
+	}
+
+	records := make([]record, 0, len(byName))
+	for _, rec := range byName {
+		records = append(records, *rec)
+	}
+
+	sort.Slice(records, func(i, j int) bool {
+		return records[i].Name < records[j].Name
+	})
+
+	return records
+}
+
+// removeShard deletes the shard at path together with its optional metadata
+// sidecar.
+func removeShard(path string) error {
+	paths, err := index.IndexFilePaths(path)
+	if err != nil {
+		return fmt.Errorf("%s: %w", path, err)
+	}
+	for _, p := range paths {
+		if err := os.Remove(p); err != nil && !os.IsNotExist(err) {
+			return fmt.Errorf("%s: %w", p, err)
+		}
+	}
+	return nil
+}
