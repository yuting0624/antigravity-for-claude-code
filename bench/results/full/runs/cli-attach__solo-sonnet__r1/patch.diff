new file mode 100644
index 000000000..2ff155a94
--- /dev/null
+++ b/internal/attachments/references.go
@@ -0,0 +1,821 @@
+package attachments
+
+import (
+	"fmt"
+	"net/url"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/yuin/goldmark"
+	"github.com/yuin/goldmark/ast"
+	"github.com/yuin/goldmark/text"
+)
+
+// attachmentArg is a resolved attachment ready to be woven into markdown: a
+// path to look for in the document, the URL it uploaded to (empty if it
+// hasn't uploaded yet), the alt text to use if none is written in the
+// markdown, and whether it renders as a video player rather than an image.
+type attachmentArg struct {
+	Path            string
+	URL             string
+	Alt             string
+	RendersAsPlayer bool
+}
+
+// attachAssetsResult is the outcome of weaving attachmentArgs into markdown.
+type attachAssetsResult struct {
+	Rewritten string
+	ToAppend  []attachmentArg
+}
+
+// attachableMarkdown is markdown that has been checked for shapes that
+// cannot be attached at all (a video embedded through a reference-style
+// image), ready to have assets woven into it.
+type attachableMarkdown struct {
+	markdown       string
+	attachmentArgs []attachmentArg
+}
+
+// newAttachableMarkdown parses markdown and refuses it outright if any
+// attachmentArg naming a video is embedded through a reference-style image,
+// since GitHub cannot render a video as an image.
+func newAttachableMarkdown(markdown string, attachmentArgs []attachmentArg) (attachableMarkdown, error) {
+	source := []byte(markdown)
+	root := goldmark.DefaultParser().Parse(text.NewReader(source))
+	blocks, defList, defIndex := collectBlocksAndDefinitions(root)
+
+	ctx := &scanContext{
+		defList:       defList,
+		defIndex:      defIndex,
+		args:          attachmentArgs,
+		used:          make([]bool, len(attachmentArgs)),
+		validateOnly:  true,
+		violationSeen: make([]bool, len(attachmentArgs)),
+	}
+	for _, blk := range blocks {
+		ctx.blockStart, ctx.blockEnd = blk.start, blk.end
+		rewriteSpan(source, blk.start, blk.end, blk.kind, ctx)
+	}
+
+	if len(ctx.violations) > 0 {
+		return attachableMarkdown{}, fmt.Errorf("cannot embed a video as a reference-style image: %s", strings.Join(ctx.violations, ", "))
+	}
+
+	return attachableMarkdown{markdown: markdown, attachmentArgs: attachmentArgs}, nil
+}
+
+// attachAssetsToMarkdown rewrites every reference to an attached file with
+// its uploaded URL, in place where the file is already referenced, and
+// reports every attached file that was never referenced so the caller can
+// append it.
+func attachAssetsToMarkdown(v attachableMarkdown) (attachAssetsResult, error) {
+	var args []attachmentArg
+	for _, a := range v.attachmentArgs {
+		if a.URL != "" {
+			args = append(args, a)
+		}
+	}
+
+	source := []byte(v.markdown)
+	root := goldmark.DefaultParser().Parse(text.NewReader(source))
+	blocks, defList, defIndex := collectBlocksAndDefinitions(root)
+
+	ctx := &scanContext{
+		defList:       defList,
+		defIndex:      defIndex,
+		args:          args,
+		used:          make([]bool, len(args)),
+		referencedDef: make([]bool, len(defList)),
+	}
+
+	type replacement struct {
+		start, end int
+		text       string
+	}
+	var replacements []replacement
+
+	for _, blk := range blocks {
+		ctx.blockStart, ctx.blockEnd = blk.start, blk.end
+		rewritten := rewriteSpan(source, blk.start, blk.end, blk.kind, ctx)
+		if rewritten != string(source[blk.start:blk.end]) {
+			replacements = append(replacements, replacement{blk.start, blk.end, rewritten})
+		}
+	}
+
+	// A reference-style usage only counts as having attached the file it
+	// names if the definition backing it can actually be rewritten; a
+	// definition that can't be safely located and replaced (see
+	// rewriteDefinition) leaves the file effectively unreferenced, so it is
+	// reported for appending instead of silently dropped.
+	for i, def := range defList {
+		if !ctx.referencedDef[i] {
+			continue
+		}
+		idx, matched := matchAttachment(decodeDestination(def.destination), args)
+		if !matched {
+			continue
+		}
+		rewritten, ok := rewriteDefinition(source, def, args[idx].URL)
+		if !ok {
+			continue
+		}
+		ctx.used[idx] = true
+		replacements = append(replacements, replacement{def.start, def.end, rewritten})
+	}
+
+	// A spare definition of an already-used file renders nothing on its
+	// own, but is rewritten alongside the one that is used, since it still
+	// names the file that got attached.
+	for i, def := range defList {
+		if ctx.referencedDef[i] {
+			continue
+		}
+		idx, matched := matchAttachment(decodeDestination(def.destination), args)
+		if !matched || !ctx.used[idx] {
+			continue
+		}
+		rewritten, ok := rewriteDefinition(source, def, args[idx].URL)
+		if !ok {
+			continue
+		}
+		replacements = append(replacements, replacement{def.start, def.end, rewritten})
+	}
+
+	sort.Slice(replacements, func(i, j int) bool { return replacements[i].start < replacements[j].start })
+
+	var b strings.Builder
+	pos := 0
+	for _, r := range replacements {
+		b.Write(source[pos:r.start])
+		b.WriteString(r.text)
+		pos = r.end
+	}
+	b.Write(source[pos:])
+
+	var toAppend []attachmentArg
+	for i, used := range ctx.used {
+		if !used {
+			toAppend = append(toAppend, args[i])
+		}
+	}
+
+	return attachAssetsResult{Rewritten: b.String(), ToAppend: toAppend}, nil
+}
+
+// isSingleImage reports whether markdown consists of exactly one image
+// pointing at url and nothing else.
+func isSingleImage(markdown, url string) bool {
+	source := []byte(markdown)
+	root := goldmark.DefaultParser().Parse(text.NewReader(source))
+	if root.ChildCount() != 1 {
+		return false
+	}
+	para, ok := root.FirstChild().(*ast.Paragraph)
+	if !ok || para.ChildCount() != 1 {
+		return false
+	}
+	img, ok := para.FirstChild().(*ast.Image)
+	if !ok {
+		return false
+	}
+	return string(img.Destination) == url
+}
+
+// scannableBlock is a leaf block (paragraph, heading, or the text block of a
+// tight list item) whose raw source span is scanned for references.
+type scannableBlock struct {
+	start, end int
+	kind       ast.NodeKind
+}
+
+// definitionInfo is a reference-style link definition's raw source span
+// alongside the label/destination/title goldmark parsed from it.
+type definitionInfo struct {
+	start, end  int
+	label       []byte
+	destination []byte
+	title       []byte
+}
+
+// collectBlocksAndDefinitions walks root once, collecting every scannable
+// block and every reference-style link definition. Code blocks and spans are
+// never collected, so they are never scanned.
+func collectBlocksAndDefinitions(root ast.Node) ([]scannableBlock, []definitionInfo, map[string]int) {
+	var blocks []scannableBlock
+	var defList []definitionInfo
+	defIndex := map[string]int{}
+
+	_ = ast.Walk(root, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		switch n.Kind() {
+		case ast.KindParagraph, ast.KindHeading, ast.KindTextBlock:
+			if lines := n.Lines(); lines.Len() > 0 {
+				blocks = append(blocks, scannableBlock{
+					start: lines.At(0).Start,
+					end:   lines.At(lines.Len() - 1).Stop,
+					kind:  n.Kind(),
+				})
+			}
+			return ast.WalkSkipChildren, nil
+		case ast.KindCodeBlock, ast.KindFencedCodeBlock, ast.KindHTMLBlock:
+			return ast.WalkSkipChildren, nil
+		case ast.KindLinkReferenceDefinition:
+			def, _ := n.(*ast.LinkReferenceDefinition)
+			info := definitionInfo{label: def.Label, destination: def.Destination, title: def.Title}
+			if lines := def.Lines(); lines.Len() > 0 {
+				info.start = lines.At(0).Start
+				info.end = lines.At(lines.Len() - 1).Stop
+			} else {
+				info.start = def.Pos()
+				info.end = def.Pos()
+			}
+			defIndex[string(def.Label)] = len(defList)
+			defList = append(defList, info)
+			return ast.WalkSkipChildren, nil
+		}
+		return ast.WalkContinue, nil
+	})
+
+	return blocks, defList, defIndex
+}
+
+// scanContext threads the state a document-wide scan needs to make its
+// decisions: the definitions available to reference-style usages, the
+// attachments being woven in, which of them have been referenced, and (in
+// validation mode) which videos were embedded through a reference-style
+// image.
+type scanContext struct {
+	defList  []definitionInfo
+	defIndex map[string]int
+	args     []attachmentArg
+	used     []bool
+
+	// referencedDef records which definitions (by index into defList) were
+	// used by some reference-style occurrence. Whether that ends up
+	// counting as "used" for ToAppend purposes is decided later, once it's
+	// known whether the definition itself can actually be rewritten.
+	referencedDef []bool
+
+	// blockStart and blockEnd are the bounds of the top-level scannable
+	// block currently being scanned, used to decide whether an occurrence
+	// stands alone in its paragraph. They stay fixed across the recursive
+	// calls that process a nested label, unlike the start/end a particular
+	// call is scanning.
+	blockStart, blockEnd int
+
+	validateOnly  bool
+	violationSeen []bool
+	violations    []string
+}
+
+// rewriteSpan scans source[start:end), a single scannable block's raw byte
+// range, and returns it with every attached-file reference rewritten. Code
+// spans are left untouched; everything else is is copied through unchanged.
+func rewriteSpan(source []byte, start, end int, blockKind ast.NodeKind, ctx *scanContext) string {
+	var b strings.Builder
+	i := start
+	lastFlush := start
+
+	for i < end {
+		c := source[i]
+		switch {
+		case c == '\\' && i+1 < end:
+			i += 2
+		case c == '`':
+			runLen := 1
+			for i+runLen < end && source[i+runLen] == '`' {
+				runLen++
+			}
+			closeAt := findBacktickRun(source, i+runLen, end, runLen)
+			if closeAt == -1 {
+				i += runLen
+			} else {
+				i = closeAt + runLen
+			}
+		case c == '!' && i+1 < end && source[i+1] == '[':
+			occEnd, output, isOcc, droppedBang := processOccurrence(source, i, end, true, blockKind, ctx)
+			if !isOcc {
+				i++
+				continue
+			}
+			flushLiteral(&b, source, lastFlush, i, droppedBang)
+			b.WriteString(output)
+			lastFlush = occEnd
+			i = occEnd
+		case c == '[':
+			occEnd, output, isOcc, droppedBang := processOccurrence(source, i, end, false, blockKind, ctx)
+			if !isOcc {
+				i++
+				continue
+			}
+			flushLiteral(&b, source, lastFlush, i, droppedBang)
+			b.WriteString(output)
+			lastFlush = occEnd
+			i = occEnd
+		default:
+			i++
+		}
+	}
+
+	b.Write(source[lastFlush:end])
+	return b.String()
+}
+
+// flushLiteral writes source[lastFlush:occStart) to b. If droppedBang is set
+// and the byte immediately before occStart is an unescaped '!', that bang is
+// escaped instead of copied as-is, so removing the "!" that opened the
+// occurrence being written next cannot let this one pair with it and re-form
+// an embed.
+func flushLiteral(b *strings.Builder, source []byte, lastFlush, occStart int, droppedBang bool) {
+	if droppedBang && occStart > lastFlush && source[occStart-1] == '!' && !bangIsEscaped(source, occStart-1, lastFlush) {
+		b.Write(source[lastFlush : occStart-1])
+		b.WriteString(`\!`)
+		return
+	}
+	b.Write(source[lastFlush:occStart])
+}
+
+// bangIsEscaped reports whether the '!' at pos is already escaped, i.e.
+// preceded by an odd number of backslashes.
+func bangIsEscaped(source []byte, pos, lowerBound int) bool {
+	n := 0
+	for pos-1-n >= lowerBound && source[pos-1-n] == '\\' {
+		n++
+	}
+	return n%2 == 1
+}
+
+// processOccurrence handles the "[" or "![" at source[pos], which lies
+// within the current scan region [pos, blockEnd) (itself inside the
+// top-level block recorded on ctx). It returns the index just past the
+// occurrence, the text to replace it with, whether it turned out to be a
+// well-formed link or image at all, and whether that replacement drops the
+// leading "!" the occurrence started with.
+func processOccurrence(source []byte, pos, blockEnd int, isEmbed bool, blockKind ast.NodeKind, ctx *scanContext) (occEnd int, output string, isOcc bool, droppedBang bool) {
+	labelStart := pos + 1
+	if isEmbed {
+		labelStart = pos + 2
+	}
+	labelEnd, ok := findClosingBracket(source, labelStart, blockEnd)
+	if !ok {
+		return 0, "", false, false
+	}
+	afterLabel := labelEnd + 1
+
+	prefix := "["
+	if isEmbed {
+		prefix = "!["
+	}
+	// label lazily rewrites the occurrence's own label/alt text the first
+	// time it's needed. A video embed that turns into a bare URL discards
+	// its label entirely, so anything attached inside it must not be
+	// counted as referenced merely because this function looked at it.
+	label := func() string { return rewriteSpan(source, labelStart, labelEnd, blockKind, ctx) }
+
+	switch {
+	case afterLabel < blockEnd && source[afterLabel] == '(':
+		destStart, destEnd, tokenStart, tokenEnd, closeParen, ok := parseInlineDestination(source, afterLabel+1, blockEnd)
+		if !ok {
+			return 0, "", false, false
+		}
+		occEnd = closeParen + 1
+
+		decoded := decodeDestination(source[destStart:destEnd])
+		idx, matched := matchAttachment(decoded, ctx.args)
+		if !matched {
+			return occEnd, prefix + label() + "]" + string(source[afterLabel:occEnd]), true, false
+		}
+		arg := ctx.args[idx]
+		// Everything but the destination token itself (whitespace, a
+		// title) is carried over verbatim; the destination, angle brackets
+		// included when present, is always fully replaced.
+		rest := string(source[afterLabel+1:tokenStart]) + arg.URL + string(source[tokenEnd:closeParen])
+
+		if isEmbed && arg.RendersAsPlayer {
+			alone := blockKind == ast.KindParagraph &&
+				isBlank(source[ctx.blockStart:pos]) && isBlank(source[occEnd:ctx.blockEnd])
+			ctx.used[idx] = true
+			if alone {
+				return occEnd, arg.URL, true, true
+			}
+			linkLabel := label()
+			if labelStart == labelEnd {
+				linkLabel = escapeAlt(arg.Alt)
+			}
+			return occEnd, "[" + linkLabel + "](" + arg.URL + ")", true, true
+		}
+		ctx.used[idx] = true
+		return occEnd, prefix + label() + "](" + rest + ")", true, false
+
+	case afterLabel < blockEnd && source[afterLabel] == '[':
+		ref2Start := afterLabel + 1
+		ref2End, ok := findClosingBracket(source, ref2Start, blockEnd)
+		if !ok {
+			return 0, "", false, false
+		}
+		occEnd = ref2End + 1
+
+		labelKey := source[ref2Start:ref2End]
+		if len(labelKey) == 0 {
+			labelKey = source[labelStart:labelEnd]
+		}
+		markReferenceUsage(ctx, labelKey, isEmbed)
+		return occEnd, prefix + label() + "]" + string(source[afterLabel:occEnd]), true, false
+
+	default:
+		occEnd = afterLabel
+		markReferenceUsage(ctx, source[labelStart:labelEnd], isEmbed)
+		return occEnd, prefix + label() + "]", true, false
+	}
+}
+
+// markReferenceUsage resolves a reference-style usage's label to a
+// definition and, if that definition's destination names an attachment,
+// records that the definition was used (or, in validation mode, flags it if
+// the usage embeds a video, which GitHub cannot render as an image).
+func markReferenceUsage(ctx *scanContext, labelKey []byte, isEmbed bool) {
+	idx, ok := ctx.defIndex[string(labelKey)]
+	if !ok {
+		return
+	}
+	def := ctx.defList[idx]
+	argIdx, matched := matchAttachment(decodeDestination(def.destination), ctx.args)
+	if !matched {
+		return
+	}
+
+	if ctx.validateOnly {
+		if isEmbed && ctx.args[argIdx].RendersAsPlayer && !ctx.violationSeen[argIdx] {
+			ctx.violationSeen[argIdx] = true
+			ctx.violations = append(ctx.violations, ctx.args[argIdx].Path)
+		}
+		return
+	}
+
+	ctx.referencedDef[idx] = true
+}
+
+// rewriteDefinition replaces the destination of a reference-style link
+// definition with url, reconstructing its raw span from scratch and
+// refusing to touch it if that reconstruction doesn't agree with what
+// goldmark parsed there.
+func rewriteDefinition(source []byte, def definitionInfo, url string) (string, bool) {
+	span := source[def.start:def.end]
+	prefix := make([]byte, 0, len(def.label)+3)
+	prefix = append(prefix, '[')
+	prefix = append(prefix, def.label...)
+	prefix = append(prefix, ']', ':')
+	if !hasBytesPrefix(span, prefix) {
+		return "", false
+	}
+
+	i := def.start + len(prefix)
+	newlineSeen := false
+	for i < def.end {
+		c := source[i]
+		if c == ' ' || c == '\t' || c == '\r' {
+			i++
+			continue
+		}
+		if c == '\n' && !newlineSeen {
+			newlineSeen = true
+			i++
+			continue
+		}
+		break
+	}
+
+	destStart, destEnd, decoded, ok := parseDefinitionDestination(source, i, def.end)
+	if !ok || decoded != decodeDestination(def.destination) {
+		return "", false
+	}
+
+	return string(source[def.start:destStart]) + url + string(source[destEnd:def.end]), true
+}
+
+func hasBytesPrefix(s, prefix []byte) bool {
+	if len(s) < len(prefix) {
+		return false
+	}
+	for i := range prefix {
+		if s[i] != prefix[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// findClosingBracket finds the ']' matching an already-consumed '[' whose
+// content starts at source[start], honoring escapes, nested "[...]" pairs,
+// and code spans (which are skipped opaquely, since punctuation inside one
+// never has markdown meaning).
+func findClosingBracket(source []byte, start, end int) (int, bool) {
+	depth := 0
+	i := start
+	for i < end {
+		c := source[i]
+		switch {
+		case c == '\\' && i+1 < end:
+			i += 2
+		case c == '`':
+			runLen := 1
+			for i+runLen < end && source[i+runLen] == '`' {
+				runLen++
+			}
+			closeAt := findBacktickRun(source, i+runLen, end, runLen)
+			if closeAt == -1 {
+				i += runLen
+			} else {
+				i = closeAt + runLen
+			}
+		case c == '[':
+			depth++
+			i++
+		case c == ']':
+			if depth == 0 {
+				return i, true
+			}
+			depth--
+			i++
+		default:
+			i++
+		}
+	}
+	return 0, false
+}
+
+// findBacktickRun finds the offset of the next run of exactly runLen
+// backticks at or after from, or -1 if there is none before end.
+func findBacktickRun(source []byte, from, end, runLen int) int {
+	i := from
+	for i < end {
+		if source[i] != '`' {
+			i++
+			continue
+		}
+		j := i
+		n := 0
+		for j < end && source[j] == '`' {
+			n++
+			j++
+		}
+		if n == runLen {
+			return i
+		}
+		i = j
+	}
+	return -1
+}
+
+// parseInlineDestination parses a link destination and optional title
+// starting at source[pos], immediately after the inline form's opening "(".
+// destStart/destEnd bound the destination's decodable content; tokenStart/
+// tokenEnd bound the whole token as written, angle brackets included when
+// present, which is what a match replaces. ok is false if what follows
+// isn't a well-formed destination.
+func parseInlineDestination(source []byte, pos, end int) (destStart, destEnd, tokenStart, tokenEnd, closeParen int, ok bool) {
+	i := pos
+	for i < end && isBlankByte(source[i]) {
+		i++
+	}
+
+	if i < end && source[i] == '<' {
+		j := i + 1
+		for j < end {
+			if source[j] == '\\' && j+1 < end {
+				j += 2
+				continue
+			}
+			if source[j] == '>' {
+				break
+			}
+			if source[j] == '\n' {
+				return 0, 0, 0, 0, 0, false
+			}
+			j++
+		}
+		if j >= end || source[j] != '>' {
+			return 0, 0, 0, 0, 0, false
+		}
+		destStart, destEnd = i+1, j
+		tokenStart, tokenEnd = i, j+1
+		i = j + 1
+	} else {
+		destStart = i
+		depth := 0
+		for i < end {
+			c := source[i]
+			if c == '\\' && i+1 < end {
+				i += 2
+				continue
+			}
+			if c == '(' {
+				depth++
+				i++
+				continue
+			}
+			if c == ')' {
+				if depth == 0 {
+					break
+				}
+				depth--
+				i++
+				continue
+			}
+			if isBlankByte(c) {
+				break
+			}
+			i++
+		}
+		destEnd = i
+		tokenStart, tokenEnd = destStart, destEnd
+	}
+
+	for i < end && isBlankByte(source[i]) {
+		i++
+	}
+
+	if i < end && (source[i] == '"' || source[i] == '\'' || source[i] == '(') {
+		closeQuote := source[i]
+		if closeQuote == '(' {
+			closeQuote = ')'
+		}
+		j := i + 1
+		for j < end {
+			if source[j] == '\\' && j+1 < end {
+				j += 2
+				continue
+			}
+			if source[j] == closeQuote {
+				break
+			}
+			j++
+		}
+		if j >= end || source[j] != closeQuote {
+			return 0, 0, 0, 0, 0, false
+		}
+		i = j + 1
+		for i < end && isBlankByte(source[i]) {
+			i++
+		}
+	}
+
+	if i >= end || source[i] != ')' {
+		return 0, 0, 0, 0, 0, false
+	}
+	return destStart, destEnd, tokenStart, tokenEnd, i, true
+}
+
+// parseDefinitionDestination parses a link destination starting at
+// source[pos], which must immediately follow a definition's "[label]:" and
+// any permitted intervening whitespace. Unlike parseInlineDestination, the
+// returned span covers the destination as written, angle brackets included,
+// since the whole thing is what gets replaced.
+func parseDefinitionDestination(source []byte, pos, end int) (start, stop int, decoded string, ok bool) {
+	if pos < end && source[pos] == '<' {
+		j := pos + 1
+		for j < end {
+			if source[j] == '\\' && j+1 < end {
+				j += 2
+				continue
+			}
+			if source[j] == '>' {
+				break
+			}
+			if source[j] == '\n' {
+				return 0, 0, "", false
+			}
+			j++
+		}
+		if j >= end || source[j] != '>' {
+			return 0, 0, "", false
+		}
+		return pos, j + 1, decodeDestination(source[pos+1 : j]), true
+	}
+
+	i := pos
+	depth := 0
+	for i < end {
+		c := source[i]
+		if c == '\\' && i+1 < end {
+			i += 2
+			continue
+		}
+		if c == '(' {
+			depth++
+			i++
+			continue
+		}
+		if c == ')' {
+			if depth == 0 {
+				break
+			}
+			depth--
+			i++
+			continue
+		}
+		if isBlankByte(c) {
+			break
+		}
+		i++
+	}
+	if i == pos {
+		return 0, 0, "", false
+	}
+	return pos, i, decodeDestination(source[pos:i]), true
+}
+
+func isBlankByte(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '\f'
+}
+
+// isBlank reports whether b contains only whitespace (or is empty).
+func isBlank(b []byte) bool {
+	return len(strings.TrimSpace(string(b))) == 0
+}
+
+// decodeDestination undoes the two things a raw markdown destination can do
+// that a plain file path never does: escape punctuation with a backslash,
+// and percent-encode bytes.
+func decodeDestination(raw []byte) string {
+	s := unescapePunctuation(string(raw))
+	if decoded, err := url.PathUnescape(s); err == nil {
+		return decoded
+	}
+	return s
+}
+
+const asciiPunctuation = "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"
+
+func unescapePunctuation(s string) string {
+	if !strings.ContainsRune(s, '\\') {
+		return s
+	}
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\\' && i+1 < len(s) && strings.IndexByte(asciiPunctuation, s[i+1]) >= 0 {
+			b.WriteByte(s[i+1])
+			i++
+			continue
+		}
+		b.WriteByte(s[i])
+	}
+	return b.String()
+}
+
+// looksLikeRemoteReference reports whether a decoded destination is an
+// anchor, a protocol-relative URL, or has a URL scheme, none of which name a
+// local file, even if the text happens to match one letter for letter. A
+// single letter before the colon is let through, since that is how Windows
+// spells a volume rather than a scheme.
+func looksLikeRemoteReference(dest string) bool {
+	if strings.HasPrefix(dest, "#") || strings.HasPrefix(dest, "//") {
+		return true
+	}
+	colon := strings.IndexByte(dest, ':')
+	if colon < 2 {
+		return false
+	}
+	scheme := dest[:colon]
+	for i := 0; i < len(scheme); i++ {
+		c := scheme[i]
+		isAlpha := (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+		if i == 0 {
+			if !isAlpha {
+				return false
+			}
+			continue
+		}
+		if !isAlpha && !(c >= '0' && c <= '9') && c != '+' && c != '-' && c != '.' {
+			return false
+		}
+	}
+	return true
+}
+
+// matchAttachment finds the attachmentArg a decoded destination names, by
+// exact match or (for an absolute destination) by resolving a relative
+// attachment path to compare against it.
+func matchAttachment(decodedDest string, args []attachmentArg) (int, bool) {
+	if looksLikeRemoteReference(decodedDest) {
+		return -1, false
+	}
+	for i, a := range args {
+		if decodedDest == a.Path {
+			return i, true
+		}
+	}
+	absDest, err := filepath.Abs(decodedDest)
+	if err != nil {
+		return -1, false
+	}
+	for i, a := range args {
+		if absArg, err := filepath.Abs(a.Path); err == nil && absArg == absDest {
+			return i, true
+		}
+	}
+	return -1, false
+}
