diff --git a/internal/attachments/asset.go b/internal/attachments/asset.go
new file mode 100644
index 000000000..a7f867659
--- /dev/null
+++ b/internal/attachments/asset.go
@@ -0,0 +1,173 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+const (
+	maxImageBytes = 10 * 1024 * 1024
+	maxVideoBytes = 100 * 1024 * 1024
+)
+
+// openFile opens the file at path for reading. It is a variable so tests can
+// stub it without touching the filesystem.
+var openFile = func(path string) (io.ReadCloser, error) {
+	return os.Open(path)
+}
+
+// extensionContentType describes how a supported file extension is handled.
+type extensionContentType struct {
+	contentType string
+	isVideo     bool
+}
+
+var supportedExtensions = map[string]extensionContentType{
+	".png":  {contentType: "image/png"},
+	".jpg":  {contentType: "image/jpeg"},
+	".jpeg": {contentType: "image/jpeg"},
+	".gif":  {contentType: "image/gif"},
+	".webp": {contentType: "image/webp"},
+	".svg":  {contentType: "image/svg+xml"},
+	".mp4":  {contentType: "video/mp4", isVideo: true},
+	".mov":  {contentType: "video/quicktime", isVideo: true},
+	".webm": {contentType: "video/webm", isVideo: true},
+}
+
+// supportedExtensionNames lists the supported extensions (without the dot)
+// in the order they should be presented to a user.
+var supportedExtensionNames = []string{"png", "jpg", "jpeg", "gif", "webp", "svg", "mp4", "mov", "webm"}
+
+// asset is the shared data behind an image or video attachment.
+type asset struct {
+	path        string
+	alt         string
+	contentType string
+	info        fs.FileInfo
+}
+
+// Path returns the path as the user wrote it on the command line.
+func (a *asset) Path() string {
+	return a.path
+}
+
+func (a *asset) getAsset() *asset {
+	return a
+}
+
+// UserAsset is a validated file to attach: an imageAsset or a videoAsset.
+type UserAsset interface {
+	Path() string
+	markdown(url string) string
+	rendersAsPlayer() bool
+	getAsset() *asset
+}
+
+type imageAsset struct {
+	asset
+}
+
+func (a *imageAsset) markdown(url string) string {
+	return fmt.Sprintf("![%s](%s)", escapeAlt(a.alt), url)
+}
+
+func (a *imageAsset) rendersAsPlayer() bool {
+	return false
+}
+
+type videoAsset struct {
+	asset
+}
+
+func (a *videoAsset) markdown(url string) string {
+	return url
+}
+
+func (a *videoAsset) rendersAsPlayer() bool {
+	return true
+}
+
+// escapeAlt makes alt text safe to place inside a markdown image label: it
+// escapes the characters that could otherwise close the label early or open
+// a new one, and collapses line breaks so the label cannot spill out of the
+// image.
+func escapeAlt(alt string) string {
+	var b strings.Builder
+	for _, r := range alt {
+		switch r {
+		case '\\', '[', ']':
+			b.WriteByte('\\')
+			b.WriteRune(r)
+		case '\n', '\r':
+			b.WriteByte(' ')
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+// newAsset validates path and alt and returns the UserAsset for it. Only
+// metadata is read; the file's contents are not opened.
+func newAsset(path, alt string) (UserAsset, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		var pathErr *fs.PathError
+		if errors.As(err, &pathErr) {
+			return nil, fmt.Errorf("%s: %w", path, pathErr.Err)
+		}
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+
+	if info.IsDir() {
+		return nil, fmt.Errorf("%s is a directory", path)
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%s is not a regular file", path)
+	}
+
+	ext := strings.ToLower(filepath.Ext(path))
+	kind, ok := supportedExtensions[ext]
+	if !ok {
+		return nil, fmt.Errorf("%s is not a supported file type (supported: %s)", path, strings.Join(supportedExtensionNames, ", "))
+	}
+
+	if kind.isVideo && alt != "" {
+		return nil, errors.New("cannot set alt text on video")
+	}
+
+	if info.Size() == 0 {
+		return nil, fmt.Errorf("%s is empty", path)
+	}
+
+	maxBytes := int64(maxImageBytes)
+	limitName := "images"
+	if kind.isVideo {
+		maxBytes = maxVideoBytes
+		limitName = "videos"
+	}
+	if info.Size() > maxBytes {
+		return nil, fmt.Errorf("%s: %s must be at most %.1f MB", path, limitName, float64(maxBytes)/(1024*1024))
+	}
+
+	if alt == "" {
+		base := filepath.Base(path)
+		if kind.isVideo {
+			alt = base
+		} else {
+			trimmed := strings.TrimSuffix(base, filepath.Ext(base))
+			alt = strings.ReplaceAll(trimmed, ".", " ")
+		}
+	}
+
+	a := asset{path: path, alt: alt, contentType: kind.contentType, info: info}
+	if kind.isVideo {
+		return &videoAsset{a}, nil
+	}
+	return &imageAsset{a}, nil
+}
diff --git a/internal/attachments/attach.go b/internal/attachments/attach.go
new file mode 100644
index 000000000..90fa17c98
--- /dev/null
+++ b/internal/attachments/attach.go
@@ -0,0 +1,79 @@
+package attachments
+
+import (
+	"context"
+	"strings"
+)
+
+// UploadAndAttach uploads each asset in order and rewrites body to reference
+// the uploaded URLs, in place where the file is already referenced and
+// appended as new paragraphs otherwise. It returns as much of the rewritten
+// body as could be produced, and how many assets uploaded, even when an
+// upload fails partway through.
+func (u *Uploader) UploadAndAttach(ctx context.Context, body string, assets []UserAsset) (string, int, error) {
+	if len(assets) == 0 {
+		return body, 0, nil
+	}
+
+	attachmentArgs := make([]attachmentArg, len(assets))
+	for i, a := range assets {
+		info := a.getAsset()
+		attachmentArgs[i] = attachmentArg{Path: info.path, Alt: info.alt, RendersAsPlayer: a.rendersAsPlayer()}
+	}
+
+	v, err := newAttachableMarkdown(body, attachmentArgs)
+	if err != nil {
+		return body, 0, err
+	}
+
+	uploaded := 0
+	var uploadErr error
+	for i, a := range assets {
+		assetURL, err := u.upload(ctx, a)
+		if err != nil {
+			uploadErr = err
+			break
+		}
+		v.attachmentArgs[i].URL = assetURL
+		uploaded++
+	}
+
+	result, attachErr := attachAssetsToMarkdown(v)
+	if attachErr != nil {
+		return body, uploaded, attachErr
+	}
+
+	newBody := result.Rewritten
+	for _, a := range result.ToAppend {
+		newBody = appendParagraph(newBody, a.markdown())
+	}
+
+	if uploadErr != nil {
+		return newBody, uploaded, uploadErr
+	}
+	return newBody, uploaded, nil
+}
+
+// markdown renders an unreferenced attachmentArg the way it would have been
+// written had the author referenced it: an image embed, or a bare URL for a
+// video so it renders as a player.
+func (a attachmentArg) markdown() string {
+	if a.RendersAsPlayer {
+		return a.URL
+	}
+	return "![" + escapeAlt(a.Alt) + "](" + a.URL + ")"
+}
+
+// appendParagraph adds addition as a new paragraph at the end of md,
+// separated by a single blank line. Trailing whitespace on md is trimmed
+// first so blank lines don't stack up.
+func appendParagraph(md, addition string) string {
+	if addition == "" {
+		return md
+	}
+	trimmed := strings.TrimRight(md, " \t\r\n")
+	if trimmed == "" {
+		return addition
+	}
+	return trimmed + "\n\n" + addition
+}
diff --git a/internal/attachments/client.go b/internal/attachments/client.go
new file mode 100644
index 000000000..43fad8a1e
--- /dev/null
+++ b/internal/attachments/client.go
@@ -0,0 +1,224 @@
+package attachments
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/cli/cli/v2/internal/gh"
+	"github.com/cli/cli/v2/internal/ghinstance"
+	ghauth "github.com/cli/go-gh/v2/pkg/auth"
+)
+
+// Uploader posts files to a host's user-attachments endpoint.
+type Uploader struct {
+	httpClient       *http.Client
+	host             string
+	targetRepository int64
+}
+
+// NewUploader builds an Uploader for host, refusing up front if uploads
+// cannot possibly succeed: GitHub Enterprise Server is not supported, the
+// credential kind cannot be used against the upload endpoint, the target
+// repository is unresolved, or the viewer's permission on it is too low.
+func NewUploader(httpClient *http.Client, tokenType gh.TokenType, host string, targetRepository int64, viewerPermission string) (*Uploader, error) {
+	if err := checkHost(host); err != nil {
+		return nil, err
+	}
+
+	switch tokenType {
+	case gh.TokenTypeOAuth, gh.TokenTypePersonalAccess, gh.TokenTypeFineGrainedPAT:
+		// these credential kinds are accepted by the upload endpoint
+	default:
+		return nil, errors.New("unsupported authentication type")
+	}
+
+	if targetRepository <= 0 {
+		return nil, errors.New("could not determine which repository to attach files to")
+	}
+
+	switch viewerPermission {
+	case "ADMIN", "MAINTAIN", "WRITE":
+		// sufficient
+	case "":
+		return nil, errors.New("could not determine your permission on the repository to attach files")
+	default:
+		return nil, errors.New("attaching files requires write access to the repository")
+	}
+
+	return &Uploader{httpClient: httpClient, host: host, targetRepository: targetRepository}, nil
+}
+
+// checkHost refuses hosts that the user-attachments endpoint does not exist
+// on: classic GitHub Enterprise Server. github.com, GHE.com tenants, and the
+// local development host are all fine.
+func checkHost(host string) error {
+	if ghauth.IsEnterprise(host) {
+		return errors.New("attaching files is not supported on GitHub Enterprise Server")
+	}
+	return nil
+}
+
+// upload posts a to the user-attachments endpoint and returns the asset URL.
+func (u *Uploader) upload(ctx context.Context, a UserAsset) (string, error) {
+	info := a.getAsset()
+
+	rc, err := openFile(info.path)
+	if err != nil {
+		return "", &uploadError{Path: info.path, Err: err}
+	}
+	defer rc.Close()
+
+	q := url.Values{}
+	q.Set("content_type", info.contentType)
+	q.Set("name", filepath.Base(info.path))
+	q.Set("repository_id", strconv.FormatInt(u.targetRepository, 10))
+
+	uploadURL := ghinstance.UserAssetUploadPrefix(u.host) + "user-attachments/assets?" + q.Encode()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, uploadURL, rc)
+	if err != nil {
+		return "", &uploadError{Path: info.path, Err: err}
+	}
+	req.ContentLength = info.info.Size()
+	req.Header.Set("Content-Type", "application/octet-stream")
+	req.Header.Set("Accept", "application/vnd.github+json")
+
+	resp, err := u.httpClient.Do(req)
+	if err != nil {
+		return "", &uploadError{Path: info.path, Err: err}
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode >= 300 {
+		return "", newUploadError(info.path, resp)
+	}
+
+	var result struct {
+		URL string `json:"url"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
+		return "", &uploadError{Path: info.path, Err: err}
+	}
+	if result.URL == "" {
+		return "", &uploadError{Path: info.path, Message: "the server returned no asset URL"}
+	}
+	return result.URL, nil
+}
+
+// uploadError describes why an upload of the file at Path failed.
+type uploadError struct {
+	Path       string
+	StatusCode int
+	// Message, when set, is the whole actionable reason and is used as-is.
+	Message string
+	// Err, when set instead of Message, is a lower-level cause reported
+	// as-is; it marks the error as not directly actionable by the user.
+	Err error
+	// actionable selects the "could not upload" prefix over "failed to
+	// upload" for reasons a user can do something about.
+	actionable bool
+}
+
+func (e *uploadError) Error() string {
+	prefix := "failed to upload"
+	if e.actionable {
+		prefix = "could not upload"
+	}
+
+	reason := e.Message
+	if e.Err != nil {
+		reason = e.Err.Error()
+	}
+	if reason == "" {
+		return fmt.Sprintf("%s %s", prefix, e.Path)
+	}
+	return fmt.Sprintf("%s %s: %s", prefix, e.Path, reason)
+}
+
+func (e *uploadError) Unwrap() error {
+	return e.Err
+}
+
+// newUploadError builds the error for a non-2xx response from the upload
+// endpoint. Known statuses get an actionable, user-facing message; anything
+// else falls back to the server's own words.
+func newUploadError(path string, resp *http.Response) *uploadError {
+	var body struct {
+		Message string `json:"message"`
+		Errors  []struct {
+			Resource string `json:"resource"`
+			Field    string `json:"field"`
+			Code     string `json:"code"`
+			Message  string `json:"message"`
+		} `json:"errors"`
+	}
+	_ = json.NewDecoder(resp.Body).Decode(&body)
+
+	switch resp.StatusCode {
+	case http.StatusNotFound:
+		return &uploadError{
+			Path:       path,
+			StatusCode: resp.StatusCode,
+			actionable: true,
+			Message:    "attaching files requires write access to the repository",
+		}
+
+	case http.StatusTooManyRequests:
+		retryAfter := resp.Header.Get("Retry-After")
+		var reason string
+		switch {
+		case retryAfter == "":
+			reason = "wait and try again"
+		default:
+			if secs, err := strconv.Atoi(retryAfter); err == nil {
+				reason = fmt.Sprintf("retry after %d seconds", secs)
+			} else {
+				reason = fmt.Sprintf("retry after %s", retryAfter)
+			}
+		}
+		return &uploadError{
+			Path:       path,
+			StatusCode: resp.StatusCode,
+			actionable: true,
+			Message:    "rate limited; " + reason,
+		}
+
+	case http.StatusUnprocessableEntity:
+		var parts []string
+		if body.Message != "" {
+			parts = append(parts, body.Message)
+		}
+		for _, e := range body.Errors {
+			switch {
+			case e.Message != "":
+				parts = append(parts, e.Message)
+			case e.Resource != "" && e.Field != "" && e.Code != "":
+				parts = append(parts, fmt.Sprintf("%s.%s is %s", e.Resource, e.Field, e.Code))
+			}
+		}
+		return &uploadError{
+			Path:       path,
+			StatusCode: resp.StatusCode,
+			actionable: true,
+			Message:    strings.Join(parts, "; "),
+		}
+
+	default:
+		message := body.Message
+		if message == "" {
+			message = http.StatusText(resp.StatusCode)
+		}
+		return &uploadError{
+			Path:       path,
+			StatusCode: resp.StatusCode,
+			Message:    fmt.Sprintf("HTTP %d: %s", resp.StatusCode, message),
+		}
+	}
+}
diff --git a/internal/attachments/flags.go b/internal/attachments/flags.go
new file mode 100644
index 000000000..cafce1c57
--- /dev/null
+++ b/internal/attachments/flags.go
@@ -0,0 +1,109 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"os"
+
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+)
+
+const flagName = "attach"
+
+// Flag wraps the --attach flag registered on a cobra command.
+type Flag struct {
+	flag   *pflag.Flag
+	values *[]string
+}
+
+// AddFlag registers a repeatable --attach <file>[#<alt text>] flag on cmd.
+func AddFlag(cmd *cobra.Command) *Flag {
+	values := cmd.Flags().StringArray(flagName, []string{}, "Attach an image or video `file`, in '<file>#<image alt text>' format")
+	return &Flag{
+		flag:   cmd.Flags().Lookup(flagName),
+		values: values,
+	}
+}
+
+// Changed reports whether --attach was passed at least once.
+func (f *Flag) Changed() bool {
+	return f.flag.Changed
+}
+
+// UserAssets resolves and validates every --attach value into a UserAsset,
+// in the order they were written. It refuses an empty value, standard input,
+// and any path that names the same file as another --attach value.
+func (f *Flag) UserAssets() ([]UserAsset, error) {
+	values := *f.values
+
+	var assets []UserAsset
+	for _, v := range values {
+		if v == "" {
+			return nil, errors.New("cannot attach an empty path; --attach needs a file path")
+		}
+		if v == "-" {
+			return nil, errors.New("cannot attach standard input; --attach needs a file path")
+		}
+
+		path, alt := splitPathAndAlt(v)
+		a, err := newAsset(path, alt)
+		if err != nil {
+			return nil, err
+		}
+
+		for _, existing := range assets {
+			if os.SameFile(existing.getAsset().info, a.getAsset().info) {
+				return nil, fmt.Errorf("%s and %s are the same file; attached files must be unique", existing.Path(), a.Path())
+			}
+		}
+
+		assets = append(assets, a)
+	}
+
+	return assets, nil
+}
+
+// splitPathAndAlt splits a raw --attach value into a path and alt text. A
+// value may contain any number of '#' characters, in the path, in the alt
+// text, or both, so the split point is chosen by trying every possible split
+// (including no split at all) and keeping the longest candidate path that
+// exists on disk. If none of them exist, the last '#' is used as the split
+// point so the resulting "file not found" error names the path the author
+// most likely meant.
+func splitPathAndAlt(v string) (path, alt string) {
+	type candidate struct {
+		path string
+		alt  string
+	}
+
+	candidates := []candidate{{path: v}}
+	var hashIndexes []int
+	for i, r := range v {
+		if r == '#' {
+			hashIndexes = append(hashIndexes, i)
+			candidates = append(candidates, candidate{path: v[:i], alt: v[i+1:]})
+		}
+	}
+
+	best := candidate{}
+	bestLen := -1
+	for _, c := range candidates {
+		if _, err := os.Stat(c.path); err != nil {
+			continue
+		}
+		if len(c.path) > bestLen {
+			bestLen = len(c.path)
+			best = c
+		}
+	}
+	if bestLen >= 0 {
+		return best.path, best.alt
+	}
+
+	if len(hashIndexes) == 0 {
+		return v, ""
+	}
+	last := hashIndexes[len(hashIndexes)-1]
+	return v[:last], v[last+1:]
+}
