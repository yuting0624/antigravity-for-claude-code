--- /dev/null
+++ b/internal/attachments/testhelpers.go
@@ -0,0 +1,66 @@
+package attachments
+
+import (
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/httpmock"
+	"github.com/stretchr/testify/require"
+)
+
+// NewTestAssets creates a real, valid file for each of paths in a temporary
+// working directory and returns the UserAssets they resolve to, for tests
+// in other packages that need attached files without exercising --attach's
+// own flag parsing. Each asset's Path is "./" plus the name as given, so
+// error messages read the way a user's own --attach paths would.
+func NewTestAssets(t *testing.T, paths ...string) []UserAsset {
+	t.Helper()
+
+	t.Chdir(t.TempDir())
+	var assets []UserAsset
+	for _, p := range paths {
+		require.NoError(t, os.WriteFile(p, []byte("the bytes"), 0o600))
+		a, err := newAsset("./"+p, "")
+		require.NoError(t, err)
+		assets = append(assets, a)
+	}
+	return assets
+}
+
+// UploadStub describes one stubbed response from the user-attachments
+// upload endpoint, for tests in other packages.
+type UploadStub struct {
+	Name   string
+	Status int
+	Body   string
+}
+
+// StubUpload registers a stub for the next upload of a file named name to
+// repositoryID's user-attachments endpoint, on whatever host it lands on.
+func StubUpload(reg *httpmock.Registry, repositoryID int64, name string, status int, body string) {
+	matcher := httpmock.QueryMatcher("POST", "user-attachments/assets", url.Values{
+		"name":          []string{name},
+		"repository_id": []string{strconv.FormatInt(repositoryID, 10)},
+	})
+	reg.Register(matcher, httpmock.StatusStringResponse(status, body))
+}
+
+// StubUploadToHost is StubUpload for an upload expected to land on a
+// specific upload host, such as a tenant's, so a request sent to the wrong
+// host fails the test with "no registered HTTP stubs matched" instead of
+// silently succeeding against the wrong endpoint.
+func StubUploadToHost(t *testing.T, reg *httpmock.Registry, host string, repositoryID int64, name string, status int, body string) {
+	t.Helper()
+
+	query := httpmock.QueryMatcher("POST", "user-attachments/assets", url.Values{
+		"name":          []string{name},
+		"repository_id": []string{strconv.FormatInt(repositoryID, 10)},
+	})
+	matcher := func(req *http.Request) bool {
+		return req.URL.Host == host && query(req)
+	}
+	reg.Register(matcher, httpmock.StatusStringResponse(status, body))
+}
