+func TestClientWorktreeAdd(t *testing.T) {
+	tests := []struct {
+		name         string
+		path         string
+		branch       string
+		remoteBranch string
+		wantCmdArgs  string
+	}{
+		{
+			name:        "existing local branch",
+			path:        "/path/to/wt",
+			branch:      "feature",
+			wantCmdArgs: "path/to/git worktree add -- /path/to/wt feature",
+		},
+		{
+			name:         "new tracking branch",
+			path:         "/path/to/wt",
+			branch:       "feature",
+			remoteBranch: "origin/feature",
+			wantCmdArgs:  "path/to/git worktree add --track -b feature -- /path/to/wt origin/feature",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cmd, cmdCtx := createCommandContext(t, 0, "", "")
