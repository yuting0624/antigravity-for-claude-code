+				GitPath:        "path/to/git",
+				commandContext: cmdCtx,
+			}
+
+			err := client.WorktreeAdd(context.Background(), tt.path, tt.branch, tt.remoteBranch)
+
+			require.NoError(t, err)
+			assert.Equal(t, tt.wantCmdArgs, strings.Join(cmd.Args[3:], " "))
+		})
+	}
+}
