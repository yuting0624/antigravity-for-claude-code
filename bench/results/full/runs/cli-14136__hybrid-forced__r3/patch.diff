@@ -288,6 +288,23 @@ func (c *Client) WorktreeRemove(ctx context.Context, path string) error {
 	return err
 }
 
+// WorktreeAdd checks branch out in a new worktree at path via
+// `git worktree add`. When remoteBranch is empty the branch already exists
+// locally; otherwise the branch is created in the new worktree tracking
+// remoteBranch (e.g. "origin/feature").
+func (c *Client) WorktreeAdd(ctx context.Context, path, branch, remoteBranch string) error {
+	args := []string{"worktree", "add", "--", path, branch}
+	if remoteBranch != "" {
+		args = []string{"worktree", "add", "--track", "-b", branch, "--", path, remoteBranch}
+	}
+	cmd, err := c.Command(ctx, args...)
+	if err != nil {
+		return err
+	}
+	_, err = cmd.Output()
+	return err
+}
+
 // parseWorktrees parses the output of `git worktree list --porcelain` into a
 // slice of Worktree. Each record begins with a "worktree <path>" line followed
 // by attribute lines; attributes other than "branch" are ignored.
