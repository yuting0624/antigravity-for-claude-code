+	// never pushed past it. Default 1m; set to a negative value to disable.
+	ReadIdleTimeout caddy.Duration `json:"read_idle_timeout,omitempty"`
+
+	// WriteIdleTimeout is the same as ReadIdleTimeout but for writing the
+	// response to the client: the deadline is reset on every successful write
+	// and, if WriteTimeout is also set, never pushed past it.
