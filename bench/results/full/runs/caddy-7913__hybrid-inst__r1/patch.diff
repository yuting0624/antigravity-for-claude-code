diff --git a/modules/caddyhttp/idletimeout.go b/modules/caddyhttp/idletimeout.go
new file mode 100644
index 000000000..78ccd539c
--- /dev/null
+++ b/modules/caddyhttp/idletimeout.go
@@ -0,0 +1,227 @@
+// Copyright 2015 Matthew Holt and The Caddy Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package caddyhttp
+
+import (
+	"io"
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zapcore"
+)
+
+// DefaultMaxWriteChunk is the default maximum number of bytes written in a single
+// underlying Write or ReadFrom call before resetting the idle deadline.
+const DefaultMaxWriteChunk = 64 * 1024
+
+// IdleDeadline configures idle-reset deadlines for reading or writing.
+//
+// Caddy hard read/write timeouts bound a whole transfer, so a slowloris client
+// that keeps trickling bytes defeats them from below. These types provide
+// idle-reset deadlines: the deadline is pushed forward on every successful read
+// or write, so a stalled connection is cut while a slow-but-progressing one
+// survives. An optional minimum transfer rate additionally catches a trickle
+// that never stalls but never sustains a useful rate.
+type IdleDeadline struct {
+	Start        time.Time     // when the transfer started; zero means set on first use
+	Timeout      time.Duration // idle window, reset on every successful read/write
+	HardDeadline time.Time     // optional absolute ceiling; zero means none
+	MinRate      int64         // optional minimum transfer rate in bytes/second; 0 disables
+}
+
+// next computes the deadline to set before the next read or write,
+// given the total number of bytes transferred so far. A zero time
+// means no deadline at all. If MinRate is set, the deadline grows
+// from Start in proportion to the bytes already transferred, so a
+// transfer that sustains the rate always stays ahead of it; otherwise
+// the deadline is simply the idle window from now. A non-zero
+// HardDeadline always caps the result.
+func (d IdleDeadline) next(transferred int64) time.Time {
+	if d.Timeout <= 0 && d.MinRate <= 0 {
+		return d.HardDeadline // zero time means no deadline
+	}
+	var t time.Time
+	if d.MinRate > 0 {
+		start := d.Start
+		if start.IsZero() {
+			start = time.Now()
+		}
+		credit := time.Duration(float64(transferred) / float64(d.MinRate) * float64(time.Second))
+		t = start.Add(d.Timeout + credit)
+	} else {
+		t = time.Now().Add(d.Timeout)
+	}
+	if !d.HardDeadline.IsZero() && t.After(d.HardDeadline) {
+		t = d.HardDeadline
+	}
+	return t
+}
+
+// IdleTimeoutReader wraps a request body and resets the read deadline on
+// the underlying connection before every read, so that a client which keeps
+// making progress is never cut off, but one which stalls (or, with a MinRate,
+// merely trickles) is.
+type IdleTimeoutReader struct {
+	io.ReadCloser
+
+	// Ctrl forwards the deadline to the underlying connection; it works
+	// for HTTP/1.1, HTTP/2 and HTTP/3 alike.
+	Ctrl *http.ResponseController
+
+	// Deadline describes the idle window, optional hard ceiling and
+	// optional minimum read rate.
+	Deadline IdleDeadline
+
+	// Logger, if not nil, receives errors from setting the deadline.
+	Logger *zap.Logger
+
+	read       int64
+	started    bool
+	deadlineNA bool
+}
+
+// Read implements io.Reader. It refreshes the read deadline before
+// delegating to the wrapped body.
+func (r *IdleTimeoutReader) Read(p []byte) (int, error) {
+	if !r.started {
+		r.started = true
+		if r.Deadline.Start.IsZero() {
+			r.Deadline.Start = time.Now()
+		}
+	}
+	if !r.deadlineNA {
+		if err := r.Ctrl.SetReadDeadline(r.Deadline.next(r.read)); err != nil {
+			// the underlying connection doesn't support deadlines; there is no
+			// point trying again for every subsequent read, nor logging it again
+			r.deadlineNA = true
+			if r.Logger != nil {
+				if c := r.Logger.Check(zapcore.ErrorLevel, "could not set read deadline"); c != nil {
+					c.Write(zap.Error(err))
+				}
+			}
+		}
+	}
+	n, err := r.ReadCloser.Read(p)
+	r.read += int64(n)
+	return n, err
+}
+
+// IdleTimeoutWriter wraps a response writer and resets the write deadline on
+// the underlying connection before every chunk it writes, so that a client
+// which keeps consuming the response is never cut off, but one which stalls
+// (or, with a MinRate, merely trickles) is.
+type IdleTimeoutWriter struct {
+	*ResponseWriterWrapper
+
+	// Ctrl forwards the deadline to the underlying connection; it works
+	// for HTTP/1.1, HTTP/2 and HTTP/3 alike.
+	Ctrl *http.ResponseController
+
+	// Deadline describes the idle window, optional hard ceiling and
+	// optional minimum write rate.
+	Deadline IdleDeadline
+
+	// MaxChunk is the largest number of bytes handed to the underlying
+	// writer in one call. If zero, DefaultMaxWriteChunk is used.
+	MaxChunk int
+
+	// Logger, if not nil, receives errors from setting the deadline.
+	Logger *zap.Logger
+
+	written    int64
+	started    bool
+	deadlineNA bool
+}
+
+func (w *IdleTimeoutWriter) maxChunk() int {
+	if w.MaxChunk > 0 {
+		return w.MaxChunk
+	}
+	return DefaultMaxWriteChunk
+}
+
+func (w *IdleTimeoutWriter) setDeadline() {
+	if !w.started {
+		w.started = true
+		if w.Deadline.Start.IsZero() {
+			w.Deadline.Start = time.Now()
+		}
+	}
+	if w.deadlineNA {
+		return
+	}
+	if err := w.Ctrl.SetWriteDeadline(w.Deadline.next(w.written)); err != nil {
+		// the underlying connection doesn't support deadlines; there is no
+		// point trying again for every subsequent chunk, nor logging it again
+		w.deadlineNA = true
+		if w.Logger != nil {
+			if c := w.Logger.Check(zapcore.ErrorLevel, "could not set write deadline"); c != nil {
+				c.Write(zap.Error(err))
+			}
+		}
+	}
+}
+
+// Write implements http.ResponseWriter. It splits p into chunks of at most
+// MaxChunk bytes and refreshes the write deadline before each one, since a
+// deadline bounds the whole write call it precedes, not just a stall inside it.
+func (w *IdleTimeoutWriter) Write(p []byte) (int, error) {
+	chunk := w.maxChunk()
+	total := 0
+	for {
+		w.setDeadline()
+		end := len(p)
+		if end-total > chunk {
+			end = total + chunk
+		}
+		n, err := w.ResponseWriterWrapper.Write(p[total:end])
+		total += n
+		w.written += int64(n)
+		if err != nil {
+			return total, err
+		}
+		if total >= len(p) {
+			return total, nil
+		}
+	}
+}
+
+// ReadFrom reads data from src and writes it to the underlying ResponseWriter
+// until EOF or error. Chunking is required because SetWriteDeadline bounds the
+// entire write call it precedes, not just a stall inside it, so one giant
+// ReadFrom could run far past a single deadline window.
+func (w *IdleTimeoutWriter) ReadFrom(src io.Reader) (int64, error) {
+	chunk := int64(w.maxChunk())
+	var total int64
+	for {
+		w.setDeadline()
+		n, err := w.ResponseWriterWrapper.ReadFrom(io.LimitReader(src, chunk))
+		total += n
+		w.written += n
+		if err != nil {
+			return total, err
+		}
+		if n < chunk {
+			return total, nil
+		}
+	}
+}
+
+var (
+	_ io.ReadCloser       = (*IdleTimeoutReader)(nil)
+	_ http.ResponseWriter = (*IdleTimeoutWriter)(nil)
+	_ io.ReaderFrom       = (*IdleTimeoutWriter)(nil)
+)
diff --git a/modules/caddyhttp/server.go b/modules/caddyhttp/server.go
index d8077463b..7d7309d2f 100644
--- a/modules/caddyhttp/server.go
+++ b/modules/caddyhttp/server.go
@@ -79,6 +79,38 @@ type Server struct {
 	// 5m is applied to help avoid resource exhaustion.
 	IdleTimeout caddy.Duration `json:"idle_timeout,omitempty"`
 
+	// ReadIdleTimeout is how long to allow a read from a client's upload to
+	// make no progress before the connection is cut. Unlike ReadTimeout, which
+	// bounds the whole upload, this deadline is reset on every successful read,
+	// so a slow-but-progressing client survives while a stalled one does not.
+	// This is what defeats slowloris uploads, which keep a hard timeout at bay
