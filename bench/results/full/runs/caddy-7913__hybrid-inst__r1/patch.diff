+package timeouts
+
+import (
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func init() {
+	caddy.RegisterModule(Timeouts{})
+}
+
+// Timeouts is a middleware that applies idle-reset read and write deadlines to a single route.
+// These deadlines are reset on every successful read or write, so a stalled connection is cut
+// while a slow-but-progressing one survives; the optional minimum rate also catches a trickle
+// that never stalls.
+type Timeouts struct {
+	// ReadTimeout is the idle timeout duration for reading the request body.
+	// The deadline is reset on every successful read, allowing slow-but-progressing
+	// transfers to survive while stalled connections are cut.
+	ReadTimeout time.Duration `json:"read_timeout,omitempty"`
+
+	// ReadMinRate is the optional minimum transfer rate in bytes per second for reading
+	// the request body. If configured, it ensures that a trickle transfer that never stalls
+	// but never sustains a useful rate is eventually timed out.
+	ReadMinRate int64 `json:"read_min_rate,omitempty"`
+
+	// WriteTimeout is the idle timeout duration for writing the response body.
+	// The deadline is reset on every successful write, allowing slow-but-progressing
+	// transfers to survive while stalled connections are cut.
+	WriteTimeout time.Duration `json:"write_timeout,omitempty"`
+
+	// WriteMinRate is the optional minimum transfer rate in bytes per second for writing
+	// the response body. If configured, it ensures that a trickle transfer that never stalls
+	// but never sustains a useful rate is eventually timed out.
+	WriteMinRate int64 `json:"write_min_rate,omitempty"`
+
+	// MaxWriteChunk is the maximum number of bytes written in a single chunk before
+	// resetting the write deadline. If zero, DefaultMaxWriteChunk is used.
+	MaxWriteChunk int `json:"max_write_chunk,omitempty"`
+
+	logger *zap.Logger
+}
+
+// CaddyModule returns the Caddy module information.
+func (Timeouts) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{
+		ID:  "http.handlers.timeouts",
+		New: func() caddy.Module { return new(Timeouts) },
+	}
+}
+
+// Provision sets up the Timeouts middleware handler.
+func (t *Timeouts) Provision(ctx caddy.Context) error {
+	t.logger = ctx.Logger()
+	return nil
+}
+
+// ServeHTTP implements caddyhttp.MiddlewareHandler. It wraps the request body and/or
+// response writer with idle-reset deadlines, so a stalled connection is cut while a
+// slow-but-progressing one survives; the optional minimum rate also catches a trickle
+// that never stalls.
+func (t Timeouts) ServeHTTP(w http.ResponseWriter, r *http.Request, next caddyhttp.Handler) error {
+	if t.ReadTimeout <= 0 && t.WriteTimeout <= 0 {
+		return next.ServeHTTP(w, r)
+	}
+	logger := t.logger
+	if logger == nil {
+		logger = zap.NewNop()
+	}
+	ctrl := http.NewResponseController(w) //nolint:bodyclose
+	start := time.Now()
+	if t.ReadTimeout > 0 && r.Body != nil {
+		r.Body = &caddyhttp.IdleTimeoutReader{
+			ReadCloser: r.Body,
+			Ctrl:       ctrl,
+			Deadline:   caddyhttp.IdleDeadline{Start: start, Timeout: t.ReadTimeout, MinRate: t.ReadMinRate},
+			Logger:     logger,
+		}
+	}
+	if t.WriteTimeout > 0 {
+		w = &caddyhttp.IdleTimeoutWriter{
+			ResponseWriterWrapper: &caddyhttp.ResponseWriterWrapper{ResponseWriter: w},
+			Ctrl:                  ctrl,
+			Deadline:              caddyhttp.IdleDeadline{Start: start, Timeout: t.WriteTimeout, MinRate: t.WriteMinRate},
+			MaxChunk:              t.MaxWriteChunk,
+			Logger:                logger,
+		}
+	}
+	return next.ServeHTTP(w, r)
+}
+
+// Interface guards
+var (
+	_ caddy.Provisioner           = (*Timeouts)(nil)
+	_ caddyhttp.MiddlewareHandler = (*Timeouts)(nil)
+)
