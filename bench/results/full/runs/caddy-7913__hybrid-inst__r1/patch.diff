+	// above it completes even if it exceeds the idle window. 0 disables.
+	ReadMinRate int64 `json:"read_min_rate,omitempty"`
+
+	// WriteMinRate is the same as ReadMinRate but for writing responses. 0 disables.
+	WriteMinRate int64 `json:"write_min_rate,omitempty"`
+
+	// MaxWriteChunk is the largest number of bytes written to the connection in
+	// a single call while a write idle deadline is in effect. A deadline bounds
+	// the whole write it precedes, not just a stall inside it, so large writes
+	// are split into chunks with the deadline reset between them.
+	// If zero, DefaultMaxWriteChunk (64 KiB) is used.
+	MaxWriteChunk int `json:"max_write_chunk,omitempty"`
+
 	// KeepAliveInterval is the interval at which TCP keepalive packets
 	// are sent to keep the connection alive at the TCP layer when no other
 	// data is being transmitted.
@@ -532,6 +564,48 @@ func (s *Server) ServeHTTP(w http.ResponseWriter, r *http.Request) {
 		}
 	}
 
+	// apply idle-reset read/write deadlines: unlike the hard ReadTimeout and
+	// WriteTimeout, which bound a whole transfer, these are pushed forward on
+	// every successful read or write, so a stalled connection is cut while a
+	// slow-but-progressing one survives (and a hard timeout, if configured,
+	// still caps how far they can be pushed)
+	if s.ReadIdleTimeout > 0 || s.WriteIdleTimeout > 0 {
+		ctrl := http.NewResponseController(w) //nolint:bodyclose
+		if s.ReadIdleTimeout > 0 && r.Body != nil {
+			deadline := IdleDeadline{
+				Start:   start,
+				Timeout: time.Duration(s.ReadIdleTimeout),
+				MinRate: s.ReadMinRate,
+			}
+			if s.ReadTimeout > 0 {
