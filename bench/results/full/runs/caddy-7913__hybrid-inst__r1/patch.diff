+		}
+		if s.WriteIdleTimeout > 0 {
+			deadline := IdleDeadline{
+				Start:   start,
+				Timeout: time.Duration(s.WriteIdleTimeout),
+				MinRate: s.WriteMinRate,
+			}
+			if s.WriteTimeout > 0 {
