+// SetCookieFilter is a Caddy log field filter that filters
+// cookies set via the Set-Cookie response header.
+//
+// This filter updates the logged Set-Cookie header values
+// to remove, replace or hash cookies containing sensitive data. For instance,
+// it can be used to redact any kind of secrets, such as session IDs.
+//
+// Unlike the Cookie header, each Set-Cookie header value only ever
+// contains a single cookie, followed by that cookie's attributes
+// (e.g. `name=value; Path=/; HttpOnly`). Only the leading `name=value`
+// pair is transformed; the attribute suffix is preserved verbatim.
+//
+// If several actions are configured for the same cookie name, only the first
+// will be applied.
+type SetCookieFilter struct {
+	// A list of actions to apply to the cookies.
+	Actions []cookieFilterAction `json:"actions"`
+}
+
+// Validate checks that action types are correct.
+func (f *SetCookieFilter) Validate() error {
+	for _, a := range f.Actions {
+		if err := a.Type.IsValid(); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+// CaddyModule returns the Caddy module information.
+func (SetCookieFilter) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{
+		ID:  "caddy.logging.encoders.filter.set_cookie",
+		New: func() caddy.Module { return new(SetCookieFilter) },
+	}
+}
+
+// UnmarshalCaddyfile sets up the module from Caddyfile tokens.
+func (m *SetCookieFilter) UnmarshalCaddyfile(d *caddyfile.Dispenser) error {
+	d.Next() // consume filter name
+	for d.NextBlock(0) {
+		cfa := cookieFilterAction{}
+		switch d.Val() {
+		case "replace":
+			if !d.NextArg() {
+				return d.ArgErr()
+			}
+
+			cfa.Type = replaceAction
+			cfa.Name = d.Val()
+
+			if !d.NextArg() {
+				return d.ArgErr()
+			}
+			cfa.Value = d.Val()
+
+		case "hash":
+			if !d.NextArg() {
+				return d.ArgErr()
+			}
+
+			cfa.Type = hashAction
+			cfa.Name = d.Val()
+
+		case "delete":
+			if !d.NextArg() {
+				return d.ArgErr()
+			}
+
+			cfa.Type = deleteAction
+			cfa.Name = d.Val()
+
+		default:
+			return d.Errf("unrecognized subdirective %s", d.Val())
+		}
+
+		m.Actions = append(m.Actions, cfa)
+	}
+	return nil
+}
+
+// parseSetCookieValue splits a single Set-Cookie header value into the
+// cookie's name, its (unquoted) value, whether the value was quoted, and
+// the verbatim attribute suffix (including the leading "; "). ok is false
+// if the value cannot be parsed as a Set-Cookie line.
+func parseSetCookieValue(v string) (name, value string, quoted bool, suffix string, ok bool) {
+	head := v
+	if idx := strings.IndexByte(v, ';'); idx != -1 {
+		head = v[:idx]
+		suffix = v[idx:]
+	}
+
+	idx := strings.IndexByte(head, '=')
+	if idx == -1 {
+		return "", "", false, "", false
+	}
+
+	name = head[:idx]
+	value = head[idx+1:]
+
+	if len(value) >= 2 && value[0] == '"' && value[len(value)-1] == '"' {
+		quoted = true
+		value = value[1 : len(value)-1]
+	}
+
+	return name, value, quoted, suffix, true
+}
+
+// Filter filters the input field.
+func (m SetCookieFilter) Filter(in zapcore.Field) zapcore.Field {
+	valuesSlice, ok := in.Interface.(internal.LoggableStringArray)
+	if !ok {
+		return in
+	}
+
+	result := make(internal.LoggableStringArray, 0, len(valuesSlice))
+
+OUTER:
+	for _, v := range valuesSlice {
+		name, value, quoted, suffix, ok := parseSetCookieValue(v)
+		if !ok {
+			result = append(result, v)
+			continue
+		}
+
+		for _, a := range m.Actions {
+			if name != a.Name {
+				continue
+			}
+
+			switch a.Type {
+			case replaceAction:
+				newValue := a.Value
+				if quoted {
+					newValue = `"` + newValue + `"`
+				}
+				result = append(result, name+"="+newValue+suffix)
+				continue OUTER
+
+			case hashAction:
+				result = append(result, name+"="+hash(value)+suffix)
+				continue OUTER
+
+			case deleteAction:
+				continue OUTER
+			}
+		}
+
+		result = append(result, v)
+	}
+
+	in.Interface = result
+
+	return in
+}
