+++ b/internal/attachments/client.go
@@ -0,0 +1,266 @@
+package attachments
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/cli/cli/v2/api"
+	"github.com/cli/cli/v2/internal/gh"
+	"github.com/cli/cli/v2/internal/ghinstance"
+)
+
+// openFile is a seam the tests replace.
+var openFile = func(path string) (io.ReadCloser, error) { return os.Open(path) }
+
+// Uploader posts files to the user-attachments endpoint.
+type Uploader struct {
+	httpClient       *http.Client
+	host             string
+	targetRepository int64
+}
+
+type uploadError struct {
+	Path       string
+	StatusCode int
+	err        error
+	message    string
+}
+
+func (e *uploadError) Error() string {
+	return e.message
+}
+
+func (e *uploadError) Unwrap() error {
+	return e.err
+}
+
+// checkHost refuses a GitHub Enterprise Server host.
+func checkHost(host string) error {
+	if ghinstance.CategorizeHost(host) == "ghes" {
+		return errors.New("attaching files is not supported on GitHub Enterprise Server")
+	}
+	return nil
+}
+
+// NewUploader refuses, before any request, anything the endpoint cannot serve.
+func NewUploader(httpClient *http.Client, tokenType gh.TokenType, host string, targetRepository int64, viewerPermission string) (*Uploader, error) {
+	if err := checkHost(host); err != nil {
+		return nil, err
+	}
+
+	switch tokenType {
+	case gh.TokenTypeOAuth, gh.TokenTypePersonalAccess, gh.TokenTypeFineGrainedPAT:
+	default:
+		return nil, errors.New("unsupported authentication type")
+	}
+
+	if targetRepository <= 0 {
+		return nil, errors.New("could not determine which repository to attach files to")
+	}
+
+	if viewerPermission == "" {
+		return nil, errors.New("could not determine your permission on the repository to attach files")
+	}
+
+	switch viewerPermission {
+	case "WRITE", "ADMIN", "MAINTAIN":
+	default:
+		return nil, errors.New("attaching files requires write access to the repository")
+	}
+
+	return &Uploader{
+		httpClient:       httpClient,
+		host:             host,
+		targetRepository: targetRepository,
+	}, nil
+}
+
+// NewUploaderForRepo builds an Uploader for the host a repository lives on.
+func NewUploaderForRepo(httpClient *http.Client, cfg gh.Config, host string, targetRepository int64, viewerPermission string) (*Uploader, error) {
+	tokenType := cfg.Authentication().ActiveTokenType(host)
+	return NewUploader(httpClient, tokenType, host, targetRepository, viewerPermission)
+}
+
+func cleanMessage(s string) string {
+	s = strings.ReplaceAll(s, "\r\n", " ")
+	s = strings.ReplaceAll(s, "\r", " ")
+	s = strings.ReplaceAll(s, "\n", " ")
+	return s
+}
+
+// upload posts one asset and returns the URL the server assigned it.
+func (u *Uploader) upload(ctx context.Context, a UserAsset) (string, error) {
+	q := url.Values{}
+	q.Set("content_type", a.getAsset().contentType)
+	q.Set("name", filepath.Base(a.Path()))
+	q.Set("repository_id", strconv.FormatInt(u.targetRepository, 10))
+
+	uploadURL := ghinstance.UserAssetUploadPrefix(u.host) + "user-attachments/assets?" + q.Encode()
+
+	f, err := openFile(a.Path())
+	if err != nil {
+		msg := fmt.Sprintf("failed to upload %s: %v", a.Path(), err)
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			err:        err,
+			message:    cleanMessage(msg),
+		}
+	}
+	defer f.Close()
+
+	req, err := http.NewRequestWithContext(ctx, "POST", uploadURL, f)
+	if err != nil {
+		msg := fmt.Sprintf("failed to upload %s: %v", a.Path(), err)
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			err:        err,
+			message:    cleanMessage(msg),
+		}
+	}
+	req.Header.Set("Content-Type", "application/octet-stream")
+	req.Header.Set("Accept", "application/vnd.github+json")
+	req.ContentLength = a.getAsset().info.Size()
+
+	resp, err := u.httpClient.Do(req)
+	if err != nil {
+		msg := fmt.Sprintf("failed to upload %s: %v", a.Path(), err)
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			err:        err,
+			message:    cleanMessage(msg),
+		}
+	}
+	defer resp.Body.Close()
+
+	bodyBytes, err := io.ReadAll(resp.Body)
+	if err != nil {
+		msg := fmt.Sprintf("failed to upload %s: %v", a.Path(), err)
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			err:        err,
+			message:    cleanMessage(msg),
+		}
+	}
+
+	if resp.StatusCode == 404 {
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 404,
+			message:    fmt.Sprintf("could not upload %s: attaching files requires write access to the repository", a.Path()),
+		}
+	}
+
+	if resp.StatusCode == 422 {
+		var valResp struct {
+			Message string `json:"message"`
+			Errors  []struct {
+				Resource string `json:"resource"`
+				Field    string `json:"field"`
+				Code     string `json:"code"`
+				Message  string `json:"message"`
+			} `json:"errors"`
+		}
+		_ = json.Unmarshal(bodyBytes, &valResp)
+
+		var causes []string
+		for _, e := range valResp.Errors {
+			if e.Message != "" {
+				causes = append(causes, e.Message)
+			} else if e.Field != "" && e.Code != "" {
+				if e.Resource != "" {
+					causes = append(causes, fmt.Sprintf("%s.%s is %s", e.Resource, e.Field, e.Code))
+				} else {
+					causes = append(causes, fmt.Sprintf("%s is %s", e.Field, e.Code))
+				}
+			}
+		}
+
+		if valResp.Message == "" && len(causes) == 0 {
+			return "", &uploadError{
+				Path:       a.Path(),
+				StatusCode: 422,
+				message:    fmt.Sprintf("could not upload %s", a.Path()),
+			}
+		}
+
+		msg := fmt.Sprintf("could not upload %s: %s", a.Path(), valResp.Message)
+		if valResp.Message == "" && len(causes) > 0 {
+			msg = fmt.Sprintf("could not upload %s: %s", a.Path(), causes[0])
+			causes = causes[1:]
+		}
+		for _, c := range causes {
+			msg += "; " + c
+		}
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 422,
+			message:    cleanMessage(msg),
+		}
+	}
+
+	if resp.StatusCode == 429 {
+		retryAfter := resp.Header.Get("Retry-After")
+		var msg string
+		if retryAfter == "" {
+			msg = fmt.Sprintf("could not upload %s: rate limited; wait and try again", a.Path())
+		} else if _, err := strconv.Atoi(retryAfter); err == nil {
+			msg = fmt.Sprintf("could not upload %s: rate limited; retry after %s seconds", a.Path(), retryAfter)
+		} else {
+			msg = fmt.Sprintf("could not upload %s: rate limited; retry after %s", a.Path(), retryAfter)
+		}
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 429,
+			message:    cleanMessage(msg),
+		}
+	}
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		resp.Body = io.NopCloser(bytes.NewReader(bodyBytes))
+		httpErr := api.HandleHTTPError(resp)
+		msg := fmt.Sprintf("failed to upload %s: %s", a.Path(), httpErr.Error())
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: resp.StatusCode,
+			err:        httpErr,
+			message:    cleanMessage(msg),
+		}
+	}
+
+	var successResp struct {
+		URL string `json:"url"`
+	}
+	if err := json.Unmarshal(bodyBytes, &successResp); err != nil {
+		msg := fmt.Sprintf("failed to upload %s: %v", a.Path(), err)
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			err:        err,
+			message:    cleanMessage(msg),
+		}
+	}
+
+	if successResp.URL == "" {
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			message:    fmt.Sprintf("failed to upload %s: the server returned no asset URL", a.Path()),
+		}
+	}
+
+	return successResp.URL, nil
+}
diff --git a/internal/attachments/flags.go b/internal/attachments/flags.go
new file mode 100644
index 000000000..e27998167
--- /dev/null
+++ b/internal/attachments/flags.go
@@ -0,0 +1,100 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"os"
+
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+)
+
+const flagName = "attach"
+
+// Flag is the repeatable --attach flag.
+type Flag struct {
+	flag   *pflag.Flag
+	values *[]string
+}
+
+// AddFlag registers --attach on cmd and returns a handle to it.
+func AddFlag(cmd *cobra.Command) *Flag {
+	values := cmd.Flags().StringArray(flagName, nil, "Attach an image or video `file`, in '<file>#<image alt text>' format")
+	return &Flag{
+		flag:   cmd.Flags().Lookup(flagName),
+		values: values,
+	}
+}
+
+// Changed reports whether --attach was passed.
+func (f *Flag) Changed() bool {
+	if f == nil || f.flag == nil {
+		return false
+	}
+	return f.flag.Changed
+}
+
+// UserAssets validates every value the flag collected.
+func (f *Flag) UserAssets() ([]UserAsset, error) {
+	if !f.Changed() {
+		return nil, nil
+	}
+	if f.values == nil {
+		return nil, nil
+	}
+
+	assets := make([]UserAsset, 0, len(*f.values))
+	for _, val := range *f.values {
+		if val == "" {
+			return nil, errors.New("cannot attach an empty path; --attach needs a file path")
+		}
+		if val == "-" {
+			return nil, errors.New("cannot attach standard input; --attach needs a file path")
+		}
+
+		path, alt := splitPathAndAlt(val)
+		a, err := newAsset(path, alt)
+		if err != nil {
+			return nil, err
+		}
+		assets = append(assets, a)
+	}
+
+	for j := 1; j < len(assets); j++ {
+		for i := 0; i < j; i++ {
+			if os.SameFile(assets[i].getAsset().info, assets[j].getAsset().info) {
+				return nil, fmt.Errorf("%s and %s are the same file; attached files must be unique", assets[i].Path(), assets[j].Path())
+			}
+		}
+	}
+
+	return assets, nil
+}
+
+func splitPathAndAlt(val string) (string, string) {
+	if _, err := os.Stat(val); err == nil {
+		return val, ""
+	}
+
+	var hashIndices []int
+	for i := 0; i < len(val); i++ {
+		if val[i] == '#' {
+			hashIndices = append(hashIndices, i)
+		}
+	}
+
+	for i := len(hashIndices) - 1; i >= 0; i-- {
+		idx := hashIndices[i]
+		candidatePath := val[:idx]
+		if _, err := os.Stat(candidatePath); err == nil {
+			return candidatePath, val[idx+1:]
+		}
+	}
+
+	if len(hashIndices) > 0 {
+		lastIdx := hashIndices[len(hashIndices)-1]
+		return val[:lastIdx], val[lastIdx+1:]
+	}
+
+	return val, ""
+}
diff --git a/internal/attachments/references.go b/internal/attachments/references.go
new file mode 100644
index 000000000..3eacbabe9
--- /dev/null
+++ b/internal/attachments/references.go
@@ -0,0 +1,715 @@
+package attachments
+
+import (
+	"fmt"
+	"net/url"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/yuin/goldmark"
+	"github.com/yuin/goldmark/ast"
+	"github.com/yuin/goldmark/text"
+)
+
+// attachmentArg is one attached file as the markdown rewriter sees it.
+type attachmentArg struct {
+	Path            string
+	URL             string
+	Alt             string
+	RendersAsPlayer bool
+}
+
+// attachableMarkdown is markdown validated and ready to upload for.
+type attachableMarkdown struct {
+	markdown       string
+	attachmentArgs []attachmentArg
+}
+
+// attachResult is the outcome of rewriting markdown references.
+type attachResult struct {
+	Rewritten string
+	ToAppend  []attachmentArg
+}
+
+func isASCIIPunct(c byte) bool {
+	return (c >= '!' && c <= '/') || (c >= ':' && c <= '@') || (c >= '[' && c <= '`') || (c >= '{' && c <= '~')
+}
+
+func unescapeBackslashes(raw string) string {
+	var sb strings.Builder
+	sb.Grow(len(raw))
+	for i := 0; i < len(raw); i++ {
+		if raw[i] == '\\' && i+1 < len(raw) && isASCIIPunct(raw[i+1]) {
+			sb.WriteByte(raw[i+1])
+			i++
+		} else {
+			sb.WriteByte(raw[i])
+		}
+	}
+	return sb.String()
+}
+
+func decodeDestination(raw string) string {
+	unescaped, err := url.PathUnescape(raw)
+	if err == nil {
+		raw = unescaped
+	}
+	return unescapeBackslashes(raw)
+}
+
+func isCandidateLocalPath(dest string) bool {
+	if strings.HasPrefix(dest, "#") || strings.HasPrefix(dest, "//") {
+		return false
+	}
+	colon := strings.IndexByte(dest, ':')
+	if colon >= 2 {
+		allLetters := true
+		for i := 0; i < colon; i++ {
+			b := dest[i]
+			if !((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')) {
+				allLetters = false
+				break
+			}
+		}
+		if allLetters {
+			return false
+		}
+	}
+	return true
+}
+
+func matchPath(dest string, argPath string) bool {
+	raw := dest
+	if !isCandidateLocalPath(raw) {
+		return false
+	}
+	argAbs, err := filepath.Abs(argPath)
+	if err != nil {
+		argAbs = filepath.Clean(argPath)
+	}
+
+	// Try without percent decoding (with backslash unescaping)
+	rawUnescaped := unescapeBackslashes(raw)
+	rawAbs, err := filepath.Abs(rawUnescaped)
+	if err != nil {
+		rawAbs = filepath.Clean(rawUnescaped)
+	}
+	if rawAbs == argAbs {
+		return true
+	}
+
+	// Try with percent decoding
+	decoded := decodeDestination(raw)
+	destAbs, err := filepath.Abs(decoded)
+	if err != nil {
+		destAbs = filepath.Clean(decoded)
+	}
+	return destAbs == argAbs
+}
+
+// findLabelEnd scans from labelStart (the byte after opening '[')
+// to find the matching ']' at depth 0, skipping backtick code spans
+// and backslash-escaped punctuation.
+func findLabelEnd(src []byte, labelStart int) (int, bool) {
+	depth := 1
+	i := labelStart
+	for i < len(src) {
+		c := src[i]
+		if c == '\\' && i+1 < len(src) && isASCIIPunct(src[i+1]) {
+			i += 2
+			continue
+		}
+		if c == '`' {
+			j := i
+			for j < len(src) && src[j] == '`' {
+				j++
+			}
+			numTicks := j - i
+			k := j
+			found := false
+			for k < len(src) {
+				if src[k] == '`' {
+					m := k
+					for m < len(src) && src[m] == '`' {
+						m++
+					}
+					if m-k == numTicks {
+						i = m
+						found = true
+						break
+					}
+					k = m
+				} else {
+					k++
+				}
+			}
+			if found {
+				continue
+			}
+			i = j
+			continue
+		}
+		if c == '[' {
+			depth++
+			i++
+			continue
+		}
+		if c == ']' {
+			depth--
+			if depth == 0 {
+				return i, true
+			}
+			i++
+			continue
+		}
+		i++
+	}
+	return -1, false
+}
+
+type inlineLinkInfo struct {
+	start      int
+	labelStart int
+	labelEnd   int
+	destStart  int
+	destEnd    int
+	nodeEnd    int
+	ok         bool
+}
+
+func parseInlineLink(src []byte, start int, isImage bool) inlineLinkInfo {
+	var labelStart int
+	if isImage {
+		if start < 0 || start+1 >= len(src) || src[start] != '!' || src[start+1] != '[' {
+			return inlineLinkInfo{}
+		}
+		labelStart = start + 2
+	} else {
+		if start < 0 || start >= len(src) || src[start] != '[' {
+			return inlineLinkInfo{}
+		}
+		labelStart = start + 1
+	}
+
+	labelEnd, ok := findLabelEnd(src, labelStart)
+	if !ok || labelEnd+1 >= len(src) || src[labelEnd+1] != '(' {
+		return inlineLinkInfo{}
+	}
+
+	i := labelEnd + 2
+	for i < len(src) && (src[i] == ' ' || src[i] == '\t' || src[i] == '\r' || src[i] == '\n') {
+		i++
+	}
+	if i >= len(src) {
+		return inlineLinkInfo{}
+	}
+
+	destStart := i
+	var destEnd int
+	if src[i] == '<' {
+		j := i + 1
+		for j < len(src) {
+			if src[j] == '\\' && j+1 < len(src) && isASCIIPunct(src[j+1]) {
+				j += 2
+				continue
+			}
+			if src[j] == '>' {
+				break
+			}
+			if src[j] == '<' || src[j] == '\n' || src[j] == '\r' {
+				return inlineLinkInfo{}
+			}
+			j++
+		}
+		if j >= len(src) || src[j] != '>' {
+			return inlineLinkInfo{}
+		}
+		destEnd = j + 1
+		i = destEnd
+	} else {
+		opened := 0
+		j := i
+		for j < len(src) {
+			if src[j] == '\\' && j+1 < len(src) && isASCIIPunct(src[j+1]) {
+				j += 2
+				continue
+			}
+			if src[j] == '(' {
+				opened++
+			} else if src[j] == ')' {
+				opened--
+				if opened < 0 {
+					break
+				}
+			} else if src[j] == ' ' || src[j] == '\t' || src[j] == '\r' || src[j] == '\n' {
+				break
+			}
+			j++
+		}
+		destEnd = j
+		i = destEnd
+	}
+
+	for i < len(src) && (src[i] == ' ' || src[i] == '\t' || src[i] == '\r' || src[i] == '\n') {
+		i++
+	}
+	if i >= len(src) {
+		return inlineLinkInfo{}
+	}
+
+	var nodeEnd int
+	if src[i] == ')' {
+		nodeEnd = i + 1
+	} else if src[i] == '"' || src[i] == '\'' || src[i] == '(' {
+		closer := src[i]
+		if closer == '(' {
+			closer = ')'
+		}
+		j := i + 1
+		for j < len(src) {
+			if src[j] == '\\' && j+1 < len(src) && isASCIIPunct(src[j+1]) {
+				j += 2
+				continue
+			}
+			if src[j] == closer {
+				break
+			}
+			j++
+		}
+		if j >= len(src) || src[j] != closer {
+			return inlineLinkInfo{}
+		}
+		i = j + 1
+		for i < len(src) && (src[i] == ' ' || src[i] == '\t' || src[i] == '\r' || src[i] == '\n') {
+			i++
+		}
+		if i >= len(src) || src[i] != ')' {
+			return inlineLinkInfo{}
+		}
+		nodeEnd = i + 1
+	} else {
+		return inlineLinkInfo{}
+	}
+
+	return inlineLinkInfo{
+		start:      start,
+		labelStart: labelStart,
+		labelEnd:   labelEnd,
+		destStart:  destStart,
+		destEnd:    destEnd,
+		nodeEnd:    nodeEnd,
+		ok:         true,
+	}
+}
+
+type defLineInfo struct {
+	destStart int
+	destEnd   int
+	ok        bool
+}
+
+func parseDefinition(src []byte, defPos int) defLineInfo {
+	pos := defPos
+	for pos < len(src) && src[pos] == ' ' {
+		pos++
+	}
+	if pos >= len(src) || src[pos] != '[' {
+		return defLineInfo{}
+	}
+	labelEnd, ok := findLabelEnd(src, pos+1)
+	if !ok || labelEnd+1 >= len(src) || src[labelEnd+1] != ':' {
+		return defLineInfo{}
+	}
+	i := labelEnd + 2
+	for i < len(src) && (src[i] == ' ' || src[i] == '\t') {
+		i++
+	}
+	if i >= len(src) || src[i] == '\r' || src[i] == '\n' {
+		return defLineInfo{}
+	}
+	destStart := i
+	var destEnd int
+	if src[i] == '<' {
+		j := i + 1
+		for j < len(src) {
+			if src[j] == '\\' && j+1 < len(src) && isASCIIPunct(src[j+1]) {
+				j += 2
+				continue
+			}
+			if src[j] == '>' {
+				break
+			}
+			if src[j] == '<' || src[j] == '\r' || src[j] == '\n' {
+				return defLineInfo{}
+			}
+			j++
+		}
+		if j >= len(src) || src[j] != '>' {
+			return defLineInfo{}
+		}
+		destEnd = j + 1
+	} else {
+		j := i
+		for j < len(src) && src[j] != ' ' && src[j] != '\t' && src[j] != '\r' && src[j] != '\n' {
+			j++
+		}
+		destEnd = j
+	}
+	return defLineInfo{
+		destStart: destStart,
+		destEnd:   destEnd,
+		ok:        true,
+	}
+}
+
+func isAloneInParagraph(p *ast.Paragraph, img *ast.Image, src []byte) bool {
+	if p == nil || img == nil {
+		return false
+	}
+	for c := p.FirstChild(); c != nil; c = c.NextSibling() {
+		if c == img {
+			continue
+		}
+		if t, ok := c.(*ast.Text); ok {
+			val := t.Segment.Value(src)
+			if len(strings.TrimSpace(string(val))) > 0 {
+				return false
+			}
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+// newAttachableMarkdown parses markdown and refuses reference-style image embeds of videos.
+func newAttachableMarkdown(markdown string, attachmentArgs []attachmentArg) (attachableMarkdown, error) {
+	md := goldmark.New()
+	reader := text.NewReader([]byte(markdown))
+	doc := md.Parser().Parse(reader)
+
+	offending := make(map[int]bool)
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		img, ok := n.(*ast.Image)
+		if !ok || img.Reference == nil {
+			return ast.WalkContinue, nil
+		}
+		dest := string(img.Destination)
+		for i, arg := range attachmentArgs {
+			if arg.RendersAsPlayer && matchPath(dest, arg.Path) {
+				offending[i] = true
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+
+	if len(offending) > 0 {
+		var paths []string
+		for i, arg := range attachmentArgs {
+			if offending[i] {
+				paths = append(paths, arg.Path)
+			}
+		}
+		return attachableMarkdown{}, fmt.Errorf("cannot embed a video as a reference-style image: %s", strings.Join(paths, ", "))
+	}
+
+	return attachableMarkdown{
+		markdown:       markdown,
+		attachmentArgs: attachmentArgs,
+	}, nil
+}
+
+// isSingleImage reports whether markdown is exactly one paragraph holding exactly one image pointing at url.
+func isSingleImage(markdown, url string) bool {
+	if markdown == "" || url == "" {
+		return false
+	}
+	md := goldmark.New()
+	reader := text.NewReader([]byte(markdown))
+	doc := md.Parser().Parse(reader)
+	if doc.ChildCount() != 1 {
+		return false
+	}
+	p, ok := doc.FirstChild().(*ast.Paragraph)
+	if !ok {
+		return false
+	}
+	if p.ChildCount() != 1 {
+		return false
+	}
+	img, ok := p.FirstChild().(*ast.Image)
+	if !ok {
+		return false
+	}
+	if img.Reference != nil {
+		return false
+	}
+	return string(img.Destination) == url
+}
+
+type textEdit struct {
+	start       int
+	end         int
+	replacement string
+	argIndex    int
+	isOuter     bool
+}
+
+// attachAssetsToMarkdown rewrites attached asset references in markdown.
+func attachAssetsToMarkdown(v attachableMarkdown) (attachResult, error) {
+	if len(v.attachmentArgs) == 0 {
+		return attachResult{Rewritten: v.markdown, ToAppend: nil}, nil
+	}
+
+	src := []byte(v.markdown)
+	md := goldmark.New()
+	reader := text.NewReader(src)
+	doc := md.Parser().Parse(reader)
+
+	// Step 1: Identify which attachment arguments are resolved by at least one link or image node in the AST.
+	resolvedArgs := make(map[int]bool)
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		var dest string
+		switch node := n.(type) {
+		case *ast.Link:
+			dest = string(node.Destination)
+		case *ast.Image:
+			dest = string(node.Destination)
+		default:
+			return ast.WalkContinue, nil
+		}
+		for i, arg := range v.attachmentArgs {
+			if arg.URL != "" && matchPath(dest, arg.Path) {
+				resolvedArgs[i] = true
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+
+	// Step 2: Collect edits for inline links and inline images.
+	var edits []textEdit
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		switch node := n.(type) {
+		case *ast.Link:
+			if node.Reference != nil {
+				return ast.WalkContinue, nil
+			}
+			dest := string(node.Destination)
+			var matchedArgIndex = -1
+			for i, arg := range v.attachmentArgs {
+				if arg.URL != "" && matchPath(dest, arg.Path) {
+					matchedArgIndex = i
+					break
+				}
+			}
+			if matchedArgIndex < 0 {
+				return ast.WalkContinue, nil
+			}
+			arg := v.attachmentArgs[matchedArgIndex]
+			info := parseInlineLink(src, node.Pos(), false)
+			if !info.ok {
+				return ast.WalkContinue, nil
+			}
+			edits = append(edits, textEdit{
+				start:       info.destStart,
+				end:         info.destEnd,
+				replacement: arg.URL,
+				argIndex:    matchedArgIndex,
+			})
+
+		case *ast.Image:
+			if node.Reference != nil {
+				return ast.WalkContinue, nil
+			}
+			dest := string(node.Destination)
+			var matchedArgIndex = -1
+			for i, arg := range v.attachmentArgs {
+				if arg.URL != "" && matchPath(dest, arg.Path) {
+					matchedArgIndex = i
+					break
+				}
+			}
+			if matchedArgIndex < 0 {
+				return ast.WalkContinue, nil
+			}
+			arg := v.attachmentArgs[matchedArgIndex]
+			info := parseInlineLink(src, node.Pos(), true)
+			if !info.ok {
+				return ast.WalkContinue, nil
+			}
+
+			if !arg.RendersAsPlayer {
+				// Normal image: replace destination in place.
+				edits = append(edits, textEdit{
+					start:       info.destStart,
+					end:         info.destEnd,
+					replacement: arg.URL,
+					argIndex:    matchedArgIndex,
+				})
+			} else {
+				// Video embed: check if alone in Paragraph.
+				p, isPara := node.Parent().(*ast.Paragraph)
+				if isPara && isAloneInParagraph(p, node, src) {
+					edits = append(edits, textEdit{
+						start:       info.start,
+						end:         info.nodeEnd,
+						replacement: arg.URL,
+						argIndex:    matchedArgIndex,
+						isOuter:     true,
+					})
+				} else {
+					// Degrades to link.
+					// Destination replacement:
+					edits = append(edits, textEdit{
+						start:       info.destStart,
+						end:         info.destEnd,
+						replacement: arg.URL,
+						argIndex:    matchedArgIndex,
+					})
+					if info.labelStart == info.labelEnd {
+						// Empty label: replace "![]" with "[" + escapedAlt + "]"
+						escapedAlt := strings.ReplaceAll(arg.Alt, "]", `\]`)
+						edits = append(edits, textEdit{
+							start:       info.start,
+							end:         info.labelEnd + 1,
+							replacement: "[" + escapedAlt + "]",
+							argIndex:    matchedArgIndex,
+						})
+					} else {
+						// Non-empty label: drop or escape leading '!'
+						if info.start > 0 && src[info.start-1] == '!' {
+							numBackslashes := 0
+							for k := info.start - 2; k >= 0 && src[k] == '\\'; k-- {
+								numBackslashes++
+							}
+							if numBackslashes%2 == 0 {
+								// Not escaped: replace "!!" with "\!"
+								edits = append(edits, textEdit{
+									start:       info.start - 1,
+									end:         info.start + 1,
+									replacement: `\!`,
+									argIndex:    matchedArgIndex,
+								})
+							} else {
+								// Already escaped: drop '!'
+								edits = append(edits, textEdit{
+									start:       info.start,
+									end:         info.start + 1,
+									replacement: "",
+									argIndex:    matchedArgIndex,
+								})
+							}
+						} else {
+							edits = append(edits, textEdit{
+								start:       info.start,
+								end:         info.start + 1,
+								replacement: "",
+								argIndex:    matchedArgIndex,
+							})
+						}
+					}
+				}
+			}
+		}
+		return ast.WalkContinue, nil
+	})
+
+	// Step 3: Collect edits for link reference definitions matching resolved arguments.
+	ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		def, ok := n.(*ast.LinkReferenceDefinition)
+		if !ok {
+			return ast.WalkContinue, nil
+		}
+		info := parseDefinition(src, def.Pos())
+		if !info.ok {
+			return ast.WalkContinue, nil
+		}
+		dest := string(def.Destination)
+		var matchedArgIndex = -1
+		for i, arg := range v.attachmentArgs {
+			if resolvedArgs[i] && matchPath(dest, arg.Path) {
+				matchedArgIndex = i
+				break
+			}
+		}
+		if matchedArgIndex < 0 {
+			return ast.WalkContinue, nil
+		}
+		arg := v.attachmentArgs[matchedArgIndex]
+		edits = append(edits, textEdit{
+			start:       info.destStart,
+			end:         info.destEnd,
+			replacement: arg.URL,
+			argIndex:    matchedArgIndex,
+		})
+		return ast.WalkContinue, nil
+	})
+
+	// Step 4: Discard inner edits that were swallowed by outer replacements (e.g. video alone in paragraph).
+	var outerEdits []textEdit
+	for _, e := range edits {
+		if e.isOuter {
+			outerEdits = append(outerEdits, e)
+		}
+	}
+
+	var survivingEdits []textEdit
+	consumedArgIndices := make(map[int]bool)
+	for _, e := range edits {
+		swallowed := false
+		for _, outer := range outerEdits {
+			if e.start >= outer.start && e.end <= outer.end && (e.start != outer.start || e.end != outer.end) {
+				swallowed = true
+				break
+			}
+		}
+		if !swallowed {
+			survivingEdits = append(survivingEdits, e)
+			if e.argIndex >= 0 {
+				consumedArgIndices[e.argIndex] = true
+			}
+		}
+	}
+
+	// Step 5: Apply surviving edits in reverse byte offset order.
+	sort.Slice(survivingEdits, func(i, j int) bool {
+		if survivingEdits[i].start != survivingEdits[j].start {
+			return survivingEdits[i].start > survivingEdits[j].start
+		}
+		return survivingEdits[i].end > survivingEdits[j].end
+	})
+
+	res := v.markdown
+	for _, e := range survivingEdits {
+		res = res[:e.start] + e.replacement + res[e.end:]
+	}
+
+	// Step 6: Collect arguments to append.
+	var toAppend []attachmentArg
+	for i, arg := range v.attachmentArgs {
+		if arg.URL == "" {
+			continue
+		}
+		if !consumedArgIndices[i] {
+			toAppend = append(toAppend, arg)
+		}
+	}
+
+	return attachResult{
+		Rewritten: res,
+		ToAppend:  toAppend,
+	}, nil
+}
