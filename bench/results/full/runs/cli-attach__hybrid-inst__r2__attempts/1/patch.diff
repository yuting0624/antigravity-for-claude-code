--- /dev/null
+++ b/internal/attachments/attach.go
@@ -0,0 +1,83 @@
+package attachments
+
+import (
+	"context"
+	"strings"
+)
+
+// appendParagraph puts addition in a paragraph of its own below md.
+func appendParagraph(md, addition string) string {
+	if addition == "" {
+		return md
+	}
+	trimmed := strings.TrimRight(md, " \t\r\n")
+	if trimmed == "" {
+		return addition
+	}
+	return trimmed + "\n\n" + addition
+}
+
+// UploadAndAttach uploads every asset and writes the result into body. It
+// returns the body to write, how many assets reached the server, and the first
+// failure. A caller must write the returned body whenever the count is above
+// zero, because an uploaded asset cannot be deleted.
+func (u *Uploader) UploadAndAttach(ctx context.Context, body string, assets []UserAsset) (string, int, error) {
+	if len(assets) == 0 {
+		return body, 0, nil
+	}
+
+	args := make([]attachmentArg, len(assets))
+	for i, a := range assets {
+		args[i] = attachmentArg{
+			Path:            a.Path(),
+			Alt:             a.getAsset().alt,
+			RendersAsPlayer: a.rendersAsPlayer(),
+		}
+	}
+
+	v, err := newAttachableMarkdown(body, args)
+	if err != nil {
+		return body, 0, err
+	}
+
+	var firstUploadErr error
+	uploaded := 0
+	for i, a := range assets {
+		uURL, err := u.upload(ctx, a)
+		if err != nil {
+			firstUploadErr = err
+			break
+		}
+		args[i].URL = uURL
+		uploaded++
+	}
+
+	if uploaded == 0 {
+		return body, 0, firstUploadErr
+	}
+
+	v.attachmentArgs = args
+	result, rerr := attachAssetsToMarkdown(v)
+
+	assetByPath := make(map[string]UserAsset, len(assets))
+	for _, a := range assets {
+		assetByPath[a.Path()] = a
+	}
+
+	newBody := result.Rewritten
+	for _, item := range result.ToAppend {
+		if item.URL == "" {
+			continue
+		}
+		if a, ok := assetByPath[item.Path]; ok {
+			newBody = appendParagraph(newBody, a.markdown(item.URL))
+		}
+	}
+
+	retErr := firstUploadErr
+	if retErr == nil {
+		retErr = rerr
+	}
+
+	return newBody, uploaded, retErr
+}
