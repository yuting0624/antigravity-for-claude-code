+package attachments
+
+import (
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/httpmock"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// UploadStub describes one stubbed upload response.
+type UploadStub struct {
+	Name   string
+	Status int
+	Body   string
+}
+
+// StubUpload registers a stubbed response for uploading name to repositoryID.
+func StubUpload(reg *httpmock.Registry, repositoryID int64, name string, status int, body string) {
+	matcher := func(req *http.Request) bool {
+		if !strings.EqualFold(req.Method, "POST") {
+			return false
+		}
+		if req.URL.Path != "/user-attachments/assets" {
+			return false
+		}
+		q := req.URL.Query()
+		return q.Get("name") == name && q.Get("repository_id") == strconv.FormatInt(repositoryID, 10)
+	}
+	reg.Register(matcher, httpmock.StatusStringResponse(status, body))
+}
+
+// StubUploadToHost is StubUpload for a run that must reach a particular upload host.
+func StubUploadToHost(t *testing.T, reg *httpmock.Registry, host string, repositoryID int64, name string, status int, body string) {
+	t.Helper()
+	matcher := func(req *http.Request) bool {
+		if !strings.EqualFold(req.Method, "POST") {
+			return false
+		}
+		if req.URL.Path != "/user-attachments/assets" {
+			return false
+		}
+		q := req.URL.Query()
+		return q.Get("name") == name && q.Get("repository_id") == strconv.FormatInt(repositoryID, 10)
+	}
+	responder := func(req *http.Request) (*http.Response, error) {
+		assert.Equal(t, host, req.URL.Host)
+		return httpmock.StatusStringResponse(status, body)(req)
+	}
+	reg.Register(matcher, responder)
+}
+
+// NewTestAssets moves into a temporary directory, writes the named files there
+// and resolves them, so a command under test can attach them.
+func NewTestAssets(t *testing.T, names ...string) []UserAsset {
+	t.Helper()
+	t.Chdir(t.TempDir())
+	assets := make([]UserAsset, 0, len(names))
+	for _, name := range names {
+		trimmedName := strings.TrimPrefix(name, "./")
+		err := os.WriteFile(trimmedName, []byte("the bytes"), 0o600)
+		require.NoError(t, err)
+		a, err := newAsset("./"+trimmedName, "")
+		require.NoError(t, err)
+		assets = append(assets, a)
+	}
+	return assets
+}
diff --git a/internal/attachments/userasset.go b/internal/attachments/userasset.go
new file mode 100644
index 000000000..20bb5fd69
--- /dev/null
+++ b/internal/attachments/userasset.go
@@ -0,0 +1,154 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+const (
+	maxImageBytes = 10 * 1024 * 1024
+	maxVideoBytes = 100 * 1024 * 1024
+)
+
+// UserAsset is one validated local file that gh can upload.
+type UserAsset interface {
+	Path() string
+	getAsset() *asset
+	markdown(url string) string
+	rendersAsPlayer() bool
+}
+
+type asset struct {
+	path        string
+	info        os.FileInfo
+	alt         string
+	contentType string
+}
+
+type imageAsset struct{ asset }
+type videoAsset struct{ asset }
+
+func (a *imageAsset) Path() string {
+	return a.path
+}
+
+func (a *imageAsset) getAsset() *asset {
+	return &a.asset
+}
+
+func (a *imageAsset) rendersAsPlayer() bool {
+	return false
+}
+
+func (a *imageAsset) markdown(url string) string {
+	alt := a.alt
+	alt = strings.ReplaceAll(alt, `\`, `\\`)
+	alt = strings.ReplaceAll(alt, "[", `\[`)
+	alt = strings.ReplaceAll(alt, "]", `\]`)
+	alt = strings.ReplaceAll(alt, "\r", " ")
+	alt = strings.ReplaceAll(alt, "\n", " ")
+	return "![" + alt + "](" + url + ")"
+}
+
+func (a *videoAsset) Path() string {
+	return a.path
+}
+
+func (a *videoAsset) getAsset() *asset {
+	return &a.asset
+}
+
+func (a *videoAsset) rendersAsPlayer() bool {
+	return true
+}
+
+func (a *videoAsset) markdown(url string) string {
+	return url
+}
+
+var extensionContentType = map[string]string{
+	"png":  "image/png",
+	"jpg":  "image/jpeg",
+	"jpeg": "image/jpeg",
+	"gif":  "image/gif",
+	"webp": "image/webp",
+	"svg":  "image/svg+xml",
+	"mp4":  "video/mp4",
+	"mov":  "video/quicktime",
+	"webm": "video/webm",
+}
+
+// newAsset validates a path and the alt text for it, reading metadata only.
+func newAsset(path, alt string) (UserAsset, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		var pathErr *fs.PathError
+		if errors.As(err, &pathErr) {
+			return nil, fmt.Errorf("%s: %w", path, pathErr.Err)
+		}
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+
+	if info.IsDir() {
+		return nil, fmt.Errorf("%s is a directory", path)
+	}
+
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%s is not a regular file", path)
+	}
+
+	ext := strings.ToLower(filepath.Ext(path))
+	ext = strings.TrimPrefix(ext, ".")
+	contentType, ok := extensionContentType[ext]
+	if !ok {
+		return nil, fmt.Errorf("%s is not a supported file type (supported: png, jpg, jpeg, gif, webp, svg, mp4, mov, webm)", path)
+	}
+
+	if info.Size() == 0 {
+		return nil, fmt.Errorf("%s is empty", path)
+	}
+
+	isVideo := strings.HasPrefix(contentType, "video/")
+	limit := int64(maxImageBytes)
+	noun := "images"
+	if isVideo {
+		limit = int64(maxVideoBytes)
+		noun = "videos"
+	}
+
+	if info.Size() > limit {
+		humanLimit := fmt.Sprintf("%.1f MB", float64(limit)/(1024*1024))
+		return nil, fmt.Errorf("%s: %s must be at most %s", path, noun, humanLimit)
+	}
+
+	if isVideo && alt != "" {
+		return nil, errors.New("cannot set alt text on video")
+	}
+
+	if alt == "" {
+		base := filepath.Base(path)
+		if isVideo {
+			alt = base
+		} else {
+			baseExt := filepath.Ext(base)
+			baseNoExt := strings.TrimSuffix(base, baseExt)
+			alt = strings.ReplaceAll(baseNoExt, ".", " ")
+		}
+	}
+
+	baseAsset := asset{
+		path:        path,
+		info:        info,
+		alt:         alt,
+		contentType: contentType,
+	}
+
+	if isVideo {
+		return &videoAsset{asset: baseAsset}, nil
+	}
+	return &imageAsset{asset: baseAsset}, nil
+}
