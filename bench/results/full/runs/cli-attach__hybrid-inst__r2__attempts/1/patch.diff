+package config
+
+import (
+	"strings"
+
+	"github.com/cli/cli/v2/internal/gh"
+)
+
+// ActiveTokenType reports what kind of credential is active for the hostname.
+func (c *AuthConfig) ActiveTokenType(hostname string) gh.TokenType {
+	token, _ := c.ActiveToken(hostname)
+	switch {
+	case strings.HasPrefix(token, "gho_"):
+		return gh.TokenTypeOAuth
+	case strings.HasPrefix(token, "ghp_"):
+		return gh.TokenTypePersonalAccess
+	case strings.HasPrefix(token, "github_pat_"):
+		return gh.TokenTypeFineGrainedPAT
+	case strings.HasPrefix(token, "ghu_"):
+		return gh.TokenTypeUserToServer
+	case strings.HasPrefix(token, "ghs_"):
+		return gh.TokenTypeServerToServer
+	case strings.HasPrefix(token, "ghr_"):
+		return gh.TokenTypeRefresh
+	default:
+		return gh.TokenTypeUnknown
+	}
+}
