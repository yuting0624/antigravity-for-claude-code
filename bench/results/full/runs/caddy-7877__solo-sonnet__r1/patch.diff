+// trimPathSuffix is like trimPathPrefix but compares from the end of
+// escapedPath. Because the comparison walks backwards, a %XX escape is
+// only recognized once its last hex digit is reached, so unlike
+// trimPathPrefix we must also check whether suffix itself spells out an
+// escape ending at the current position; if it does, the comparison stays
+// literal (byte-for-byte, case-insensitive) instead of decoding the path.
+func trimPathSuffix(escapedPath, suffix string) string {
+	iPath, iSuffix := len(escapedPath)-1, len(suffix)-1
+	for iPath >= 0 && iSuffix >= 0 {
+		suffixCh := suffix[iSuffix]
+		ch := string(escapedPath[iPath])
+
+		pathEscapeEnds := iPath >= 2 && escapedPath[iPath-2] == '%'
+		suffixEscapeEnds := iSuffix >= 2 && suffix[iSuffix-2] == '%'
+
+		if pathEscapeEnds && !suffixEscapeEnds {
+			unescaped, err := url.PathUnescape(escapedPath[iPath-2 : iPath+1])
+			if err != nil {
+				// should be impossible unless EscapedPath() is returning invalid values!
+				return escapedPath
+			}
+			ch = unescaped
+			iPath -= 2
+		}
+
+		// suffix comparisons are case-insensitive to consistency with
+		// path matcher, which is case-insensitive for good reasons
+		if !strings.EqualFold(ch, string(suffixCh)) {
+			return escapedPath
+		}
+
+		iPath--
+		iSuffix--
 	}
-	return string(r)
+
+	// if we iterated through the entire suffix, we found it, so trim it
+	if iSuffix < 0 {
+		return escapedPath[:iPath+1]
+	}
+
+	// otherwise we did not find the suffix
+	return escapedPath
 }
 
