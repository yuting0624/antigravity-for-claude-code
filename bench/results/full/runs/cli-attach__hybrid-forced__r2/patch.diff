diff --git a/internal/attachments/attach.go b/internal/attachments/attach.go
new file mode 100644
index 000000000..1c6f7a7cb
--- /dev/null
+++ b/internal/attachments/attach.go
@@ -0,0 +1,86 @@
+package attachments
+
+import (
+	"context"
+	"strings"
+)
+
+// UploadAndAttach uploads the given assets and attaches them to the markdown content.
+func (u *Uploader) UploadAndAttach(ctx context.Context, markdown string, assets []UserAsset) (string, int, error) {
+	if len(assets) == 0 {
+		return markdown, 0, nil
+	}
+
+	args := make([]attachmentArg, len(assets))
+	assetByIndex := make([]UserAsset, len(assets))
+	for i, a := range assets {
+		args[i] = attachmentArg{
+			Path:            a.Path(),
+			Alt:             a.getAsset().alt,
+			RendersAsPlayer: a.rendersAsPlayer(),
+			URL:             "",
+		}
+		assetByIndex[i] = a
+	}
+
+	v, err := newAttachableMarkdown(markdown, args)
+	if err != nil {
+		return markdown, 0, err
+	}
+
+	var uploadErr error
+	var uploaded int
+	for i, a := range assets {
+		assetURL, err := u.upload(ctx, a)
+		if err != nil {
+			uploadErr = err
+			break
+		}
+		args[i].URL = assetURL
+		uploaded++
+	}
+
+	got, err2 := attachAssetsToMarkdown(v)
+
+	body := got.Rewritten
+	argIdx := 0
+	for _, item := range got.ToAppend {
+		for argIdx < len(args) && (args[argIdx].Path != item.Path || args[argIdx].URL != item.URL) {
+			argIdx++
+		}
+		var targetAsset UserAsset
+		if argIdx < len(args) {
+			targetAsset = assetByIndex[argIdx]
+			argIdx++
+		} else {
+			for i, arg := range args {
+				if arg.Path == item.Path {
+					targetAsset = assetByIndex[i]
+					break
+				}
+			}
+		}
+
+		if targetAsset != nil {
+			body = appendParagraph(body, targetAsset.markdown(item.URL))
+		}
+	}
+
+	finalErr := uploadErr
+	if finalErr == nil && err2 != nil {
+		finalErr = err2
+	}
+
+	return body, uploaded, finalErr
+}
+
+func appendParagraph(md, addition string) string {
+	if addition == "" {
+		return md
+	}
+	trimmed := strings.TrimRight(md, " \t\r\n")
+	if trimmed == "" {
+		return addition
+	}
+	return trimmed + "\n\n" + addition
+}
diff --git a/internal/attachments/client.go b/internal/attachments/client.go
new file mode 100644
index 000000000..187d6dfe6
--- /dev/null
+++ b/internal/attachments/client.go
@@ -0,0 +1,226 @@
+package attachments
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/cli/cli/v2/api"
+	"github.com/cli/cli/v2/internal/gh"
+	"github.com/cli/cli/v2/internal/ghinstance"
+	ghauth "github.com/cli/go-gh/v2/pkg/auth"
+)
+
+// Uploader uploads assets and attaches them to markdown content.
+type Uploader struct {
+	httpClient       *http.Client
+	host             string
+	targetRepository int64
+}
+
+// NewUploader constructs an Uploader for attaching files to a repository on host.
+func NewUploader(httpClient *http.Client, tokenType gh.TokenType, host string, targetRepository int64, viewerPermission string) (*Uploader, error) {
+	if err := checkHost(host); err != nil {
+		return nil, err
+	}
+
+	switch tokenType {
+	case gh.TokenTypeOAuth, gh.TokenTypePersonalAccess, gh.TokenTypeFineGrainedPAT:
+		// accepted
+	default:
+		return nil, errors.New("unsupported authentication type")
+	}
+
+	if targetRepository <= 0 {
+		return nil, errors.New("could not determine which repository to attach files to")
+	}
+
+	if viewerPermission == "" {
+		return nil, errors.New("could not determine your permission on the repository to attach files")
+	}
+
+	switch strings.ToUpper(viewerPermission) {
+	case "ADMIN", "MAINTAIN", "WRITE":
+		// accepted
+	default:
+		return nil, errors.New("attaching files requires write access to the repository")
+	}
+
+	return &Uploader{
+		httpClient:       httpClient,
+		host:             host,
+		targetRepository: targetRepository,
+	}, nil
+}
+
+func checkHost(host string) error {
+	if ghauth.IsEnterprise(host) {
+		return errors.New("attaching files is not supported on GitHub Enterprise Server")
+	}
+	return nil
+}
+
+type uploadError struct {
+	Path       string
+	StatusCode int
+	err        error
+}
+
+func (e *uploadError) Error() string {
+	if e.err != nil {
+		return e.err.Error()
+	}
+	return ""
+}
+
+func (e *uploadError) Unwrap() error {
+	return e.err
+}
+
+func (u *Uploader) upload(ctx context.Context, a UserAsset) (string, error) {
+	rc, err := openFile(a.Path())
+	if err != nil {
+		cleanMsg := strings.ReplaceAll(err.Error(), "\n", " ")
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			err:        fmt.Errorf("failed to upload %s: %s", a.Path(), cleanMsg),
+		}
+	}
+	defer rc.Close()
+
+	q := url.Values{
+		"content_type":  {a.getAsset().contentType},
+		"name":          {filepath.Base(a.Path())},
+		"repository_id": {strconv.FormatInt(u.targetRepository, 10)},
+	}
+	endpoint := ghinstance.UserAssetUploadPrefix(u.host) + "user-attachments/assets?" + q.Encode()
+
+	req, err := http.NewRequestWithContext(ctx, "POST", endpoint, rc)
+	if err != nil {
+		cleanMsg := strings.ReplaceAll(err.Error(), "\n", " ")
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			err:        fmt.Errorf("failed to upload %s: %s", a.Path(), cleanMsg),
+		}
+	}
+
+	req.Header.Set("Content-Type", "application/octet-stream")
+	req.Header.Set("Accept", "application/vnd.github+json")
+	if a.getAsset().info != nil {
+		req.ContentLength = a.getAsset().info.Size()
+	}
+
+	resp, err := u.httpClient.Do(req)
+	if err != nil {
+		cleanMsg := strings.ReplaceAll(err.Error(), "\n", " ")
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: 0,
+			err:        fmt.Errorf("failed to upload %s: %s", a.Path(), cleanMsg),
+		}
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+		var res struct {
+			URL string `json:"url"`
+		}
+		if err := json.NewDecoder(resp.Body).Decode(&res); err != nil {
+			cleanMsg := strings.ReplaceAll(err.Error(), "\n", " ")
+			return "", &uploadError{
+				Path:       a.Path(),
+				StatusCode: 0,
+				err:        fmt.Errorf("failed to upload %s: %s", a.Path(), cleanMsg),
+			}
+		}
+		if res.URL == "" {
+			return "", &uploadError{
+				Path:       a.Path(),
+				StatusCode: 0,
+				err:        fmt.Errorf("failed to upload %s: the server returned no asset URL", a.Path()),
+			}
+		}
+		return res.URL, nil
+	}
+
+	switch resp.StatusCode {
+	case http.StatusNotFound:
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: http.StatusNotFound,
+			err:        fmt.Errorf("could not upload %s: attaching files requires write access to the repository", a.Path()),
+		}
+	case http.StatusTooManyRequests:
+		retryAfter := resp.Header.Get("Retry-After")
+		var msg string
+		if retryAfter == "" {
+			msg = fmt.Sprintf("could not upload %s: rate limited; wait and try again", a.Path())
+		} else {
+			isDigits := true
+			for _, r := range retryAfter {
+				if r < '0' || r > '9' {
+					isDigits = false
+					break
+				}
+			}
+			if isDigits {
+				msg = fmt.Sprintf("could not upload %s: rate limited; retry after %s seconds", a.Path(), retryAfter)
+			} else {
+				msg = fmt.Sprintf("could not upload %s: rate limited; retry after %s", a.Path(), retryAfter)
+			}
+		}
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: http.StatusTooManyRequests,
+			err:        errors.New(msg),
+		}
+	case http.StatusUnprocessableEntity:
+		var respObj struct {
+			Message string `json:"message"`
+			Errors  []struct {
+				Resource string `json:"resource"`
+				Field    string `json:"field"`
+				Code     string `json:"code"`
+				Message  string `json:"message"`
+			} `json:"errors"`
+		}
+		_ = json.NewDecoder(resp.Body).Decode(&respObj)
+
+		var sb strings.Builder
+		sb.WriteString(fmt.Sprintf("could not upload %s", a.Path()))
+		if respObj.Message != "" {
+			sb.WriteString(": ")
+			sb.WriteString(respObj.Message)
+		}
+		for _, errEntry := range respObj.Errors {
+			sb.WriteString("; ")
+			if errEntry.Message != "" {
+				sb.WriteString(errEntry.Message)
+			} else {
+				sb.WriteString(fmt.Sprintf("%s.%s is %s", errEntry.Resource, errEntry.Field, errEntry.Code))
+			}
+		}
+		msg := strings.ReplaceAll(sb.String(), "\n", " ")
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: http.StatusUnprocessableEntity,
+			err:        errors.New(msg),
+		}
+	default:
+		httpErr := api.HandleHTTPError(resp)
+		cleanMsg := strings.ReplaceAll(httpErr.Error(), "\n", " ")
+		return "", &uploadError{
+			Path:       a.Path(),
+			StatusCode: resp.StatusCode,
+			err:        fmt.Errorf("failed to upload %s: %s", a.Path(), cleanMsg),
+		}
+	}
+}
diff --git a/internal/attachments/flags.go b/internal/attachments/flags.go
new file mode 100644
index 000000000..0826dc391
--- /dev/null
+++ b/internal/attachments/flags.go
@@ -0,0 +1,105 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+)
+
+const flagName = "attach"
+
+// Flag manages the --attach flag on a command.
+type Flag struct {
+	flag *pflag.Flag
+}
+
+// AddFlag adds the --attach flag to the given command.
+func AddFlag(cmd *cobra.Command) *Flag {
+	cmd.Flags().StringArray(flagName, []string{}, "Attach an image or video `file`, in '<file>#<image alt text>' format")
+	return &Flag{flag: cmd.Flags().Lookup(flagName)}
+}
+
+// Changed reports whether the flag was passed on the command line.
+func (f *Flag) Changed() bool {
+	if f == nil || f.flag == nil {
+		return false
+	}
+	return f.flag.Changed
+}
+
+// UserAssets returns the parsed and validated assets from the --attach flag.
+func (f *Flag) UserAssets() ([]UserAsset, error) {
+	if f == nil || f.flag == nil || !f.flag.Changed {
+		return nil, nil
+	}
+
+	slice, ok := f.flag.Value.(pflag.SliceValue)
+	if !ok {
+		return nil, nil
+	}
+
+	values := slice.GetSlice()
+	if len(values) == 0 {
+		return nil, nil
+	}
+
+	var resolved []UserAsset
+	for _, val := range values {
+		if val == "" {
+			return nil, errors.New("cannot attach an empty path; --attach needs a file path")
+		}
+		if val == "-" {
+			return nil, errors.New("cannot attach standard input; --attach needs a file path")
+		}
+
+		path, alt := splitPathAndAlt(val)
+		asset, err := newAsset(path, alt)
+		if err != nil {
+			return nil, err
+		}
+
+		for _, prev := range resolved {
+			if os.SameFile(prev.getAsset().info, asset.getAsset().info) {
+				return nil, fmt.Errorf("%s and %s are the same file; attached files must be unique", prev.Path(), asset.Path())
+			}
+		}
+		resolved = append(resolved, asset)
+	}
+
+	return resolved, nil
+}
+
+func splitPathAndAlt(val string) (string, string) {
+	if !strings.Contains(val, "#") {
+		return val, ""
+	}
+
+	// Try the WHOLE value as a path first.
+	if _, err := os.Stat(val); err == nil {
+		return val, ""
+	}
+
+	// Progressively shorter prefixes cut at each hash from the right.
+	var hashIndices []int
+	for i := 0; i < len(val); i++ {
+		if val[i] == '#' {
+			hashIndices = append(hashIndices, i)
+		}
+	}
+
+	for i := len(hashIndices) - 1; i >= 0; i-- {
+		idx := hashIndices[i]
+		candidatePath := val[:idx]
+		if _, err := os.Stat(candidatePath); err == nil {
+			return candidatePath, val[idx+1:]
+		}
+	}
+
+	// Fall back to cutting at the LAST hash.
+	lastHash := hashIndices[len(hashIndices)-1]
+	return val[:lastHash], val[lastHash+1:]
+}
diff --git a/internal/attachments/references.go b/internal/attachments/references.go
new file mode 100644
index 000000000..71d0174db
--- /dev/null
+++ b/internal/attachments/references.go
@@ -0,0 +1,604 @@
+package attachments
+
+import (
+	"fmt"
+	"net/url"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/yuin/goldmark"
+	"github.com/yuin/goldmark/ast"
+	"github.com/yuin/goldmark/text"
+)
+
+type attachmentArg struct {
+	Path            string
+	URL             string
+	Alt             string
+	RendersAsPlayer bool
+}
+
+type attachableMarkdown struct {
+	markdown string
+	args     []attachmentArg
+}
+
+type attachResult struct {
+	Rewritten string
+	ToAppend  []attachmentArg
+}
+
+func isASCIIPunct(c byte) bool {
+	return (c >= '!' && c <= '/') || (c >= ':' && c <= '@') || (c >= '[' && c <= '`') || (c >= '{' && c <= '~')
+}
+
+func unescapeCommonMark(dest string) string {
+	var b strings.Builder
+	for i := 0; i < len(dest); i++ {
+		if dest[i] == '\\' && i+1 < len(dest) && isASCIIPunct(dest[i+1]) {
+			b.WriteByte(dest[i+1])
+			i++
+			continue
+		}
+		b.WriteByte(dest[i])
+	}
+	s := b.String()
+	if unescaped, err := url.PathUnescape(s); err == nil {
+		s = unescaped
+	}
+	return s
+}
+
+func isScheme(s string) bool {
+	if len(s) == 0 {
+		return false
+	}
+	if !((s[0] >= 'a' && s[0] <= 'z') || (s[0] >= 'A' && s[0] <= 'Z')) {
+		return false
+	}
+	for i := 1; i < len(s); i++ {
+		c := s[i]
+		if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '+' || c == '-' || c == '.') {
+			return false
+		}
+	}
+	return true
+}
+
+func isLocalPath(dest string) bool {
+	if strings.HasPrefix(dest, "#") {
+		return false
+	}
+	if strings.HasPrefix(dest, "//") {
+		return false
+	}
+	colonIdx := strings.Index(dest, ":")
+	if colonIdx != -1 {
+		scheme := dest[:colonIdx]
+		if len(scheme) >= 2 && isScheme(scheme) {
+			return false
+		}
+	}
+	return true
+}
+
+func matchDestination(dest, argPath string) bool {
+	if !isLocalPath(dest) {
+		return false
+	}
+	cleanDest := dest
+	if strings.HasPrefix(cleanDest, "<") && strings.HasSuffix(cleanDest, ">") {
+		cleanDest = cleanDest[1 : len(cleanDest)-1]
+	}
+	unescaped := unescapeCommonMark(cleanDest)
+
+	if unescaped == argPath || filepath.Clean(unescaped) == filepath.Clean(argPath) {
+		return true
+	}
+	if filepath.ToSlash(unescaped) == filepath.ToSlash(argPath) {
+		return true
+	}
+	absDest, err1 := filepath.Abs(unescaped)
+	absArg, err2 := filepath.Abs(argPath)
+	if err1 == nil && err2 == nil && filepath.Clean(absDest) == filepath.Clean(absArg) {
+		return true
+	}
+	return false
+}
+
+func findMatchingArg(dest string, args []attachmentArg) (int, *attachmentArg) {
+	for i := range args {
+		if matchDestination(dest, args[i].Path) {
+			return i, &args[i]
+		}
+	}
+	return -1, nil
+}
+
+func newAttachableMarkdown(markdown string, args []attachmentArg) (attachableMarkdown, error) {
+	doc := goldmark.New().Parser().Parse(text.NewReader([]byte(markdown)))
+	var offendingPaths []string
+	seen := make(map[string]bool)
+
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		img, ok := n.(*ast.Image)
+		if !ok || img.Reference == nil {
+			return ast.WalkContinue, nil
+		}
+		_, arg := findMatchingArg(string(img.Destination), args)
+		if arg != nil && arg.RendersAsPlayer {
+			seen[arg.Path] = true
+		}
+		return ast.WalkContinue, nil
+	})
+
+	if len(seen) > 0 {
+		for _, arg := range args {
+			if seen[arg.Path] {
+				offendingPaths = append(offendingPaths, arg.Path)
+			}
+		}
+		return attachableMarkdown{}, fmt.Errorf("cannot embed a video as a reference-style image: %s", strings.Join(offendingPaths, ", "))
+	}
+
+	return attachableMarkdown{markdown: markdown, args: args}, nil
+}
+
+type replacement struct {
+	start int
+	end   int
+	text  string
+}
+
+func scanInline(src []byte, pos int, isImage bool) (destStart, destEnd, embedEnd int, ok bool) {
+	openBracket := pos
+	if isImage {
+		openBracket = pos + 1
+	}
+	if openBracket >= len(src) || src[openBracket] != '[' {
+		return 0, 0, 0, false
+	}
+	bracketDepth := 1
+	labelEnd := -1
+	i := openBracket + 1
+	for i < len(src) {
+		c := src[i]
+		if c == '\\' && i+1 < len(src) {
+			i += 2
+			continue
+		}
+		if c == '`' {
+			numTicks := 0
+			for i < len(src) && src[i] == '`' {
+				numTicks++
+				i++
+			}
+			for i < len(src) {
+				if src[i] == '`' {
+					closeTicks := 0
+					for i < len(src) && src[i] == '`' {
+						closeTicks++
+						i++
+					}
+					if closeTicks == numTicks {
+						break
+					}
+				} else {
+					i++
+				}
+			}
+			continue
+		}
+		if c == '[' {
+			bracketDepth++
+		} else if c == ']' {
+			bracketDepth--
+			if bracketDepth == 0 {
+				labelEnd = i
+				break
+			}
+		}
+		i++
+	}
+	if labelEnd == -1 || labelEnd+1 >= len(src) || src[labelEnd+1] != '(' {
+		return 0, 0, 0, false
+	}
+	p := labelEnd + 2
+	for p < len(src) && (src[p] == ' ' || src[p] == '\t' || src[p] == '\r' || src[p] == '\n') {
+		p++
+	}
+	destStart = p
+	if p < len(src) && src[p] == '<' {
+		p++
+		for p < len(src) {
+			if src[p] == '\\' && p+1 < len(src) {
+				p += 2
+				continue
+			}
+			if src[p] == '>' {
+				p++
+				break
+			}
+			p++
+		}
+		destEnd = p
+	} else {
+		opened := 0
+		for p < len(src) {
+			c := src[p]
+			if c == '\\' && p+1 < len(src) {
+				p += 2
+				continue
+			} else if c == '(' {
+				opened++
+			} else if c == ')' {
+				opened--
+				if opened < 0 {
+					break
+				}
+			} else if c == ' ' || c == '\t' || c == '\r' || c == '\n' {
+				break
+			}
+			p++
+		}
+		destEnd = p
+	}
+	for p < len(src) && (src[p] == ' ' || src[p] == '\t' || src[p] == '\r' || src[p] == '\n') {
+		p++
+	}
+	if p < len(src) && (src[p] == '"' || src[p] == '\'' || src[p] == '(') {
+		closer := src[p]
+		if closer == '(' {
+			closer = ')'
+		}
+		p++
+		for p < len(src) {
+			if src[p] == '\\' && p+1 < len(src) {
+				p += 2
+				continue
+			}
+			if src[p] == closer {
+				p++
+				break
+			}
+			p++
+		}
+		for p < len(src) && (src[p] == ' ' || src[p] == '\t' || src[p] == '\r' || src[p] == '\n') {
+			p++
+		}
+	}
+	if p < len(src) && src[p] == ')' {
+		embedEnd = p + 1
+		return destStart, destEnd, embedEnd, true
+	}
+	return 0, 0, 0, false
+}
+
+func escapeCloseBrackets(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		if s[i] == ']' && (i == 0 || s[i-1] != '\\') {
+			b.WriteString("\\]")
+		} else {
+			b.WriteByte(s[i])
+		}
+	}
+	return b.String()
+}
+
+func attachAssetsToMarkdown(v attachableMarkdown) (attachResult, error) {
+	if _, err := newAttachableMarkdown(v.markdown, v.args); err != nil {
+		return attachResult{}, err
+	}
+
+	src := []byte(v.markdown)
+	doc := goldmark.New().Parser().Parse(text.NewReader(src))
+
+	usedByReference := make(map[string]bool)
+	var definitions []*ast.LinkReferenceDefinition
+	type inlineInfo struct {
+		node      ast.Node
+		pos       int
+		isImage   bool
+		destStart int
+		destEnd   int
+		embedEnd  int
+		arg       *attachmentArg
+		isAlone   bool
+	}
+	var inlines []inlineInfo
+
+	_ = ast.Walk(doc, func(n ast.Node, entering bool) (ast.WalkStatus, error) {
+		if !entering {
+			return ast.WalkContinue, nil
+		}
+		if def, ok := n.(*ast.LinkReferenceDefinition); ok {
+			definitions = append(definitions, def)
+			return ast.WalkContinue, nil
+		}
+		var pos int
+		var isImage bool
+		var ref *ast.ReferenceLink
+		var dest []byte
+		if img, ok := n.(*ast.Image); ok {
+			pos = img.Pos()
+			isImage = true
+			ref = img.Reference
+			dest = img.Destination
+		} else if lnk, ok := n.(*ast.Link); ok {
+			pos = lnk.Pos()
+			ref = lnk.Reference
+			dest = lnk.Destination
+		} else {
+			return ast.WalkContinue, nil
+		}
+
+		if ref != nil {
+			_, arg := findMatchingArg(string(dest), v.args)
+			if arg != nil {
+				usedByReference[arg.Path] = true
+			}
+			return ast.WalkContinue, nil
+		}
+
+		dStart, dEnd, eEnd, ok := scanInline(src, pos, isImage)
+		if !ok {
+			return ast.WalkContinue, nil
+		}
+		_, arg := findMatchingArg(string(dest), v.args)
+		if arg == nil || arg.URL == "" {
+			return ast.WalkContinue, nil
+		}
+
+		isAlone := false
+		if isImage && arg.RendersAsPlayer {
+			if p, ok := n.Parent().(*ast.Paragraph); ok {
+				if p.Lines().Len() == 1 && p.ChildCount() == 1 && p.FirstChild() == n {
+					isAlone = true
+				}
+			}
+		}
+
+		inlines = append(inlines, inlineInfo{
+			node:      n,
+			pos:       pos,
+			isImage:   isImage,
+			destStart: dStart,
+			destEnd:   dEnd,
+			embedEnd:  eEnd,
+			arg:       arg,
+			isAlone:   isAlone,
+		})
+
+		return ast.WalkContinue, nil
+	})
+
+	successfullyRewritten := make(map[string]bool)
+	var replacements []replacement
+
+	type aloneSpan struct {
+		start int
+		end   int
+	}
+	var aloneSpans []aloneSpan
+	for _, inf := range inlines {
+		if inf.isAlone {
+			aloneSpans = append(aloneSpans, aloneSpan{start: inf.pos, end: inf.embedEnd})
+		}
+	}
+
+	for _, inf := range inlines {
+		swallowed := false
+		for _, sp := range aloneSpans {
+			if inf.pos > sp.start && inf.embedEnd <= sp.end {
+				swallowed = true
+				break
+			}
+		}
+		if swallowed {
+			continue
+		}
+
+		if inf.isAlone {
+			replacements = append(replacements, replacement{
+				start: inf.pos,
+				end:   inf.embedEnd,
+				text:  inf.arg.URL,
+			})
+			successfullyRewritten[inf.arg.Path] = true
+		} else if inf.isImage && inf.arg.RendersAsPlayer {
+			if inf.pos > 0 && src[inf.pos-1] == '!' {
+				if inf.pos >= 2 && src[inf.pos-2] == '\\' {
+					replacements = append(replacements, replacement{
+						start: inf.pos,
+						end:   inf.pos + 1,
+						text:  "",
+					})
+				} else {
+					replacements = append(replacements, replacement{
+						start: inf.pos - 1,
+						end:   inf.pos + 1,
+						text:  "\\!",
+					})
+				}
+			} else {
+				replacements = append(replacements, replacement{
+					start: inf.pos,
+					end:   inf.pos + 1,
+					text:  "",
+				})
+			}
+
+			if inf.pos+1 < len(src) && src[inf.pos+1] == '[' && inf.pos+2 < len(src) && src[inf.pos+2] == ']' {
+				replacements = append(replacements, replacement{
+					start: inf.pos + 2,
+					end:   inf.pos + 2,
+					text:  escapeCloseBrackets(inf.arg.Alt),
+				})
+			}
+
+			replacements = append(replacements, replacement{
+				start: inf.destStart,
+				end:   inf.destEnd,
+				text:  inf.arg.URL,
+			})
+			successfullyRewritten[inf.arg.Path] = true
+		} else {
+			replacements = append(replacements, replacement{
+				start: inf.destStart,
+				end:   inf.destEnd,
+				text:  inf.arg.URL,
+			})
+			successfullyRewritten[inf.arg.Path] = true
+		}
+	}
+
+	for _, def := range definitions {
+		_, arg := findMatchingArg(string(def.Destination), v.args)
+		if arg == nil || arg.URL == "" {
+			continue
+		}
+		if !usedByReference[arg.Path] {
+			continue
+		}
+
+		lines := def.Lines()
+		if lines == nil || lines.Len() == 0 {
+			continue
+		}
+		seg0 := lines.At(0)
+		seg0Bytes := seg0.Value(src)
+
+		openBracket := strings.IndexByte(string(seg0Bytes), '[')
+		if openBracket == -1 {
+			continue
+		}
+		bracketDepth := 1
+		labelEnd := -1
+		for i := openBracket + 1; i < len(seg0Bytes); i++ {
+			c := seg0Bytes[i]
+			if c == '\\' && i+1 < len(seg0Bytes) {
+				i++
+				continue
+			}
+			if c == '[' {
+				bracketDepth++
+			} else if c == ']' {
+				bracketDepth--
+				if bracketDepth == 0 {
+					labelEnd = i
+					break
+				}
+			}
+		}
+		if labelEnd == -1 || labelEnd+1 >= len(seg0Bytes) || seg0Bytes[labelEnd+1] != ':' {
+			continue
+		}
+		p := labelEnd + 2
+		for p < len(seg0Bytes) && (seg0Bytes[p] == ' ' || seg0Bytes[p] == '\t') {
+			p++
+		}
+		if p >= len(seg0Bytes) || seg0Bytes[p] == '\r' || seg0Bytes[p] == '\n' {
+			inBlockquote := false
+			for parent := def.Parent(); parent != nil; parent = parent.Parent() {
+				if _, ok := parent.(*ast.Blockquote); ok {
+					inBlockquote = true
+					break
+				}
+			}
+			if inBlockquote {
+				continue
+			}
+		}
+
+		dStartInSeg := p
+		var dEndInSeg int
+		if dStartInSeg < len(seg0Bytes) && seg0Bytes[dStartInSeg] == '<' {
+			closed := false
+			p = dStartInSeg + 1
+			for p < len(seg0Bytes) {
+				if seg0Bytes[p] == '\\' && p+1 < len(seg0Bytes) {
+					p += 2
+					continue
+				}
+				if seg0Bytes[p] == '>' {
+					closed = true
+					p++
+					break
+				}
+				p++
+			}
+			if !closed {
+				continue
+			}
+			dEndInSeg = p
+		} else {
+			p = dStartInSeg
+			for p < len(seg0Bytes) && seg0Bytes[p] != ' ' && seg0Bytes[p] != '\t' && seg0Bytes[p] != '\r' && seg0Bytes[p] != '\n' {
+				p++
+			}
+			dEndInSeg = p
+		}
+
+		destStart := seg0.Start + dStartInSeg
+		destEnd := seg0.Start + dEndInSeg
+
+		replacements = append(replacements, replacement{
+			start: destStart,
+			end:   destEnd,
+			text:  arg.URL,
+		})
+		successfullyRewritten[arg.Path] = true
+	}
+
+	sort.Slice(replacements, func(i, j int) bool {
+		return replacements[i].start < replacements[j].start
+	})
+
+	var out strings.Builder
+	lastPos := 0
+	for _, r := range replacements {
+		if r.start < lastPos {
+			continue
+		}
+		out.Write(src[lastPos:r.start])
+		out.WriteString(r.text)
+		lastPos = r.end
+	}
+	out.Write(src[lastPos:])
+
+	var toAppend []attachmentArg
+	for _, arg := range v.args {
+		if arg.URL == "" {
+			continue
+		}
+		if !successfullyRewritten[arg.Path] {
+			toAppend = append(toAppend, arg)
+		}
+	}
+
+	return attachResult{
+		Rewritten: out.String(),
+		ToAppend:  toAppend,
+	}, nil
+}
+
+func isSingleImage(markdown, assetURL string) bool {
+	doc := goldmark.New().Parser().Parse(text.NewReader([]byte(markdown)))
+	if doc.ChildCount() != 1 {
+		return false
+	}
+	p, ok := doc.FirstChild().(*ast.Paragraph)
+	if !ok || p.ChildCount() != 1 {
+		return false
+	}
+	img, ok := p.FirstChild().(*ast.Image)
+	if !ok {
+		return false
+	}
+	return string(img.Destination) == assetURL
+}
