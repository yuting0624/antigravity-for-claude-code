+// Package attachments provides test helpers for attachments used by tests in other packages under pkg/cmd.
+package attachments
+
+import (
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/httpmock"
+)
+
+// UploadStub represents a stubbed upload response for tests.
+type UploadStub struct {
+	Name   string
+	Status int
+	Body   string
+}
+
+// StubUpload registers a mock HTTP response for an attachment upload to GitHub.com.
+func StubUpload(reg *httpmock.Registry, repositoryID int64, name string, status int, body string) {
+	repoIDStr := strconv.FormatInt(repositoryID, 10)
+	reg.Register(
+		func(req *http.Request) bool {
+			if !strings.EqualFold(req.Method, "POST") {
+				return false
+			}
+			if req.URL.Path != "/user-attachments/assets" {
+				return false
+			}
+			q := req.URL.Query()
+			return q.Get("name") == name && q.Get("repository_id") == repoIDStr
+		},
+		httpmock.StatusStringResponse(status, body),
+	)
+}
+
+// StubUploadToHost registers a mock HTTP response for an attachment upload to a specific host.
+func StubUploadToHost(t *testing.T, reg *httpmock.Registry, host string, repositoryID int64, name string, status int, body string) {
+	t.Helper()
+	repoIDStr := strconv.FormatInt(repositoryID, 10)
+	reg.Register(
+		func(req *http.Request) bool {
+			if req.URL.Host != host {
+				return false
+			}
+			if !strings.EqualFold(req.Method, "POST") {
+				return false
+			}
+			if req.URL.Path != "/user-attachments/assets" {
+				return false
+			}
+			q := req.URL.Query()
+			return q.Get("name") == name && q.Get("repository_id") == repoIDStr
+		},
+		httpmock.StatusStringResponse(status, body),
+	)
+}
+
+// NewTestAssets creates temporary test files and resolves them as UserAssets.
+func NewTestAssets(t *testing.T, names ...string) []UserAsset {
+	t.Helper()
+	t.Chdir(t.TempDir())
+
+	assets := make([]UserAsset, 0, len(names))
+	for _, name := range names {
+		if err := os.WriteFile(name, []byte("asset content"), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		a, err := newAsset("./"+name, "")
+		if err != nil {
+			t.Fatal(err)
+		}
+		assets = append(assets, a)
+	}
+	return assets
+}
diff --git a/internal/attachments/userasset.go b/internal/attachments/userasset.go
new file mode 100644
index 000000000..540d956ff
--- /dev/null
+++ b/internal/attachments/userasset.go
@@ -0,0 +1,160 @@
+package attachments
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+const (
+	maxImageBytes = 10 * 1024 * 1024
+	maxVideoBytes = 100 * 1024 * 1024
+)
+
+var openFile = func(path string) (io.ReadCloser, error) {
+	return os.Open(path)
+}
+
+var mediaTypes = map[string]string{
+	"png":  "image/png",
+	"jpg":  "image/jpeg",
+	"jpeg": "image/jpeg",
+	"gif":  "image/gif",
+	"webp": "image/webp",
+	"svg":  "image/svg+xml",
+	"mp4":  "video/mp4",
+	"mov":  "video/quicktime",
+	"webm": "video/webm",
+}
+
+type asset struct {
+	path        string
+	alt         string
+	contentType string
+	info        fs.FileInfo
+}
+
+// UserAsset represents an attached user asset (image or video).
+type UserAsset interface {
+	Path() string
+	markdown(assetURL string) string
+	rendersAsPlayer() bool
+	getAsset() *asset
+}
+
+type imageAsset struct {
+	asset
+}
+
+type videoAsset struct {
+	asset
+}
+
+func (a *asset) Path() string {
+	return a.path
+}
+
+func (a *asset) getAsset() *asset {
+	return a
+}
+
+func (a *imageAsset) rendersAsPlayer() bool {
+	return false
+}
+
+func (a *videoAsset) rendersAsPlayer() bool {
+	return true
+}
+
+func escapeAlt(alt string) string {
+	s := strings.ReplaceAll(alt, `\`, `\\`)
+	s = strings.ReplaceAll(s, `[`, `\[`)
+	s = strings.ReplaceAll(s, `]`, `\]`)
+	s = strings.ReplaceAll(s, "\r", " ")
+	s = strings.ReplaceAll(s, "\n", " ")
+	return s
+}
+
+func (a *imageAsset) markdown(assetURL string) string {
+	return fmt.Sprintf("![%s](%s)", escapeAlt(a.alt), assetURL)
+}
+
+func (a *videoAsset) markdown(assetURL string) string {
+	return assetURL
+}
+
+func formatMB(bytes int64) string {
+	return fmt.Sprintf("%.1f", float64(bytes)/(1024*1024))
+}
+
+func newAsset(path, alt string) (UserAsset, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		var pe *fs.PathError
+		if errors.As(err, &pe) {
+			return nil, fmt.Errorf("%s: %w", path, pe.Err)
+		}
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+
+	if info.IsDir() {
+		return nil, fmt.Errorf("%s is a directory", path)
+	}
+
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%s is not a regular file", path)
+	}
+
+	if info.Size() == 0 {
+		return nil, fmt.Errorf("%s is empty", path)
+	}
+
+	ext := strings.ToLower(filepath.Ext(path))
+	ext = strings.TrimPrefix(ext, ".")
+	contentType, ok := mediaTypes[ext]
+	if !ok {
+		return nil, fmt.Errorf("%s is not a supported file type (supported: png, jpg, jpeg, gif, webp, svg, mp4, mov, webm)", path)
+	}
+
+	isVideo := strings.HasPrefix(contentType, "video/")
+	if isVideo {
+		if info.Size() > maxVideoBytes {
+			return nil, fmt.Errorf("%s: videos must be at most %s MB", path, formatMB(maxVideoBytes))
+		}
+	} else {
+		if info.Size() > maxImageBytes {
+			return nil, fmt.Errorf("%s: images must be at most %s MB", path, formatMB(maxImageBytes))
+		}
+	}
+
+	if isVideo && alt != "" {
+		return nil, errors.New("cannot set alt text on video")
+	}
+
+	if alt == "" {
+		if isVideo {
+			alt = filepath.Base(path)
+		} else {
+			base := filepath.Base(path)
+			ext := filepath.Ext(base)
+			nameWithoutExt := strings.TrimSuffix(base, ext)
+			alt = strings.ReplaceAll(nameWithoutExt, ".", " ")
+		}
+	}
+
+	base := asset{
+		path:        path,
+		alt:         alt,
+		contentType: contentType,
+		info:        info,
+	}
+
+	if isVideo {
+		return &videoAsset{base}, nil
+	}
+	return &imageAsset{base}, nil
+}
