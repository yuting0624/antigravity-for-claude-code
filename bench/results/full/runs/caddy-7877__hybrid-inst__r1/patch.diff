+// trimPathSuffix is like strings.TrimSuffix, but customized for advanced URI
+// path suffix matching. The string suffix will be trimmed from the end
+// of escapedPath if escapedPath ends with suffix. Rather than a naive 1:1
+// comparison of each byte to determine if escapedPath ends with suffix,
+// both strings are iterated from the end, and if suffix has a '%' encoding
+// at a particular position, escapedPath must also have the same encoding
+// representation for that character. In other words, if the suffix string
+// uses the escaped form for a character, escapedPath must literally use the
+// same escape at that position. Otherwise, all character comparisons are
+// performed in normalized/unescaped space.
+func trimPathSuffix(escapedPath, suffix string) string {
+	iPath := len(escapedPath)
+	iSuffix := len(suffix)
+
+	for iPath > 0 && iSuffix > 0 {
+		if iSuffix >= 3 && suffix[iSuffix-3] == '%' && isHex(suffix[iSuffix-2]) && isHex(suffix[iSuffix-1]) {
+			if iPath < 3 || !strings.EqualFold(escapedPath[iPath-3:iPath], suffix[iSuffix-3:iSuffix]) {
+				return escapedPath
+			}
+			iPath -= 3
+			iSuffix -= 3
+			continue
+		}
+
+		if iPath >= 3 && escapedPath[iPath-3] == '%' {
+			ch, err := url.PathUnescape(escapedPath[iPath-3 : iPath])
+			if err != nil {
+				// should be impossible unless EscapedPath() is returning invalid values!
+				return escapedPath
+			}
