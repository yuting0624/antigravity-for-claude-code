+				return escapedPath
+			}
+			iPath -= 3
+			iSuffix--
+			continue
+		}
+
+		if !strings.EqualFold(string(escapedPath[iPath-1]), string(suffix[iSuffix-1])) {
+			return escapedPath
+		}
+		iPath--
+		iSuffix--
 	}
-	return string(r)
+
+	if iSuffix <= 0 {
