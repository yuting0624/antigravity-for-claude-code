+package timeouts
+
+import (
+	"net/http"
+	"time"
+
+	"go.uber.org/zap"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+)
+
+func init() {
+	caddy.RegisterModule(Timeouts{})
+}
+
+// Timeouts is a middleware that enforces idle timeouts and minimum transfer
+// rates on request bodies and responses.
+type Timeouts struct {
+	// ReadTimeout is the idle read timeout for the request body, reset on every
+	// successful read so a slow but steadily progressing upload survives while
+	// a stalled one is cut; 0 disables.
+	ReadTimeout time.Duration `json:"read_timeout,omitempty"`
+
+	// ReadMinRate is the minimum read rate in bytes per second; 0 disables.
+	ReadMinRate int64 `json:"read_min_rate,omitempty"`
+
+	// WriteTimeout is the idle write timeout for the response; 0 disables.
+	WriteTimeout time.Duration `json:"write_timeout,omitempty"`
+
+	// WriteMinRate is the minimum write rate in bytes per second; 0 disables.
+	WriteMinRate int64 `json:"write_min_rate,omitempty"`
+
+	// MaxWriteChunk is the maximum bytes covered by a single underlying write
+	// before the deadline is reset; 0 means caddyhttp.DefaultMaxWriteChunk.
+	MaxWriteChunk int `json:"max_write_chunk,omitempty"`
+
+	logger *zap.Logger
+}
+
+// CaddyModule returns the Caddy module information.
+func (Timeouts) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{
+		ID:  "http.handlers.timeouts",
+		New: func() caddy.Module { return new(Timeouts) },
+	}
+}
+
+// Provision sets up the module.
+func (t *Timeouts) Provision(ctx caddy.Context) error {
+	t.logger = ctx.Logger()
+	return nil
+}
+
+func (t Timeouts) ServeHTTP(w http.ResponseWriter, r *http.Request, next caddyhttp.Handler) error {
+	readOn := t.ReadTimeout > 0 || t.ReadMinRate > 0
+	writeOn := t.WriteTimeout > 0 || t.WriteMinRate > 0
+	if !readOn && !writeOn {
+		return next.ServeHTTP(w, r)
+	}
+
+	logger := t.logger
+	if logger == nil {
+		logger = zap.NewNop()
+	}
+
+	start := time.Now()
+
+	//nolint:bodyclose
+	ctrl := http.NewResponseController(w)
+
+	if readOn && r.Body != nil {
+		mine := caddyhttp.IdleDeadline{
+			Start:   start,
+			Timeout: t.ReadTimeout,
+			MinRate: t.ReadMinRate,
+		}
+		if outer, ok := r.Body.(*caddyhttp.IdleTimeoutReader); ok {
+			// Nesting a second wrapper inside an existing one would be ineffective,
+			// because the innermost wrapper sets the deadline last, so instead the
+			// already-installed policy is tightened for the duration of this route
+			// and restored afterwards.
+			prev := outer.CurrentDeadline()
+			outer.SetDeadline(prev.Restrict(mine))
+			defer outer.SetDeadline(prev)
+		} else {
+			r.Body = &caddyhttp.IdleTimeoutReader{
+				ReadCloser: r.Body,
+				Ctrl:       ctrl,
+				Deadline:   mine,
+				Logger:     logger,
+			}
+			// A deadline set here must not leak onto a later request on the same keep-alive connection.
+			defer func() {
+				_ = ctrl.SetReadDeadline(time.Time{})
+			}()
+		}
+	}
+
+	if writeOn {
+		mine := caddyhttp.IdleDeadline{
+			Start:   start,
+			Timeout: t.WriteTimeout,
+			MinRate: t.WriteMinRate,
+		}
+		outer := caddyhttp.FindIdleTimeoutWriter(w)
+		if outer != nil {
+			// Nesting a second wrapper inside an existing one would be ineffective,
+			// because the innermost wrapper sets the deadline last, so instead the
+			// already-installed policy is tightened for the duration of this route
+			// and restored afterwards.
+			prev := outer.CurrentDeadline()
+			outer.SetDeadline(prev.Restrict(mine))
+			defer outer.SetDeadline(prev)
+			if t.MaxWriteChunk > 0 {
+				newChunk := t.MaxWriteChunk
+				if outer.MaxChunk > 0 && outer.MaxChunk < newChunk {
+					newChunk = outer.MaxChunk
+				}
+				prevChunk := outer.SetMaxChunk(newChunk)
+				defer outer.SetMaxChunk(prevChunk)
+			}
+		} else {
+			w = &caddyhttp.IdleTimeoutWriter{
+				ResponseWriterWrapper: &caddyhttp.ResponseWriterWrapper{
+					ResponseWriter: w,
+				},
+				Ctrl:     ctrl,
+				Deadline: mine,
+				MaxChunk: t.MaxWriteChunk,
+				Logger:   logger,
+			}
+			// net/http only resets the write deadline per request when Server.WriteTimeout is configured.
+			defer func() {
+				_ = ctrl.SetWriteDeadline(time.Time{})
+			}()
+		}
+	}
+
+	return next.ServeHTTP(w, r)
+}
+
+// Interface guards
+var (
+	_ caddy.Provisioner           = (*Timeouts)(nil)
+	_ caddyhttp.MiddlewareHandler = (*Timeouts)(nil)
+)
