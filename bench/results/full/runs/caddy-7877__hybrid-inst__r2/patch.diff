+// trimPathSuffix is like strings.TrimSuffix, but customized for advanced URI
+// path suffix matching. The string suffix will be trimmed from the end
+// of escapedPath if escapedPath ends with suffix. Rather than a naive 1:1
+// comparison of each byte to determine if escapedPath ends with suffix,
+// both strings are iterated in lock-step from the end, and if suffix has a '%'
+// encoding at a particular position, escapedPath must also have the same encoding
+// representation for that character. In other words, if the suffix string
+// uses the escaped form for a character, escapedPath must literally use the
+// same escape at that position. Otherwise, all character comparisons are
+// performed in normalized/unescaped space.
+func trimPathSuffix(escapedPath, suffix string) string {
+	iPath := len(escapedPath) - 1
+	iSuffix := len(suffix) - 1
+	for iPath >= 0 && iSuffix >= 0 {
+		suffixCh := suffix[iSuffix]
+		ch := string(escapedPath[iPath])
+
+		// if the path has an escape sequence ending at this position, and the
+		// suffix does not itself use an escape here, decode the escape so the
+		// comparison is performed in normalized space
+		if iPath >= 2 && escapedPath[iPath-2] == '%' && !(iSuffix >= 2 && suffix[iSuffix-2] == '%') {
+			var err error
+			ch, err = url.PathUnescape(escapedPath[iPath-2 : iPath+1])
+			if err != nil {
+				// should be impossible unless EscapedPath() is returning invalid values!
+				return escapedPath
+			}
+			iPath -= 2
+		}
+
+		// suffix comparisons are case-insensitive to be consistent with the
+		// path matcher, which is case-insensitive for good reasons
+		if !strings.EqualFold(ch, string(suffixCh)) {
+			return escapedPath
+		}
+
+		iPath--
+		iSuffix--
+	}
+
+	// if we iterated through the entire suffix, we found it, so trim it
+	if iSuffix < 0 {
+		return escapedPath[:iPath+1]
 	}
-	return string(r)
