@@ -0,0 +1,11 @@
+// Package clientcfg holds retry configuration shared by the k6 Cloud API clients.
+package clientcfg
+
+import "time"
+
+const (
+	// RetryInterval is the default cloud request retry interval.
+	RetryInterval = 500 * time.Millisecond
+	// MaxRetries specifies the max retry attempts.
+	MaxRetries = 3
+)
diff --git a/internal/cloudapi/provisioning/api.go b/internal/cloudapi/provisioning/api.go
new file mode 100644
index 000000000..177957cdc
--- /dev/null
+++ b/internal/cloudapi/provisioning/api.go
@@ -0,0 +1,173 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// StartLocalExecution asks the provisioning API to start a test in local
+// execution mode for the given load test.
+func (c *Client) StartLocalExecution(
+	ctx context.Context, loadTestID int64, req StartLocalExecutionRequest,
+) (*StartLocalExecutionResponse, error) {
+	var opts map[string]interface{}
+	if len(req.Options) > 0 {
+		if err := json.Unmarshal(req.Options, &opts); err != nil {
+			return nil, fmt.Errorf("decoding options: %w", err)
+		}
+	}
+
+	sdkReq := k6cloud.NewStartLocalExecutionTestRequest(opts, req.MaxVUs, req.TotalDuration)
+	if req.ArchiveSize > 0 {
+		sdkReq.SetArchiveSize(int32(req.ArchiveSize)) //nolint:gosec
+	} else {
+		sdkReq.SetArchiveSizeNil()
+	}
+
+	body, err := json.Marshal(sdkReq)
+	if err != nil {
+		return nil, err
+	}
+
+	idempKey, err := randomHex()
+	if err != nil {
+		return nil, err
+	}
+
+	url := fmt.Sprintf("%s/provisioning/v1/load_tests/%d/start_local_execution", c.baseURL, loadTestID)
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(body))
+	if err != nil {
+		return nil, err
+	}
+	httpReq.Header.Set("Content-Type", "application/json")
+	httpReq.Header.Set("X-Stack-Id", strconv.FormatInt(c.stackID, 10))
+	httpReq.Header.Set("K6-Idempotency-Key", idempKey)
+	httpReq.GetBody = func() (io.ReadCloser, error) {
+		return io.NopCloser(bytes.NewReader(body)), nil
+	}
+
+	var sdkResp k6cloud.StartLocalExecutionTestResponse
+	if err := c.httpClient.Do(httpReq, &sdkResp); err != nil {
+		return nil, err
+	}
+
+	return fromStartLocalExecutionResponse(&sdkResp), nil
+}
+
+func fromStartLocalExecutionResponse(res *k6cloud.StartLocalExecutionTestResponse) *StartLocalExecutionResponse {
+	archiveUploadURL, _ := res.GetArchiveUploadUrlOk()
+
+	return &StartLocalExecutionResponse{
+		TestRunID:             res.GetTestRunId(),
+		ArchiveUploadURL:      archiveUploadURL,
+		TestRunDetailsPageURL: res.GetTestRunDetailsPageUrl(),
+		RuntimeConfig:         fromRuntimeConfig(res.GetRuntimeConfig()),
+	}
+}
+
+func fromRuntimeConfig(rc k6cloud.RuntimeConfig) RuntimeConfig {
+	m := rc.GetMetrics()
+	s := rc.GetSecrets()
+
+	return RuntimeConfig{
+		Metrics: MetricsConfig{
+			PushURL:               m.GetPushUrl(),
+			PushInterval:          m.PushInterval.Get(),
+			PushConcurrency:       m.PushConcurrency.Get(),
+			AggregationPeriod:     m.AggregationPeriod.Get(),
+			AggregationWaitPeriod: m.AggregationWaitPeriod.Get(),
+			AggregationMinSamples: m.AggregationMinSamples.Get(),
+			MaxSamplesPerPackage:  m.MaxSamplesPerPackage.Get(),
+		},
+		Secrets: SecretsConfig{
+			Endpoint:     s.GetEndpoint(),
+			ResponsePath: s.GetResponsePath(),
+		},
+		TestRunToken: rc.TestRunToken,
+	}
+}
+
+// UploadArchive uploads the given k6 archive bytes to a presigned URL
+// returned by StartLocalExecution. Presigned URLs must not carry an
+// Authorization header, so this request is sent unauthenticated.
+func (c *Client) UploadArchive(ctx context.Context, url string, body []byte) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPut, url, bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/x-tar")
+	req.ContentLength = int64(len(body))
+	req.GetBody = func() (io.ReadCloser, error) {
+		return io.NopCloser(bytes.NewReader(body)), nil
+	}
+
+	hc := NewHTTPClient(c.rawClient, "", c.version, c.logger)
+	return hc.Do(req, nil)
+}
+
+// WaitForTestRunReady polls the v6 test run status until the run reports
+// "initializing", meaning the cloud side is ready for k6 to start streaming
+// metrics.
+func (c *Client) WaitForTestRunReady(ctx context.Context, testRunID int64, pollInterval time.Duration) error {
+	var lastLoggedStatus v6.Status
+
+	for {
+		tp, err := c.v6Client.FetchTest(ctx, testRunID)
+		if err != nil {
+			return err
+		}
+
+		switch tp.Status {
+		case v6.StatusInitializing:
+			return nil
+		case v6.StatusAborted:
+			if msg := abortMessage(tp); msg != "" {
+				return fmt.Errorf("test run aborted before starting: %s", msg)
+			}
+			return errors.New("test run aborted before starting")
+		case v6.StatusCompleted:
+			return errors.New("test run completed before local execution could start")
+		default:
+			if tp.Status != lastLoggedStatus {
+				c.logger.WithField("status", tp.FormatStatus()).Info("Waiting for test run to be ready")
+				lastLoggedStatus = tp.Status
+			}
+		}
+
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(pollInterval):
+		}
+	}
+}
+
+func abortMessage(tp *v6.TestProgress) string {
+	for _, e := range tp.StatusHistory {
+		if e.Status == v6.StatusAborted && e.Message != "" {
+			return e.Message
+		}
+	}
+	return ""
+}
+
+func randomHex() (string, error) {
+	var key [8]byte
+	if _, err := rand.Read(key[:]); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(key[:]), nil
+}
diff --git a/internal/cloudapi/provisioning/client.go b/internal/cloudapi/provisioning/client.go
new file mode 100644
index 000000000..df939009f
--- /dev/null
+++ b/internal/cloudapi/provisioning/client.go
@@ -0,0 +1,77 @@
+// Package provisioning implements a client for Grafana Cloud k6's
+// provisioning API, used by `k6 cloud run --local-execution` to start a test
+// run whose load is generated locally while results stream to Grafana Cloud
+// k6.
+package provisioning
+
+import (
+	"errors"
+	"net/http"
+	"time"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+// Client handles communication with Grafana Cloud k6's provisioning API, and
+// with the v6 API for the pieces of the local-execution flow (creating or
+// finding a load test, and waiting for a test run to be ready) that belong
+// to it.
+type Client struct {
+	logger  logrus.FieldLogger
+	token   string
+	stackID int64
+	version string
+	baseURL string
+
+	apiClient  *k6cloud.APIClient
+	v6Client   *v6.Client
+	httpClient *HTTPClient
+	rawClient  *http.Client
+}
+
+// NewClient returns a new client for the provisioning API.
+func NewClient(
+	logger logrus.FieldLogger, token, host, version string, stackID int64, timeout time.Duration,
+) (*Client, error) {
+	if token == "" {
+		return nil, errors.New("token is required to create provisioning API client")
+	}
+
+	cfg := k6cloud.NewConfiguration()
+	cfg.UserAgent = "k6cloud/" + version
+	cfg.Servers = k6cloud.ServerConfigurations{
+		{
+			URL:         host,
+			Description: "Grafana Cloud k6 API.",
+		},
+	}
+	cfg.HTTPClient = &http.Client{Timeout: timeout}
+	cfg.MaxRetries = clientcfg.MaxRetries
+	cfg.RetryInterval = clientcfg.RetryInterval
+
+	v6Client, err := v6.NewClient(logger, token, host, version, timeout)
+	if err != nil {
+		return nil, err
+	}
+	if err := v6Client.SetStackID(stackID); err != nil {
+		return nil, err
+	}
+
+	rawClient := &http.Client{Timeout: timeout}
+
+	return &Client{
+		logger:     logger,
+		token:      token,
+		stackID:    stackID,
+		version:    version,
+		baseURL:    host,
+		apiClient:  k6cloud.NewAPIClient(cfg),
+		v6Client:   v6Client,
+		httpClient: NewHTTPClient(rawClient, token, version, logger),
+		rawClient:  rawClient,
+	}, nil
+}
diff --git a/internal/cloudapi/provisioning/errors.go b/internal/cloudapi/provisioning/errors.go
new file mode 100644
index 000000000..bf1c6f790
--- /dev/null
+++ b/internal/cloudapi/provisioning/errors.go
@@ -0,0 +1,45 @@
+package provisioning
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+)
+
+var errUnknown = errors.New("an error occurred communicating with the k6 Cloud provisioning API")
+
+// ResponseError represents an error caused by a non-2xx response from the
+// provisioning API. Unlike the v6 and legacy clients, the provisioning API's
+// error body shape isn't parsed into a structured model - the raw body is
+// kept verbatim so callers (and their error messages) see whatever the
+// backend sent.
+type ResponseError struct {
+	StatusCode int
+	Body       string
+}
+
+func (e *ResponseError) Error() string {
+	return fmt.Sprintf("provisioning API returned %d: %s", e.StatusCode, e.Body)
+}
+
+// CheckResponse checks the response of an HTTP call made to the provisioning
+// API. It returns nil for 2xx responses, httperr's classified errors for
+// 401/403, and a *ResponseError carrying the raw body for any other
+// non-2xx status.
+func CheckResponse(r *http.Response) error {
+	if r == nil {
+		return errUnknown
+	}
+
+	if r.StatusCode >= 200 && r.StatusCode <= 299 {
+		return nil
+	}
+
+	data, err := io.ReadAll(r.Body)
+	if err != nil {
+		return err
+	}
+
+	return &ResponseError{StatusCode: r.StatusCode, Body: string(data)}
+}
diff --git a/internal/cloudapi/provisioning/http_client.go b/internal/cloudapi/provisioning/http_client.go
new file mode 100644
index 000000000..d079e7a37
--- /dev/null
+++ b/internal/cloudapi/provisioning/http_client.go
@@ -0,0 +1,121 @@
+package provisioning
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"time"
+
+	"github.com/sirupsen/logrus"
+
+	"go.k6.io/k6/v2/internal/cloudapi/clientcfg"
+)
+
+// HTTPClient is a small, retrying HTTP client used for the provisioning
+// API's endpoints and for pushing metrics with a test-run-scoped token. It
+// mirrors the retry/error-handling semantics of the existing cloud API
+// clients: 5xx and 429 responses are retried, everything else is not.
+type HTTPClient struct {
+	client  *http.Client
+	token   string
+	version string
+	logger  logrus.FieldLogger
+}
+
+// NewHTTPClient creates a new HTTPClient. token may be empty, in which case
+// requests are sent without an Authorization header - this is required for
+// presigned upload URLs, which reject requests that carry one.
+func NewHTTPClient(client *http.Client, token, version string, logger logrus.FieldLogger) *HTTPClient {
+	return &HTTPClient{client: client, token: token, version: version, logger: logger}
+}
+
+// Do sends req and, on success, decodes the JSON response body into v (when
+// v is non-nil). It retries on transport errors and 5xx/429 responses,
+// replaying the request body via req.GetBody on each attempt.
+func (c *HTTPClient) Do(req *http.Request, v any) error {
+	if req.Body != nil && req.GetBody == nil {
+		originalBody, err := io.ReadAll(req.Body)
+		if err != nil {
+			return err
+		}
+		if err := req.Body.Close(); err != nil {
+			return err
+		}
+
+		req.GetBody = func() (io.ReadCloser, error) {
+			return io.NopCloser(bytes.NewReader(originalBody)), nil
+		}
+		req.Body, _ = req.GetBody()
+	}
+
+	if c.token != "" {
+		req.Header.Set("Authorization", "Bearer "+c.token)
+	}
+	req.Header.Set("User-Agent", "k6cloud/"+c.version)
+
+	for i := 1; i <= clientcfg.MaxRetries; i++ {
+		retry, err := c.do(req, v, i)
+		if retry {
+			select {
+			case <-req.Context().Done():
+				return req.Context().Err()
+			case <-time.After(clientcfg.RetryInterval):
+			}
+			if req.GetBody != nil {
+				req.Body, _ = req.GetBody()
+			}
+			continue
+		}
+
+		return err
+	}
+
+	return nil
+}
+
+func (c *HTTPClient) do(req *http.Request, v any, attempt int) (retry bool, err error) {
+	resp, err := c.client.Do(req) //nolint:gosec
+
+	defer func() {
+		if resp != nil {
+			_, _ = io.Copy(io.Discard, resp.Body)
+			if cerr := resp.Body.Close(); cerr != nil && err == nil {
+				err = cerr
+			}
+		}
+	}()
+
+	if shouldRetry(resp, err, attempt, clientcfg.MaxRetries) {
+		return true, err
+	}
+
+	if err != nil {
+		return false, err
+	}
+
+	if err = CheckResponse(resp); err != nil {
+		return false, err
+	}
+
+	if v != nil {
+		if err = json.NewDecoder(resp.Body).Decode(v); errors.Is(err, io.EOF) {
+			err = nil // Ignore EOF from an empty body.
+		}
+	}
+
+	return false, err
+}
+
+func shouldRetry(resp *http.Response, err error, attempt, maxAttempts int) bool {
+	if attempt >= maxAttempts {
+		return false
+	}
+
+	if resp == nil || err != nil {
+		return true
+	}
+
+	return resp.StatusCode >= 500 || resp.StatusCode == http.StatusTooManyRequests
+}
diff --git a/internal/cloudapi/provisioning/notify.go b/internal/cloudapi/provisioning/notify.go
new file mode 100644
index 000000000..5a5fe68f8
--- /dev/null
+++ b/internal/cloudapi/provisioning/notify.go
@@ -0,0 +1,87 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+
+	"go.k6.io/k6/v2/errext"
+)
+
+// Error codes reported to the provisioning API's notify endpoint, describing
+// how the test run stopped.
+const (
+	notifyCodeAbortedByUserOrScript = 8036
+	notifyCodeScriptError           = 8035
+	notifyCodeTimeoutOrOutput       = 8034
+)
+
+type notifyError struct {
+	Code   int32  `json:"code"`
+	Reason string `json:"reason"`
+}
+
+type notifyRequestBody struct {
+	EventType string       `json:"event_type"`
+	Error     *notifyError `json:"error"`
+}
+
+// NotifyTestRunCompleted reports the end of a locally-executed test run to
+// the provisioning API. token is the test-run-scoped token from the
+// StartLocalExecution response's runtime config, not the client's own
+// (long-lived) token. testErr, when non-nil, is mapped to an error code
+// describing how the test stopped.
+func (c *Client) NotifyTestRunCompleted(ctx context.Context, testRunID int64, token string, testErr error) error {
+	body, err := json.Marshal(notifyRequestBody{
+		EventType: "script_execution_completed",
+		Error:     mapTestErrorToNotifyCode(testErr),
+	})
+	if err != nil {
+		return err
+	}
+
+	url := fmt.Sprintf("%s/provisioning/v1/test_runs/%d/notify", c.baseURL, testRunID)
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.GetBody = func() (io.ReadCloser, error) {
+		return io.NopCloser(bytes.NewReader(body)), nil
+	}
+
+	hc := NewHTTPClient(c.rawClient, token, c.version, c.logger)
+	return hc.Do(req, nil)
+}
+
+// mapTestErrorToNotifyCode maps a k6 test error to the error code reported
+// to the provisioning API's notify endpoint. It returns nil for a clean
+// finish, and for thresholds that only failed after the test ended (the run
+// itself completed normally).
+func mapTestErrorToNotifyCode(err error) *notifyError {
+	if err == nil {
+		return nil
+	}
+
+	var hasReason errext.HasAbortReason
+	if !errors.As(err, &hasReason) {
+		return &notifyError{Reason: err.Error()}
+	}
+
+	switch hasReason.AbortReason() {
+	case errext.AbortedByUser, errext.AbortedByScriptAbort, errext.AbortedByThreshold:
+		return &notifyError{Code: notifyCodeAbortedByUserOrScript, Reason: err.Error()}
+	case errext.AbortedByScriptError:
+		return &notifyError{Code: notifyCodeScriptError, Reason: err.Error()}
+	case errext.AbortedByOutput, errext.AbortedByTimeout:
+		return &notifyError{Code: notifyCodeTimeoutOrOutput, Reason: err.Error()}
+	case errext.AbortedByThresholdsAfterTestEnd:
+		return nil
+	default:
+		return &notifyError{Reason: err.Error()}
+	}
+}
diff --git a/internal/cloudapi/provisioning/provision.go b/internal/cloudapi/provisioning/provision.go
new file mode 100644
index 000000000..ab3f3d13a
--- /dev/null
+++ b/internal/cloudapi/provisioning/provision.go
@@ -0,0 +1,100 @@
+package provisioning
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"go.k6.io/k6/v2/lib"
+)
+
+// defaultPollInterval is used by ProvisionLocalExecution when
+// ProvisionParams.PollInterval is left unset.
+const defaultPollInterval = 2 * time.Second
+
+// ProvisionParams describes a local execution test run to provision.
+type ProvisionParams struct {
+	// Name is the load test's name, used to create or find it.
+	Name string
+	// ProjectID is the project the load test belongs to.
+	ProjectID int64
+	// MaxVUs is the maximum number of virtual users during the test.
+	MaxVUs int32
+	// TotalDuration is the total duration of the test, in seconds.
+	TotalDuration int32
+	// Options holds the parsed k6 script options.
+	Options json.RawMessage
+	// Archive, when non-nil, is uploaded to the cloud after the test run is started.
+	Archive *lib.Archive
+	// PollInterval overrides the default interval used while waiting for
+	// the test run to be ready. Defaults to 2 seconds when zero.
+	PollInterval time.Duration
+}
+
+// ProvisionResult holds what's needed to run the test locally and stream
+// results to Grafana Cloud k6.
+type ProvisionResult struct {
+	// TestRunID is the id of the created test run.
+	TestRunID int64
+	// TestRunDetailsPageURL is the URL to the Grafana web app's test run details page.
+	TestRunDetailsPageURL string
+	// RuntimeConfig configures where and how the test run reports its data.
+	RuntimeConfig RuntimeConfig
+}
+
+// ProvisionLocalExecution ensures the load test exists, starts it in local
+// execution mode, optionally uploads the test archive, and waits until the
+// cloud side is ready to receive metrics.
+func (c *Client) ProvisionLocalExecution(ctx context.Context, p ProvisionParams) (*ProvisionResult, error) {
+	loadTestID, err := c.v6Client.CreateOrFindLoadTest(ctx, p.ProjectID, p.Name)
+	if err != nil {
+		return nil, fmt.Errorf("create or find load test: %w", err)
+	}
+
+	var archiveBytes []byte
+	var archiveSize int64
+	if p.Archive != nil {
+		var buf bytes.Buffer
+		if err := p.Archive.Write(&buf); err != nil {
+			return nil, fmt.Errorf("write archive: %w", err)
+		}
+		archiveBytes = buf.Bytes()
+		archiveSize = int64(len(archiveBytes))
+	}
+
+	sleResp, err := c.StartLocalExecution(ctx, loadTestID, StartLocalExecutionRequest{
+		Options:       p.Options,
+		MaxVUs:        p.MaxVUs,
+		TotalDuration: p.TotalDuration,
+		ArchiveSize:   archiveSize,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("start local execution: %w", err)
+	}
+
+	if p.Archive != nil {
+		if sleResp.ArchiveUploadURL != nil {
+			if err := c.UploadArchive(ctx, *sleResp.ArchiveUploadURL, archiveBytes); err != nil {
+				return nil, fmt.Errorf("upload archive: %w", err)
+			}
+		} else {
+			c.logger.Warn("No archive upload URL was returned by the cloud API; skipping archive upload")
+		}
+	}
+
+	pollInterval := p.PollInterval
+	if pollInterval <= 0 {
+		pollInterval = defaultPollInterval
+	}
+	if err := c.WaitForTestRunReady(ctx, sleResp.TestRunID, pollInterval); err != nil {
+		return nil, fmt.Errorf("wait for test run ready: %w", err)
