diff --git a/internal/cloudapi/provisioning/test/server.go b/internal/cloudapi/provisioning/test/server.go
new file mode 100644
index 000000000..f0f4646d2
--- /dev/null
+++ b/internal/cloudapi/provisioning/test/server.go
@@ -0,0 +1,155 @@
+// Package test provides an HTTP test server that fakes the provisioning API
+// (and the pieces of the v6 API used alongside it) for local-execution
+// tests.
+package test
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	k6cloud "github.com/grafana/k6-cloud-openapi-client-go/k6"
+
+	v6 "go.k6.io/k6/v2/internal/cloudapi/v6"
+)
+
+const (
+	// DefaultLoadTestID is the load test id used by DefaultStartLocalExecutionResponse.
+	DefaultLoadTestID int64 = 456
+	// DefaultTestRunID is the test run id used by DefaultStartLocalExecutionResponse.
+	DefaultTestRunID int64 = 123
+	// PresignedUploadPath is the path DefaultStartLocalExecutionResponse points
+	// its archive upload URL to.
+	PresignedUploadPath = "/s3/presigned-upload"
+)
+
+// Server is a test HTTP server that fakes the provisioning API.
+type Server struct {
+	*httptest.Server
+
+	// Mux is the server's request mux. Tests can register additional
+	// routes (e.g. a catch-all for metrics pushes) directly on it.
+	Mux *http.ServeMux
+
+	fetchHits atomic.Int32
+}
+
+// NewServer creates a test server with no routes registered. Use the
+// Handle* methods to register the endpoints a test cares about.
+func NewServer(t *testing.T) *Server {
+	t.Helper()
+
+	mux := http.NewServeMux()
+	s := &Server{Mux: mux}
+
+	srv := httptest.NewServer(mux)
+	s.Server = srv
+	t.Cleanup(srv.Close)
+
+	return s
+}
+
+// PresignedUploadURL returns the full URL of the server's presigned upload path.
+func (s *Server) PresignedUploadURL() string {
+	return s.URL + PresignedUploadPath
+}
+
+// HandleCreateLoadTest registers the v6 create-or-find load test endpoint
+// for the given project id.
+func (s *Server) HandleCreateLoadTest(projectID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/projects/%d/load_tests", projectID), h)
+}
+
+// HandleStartLocalExecution registers the start_local_execution endpoint
+// for the given load test id.
+func (s *Server) HandleStartLocalExecution(loadTestID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/load_tests/%d/start_local_execution", loadTestID), h)
+}
+
+// HandlePresignedUpload registers a handler for the given presigned upload path.
+func (s *Server) HandlePresignedUpload(path string, h http.HandlerFunc) {
+	s.Mux.HandleFunc(path, h)
+}
+
+// HandleNotify registers the notify endpoint for the given test run id.
+func (s *Server) HandleNotify(testRunID int64, h http.HandlerFunc) {
+	s.Mux.HandleFunc(fmt.Sprintf("/provisioning/v1/test_runs/%d/notify", testRunID), h)
+}
+
+// HandleFetchTestRun registers the v6 test run fetch endpoint for the given
+// test run id. Each request advances through progressions in order,
+// repeating the last entry once exhausted.
+func (s *Server) HandleFetchTestRun(testRunID int64, progressions []v6.TestProgress) {
+	s.Mux.HandleFunc(fmt.Sprintf("/cloud/v6/test_runs/%d", testRunID), func(w http.ResponseWriter, _ *http.Request) {
+		n := int(s.fetchHits.Add(1)) - 1
+		if n >= len(progressions) {
+			n = len(progressions) - 1
+		}
+		tp := progressions[n]
+
+		res := k6cloud.NewTestRunApiModelWithDefaults()
+		res.SetStatus(tp.Status.String())
+		res.SetResult(tp.Result.String())
+		res.SetEstimatedDuration(tp.EstimatedDuration)
+		res.SetExecutionDuration(tp.ExecutionDuration)
+		res.SetStatusHistory(v6.ToStatusModel(tp.StatusHistory))
+		// SDK decoder requires these keys on the other end even when empty.
+		res.SetDistribution([]k6cloud.DistributionZoneApiModel{})
+		res.SetResultDetails(k6cloud.ResultDetailsApiModelAsTestRunApiModelResultDetails(k6cloud.NewResultDetailsApiModel("")))
+		res.SetOptions(map[string]any{})
+		writeJSON(w, http.StatusOK, res)
+	})
+}
+
+// FetchTestRunHitCount returns how many times the fetch-test-run endpoint
+// registered by HandleFetchTestRun has been hit.
+func (s *Server) FetchTestRunHitCount() int32 {
+	return s.fetchHits.Load()
+}
+
+// DefaultStartLocalExecutionResponse returns a fully populated
+// start_local_execution response for DefaultLoadTestID/DefaultTestRunID,
+// suitable as a starting point for tests that only care about overriding a
+// couple of fields.
+func DefaultStartLocalExecutionResponse() *k6cloud.StartLocalExecutionTestResponse {
+	metrics := k6cloud.NewMetricsRuntimeConfigWithDefaults()
+	metrics.SetPushUrl("https://ingest.k6.io/v1/metrics")
+	metrics.SetPushInterval("2s")
+	metrics.SetPushConcurrency(5)
+	metrics.SetAggregationPeriod("3s")
+	metrics.SetAggregationWaitPeriod("1s")
+	metrics.SetMaxSamplesPerPackage(2000)
+
+	secrets := k6cloud.NewSecretsRuntimeConfigWithDefaults()
+	secrets.SetEndpoint(fmt.Sprintf(
+		"https://api.k6.io/provisioning/v1/test_runs/%d/decrypt_secret?name={key}", DefaultTestRunID,
+	))
+	secrets.SetResponsePath("plaintext")
+
+	rc := k6cloud.NewRuntimeConfigWithDefaults()
+	rc.Metrics = *metrics
+	rc.Secrets = *secrets
+	rc.Traces = *k6cloud.NewTracesRuntimeConfigWithDefaults()
+	rc.Files = *k6cloud.NewFilesRuntimeConfigWithDefaults()
+	rc.Logs = *k6cloud.NewLogsRuntimeConfigWithDefaults()
+	rc.TestRunToken = "test-run-token-abc"
+
+	resp := k6cloud.NewStartLocalExecutionTestResponseWithDefaults()
+	resp.SetTestRunId(DefaultTestRunID)
+	resp.SetRuntimeConfig(*rc)
+	resp.SetArchiveUploadUrl("https://bucket.s3.amazonaws.com/presigned-upload-path")
+	resp.SetTestRunDetailsPageUrl(fmt.Sprintf("https://app.k6.io/runs/%d", DefaultTestRunID))
+
+	return resp
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	if err := json.NewEncoder(w).Encode(v); err != nil {
+		panic(fmt.Errorf("provtest: encoding JSON: %w", err))
+	}
+}
