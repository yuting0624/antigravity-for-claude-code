+package provisioning
+
+import "encoding/json"
+
+// StartLocalExecutionRequest is the payload for starting a test in local
+// execution mode.
+type StartLocalExecutionRequest struct {
+	// Options holds the parsed k6 script options.
+	Options json.RawMessage
+	// MaxVUs is the maximum number of virtual users during the test.
+	MaxVUs int32
+	// TotalDuration is the total duration of the test, in seconds.
+	TotalDuration int32
+	// ArchiveSize is the k6 archive file size in bytes, or 0 when no
+	// archive will be uploaded (encoded as an explicit JSON null on the wire).
+	ArchiveSize int64
+}
+
+// StartLocalExecutionResponse is the response to starting a test in local
+// execution mode.
+type StartLocalExecutionResponse struct {
+	// TestRunID is the id of the created test run.
+	TestRunID int64
+	// ArchiveUploadURL is the URL to upload the k6 archive to, or nil if no
+	// archive upload was requested or offered.
+	ArchiveUploadURL *string
+	// TestRunDetailsPageURL is the URL to the Grafana web app's test run
+	// details page.
+	TestRunDetailsPageURL string
+	// RuntimeConfig configures where and how the test run should report
+	// metrics, logs and other data while it executes.
+	RuntimeConfig RuntimeConfig
+}
+
+// RuntimeConfig configures where and how a locally-executed test run
+// reports its data back to Grafana Cloud k6.
+type RuntimeConfig struct {
+	Metrics MetricsConfig
+	Secrets SecretsConfig
+	// TestRunToken is a token scoped to this test run, used to authenticate
+	// metrics pushes and the end-of-test notification.
+	TestRunToken string
+}
+
+// MetricsConfig configures where and how metrics are pushed for a test run.
+type MetricsConfig struct {
+	// PushURL is the URL metrics should be pushed to.
+	PushURL string
+
+	// PushInterval, when set, overrides the default metric push interval.
+	PushInterval *string
+	// PushConcurrency, when set, overrides the default metric push concurrency.
+	PushConcurrency *int32
+	// AggregationPeriod, when set, overrides the default aggregation period.
+	AggregationPeriod *string
+	// AggregationWaitPeriod, when set, overrides the default aggregation wait period.
+	AggregationWaitPeriod *string
+	// AggregationMinSamples, when set, overrides the default minimum number
+	// of samples for aggregation. k6 OSS has no equivalent knob and ignores it.
+	AggregationMinSamples *int32
+	// MaxSamplesPerPackage, when set, overrides the max number of time
+	// series sent in a single batch.
+	MaxSamplesPerPackage *int32
+}
+
+// SecretsConfig configures the endpoint used to decrypt cloud-managed secrets.
+type SecretsConfig struct {
+	// Endpoint is a URL template, with a {key} placeholder, used to decrypt a secret.
+	Endpoint string
+	// ResponsePath is the JSON path to the decrypted secret value in the response.
+	ResponsePath string
+}
