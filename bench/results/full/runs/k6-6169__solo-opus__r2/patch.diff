+// CreateOrFindLoadTest makes sure a load test named name exists in the given
+// project and returns its id. On a 409 conflict - a test with that name is
+// already there - it looks the existing one up by name instead of failing.
+//
+// Unlike [Client.UploadTest] it never sends a script: local execution uploads
+// the archive out-of-band, through a presigned URL.
+func (c *Client) CreateOrFindLoadTest(ctx context.Context, projectID int64, name string) (int64, error) {
+	lt, err := c.createEmptyTest(ctx, name, projectID)
+	if err == nil {
+		return lt.GetId(), nil
+	}
+	var rerr ResponseError
+	if !errors.As(err, &rerr) || rerr.Response == nil || rerr.Response.StatusCode != http.StatusConflict {
+		return 0, err
+	}
+
+	lt, err = c.findTestByName(ctx, projectID, name)
+	if err != nil {
+		return 0, err
+	}
+
+	return lt.GetId(), nil
+}
+
+// createEmptyTest creates a new cloud load test without a script.
+func (c *Client) createEmptyTest(
+	ctx context.Context, name string, projectID int64,
+) (_ *k6cloud.LoadTestApiModel, err error) {
+	res, hr, err := c.apiClient.LoadTestsAPI.
+		ProjectsLoadTestsCreate(c.authCtx(ctx), projectID).
+		XStackId(c.stackID).
+		Name(name).
+		Execute()
+	defer closeResponse(hr, &err)
+
+	if err := CheckResponse(hr, err); err != nil {
+		return nil, err
+	}
+	if res == nil {
+		return nil, errUnknown
+	}
+
+	return res, nil
+}
+
