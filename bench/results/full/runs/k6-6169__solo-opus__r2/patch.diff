+// buildConfigFromRuntimeConfig translates the runtime configuration the
+// provisioning API returned into the cloud output's own configuration.
+//
+// Every tuning field is optional: when the cloud has no opinion, or when the
+// value it sent can't be parsed, the corresponding config field is left unset
+// so the local default keeps applying.
+func buildConfigFromRuntimeConfig(
+	logger logrus.FieldLogger, rc provisioning.RuntimeConfig,
+) cloudapi.Config {
+	var conf cloudapi.Config
+
+	if rc.Metrics.PushURL != "" {
+		conf.MetricsPushURL = null.StringFrom(rc.Metrics.PushURL)
+	}
+	if rc.TestRunToken != "" {
+		conf.TestRunToken = null.StringFrom(rc.TestRunToken)
+	}
+
+	conf.MetricPushInterval = parseRuntimeDuration(logger, "push_interval", rc.Metrics.PushInterval)
+	conf.AggregationPeriod = parseRuntimeDuration(logger, "aggregation_period", rc.Metrics.AggregationPeriod)
+	conf.AggregationWaitPeriod = parseRuntimeDuration(
+		logger, "aggregation_wait_period", rc.Metrics.AggregationWaitPeriod)
+
+	if rc.Metrics.PushConcurrency != nil {
+		conf.MetricPushConcurrency = null.IntFrom(int64(*rc.Metrics.PushConcurrency))
+	}
+	if rc.Metrics.MaxSamplesPerPackage != nil {
+		conf.MaxTimeSeriesInBatch = null.IntFrom(int64(*rc.Metrics.MaxSamplesPerPackage))
+	}
+
+	// aggregation_min_samples has no equivalent in the cloud output's
+	// configuration, so it is intentionally dropped.
+
+	return conf
+}
+
+func parseRuntimeDuration(logger logrus.FieldLogger, field string, value *string) types.NullDuration {
+	if value == nil {
+		return types.NullDuration{}
+	}
+
+	d, err := types.ParseExtendedDuration(*value)
+	if err != nil {
+		logger.WithError(err).WithFields(logrus.Fields{"field": field, "value": *value}).
+			Warn("Ignoring an unparseable duration in the cloud runtime configuration")
+		return types.NullDuration{}
+	}
+
+	return types.NewNullDuration(d, true)
+}
