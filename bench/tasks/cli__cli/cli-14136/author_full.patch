@@ -0,0 +1,44 @@
+# Develop an issue in a branch repository worktree, then reuse that worktree.
+
+# Set up env vars
+env ISSUE_REPO=${SCRIPT_NAME}-issue-${RANDOM_STRING}
+env BRANCH_REPO=${SCRIPT_NAME}-branch-${RANDOM_STRING}
+
+# Use gh as a credential helper
+exec gh auth setup-git
+
+# Create the issue and branch repositories
+exec gh repo create ${ORG}/${ISSUE_REPO} --add-readme --private
+exec gh repo create ${ORG}/${BRANCH_REPO} --add-readme --private
+
+# Defer repo cleanup
+defer gh repo delete --yes ${ORG}/${ISSUE_REPO}
+defer gh repo delete --yes ${ORG}/${BRANCH_REPO}
+
+# Clone the issue repository and configure the branch repository as a remote
+exec gh repo clone ${ORG}/${ISSUE_REPO}
+cd ${ISSUE_REPO}
+exec git remote add branch-repo https://${GH_HOST}/${ORG}/${BRANCH_REPO}.git
+
+# Create an issue in the issue repository
+exec gh issue create --title 'Feature Request' --body 'Request Body'
+stdout2env ISSUE_URL
+
+# Create the linked branch in the branch repository and check it out in a worktree
+exec gh issue develop ${ISSUE_URL} --branch-repo ${ORG}/${BRANCH_REPO} --name feature-branch --checkout --worktree ../wt
+exists ../wt
+exec git -C ../wt rev-parse --abbrev-ref HEAD
+stdout '(?m)^feature-branch$'
+
+# The issue repository working copy remains on its default branch
+exec git rev-parse --abbrev-ref HEAD
+stdout '(?m)^main$'
+
+# Repeating the command reuses the branch repository worktree
+exec gh issue develop ${ISSUE_URL} --branch-repo ${ORG}/${BRANCH_REPO} --name feature-branch --checkout --worktree ../wt
+exec git -C ../wt rev-parse --abbrev-ref HEAD
+stdout '(?m)^feature-branch$'
+
+# The issue repository working copy remains untouched
+exec git rev-parse --abbrev-ref HEAD
+stdout '(?m)^main$'
diff --git a/acceptance/testdata/issue/issue-develop-worktree.txtar b/acceptance/testdata/issue/issue-develop-worktree.txtar
